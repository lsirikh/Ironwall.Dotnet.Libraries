<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<!--
		다이얼로그 가족 T4 (all-windows-console-redesign N-05).
		치수 정본: docs/design/window-layout-system-storyboard.html #h-dlg (L1421-1428) · T4 정의 (L1502).
		머리 48 · 버튼 줄 56 · 버튼 34 · 모서리 10 · 폭은 DialogSizeRules 가 정한다(여기에 숫자를 적지 않는다).
		규칙: ① 색은 전부 DynamicResource(캐싱 금지) ② 상태는 색이 아니라 형태 ③ 식별자는 peer 가 있는 요소에만
		④ 이 사전은 Generic.xaml 이 Source= 로 병합한다 — 그래서 위쪽 사전의 키를 StaticResource 로 볼 수 없다.
		  버튼 스타일을 여기에 따로 둔 까닭이 그것이다(Console.Button 재사용 불가).
	-->

	<!--  ───────── 버튼 (이 사전 안에서만 쓰는 명시 스타일)  ─────────  -->
	<Style x:Key="Dialog.Button" TargetType="ButtonBase">
		<Setter Property="Height" Value="34" />
		<Setter Property="MinWidth" Value="92" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ButtonBase">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4" />
						<!--  포커스는 색이 아니라 바깥 윤곽(형태) — 라이트에서 Primary=Selection=Focus 가 같은 색이다  -->
						<Border
							x:Name="Ring"
							Margin="-3"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Ring" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<!--
								꺼진 버튼도 읽혀야 한다 — 투명도를 떨어뜨리지 않고 글자만 muted 로 바꾼다.
								테두리까지 한 단계 여리게 해야 '꺼진 주 동작'이 '켜진 보조'처럼 보이지 않는다.
							-->
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="Dialog.Button.Primary"
		BasedOn="{StaticResource Dialog.Button}"
		TargetType="ButtonBase">
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style
		x:Key="Dialog.Button.Danger"
		BasedOn="{StaticResource Dialog.Button}"
		TargetType="ButtonBase">
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!--  머리의 닫기 — 네모 한 칸. Button 이라 peer 가 실재한다.  -->
	<Style
		x:Key="Dialog.Button.Close"
		BasedOn="{StaticResource Dialog.Button}"
		TargetType="ButtonBase">
		<Setter Property="Width" Value="30" />
		<Setter Property="Height" Value="30" />
		<Setter Property="MinWidth" Value="30" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<!--  ───────── 글 (자동화가 읽는다)  ─────────  -->
	<Style TargetType="{x:Type dlg:ConsoleDialogText}">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type dlg:ConsoleDialogText}">
					<TextBlock
						Foreground="{TemplateBinding Foreground}"
						FontFamily="{TemplateBinding FontFamily}"
						FontSize="{TemplateBinding FontSize}"
						FontWeight="{TemplateBinding FontWeight}"
						Text="{TemplateBinding Text}"
						TextTrimming="{TemplateBinding TrimType}"
						TextWrapping="{TemplateBinding TextWrapping}" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<!--  글자가 없으면 자리도 차지하지 않는다 — 빈 줄이 머리를 벌리지 않게  -->
			<Trigger Property="Text" Value="{x:Static sys:String.Empty}">
				<Setter Property="Visibility" Value="Collapsed" />
			</Trigger>
			<Trigger Property="Text" Value="{x:Null}">
				<Setter Property="Visibility" Value="Collapsed" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  ───────── 틀 T4  ─────────  -->
	<Style TargetType="{x:Type dlg:ConsoleDialogFrame}">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type dlg:ConsoleDialogFrame}">
					<!--  바깥: 창으로 띄우면 바탕, 호스트 스크림 위면 비워 둔다  -->
					<Grid Background="{TemplateBinding Backdrop}">
						<Border
							x:Name="Card"
							Width="{TemplateBinding CardWidth}"
							MaxHeight="{TemplateBinding CardMaxHeight}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="{DynamicResource SurfaceBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="10">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="18"
									Direction="270"
									Opacity="0.28"
									ShadowDepth="4"
									Color="Black" />
							</Border.Effect>
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!--  ① 머리  -->
								<Border
									Grid.Row="0"
									Padding="20,10"
									Background="{DynamicResource SurfaceAltBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="0,0,0,1"
									CornerRadius="9,9,0,0">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0" VerticalAlignment="Center">
											<dlg:ConsoleDialogText
												x:Name="PART_Title"
												FontSize="15"
												FontWeight="Bold"
												Text="{TemplateBinding Title}"
												TrimType="CharacterEllipsis" />
											<dlg:ConsoleDialogText
												Margin="0,2,0,0"
												FontSize="12"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{TemplateBinding Kind}"
												TrimType="CharacterEllipsis" />
										</StackPanel>
										<ContentPresenter
											Grid.Column="1"
											Margin="8,0"
											VerticalAlignment="Center"
											Content="{TemplateBinding HeaderExtra}" />
										<Button
											x:Name="PART_Close"
											Grid.Column="2"
											VerticalAlignment="Center"
											Content="✕"
											Style="{StaticResource Dialog.Button.Close}"
											ToolTip="닫기 (ESC)" />
									</Grid>
								</Border>

								<!--  ② 몸통 — 넘치면 여기서만 스크롤한다  -->
								<ScrollViewer
									Grid.Row="1"
									HorizontalScrollBarVisibility="Disabled"
									VerticalScrollBarVisibility="{TemplateBinding BodyScroll}">
									<!--  MDIX 암시적 ScrollViewer 스타일이 ScrollViewer.Padding 을 삼킨다 — 안쪽 칸에 준다  -->
									<Border Padding="{TemplateBinding BodyPadding}">
										<ContentPresenter
											HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
									</Border>
								</ScrollViewer>

								<!--  ③ 버튼 줄 — 왼쪽 안내 글, 오른쪽 보조 → 주 동작  -->
								<Border
									Grid.Row="2"
									Padding="20,12"
									Background="{DynamicResource SurfaceAltBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="0,1,0,0"
									CornerRadius="0,0,9,9">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<!--
											가로 StackPanel 이면 글이 무한 폭을 받아 버튼 줄 밖으로 잘린다 —
											남는 폭을 실제로 받아 접히도록 칸으로 나눈다(S 400 에서 실측).
										-->
										<Grid Grid.Column="0" Margin="0,0,12,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<ContentPresenter
												Grid.Column="0"
												Margin="0,0,10,0"
												VerticalAlignment="Center"
												Content="{TemplateBinding FooterExtra}" />
											<dlg:ConsoleDialogText
												x:Name="PART_Message"
												Grid.Column="1"
												VerticalAlignment="Center"
												FontSize="12"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{TemplateBinding Message}"
												TextWrapping="Wrap" />
										</Grid>
										<StackPanel
											Grid.Column="1"
											VerticalAlignment="Center"
											Orientation="Horizontal">
											<Button
												x:Name="PART_Secondary"
												Margin="0,0,8,0"
												Content="{TemplateBinding SecondaryText}"
												Style="{StaticResource Dialog.Button}" />
											<Button
												x:Name="PART_Primary"
												Content="{TemplateBinding PrimaryText}"
												IsEnabled="{TemplateBinding IsPrimaryEnabled}"
												Style="{StaticResource Dialog.Button.Primary}" />
										</StackPanel>
									</Grid>
								</Border>
							</Grid>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="ShowClose" Value="False">
							<Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="PrimaryText" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="PART_Primary" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="PrimaryText" Value="{x:Null}">
							<Setter TargetName="PART_Primary" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="SecondaryText" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="PART_Secondary" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="SecondaryText" Value="{x:Null}">
							<Setter TargetName="PART_Secondary" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="IsPrimaryDestructive" Value="True">
							<Setter TargetName="PART_Primary" Property="Style" Value="{StaticResource Dialog.Button.Danger}" />
						</Trigger>
						<Trigger Property="IsBusy" Value="True">
							<Setter TargetName="PART_Primary" Property="IsEnabled" Value="False" />
						</Trigger>
						<Trigger Property="MessageSeverity" Value="Info">
							<Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
						</Trigger>
						<Trigger Property="MessageSeverity" Value="Warning">
							<Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
							<Setter TargetName="PART_Message" Property="FontWeight" Value="SemiBold" />
						</Trigger>
						<Trigger Property="MessageSeverity" Value="Critical">
							<Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter TargetName="PART_Message" Property="FontWeight" Value="SemiBold" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
