<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles"
	xmlns:d="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<!--
		콘솔 커널 기본 템플릿 (console-kernel PRD · 봉투 all-windows-console-redesign N-01).
		치수 정본: docs/design/window-layout-system-storyboard.html — 머리 40 · 레일 184/56 · 툴바 48(버튼·검색 32) · 행 38 · 상태 띠 30 · 상세 340(300~480).
		규칙: ① 색은 전부 DynamicResource 토큰(캐싱 금지) ② 상태는 색이 아니라 형태로 구분 ③ 암시적 스타일(키 없는 TargetType) 은
		이 어셈블리의 컨트롤에만 — 남의 Button/TextBox 를 건드리지 않는다 ④ x:Name 은 템플릿 부품(PART_*) 에만.
	-->

	<!--
		이 두 변환기는 여기 남는다 — Binding.Converter 는 DP 가 아니라 DynamicResource 를 못 받고,
		StaticResource 는 이 사전(테마 사전) 안에서만 풀린다. 창 쪽에서 bool→Visibility 가 필요하면
		Theme/Converters.xaml 의 정본 {StaticResource BooleanToVisibilityConverter} 를 쓴다(중복 정의를 만들지 않는다).
	-->
	<BooleanToVisibilityConverter x:Key="Console.BoolToVisibility" />
	<c:ConsoleLengthConverter x:Key="Console.DoubleToGridLength" />

	<!--
		───────── 버튼 · 검색 상자는 여기 없다 (K-02, 2026-09-21) ─────────
		Console.Button / .Primary / .Ghost / .Mini / Console.SearchBox 는
		Ironwall.Dotnet.Libraries.Theme/Themes/Styles.Console.xaml 로 옮겼다 — 정의는 거기 한 곳뿐이다.
		이유: 이 파일은 테마 사전이라 앱 스코프의 {StaticResource} 로 닿지 않는다. 창들이 못 닿으니
		MDIX 암시 스타일로 떨어졌고 Teal500(#009688) · 체크 색 세 가지 · 회색 스크롤바가 새어 들어왔다.
		실측(2026-09-21): 반대 방향도 막힌다 — 이 사전 안의 {StaticResource} 는 Application.Resources 를
		보지 못하고 DependencyProperty.UnsetValue 를 돌려준다(조용한 실패). 그래서 커널 템플릿은
		아래에서 {DynamicResource Console.*} 로 같은 정의를 가져다 쓴다. 앱이 Theme.Current 를 병합해야 한다.
	-->

	<!--  ───────── 드래그 핸들  ─────────  -->
	<Style TargetType="{x:Type d:DragHandle}">
		<Setter Property="Width" Value="20" />
		<Setter Property="Cursor" Value="SizeAll" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="AutomationProperties.Name" Value="끌기 핸들" />
		<Setter Property="ToolTip" Value="끌어서 옮기기" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type d:DragHandle}">
					<Border Background="{TemplateBinding Background}">
						<!--  DragVertical 과 같은 6점 그립  -->
						<Path
							x:Name="Grip"
							Width="8"
							Height="14"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Data="M0,0 h3 v3 h-3z M5,0 h3 v3 h-3z M0,5.5 h3 v3 h-3z M5,5.5 h3 v3 h-3z M0,11 h3 v3 h-3z M5,11 h3 v3 h-3z"
							Fill="{DynamicResource TextMutedBrush}"
							Stretch="Fill" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Grip" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Grip" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.3" />
							<Setter Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 드롭존 겉모습: 가능=파선 / 불가=사선 해치 / 호버=굵은 윤곽 (색이 아니라 형태)  ─────────  -->
	<Style TargetType="{x:Type d:DropZoneChrome}">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type d:DropZoneChrome}">
					<Grid>
						<ContentPresenter
							x:Name="Body"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						<Rectangle
							x:Name="Hatch"
							IsHitTestVisible="False"
							RadiusX="{TemplateBinding CornerRadius}"
							RadiusY="{TemplateBinding CornerRadius}"
							Visibility="Collapsed">
							<Rectangle.Fill>
								<DrawingBrush
									TileMode="Tile"
									Viewport="0,0,8,8"
									ViewportUnits="Absolute">
									<DrawingBrush.Drawing>
										<GeometryDrawing Geometry="M0,8 L8,0 M-2,2 L2,-2 M6,10 L10,6">
											<GeometryDrawing.Pen>
												<Pen Brush="{DynamicResource TextMutedBrush}" Thickness="1" />
											</GeometryDrawing.Pen>
										</GeometryDrawing>
									</DrawingBrush.Drawing>
								</DrawingBrush>
							</Rectangle.Fill>
						</Rectangle>
						<Rectangle
							x:Name="Outline"
							IsHitTestVisible="False"
							RadiusX="{TemplateBinding CornerRadius}"
							RadiusY="{TemplateBinding CornerRadius}"
							Stroke="{DynamicResource PrimaryBrush}"
							StrokeDashArray="6 4"
							StrokeThickness="1.5"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="d:DropZone.State" Value="Available">
							<Setter TargetName="Outline" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="d:DropZone.State" Value="Hover">
							<Setter TargetName="Outline" Property="Visibility" Value="Visible" />
							<Setter TargetName="Outline" Property="StrokeDashArray" Value="{x:Null}" />
							<Setter TargetName="Outline" Property="StrokeThickness" Value="3" />
						</Trigger>
						<Trigger Property="d:DropZone.State" Value="Blocked">
							<Setter TargetName="Hatch" Property="Visibility" Value="Visible" />
							<Setter TargetName="Body" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 콘솔 셸: 레일 · 목록 · 상세  ─────────  -->
	<Style TargetType="{x:Type c:ConsoleShell}">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleShell}">
					<Border Background="{TemplateBinding Background}">
						<!--  고스트 · 삽입선이 콘솔 안에서 뜨게 한다(패널 카드 안에서는 창의 어도너 층이 멀다)  -->
						<AdornerDecorator>
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="40" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>

								<Border
									Background="{DynamicResource SurfaceAltBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="0,0,0,1">
									<DockPanel Margin="16,0,8,0" LastChildFill="True">
										<ContentPresenter
											VerticalAlignment="Center"
											Content="{TemplateBinding HeaderContent}"
											DockPanel.Dock="Right" />
										<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
											<TextBlock
												FontSize="15"
												FontWeight="SemiBold"
												Text="{TemplateBinding Title}" />
											<TextBlock
												Margin="10,0,0,0"
												VerticalAlignment="Center"
												FontSize="12.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{TemplateBinding Subtitle}" />
										</StackPanel>
									</DockPanel>
								</Border>

								<Grid Grid.Row="1">
									<Grid.ColumnDefinitions>
										<ColumnDefinition x:Name="PART_RailColumn" Width="184" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition x:Name="PART_DetailColumn" Width="340" />
									</Grid.ColumnDefinitions>

									<Border
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource DividerBrush}"
										BorderThickness="0,0,1,0">
										<ContentPresenter Content="{TemplateBinding Rail}" />
									</Border>

									<!--  목록은 남는 높이를 전부 쓴다 — 고정 높이 없음  -->
									<Grid Grid.Column="1">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<ContentPresenter Content="{TemplateBinding Toolbar}" />
										<ContentPresenter Grid.Row="1" Content="{TemplateBinding List}" />
										<ContentPresenter Grid.Row="2" Content="{TemplateBinding StatusBar}" />
									</Grid>

									<Border
										x:Name="PART_DetailHost"
										Grid.Column="2"
										Panel.ZIndex="5"
										Background="{DynamicResource SurfaceBrush}"
										BorderBrush="{DynamicResource DividerBrush}"
										BorderThickness="1,0,0,0">
										<ContentPresenter Content="{TemplateBinding Detail}" />
									</Border>

									<Thumb
										x:Name="PART_Splitter"
										Grid.Column="2"
										Width="9"
										Margin="-4,0,0,0"
										HorizontalAlignment="Left"
										Panel.ZIndex="6"
										AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Splitter}"
										AutomationProperties.Name="상세 칸 경계"
										Cursor="SizeWE"
										Focusable="True"
										FocusVisualStyle="{x:Null}"
										ToolTip="끌어서 폭 조절 · 더블클릭 340 · ←/→ 10px · Esc 되돌림">
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Border Background="Transparent">
													<Rectangle
														x:Name="Line"
														Width="3"
														HorizontalAlignment="Center"
														Fill="{DynamicResource PrimaryBrush}"
														Visibility="Collapsed" />
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="Line" Property="Visibility" Value="Visible" />
													</Trigger>
													<Trigger Property="IsDragging" Value="True">
														<Setter TargetName="Line" Property="Visibility" Value="Visible" />
													</Trigger>
													<Trigger Property="IsKeyboardFocused" Value="True">
														<Setter TargetName="Line" Property="Visibility" Value="Visible" />
													</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>

									<Border
										x:Name="PART_SplitLabel"
										Grid.Column="2"
										Margin="10,8,0,0"
										Padding="6,2"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Panel.ZIndex="7"
										Background="{DynamicResource PrimaryBrush}"
										CornerRadius="3"
										IsHitTestVisible="False"
										Visibility="Collapsed">
										<TextBlock
											FontFamily="{DynamicResource MonoFont}"
											FontSize="11.5"
											Foreground="{DynamicResource OnPrimaryBrush}"
											Text="{TemplateBinding SplitLabelText}" />
									</Border>
								</Grid>
							</Grid>
						</AdornerDecorator>
					</Border>
					<ControlTemplate.Triggers>
						<!--  서랍은 목록 위에 겹친다 — 경계를 그림자 대신 굵은 선으로(형태)  -->
						<Trigger Property="IsDrawerOpen" Value="True">
							<Setter TargetName="PART_DetailHost" Property="BorderThickness" Value="2,0,0,0" />
							<Setter TargetName="PART_DetailHost" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 레일  ─────────  -->
	<Style TargetType="{x:Type c:ConsoleRail}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="SelectionMode" Value="Single" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
		<Setter Property="AutomationProperties.AutomationId" Value="{Binding ConsoleKey, RelativeSource={RelativeSource Self}, StringFormat=Console.{0}.Rail}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleRail}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<ScrollViewer
							Padding="0,10,0,10"
							Focusable="False"
							Style="{DynamicResource Console.ScrollViewer}"
							VerticalScrollBarVisibility="Auto">
							<ItemsPresenter />
						</ScrollViewer>
						<Border
							x:Name="FooterHost"
							Grid.Row="1"
							Padding="16,12,16,14"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="0,1,0,0">
							<ContentPresenter Content="{TemplateBinding Footer}" TextElement.Foreground="{DynamicResource TextMutedBrush}" />
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsCompact" Value="True">
							<Setter TargetName="FooterHost" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Footer" Value="{x:Null}">
							<Setter TargetName="FooterHost" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type c:ConsoleRailItem}">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="FontSize" Value="13.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
		<Setter Property="AutomationProperties.AutomationId">
			<Setter.Value>
				<MultiBinding StringFormat="Console.{0}.Rail.{1}">
					<Binding Path="ConsoleKey" RelativeSource="{RelativeSource AncestorType={x:Type c:ConsoleRail}}" />
					<Binding Path="Key" />
				</MultiBinding>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleRailItem}">
					<StackPanel>
						<Rectangle
							x:Name="Sep"
							Height="1"
							Margin="8,6"
							Fill="{DynamicResource RowLineBrush}"
							Visibility="{Binding HasSeparatorAbove, Converter={StaticResource Console.BoolToVisibility}}" />
						<Grid Margin="8,1">
							<Border
								x:Name="Bd"
								Background="Transparent"
								CornerRadius="4" />
							<!--  선택 = 좌측 3px 세로 바 (드롭 위치의 가로선과 축이 직교)  -->
							<Rectangle
								x:Name="Bar"
								Width="3"
								Margin="-8,6,0,6"
								HorizontalAlignment="Left"
								Fill="{DynamicResource PrimaryBrush}"
								RadiusX="1.5"
								RadiusY="1.5"
								Visibility="Collapsed" />
							<Border
								x:Name="Focus"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								CornerRadius="4"
								Visibility="Collapsed" />
							<Grid x:Name="Row" Margin="12,9">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<ContentPresenter
									x:Name="Icon"
									Width="18"
									Height="18"
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Content="{Binding Icon}"
									TextElement.Foreground="{DynamicResource TextMutedBrush}" />
								<TextBlock
									x:Name="Lbl"
									Grid.Column="1"
									Margin="10,0,0,0"
									VerticalAlignment="Center"
									Text="{Binding Label}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									x:Name="Cnt"
									Grid.Column="2"
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									FontFamily="{DynamicResource MonoFont}"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding CountText}" />
							</Grid>
						</Grid>
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintInfoBrush}" />
							<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Setter Property="FontWeight" Value="Bold" />
							<Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Focus" Property="Visibility" Value="Visible" />
						</Trigger>
						<DataTrigger Binding="{Binding HasBad}" Value="True">
							<Setter TargetName="Cnt" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter TargetName="Cnt" Property="FontWeight" Value="SemiBold" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type c:ConsoleRail}}}" Value="True">
							<Setter TargetName="Lbl" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="Cnt" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="Row" Property="Margin" Value="11,9" />
							<Setter Property="ToolTip" Value="{Binding Label}" />
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 툴바  ─────────  -->
	<Style TargetType="{x:Type c:ConsoleToolbar}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleToolbar}">
					<!--
						D-23 — 띠 높이는 고정한다(MinHeight 가 아니라 Height) + ClipToBounds. 폭 32 를 넘는
						내용이 들어와도 행을 밀어 키우지 못하고 잘린다 — Padding 12,8 이 위아래 16 을 먹고
						남는 32 가 버튼·검색 높이(Console.Button/.SearchBox = 32)와 정확히 맞는다(D-20 은
						900~1900 어떤 폭에서도 재현 안 됨 — 이 고정은 재현 여부와 무관하게 구조로 막는다).
					-->
					<Border
						Height="{x:Static c:ConsoleLayoutMath.ToolbarHeight}"
						Padding="12,8"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,0,0,1"
						ClipToBounds="True">
						<!--
							D-16 — 옛 구조는 DockPanel(LastChildFill) 이라 검색이 '남는 자리' 였다. Extra 가 길면
							검색이 MinWidth 120 아래로 눌려 글자가 잘렸다. Grid 로 바꾸고 검색 칸에 MinWidth 를 걸어
							이제는 왼쪽 · 오른쪽 묶음이 먼저 줄어든다 — 검색은 결코 잘리지 않는다.
							D-44 — 버튼 사이 간격은 8px 로 통일한다(집 규칙). 커널이 8 이면 창도 8 이다.
							D-23 — 그 "결코 잘리지 않는다"가 틀렸다: 가운데 칸의 고정 MinWidth(132) 는 폭이
							모자라도 줄지 않아, 왼쪽(필터)이 넓어지면 오른쪽(Extra=기본 액션)이 화면 밖으로
							밀렸다(서랍 1150px · "직접" 에서 실측). 가운데 칸의 MinWidth 는 이제 코드비하인드
							(ConsoleToolbar.ApplySearchGeometry)가 검색 밀도에 맞춰 동적으로 줄인다 — 아래 132 는
							"전체 폭 검색" 상태의 초기값일 뿐이다.
						-->
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" MinWidth="132" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel Orientation="Horizontal">
								<Button
									x:Name="PART_Add"
									AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Toolbar.Add}"
									IsEnabled="{TemplateBinding CanAdd}"
									Style="{DynamicResource Console.Button.Primary}">
									<StackPanel Orientation="Horizontal">
										<!--  글리프는 버튼의 Foreground 를 따른다 — 꺼지면 판이 가라앉으므로 흰 십자가 사라지면 안 된다(K-01)  -->
										<Path
											Width="10"
											Height="10"
											Margin="0,0,6,0"
											VerticalAlignment="Center"
											Data="M4,0 h2 v4 h4 v2 h-4 v4 h-2 v-4 h-4 v-2 h4z"
											Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
											Stretch="Fill" />
										<TextBlock VerticalAlignment="Center" Text="{Binding AddText, RelativeSource={RelativeSource TemplatedParent}}" />
									</StackPanel>
								</Button>
								<Button
									x:Name="PART_Delete"
									Margin="8,0,0,0"
									AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Toolbar.Delete}"
									Content="삭제"
									IsEnabled="{TemplateBinding CanDelete}"
									Style="{DynamicResource Console.Button}" />
								<Button
									x:Name="PART_Refresh"
									Margin="8,0,0,0"
									AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Toolbar.Refresh}"
									Content="갱신"
									IsEnabled="{TemplateBinding CanRefresh}"
									Style="{DynamicResource Console.Button.Ghost}" />
								<ContentPresenter
									Margin="10,0,0,0"
									VerticalAlignment="Center"
									Content="{TemplateBinding Filters}" />
							</StackPanel>
							<TextBox
								x:Name="Search"
								Grid.Column="1"
								MinWidth="120"
								MaxWidth="320"
								Margin="12,0,0,0"
								HorizontalAlignment="Right"
								AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Toolbar.Search}"
								Style="{DynamicResource Console.SearchBox}"
								Tag="{TemplateBinding SearchPlaceholder}"
								Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<StackPanel Grid.Column="2" Orientation="Horizontal">
								<Button
									x:Name="PART_Columns"
									Margin="8,0,0,0"
									AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Toolbar.Columns}"
									Content="{TemplateBinding ColumnsText}"
									FontFamily="{DynamicResource MonoFont}"
									Style="{DynamicResource Console.Button.Ghost}"
									ToolTip="기본 열 / 전체 열" />
								<ContentPresenter
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									Content="{TemplateBinding Extra}" />
							</StackPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<!--  꺼진 버튼은 늘 사유를 갖는다  -->
						<Trigger Property="CanAdd" Value="False">
							<Setter TargetName="PART_Add" Property="ToolTip" Value="{Binding AddDisabledReason, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger Property="CanDelete" Value="False">
							<Setter TargetName="PART_Delete" Property="ToolTip" Value="{Binding DeleteDisabledReason, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>
						<Trigger Property="ColumnsText" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="PART_Columns" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="ShowSearch" Value="False">
							<Setter TargetName="Search" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 상세 호스트: 머리 · 배너 · 본문 · 고정 적용 막대  ─────────  -->
	<Style TargetType="{x:Type c:ConsoleDetailHost}">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Top" />
		<Setter Property="AutomationProperties.AutomationId" Value="{Binding ConsoleKey, RelativeSource={RelativeSource Self}, StringFormat=Console.{0}.Detail}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleDetailHost}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<Grid Margin="16,14,16,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock
									FontFamily="{DynamicResource MonoFont}"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{TemplateBinding Kind}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									Margin="0,2,0,0"
									AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Detail.Title}"
									FontSize="16"
									FontWeight="SemiBold"
									Text="{TemplateBinding Title}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
							<StackPanel
								x:Name="WidthTools"
								Grid.Column="1"
								VerticalAlignment="Top"
								Orientation="Horizontal">
								<Button
									x:Name="PART_WidthS"
									Content="S"
									Style="{DynamicResource Console.Button.Mini}"
									ToolTip="상세 폭 300" />
								<Button
									x:Name="PART_WidthM"
									Content="M"
									Style="{DynamicResource Console.Button.Mini}"
									ToolTip="상세 폭 340" />
								<Button
									x:Name="PART_WidthL"
									Content="L"
									Style="{DynamicResource Console.Button.Mini}"
									ToolTip="상세 폭 480" />
							</StackPanel>
						</Grid>

						<Border
							x:Name="BannerHost"
							Grid.Row="1"
							Margin="16,0,16,8"
							Padding="10,7"
							Background="{DynamicResource TintInfoBrush}"
							BorderBrush="{DynamicResource StatusInfoBrush}"
							BorderThickness="3,0,0,0"
							CornerRadius="3">
							<!--  D-17 — Wrap 은 한 글자짜리 고아 줄을 만든다(실측: 12px 셋째 줄에 한 음절). WrapWithOverflow 로.  -->
							<TextBlock
								FontSize="12.5"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{TemplateBinding Banner}"
								TextWrapping="WrapWithOverflow" />
						</Border>

						<!--
							좌우 여백은 <b>ScrollViewer 의 Padding 이 아니라 안쪽 Margin</b> 이다 — 앱 전역 MaterialDesign
							ScrollViewer 암시 스타일이 Padding 을 삼켜 폼이 왼쪽으로 2px 붙어 버렸다(N-10 실측).
							<b>아래 여백은 반대로 바깥이어야 한다</b>(D-37): 안쪽 Margin 은 굴러가는 내용 <b>안</b>이라
							맨 위에서는 화면 밖으로 나가 한 뼘도 벌어 주지 못한다 — 본문이 넘치는 여섯 상태에서
							마지막 줄이 막대 윗선에 2px 까지 붙었다(보고서 콘솔 light/dark-03·04·09~12 실측).
							그래서 아래 12 는 <b>ScrollViewer 자신의 Margin</b> 으로 잡는다. 뷰포트가 그만큼 줄어
							어느 스크롤 위치에서도 띠가 남는다. Padding 도 같은 값을 냈지만(렌더로 대조) 템플릿이
							Padding 을 template-binding 하지 않으면 조용히 사라진다 — N-10 이 바로 그 사고였다.
							Margin 은 어떤 스타일 · 템플릿도 삼킬 수 없다.
							대가: 넘치던 칸이 12 만큼 더 넘친다 — 이미 어딘가에 초점이 가 있던 칸(검증 실패 · 등록)은
							초점을 보이려고 처음부터 조금 굴러간 채로 열린다(장비 콘솔 05~08·10~12 실측, 의도된 거동).
						-->
						<ScrollViewer
							Grid.Row="2"
							Margin="0,0,0,12"
							Focusable="False"
							HorizontalScrollBarVisibility="Disabled"
							Style="{DynamicResource Console.ScrollViewer}"
							VerticalScrollBarVisibility="Auto">
							<!--  맨 아래까지 굴렸을 때의 여백 = 바깥 Margin 12 + 이 Margin 12 = 24(종전과 같다).  -->
							<ContentPresenter
								Margin="16,4,16,12"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</ScrollViewer>

						<Border
							x:Name="PART_Footer"
							Grid.Row="3"
							Padding="16,10"
							AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Detail.ApplyBar}"
							Background="{DynamicResource SurfaceAltBrush}"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="0,1,0,0">
							<DockPanel LastChildFill="True">
								<StackPanel
									x:Name="Buttons"
									VerticalAlignment="Center"
									DockPanel.Dock="Right"
									Orientation="Horizontal">
									<Button
										x:Name="PART_Revert"
										AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Detail.Revert}"
										Content="{TemplateBinding RevertText}"
										IsEnabled="{TemplateBinding CanRevert}"
										Style="{DynamicResource Console.Button}"
										ToolTip="바꾼 것을 버리고 원래 값으로" />
									<Button
										x:Name="PART_Apply"
										Margin="8,0,0,0"
										AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Detail.Apply}"
										Content="{TemplateBinding ApplyText}"
										IsEnabled="{TemplateBinding CanApply}"
										Style="{DynamicResource Console.Button.Primary}" />
								</StackPanel>
								<!--
									D-12/D-13 — 한 줄 + 줄임표였다. 버튼 둘이 자리를 먹으면 "적용하거나 되돌린 뒤 이동하세요" ·
									"등록 전에는 목록에 나타나지…" 가 매번 잘렸다. 두 줄까지 접고(막대는 Auto 높이라 같이 자란다)
									그래도 넘치면 줄임표. 흔들기는 PART_Footer 의 RenderTransform 이라 레이아웃과 무관하게 그대로다.
								-->
								<TextBlock
									x:Name="Msg"
									MaxWidth="360"
									Margin="0,0,12,0"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding ConsoleKey, RelativeSource={RelativeSource TemplatedParent}, StringFormat=Console.{0}.Detail.Message}"
									FontSize="12.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{TemplateBinding FooterText}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="WrapWithOverflow" />
							</DockPanel>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Banner" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="BannerHost" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="IsReadOnly" Value="True">
							<Setter TargetName="BannerHost" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="BannerHost" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<Trigger Property="ShowButtons" Value="False">
							<Setter TargetName="Buttons" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="ShowWidthTools" Value="False">
							<Setter TargetName="WidthTools" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<!--  미적용 변경: 경고색 바탕 + 굵은 윗선(형태) + 굵은 글자. K-04 — 틴트 0x22 는 흰 바탕과 1.18 이라 안 보였다: 토큰 0x55 + 윗선 4px.  -->
						<Trigger Property="IsDirty" Value="True">
							<Setter TargetName="PART_Footer" Property="Background" Value="{DynamicResource TintWarningBrush}" />
							<Setter TargetName="PART_Footer" Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
							<Setter TargetName="PART_Footer" Property="BorderThickness" Value="0,4,0,0" />
							<Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Setter TargetName="Msg" Property="FontWeight" Value="SemiBold" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 섹션  ─────────  -->
	<Style TargetType="{x:Type c:ConsoleSection}">
		<Setter Property="Margin" Value="0,14,0,0" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleSection}">
					<StackPanel>
						<DockPanel LastChildFill="False">
							<Border
								x:Name="TagHost"
								Padding="6,1"
								VerticalAlignment="Center"
								Background="{DynamicResource SurfaceSunkenBrush}"
								CornerRadius="3"
								DockPanel.Dock="Right"
								Visibility="Collapsed">
								<TextBlock
									x:Name="TagLabel"
									FontSize="10.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{TemplateBinding TagText}" />
							</Border>
							<ContentPresenter
								VerticalAlignment="Center"
								ContentSource="Header"
								TextElement.FontSize="13"
								TextElement.FontWeight="SemiBold"
								TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								FontFamily="{DynamicResource MonoFont}"
								FontSize="11"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{TemplateBinding AxisName}" />
							<Border
								x:Name="CountHost"
								Margin="8,0,0,0"
								Padding="6,0"
								VerticalAlignment="Center"
								Background="{DynamicResource SurfaceSunkenBrush}"
								CornerRadius="8">
								<TextBlock
									FontFamily="{DynamicResource MonoFont}"
									FontSize="11"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{TemplateBinding CountText}" />
							</Border>
						</DockPanel>
						<Rectangle
							Height="1"
							Margin="0,6,0,6"
							Fill="{DynamicResource RowLineBrush}" />
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
					</StackPanel>
					<ControlTemplate.Triggers>
						<Trigger Property="CountText" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="CountHost" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="TagKind" Value="Observed">
							<Setter TargetName="TagHost" Property="Visibility" Value="Visible" />
							<Setter TargetName="TagLabel" Property="Text" Value="관측 · 읽기 전용" />
						</Trigger>
						<Trigger Property="TagKind" Value="Intent">
							<Setter TargetName="TagHost" Property="Visibility" Value="Visible" />
							<Setter TargetName="TagHost" Property="Background" Value="{DynamicResource TintInfoBrush}" />
							<Setter TargetName="TagLabel" Property="Text" Value="의도 · 쓰기 가능" />
							<Setter TargetName="TagLabel" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="TagLabel" Property="FontWeight" Value="SemiBold" />
						</Trigger>
						<Trigger Property="TagKind" Value="Custom">
							<Setter TargetName="TagHost" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 필드: 라벨 102 + 값, API 이름은 라벨 아랫줄  ─────────  -->
	<Style TargetType="{x:Type c:ConsoleField}">
		<Setter Property="Margin" Value="0,4" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleField}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Console.DoubleToGridLength}}" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<StackPanel Margin="0,6,8,0" VerticalAlignment="Top">
							<StackPanel Orientation="Horizontal">
								<ContentPresenter
									ContentSource="Header"
									TextElement.FontSize="12.5"
									TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
								<!--  자물쇠: 잠긴 칸은 색이 아니라 글리프로  -->
								<Path
									x:Name="Lock"
									Width="8"
									Height="10"
									Margin="5,0,0,0"
									VerticalAlignment="Center"
									Data="M2,4 V3 a3,3 0 0 1 6,0 V4 h1 v6 h-8 v-6z M3.5,4 h3 V3 a1.5,1.5 0 0 0 -3,0z"
									Fill="{DynamicResource TextMutedBrush}"
									Stretch="Fill"
									Visibility="Collapsed" />
							</StackPanel>
							<!--  API 이름은 단어가 아니라 식별자다 — 중간에서 자르면(IsAutoEventDiscar/d) 뜻이 죽는다. 줄임표 + 전문은 ToolTip.  -->
							<TextBlock
								x:Name="Api"
								FontFamily="{DynamicResource MonoFont}"
								FontSize="10"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{TemplateBinding ApiName}"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap"
								ToolTip="{TemplateBinding ApiName}" />
						</StackPanel>
						<Grid Grid.Column="1">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Rectangle
								x:Name="Touched"
								Width="3"
								Margin="-7,2,0,2"
								HorizontalAlignment="Left"
								Fill="{DynamicResource StatusWarningBrush}"
								Visibility="Collapsed" />
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
							<TextBlock
								x:Name="NoteText"
								Grid.Row="1"
								Margin="0,3,0,0"
								FontSize="11"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{TemplateBinding Note}"
								TextWrapping="WrapWithOverflow" />
						</Grid>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="ApiName" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="Api" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Note" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="IsTouched" Value="True">
							<Setter TargetName="Touched" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsLocked" Value="True">
							<Setter TargetName="Lock" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 미수신 상자 (빈 값과 다르다)  ─────────  -->
	<Style TargetType="{x:Type c:NotReceivedBox}">
		<Setter Property="Margin" Value="0,2,0,4" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:NotReceivedBox}">
					<Grid>
						<Rectangle
							RadiusX="4"
							RadiusY="4"
							Stroke="{DynamicResource BorderBrush}"
							StrokeDashArray="6 4"
							StrokeThickness="1" />
						<StackPanel Margin="10,8">
							<TextBlock
								FontSize="12"
								Foreground="{DynamicResource TextSecondaryBrush}"
								TextWrapping="WrapWithOverflow">
								<Run Text="이 응답에 " /><Run
									FontFamily="{DynamicResource MonoFont}"
									FontWeight="SemiBold"
									Text="{Binding SectionName, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" /><Run Text=" 절이 실리지 않았습니다." />
							</TextBlock>
							<TextBlock
								Margin="0,2,0,0"
								FontSize="11"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="빈 값이 아니라 미수신입니다."
								TextWrapping="WrapWithOverflow" />
							<TextBlock
								x:Name="Hint"
								Margin="0,2,0,0"
								FontFamily="{DynamicResource MonoFont}"
								FontSize="11"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{TemplateBinding ReloadHint}"
								TextWrapping="WrapWithOverflow" />
						</StackPanel>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="ReloadHint" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 빈 자리 (D-33)  ─────────  -->
	<!--
		걸릴 것이 없을 때 본문을 비워 두지 않는다 — 네 콘솔이 잉크 0.0% 로 비어 있었고,
		"없음" 과 "덜 불러옴" 과 "고장" 이 화면에서 같아 보였다. 글리프 + 제목 + 힌트 + (선택) 단추.
		커널은 자리만 만든다; 어느 콘솔에 붙일지는 창이 정한다.
	-->
	<Style TargetType="{x:Type c:ConsoleEmptyState}">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Padding" Value="24" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="AutomationProperties.AutomationId" Value="Console.EmptyState" />
		<Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:ConsoleEmptyState}">
					<Border Padding="{TemplateBinding Padding}" Background="Transparent">
						<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
							<Path
								Width="34"
								Height="34"
								HorizontalAlignment="Center"
								Data="{TemplateBinding Glyph}"
								Stretch="Uniform"
								Stroke="{DynamicResource TextMutedBrush}"
								StrokeLineJoin="Round"
								StrokeThickness="1.4" />
							<TextBlock
								x:Name="TitleText"
								MaxWidth="320"
								Margin="0,12,0,0"
								HorizontalAlignment="Center"
								FontSize="13.5"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{TemplateBinding Title}"
								TextAlignment="Center"
								TextWrapping="WrapWithOverflow" />
							<TextBlock
								x:Name="HintText"
								MaxWidth="320"
								Margin="0,5,0,0"
								HorizontalAlignment="Center"
								FontSize="12.5"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{TemplateBinding Hint}"
								TextAlignment="Center"
								TextWrapping="WrapWithOverflow" />
							<ContentPresenter
								x:Name="ActionHost"
								Margin="0,14,0,0"
								HorizontalAlignment="Center"
								Content="{TemplateBinding Action}" />
						</StackPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="Hint" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Title" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Action" Value="{x:Null}">
							<Setter TargetName="ActionHost" Property="Visibility" Value="Collapsed" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 날짜·시각 범위 팝업(DateTimeRangeField) ═════════
	     사용자 결정(2026-09-23) — 두 mah:DateTimePicker 나열을 대체한다. 달력은 WPF 표준 Calendar
	     (SelectionMode=SingleRange, 드래그/Shift+클릭으로 시작·끝을 한 번에), 시각은 MDIX TimePicker —
	     이 앱이 MaterialDesign3.Defaults.xaml 을 실제로 병합하므로(App.xaml) mah:DateTimePicker 에서
	     실측한 "베이스 사전 미병합 → DynamicResource 미해결" 결함군이 여기서는 원리적으로 없다.
	     표기는 DateTimeRangeText 로 고정(yyyy-MM-dd HH:mm, 고정 문화권).

	     K-12(2026-09-23, 실기 재현검토) — MDIX 는 WPF 표준 Calendar 를 "Material 달력"으로 암시(키 없는
	     {x:Type Calendar}) 통째로 재스킨한다(MD3.Defaults.xaml 이 실제 병합돼 있으므로 이건 미해결 폴백이
	     아니라 MDIX 자신의 의도된 디자인 — MahApps 의 "깨진 폴백"과는 다른 실패 모드). 실측 픽셀:
	     헤더 띠(연도/요일-월-일)와 선택된 날짜 원 = #009688(Teal500, MD PrimaryHueMid) — 우리 토큰
	     PrimaryBrush 계열(#0C6B89 급)과 다른 색. 같은 스킨이 헤더를 "Tue, Sep 22" 영문으로 굳혀서 고정
	     문화권(요일 헤더는 이미 한글로 나오는 것과 대조적) 규칙도 깬다.
	     고치는 법 — Calendar.Style 을 명시로 준다(비워도 된다: Template 을 안 주면 그 속성만 WPF 자신의
	     테마 기본 스타일로 떨어진다). Style 이 일단 명시로 배정되면 앱 스코프의 암시 {x:Type Calendar} 는
	     더는 안 끼어든다(우리 트리거 ToggleButton 에서 Style="{x:Null}" 로 이미 같은 수법을 실증).
	     ⚠ CalendarDayButton·CalendarButton·Button(헤더/화살표) 세 내부 타입은 Style.Resources 로는 안 닿는다
	     (실측: Lime/Red 로 표시색을 바꿔도 반영 0 — Calendar.Template 을 우리가 안 주는 한 날짜 칸은 여전히
	     "테마 기본 스타일" 이 만들고, 그 템플릿이 참조하는 리소스는 **그 테마 스타일 자신의** Resources 이지
	     우리 Style 의 Resources 가 아니다). 대신 Calendar **요소 자신의** Resources(암시 스타일, 인라인
	     &lt;Calendar.Resources&gt;)에 넣는다 — 이건 어떤 템플릿이 자식을 만들었든 그 시각/논리 트리 전체의
	     조회 사슬에 항상 들어간다(실측: 이 경로로 바꾸자 즉시 반영).
	     Language="ko-KR" 을 Calendar/TimePicker 양쪽에 명시로 준다 — 요일 헤더는 이미 한글이라 문화권
	     자체는 흐르고 있었지만 월 헤더는 별도 경로였다(재현검토로 확인).  -->
	<c:FixedDateTimeConverter x:Key="Console.FixedDateTime" />

	<!--  K-13(2026-09-23, 2차 재현검토) — CalendarDayButton/CalendarButton/Button(헤더·화살표)에 건
	     Style.Resources 도, Calendar 인스턴스 자신의 &lt;Calendar.Resources&gt;(암시 BasedOn)도 전부 무력했다
	     (실측 4종: Lime 배경 · Red 선택색 · Visibility=Collapsed · CalendarItem 자체 Background=Lime — 전부
	     화면에 전혀 반영되지 않았다). 결론: WPF 표준 Calendar 가 Template 없이 떨어지는 "테마 기본"은
	     PresentationFramework.Aero2 에 봉인된 BAML 이고, 그 안의 CalendarItem/CalendarDayButton 템플릿은
	     외부 리소스 사전으로 절대 가로챌 수 없다(MahApps 의 "미병합이라 실패"와는 다른 종류 — 여기는
	     애초에 후킹 지점이 없다). 유일한 길은 CalendarItem 까지 통째로 우리 템플릿으로 새로 준다 —
	     그러면 CalendarItem 이 만드는 CalendarDayButton/CalendarButton 이 우리 Grid(PART_MonthView/
	     PART_YearView) 의 자식이 되고, 그 조회 사슬이 마침내 우리 ControlTemplate.Resources 를 통과한다
	     (실측: 이 경로로 바꾸자 즉시 반영 — 아래 확인).
	     치수 — 사용자 실기 피드백(다크 캡처, 2026-09-23): "달력이 너무 작다" · "다크에서 묻힌다".
	     날짜 칸 38×38(콘솔 32 입력 리듬보다 살짝 넉넉하게 — 클릭 표적), 7열 = 266px, 팝업 폭을 그만큼
	     넓힌다(아래 DateTimeRangeField 템플릿의 StackPanel Width). 달력 판 자체는 SurfaceAltBrush(팝업의
	     SurfaceBrush 와 다른 면)로 감싸 테두리를 둔다 — 팝업과 같은 색이면 "판" 이 안 보인다(실측 지적).  -->
	<Style x:Key="Console.DateTimeRange.CalendarButtonChrome" TargetType="{x:Type Button}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.DateTimeRange.CalendarButtonCell" TargetType="{x:Type CalendarButton}">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type CalendarButton}">
					<Border x:Name="Bg" Margin="2" Background="Transparent" CornerRadius="4">
						<ContentPresenter
							Margin="4"
							HorizontalAlignment="Center"
							VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsInactive" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<!--  CalendarButton 에는 IsSelected 가 없다(실측: 빌드 MC4109) — 이 칸이 나타내는
						     달/해에 고른 날이 있는지는 HasSelectedDays 가 대신한다.  -->
						<Trigger Property="HasSelectedDays" Value="True">
							<Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  날짜 낱칸 — 이 팝업의 핵심 선택 표면. 38×38(요청: 32 입력 리듬보다 넉넉한 클릭 표적).
	     오늘 = PrimaryBrush 고리(선, 채움 없음) · 선택 = PrimaryBrush 채움(면) + OnPrimary 글자.
	     라이트에서 PrimaryBrush=SelectionBrush=FocusRingBrush(1.00:1)라 "선택됐다"를 색으로만
	     내걸지 않는다 — 면(채움) 자체가 형태 신호이고, 오늘의 고리(선)와 선택의 채움(면)이
	     서로 다른 기하라 겹쳐도(오늘이면서 선택) 구분된다.  -->
	<Style x:Key="Console.DateTimeRange.CalendarDayCell" TargetType="{x:Type CalendarDayButton}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type CalendarDayButton}">
					<Grid>
						<Border x:Name="Bg" Margin="2" Background="{TemplateBinding Background}" CornerRadius="15" />
						<Border
							x:Name="TodayRing"
							Margin="2"
							BorderBrush="{DynamicResource PrimaryBrush}"
							BorderThickness="1.5"
							CornerRadius="15"
							Visibility="Collapsed" />
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsToday" Value="True">
							<Setter TargetName="TodayRing" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsInactive" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsBlackedOut" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bg" Property="Background" Value="Transparent" />
						</Trigger>
						<!--  선택이 맨 뒤 — 호버·오늘·비활성 어떤 조합 위에서도 선택이 이긴다.  -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
							<Setter Property="FontWeight" Value="SemiBold" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  CalendarItem — 헤더(◀ 월 ▶) + 날짜/월 격자를 담는 판. Background 를 SurfaceAltBrush 로 둬서
	     팝업(SurfaceBrush)과 면이 구분되게 하고, 자체 테두리를 준다(요청: "다크에서 묻힌다" 대응).  -->
	<Style x:Key="Console.DateTimeRange.CalendarItemStyle" TargetType="{x:Type CalendarItem}">
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type CalendarItem}">
					<!--  ControlTemplate.Resources — CalendarItem 이 내부에서 새로 만드는 CalendarDayButton ·
					     CalendarButton · Button(헤더·화살표) 이 전부 여기서 암시 스타일을 찾는다(실측: 이게
					     유일하게 통하는 경로 — 위 K-13 참조).  -->
					<ControlTemplate.Resources>
						<Style BasedOn="{StaticResource Console.DateTimeRange.CalendarButtonChrome}" TargetType="{x:Type Button}" />
						<Style BasedOn="{StaticResource Console.DateTimeRange.CalendarButtonCell}" TargetType="{x:Type CalendarButton}" />
						<Style BasedOn="{StaticResource Console.DateTimeRange.CalendarDayCell}" TargetType="{x:Type CalendarDayButton}" />
						<!--  요일 머리글(일 월 화 …) — K-14(WPF 소스 확인, CalendarItem.cs OnApplyTemplate):
						     CalendarItem 은 이걸 TryFindResource("DayTitleTemplate") 같은 평범한 문자열 키로
						     찾지 않는다 — 정확히 `Template.Resources[DayTitleTemplateResourceKey]` 이고
						     그 키는 `ComponentResourceKey(typeof(CalendarItem), "DayTitleTemplate")` 다.
						     평범한 x:Key="DayTitleTemplate" 문자열은 이 ComponentResourceKey 와 전혀 다른
						     키라 조회가 조용히 실패한다(실측: 못 찾으면 PopulateGrids() 가 빈 ContentControl
						     7개를 대신 넣어 요일 줄이 통째로 비어 보였다 — 문자열 키였을 때 정확히 이 증상).
						     TypeInTargetAssembly 로 ComponentResourceKey 마크업 확장을 써야 한다.  -->
						<DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type CalendarItem}, ResourceId=DayTitleTemplate}">
							<TextBlock
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="11"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{Binding}" />
						</DataTemplate>
					</ControlTemplate.Resources>
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="1"
						CornerRadius="6">
						<Grid Margin="10">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid Grid.Row="0" Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Button
									x:Name="PART_PreviousButton"
									Grid.Column="0"
									Width="30"
									Height="30"
									Content="◀" />
								<Button
									x:Name="PART_HeaderButton"
									Grid.Column="1"
									FontSize="14"
									FontWeight="SemiBold"
									HorizontalContentAlignment="Center" />
								<Button
									x:Name="PART_NextButton"
									Grid.Column="2"
									Width="30"
									Height="30"
									Content="▶" />
							</Grid>
							<Grid
								x:Name="PART_MonthView"
								Grid.Row="1"
								HorizontalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="38" />
									<ColumnDefinition Width="38" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="24" />
									<RowDefinition Height="38" />
									<RowDefinition Height="38" />
									<RowDefinition Height="38" />
									<RowDefinition Height="38" />
									<RowDefinition Height="38" />
									<RowDefinition Height="38" />
								</Grid.RowDefinitions>
							</Grid>
							<Grid
								x:Name="PART_YearView"
								Grid.Row="1"
								HorizontalAlignment="Center">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="66" />
									<ColumnDefinition Width="66" />
									<ColumnDefinition Width="66" />
									<ColumnDefinition Width="66" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="44" />
									<RowDefinition Height="44" />
									<RowDefinition Height="44" />
								</Grid.RowDefinitions>
							</Grid>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Calendar 껍데기 — PART_Root 안에 PART_CalendarItem 하나만 얹는다. 우리 CalendarItemStyle 을
	     명시로 줘야 그 안의 날짜 칸들이 위 세 스타일을 실제로 찾는다(K-13).  -->
	<Style x:Key="Console.DateTimeRange.CalendarStyle" TargetType="{x:Type Calendar}">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Calendar}">
					<Grid x:Name="PART_Root">
						<CalendarItem
							x:Name="PART_CalendarItem"
							Style="{StaticResource Console.DateTimeRange.CalendarItemStyle}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type c:DateTimeRangeField}">
		<Setter Property="Height" Value="32" />
		<!--  D-30 — 전체값은 항상 ToolTip 에 있다(트리거 글자가 tier 로 짧아져도 정보는 새지 않는다).
		     각 Binding 이 개별로 Console.FixedDateTime 을 거쳐 이미 문자열이 된 뒤, MultiBinding.StringFormat
		     은 그 문자열 둘을 "{0} ~ {1}" 로 잇기만 한다(문화권 재해석 없음).  -->
		<Setter Property="ToolTip">
			<Setter.Value>
				<MultiBinding StringFormat="{}{0} ~ {1}">
					<Binding Converter="{StaticResource Console.FixedDateTime}" Path="RangeStart" RelativeSource="{RelativeSource Self}" />
					<Binding Converter="{StaticResource Console.FixedDateTime}" Path="RangeEnd" RelativeSource="{RelativeSource Self}" />
				</MultiBinding>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type c:DateTimeRangeField}">
					<!--  Grid 가 비어 있으면(RowDefinitions/ColumnDefinitions 없음) 암시 열이 Star 가 되어
					     StackPanel 처럼 폭 무제한인 부모 밑에서도 내용에 안 맞춰 잘린다(실측: "2026-" 로 잘림).
					     열을 Auto 로 못박아 내용 폭 그대로 커지게 한다.  -->
					<Grid HorizontalAlignment="Left">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<!--  ⚠ Style 를 명시로 비운다 — 안 비우면 앱 스코프의 MD3 암시 ToggleButton(스위치, 고정
						     Width)이 이겨서 내용이 그 좁은 틀 안으로 잘린다(실측: "yyyy-MM-dd HH:mm ~ …" 가
						     "2026-" 로 잘림 — K-02 와 같은 실패 모드, Template 재정의만으론 Width Setter 까지는
						     못 막는다).  -->
						<ToggleButton
							x:Name="PART_Trigger"
							Height="32"
							Padding="10,0"
							HorizontalAlignment="Left"
							HorizontalContentAlignment="Left"
							Background="{DynamicResource SurfaceBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							Cursor="Hand"
							IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
							Style="{x:Null}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border
										Background="{TemplateBinding Background}"
										BorderBrush="{TemplateBinding BorderBrush}"
										BorderThickness="{TemplateBinding BorderThickness}"
										CornerRadius="4">
										<ContentPresenter
											Margin="{TemplateBinding Padding}"
											HorizontalAlignment="Left"
											VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</ToggleButton.Template>
							<StackPanel Orientation="Horizontal">
								<!--  D-30 — DisplayStartText/DisplayEndText 는 이 컨트롤이 실제로 배정받은 폭에 맞춰
								     이미 tier 로 짧아진 글자다(RangeStart/RangeEnd 를 직접 포매팅하지 않는다).
								     전체 정밀도는 이 요소 트리 루트의 ToolTip 에 항상 있다.  -->
								<TextBlock
									x:Name="PART_StartText"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding FromAutomationId, RelativeSource={RelativeSource TemplatedParent}}"
									FontSize="12"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding DisplayStartText, RelativeSource={RelativeSource TemplatedParent}}" />
								<TextBlock
									Margin="6,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="~" />
								<TextBlock
									x:Name="PART_EndText"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding ToAutomationId, RelativeSource={RelativeSource TemplatedParent}}"
									FontSize="12"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding DisplayEndText, RelativeSource={RelativeSource TemplatedParent}}" />
								<Path
									Width="13"
									Height="13"
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									Data="M9,11H7V13H9V11M13,11H11V13H13V11M17,11H15V13H17V11M19,3H18V1H16V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V8H19V19Z"
									Fill="{DynamicResource TextSecondaryBrush}"
									Stretch="Uniform" />
							</StackPanel>
						</ToggleButton>

						<!--  팝업 — 트리거 바로 아래, 클릭한 그 자리에 뜬다(AllowsTransparency=그림자 위해).  -->
						<Popup
							x:Name="PART_Popup"
							AllowsTransparency="True"
							IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
							Placement="Bottom"
							PlacementTarget="{Binding ElementName=PART_Trigger}"
							PopupAnimation="Fade"
							StaysOpen="False">
							<Border
								x:Name="PART_PopupContent"
								Margin="0,4,0,0"
								Padding="14"
								Background="{DynamicResource SurfaceBrush}"
								BorderBrush="{DynamicResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="4"
								Focusable="True"
								FocusVisualStyle="{x:Null}">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.28"
										ShadowDepth="2" />
								</Border.Effect>
								<StackPanel Width="320">
									<Calendar
										x:Name="PART_Calendar"
										HorizontalAlignment="Center"
										AutomationProperties.AutomationId="Console.DateTimeRange.Calendar"
										Language="ko-KR"
										SelectionMode="SingleRange"
										Style="{StaticResource Console.DateTimeRange.CalendarStyle}" />
									<Grid Margin="0,10,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="12" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock
												Margin="0,0,0,2"
												FontSize="11"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="시작 시각" />
											<md:TimePicker
												x:Name="PART_StartTime"
												AutomationProperties.AutomationId="Console.DateTimeRange.StartTime"
												Is24Hours="True"
												Language="ko-KR"
												WithSeconds="False" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock
												Margin="0,0,0,2"
												FontSize="11"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="종료 시각" />
											<md:TimePicker
												x:Name="PART_EndTime"
												AutomationProperties.AutomationId="Console.DateTimeRange.EndTime"
												Is24Hours="True"
												Language="ko-KR"
												WithSeconds="False" />
										</StackPanel>
									</Grid>
									<!--  미리보기 — 커밋 전 "지금 고른 값" 을 글자로 못박는다(라이트에서 Primary=Selection
									     동색 문제를 형태로 우회 — 요구사항 6).  -->
									<Border
										Margin="0,10,0,0"
										Padding="8,6"
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										CornerRadius="3">
										<TextBlock
											x:Name="PART_Preview"
											AutomationProperties.AutomationId="Console.DateTimeRange.Preview"
											FontFamily="{DynamicResource MonoFont}"
											FontSize="12"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding PreviewText, RelativeSource={RelativeSource TemplatedParent}}"
											TextAlignment="Center" />
									</Border>
									<Grid Margin="0,10,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="8" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Button
											x:Name="PART_Cancel"
											Grid.Column="0"
											AutomationProperties.AutomationId="Console.DateTimeRange.Cancel"
											Content="취소"
											Style="{DynamicResource Console.Button}" />
										<Button
											x:Name="PART_Apply"
											Grid.Column="2"
											AutomationProperties.AutomationId="Console.DateTimeRange.Apply"
											Content="적용"
											Style="{DynamicResource Console.Button.Primary}" />
									</Grid>
								</StackPanel>
							</Border>
						</Popup>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  다이얼로그 가족 T4 (N-05) — 새 사전 하나로 들어온다. 이 줄 하나만 더한다.  -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Utils;component/Themes/Dialogs.xaml" />
	</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
