<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        IMPL-03 — Tokens.Dark = Tactical Command Dark (스토리보드 적용).
        컨셉 변경(2026-06-25, 사용자): Modern → Tactical Command (다크 우선 C2).
        storyboard.html [data-concept="tactical"][data-theme="dark"]. Tokens.Light와 동일 키셋(린터 파리티).
        primary=시안 #22B8D9, accent=앰버 #F0A33C, onPrimary=어두움(시안 위 대비).
    -->

    <!-- ══ Surfaces ══ -->
    <SolidColorBrush x:Key="BgBrush"            Color="#0C1117" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#161D26" />
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="#1E2832" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0F151C" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#243240" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2E3F4D" />

    <!--
        ══ Borders / Dividers ══
        K-03(측정) — 옛 값: Border/Surface 1.46 · Divider/SurfaceAlt 1.13(사실상 안 보임).
        다크에서는 검색 상자 바탕(Sunken)과 툴바(Surface)가 1.08 이라 테두리가 없으면 입력칸 경계가 사라진다.
        구조선은 3:1 대역으로 올리고, 표의 행 구분선은 RowLineBrush 로 떼어 ~2:1 에 둔다.
    -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#5F7185" /><!-- vs Surface 3.38 · Sunken 3.66 · SurfaceAlt 2.98 -->
    <SolidColorBrush x:Key="DividerBrush" Color="#5A6C80" /><!-- 구조 구분선 — vs Surface 3.14 · SurfaceAlt 2.77 -->
    <SolidColorBrush x:Key="RowLineBrush" Color="#455667" /><!-- 표 행 구분선 — vs SurfaceAlt 1.98 · Surface 2.25 -->

    <!-- ══ Text ══ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E6EDF3" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6B4C2" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#8493A2" />

    <!-- ══ Primary / Accent ══ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#22B8D9" /><!-- tactical cyan -->
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#3FCBE8" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#1E3640" />
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#04161C" /><!-- 시안 위 어두운 텍스트 -->
    <SolidColorBrush x:Key="OnPrimaryFixedBrush" Color="#04161C" /><!-- 헤더 텍스트(시안 위 어두움) -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#F0A33C" /><!-- tactical amber -->

    <!-- ══ Status (hue-lock) ══ -->
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#FF5A52" />
    <SolidColorBrush x:Key="DangerSurfaceBrush"  Color="#2A1A1C" />
    <SolidColorBrush x:Key="DangerBorderBrush"   Color="#5A2E30" />
    <SolidColorBrush x:Key="DangerHoverBrush"    Color="#3A2123" />
    <SolidColorBrush x:Key="StatusWarningBrush"  Color="#FFB02E" />
    <SolidColorBrush x:Key="StatusNormalBrush"   Color="#46D17A" />
    <SolidColorBrush x:Key="StatusInfoBrush"     Color="#4FB8FF" />

    <!-- ══ Scrim (alpha) ══ -->
    <SolidColorBrush x:Key="ScrimModalBrush" Color="#B8040810" /><!-- rgba(4,8,12,.72) -->
    <SolidColorBrush x:Key="ScrimSplitBrush" Color="#C8040810" />

    <!-- ══ Misc ══ -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#2A9FE6" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3FCBE8" />

    <!-- ══ Event/KPI 반투명 틴트 (severity) ══ -->
    <SolidColorBrush x:Key="TintInfoBrush"     Color="#2A4FB8FF" /><!-- 정보 틴트 -->
    <SolidColorBrush x:Key="TintSuccessBrush"  Color="#2A46D17A" /><!-- 성공 틴트 -->
    <SolidColorBrush x:Key="TintCriticalBrush" Color="#33FF5A52" /><!-- 위험 틴트 -->
    <!--  K-04 — 라이트와 같은 이유로 올린다(측정: 0x33 은 미적용 막대가 제 바탕과 1.34:1).  -->
    <SolidColorBrush x:Key="TintWarningBrush"  Color="#55FFB02E" /><!-- 경고 틴트 -->
    <SolidColorBrush x:Key="TintAccentBrush"   Color="#3322B8D9" /><!-- 강조 틴트(cyan) -->
    <SolidColorBrush x:Key="SurfaceTranslucentBrush" Color="#CC161D26" /><!-- 반투명 표면 -->

    <!-- ══ 차트 시리즈 8색 (pidsgroup-rightclick FR-11 — 전 센서 색+라인, 인덱스 순환. validate_palette 6종 검사 통과) ══ -->
    <SolidColorBrush x:Key="ChartSeries1Brush" Color="#1490AC" /><!-- series cyan(dk) -->
    <SolidColorBrush x:Key="ChartSeries2Brush" Color="#BF7C16" /><!-- series amber(dk) -->
    <SolidColorBrush x:Key="ChartSeries3Brush" Color="#A371F7" /><!-- series purple -->
    <SolidColorBrush x:Key="ChartSeries4Brush" Color="#3FA352" /><!-- series green(dk) -->
    <SolidColorBrush x:Key="ChartSeries5Brush" Color="#C75B9B" /><!-- series magenta(dk) -->
    <SolidColorBrush x:Key="ChartSeries6Brush" Color="#6D8DE0" /><!-- series blue(dk) -->
    <SolidColorBrush x:Key="ChartSeries7Brush" Color="#C96A4A" /><!-- series terracotta(dk) -->
    <SolidColorBrush x:Key="ChartSeries8Brush" Color="#2F9E8F" /><!-- series teal(dk) -->


</ResourceDictionary>
