<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        IMPL-12 — 공용 컨트롤 토큰 스타일셋 (FR-06). Button / Input / ComboBox / TextBox / PasswordBox.
        원칙:
          · keyed 스타일만(implicit 금지) — 소비자 opt-in. AD-6 Light byte-identical 보존(전역 MD 기본 미오염).
          · 기존 MaterialDesign* BasedOn 유지 — 색/radius/font 만 DynamicResource 토큰으로 오버라이드.
          · 런타임 BasedOn(StaticResource MD키) 해소는 앱 컨텍스트(App.xaml: MD3.Defaults 이후 Theme.Current 병합) 전제.
        토큰: Tokens.Light/Dark(brush) + Tokens.Shared(RadiusSmall/Medium·UiFont·MonoFont).
    -->

    <!-- ═══════════════ Button ═══════════════ -->

    <!-- Primary(contained): 파란 배경 + 흰 글자(white-on-blue) -->
    <Style x:Key="ModernPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <!-- Secondary(outlined): 투명 배경 + 파란 글자/테두리 -->
    <Style x:Key="ModernSecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <!-- Danger(outlined): 위험 색 hue-lock(StatusCritical) -->
    <Style x:Key="ModernDangerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <!-- Text(flat): 강조 없는 보조 액션 -->
    <Style x:Key="ModernTextButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:ButtonAssist.CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <!-- ═══════════════ TextBox / PasswordBox / ComboBox ═══════════════ -->

    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:HintAssist.Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="ModernPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignPasswordBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:HintAssist.Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="md:HintAssist.Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- ═══════════════ TextBlock (본문 / 좌표 readout) ═══════════════ -->

    <Style x:Key="ModernBodyText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <!-- 좌표/수치 monospace readout (Modern 컨셉: 모노 좌표) -->
    <Style x:Key="ModernMonoText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>

</ResourceDictionary>
