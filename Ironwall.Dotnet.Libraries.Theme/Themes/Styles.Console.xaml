<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<!--
		콘솔(T1) 공용 스타일 (console-kernel PRD · IMPL-05, K-02 승격 2026-09-21).
		· 키는 전부 "Console." 접두. 암시적 스타일(키 없는 TargetType) 0 — 기존 그리드 · 버튼을 건드리지 않는다.
		· 색은 DynamicResource 토큰만. 테마 스왑에 동참한다.
		· 선택 = 좌측 3px 세로 바(색이 아니라 형태). 드롭 위치의 가로 삽입선과 축이 직교한다.
		· 정렬 · 열 재정렬을 끈다 — 화면 순서와 저장 순서가 어긋나면 의미와 자동화 단언이 같이 무너진다.
		치수 정본: docs/design/window-layout-system-storyboard.html (행 38 · 머리글 12.5px · 셀 패딩 12).

		K-02 — 버튼 · 검색 상자는 여기가 정본이다(옛 위치: Utils/Themes/Generic.xaml).
		Generic.xaml 은 테마 사전이라 앱 스코프에서 StaticResource 로 닿지 않는다 → 창들이 MDIX 암시 스타일로
		떨어져 Teal500(#009688) 같은 남의 팔레트가 새어 들어왔다. 이 파일은 Theme.Current 로 앱 스코프에 병합되므로
		창이 {StaticResource Console.Button} 을 쓸 수 있다. 커널 자신은 {DynamicResource} 로 같은 정의를 가져다 쓴다
		(정의는 한 곳뿐 — 두 사전에 같은 키를 두면 조용히 어긋난다).
	-->

	<!--  ═════════ 버튼 ═════════  -->
	<!--
		K-01 — 꺼짐은 Opacity 가 아니다. 0.45 를 걸면 글자와 바탕이 같이 옅어져 대비가 무너진다
		(측정: 꺼진 Primary 글자/판 2.05 라이트 · 켜짐 대 꺼짐 판 차이 2.79 라 꺼진 것이 켜져 보였다).
		꺼짐 = ① 글자 TextMuted ② 판 SurfaceSunken ③ 테두리 BorderBrush 를 명시로 바꿔 끼운다.
		Primary 는 꺼지면 채움을 버린다 — 꺼진 것이 '이 창의 할 일' 로 읽히면 안 된다.
		K-10 — 포커스 고리는 두 겹이다. 안 1px OnPrimary + 밖 2px FocusRing — 라이트에서 FocusRing 과 Primary 가
		같은 색(1.00:1)이라 한 겹으로는 채운 버튼 위에서 사라진다.
	-->
	<Style x:Key="Console.Button" TargetType="ButtonBase">
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="56" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ButtonBase">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4" />
						<!--  포커스는 색이 아니라 바깥 윤곽(형태) — 두 겹이라 어떤 채움 위에서도 읽힌다  -->
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="5"
							Visibility="Collapsed" />
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  맨 뒤 — 꺼짐이 hover · pressed 를 이긴다  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
							<Setter TargetName="Bd" Property="BorderThickness" Value="1" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="Console.Button.Primary"
		BasedOn="{StaticResource Console.Button}"
		TargetType="ButtonBase">
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ButtonBase">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1"
							CornerRadius="4" />
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="5"
							Visibility="Collapsed" />
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  꺼진 Primary 는 채움을 버린다 — 켜진 것과 형태가 다르다  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter Property="FontWeight" Value="Normal" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="Console.Button.Ghost"
		BasedOn="{StaticResource Console.Button}"
		TargetType="ButtonBase">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<Style
		x:Key="Console.Button.Mini"
		BasedOn="{StaticResource Console.Button.Ghost}"
		TargetType="ButtonBase">
		<Setter Property="Height" Value="22" />
		<Setter Property="MinWidth" Value="24" />
		<Setter Property="Padding" Value="4,0" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
	</Style>

	<!--  ═════════ 검색 상자 ═════════  -->
	<Style x:Key="Console.SearchBox" TargetType="TextBox">
		<Setter Property="Height" Value="32" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{DynamicResource SurfaceSunkenBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="4">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="30" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Path
									Width="13"
									Height="13"
									Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
									Fill="{DynamicResource TextMutedBrush}"
									Stretch="Uniform" />
								<TextBlock
									x:Name="Hint"
									Grid.Column="1"
									VerticalAlignment="Center"
									Foreground="{DynamicResource TextMutedBrush}"
									IsHitTestVisible="False"
									Text="{TemplateBinding Tag}"
									TextTrimming="CharacterEllipsis"
									Visibility="Collapsed" />
								<ScrollViewer
									x:Name="PART_ContentHost"
									Grid.Column="1"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Focusable="False" />
							</Grid>
						</Border>
						<!--  K-10 두 겹 고리 — 채운 툴바 위에서도 읽힌다  -->
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="5"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="Hint" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="BorderThickness" Value="2" />
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 체크 상자 (K-02 신설 · K-09 꺼짐은 형태로) ═════════  -->
	<!--
		K-09 — 꺼진 체크 상자는 테두리가 판과 1.36:1(라이트) 이라 사실상 사라졌고, 그래서
		"쓸 수 없음" 과 "안 눌림" 이 구분되지 않았다. 꺼짐은 ① 테두리 TextMuted(4.42:1) ② 안 눌린 상자에는
		대각 빗금 — 색이 아니라 형태로 말한다.
		MDIX 암시 스타일은 체크 색을 Teal500/#0072B8/#03A9F4 세 가지로 흘려 보냈다(측정) — 여기서는 PrimaryBrush 하나.
	-->
	<Style x:Key="Console.CheckBox" TargetType="CheckBox">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid Background="Transparent">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid
							x:Name="BoxHost"
							Width="18"
							Height="18"
							VerticalAlignment="Center">
							<Border
								x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1.4"
								CornerRadius="3" />
							<Path
								x:Name="Check"
								Width="11"
								Height="9"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="M0,4.6 L1.4,3.2 L4.2,6 L9.6,0.6 L11,2 L4.2,8.8 z"
								Fill="{DynamicResource OnPrimaryBrush}"
								Stretch="Fill"
								Visibility="Collapsed" />
							<Rectangle
								x:Name="Dash"
								Width="10"
								Height="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Fill="{DynamicResource OnPrimaryBrush}"
								Visibility="Collapsed" />
							<!--  꺼짐 + 안 눌림 = 대각 빗금(형태). 눌린 채 꺼진 것과 뜻이 겹치지 않는다.  -->
							<Path
								x:Name="Slash"
								Margin="2"
								Data="M0,1 L1,0"
								Stretch="Fill"
								Stroke="{DynamicResource TextMutedBrush}"
								StrokeEndLineCap="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6"
								Visibility="Collapsed" />
							<Border
								x:Name="FocusOuter"
								Margin="-4"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								CornerRadius="6"
								Visibility="Collapsed" />
							<Border
								x:Name="FocusInner"
								Margin="-2"
								BorderBrush="{DynamicResource OnPrimaryBrush}"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed" />
						</Grid>
						<ContentPresenter
							x:Name="Label"
							Grid.Column="1"
							Margin="8,0,0,0"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Check" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsChecked" Value="{x:Null}">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Dash" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  맨 뒤 — 꺼짐이 앞의 모든 상태를 이긴다  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter Property="Cursor" Value="No" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Check" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Dash" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsEnabled" Value="False" />
								<Condition Property="IsChecked" Value="False" />
							</MultiTrigger.Conditions>
							<Setter TargetName="Slash" Property="Visibility" Value="Visible" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 토글 스위치 (K-02 신설) ═════════  -->
	<!--  켜짐 · 꺼짐은 손잡이의 자리(형태)로 말한다 — 색만으로 구분하지 않는다.  -->
	<Style x:Key="Console.ToggleSwitch" TargetType="ToggleButton">
		<Setter Property="Width" Value="38" />
		<Setter Property="Height" Value="20" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid>
						<Border
							x:Name="Track"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1.4"
							CornerRadius="10" />
						<Ellipse
							x:Name="Knob"
							Width="14"
							Height="14"
							Margin="3,0,0,0"
							HorizontalAlignment="Left"
							Fill="{DynamicResource TextSecondaryBrush}" />
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="13"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="11"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
							<Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Cursor" Value="No" />
							<Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 스크롤 막대 (K-08) ═════════  -->
	<!--  옛 값(MDIX 암시): 손잡이 #BBBDC0 / 길 #F2F5F9 = 1.72 — 어디를 잡는지 안 보였다. 손잡이 = TextMuted(4.42~5.83).  -->
	<Style x:Key="Console.ScrollBar.Page" TargetType="RepeatButton">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Rectangle Fill="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.ScrollBar.Thumb" TargetType="Thumb">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Border
						x:Name="Fill"
						Margin="2"
						Background="{DynamicResource TextMutedBrush}"
						CornerRadius="3" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fill" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Fill" Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.ScrollBar" TargetType="ScrollBar">
		<Setter Property="Width" Value="10" />
		<Setter Property="MinWidth" Value="10" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ScrollBar">
					<Border Background="{TemplateBinding Background}">
						<Track x:Name="PART_Track" IsDirectionReversed="True">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Console.ScrollBar.Page}" />
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb MinHeight="24" Style="{StaticResource Console.ScrollBar.Thumb}" />
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Console.ScrollBar.Page}" />
							</Track.IncreaseRepeatButton>
						</Track>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="Orientation" Value="Horizontal">
				<Setter Property="Width" Value="Auto" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="Height" Value="10" />
				<Setter Property="MinHeight" Value="10" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ScrollBar">
							<Border Background="{TemplateBinding Background}">
								<Track x:Name="PART_Track" IsDirectionReversed="False">
									<Track.DecreaseRepeatButton>
										<RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Console.ScrollBar.Page}" />
									</Track.DecreaseRepeatButton>
									<Track.Thumb>
										<Thumb MinWidth="24" Style="{StaticResource Console.ScrollBar.Thumb}" />
									</Track.Thumb>
									<Track.IncreaseRepeatButton>
										<RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Console.ScrollBar.Page}" />
									</Track.IncreaseRepeatButton>
								</Track>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--
		스크롤 막대는 ScrollViewer 가 자기 템플릿 안에서 만든다 — 바깥에서 Style= 을 걸 자리가 없다.
		그래서 소비자 쪽에 붙일 수 있는 얇은 래퍼를 둔다: Style.Resources 의 암시 스타일이 그 부분트리에만 적용된다
		(앱 전역 ScrollBar 는 건드리지 않는다).
	-->
	<Style x:Key="Console.ScrollViewer" TargetType="ScrollViewer">
		<Style.Resources>
			<Style BasedOn="{StaticResource Console.ScrollBar}" TargetType="ScrollBar" />
		</Style.Resources>
	</Style>

	<!--  ═════════ 목록 ═════════  -->
	<Style x:Key="Console.DataGrid.ColumnHeader" TargetType="DataGridColumnHeader">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridColumnHeader">
					<Grid>
						<Border
							Padding="12,8"
							Background="{TemplateBinding Background}"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="0,0,0,1">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
						<Thumb
							x:Name="PART_LeftHeaderGripper"
							Width="6"
							HorizontalAlignment="Left"
							Cursor="SizeWE">
							<Thumb.Template>
								<ControlTemplate TargetType="Thumb">
									<Border Background="Transparent" />
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
						<Thumb
							x:Name="PART_RightHeaderGripper"
							Width="6"
							HorizontalAlignment="Right"
							Cursor="SizeWE">
							<Thumb.Template>
								<ControlTemplate TargetType="Thumb">
									<Border Background="Transparent">
										<Rectangle
											Width="1"
											Margin="0,8"
											HorizontalAlignment="Right"
											Fill="{DynamicResource RowLineBrush}" />
									</Border>
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.DataGrid.Cell" TargetType="DataGridCell">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<Border Padding="12,0" Background="{TemplateBinding Background}">
						<ContentPresenter VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  핸들 열처럼 안쪽 여백이 없어야 하는 셀  -->
	<Style
		x:Key="Console.DataGrid.Cell.Flush"
		BasedOn="{StaticResource Console.DataGrid.Cell}"
		TargetType="DataGridCell">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<Border Background="{TemplateBinding Background}">
						<ContentPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.DataGrid.Row" TargetType="DataGridRow">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridRow">
					<Grid>
						<Border
							x:Name="DGR_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{DynamicResource RowLineBrush}"
							BorderThickness="0,0,0,1">
							<SelectiveScrollingGrid>
								<SelectiveScrollingGrid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</SelectiveScrollingGrid.ColumnDefinitions>
								<SelectiveScrollingGrid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</SelectiveScrollingGrid.RowDefinitions>
								<DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" />
								<!--  RowDetailsTemplate 을 쓰는 창을 위해 — 없으면 상세가 조용히 안 뜬다  -->
								<DataGridDetailsPresenter
									Grid.Row="1"
									Grid.Column="1"
									SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
									Visibility="{TemplateBinding DetailsVisibility}" />
								<!--  선택 = 좌측 3px 바. 가로로 굴려도 제자리에 남는다.  -->
								<Rectangle
									x:Name="Bar"
									Grid.RowSpan="2"
									Grid.ColumnSpan="2"
									Width="3"
									HorizontalAlignment="Left"
									Fill="{DynamicResource PrimaryBrush}"
									IsHitTestVisible="False"
									SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
									Visibility="Collapsed" />
							</SelectiveScrollingGrid>
						</Border>
						<!--  K-10 — 키보드로 짚은 행도 두 겹 고리로 보인다  -->
						<Border
							x:Name="FocusOuter"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
							<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.DataGrid" TargetType="DataGrid">
		<Style.Resources>
			<Style BasedOn="{StaticResource Console.ScrollBar}" TargetType="ScrollBar" />
		</Style.Resources>
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="RowHeight" Value="38" />
		<Setter Property="HeadersVisibility" Value="Column" />
		<Setter Property="GridLinesVisibility" Value="None" />
		<Setter Property="AutoGenerateColumns" Value="False" />
		<Setter Property="CanUserAddRows" Value="False" />
		<Setter Property="CanUserDeleteRows" Value="False" />
		<Setter Property="CanUserResizeRows" Value="False" />
		<Setter Property="CanUserSortColumns" Value="False" />
		<Setter Property="CanUserReorderColumns" Value="False" />
		<Setter Property="SelectionMode" Value="Extended" />
		<Setter Property="SelectionUnit" Value="FullRow" />
		<Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
		<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="ColumnHeaderStyle" Value="{StaticResource Console.DataGrid.ColumnHeader}" />
		<Setter Property="CellStyle" Value="{StaticResource Console.DataGrid.Cell}" />
		<Setter Property="RowStyle" Value="{StaticResource Console.DataGrid.Row}" />
	</Style>

	<!--  순서 드래그 대상 목록 — 가상화를 끈다(화면 밖 행은 드롭 자리가 될 수 없다). 전량 로딩이 전제.  -->
	<Style x:Key="Console.ReorderList" TargetType="ListBox">
		<Style.Resources>
			<Style BasedOn="{StaticResource Console.ScrollBar}" TargetType="ScrollBar" />
		</Style.Resources>
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.CanContentScroll" Value="False" />
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="ListBoxItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="FocusVisualStyle" Value="{x:Null}" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Grid>
									<Border
										x:Name="Bd"
										Background="Transparent"
										BorderBrush="{DynamicResource RowLineBrush}"
										BorderThickness="0,0,0,1" />
									<Rectangle
										x:Name="Bar"
										Width="3"
										HorizontalAlignment="Left"
										Fill="{DynamicResource PrimaryBrush}"
										Visibility="Collapsed" />
									<Border
										x:Name="FocusOuter"
										BorderBrush="{DynamicResource FocusRingBrush}"
										BorderThickness="2"
										Visibility="Collapsed" />
									<Border
										x:Name="FocusInner"
										Margin="2"
										BorderBrush="{DynamicResource OnPrimaryBrush}"
										BorderThickness="1"
										Visibility="Collapsed" />
									<ContentPresenter Margin="6,0" />
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
									</Trigger>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
										<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
										<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 상태 배지 (K-06) ═════════  -->
	<!--
		K-06(측정) — 상태색을 배지 '글자' 에 쓰면 라이트에서 본문 대비가 무너진다:
		StatusWarning 이 제 틴트 위 3.30 · Sunken 위 3.44(본문 기준 4.5 미달).
		그래서 글자는 TextPrimary(Sunken 위 13.41) 가 맡고, 상태색은 점 · 삼각 글리프와 테두리만 맡는다
		— 이 파일이 원래 적어 두었던 "색만으로 뜻을 전하지 않는다" 를 글자에까지 끝까지 민 것이다.
	-->
	<Style x:Key="Console.Pill" TargetType="Border">
		<Setter Property="Padding" Value="7,1" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<!--
			바탕 배지는 테두리를 두르지 않는다 — 이미 나가 있는 창(ByComponentView)의 겉모습을 말없이 바꾸지 않기 위해서다.
			테두리는 상태 변형에만 붙인다: 뜻을 나르는 것이 상태색이고, 그 색은 글자가 아니라 점과 테두리가 맡는다.
		-->
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextElement.FontSize" Value="12" />
	</Style>

	<Style
		x:Key="Console.Pill.Normal"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusNormalBrush}" />
	</Style>

	<Style
		x:Key="Console.Pill.Warning"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
	</Style>

	<Style
		x:Key="Console.Pill.Critical"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
	</Style>

	<Style
		x:Key="Console.Pill.Info"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
	</Style>

	<!--  배지 앞의 점 — 뜻을 나르는 것은 이 글리프다(글자가 아니라).  -->
	<Style x:Key="Console.Pill.Dot" TargetType="Ellipse">
		<Setter Property="Width" Value="7" />
		<Setter Property="Height" Value="7" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
	</Style>
</ResourceDictionary>
