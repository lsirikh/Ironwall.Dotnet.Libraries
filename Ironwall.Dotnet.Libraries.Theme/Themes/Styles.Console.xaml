<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:theme="clr-namespace:Ironwall.Dotnet.Libraries.Theme.Themes">
	<!--
		콘솔(T1) 공용 스타일 (console-kernel PRD · IMPL-05, K-02 승격 2026-09-21).
		· 키는 전부 "Console." 접두. 암시적 스타일(키 없는 TargetType) 0 — 기존 그리드 · 버튼을 건드리지 않는다.
		· 색은 DynamicResource 토큰만. 테마 스왑에 동참한다.
		· 선택 = 좌측 3px 세로 바(색이 아니라 형태). 드롭 위치의 가로 삽입선과 축이 직교한다.
		· 정렬 · 열 재정렬을 끈다 — 화면 순서와 저장 순서가 어긋나면 의미와 자동화 단언이 같이 무너진다.
		치수 정본: docs/design/window-layout-system-storyboard.html (행 38 · 머리글 12.5px · 셀 패딩 12).

		K-02 — 버튼 · 검색 상자는 여기가 정본이다(옛 위치: Utils/Themes/Generic.xaml).
		Generic.xaml 은 테마 사전이라 앱 스코프에서 StaticResource 로 닿지 않는다 → 창들이 MDIX 암시 스타일로
		떨어져 Teal500(#009688) 같은 남의 팔레트가 새어 들어왔다. 이 파일은 Theme.Current 로 앱 스코프에 병합되므로
		창이 {StaticResource Console.Button} 을 쓸 수 있다. 커널 자신은 {DynamicResource} 로 같은 정의를 가져다 쓴다
		(정의는 한 곳뿐 — 두 사전에 같은 키를 두면 조용히 어긋난다).
	-->

	<!--  ═════════ 버튼 ═════════  -->
	<!--
		K-01 — 꺼짐은 Opacity 가 아니다. 0.45 를 걸면 글자와 바탕이 같이 옅어져 대비가 무너진다
		(측정: 꺼진 Primary 글자/판 2.05 라이트 · 켜짐 대 꺼짐 판 차이 2.79 라 꺼진 것이 켜져 보였다).
		꺼짐 = ① 글자 TextMuted ② 판 SurfaceSunken ③ 테두리 BorderBrush 를 명시로 바꿔 끼운다.
		Primary 는 꺼지면 채움을 버린다 — 꺼진 것이 '이 창의 할 일' 로 읽히면 안 된다.
		K-10 — 포커스 고리는 두 겹이다. 안 1px OnPrimary + 밖 2px FocusRing — 라이트에서 FocusRing 과 Primary 가
		같은 색(1.00:1)이라 한 겹으로는 채운 버튼 위에서 사라진다.
	-->
	<Style x:Key="Console.Button" TargetType="ButtonBase">
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="56" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<!--
			U-14 — 가로 정렬은 템플릿이 박지 않고 속성으로 받는다. 옛 템플릿은 Center 를 못박아
			목록형 버튼(프리셋 목록 · 그룹 체크 행처럼 HorizontalContentAlignment=Left/Stretch 를 주는 자리)이
			커널로 옮겨 오면 조용히 가운데로 몰렸다. 기본값은 여전히 Center 라 기존 버튼의 겉모습은 그대로다.
		-->
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ButtonBase">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4" />
						<!--  포커스는 색이 아니라 바깥 윤곽(형태) — 두 겹이라 어떤 채움 위에서도 읽힌다  -->
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="5"
							Visibility="Collapsed" />
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  맨 뒤 — 꺼짐이 hover · pressed 를 이긴다  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
							<Setter TargetName="Bd" Property="BorderThickness" Value="1" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="Console.Button.Primary"
		BasedOn="{StaticResource Console.Button}"
		TargetType="ButtonBase">
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ButtonBase">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1"
							CornerRadius="4" />
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="5"
							Visibility="Collapsed" />
						<ContentPresenter
							Margin="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--
							꺼진 Primary 는 채움을 버린다 — 켜진 것과 형태가 다르다.
							U-14 — 굵기는 바꾸지 않는다. 옛 판은 꺼질 때 FontWeight 를 Normal 로 내려, 행을 고를 때마다
							켜지고 꺼지는 버튼(예: 이벤트 콘솔의 [조치보고 (N)])이 그때마다 몇 px 씩 넓어졌다 줄었다 했다 —
							"고를 때마다 버튼 크기가 바뀐다" 신고의 한 갈래. 꺼짐은 채움 · 글자색(형태)으로 이미 충분히 말한다.
						-->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style
		x:Key="Console.Button.Ghost"
		BasedOn="{StaticResource Console.Button}"
		TargetType="ButtonBase">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<Style
		x:Key="Console.Button.Mini"
		BasedOn="{StaticResource Console.Button.Ghost}"
		TargetType="ButtonBase">
		<Setter Property="Height" Value="22" />
		<Setter Property="MinWidth" Value="24" />
		<Setter Property="Padding" Value="4,0" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
	</Style>

	<!--
		U-14 — 아이콘만 있는 버튼. 이 키가 없어 창마다 MaterialDesignIconButton(48 원형 · 물결)을 쓰는 바람에
		같은 줄에서 커널 버튼(32 사각)과 MD 버튼(48 원형)이 섞였다. 새 치수를 만들지 않는다 — 한 변은
		Console.Button 의 높이(32 = ConsoleLayoutMath.InputHeight) 그대로, 템플릿 · 두 겹 포커스 고리 ·
		hover/pressed/꺼짐은 Ghost 를 그대로 물려받는다(정의는 한 곳뿐).
		MinWidth 를 0 으로 푸는 이유: 칩 안의 ✕ 처럼 자리에서 Width/Height 를 16~18 로 줄여야 하는 곳이 있는데,
		WPF 는 MinWidth 가 Width 를 이긴다 — Ghost 의 56 을 물려받으면 작은 ✕ 가 56 폭으로 부풀어 칩을 밀어낸다.
	-->
	<Style
		x:Key="Console.Button.Icon"
		BasedOn="{StaticResource Console.Button.Ghost}"
		TargetType="ButtonBase">
		<Setter Property="Width" Value="32" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<!--
		U-17 — 콘솔 머리(SurfaceAlt)의 닫기 ✕. 콘솔마다 따로 만들던 것(계정 Acc.CloseButton · 보고서 "닫기" 글자 버튼 ·
		호스트 카드의 시안 머리 ModernPanelCloseButton)을 하나로 모은다. 치수 · hover · 두 겹 고리 · 꺼짐은 Icon 을 그대로 물려받는다.
		· 도움말은 <b>왼쪽</b>에 띄운다 — 머리 오른쪽 끝의 버튼이라 기본(마우스 아래)으로 띄우면 콘솔 오른쪽 가장자리 밖으로
		  삐져나온 흰 사각형("닫기")이 상세 칸 머리 위에 걸렸다(계정 콘솔 실창 캡처 · MD3 도움말은 다크에서 밝은 판이다).
		· 글자가 없는 버튼이라 UIA 이름을 직접 준다 — 비워 두면 자동화 트리에서 이름 없는 Button 으로 보인다.
		· 글리프는 버튼의 Foreground 를 따른다(Ghost = TextSecondary, 꺼지면 TextMuted).
	-->
	<Style
		x:Key="Console.Button.Close"
		BasedOn="{StaticResource Console.Button.Icon}"
		TargetType="ButtonBase">
		<Setter Property="ToolTip" Value="닫기" />
		<Setter Property="ToolTipService.Placement" Value="Left" />
		<Setter Property="AutomationProperties.Name" Value="닫기" />
		<Setter Property="ContentTemplate">
			<Setter.Value>
				<DataTemplate>
					<Path
						Width="11"
						Height="11"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Data="M0.9,0 L5.5,4.6 L10.1,0 L11,0.9 L6.4,5.5 L11,10.1 L10.1,11 L5.5,6.4 L0.9,11 L0,10.1 L4.6,5.5 L0,0.9z"
						Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}"
						Stretch="Uniform" />
				</DataTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		U-14 — Primary 로 채운 머리(옛 이벤트 카드의 ColorZone 머리) 위에 앉는 아이콘 버튼. 옛 자리는
		MaterialDesignToolForegroundButton 이었다. Console.Button.Icon 을 그대로 얹으면 hover 판이 SurfaceHover
		(밝은 회색)라 그 위의 OnPrimaryFixed 글리프(라이트=흰색)가 hover 순간 사라진다 — 그래서 Primary 버튼의
		템플릿(hover = PrimaryHover · 누름 = 테두리 TextPrimary · 두 겹 고리)을 물려받고 채움만 비운다.
		글리프는 OnPrimaryFixed(라이트 흰색 · 다크 짙은 잉크) — 같은 머리의 제목 글자와 같은 토큰이다.
	-->
	<Style
		x:Key="Console.Button.Icon.OnPrimary"
		BasedOn="{StaticResource Console.Button.Primary}"
		TargetType="ButtonBase">
		<Setter Property="Width" Value="32" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>

	<!--
		U-14 — 되돌릴 수 없는 동작(삭제 등). 위험은 색 하나가 아니라 테두리(형태) + 바탕으로 말한다.
		왜 커널에 두나: Accounts(Acc.Btn.Danger) · Reports(Local.Button.Mini.Danger) 가 이미 같은 것을 뷰마다
		따로 만들었고, 부대 콘솔은 Outlined 버튼에 Foreground 를 로컬로 박아 두었다 — 로컬 값은 템플릿 트리거를
		이기므로 꺼져도 빨간 글자가 남아 K-01(꺼짐 = 형태) 이 깨졌다. Style Setter 로 주면 꺼짐 트리거가 이긴다.
		모양은 Accounts 의 선례(테두리 StatusCritical · 바탕 DangerSurface · SemiBold)를 그대로 옮겼다.
	-->
	<Style
		x:Key="Console.Button.Danger"
		BasedOn="{StaticResource Console.Button}"
		TargetType="ButtonBase">
		<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
		<Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!--
		행 안의 작은 위험 동작(목록 행의 "삭제"). 옆의 Console.Button.Mini("수정")와 같은 22px 로 맞춘다 —
		Danger(32px · 채움)를 행에 넣으면 같은 줄에서 두 버튼 높이가 달라진다. 위험은 테두리(형태)+글자색으로 말하고,
		Setter 로 주므로 꺼짐 트리거가 이긴다(K-01).
	-->
	<Style
		x:Key="Console.Button.Mini.Danger"
		BasedOn="{StaticResource Console.Button.Mini}"
		TargetType="ButtonBase">
		<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
	</Style>

	<!--
		임의 내용을 감싸는 "투명한 행" 버튼용 템플릿(K-17) — Console.Button 계열과 달리 Style 이 아니라
		Template 하나만 준다. 이런 버튼은 이미 자기 자리에서 Background·BorderThickness·Padding·Height 를
		로컬로 정해 두고(예: 표 행 전체를 감싸는 버튼) Console.Button 의 고정 Height=32 · Padding 12,0 을
		강제로 얹으면 레이아웃이 깨진다 — 반대로 Style 을 아예 안 주면(무명시) 앱 스코프의 MD3 암시
		Button 스타일이 떨어져 테두리도 배경도 없는 자리에 틸 채움·36px 높이 chrome 이 새어 든다.
		그래서 여기는 <c>Template</c> 프로퍼티만 준다 — 로컬 Background/BorderThickness/Padding 은
		TemplateBinding 으로 그대로 존중하고, ContentPresenter 하나로 그 외 chrome 을 전부 걷어낸다.
	-->
	<ControlTemplate x:Key="Console.Button.TransparentRow" TargetType="Button">
		<Border
			Background="{TemplateBinding Background}"
			BorderBrush="{TemplateBinding BorderBrush}"
			BorderThickness="{TemplateBinding BorderThickness}"
			Padding="{TemplateBinding Padding}">
			<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
		</Border>
	</ControlTemplate>

	<!--  ═════════ 검색 상자 ═════════  -->
	<Style x:Key="Console.SearchBox" TargetType="TextBox">
		<Setter Property="Height" Value="32" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<!--  U-18 — 좁아서 안내 글(Hint)이 줄임표로 잘렸을 때만 전체 안내를 툴팁으로(잘림 감사: 계정 · 장비 900).  -->
		<Setter Property="theme:TrimmedToolTip.IsEnabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{DynamicResource SurfaceSunkenBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="4">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="30" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Path
									Width="13"
									Height="13"
									Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
									Fill="{DynamicResource TextMutedBrush}"
									Stretch="Uniform" />
								<!--
									U-17 — 오른쪽 여백 8. 검색 상자는 오른쪽 정렬이라 자기 폭을 내용(=이 안내 글)에 맞춘다 —
									여백이 없으면 마지막 글자가 테두리에 붙어 "잘린 것처럼" 보였고(계정 콘솔 "…부서 검색" 실창 캡처),
									칸이 모자랄 때도 줄임표가 테두리 바로 위에 찍혔다. 입력 칸(PART_ContentHost)의 6 과 같은 결.
								-->
								<TextBlock
									x:Name="Hint"
									Grid.Column="1"
									Margin="0,0,8,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource TextMutedBrush}"
									IsHitTestVisible="False"
									Text="{TemplateBinding Tag}"
									TextTrimming="CharacterEllipsis"
									Visibility="Collapsed" />
								<ScrollViewer
									x:Name="PART_ContentHost"
									Grid.Column="1"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Focusable="False" />
							</Grid>
						</Border>
						<!--  K-10 두 겹 고리 — 채운 툴바 위에서도 읽힌다  -->
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="7"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="5"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="Text" Value="{x:Static sys:String.Empty}">
							<Setter TargetName="Hint" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="BorderThickness" Value="2" />
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 체크 상자 (K-02 신설 · K-09 꺼짐은 형태로) ═════════  -->
	<!--
		K-09 — 꺼진 체크 상자는 테두리가 판과 1.36:1(라이트) 이라 사실상 사라졌고, 그래서
		"쓸 수 없음" 과 "안 눌림" 이 구분되지 않았다. 꺼짐은 ① 테두리 TextMuted(4.42:1) ② 안 눌린 상자에는
		대각 빗금 — 색이 아니라 형태로 말한다.
		MDIX 암시 스타일은 체크 색을 Teal500/#0072B8/#03A9F4 세 가지로 흘려 보냈다(측정) — 여기서는 PrimaryBrush 하나.
	-->
	<Style x:Key="Console.CheckBox" TargetType="CheckBox">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid Background="Transparent">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid
							x:Name="BoxHost"
							Width="18"
							Height="18"
							VerticalAlignment="Center">
							<Border
								x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="1.4"
								CornerRadius="3" />
							<Path
								x:Name="Check"
								Width="11"
								Height="9"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Data="M0,4.6 L1.4,3.2 L4.2,6 L9.6,0.6 L11,2 L4.2,8.8 z"
								Fill="{DynamicResource OnPrimaryBrush}"
								Stretch="Fill"
								Visibility="Collapsed" />
							<Rectangle
								x:Name="Dash"
								Width="10"
								Height="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Fill="{DynamicResource OnPrimaryBrush}"
								Visibility="Collapsed" />
							<!--  꺼짐 + 안 눌림 = 대각 빗금(형태). 눌린 채 꺼진 것과 뜻이 겹치지 않는다.  -->
							<Path
								x:Name="Slash"
								Margin="2"
								Data="M0,1 L1,0"
								Stretch="Fill"
								Stroke="{DynamicResource TextMutedBrush}"
								StrokeEndLineCap="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="1.6"
								Visibility="Collapsed" />
							<Border
								x:Name="FocusOuter"
								Margin="-4"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								CornerRadius="6"
								Visibility="Collapsed" />
							<Border
								x:Name="FocusInner"
								Margin="-2"
								BorderBrush="{DynamicResource OnPrimaryBrush}"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed" />
						</Grid>
						<ContentPresenter
							x:Name="Label"
							Grid.Column="1"
							Margin="8,0,0,0"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Check" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsChecked" Value="{x:Null}">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Dash" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  맨 뒤 — 꺼짐이 앞의 모든 상태를 이긴다  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter Property="Cursor" Value="No" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Check" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Dash" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsEnabled" Value="False" />
								<Condition Property="IsChecked" Value="False" />
							</MultiTrigger.Conditions>
							<Setter TargetName="Slash" Property="Visibility" Value="Visible" />
						</MultiTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 라디오 버튼 (K-15 신설) ═════════  -->
	<!--
		Console.CheckBox 와 같은 언어(원 안의 점, 라벨 굵기·크기 불변). product XAML 의 무명시
		RadioButton 이 MD3 암시 스타일(원 채움 색이 토큰이 아니다)로 떨어지는 문제를 이 키로 막는다 —
		"버튼 계열은 암시 스타일 0, 전부 Console.* 명시" 원칙은 버튼뿐 아니라 라디오에도 적용된다.
	-->
	<Style x:Key="Console.RadioButton" TargetType="RadioButton">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RadioButton">
					<Grid Background="Transparent">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid
							x:Name="BoxHost"
							Width="18"
							Height="18"
							VerticalAlignment="Center">
							<Ellipse
								x:Name="Bd"
								Fill="{TemplateBinding Background}"
								Stroke="{TemplateBinding BorderBrush}"
								StrokeThickness="1.4" />
							<Ellipse
								x:Name="Dot"
								Width="8"
								Height="8"
								Fill="{DynamicResource OnPrimaryBrush}"
								Visibility="Collapsed" />
							<Border
								x:Name="FocusOuter"
								Margin="-4"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								CornerRadius="13"
								Visibility="Collapsed" />
							<Border
								x:Name="FocusInner"
								Margin="-2"
								BorderBrush="{DynamicResource OnPrimaryBrush}"
								BorderThickness="1"
								CornerRadius="11"
								Visibility="Collapsed" />
						</Grid>
						<ContentPresenter
							x:Name="Label"
							Grid.Column="1"
							Margin="8,0,0,0"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							RecognizesAccessKey="True" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Bd" Property="Fill" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Dot" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  맨 뒤 — 꺼짐이 앞의 모든 상태를 이긴다  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter Property="Cursor" Value="No" />
							<Setter TargetName="Bd" Property="Fill" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Bd" Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 칩 · 탭 (단일 선택 필터, K-16 신설) ═════════  -->
	<!--
		U-12/U-13 — 칩 · 필터 버튼을 고를 때 폭이 흔들렸다: 창마다 있던 로컬 사본(EventDashboardView
		의 ConsoleChip/ConsoleTab, DetectionHistoryDialogView 의 PeriodSegButton/FilterChip(Compact),
		ByComponentView 의 ByComponent.Chip 등)이 IsChecked/IsSelected 에서 라벨에
		FontWeight="SemiBold"/"Bold" 를 얹으면서 그 폭 증가를 예약해 두지 않았다 — Border 가
		TextBlock/ContentPresenter 폭에 맞춰 크기를 정하는 구조라 그만큼 칩이 넓어졌다. 일부는
		더해 BorderThickness 도 1→2 로 키워(ByComponent.Chip) 두 번 넓어졌다.
		해법: ① 항상 굵은 글자로 잰 "고스트" 사본을 같은 칸에 겹쳐 두어 칩 폭을 처음부터 그만큼
		     예약한다 — 실제 라벨이 나중에 굵어져도 칸은 이미 그 폭이라 그대로다.
		     ② 선택 테두리는 실제 BorderThickness 를 바꾸지 않고, 레이아웃에 참여하지 않는 음수
		     Margin 오버레이 Border 로 그린다(Console.Button 의 FocusOuter/Inner 와 같은 관용구).
	-->
	<Style x:Key="Console.Chip" TargetType="ToggleButton">
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="Padding" Value="10,4" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid>
						<Border
							x:Name="Chip"
							Padding="{TemplateBinding Padding}"
							Background="{DynamicResource SurfaceAltBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="11">
							<Grid>
								<!--  고정폭 예약 — 항상 SemiBold 로 재어, 실제 라벨이 굵어져도 칩이 넓어지지 않는다.  -->
								<TextBlock
									x:Name="Ghost"
									FontWeight="SemiBold"
									IsHitTestVisible="False"
									Opacity="0"
									Text="{TemplateBinding Content}" />
								<TextBlock
									x:Name="Label"
									VerticalAlignment="Center"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{TemplateBinding Content}" />
							</Grid>
						</Border>
						<!--  선택 테두리 — 실제 BorderThickness 는 그대로 두고, 레이아웃 밖 오버레이로 두꺼워 보인다.  -->
						<Border
							x:Name="SelectedRing"
							Margin="-2"
							BorderBrush="{DynamicResource PrimaryBrush}"
							BorderThickness="2"
							CornerRadius="13"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
						<Border
							x:Name="Focus"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="14"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Chip" Property="Background" Value="{DynamicResource TintInfoBrush}" />
							<Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
							<Setter TargetName="SelectedRing" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Focus" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ListBoxItem 칩(다중 목록에서 단일/다중 선택을 칩으로 — 예: "부품으로 찾기" 필터) — 같은 예약 기법.  -->
	<Style x:Key="Console.Chip.ListBoxItem" TargetType="ListBoxItem">
		<Setter Property="Padding" Value="10,4" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBoxItem">
					<Grid>
						<Border
							x:Name="Bd"
							Padding="{TemplateBinding Padding}"
							Background="{DynamicResource SurfaceAltBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="12">
							<Grid>
								<ContentPresenter
									x:Name="Ghost"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									IsHitTestVisible="False"
									Opacity="0"
									TextElement.FontWeight="Bold" />
								<ContentPresenter
									x:Name="Cp"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									TextElement.FontSize="12"
									TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
							</Grid>
						</Border>
						<Border
							x:Name="SelectedRing"
							Margin="-2"
							BorderBrush="{DynamicResource PrimaryBrush}"
							BorderThickness="2"
							CornerRadius="14"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Cp" Property="TextElement.FontWeight" Value="Bold" />
							<Setter TargetName="SelectedRing" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  밑줄 탭(목록 위 필터 줄) — 테두리 두께는 늘 0,0,0,2 로 고정이라 Chip 처럼 오버레이 링이 필요 없다.  -->
	<Style x:Key="Console.Tab" TargetType="ToggleButton">
		<Setter Property="Margin" Value="0,0,4,0" />
		<Setter Property="Padding" Value="14,5" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border
						x:Name="Bd"
						Padding="{TemplateBinding Padding}"
						Background="Transparent"
						BorderBrush="Transparent"
						BorderThickness="0,0,0,2">
						<Grid>
							<TextBlock
								x:Name="Ghost"
								FontWeight="SemiBold"
								IsHitTestVisible="False"
								Opacity="0"
								Text="{TemplateBinding Content}" />
							<TextBlock
								x:Name="Label"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{TemplateBinding Content}" />
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 토글 스위치 (K-02 신설) ═════════  -->
	<!--  켜짐 · 꺼짐은 손잡이의 자리(형태)로 말한다 — 색만으로 구분하지 않는다.  -->
	<Style x:Key="Console.ToggleSwitch" TargetType="ToggleButton">
		<Setter Property="Width" Value="38" />
		<Setter Property="Height" Value="20" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Grid>
						<Border
							x:Name="Track"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="1.4"
							CornerRadius="10" />
						<Ellipse
							x:Name="Knob"
							Width="14"
							Height="14"
							Margin="3,0,0,0"
							HorizontalAlignment="Left"
							Fill="{DynamicResource TextSecondaryBrush}" />
						<Border
							x:Name="FocusOuter"
							Margin="-4"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="13"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="-2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							CornerRadius="11"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
							<Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnPrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Cursor" Value="No" />
							<Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
							<Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 스크롤 막대 (K-08) ═════════  -->
	<!--  옛 값(MDIX 암시): 손잡이 #BBBDC0 / 길 #F2F5F9 = 1.72 — 어디를 잡는지 안 보였다. 손잡이 = TextMuted(4.42~5.83).  -->
	<Style x:Key="Console.ScrollBar.Page" TargetType="RepeatButton">
		<Setter Property="Focusable" Value="False" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RepeatButton">
					<Rectangle Fill="Transparent" />
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.ScrollBar.Thumb" TargetType="Thumb">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Border
						x:Name="Fill"
						Margin="2"
						Background="{DynamicResource TextMutedBrush}"
						CornerRadius="3" />
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Fill" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Fill" Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.ScrollBar" TargetType="ScrollBar">
		<Setter Property="Width" Value="10" />
		<Setter Property="MinWidth" Value="10" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ScrollBar">
					<Border Background="{TemplateBinding Background}">
						<Track x:Name="PART_Track" IsDirectionReversed="True">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Console.ScrollBar.Page}" />
							</Track.DecreaseRepeatButton>
							<Track.Thumb>
								<Thumb MinHeight="24" Style="{StaticResource Console.ScrollBar.Thumb}" />
							</Track.Thumb>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Console.ScrollBar.Page}" />
							</Track.IncreaseRepeatButton>
						</Track>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="Orientation" Value="Horizontal">
				<Setter Property="Width" Value="Auto" />
				<Setter Property="MinWidth" Value="0" />
				<Setter Property="Height" Value="10" />
				<Setter Property="MinHeight" Value="10" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ScrollBar">
							<Border Background="{TemplateBinding Background}">
								<Track x:Name="PART_Track" IsDirectionReversed="False">
									<Track.DecreaseRepeatButton>
										<RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Console.ScrollBar.Page}" />
									</Track.DecreaseRepeatButton>
									<Track.Thumb>
										<Thumb MinWidth="24" Style="{StaticResource Console.ScrollBar.Thumb}" />
									</Track.Thumb>
									<Track.IncreaseRepeatButton>
										<RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Console.ScrollBar.Page}" />
									</Track.IncreaseRepeatButton>
								</Track>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--
		스크롤 막대는 ScrollViewer 가 자기 템플릿 안에서 만든다 — 바깥에서 Style= 을 걸 자리가 없다.
		그래서 소비자 쪽에 붙일 수 있는 얇은 래퍼를 둔다: Style.Resources 의 암시 스타일이 그 부분트리에만 적용된다
		(앱 전역 ScrollBar 는 건드리지 않는다).
	-->
	<Style x:Key="Console.ScrollViewer" TargetType="ScrollViewer">
		<Style.Resources>
			<Style BasedOn="{StaticResource Console.ScrollBar}" TargetType="ScrollBar" />
		</Style.Resources>
	</Style>

	<!--  ═════════ 목록 ═════════  -->
	<Style x:Key="Console.DataGrid.ColumnHeader" TargetType="DataGridColumnHeader">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridColumnHeader">
					<Grid>
						<Border
							Padding="12,8"
							Background="{TemplateBinding Background}"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="0,0,0,1">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
						<Thumb
							x:Name="PART_LeftHeaderGripper"
							Width="6"
							HorizontalAlignment="Left"
							Cursor="SizeWE">
							<Thumb.Template>
								<ControlTemplate TargetType="Thumb">
									<Border Background="Transparent" />
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
						<Thumb
							x:Name="PART_RightHeaderGripper"
							Width="6"
							HorizontalAlignment="Right"
							Cursor="SizeWE">
							<Thumb.Template>
								<ControlTemplate TargetType="Thumb">
									<Border Background="Transparent">
										<Rectangle
											Width="1"
											Margin="0,8"
											HorizontalAlignment="Right"
											Fill="{DynamicResource RowLineBrush}" />
									</Border>
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.DataGrid.Cell" TargetType="DataGridCell">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<Border Padding="12,0" Background="{TemplateBinding Background}">
						<ContentPresenter VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  핸들 열처럼 안쪽 여백이 없어야 하는 셀  -->
	<Style
		x:Key="Console.DataGrid.Cell.Flush"
		BasedOn="{StaticResource Console.DataGrid.Cell}"
		TargetType="DataGridCell">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<Border Background="{TemplateBinding Background}">
						<ContentPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		U-18 — 목록 칸 글자(DataGridTextColumn.ElementStyle). 폭이 모자라면 줄임표로 끝내고, 잘렸을 때만 전체 값을 툴팁으로 준다.
		기본 ElementStyle 은 줄임표가 없어 긴 값이 칸 끝에서 칼로 자른 듯 잘렸다(잘림 감사: 계정 감사 로그 "대상명" · 보고서 "제목").
	-->
	<Style x:Key="Console.DataGrid.CellText" TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="theme:TrimmedToolTip.IsEnabled" Value="True" />
	</Style>

	<Style x:Key="Console.DataGrid.Row" TargetType="DataGridRow">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridRow">
					<Grid>
						<Border
							x:Name="DGR_Border"
							Background="{TemplateBinding Background}"
							BorderBrush="{DynamicResource RowLineBrush}"
							BorderThickness="0,0,0,1">
							<SelectiveScrollingGrid>
								<SelectiveScrollingGrid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</SelectiveScrollingGrid.ColumnDefinitions>
								<SelectiveScrollingGrid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</SelectiveScrollingGrid.RowDefinitions>
								<DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" />
								<!--  RowDetailsTemplate 을 쓰는 창을 위해 — 없으면 상세가 조용히 안 뜬다  -->
								<DataGridDetailsPresenter
									Grid.Row="1"
									Grid.Column="1"
									SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
									Visibility="{TemplateBinding DetailsVisibility}" />
								<!--  선택 = 좌측 3px 바. 가로로 굴려도 제자리에 남는다.  -->
								<Rectangle
									x:Name="Bar"
									Grid.RowSpan="2"
									Grid.ColumnSpan="2"
									Width="3"
									HorizontalAlignment="Left"
									Fill="{DynamicResource PrimaryBrush}"
									IsHitTestVisible="False"
									SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
									Visibility="Collapsed" />
							</SelectiveScrollingGrid>
						</Border>
						<!--  K-10 — 키보드로 짚은 행도 두 겹 고리로 보인다  -->
						<Border
							x:Name="FocusOuter"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
						<Border
							x:Name="FocusInner"
							Margin="2"
							BorderBrush="{DynamicResource OnPrimaryBrush}"
							BorderThickness="1"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="DGR_Border" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
							<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
							<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Console.DataGrid" TargetType="DataGrid">
		<Style.Resources>
			<Style BasedOn="{StaticResource Console.ScrollBar}" TargetType="ScrollBar" />
		</Style.Resources>
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="RowHeight" Value="38" />
		<Setter Property="HeadersVisibility" Value="Column" />
		<Setter Property="GridLinesVisibility" Value="None" />
		<Setter Property="AutoGenerateColumns" Value="False" />
		<Setter Property="CanUserAddRows" Value="False" />
		<Setter Property="CanUserDeleteRows" Value="False" />
		<Setter Property="CanUserResizeRows" Value="False" />
		<Setter Property="CanUserSortColumns" Value="False" />
		<Setter Property="CanUserReorderColumns" Value="False" />
		<Setter Property="SelectionMode" Value="Extended" />
		<Setter Property="SelectionUnit" Value="FullRow" />
		<Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
		<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="ColumnHeaderStyle" Value="{StaticResource Console.DataGrid.ColumnHeader}" />
		<Setter Property="CellStyle" Value="{StaticResource Console.DataGrid.Cell}" />
		<Setter Property="RowStyle" Value="{StaticResource Console.DataGrid.Row}" />
	</Style>

	<!--  순서 드래그 대상 목록 — 가상화를 끈다(화면 밖 행은 드롭 자리가 될 수 없다). 전량 로딩이 전제.  -->
	<Style x:Key="Console.ReorderList" TargetType="ListBox">
		<Style.Resources>
			<Style BasedOn="{StaticResource Console.ScrollBar}" TargetType="ScrollBar" />
		</Style.Resources>
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.CanContentScroll" Value="False" />
		<Setter Property="ItemContainerStyle">
			<Setter.Value>
				<Style TargetType="ListBoxItem">
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					<Setter Property="FocusVisualStyle" Value="{x:Null}" />
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="ListBoxItem">
								<Grid>
									<Border
										x:Name="Bd"
										Background="Transparent"
										BorderBrush="{DynamicResource RowLineBrush}"
										BorderThickness="0,0,0,1" />
									<Rectangle
										x:Name="Bar"
										Width="3"
										HorizontalAlignment="Left"
										Fill="{DynamicResource PrimaryBrush}"
										Visibility="Collapsed" />
									<Border
										x:Name="FocusOuter"
										BorderBrush="{DynamicResource FocusRingBrush}"
										BorderThickness="2"
										Visibility="Collapsed" />
									<Border
										x:Name="FocusInner"
										Margin="2"
										BorderBrush="{DynamicResource OnPrimaryBrush}"
										BorderThickness="1"
										Visibility="Collapsed" />
									<ContentPresenter Margin="6,0" />
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
									</Trigger>
									<Trigger Property="IsSelected" Value="True">
										<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
										<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter TargetName="FocusOuter" Property="Visibility" Value="Visible" />
										<Setter TargetName="FocusInner" Property="Visibility" Value="Visible" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ═════════ 상태 배지 (K-06) ═════════  -->
	<!--
		K-06(측정) — 상태색을 배지 '글자' 에 쓰면 라이트에서 본문 대비가 무너진다:
		StatusWarning 이 제 틴트 위 3.30 · Sunken 위 3.44(본문 기준 4.5 미달).
		그래서 글자는 TextPrimary(Sunken 위 13.41) 가 맡고, 상태색은 점 · 삼각 글리프와 테두리만 맡는다
		— 이 파일이 원래 적어 두었던 "색만으로 뜻을 전하지 않는다" 를 글자에까지 끝까지 민 것이다.
	-->
	<Style x:Key="Console.Pill" TargetType="Border">
		<Setter Property="Padding" Value="7,1" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<!--
			바탕 배지는 테두리를 두르지 않는다 — 이미 나가 있는 창(ByComponentView)의 겉모습을 말없이 바꾸지 않기 위해서다.
			테두리는 상태 변형에만 붙인다: 뜻을 나르는 것이 상태색이고, 그 색은 글자가 아니라 점과 테두리가 맡는다.
		-->
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextElement.FontSize" Value="12" />
	</Style>

	<Style
		x:Key="Console.Pill.Normal"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusNormalBrush}" />
	</Style>

	<Style
		x:Key="Console.Pill.Warning"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
	</Style>

	<Style
		x:Key="Console.Pill.Critical"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
	</Style>

	<Style
		x:Key="Console.Pill.Info"
		BasedOn="{StaticResource Console.Pill}"
		TargetType="Border">
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
	</Style>

	<!--  배지 앞의 점 — 뜻을 나르는 것은 이 글리프다(글자가 아니라).  -->
	<Style x:Key="Console.Pill.Dot" TargetType="Ellipse">
		<Setter Property="Width" Value="7" />
		<Setter Property="Height" Value="7" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
	</Style>

	<!--  ═════════ 날짜/시각 입력 ═════════
	     K-11 — mah:DateTimePicker 내부 달력 토글 버튼은 자기 Style 이 없는 게 아니라
	     Style="{DynamicResource MahApps.Styles.Button.Chromeless}" 로 MahApps 자신의 키를 명시로 찾는다(실측:
	     GitHub MahApps.Metro 2.4.10 Styles/Controls.DatePicker.xaml). ★정정(D-28, 2026-09-23): 호스트 앱
	     (Dotnet.Monitoring.Solution/App.xaml:15-17)은 MahApps 자신의 Controls.xaml·Fonts.xaml·Light.Blue.xaml 을
	     MDIX 보다 먼저 병합해 이 카탈로그를 갖고 있으므로, 호스트에서는 그 DynamicResource 가 정상적으로 풀린다
	     — "이 앱은 MDIX + Theme.Current 만 병합한다"는 예전 진술은 틀렸다. 통짜 사각형 증상(Teal500 #009688,
	     글리프 없음)은 과거 미리보기 도구들(tools/*-console-preview, console-gallery)이 MDIX 만 병합하고
	     MahApps 자신의 사전은 하나도 병합하지 않았던 데서 나온 것이었다 — 즉 이 저장소 실코드의 결함이 아니라
	     미리보기 도구의 병합 목록 누락이 만든 팬텀 증상이었다(실측). tools/shared/HostResources.Pre.xaml 이
	     호스트 목록을 그대로 병합하도록 다섯 도구를 정정해 지금은 도구에서도 재현되지 않는다(단, 다섯 도구의
	     전체 스냅샷 모드를 픽셀 diff 로 훑었을 때 이 토글 글리프 자체를 노출하는 프레임을 찾지 못해 "고쳐지는
	     장면"을 직접 본 것은 아니다 — 병합 목록이 호스트와 바이트 단위로 같아졌다는 코드 사실로 판단한다).
	     같은 조사에서 별개의 프리뷰-하네스 전용 결함이 하나 더 나왔다 — device-console-preview 의 옛 Save()
	     가 VisualBrush 간접 합성을 쓰다 창을 막 띄운 첫 캡처에서 40px 헤더가 통째로 빠지는 결함이 있었다
	     (제품 코드는 처음부터 정상, D-05, 2026-09-23). 즉 "통짜 사각형"과 "빠진 헤더" 둘 다 제품 결함이 아니라
	     미리보기 하네스 자체의 결함이었다 — 프리뷰에서만 보이는 증상은, 그 도구가 호스트에 충실하다고
	     증명되기 전까지는 일단 의심한다.
	     그렇다고 아래 Style.Resources 오버라이드가 불필요해지는 것은 아니다 — 호스트가 카탈로그를 갖고 있어도
	     Culture/워터마크/다크 배경(K-11 나머지 항목, 아래 계속)은 MahApps 2.4.10 의 별개 결함이라 여전히
	     유효하다. 고치는 법은 그 정확한 키 이름으로 우리 정의를 Style.Resources 에 두는 것 — 이 컨트롤 스코프
	     DynamicResource 조회가 Application 보다 먼저 이 사전을 본다. Template 은 손대지 않는다
	     (Background/BorderThickness 만 비우면 컨트롤 자신의 테마 스타일이 글리프까지 그대로 그려진다 —
	     Style setter 는 그 Style 이 정의하지 않은 속성에 한해 테마 스타일로 떨어진다).
	     Culture 를 비워 두면 WPF FrameworkElement.Language 기본값(en-US)으로 떨어져 9/16/2026 3:52:12 PM 처럼
	     미국식 · 초 포함 · AM/PM 으로 렌더링된다(실측). ConsoleDateTimeFormat.FixedCulture(불변 문화권 복제 +
	     yyyy-MM-dd / HH:mm 패턴 + AM/PM 디자이네이터 제거) + SelectedDateFormat=Short + SelectedTimeFormat=Short 로
	     화면 전체 한 표기 yyyy-MM-dd HH:mm(FR-29b, docs/prds/suppression-schedule-prd.md)에 고정한다.
	     워터마크는 MahApps 에 ko 위성 리소스가 없어 영문 "Select a date" 로 뜬다 — Setter 로 명시해 이긴다.
	     ⚠ 이 컨트롤은 워터마크를 입력 위 캡션 줄로 '항상' 그린다(값이 있어도 사라지지 않는다 — TextBox 의
	     사라지는 플레이스홀더와 다르다, 실측: 이 저장소의 실제 결함 스크린샷도 캡션+값 두 줄이 같이 찍혀 있다).
	     그래서 Height 를 32 로 못박지 않는다 — 캡션 줄까지 눌러 겹치는 게 바로 사용자가 신고한 4번째 결함이다.
	     치수: MinHeight=50 은 캡션+값 두 줄이 라이트 · 다크 모두에서 겹치지 않고 렌더링으로 실측한 값
	     (Console.SearchBox 의 Height=32 규약을 그대로 못 쓰는 이유 — FormDateTimePicker 선례도 같은 이유로
	     고정 Height 대신 MinHeight 를 쓴다). Width=188 은 yyyy-MM-dd HH:mm(16자) + 달력 아이콘 버튼이
	     잘리지 않는 값이다.
	-->
	<Style x:Key="Console.DateTimePicker" TargetType="mah:DateTimePicker">
		<Style.Resources>
			<!--  MahApps 자신이 찾는 정확한 키 — 위 주석 참조. 이 컨트롤 스코프 안에서만 재정의한다(전역 아님).  -->
			<!--  달력 토글 버튼의 Content 는 MahApps 자신의 테마 기본 스타일이 달력 Path 데이터 문자열("M34…")로
			     채운다(TemplateBinding, 병합 여부와 무관하게 항상 채워진다 — 실측). 문제는 그 문자열을 Geometry 로
			     그려주는 ContentTemplate 쪽이다 — 그 템플릿 내부의 중첩 ContentControl 이 다시
			     Style="{DynamicResource MahApps.Styles.ContentControl.PathIcon}" 를 찾는데, DataTemplate 안쪽
			     깊숙한 곳이라 이 사전을 안 뒤지는 것으로 보인다(실측: PathIcon 키를 똑같이 정의해도 문자열이
			     그대로 글자로 찍힘). 그래서 ContentTemplate 체인에 기대지 않고, 이 버튼 자신의 Template 에서
			     Content(=Path 데이터 문자열)를 직접 Geometry 로 그린다 — 문자열→Geometry 자동 변환은
			     TemplateBinding 이 아니라 일반 Binding 이라야 GeometryConverter 폴백이 걸린다(실측).  -->
			<Style x:Key="MahApps.Styles.Button.Chromeless" TargetType="ButtonBase">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ButtonBase">
							<Border Background="{TemplateBinding Background}">
								<Viewbox
									Width="15"
									Height="15"
									Stretch="Uniform">
									<Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}" />
								</Viewbox>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!--  다크 배경 결함(4번째) — PART_TextBox 는 WPF 내장 DatePickerTextBox(TextBox 파생)다.
			     실측(시각 트리 덤프): 바깥 mah:DateTimePicker.Background 를 SurfaceBrush 로 바꿔도 'Base' Border 만
			     따라가고, PART_TextBox 는 항상 #FFFFFFFF 고정 — 이 내장 컨트롤의 기본 ControlTemplate 은
			     Background 를 TemplateBinding 하지 않는 것으로 보인다(실측, WPF 소스 미확인). 암시 스타일
			     (키 없는 TargetType)로 재정의하면 이 Style 이 걸린 mah:DateTimePicker 인스턴스가 자기 스코프
			     Resources(=이 Style.Resources)를 템플릿 자식까지 상속시켜 PART_TextBox 에도 닿는다(K-11 의
			     Chromeless 버튼과 같은 스코프 경로). Foreground/CaretBrush 도 같이 재정의하지 않으면 다크에서
			     흰 배경이 사라져도 글자·캐럿이 기본 검정/흰 그대로 남아 대비가 뒤집힌다.  -->
			<Style TargetType="DatePickerTextBox">
				<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
				<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
				<Setter Property="BorderThickness" Value="0" />
			</Style>
		</Style.Resources>
		<Setter Property="Width" Value="188" />
		<Setter Property="MinHeight" Value="50" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="mah:TextBoxHelper.Watermark" Value="날짜 선택" />
		<!--  ⚠ Culture/SelectedDateFormat/SelectedTimeFormat/PickerVisibility 는 평범한 <Setter> 로 걸면
		     실측상 무시된다(en-US · 초 포함 그대로) — 같은 값을 호출부에 로컬 속성으로 쓰면 즉시 반영된다.
		     TimePickerBase 가 이 값들을 내부 파트 최초 구성 시점에만 읽고 Style-Setter 적용 시점의 재평가를
		     타지 않는 것으로 보인다(실측, 정확한 내부 원인은 MahApps 2.4.10 소스 미확인). Trigger 안의 Setter 는
		     별도 재평가 경로를 타 반영된다 — 조건은 이 컨트롤이 항상 참인 IsEnabled=True 로 건다.  -->
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="True">
				<Setter Property="Culture" Value="{x:Static theme:ConsoleDateTimeFormat.FixedCulture}" />
				<Setter Property="SelectedDateFormat" Value="Short" />
				<Setter Property="SelectedTimeFormat" Value="Short" />
				<Setter Property="PickerVisibility" Value="HourMinute" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
