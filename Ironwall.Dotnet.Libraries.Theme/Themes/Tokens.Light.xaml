<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        IMPL-02 — Tokens.Light (적용·현재 출고).
        AD-2: 리터럴 whole-brush. AD-6: 기존 출고 hex byte-identical(Modern 캐노니컬 Light는 후속 visual-refresh).
        PRD §3.3 "Light(적용·현재출고)" 컬럼.

        ⚠ [VER-14 앵커] 표기 토큰 = "(현 ...)"로 PRD에 명시된 MD3/MahApps 시맨틱 기본값 또는
           뷰 인라인 산재값. Phase 1에서는 소비자 미배선이라 외관 영향 0.
           Phase 4 소비 이관 전 외부 앱 실측(VER-14)으로 확정 → 그때 byte-identical 검증.
        그 외 토큰 = byte-identical 확정(기존 DesignTokens.xaml/§3.3 명시 hex).
    -->

    <!-- ══ Surfaces ══ -->
    <SolidColorBrush x:Key="BgBrush"            Color="#FFFBFE" /><!-- VER-14 앵커: 현 윈도우 배경(MD3 Light surface) -->
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFF" /><!-- ← PanelWhiteBrush -->
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="#EEF3FB" /><!-- ← LightBlueBrush -->
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#EAEEF4" /><!-- VER-14 앵커: 현 입력 배경 -->
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#E8F0FE" /><!-- ← BasePropertyStyle hover -->
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#C5D5FB" /><!-- ← BasePropertyStyle pressed -->

    <!-- ══ Borders / Dividers ══ -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#E8ECF1" /><!-- ← BorderGrayBrush -->
    <SolidColorBrush x:Key="DividerBrush" Color="#33000000" /><!-- alpha 브러시 유지(현 구분선) -->

    <!-- ══ Text ══ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1C1B1F" /><!-- VER-14 앵커: 현 본문색(MD3 Light onSurface) -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#999999" />

    <!-- ══ Primary / Accent ══ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#2C5F9E" /><!-- ← PrimaryBlueBrush; MD PrimaryColor 매핑 -->
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#245085" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#DCE8F8" />
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#FFFFFF" /><!-- onPrimary(일반) -->
    <SolidColorBrush x:Key="OnPrimaryFixedBrush" Color="#FFFFFF" /><!-- 양 테마 고정: white-on-blue 헤더(FR-09) -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#0E8C9B" /><!-- VER-14 앵커: 현 보조색(Secondary Cyan) -->

    <!-- ══ Status (hue-lock) ══ -->
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#C0392B" /><!-- ← DangerRedBrush -->
    <SolidColorBrush x:Key="DangerSurfaceBrush"  Color="#FFF5F5" />
    <SolidColorBrush x:Key="DangerBorderBrush"   Color="#FFCDD2" />
    <SolidColorBrush x:Key="DangerHoverBrush"    Color="#FFEBEE" />
    <SolidColorBrush x:Key="StatusWarningBrush"  Color="#FF8E00" /><!-- VER-14 앵커: 현 경고색 -->
    <SolidColorBrush x:Key="StatusNormalBrush"   Color="#2E9E5B" /><!-- VER-14 앵커: 현 정상색 -->
    <SolidColorBrush x:Key="StatusInfoBrush"     Color="#1976D2" /><!-- primary와 분리 유지 -->

    <!-- ══ Scrim (alpha) ══ -->
    <SolidColorBrush x:Key="ScrimModalBrush" Color="#88000000" />
    <SolidColorBrush x:Key="ScrimSplitBrush" Color="#99000000" />

    <!-- ══ Misc ══ -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#007ACC" /><!-- ImageMarker selection (≠ Streaming accent) -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3D7AC4" /><!-- VER-14 앵커: 현 포커스 -->

    <!-- ══ Event/KPI 반투명 틴트 (IMPL-20, Light=byte-identical 기존 hex) ══ -->
    <!-- Dark 값은 다크표면 대비용 별도 — storyboard sb-modern 대조로 정밀화(V-11) -->
    <SolidColorBrush x:Key="TintInfoBrush"     Color="#22111188" /><!-- KPI 정보 틴트(EventInfo) -->
    <SolidColorBrush x:Key="TintSuccessBrush"  Color="#22118811" /><!-- KPI 성공 틴트(EventInfo) -->
    <SolidColorBrush x:Key="TintCriticalBrush" Color="#22FF6464" /><!-- severity 위험 틴트(CameraEventInfo) -->
    <SolidColorBrush x:Key="TintWarningBrush"  Color="#22FFB347" /><!-- severity 경고 틴트 -->
    <SolidColorBrush x:Key="TintAccentBrush"   Color="#224FC3F7" /><!-- severity 정보 틴트(cyan) -->
    <SolidColorBrush x:Key="SurfaceTranslucentBrush" Color="#88FFFFFF" /><!-- flip 카드 반투명 표면 -->

</ResourceDictionary>
