<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        IMPL-02 — Tokens.Light = Modern Operations Light (스토리보드 적용).
        AD-6 변경(2026-06-25, 사용자 요청): 기존 byte-identical 대신 storyboard.html
        modern/light 팔레트로 정렬 — Light 화면이 선택한 Modern Operations 디자인으로 보이도록.
        AD-2: 리터럴 whole-brush. 키셋은 Tokens.Dark와 동일(린터 파리티).
    -->

    <!-- ══ Surfaces ══ -->
    <SolidColorBrush x:Key="BgBrush"            Color="#EEF1F6" /><!-- storyboard bg -->
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFF" /><!-- storyboard surface -->
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="#F6F8FC" /><!-- storyboard surfaceAlt -->
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#EAEEF4" /><!-- storyboard surfaceSunken -->
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#E8F0FE" /><!-- hover(파생) -->
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#C5D5FB" /><!-- pressed(파생) -->

    <!-- ══ Borders / Dividers ══ -->
    <SolidColorBrush x:Key="BorderBrush"  Color="#D8DFE9" /><!-- storyboard border -->
    <SolidColorBrush x:Key="DividerBrush" Color="#E8ECF1" /><!-- storyboard divider -->

    <!-- ══ Text ══ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#1A2230" /><!-- storyboard textPrimary -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5568" /><!-- storyboard textSecondary -->
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#69748A" /><!-- storyboard textMuted -->

    <!-- ══ Primary / Accent ══ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#2C5F9E" /><!-- storyboard primary -->
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#234E85" /><!-- storyboard primaryHover -->
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#DCE8F8" /><!-- 보조 hover(파생) -->
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#FFFFFF" /><!-- storyboard onPrimary -->
    <SolidColorBrush x:Key="OnPrimaryFixedBrush" Color="#FFFFFF" /><!-- 양 테마 고정 white-on-blue(FR-09) -->
    <SolidColorBrush x:Key="AccentBrush"         Color="#0E8C9B" /><!-- storyboard accent -->

    <!-- ══ Status (hue-lock) ══ -->
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#D32F2F" /><!-- storyboard statusCritical -->
    <SolidColorBrush x:Key="DangerSurfaceBrush"  Color="#FCEBEA" /><!-- critical 표면(파생) -->
    <SolidColorBrush x:Key="DangerBorderBrush"   Color="#F4C7C3" /><!-- critical 테두리(파생) -->
    <SolidColorBrush x:Key="DangerHoverBrush"    Color="#F9DDDB" /><!-- critical hover(파생) -->
    <SolidColorBrush x:Key="StatusWarningBrush"  Color="#E08600" /><!-- storyboard statusWarning -->
    <SolidColorBrush x:Key="StatusNormalBrush"   Color="#2E9E5B" /><!-- storyboard statusNormal -->
    <SolidColorBrush x:Key="StatusInfoBrush"     Color="#1976D2" /><!-- storyboard statusInfo -->

    <!-- ══ Scrim (alpha) ══ -->
    <SolidColorBrush x:Key="ScrimModalBrush" Color="#8C101621" /><!-- storyboard scrim rgba(16,22,33,.55) -->
    <SolidColorBrush x:Key="ScrimSplitBrush" Color="#99101621" />

    <!-- ══ Misc ══ -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#007ACC" /><!-- ImageMarker selection -->
    <SolidColorBrush x:Key="FocusRingBrush" Color="#3D7AC4" /><!-- storyboard focusRing -->

    <!-- ══ Event/KPI 반투명 틴트 (IMPL-20) ══ -->
    <SolidColorBrush x:Key="TintInfoBrush"     Color="#22111188" /><!-- KPI 정보 틴트(EventInfo) -->
    <SolidColorBrush x:Key="TintSuccessBrush"  Color="#22118811" /><!-- KPI 성공 틴트(EventInfo) -->
    <SolidColorBrush x:Key="TintCriticalBrush" Color="#22FF6464" /><!-- severity 위험 틴트 -->
    <SolidColorBrush x:Key="TintWarningBrush"  Color="#22FFB347" /><!-- severity 경고 틴트 -->
    <SolidColorBrush x:Key="TintAccentBrush"   Color="#224FC3F7" /><!-- severity 정보 틴트(cyan) -->
    <SolidColorBrush x:Key="SurfaceTranslucentBrush" Color="#88FFFFFF" /><!-- flip 카드 반투명 표면 -->

</ResourceDictionary>
