<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        IMPL-13 — 컨테이너 토큰 스타일셋 (FR-06). DataGrid(헤더/행/hover/selected) · Card · Dialog.
        keyed only, MD BasedOn 유지, 색/radius 만 토큰. 행 높이=RowHeight(Shared, 고밀도 40).
        ※ "draft 행"(Id<=0 임시상태) 강조는 데이터 의존 → 소비자 뷰에서 DataTrigger로 적용
          ([[project_crud_tempstate_canonical]]). 여기선 토큰 기반 일반 행/hover/selected 만 정의.
    -->

    <!-- ═══════════════ DataGrid ═══════════════ -->

    <Style x:Key="ModernDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="RowHeight" Value="{DynamicResource RowHeight}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <Style x:Key="ModernDataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="ModernDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 행: hover / selected 토큰 상태 -->
    <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════ Card ═══════════════ -->

    <Style x:Key="ModernCard" TargetType="md:Card" BasedOn="{StaticResource MaterialDesignElevatedCard}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="UniformCornerRadius" Value="10" /><!-- RadiusMedium(10): Card 속성은 double -->
    </Style>

    <!-- ═══════════════ Dialog ═══════════════ -->

    <!-- 다이얼로그 본체 패널 -->
    <Style x:Key="ModernDialogPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 다이얼로그/패널 헤더 띠: 시안(primary) 바 + on-primary 글씨 (LayerPanel 표준 패턴) -->
    <Style x:Key="ModernDialogHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="8,8,0,0" /><!-- RadiusLarge(8) 상단만 -->
    </Style>

    <Style x:Key="ModernDialogHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════ Panel 표준 패턴 (LayerPanel 스타일, FR-06 확산) ═══════════════ -->

    <!-- 섹션 라벨: 시안 대문자 볼드 (BASIC / COLOR / DISPLAY / OVERLAY MAP …) -->
    <Style x:Key="PanelSectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,10,0,6" />
    </Style>

    <!-- 필드 라벨: 보조 텍스트색(라벨용) -->
    <Style x:Key="PanelFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 표준 패널 카드: 다크 표면 + 1px 헤어라인 + 샤프 코너 (LayerPanel 본문) -->
    <Style x:Key="StandardPanelCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    </Style>

    <!-- 전역: 모든 md:Card 배경을 SurfaceBrush로 통일 + elevation 오버레이 제거(Dp0).
         다크에서 카드마다 회색(오버레이)/진청 제각각이던 패널 배경을 한 색으로 일치.
         명시적 Style 또는 Background 가진 카드(KPI 등)는 로컬값 우선 → 영향 없음. -->
    <Style TargetType="md:Card" BasedOn="{StaticResource MaterialDesignElevatedCard}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
    </Style>

</ResourceDictionary>
