+def should_stop_between_lama_windows_and_not_fall_back_to_telea_when_cancelled(monkeypatch):
+    ev = threading.Event()
+    calls = []
+
+    class Fake:
+        def run(self, _, feed):
+            calls.append(1)
+            ev.set()                                                                   # 첫 창을 채우는 중에 취소 요청
+            return [np.full((1, 3, 512, 512), 200.0, np.float32)]
+    monkeypatch.setattr(inpaint, "_session", lambda d: Fake())
+    telea = []
+    monkeypatch.setattr(inpaint, "telea", lambda *a: telea.append(1))
+    rgb = np.random.default_rng(1).integers(0, 150, (700, 1100, 3)).astype(np.uint8)
+    mask = np.zeros((700, 1100), bool)
+    mask[50:650, 100:1000:7] = True                                                    # 창 6 개(2 × 3)가 모두 할 일이 있다
+    cancel.bind(ev)
+    try:
+        with pytest.raises(cancel.Cancelled):
+            inpaint.lama(rgb, mask, "unused")
+        assert calls == [1]                                                            # 다음 창 전에 멈춘다
+        ev.clear()
+        calls.clear()
+        with pytest.raises(cancel.Cancelled):
+            inpaint.fill(rgb, mask, "unused")                                          # Cancelled 는 Telea 대체에 먹히지 않는다
+        assert calls == [1] and telea == []
+    finally:
+        cancel.bind(None)
