+# ---------------------------------------------------------------- F-41 탱크 · 굴뚝 근처 공장 외벽 → industrial(ind) 색
+def _ll(e, n):
+    return 127.1020 + e / (111320 * math.cos(math.radians(LATC))), LATC + n / 111320
+
+
+def _poly_ll(poly):
+    return [[*_ll(x, y)] for x, y in poly.exterior.coords]
+
+
+def _user_scene(tmp_path, mbtiles, items, sub):
+    feats = [{"type": "Feature", "properties": props, "geometry": {"type": "Polygon", "coordinates": [_poly_ll(p)]}}
+             for p, props in items]
+    up = tmp_path / f"{sub}.geojson"
+    up.write_text(json.dumps({"type": "FeatureCollection", "features": feats}), encoding="utf-8")
+    req = GenerateRequest(bbox=BB, params=SceneParams(zoom=16), offline=True, buildings_geojson=str(up), fill_gaps=False)
+    with httpx.Client(transport=httpx.MockTransport(_no_net)) as dc:
+        sc = generate(req, _offline(tmp_path, mbtiles), tmp_path / sub, dem_client=dc)
+    return sc, _glb_json(tmp_path / sub / "scene.glb")
+
+
