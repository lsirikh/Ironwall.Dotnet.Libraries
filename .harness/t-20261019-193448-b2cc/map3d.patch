+// 3D 영역 · 상호작용 시나리오 시험(2026-10-19, GIS 전수 시나리오 t-20261019-193448-b2cc) — pytest(test_scenarios_coord.py)가 node 로 부른다.
+//   B-71 오버레이 항목이 영역 안 → 밖(overlay.patch · add) → 숨김 · 다시 안 → 보임
+//   B-72 영역 밖 추적(track) 표식 숨김 · B-D5 숨긴 노드의 GIS 창 자리(anchorOf)는 null · watchPoint 가 위경도로 되살리지 않음
+//   B-76 enuOf ↔ lonLatOf 왕복 · 동서 · 남북 거리 = 타원체(WGS84) 식
+//   C-14/C-16/C-99 마커 A → 건물(빈 곳) → 마커 A 는 더블클릭이 아니다(clickStep)
+//   F-24 뷰어 해 고도 음수 · 0 → 3° · 건물 commit 뒤 미리보기 원형 교체(늘이기 식 합성)
+//   three · DOM 없이 돈다 — 캔버스는 가짜(그리기 호출만 받는다).
+import { existsSync, readFileSync } from "node:fs";
+import { register } from "node:module";
+import { enuOf, lonLatOf } from "../map3d/static/camsync.js";
+import { sunOf } from "../map3d/static/light.js";
+import { stretchPositions, wallTop } from "../map3d/static/buildingedit.js";
+
+const fails = [];
+const ok = (c, what) => { if (!c) fails.push(what); };
+
+// ---------------------------------------------------------------- B-76 좌표 왕복 · 타원체 식
+{
+  const A = 6378137.0, F = 1 / 298.257223563, E2 = F * (2 - F), D2R = Math.PI / 180;
+  for (const lat0 of [0, 37.5, 60, 80]) {
+    const o = { lon: 127.0, lat: lat0 };
+    for (const [dlon, dlat] of [[0, 0], [1e-3, 0], [-0.05, 0.02], [0.01, -0.01], [0.2, 0.1]]) {
+      const lon = o.lon + dlon, lat = lat0 + dlat;
+      const e = enuOf(o, lon, lat), b = lonLatOf(o, e.x, e.z);
+      ok(Math.abs(b.lon - lon) <= 1e-12 && Math.abs(b.lat - lat) <= 1e-12, `B-76 lat ${lat0}: lonLatOf(enuOf) ${b.lon},${b.lat} != ${lon},${lat}`);
+    }
+    const s = Math.sin(lat0 * D2R), w = 1 - E2 * s * s;
+    const N = A / Math.sqrt(w), M = A * (1 - E2) / Math.pow(w, 1.5);
+    const dx = enuOf(o, o.lon + 1e-3, lat0).x, ex = N * Math.cos(lat0 * D2R) * 1e-3 * D2R;
+    ok(Math.abs(dx - ex) / ex <= 1e-9, `B-76 lat ${lat0}: east ${dx} vs prime-vertical ${ex}`);
+    const dz = -enuOf(o, o.lon, lat0 + 1e-3).z, ez = M * 1e-3 * D2R;
+    ok(Math.abs(dz - ez) / ez <= 1e-9, `B-76 lat ${lat0}: north ${dz} vs meridian ${ez}`);
+  }
+}
+
+// ---------------------------------------------------------------- F-24 뷰어 해 고도 하한
+ok(sunOf({ sun: { elevation_deg: -7.1, azimuth_deg: 170 } }).elevation === 3, "F-24 sunOf negative elevation -> 3");
+ok(sunOf({ sun: { elevation_deg: 0, azimuth_deg: 170 } }).elevation === 3, "F-14 sunOf zero elevation -> 3");
+ok(sunOf({ sun: { elevation_deg: 90, azimuth_deg: -10 } }).elevation === 85 && sunOf({ sun: { elevation_deg: 90, azimuth_deg: -10 } }).azimuth === 350, "sunOf 90 -> 85, azimuth -10 -> 350");
+
+// ---------------------------------------------------------------- C-16 건물 commit 뒤 다음 미리보기 — 새 원래 모양에서 셈해도 처음 모양에서 바로 셈한 것과 같다
+{
+  const b0 = { ground_min: 0, base_z: 0, height: 10 }, b1 = { ...b0, height: 20 };
+  const src = new Float32Array([0, 0, 0, 1, 5, 1, 2, 10, 2, 3, 11, 3]);    // 바닥 · 벽 중간 · 벽 꼭대기 · 난간 위
+  const committed = stretchPositions(src, new Float32Array(src.length), 0, wallTop(b0, 10), wallTop(b0, 20));   // 저장(10 → 20)
+  const next = stretchPositions(committed, new Float32Array(src.length), 0, wallTop(b1, 20), wallTop(b1, 15)); // 다음 미리보기(20 → 15)
+  const direct = stretchPositions(src, new Float32Array(src.length), 0, wallTop(b0, 10), wallTop(b0, 15));
+  ok(next.every((v, i) => Math.abs(v - direct[i]) < 1e-4), `C-16 commit then preview ${[...next]} != direct ${[...direct]}`);
+  const stale = stretchPositions(committed, new Float32Array(src.length), 0, wallTop(b0, 10), wallTop(b0, 15)); // 옛 줄(높이 10)로 셈하면 틀린다
+  ok(stale.some((v, i) => Math.abs(v - direct[i]) > 1), "C-16 stale row would differ (control)");
+}
+
+// ---------------------------------------------------------------- C-14/C-16/C-99 더블클릭 판정(clickStep)
+const pick = await import("../map3d/static/overlay-pick.js");
+if (typeof pick.clickStep !== "function") fails.push("C-99 overlay-pick.js has no clickStep (double-click decision is inside view.js handler)");
+else {
+  const { clickStep, DBLCLICK_MS } = pick;
+  const run = (seq) => {   // seq: [[ov|null, t]] → 각 클릭의 kind
+    let last = null; const out = [];
+    for (const [ov, t] of seq) { const r = clickStep(last, ov, t); last = r.last; out.push(r.kind); }
+    return out.join(",");
+  };
+  const A = { kind: "pids", id: 1 }, A2 = { kind: "pids", id: 1 }, B = { kind: "pids", id: 2 }, L = { kind: "line", id: 1 };
+  ok(DBLCLICK_MS === 400, `DBLCLICK_MS ${DBLCLICK_MS}`);
+  ok(run([[A, 0], [A2, 300]]) === "click,dblclick", "C-14 A A within 400 ms -> dblclick " + run([[A, 0], [A2, 300]]));
+  ok(run([[A, 0], [null, 150], [A, 300]]) === "click,,click", "C-99 A -> building/empty -> A within 400 ms is NOT dblclick: " + run([[A, 0], [null, 150], [A, 300]]));
+  ok(run([[A, 0], [B, 100], [A, 200]]) === "click,click,click", "C-16 A -> B -> A is not dblclick: " + run([[A, 0], [B, 100], [A, 200]]));
+  ok(run([[A, 0], [A, 400]]) === "click,click", "A A at exactly 400 ms -> two clicks");
+  ok(run([[A, 0], [A, 100], [A, 200]]) === "click,dblclick,click", "triple click -> dblclick then fresh click");
+  ok(run([[{ kind: "line", id: 1 }, 0], [{ kind: "pids", id: 1 }, 100]]) === "click,click", "same id different kind -> not dblclick");
+  ok(run([[L, 0], [{ kind: "line", id: 1 }, 100]]) === "click,dblclick", "line dblclick");
+}
+{
+  const src = readFileSync(new URL("../map3d/static/view.js", import.meta.url), "utf-8").replace(/\r\n/g, "\n");
+  const at = src.indexOf('addEventListener("pointerup", (ev) => {\n  if (ev.button !== 0)');
+  const h = at >= 0 ? src.slice(at) : "";
+  const body = h.slice(0, h.indexOf("\n});"));
+  ok(/clickStep\(lastUp, ov,/.test(body) && body.indexOf("lastUp = ") < body.indexOf("if (ov)"),
+    "C-99 view.js left pointerup: lastUp must be updated (cleared on non-overlay click) by clickStep before `if (ov)`");
+  const wp = src.slice(src.indexOf("function watchPoint(w)"), src.indexOf("function reportScreens()"));
+  ok(/overlay\.isOutside\(w\.kind, w\.id\)\) return null/.test(wp),
+    "B-D5 view.js watchPoint: a marker hidden outside the scene area must not fall back to its lon/lat");
+}
+
+// ---------------------------------------------------------------- B-71 · B-72 · B-D5 — Overlay3D(three vendor)
+const three = new URL("../map3d/static/vendor/three/build/three.module.js", import.meta.url);
+if (existsSync(three)) {
+  const jsm = new URL("../map3d/static/vendor/three/examples/jsm/", import.meta.url).href;
+  register("data:text/javascript," + encodeURIComponent(
+    `export async function resolve(s, c, n) { if (s === "three") return n(${JSON.stringify(three.href)}, c);
+       if (s.startsWith("three/addons/")) return n(${JSON.stringify(jsm)} + s.slice(13), c); return n(s, c); }`));
+  const g2d = new Proxy({}, { get: (t, k) => (k in t ? t[k] : k === "measureText" ? () => ({ width: 40 }) : () => {}), set: (t, k, v) => { t[k] = v; return true; } });
+  globalThis.document = { createElement: () => ({ width: 0, height: 0, getContext: () => g2d }) };
+  const THREE = await import("three");
+  const { Overlay3D } = await import("../map3d/static/overlay3d.js");
+  const o = { lon: 127.0, lat: 37.0 }, bbox = [126.999, 36.999, 127.001, 37.001];       // 약 178 m × 222 m
+  const IN = { lon: 127.0002, lat: 37.0003 }, OUT = { lon: 127.004, lat: 37.0 };
+  const ov = new Overlay3D({ scene: new THREE.Scene(), camera: {}, host: {}, origin: () => o, area: () => bbox, groundY: () => 0 });
+  const vis = (k) => { const n = ov.nodes.get(k); return n ? n.group.visible : "none"; };
+  ov.apply({ type: "overlay.snapshot", rev: 1, points: [{ kind: "pids", id: 1, title: "P1", ...IN }],
+             lines: [{ kind: "line", id: 5, pts: [[37.0, 126.9995], [37.0005, 127.0005]] }] });
+  ok(vis("pids:1") === true && vis("line:5") === true, `B-71 snapshot inside -> shown (${vis("pids:1")}, ${vis("line:5")})`);
+  ok(ov.anchorOf("pids", 1) !== null, "B-D5 anchorOf inside -> position");
+  ok(ov.isOutside && ov.isOutside("pids", 1) === false, "B-D5 isOutside inside -> false");
+  ov.apply({ type: "overlay.patch", rev: 2, kind: "pids", id: 1, set: OUT });
+  ok(vis("pids:1") === false, `B-71 patch moves marker outside -> hidden (${vis("pids:1")})`);
+  ok(ov.anchorOf("pids", 1) === null, "B-D5 anchorOf of marker hidden outside area -> null (GIS box must not follow an undrawn marker)");
+  ok(ov.isOutside && ov.isOutside("pids", 1) === true, "B-D5 isOutside hidden -> true");
+  ov.apply({ type: "overlay.patch", rev: 3, kind: "pids", id: 1, set: IN });
+  ok(vis("pids:1") === true && ov.anchorOf("pids", 1) !== null, `B-71 patch back inside -> shown again (${vis("pids:1")})`);
+  ov.apply({ type: "overlay.patch", rev: 4, kind: "line", id: 5, set: { pts: [[37.002, 126.99], [37.003, 127.01]] } });
+  ok(vis("line:5") === false, `B-71 line moved outside -> hidden (${vis("line:5")})`);
+  ov.apply({ type: "overlay.add", rev: 5, item: { kind: "pids", id: 2, ...OUT } });
+  ok(vis("pids:2") === false, `B-71 add outside -> hidden (${vis("pids:2")})`);
+  ov.apply({ type: "overlay.patch", rev: 6, kind: "pids", id: 1, set: { visible: false } });
+  ok(vis("pids:1") === false, "B-71 hidden by visible=false inside");
+  ov.apply({ type: "overlay.patch", rev: 7, kind: "pids", id: 1, set: { visible: true } });
+  ok(vis("pids:1") === true, "B-71 visible=true inside -> shown");
+  ov.refreshVisibility(14);
+  ok(vis("pids:2") === false && vis("pids:1") === true, "B-71 zoom refresh keeps area decision");
+  ov.apply({ type: "overlay.remove", rev: 8, kind: "pids", id: 2 });
+  ok(vis("pids:2") === "none" && ov.anchorOf("pids", 2) === null, "removed -> no node, anchor null");
+
+  // B-72 추적 표식
+  const tvis = (id) => { const n = ov.trackNodes.get(String(id)); return n ? n.group.visible : "none"; };
+  ov.applyTrack({ type: "track.upsert", id: "t1", ...OUT, bearing: 90, label: "T1" });
+  ok(tvis("t1") === false, `B-72 track outside area -> hidden (${tvis("t1")})`);
+  ok(ov.anchorOf("track", "t1") === null, "B-D5 anchorOf of track hidden outside -> null");
+  ov.applyTrack({ type: "track.upsert", id: "t1", ...IN, trail: [[OUT.lat, OUT.lon]] });
+  ok(tvis("t1") === true && ov.anchorOf("track", "t1") !== null, `B-72 track moves inside -> shown (${tvis("t1")})`);
+  ov.applyTrack({ type: "track.upsert", id: "t1", ...OUT });
+  ok(tvis("t1") === false, `B-72 track leaves area again -> hidden (${tvis("t1")})`);
+  ov.applyTrack({ type: "track.upsert", id: 7, ...IN });
+  ok(tvis(7) === true, "B-72 numeric id inside -> shown");
+  ov.apply({ type: "overlay.snapshot", rev: 20, points: [] });
+  ok(tvis(7) === true && tvis("t1") === false, "B-72 snapshot keeps tracks and their area decision");
+  ov.applyTrack({ type: "track.remove", id: "t1" });
+  ok(tvis("t1") === "none", "track removed");
+  // 영역이 없는(옛 장면) 경우 — 전부 보인다(예전 동작)
+  const ov2 = new Overlay3D({ scene: new THREE.Scene(), camera: {}, host: {}, origin: () => o, groundY: () => 0 });
+  ov2.applyTrack({ type: "track.upsert", id: "x", ...OUT });
+  ok(ov2.trackNodes.get("x").group.visible === true, "B-72 no area -> track shown (as before)");
+} else console.log("(three vendor 없음 — Overlay3D 칸 건너뜀)");
+
+if (fails.length) { console.log(fails.join("\n")); process.exit(1); }
+console.log("scenario bc ok");
