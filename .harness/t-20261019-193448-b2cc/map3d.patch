+    tank2 = (Point(-20, 30).buffer(6, 16), {"id": "t2", "man_made": "storage_tank", "height": 12})
+    shed = (box(10, -10, 30, 5), {"id": "w"})                                    # 300 m², 높이 태그 없음(기본 6 m)
