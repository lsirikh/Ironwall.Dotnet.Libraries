+++ b/tests/test_scenarios_coord.py
@@ -0,0 +1,81 @@
+"""전수 시나리오(2026-10-19, GIS t-20261019-193448-b2cc) — 3D 영역 · 상호작용 뷰어 시험(node) · 고위도 기본 해 고도 하한(F-D8)."""
+import math
+import shutil
+import subprocess
+from pathlib import Path
+
+import httpx
+import pytest
+
+from map3d import extract as X
+from map3d.config import Settings
+from map3d.extract import ExtractResult, Found, default_sun, extract_buildings
+from map3d.params import SceneParams
+from map3d.pipeline import GenerateRequest, generate
+from shapely.geometry import box
+
+from test_oblique import _fake_sam, _oblique_scene
+
+SUN_MIN = 3.0   # 굽기(shade.py max(el, 3)) · 뷰어(light.js max(3, …))와 같은 하한
+
+
+# ---------------------------------------------------------------- B-71 · B-72 · B-76 · C-14/C-16/C-99 · F-24(뷰어) — node
+def should_hide_out_of_area_markers_tracks_and_not_double_click_across_building_when_checked_with_node():
+    node = shutil.which("node")
+    assert node, "node 가 없어 3D 영역 · 상호작용 시나리오 시험(scenario_bc_check.mjs)을 돌릴 수 없다"
+    r = subprocess.run([node, str(Path(__file__).with_name("scenario_bc_check.mjs"))], capture_output=True, text=True, timeout=60)
+    assert r.returncode == 0, r.stdout + r.stderr
+
+
+# ---------------------------------------------------------------- F-14 / F-24 해 고도 0 · 음수(고위도)
+def should_assume_negative_elevation_when_latitude_is_far_north():
+    """가정(2월 초 · 11 시) 해는 위도 80° 에서 지평선 아래 — default_sun 은 천문 값 그대로(지금 동작 확인)."""
+    el, _ = default_sun(80.0)
+    assert el < 0 and default_sun(60.0)[0] > 0
+
+
+def _photo_only_scene(tmp_path, mbtiles, monkeypatch, sun):
+    """외부 자료 0건 장면(test_quality 의 예와 같은 꼴) — 그림자 100 m 인 사진 건물 하나, 가정 해 = sun."""
+    def fake(img, region, gsd0, model_dir, deadline=None):
+        W, H = img.size
+        sq = box(W / 2 - 15, H / 2 - 15, W / 2 + 15, H / 2 + 15)
+        return ExtractResult("tile", [Found(sq, 3000.0, 1.0, (0, 0, 0), 7.0, "unknown", "shadow", "tile", sq, shadow_m=100.0)],
+                             {"segmenter": "mobile_sam", "found": 1})
+    monkeypatch.setattr(X, "extract_tiles", fake)
+    monkeypatch.setattr(X, "default_sun", lambda lat: sun)
+
+    def no_net(request):
+        raise httpx.ConnectError("보안 구역(시험) — 인터넷 없음", request=request)
+    s = Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"), buildings_dir=str(tmp_path / "none"))
+    req = GenerateRequest(bbox=(127.1000, 37.3600, 127.1040, 37.3632), params=SceneParams(zoom=16), offline=True)
+    with httpx.Client(transport=httpx.MockTransport(no_net)) as dc:
+        return generate(req, s, tmp_path / "z", dem_client=dc)
+
+
+@pytest.mark.parametrize("el", [-7.1, 0.0])
+def should_clip_default_sun_to_3_degrees_for_shadow_heights_when_assumed_elevation_is_zero_or_negative(tmp_path, mbtiles, monkeypatch, el):
+    sc = _photo_only_scene(tmp_path, mbtiles, monkeypatch, (el, 170.0))
+    sun = sc["sun"]
+    k = math.tan(math.radians(SUN_MIN)) / X.SHADOW_BIAS
+    assert sun["source"] == "default" and sun["elevation_deg"] == SUN_MIN, sun
+    assert sun["shadow_k"] == pytest.approx(k, abs=0.002), sun                     # 음수 · 0 이면 모든 그림자 높이가 하한(3 m)
+    (b,) = sc["buildings"]
+    assert b["height_from"] == "shadow" and b["height"] == pytest.approx(100.0 * sun["shadow_k"], abs=0.05), b
+
+
+def should_keep_default_sun_when_assumed_elevation_is_above_3_degrees(tmp_path, mbtiles, monkeypatch):
+    sc = _photo_only_scene(tmp_path, mbtiles, monkeypatch, (20.0, 170.0))
+    assert sc["sun"]["elevation_deg"] == 20.0
+    assert sc["sun"]["shadow_k"] == pytest.approx(math.tan(math.radians(20.0)) / X.SHADOW_BIAS, abs=0.002)
+
+
+def should_clip_assumed_sun_in_photo_extract_when_no_map_refs_and_far_north(monkeypatch):
+    """비스듬한 실사 추출(지도 자료 없음 → 맞추지 않음): 그림자 높이 · stats.sun 이 가정 고도 하한을 따른다."""
+    _fake_sam(monkeypatch)
+    monkeypatch.setattr(X, "default_sun", lambda lat: (-7.1, 170.0))
+    ortho, spec, photo, _ = _oblique_scene()
+    r = extract_buildings(photo, spec, style="photo", model_dir="unused", ortho=ortho, refs=[])
+    sun = r.stats["sun"]
+    assert sun["source"] == "default" and sun["shadow_k"] > 0, sun
+    assert sun["elevation_deg"] == pytest.approx(SUN_MIN, abs=0.1), sun
+    assert all(f.height >= 3.0 for f in r.buildings)
diff --git a/tests/test_scenarios_e.py b/tests/test_scenarios_e.py
new file mode 100644
index 0000000..5fd1a78
--- /dev/null
+++ b/tests/test_scenarios_e.py
@@ -0,0 +1,369 @@
+"""영역 E(오버레이 이미지 — map-3d 쪽) 시나리오 — 완전 투명 · 1×1 · 회전 영역 밖 · mask=false · 성격 판정 마스크 경계 ·
+사진 텍스처(repeat=False · 투명 자리 · 사진 경계 · 가림만 하는 건물 · 아주 작은 건물) · 흐린 곳 없음 · LaMa 창 사이 취소.
+
+기존 시험 장치(test_alpha_region · test_overlay · test_regions · test_photo_texture · test_rotated_area)를 그대로 쓴다.
+네트워크는 막거나(httpx.MockTransport · _blocked) 오프라인 모드로만."""
+import threading
+
+import httpx
+import numpy as np
+import pytest
+from PIL import Image
+from scipy import ndimage as ndi
+
+from map3d import cancel, inpaint
+from map3d import extract as X
+from map3d.config import Settings
+from map3d.extract import detect_style, extract_buildings
+from map3d.geo import parse_rect
+from map3d.overlay import MASK_GRAY, OverlaySpec, composite, coverage_mask, photo_ground
+from map3d.params import SceneParams
+from map3d.pipeline import GenerateRequest, generate
+
+from conftest import BBOX
+from test_alpha_region import H, W, _rgba
+from test_overlay import OV, _illustration, _noise_ortho, _osm_client, _spec
+from test_regions import _blocked, _dem404
+from test_rotated_area import RECT, _square
+
+cv2 = pytest.importorskip("cv2")
+
+from map3d.photo_texture import photo_matrix, project, texture_buildings  # noqa: E402
+from test_photo_texture import CAM, TO_PX, _atlas_at, _box, _photo_two_boxes  # noqa: E402
+
+WARN_TINY = "불투명 부분이 너무 작음"          # pipeline.py 오버레이 경고 문구(부분 문자열)
+WARN_OUT = "가 영역 밖이라 굽지 않음"
+
+
+def _gen(tmp_path, mbtiles, slope_dem, sub, mode, overlays, osm=None, rect=None, bbox=BBOX):
+    """파이프라인 한 번 — osm 이 없으면 오프라인(캐시만), DEM 은 404(평지 대체)."""
+    st = Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"), overpass_endpoints=["https://ok.example/api"])
+    req = GenerateRequest(bbox=bbox, params=SceneParams(zoom=16), dem_path=str(slope_dem), overlay_mode=mode,
+                          overlays=overlays, fill_gaps=False, offline=osm is None, rect=rect)
+    with _dem404() as dc:
+        if osm is None:
+            return generate(req, st, tmp_path / sub, dem_client=dc)
+        with osm as oc:
+            return generate(req, st, tmp_path / sub, osm_client=oc, dem_client=dc)
+
+
+def _ov_warnings(sc, oid):
+    return [w for w in sc["warnings"] if w.startswith(f"오버레이 {oid}")]
+
+
+# ================================================================ E-49 완전 투명 PNG
+def should_give_empty_region_zero_cover_and_untouched_texture_when_png_fully_transparent():
+    s = _spec(rotation=20.0)
+    img = _rgba(np.zeros((H, W), np.uint8))
+    g = s.region_ll(img)
+    assert g.is_empty and s.region_ll().is_empty                  # 기억한 범위도 빈 것(네모로 되돌아가지 않는다)
+    assert s.region_info == {"transparent": True, "parts": 0, "holes": 0, "vertices": 0, "area_m2": 0.0}
+    o = _noise_ortho()
+    before = np.asarray(o.image).copy()
+    assert not coverage_mask(o, s).any()
+    info = composite(o, s, img)
+    assert info["pixels"] == 0 and np.array_equal(np.asarray(o.image), before)   # 보안 회색도 칠하지 않는다
+
+
+@pytest.mark.parametrize("mode", ["composite", "extract"])
+def should_warn_tiny_and_outside_and_bake_nothing_when_png_fully_transparent(tmp_path, mbtiles, slope_dem, monkeypatch, mode):
+    _blocked(monkeypatch)
+    png = tmp_path / "clear.png"
+    _rgba(np.zeros((H, W), np.uint8)).save(png)
+    sc = _gen(tmp_path, mbtiles, slope_dem, "o", mode, [{"id": 7, "title": "투명", "image_path": str(png), "bounds": OV}])
+    w = _ov_warnings(sc, 7)
+    assert len(w) == 2, sc["warnings"]
+    assert WARN_TINY in w[0] and "(0 m²)" in w[0] and WARN_OUT in w[1]
+    assert sc["overlays_baked"] == [] and sc["sources"]["overlay"]["items"] == []
+    assert not [b for b in sc["buildings"] if b["source"] == "overlay"]
+    assert (tmp_path / "o" / "scene.glb").stat().st_size > 0
+    log = (tmp_path / "o" / "log.txt").read_text(encoding="utf-8")
+    assert WARN_TINY in log and WARN_OUT in log and "오버레이 0장" in log
+
+
+# ================================================================ E-50 1×1 PNG
+def should_treat_one_pixel_opaque_png_as_full_rectangle_and_stretch_it():
+    s = _spec(rotation=15.0)
+    img = Image.new("RGBA", (1, 1), (200, 40, 160, 255))
+    g = s.region_ll(img)
+    assert g.equals(s.polygon_ll()) and not s.region_info["transparent"] and s.region_info["vertices"] == 4
+    o = _noise_ortho()
+    info = composite(o, s, img)
+    inner = ndi.binary_erosion(coverage_mask(o, s), iterations=3)
+    assert info["pixels"] > 1000 and inner.sum() > 1000
+    assert np.abs(np.asarray(o.image).astype(int)[inner] - [200, 40, 160]).max() <= 1   # 한 화소가 범위 전체로 늘어난다
+
+
+def should_treat_one_pixel_transparent_png_like_fully_transparent():
+    s = _spec()
+    g = s.region_ll(Image.new("RGBA", (1, 1), (0, 0, 0, 0)))
+    assert g.is_empty and s.region_info["parts"] == 0 and s.region_info["area_m2"] == 0.0
+    o = _noise_ortho()
+    assert composite(o, s, Image.new("RGBA", (1, 1), (0, 0, 0, 0)))["pixels"] == 0
+
+
+@pytest.mark.parametrize("mode", ["composite", "extract"])
+def should_bake_one_pixel_png_without_crash_when_generating(tmp_path, mbtiles, slope_dem, monkeypatch, mode):
+    _blocked(monkeypatch)
+    opaque, clear = tmp_path / "one.png", tmp_path / "one_clear.png"
+    Image.new("RGBA", (1, 1), (200, 40, 160, 255)).save(opaque)
+    Image.new("RGBA", (1, 1), (0, 0, 0, 0)).save(clear)
+    ov = [{"id": 1, "image_path": str(opaque), "bounds": OV}, {"id": 2, "image_path": str(clear), "bounds": OV}]
+    sc = _gen(tmp_path, mbtiles, slope_dem, "one", mode, ov)
+    assert [b["id"] for b in sc["overlays_baked"]] == [1]                 # 불투명 1×1 = 범위 전체, 투명 1×1 = 건너뜀
+    if mode == "composite":
+        assert sc["overlays_baked"][0]["buildings"] == 0                  # composite 는 건물을 찾지 않는다
+    # extract 의 한 색 1×1 그림 → 범위 전체 크기 건물 1채(높이 0 m)가 나온다 — 고정하지 않고 보고(extract.py 소관)
+    item = sc["sources"]["overlay"]["items"][0]
+    assert item["pixels"] > 0 and item["region"]["transparent"] is False
+    assert not [w for w in _ov_warnings(sc, 1) if WARN_TINY in w or WARN_OUT in w]   # (extract 는 가중치 없음 경고만)
+    w2 = _ov_warnings(sc, 2)
+    assert len(w2) == 2 and WARN_TINY in w2[0] and WARN_OUT in w2[1]
+    if mode == "extract":
+        assert item["extract"] is not None and item["extract"]["style_auto"] in ("illustration", "photo")
+
+
+# ================================================================ E-51 투명 PNG + 회전 영역(rect) 밖
+def _rect_overlay(tmp_path, keep_outside: bool):
+    """회전 영역 위쪽 변(로컬 y = 60)에 걸친 40 m 네모 그림 — 불투명 = 변 바깥 3 m 넘는 곳(keep_outside) 또는 안쪽 3 m 넘는 곳."""
+    rr = parse_rect(RECT)
+    c = np.asarray(_square(rr, 0, 60, 20.0))
+    b = {"left": float(c[:, 0].min()), "right": float(c[:, 0].max()), "bottom": float(c[:, 1].min()), "top": float(c[:, 1].max())}
+    s = OverlaySpec(id=9, image_path="x.png", **b)
+    n = 200
+    iy, ix = np.mgrid[0:n, 0:n] + 0.5
+    lon, lat = s.image_to_lonlat(ix.ravel(), iy.ravel(), n, n)
+    _, y = rr.to_local(np.asarray(lon), np.asarray(lat))
+    y = np.asarray(y).reshape(n, n)
+    a = np.where(y > 63.0 if keep_outside else y < 57.0, 255, 0).astype(np.uint8)
+    png = tmp_path / ("out.png" if keep_outside else "in.png")
+    _rgba(a).save(png)
+    return {"id": 9, "image_path": str(png), "bounds": b}, rr
+
+
+def should_skip_transparent_png_whose_opaque_part_is_outside_rotated_rect(tmp_path, mbtiles, slope_dem):
+    ov, rr = _rect_overlay(tmp_path, keep_outside=True)
+    sc = _gen(tmp_path, mbtiles, slope_dem, "r", "composite", [ov], rect=RECT, bbox=rr.bbox())
+    assert sc["overlays_baked"] == [] and any(WARN_OUT in w for w in _ov_warnings(sc, 9)), sc["warnings"]
+
+
+def should_bake_transparent_png_whose_opaque_part_is_inside_rotated_rect(tmp_path, mbtiles, slope_dem):
+    ov, rr = _rect_overlay(tmp_path, keep_outside=False)                 # 대조: 같은 경계, 불투명이 영역 안
+    sc = _gen(tmp_path, mbtiles, slope_dem, "r", "composite", [ov], rect=RECT, bbox=rr.bbox())
+    assert [b["id"] for b in sc["overlays_baked"]] == [9] and not _ov_warnings(sc, 9), sc["warnings"]
+    assert sc["sources"]["overlay"]["items"][0]["region"]["transparent"]
+
+
+# ================================================================ E-52 투명 PNG + mask=false
+def _corner_alpha():
+    a = np.full((H, W), 255, np.uint8)
+    a[:100, 300:] = 0                    # 오른쪽 위 모서리만 투명(가운데는 불투명)
+    return a
+
+
+def should_blend_over_satellite_only_on_opaque_shape_when_mask_off():
+    o = _noise_ortho()
+    before = np.asarray(o.image).astype(float)
+    img = _rgba(_corner_alpha(), color=(0, 0, 255))
+    s = _spec(mask=False, opacity=0.5)
+    s.region_ll(img)
+    m = coverage_mask(o, s)
+    rect = coverage_mask(o, _spec())
+    composite(o, s, img)
+    after = np.asarray(o.image).astype(float)
+    notch = rect & ~ndi.binary_dilation(m, iterations=2)
+    assert notch.sum() > 500 and (after[notch] == before[notch]).all()                # 투명한 곳 = 위성 그대로
+    inner = ndi.binary_erosion(m, iterations=2)
