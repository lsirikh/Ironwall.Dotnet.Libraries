+def should_put_parapet_on_both_outer_and_courtyard_edges_when_footprint_has_hole(roof_kit):
+    yard = Polygon([(0, 0), (40, 0), (40, 40), (0, 40)], [[(15, 15), (25, 15), (25, 25), (15, 25)]])
+    d, info = roof_kit(yard, 12.0)
+    assert d is not None
+    top = info["ground_min"] + 12.0
+    p = d.positions
+    rim = p[np.isclose(p[:, 2], top + PARAPET_H)]
+    on = lambda q, v: np.isclose(q, v, atol=0.06)  # noqa: E731
+    assert (on(rim[:, 0], 0) | on(rim[:, 0], 40)).any()                          # 바깥 테두리
+    assert (on(rim[:, 0], 15) & (rim[:, 1] > 14) & (rim[:, 1] < 26)).any()        # 중정 테두리(구멍 가장자리)
+    assert (on(rim[:, 0], 15 - PARAPET_T) & (rim[:, 1] > 14) & (rim[:, 1] < 26)).any()   # 중정 난간 안쪽 면(두께)
+    hole = (p[:, 0] > 15.05) & (p[:, 0] < 24.95) & (p[:, 1] > 15.05) & (p[:, 1] < 24.95)
+    assert not hole.any()                                                      # 중정 위에는 아무것도(옥탑 포함) 없다
+    assert p[:, 2].max() == pytest.approx(top + 1.6, abs=0.01)                   # 설비 상자(15 m 미만 1.6 m)는 지붕 위 다른 자리에
