+    assert sc["counts"]["buildings_industrial_site"] == 1
+    name = f"facade_ind{w['id'] % len(PL.IND_TINTS)}"
+    assert _node_materials(g, _building_nodes(g)[w["id"]]) >= {name}
+    mat = next(m for m in g["materials"] if m["name"] == name)
+    assert mat["pbrMetallicRoughness"]["baseColorFactor"] == pytest.approx(list(srgb_hex_to_linear(PL.IND_TINTS[w["id"] % 4])))
+    tanks = [b for b in sc["buildings"] if b["source_id"] in ("t1", "t2")]
+    assert all(b["facade"] == "tank" and b["use"] == "unknown" for b in tanks)  # 탱크 자신은 그대로
+
+    alone, g2 = _user_scene(tmp_path, mbtiles, [tank1, shed], "one")              # 탱크 1 개 → 공장 아님
+    w2 = next(b for b in alone["buildings"] if b["source_id"] == "w")
+    assert w2["use"] == "unknown" and w2["facade"] != "ind" and alone["counts"]["buildings_industrial_site"] == 0
+    assert not any(n.startswith("facade_ind") for n in _node_materials(g2, _building_nodes(g2)[w2["id"]]))
