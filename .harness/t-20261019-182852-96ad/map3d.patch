@@ -0,0 +1,370 @@
+"""굽기 취소(POST /api/jobs/{id}/cancel · JobManager.cancel · cancel.check) — 취소 시점별.
+
+실제 굽기는 합성 MBTiles · 평지 DEM · 가짜 OSM 으로 빠르게. 오래 걸리는 단계(Overpass 대기 · 건물 메시 · SAM 조각)는
+가짜 함수가 "들어왔다"를 알리고 느리게 돌아 그 사이에 취소한다.
+"""
+import json
+import threading
+import time
+
+import numpy as np
+import pytest
+from fastapi.testclient import TestClient
+
+from map3d import cancel, extract, jobs as jobs_mod, pipeline, sam
+from map3d.config import Settings
+from map3d.jobs import JobManager
+from map3d.osm import OsmResult
+from map3d.server import create_app
+
+STOP_S = 2.0   # 취소 요청 뒤 이 안에 멈춰야 한다
+
+
+def _settings(tmp_path, mbtiles):
+    return Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"), overpass_endpoints=["https://a.example/api"])
+
+
+def _geojson(tmp_path, bbox, n=12) -> str:
+    """영역 안 작은 건물 n 개(사용자 GeoJSON — 메시 단계를 길게)."""
+    feats = []
+    for i in range(n):
+        x = bbox[0] + 0.0004 + (i % 4) * 0.0008
+        y = bbox[1] + 0.0004 + (i // 4) * 0.0008
+        feats.append({"type": "Feature", "properties": {"height": 10},
+                      "geometry": {"type": "Polygon", "coordinates": [[[x, y], [x + 0.0002, y], [x + 0.0002, y + 0.0002],
+                                                                       [x, y + 0.0002], [x, y]]]}})
+    p = tmp_path / "b.geojson"
+    p.write_text(json.dumps({"type": "FeatureCollection", "features": feats}), encoding="utf-8")
+    return str(p)
+
+
+@pytest.fixture
+def offline(monkeypatch):
+    """DEM 은 평지(내려받기 실패 대체), OSM 은 빈 결과 — 기본은 바로. osm_wait 를 정하면 그만큼 기다린다(Overpass 대기 흉내)."""
+    st = {"osm_wait": 0.0, "osm_entered": threading.Event(), "mesh_delay": 0.0, "mesh_entered": threading.Event()}
+
+    def fake_dem(*a, **k):
+        raise RuntimeError("시험: 네트워크 없음")
+
+    def fake_osm(*a, **k):
+        st["osm_entered"].set()
+        time.sleep(st["osm_wait"])
+        return OsmResult()
+
+    real_build = pipeline.build_building
+
+    def slow_build(*a, **k):
+        st["mesh_entered"].set()
+        time.sleep(st["mesh_delay"])
+        return real_build(*a, **k)
+    monkeypatch.setattr(pipeline, "load_copernicus", fake_dem)
+    monkeypatch.setattr(pipeline, "fetch_osm", fake_osm)
+    monkeypatch.setattr(pipeline, "build_building", slow_build)
+    return st
+
+
+def _client(tmp_path, mbtiles, workers=1):
+    s = _settings(tmp_path, mbtiles)
+    jm = JobManager(s, workers=workers)
+    return TestClient(create_app(s, jm)), jm, s
+
+
+def _body(bbox, **kw):
+    return {"bbox": list(bbox), "fill_gaps": False, **kw}
+
+
+def _wait_status(c, jid, want, timeout=30.0):
+    t0 = time.time()
+    while time.time() - t0 < timeout:
+        st = c.get(f"/api/jobs/{jid}").json()["status"]
+        if st in want:
+            return st
+        time.sleep(0.05)
+    raise AssertionError(f"{jid}: {want} 를 기다리다 시간 초과")
+
+
+def _cancel_and_time(c, jid):
+    t0 = time.time()
+    r = c.post(f"/api/jobs/{jid}/cancel")
+    assert r.status_code == 200
+    assert _wait_status(c, jid, ("cancelled",), timeout=10) == "cancelled"
+    return r.json(), time.time() - t0
+
+
+# ---------------------------------------------------------------- 시점별
+
+def should_stop_within_two_seconds_when_cancelled_during_osm_wait(tmp_path, mbtiles, bbox, offline):
+    offline["osm_wait"] = 30.0                    # Overpass 가 30 초 걸리는 상황
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert offline["osm_entered"].wait(15)
+    r, took = _cancel_and_time(c, jid)
+    assert r["result"] == "requested" and r["cancel_requested"] is True
+    assert took < STOP_S
+    assert not (s.jobs_dir / jid).exists()        # 만들다 만 폴더는 지운다
+    j = c.get(f"/api/jobs/{jid}").json()
+    assert j["status"] == "cancelled" and "files" not in j and j["error"] is None
+
+
+def should_stop_within_two_seconds_when_cancelled_during_building_mesh(tmp_path, mbtiles, bbox, offline):
+    offline["mesh_delay"] = 0.3                   # 건물 12 동 × 0.3 s
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json=_body(bbox, buildings_geojson=_geojson(tmp_path, bbox))).json()["id"]
+    assert offline["mesh_entered"].wait(30)
+    r, took = _cancel_and_time(c, jid)
+    assert r["result"] == "requested" and took < STOP_S
+    assert not (s.jobs_dir / jid).exists()
+    assert all(x["id"] != jid for x in c.get("/api/jobs").json()["scenes"])
+
+
+def should_cancel_immediately_when_job_still_queued(tmp_path, mbtiles, bbox, offline):
+    offline["osm_wait"] = 30.0
+    c, jm, s = _client(tmp_path, mbtiles, workers=1)
+    first = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    second = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert offline["osm_entered"].wait(15)
+    assert c.get(f"/api/jobs/{second}").json()["status"] == "queued"
+    r = c.post(f"/api/jobs/{second}/cancel").json()
+    assert r["result"] == "cancelled" and r["status"] == "cancelled"
+    assert not (s.jobs_dir / second).exists()
+    listed = c.get("/api/jobs").json()
+    assert [x["id"] for x in listed["cancelled"]] == [second]
+    assert [x["id"] for x in listed["running"]] == [first]
+    c.post(f"/api/jobs/{first}/cancel")
+    _wait_status(c, first, ("cancelled",))
+    time.sleep(0.3)                               # 기다리던 작업은 차례가 와도 돌지 않는다
+    assert c.get(f"/api/jobs/{second}").json()["status"] == "cancelled" and not (s.jobs_dir / second).exists()
+
+
+def should_answer_harmlessly_when_job_already_done(tmp_path, mbtiles, bbox, offline):
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert _wait_status(c, jid, ("done", "error")) == "done"
+    r = c.post(f"/api/jobs/{jid}/cancel")
+    assert r.status_code == 200 and r.json()["result"] == "already" and r.json()["status"] == "done"
+    assert (s.jobs_dir / jid / "scene.json").exists()      # 다 만든 장면은 그대로
+    assert c.get(f"/api/jobs/{jid}").json()["status"] == "done"
+
+
+def should_answer_harmlessly_when_job_missing_or_id_invalid(tmp_path, mbtiles):
+    c, jm, s = _client(tmp_path, mbtiles)
+    r = c.post("/api/jobs/20990101-000000-abcdef/cancel")
+    assert r.status_code == 200 and r.json() == {"id": "20990101-000000-abcdef", "result": "missing", "status": "missing",
+                                                 "cancel_requested": False}
+    for bad in ("a.b", "x" * 65, "..", "a%20b"):
+        assert c.post(f"/api/jobs/{bad}/cancel").status_code in (404, 422)   # 형식이 틀린 id 는 받지 않는다
+    assert c.get("/api/jobs/nojob/cancel").status_code == 405                 # POST 만
+
+
+def should_be_idempotent_when_cancelled_twice(tmp_path, mbtiles, bbox, offline):
+    offline["osm_wait"] = 30.0
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert offline["osm_entered"].wait(15)
+    a = c.post(f"/api/jobs/{jid}/cancel").json()
+    b = c.post(f"/api/jobs/{jid}/cancel").json()
+    assert a["result"] == "requested" and b["result"] in ("already", "requested") and b["cancel_requested"]
+    _wait_status(c, jid, ("cancelled",))
+    assert c.post(f"/api/jobs/{jid}/cancel").json()["result"] == "already"
+    assert c.get(f"/api/jobs/{jid}").json()["history"].count("취소됨") == 1
+
+
+def should_keep_previous_scene_when_rebake_cancelled(tmp_path, mbtiles, bbox, offline):
+    c, jm, s = _client(tmp_path, mbtiles)
+    old = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert _wait_status(c, old, ("done", "error")) == "done"
+    before = (s.jobs_dir / old / "scene.glb").read_bytes()
+    offline["osm_wait"] = 30.0
+    offline["osm_entered"].clear()
+    new = c.post("/api/jobs", json=_body(bbox)).json()["id"]           # 같은 영역 다시 만들기
+    assert offline["osm_entered"].wait(15)
+    _cancel_and_time(c, new)
+    assert (s.jobs_dir / old / "scene.glb").read_bytes() == before     # 옛 장면 파일 그대로
+    assert [x["id"] for x in c.get("/api/jobs").json()["scenes"]] == [old]
+    lon, lat = (bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2
+    assert c.get("/api/scenes/at", params={"lon": lon, "lat": lat}).json()["id"] == old
+
+
+def should_bake_again_when_same_area_requested_after_cancel(tmp_path, mbtiles, bbox, offline):
+    offline["osm_wait"] = 30.0
+    c, jm, s = _client(tmp_path, mbtiles)
+    first = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert offline["osm_entered"].wait(15)
+    c.post(f"/api/jobs/{first}/cancel")
+    offline["osm_wait"] = 0.0
+    again = c.post("/api/jobs", json=_body(bbox)).json()["id"]        # 취소 중에도 곧바로 다시 만들기(뒤에 줄 선다)
+    assert _wait_status(c, first, ("cancelled",)) == "cancelled"
+    assert _wait_status(c, again, ("done", "error")) == "done"
+    assert (s.jobs_dir / again / "scene.glb").exists() and not (s.jobs_dir / first).exists()
+    assert c.get(f"/api/jobs/{again}").json()["cancel_requested"] is False
+
+
+def should_cancel_only_one_when_two_jobs_run_together(tmp_path, mbtiles, bbox, offline):
+    offline["mesh_delay"] = 0.15
+    c, jm, s = _client(tmp_path, mbtiles, workers=2)
+    gj = _geojson(tmp_path, bbox)
+    a = c.post("/api/jobs", json=_body(bbox, buildings_geojson=gj)).json()["id"]
+    b = c.post("/api/jobs", json=_body(bbox, buildings_geojson=gj)).json()["id"]
+    assert offline["mesh_entered"].wait(30)
+    _wait_status(c, b, ("running",))
+    _cancel_and_time(c, a)
+    assert _wait_status(c, b, ("done", "error")) == "done"            # 다른 작업은 끝까지
+    assert (s.jobs_dir / b / "scene.json").exists() and not (s.jobs_dir / a).exists()
+    assert c.get(f"/api/jobs/{b}").json()["cancel_requested"] is False
+
+
+def should_not_cancel_when_writing_glb(tmp_path, mbtiles, monkeypatch):
+    """GLB 쓰기(0.85) 뒤는 취소하지 않는다(too_late) — 반쯤 쓴 장면이 남지 않게. 그 뒤 그대로 다 만든다."""
+    go = threading.Event()
+    at_write = threading.Event()
+
+    def fake_generate(req, settings, out_dir, prog):
+        prog(0.5, "메시")
+        prog(0.85, "GLB 쓰기")
+        at_write.set()
+        go.wait(10)
+        (out_dir / "scene.json").write_text(json.dumps({"bbox": list(req.bbox), "created": "2026-10-19T00:00:00"}), encoding="utf-8")
+        prog(1.0, "완료")
+    monkeypatch.setattr(jobs_mod, "generate", fake_generate)
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json={"bbox": [127.1, 37.36, 127.101, 37.361]}).json()["id"]
+    assert at_write.wait(10)
+    r = c.post(f"/api/jobs/{jid}/cancel").json()
+    assert r["result"] == "too_late" and r["cancel_requested"] is False
+    go.set()
+    assert _wait_status(c, jid, ("done", "cancelled")) == "done"
+
+
+def should_cancel_at_last_check_when_request_races_glb_step(tmp_path, mbtiles, monkeypatch):
+    """취소가 GLB 쓰기 단계 진입보다 먼저면 그 진입(진행 콜백)에서 멈춘다 — 파일은 쓰지 않는다."""
+    step = threading.Event()
+    go = threading.Event()
+
+    def fake_generate(req, settings, out_dir, prog):
+        prog(0.5, "메시")
+        step.set()
+        go.wait(10)
+        prog(0.85, "GLB 쓰기")
+        (out_dir / "scene.glb").write_bytes(b"x")
+    monkeypatch.setattr(jobs_mod, "generate", fake_generate)
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json={"bbox": [127.1, 37.36, 127.101, 37.361]}).json()["id"]
+    assert step.wait(10)
+    assert c.post(f"/api/jobs/{jid}/cancel").json()["result"] == "requested"
+    go.set()
+    assert _wait_status(c, jid, ("cancelled", "done")) == "cancelled"
+    assert not (s.jobs_dir / jid).exists()
+
+
+def should_keep_old_files_when_llm_edit_regeneration_cancelled(tmp_path, mbtiles, bbox, offline):
+    """같은 폴더에 다시 만드는 조정(edit)을 취소하면 옛 장면 파일은 그대로 남는다(폴더를 지우지 않는다)."""
+    c, jm, s = _client(tmp_path, mbtiles)
+    jid = c.post("/api/jobs", json=_body(bbox)).json()["id"]
+    assert _wait_status(c, jid, ("done", "error")) == "done"
+    glb = (s.jobs_dir / jid / "scene.glb").read_bytes()
+    offline["osm_wait"] = 30.0
+    offline["osm_entered"].clear()
+
+    class FakeLlm:
+        def edit_patch(self, instruction, params, buildings):
+            return {"explanation": "높이"}
+    jm.edit(jid, "더 높게", llm_client=FakeLlm())
+    assert offline["osm_entered"].wait(15)
+    _cancel_and_time(c, jid)
+    assert (s.jobs_dir / jid / "scene.glb").read_bytes() == glb
+    assert any(x["id"] == jid for x in c.get("/api/jobs").json()["scenes"])
+
+
+# ---------------------------------------------------------------- 확인 지점(단위)
+
+def _in_cancellable_thread(fn, cancel_after: float):
+    """취소 표시를 붙인 스레드에서 fn — cancel_after 초 뒤 취소. (예외, 걸린 시간)."""
+    ev, out = threading.Event(), {}
+
+    def work():
+        cancel.bind(ev)
+        t0 = time.time()
+        try:
+            fn()
+        except BaseException as ex:
+            out["ex"] = ex
+        finally:
+            out["took"] = time.time() - t0
+            cancel.bind(None)
+    t = threading.Thread(target=work)
+    t.start()
+    time.sleep(cancel_after)
+    ev.set()
+    t.join(10)
+    return out.get("ex"), out["took"] - cancel_after
+
+
+def should_stop_between_sam_tiles_when_cancelled(monkeypatch):
+    calls = []
+
+    def slow_grid(rgb, model_dir, grid, skip):
+        calls.append(1)
+        time.sleep(0.3)
+        return []
+    monkeypatch.setattr(sam, "segment_grid", slow_grid)
+    rgb = np.zeros((3000, 3000, 3), np.uint8)
+    ex, late = _in_cancellable_thread(lambda: extract._sam_cands(rgb, None, np.zeros((3000, 3000), bool)), 0.5)
+    assert isinstance(ex, cancel.Cancelled) and late < 1.0 and 1 <= len(calls) < 10
+
+
+def should_stop_inside_sam_point_grid_when_cancelled():
+    class SlowDec:
+        def run(self, _, feeds):
+            time.sleep(0.01)
+            return None, np.ones((1, 4)), np.zeros((1, 4, 256, 256), np.float32)
+    im = object.__new__(sam.SamImage)
+    im.dec, im.emb, im.s, im.H, im.W, im.hl, im.wl = SlowDec(), None, 1.0, 100, 100, 25, 25
+    ex, late = _in_cancellable_thread(lambda: im.grid(32), 0.2)     # 점 1024 개 × 10 ms ≈ 10 s
+    assert isinstance(ex, cancel.Cancelled) and late < 1.0
+
+
+def should_stop_between_ortho_tile_rows_when_cancelled(mbtiles, bbox):
+    from map3d.ortho import MBTiles, build_ortho
+    mb = MBTiles(str(mbtiles))
+    ev = threading.Event()
+    ev.set()
+    cancel.bind(ev)
+    try:
+        with pytest.raises(cancel.Cancelled):
+            build_ortho(mb, bbox, 16)
+    finally:
+        cancel.bind(None)
+        mb.close()
+
+
+def should_not_be_swallowed_by_broad_except_when_cancelled():
+    """Cancelled 는 BaseException — 파이프라인의 실패 대체(except Exception)에 먹히지 않는다."""
+    assert not issubclass(cancel.Cancelled, Exception)
+    ev = threading.Event()
+    ev.set()
+    cancel.bind(ev)
+    try:
+        with pytest.raises(cancel.Cancelled):
+            try:
+                cancel.check()
+            except Exception:
+                pass
+    finally:
+        cancel.bind(None)
+
+
+def should_do_nothing_when_no_cancel_bound():
+    cancel.bind(None)
