     @app.delete("/api/jobs/{job_id}", status_code=204)
     def delete_job(job_id: str):
         """장면 지우기(GIS 「3D 영역 관리」) — data/jobs 아래만. 예시(samples)는 405, 만드는 중이면 409."""
