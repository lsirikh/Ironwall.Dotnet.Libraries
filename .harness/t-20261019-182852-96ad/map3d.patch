+"""굽기 취소 — 작업 스레드마다 취소 표시(threading.Event)를 붙여 두고, 파이프라인의 단계 경계 · 긴 반복이 check() 로 확인한다.
+
+취소 표시가 없는 스레드(CLI · 시험의 직접 generate 호출)에서는 check() 가 아무것도 하지 않는다 — 예전과 같은 동작.
+"""
+from __future__ import annotations
+
+import threading
+
+_local = threading.local()
+POLL_S = 0.2   # 네트워크 대기(OSM · DEM)를 이 간격으로 확인 — 취소가 1~2초 안에 멈추게
+
+
+class Cancelled(BaseException):
+    """취소 요청으로 굽기를 멈춤. BaseException — 파이프라인의 넓은 except Exception(DEM · LLM 등 실패 대체)에 먹히지 않게."""
+
+
+def bind(event: threading.Event | None) -> None:
+    """이 스레드의 취소 표시를 정한다(None = 없앰)."""
+    _local.event = event
+
+
+def check() -> None:
+    """취소 요청이 있으면 Cancelled."""
+    ev = getattr(_local, "event", None)
+    if ev is not None and ev.is_set():
+        raise Cancelled("취소됨")
+
+
+def run(fn, *args, **kwargs):
+    """오래 기다리는 호출(네트워크)을 취소할 수 있게 — 취소 표시가 있으면 별도 스레드에서 돌리며 POLL_S 마다 확인한다.
+    취소되면 그 호출은 끝날 때까지 버려 둔다(결과는 쓰지 않는다 · 데몬 스레드). 표시가 없으면 그냥 부른다."""
+    ev = getattr(_local, "event", None)
+    if ev is None:
+        return fn(*args, **kwargs)
+    box: dict = {}
+
+    def work():
+        try:
+            box["value"] = fn(*args, **kwargs)
+        except BaseException as ex:   # 호출한 스레드에서 다시 던진다
+            box["error"] = ex
+    t = threading.Thread(target=work, name="map3d-wait", daemon=True)
+    t.start()
+    while t.is_alive():
+        check()
+        t.join(POLL_S)
+    check()
+    if "error" in box:
+        raise box["error"]
+    return box["value"]
