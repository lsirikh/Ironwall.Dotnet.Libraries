@@ -0,0 +1,162 @@
+"""회전 영역 — 굽기 · 뷰어가 같은 가정을 공유하지 않는 진실값으로 맞춰 보기(2026-10-19, GIS 작업 t-20261019-184431-1007).
+
+진실값: 사각형 로컬(x 오른쪽 · y 위쪽) 점의 위경도 = pyproj 측지선(방위 rotation + atan2(x, y), 거리 hypot) — RotRect 식을 쓰지 않는다.
+ENU = pyproj ECEF 를 이 파일의 접평면 식으로(LocalFrame 을 쓰지 않는다). 지형 높이 = 시험 DEM 함수 그대로.
+GLB 는 trimesh 로 정점을 직접 읽고, 뷰어처럼 y 축으로 sceneYaw(−회전각) 돌린다(three.js rotation.y 식을 여기 따로 적음).
+그다음 같은 진실값을 node(overlay_area_check.mjs)에 넘겨 뷰어 enuOf · makeHeightField 가 같은 자리를 가리키는지 본다."""
+import json
+import math
+import shutil
+import subprocess
+from pathlib import Path
+
+import httpx
+import numpy as np
+import pytest
+import trimesh
+from pyproj import Geod, Transformer
+
+from map3d.config import Settings
+from map3d.params import SceneParams
+from map3d.pipeline import GenerateRequest, generate
+
+from conftest import make_dem_tif, make_mbtiles
+
+# 안양 회전 영역(724 × 591 m)만 한 크기 — 구(球) 셈의 0.3 % 차가 모서리(약 460 m)에서 1 m 넘게 드러나는 크기
+LON0, LAT0, W, H = 127.1020, 37.3616, 720.0, 590.0
+BIG = (127.094, 37.355, 127.110, 37.368)
+GEOD = Geod(ellps="WGS84")
+TO_ECEF = Transformer.from_crs("EPSG:4979", "EPSG:4978", always_xy=True)
+BUILDINGS = [(0.0, 0.0), (250.0, 200.0), (-300.0, -220.0), (320.0, -250.0), (-200.0, 150.0)]   # 사각형 로컬(m)
+
+
+def dem_height(lon, lat):
+    return 100.0 + (np.asarray(lon) - BIG[0]) * 8860.0        # 동쪽으로 오르는 경사(약 10 %)
+
+
+@pytest.fixture
+def big_mbtiles(tmp_path):
+    return make_mbtiles(tmp_path / "big.mbtiles", BIG)
+
+
+@pytest.fixture
+def big_dem(tmp_path):
+    return make_dem_tif(tmp_path / "big_dem.tif", BIG, dem_height)
+
+
+def truth_lonlat(rot, x, y):
+    az = rot + math.degrees(math.atan2(x, y))
+    lon, lat, _ = GEOD.fwd(LON0, LAT0, az, math.hypot(x, y))
+    return lon, lat
+
+
+def truth_enu(origin, lon, lat, h=0.0):
+    """접평면 ENU(m) — 원점 (lon, lat, height) 기준. 반환 (동, 북, 위)."""
+    lo, la = math.radians(origin["lon"]), math.radians(origin["lat"])
+    x0 = np.array(TO_ECEF.transform(origin["lon"], origin["lat"], origin["height"]))
+    p = np.array(TO_ECEF.transform(lon, lat, h)) - x0
+    e = np.array([-math.sin(lo), math.cos(lo), 0.0])
+    n = np.array([-math.sin(la) * math.cos(lo), -math.sin(la) * math.sin(lo), math.cos(la)])
+    u = np.array([math.cos(la) * math.cos(lo), math.cos(la) * math.sin(lo), math.sin(la)])
+    return float(p @ e), float(p @ n), float(p @ u)
+
+
+def world_xz(local, rot):
+    """GLB 로컬(x, z) → 뷰어 세계(x, z) — three.js Object3D.rotation.y = −rot(도)."""
+    yaw = -math.radians(rot)
+    x, z = local[..., 0], local[..., 2]
+    return np.stack([x * math.cos(yaw) + z * math.sin(yaw), -x * math.sin(yaw) + z * math.cos(yaw)], -1)
+
+
+def _square(rot, cx, cy, half=4.0):
+    return [list(truth_lonlat(rot, cx + dx, cy + dy)) for dx, dy in ((-half, -half), (half, -half), (half, half), (-half, half), (-half, -half))]
+
+
+def _bake(tmp_path, mbtiles, slope_dem, rot):
+    gj = {"type": "FeatureCollection", "features": [
+        {"type": "Feature", "properties": {"height": 10, "name": f"B{i}"}, "geometry": {"type": "Polygon", "coordinates": [_square(rot, x, y)]}}
+        for i, (x, y) in enumerate(BUILDINGS)]}
+    p = tmp_path / f"b{rot}.geojson"
+    p.write_text(json.dumps(gj), encoding="utf-8")
+    corners = [truth_lonlat(rot, sx * W / 2, sy * H / 2) for sx, sy in ((-1, -1), (1, -1), (1, 1), (-1, 1))]
+    if rot % 360:
+        rect = {"lon": LON0, "lat": LAT0, "width_m": W, "height_m": H, "rotation_deg": rot}
+        bbox = (min(c[0] for c in corners) - 1e-5, min(c[1] for c in corners) - 1e-5, max(c[0] for c in corners) + 1e-5, max(c[1] for c in corners) + 1e-5)
+    else:
+        rect, bbox = None, (corners[0][0], corners[0][1], corners[2][0], corners[2][1])
+    s = Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"), overpass_endpoints=["https://a.example/api"])
+    req = GenerateRequest(bbox=bbox, params=SceneParams(zoom=16), dem_path=str(slope_dem), buildings_geojson=str(p), rect=rect)
+    with httpx.Client(transport=httpx.MockTransport(lambda r: httpx.Response(504))) as oc, \
+            httpx.Client(transport=httpx.MockTransport(lambda r: httpx.Response(404))) as dc:
+        sc = generate(req, s, tmp_path / f"s{rot}", osm_client=oc, dem_client=dc)
+    return sc, corners, trimesh.load(tmp_path / f"s{rot}" / "scene.glb", force="scene")
+
+
+def _verts(glb, pred):
+    out = []
+    for node in glb.graph.nodes_geometry:
+        T, gname = glb.graph.get(node)
+        if pred(gname):
+            out.append(trimesh.transform_points(glb.geometry[gname].vertices, T))
+    return np.concatenate(out) if out else np.zeros((0, 3))
+
+
+@pytest.mark.parametrize("rot", [0.0, 30.0, 65.0, 90.0, -45.0])
+def should_put_terrain_buildings_and_overlays_on_same_lonlat_when_rotated(tmp_path, big_mbtiles, big_dem, rot):
+    sc, corners, glb = _bake(tmp_path, big_mbtiles, big_dem, rot)
+    o = sc["origin"]
+    assert (sc.get("rect") or {}).get("rotation_deg", 0.0) == pytest.approx(rot % 360 if rot % 360 else 0.0)
+    terrain = glb.geometry["terrain"]
+    T = glb.graph.get(glb.graph.geometry_nodes["terrain"][0])[0]
+    tv = trimesh.transform_points(terrain.vertices, T)
+    nx, ny = sc["terrain"]["grid"]
+    assert len(tv) == nx * ny
+    tw = world_xz(tv, rot)
+
+    # ① 지형 네 모서리(세계) == 회전 사각형 모서리의 진짜 ENU
+    samples = []
+    for lon, lat in corners:
+        e, n, _ = truth_enu(o, lon, lat)
+        d = np.hypot(tw[:, 0] - e, tw[:, 1] + n)
+        i = int(d.argmin())
+        assert d[i] < 0.1, f"rot {rot}: terrain corner {d[i]:.3f} m from truth"
+        samples.append({"what": f"corner {lon:.6f},{lat:.6f}", "lon": lon, "lat": lat, "local": tv[i].tolist()})
+
+    # ② 건물 가운데(세계) == 같은 위경도의 진짜 ENU(±0.5 m)
+    bv = _verts(glb, lambda g: g.startswith("building"))
+    for i, (x, y) in enumerate(BUILDINGS):
+        lon, lat = truth_lonlat(rot, x, y)
+        e, n, _ = truth_enu(o, lon, lat)
+        bw = world_xz(bv, rot)
+        near = bv[np.hypot(bw[:, 0] - e, bw[:, 1] + n) < 7.0]
+        assert len(near), f"rot {rot}: building B{i} not found near truth"
+        c = (near.min(0) + near.max(0)) / 2
+        cw = world_xz(c[None], rot)[0]
+        assert math.hypot(cw[0] - e, cw[1] + n) < 0.5, f"rot {rot}: building B{i} center off by {math.hypot(cw[0] - e, cw[1] + n):.3f} m"
+        samples.append({"what": f"building B{i}", "lon": lon, "lat": lat, "local": c.tolist()})
+
+    # ③ 지형 높이 == DEM(진실 함수) — 건물 자리 다지기에서 먼 정점만
+    heights = []
+    rng = np.random.default_rng(int(rot) + 1000)
+    bld_w = [np.array(truth_enu(o, *truth_lonlat(rot, x, y))[:2]) for x, y in BUILDINGS]
+    for i in rng.choice(len(tv), 400, replace=False):
+        e, nn = tw[i, 0], -tw[i, 1]
+        if min(math.hypot(e - b[0], nn - b[1]) for b in bld_w) < 25:
+            continue
+        # 세계 ENU(e, n) → 위경도: 진실 ENU 를 거꾸로 — 측지선 방위 · 거리(접평면에서 수백 m 는 mm 차)
+        lon, lat, _ = GEOD.fwd(o["lon"], o["lat"], math.degrees(math.atan2(e, nn)), math.hypot(e, nn))
+        want = float(dem_height(lon, lat)) - o["height"]
+        assert tv[i, 1] == pytest.approx(want, abs=0.05), f"rot {rot}: terrain height at {lon},{lat}"
+        if len(heights) < 60:
+            heights.append({"lon": lon, "lat": lat, "y": want})
+    assert len(heights) >= 30
+
+    # ④ 뷰어(node): 같은 위경도의 enuOf == GLB 정점을 sceneYaw 로 돌린 자리(±0.5 m) · 높이표 == 진짜 높이(±0.1 m)
+    node = shutil.which("node")
+    assert node, "node 가 없어 뷰어 진실값 시험(overlay_area_check.mjs)을 돌릴 수 없다"
+    truth = {"name": f"rot{rot:g}", "scene": {"origin": o, **({"rect": sc["rect"]} if sc.get("rect") else {}), "bbox": sc["bbox"]},
+             "samples": samples, "grid": [nx, ny], "terrain": [round(float(v), 4) for v in tv.ravel()], "heights": heights}
+    tp = tmp_path / "truth.json"
+    tp.write_text(json.dumps(truth), encoding="utf-8")
+    r = subprocess.run([node, str(Path(__file__).with_name("overlay_area_check.mjs")), str(tp)], capture_output=True, text=True, timeout=120)
+    assert r.returncode == 0, r.stdout + r.stderr
