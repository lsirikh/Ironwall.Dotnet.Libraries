@@ -0,0 +1,98 @@
+// 장면 영역 밖 오버레이 · 오버레이 ↔ 지형 같은 자리 시험(2026-10-19, GIS 작업 t-20261019-184431-1007) — pytest(test_rotated_truth.py)가 node 로 부른다.
+//   1) itemInArea — 실제 안양 자리: 옛 장면(5e0a01, 북쪽 정렬 bbox) 안에 들어가면 1 km 떨어진 발전소 사진 · 표식은 영역 밖, 회전 장면(f366a1)이면 안.
+//   2) Overlay3D.refreshVisibility 가 영역 밖 항목을 숨긴다(three 는 vendor 에서 — 없으면 이 칸만 건너뛴다).
+//   3) 인자로 진실값 JSON(파이썬이 pyproj 측지 계산 · GLB 정점으로 만든 것)을 주면: GLB 로컬 정점을 sceneYaw 로 돌린 세계 좌표 == 같은 위경도의 enuOf(±0.5 m),
+//      높이표(makeHeightField yaw)가 그 자리 진짜 높이와 같다(±0.1 m).
+import { existsSync, readFileSync } from "node:fs";
+import { register } from "node:module";
+import { areaOf, enuOf, sceneYaw } from "../map3d/static/camsync.js";
+import { itemInArea, makeHeightField } from "../map3d/static/overlay-geom.js";
+
+const fails = [];
+const ok = (c, what) => { if (!c) fails.push(what); };
+
+// ---------------------------------------------------------------- 1) 실제 안양 자리
+const OLD = { bbox: [126.956, 37.3834, 126.964, 37.3897], origin: { lon: 126.96, lat: 37.38655 } };   // 20261017-205808-5e0a01
+const ROT = {                                                                                          // 20261019-183014-f366a1
+  origin: { lon: 126.96700662374496, lat: 37.39415334867756 },
+  rect: { lon: 126.96700662374496, lat: 37.39415334867756, width_m: 724.4817532435172, height_m: 591.3991628399579, rotation_deg: 65,
+          corners: [[126.9622512999616, 37.395985430520646], [126.9657089943689, 37.390069286955594], [126.97176194752834, 37.39232126683448], [126.96830425312103, 37.39823741039953]] },
+  bbox: [126.9622413, 37.3900593, 126.9717719, 37.3982474],
+};
+const plantImage = { kind: "image", id: 31, bounds: { left: 126.96482164, top: 37.39578595, right: 126.9691326, bottom: 37.39168981 }, rotation: 0 };
+const plantPoint = { kind: "pids", id: 1, lon: 126.96698, lat: 37.39374 };
+const inOld = (it) => itemInArea(it, OLD.origin, areaOf(OLD.bbox).corners, enuOf);
+const inRot = (it) => itemInArea(it, ROT.origin, areaOf(ROT.rect).corners, enuOf);
+ok(!inOld(plantImage), "old scene: plant image is outside (floats in void)");
+ok(!inOld(plantPoint), "old scene: plant marker is outside");
+ok(inRot(plantImage), "rotated scene: plant image inside");
+ok(inRot(plantPoint), "rotated scene: plant marker inside");
+ok(inOld({ kind: "pids", id: 2, lon: 126.96, lat: 37.3866 }), "old scene: its own center inside");
+// 감싸는 bbox 의 모서리(회전 사각형 밖) — 회전 장면은 그 자리에 지형이 없다
+ok(!inRot({ kind: "pids", id: 3, lon: ROT.bbox[2] - 1e-4, lat: ROT.bbox[3] - 1e-4 }), "rotated scene: bbox corner (outside rect) hidden");
+ok(!inRot({ kind: "pids", id: 4, lon: ROT.bbox[0] + 1e-4, lat: ROT.bbox[1] + 1e-4 }), "rotated scene: other bbox corner hidden");
+
+// ---------------------------------------------------------------- 1') 모양별 겹침
+{
+  const o = { lon: 127.0, lat: 37.0 }, area = areaOf([126.999, 36.999, 127.001, 37.001]).corners;   // 약 178 m × 222 m
+  const f = (it) => itemInArea(it, o, area, enuOf);
+  ok(f({ kind: "line", pts: [[37.0, 126.99], [37.0, 127.01]] }), "line crossing area without vertex inside");
+  ok(!f({ kind: "line", pts: [[37.002, 126.99], [37.002, 127.01]] }), "line passing north of area");
+  ok(f({ kind: "polygon", pts: [[37.01, 126.99], [37.01, 127.01], [36.99, 127.01], [36.99, 126.99]] }), "polygon enclosing area");
+  ok(!f({ kind: "line", closed: false, pts: [[37.01, 126.99], [37.01, 127.01], [36.99, 127.01], [36.99, 126.99]] }), "open line around area (no overlap)");
+  ok(f({ kind: "image", bounds: { left: 126.99, top: 37.01, right: 127.01, bottom: 36.99 }, rotation: 0 }), "image covering whole area");
+  ok(f({ kind: "image", bounds: { left: 127.0009, top: 37.0, right: 127.003, bottom: 36.99 }, rotation: 0 }), "image overlapping edge");
+  ok(!f({ kind: "image", bounds: { left: 127.002, top: 37.0, right: 127.003, bottom: 36.99 }, rotation: 0 }), "image east of area");
+  ok(f({ kind: "pids", id: 9 }), "no position -> shown (as before)");
+  ok(itemInArea({ kind: "pids", lon: 0, lat: 0 }, o, null, enuOf), "no area -> shown (as before)");
+}
+
+// ---------------------------------------------------------------- 2) Overlay3D 배선
+const three = new URL("../map3d/static/vendor/three/build/three.module.js", import.meta.url);
+if (existsSync(three)) {
+  const jsm = new URL("../map3d/static/vendor/three/examples/jsm/", import.meta.url).href;
+  register("data:text/javascript," + encodeURIComponent(
+    `export async function resolve(s, c, n) { if (s === "three") return n(${JSON.stringify(three.href)}, c);
+       if (s.startsWith("three/addons/")) return n(${JSON.stringify(jsm)} + s.slice(13), c); return n(s, c); }`));
+  const THREE = await import("three");
+  const { Overlay3D } = await import("../map3d/static/overlay3d.js");
+  for (const [name, scene, outside, inside] of [["old", OLD, [plantImage, plantPoint], [{ kind: "pids", id: 2, lon: 126.96, lat: 37.3866 }]],
+                                                 ["rot", ROT, [{ kind: "pids", id: 3, lon: ROT.bbox[2] - 1e-4, lat: ROT.bbox[3] - 1e-4 }], [plantImage, plantPoint]]]) {
+    const ov = new Overlay3D({ scene: new THREE.Scene(), camera: {}, host: {}, origin: () => scene.origin, area: () => scene.rect || scene.bbox, groundY: () => 0 });
+    const items = [...outside, ...inside];
+    ov.store.apply({ type: "overlay.snapshot", rev: 1, points: items.filter((i) => i.kind !== "image"), images: items.filter((i) => i.kind === "image") });
+    for (const it of items) ov.nodes.set(`${it.kind}:${it.id}`, { group: new THREE.Group() });
+    ov.refreshVisibility(18);
+    for (const it of outside) ok(ov.nodes.get(`${it.kind}:${it.id}`).group.visible === false, `${name}: Overlay3D hides ${it.kind}:${it.id} outside`);
+    for (const it of inside) ok(ov.nodes.get(`${it.kind}:${it.id}`).group.visible === true, `${name}: Overlay3D shows ${it.kind}:${it.id} inside`);
+    if (ov.store.items.size !== items.length) fails.push(`${name}: store did not take snapshot (${ov.store.items.size})`);
+  }
+} else console.log("(three vendor 없음 — Overlay3D 배선 칸 건너뜀)");
+
+// ---------------------------------------------------------------- 3) 진실값(파이썬)
+const truthPath = process.argv[2];
+if (truthPath) {
+  const t = JSON.parse(readFileSync(truthPath, "utf-8"));
+  const yaw = sceneYaw(t.scene), c = Math.cos(yaw), s = Math.sin(yaw);
+  const world = ([x, y, z]) => ({ x: x * c + z * s, y, z: -x * s + z * c });   // three.js rotation.y
+  let worst = 0;
+  for (const p of t.samples) {
+    const w = world(p.local), e = enuOf(t.scene.origin, p.lon, p.lat), d = Math.hypot(w.x - e.x, w.z - e.z);
+    worst = Math.max(worst, d);
+    if (!(d <= 0.5)) fails.push(`${t.name} ${p.what}: overlay(enuOf) vs terrain/building ${d.toFixed(3)} m`);
+  }
+  const pos = new Float32Array(t.terrain.length);
+  for (let i = 0; i < t.terrain.length; i += 3) { const w = world([t.terrain[i], t.terrain[i + 1], t.terrain[i + 2]]); pos[i] = w.x; pos[i + 1] = w.y; pos[i + 2] = w.z; }
+  const hf = makeHeightField(pos, t.grid[0], t.grid[1], yaw);
+  let worstH = 0;
+  if (!hf) fails.push(`${t.name}: height field null`);
+  else for (const h of t.heights) {
+    const e = enuOf(t.scene.origin, h.lon, h.lat), d = Math.abs(hf.sample(e.x, e.z) - h.y);
+    worstH = Math.max(worstH, d);
+    if (!(d <= 0.1)) fails.push(`${t.name} height at ${h.lon},${h.lat}: ${hf.sample(e.x, e.z)} != ${h.y}`);
+  }
+  console.log(`${t.name}: samples ${t.samples.length} worst ${worst.toFixed(3)} m · heights ${t.heights.length} worst ${worstH.toFixed(3)} m`);
+}
+
+if (fails.length) { console.log(fails.join("\n")); process.exit(1); }
+console.log("overlay area ok");
