+def should_match_by_iou_threshold_and_one_item_per_building_when_reattaching():
+    sq = lambda x0, y0, d: [[x0, y0], [x0 + d, y0], [x0 + d, y0 + d], [x0, y0 + d], [x0, y0]]   # noqa: E731
+
+    def spec(i, ring):
+        return BuildingSpec(id=i, source="user", source_id=f"u{i}", footprint_ll=Polygon(ring), tags={}, height=6.0)
+
+    def item(uid, ring, h=20.0):
+        p = Polygon(ring)
+        return {"uid": uid, "center": [p.centroid.x, p.centroid.y], "area_m2": 400.0, "footprint": ring, "height": h, "floors": None}
+    a = sq(127.1, 37.36, 0.0002)                     # 약 18 × 22 m
+    specs = [spec(1, a), spec(2, sq(127.1010, 37.36, 0.0002))]
+    near = item("near", sq(127.10001, 37.36001, 0.0002))      # 1 m 남짓 밀림 → 붙음
+    dup = item("dup", sq(127.10006, 37.36006, 0.0002), 9.0)   # 같은 건물에 덜 겹침 → 못 붙음(건물 하나에 하나)
+    far = item("far", sq(127.1005, 37.36, 0.0002))            # 겹치지 않음
+    manual, auto, left = heights.apply_to_specs(specs, [near, dup, far])
+    assert set(manual) == {1} and manual[1]["uid"] == "near" and specs[0].height == 20.0 and specs[0].height_source == "manual"
+    assert auto[1] == {"height": 6.0, "height_source": "default", "levels": None}
+    assert {it["uid"] for it in left} == {"dup", "far"} and specs[1].height == 6.0
+    # 옛 장면(윤곽 없음) — 중심 · 면적 원으로 겹침을 잰다
+    assert heights.iou({"center": [127.1, 37.36], "area_m2": 300.0}, {"center": [127.1, 37.36], "area_m2": 300.0}) == pytest.approx(1.0, abs=1e-6)
+    assert heights.iou({"center": [127.1, 37.36], "area_m2": 300.0}, {"center": [127.101, 37.36], "area_m2": 300.0}) == 0.0
