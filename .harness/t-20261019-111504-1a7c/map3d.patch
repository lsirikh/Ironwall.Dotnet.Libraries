+"""건물 높이 직접 입력(덮어쓰기) — 보안 구역처럼 공개 건물 자료(층수)를 못 구할 때 운영자가 GIS 에서 건물을 골라 높이를 넣는다.
+
+저장: data/overrides/area-<영역 키>.json — 영역(bbox) 단위 파일. 항목 하나 = 건물 자리(바닥 윤곽 위경도 · 중심 · 면적) + 높이 · 층수.
+  장면 id 가 아니라 자리로 붙인다 — 다시 굽기(새 장면 id) · 다른 방식(tiles · extract) 굽기는 장면 범위에 중심이 든 항목을
+  가장 많이 겹치는(IoU ≥ MATCH_IOU) 건물에 다시 붙이고 높이 출처를 manual 로 둔다. 못 붙인 항목은 지우지 않고 남겨 알린다.
+지금 장면: 다시 굽지 않고 그 건물의 GLB 정점만 세로로 고친다(stretch_y — 벽은 늘이고 지붕 · 난간 · 옥탑은 그대로 올린다) +
+  scene.json 그 건물 줄 · 집계를 고친다. 뷰어 미리보기(static/buildingedit.js)와 같은 식이다.
+"""
+from __future__ import annotations
+
+import datetime as dt
+import hashlib
+import json
+import math
+import os
+import secrets
+import struct
+import threading
+from pathlib import Path
+
+import numpy as np
+from shapely.geometry import Point, Polygon
+
+MATCH_IOU = 0.4          # 다시 붙이는 겹침 하한(바닥 윤곽 IoU) — 다시 굽기에서 윤곽이 조금 달라도(몇 m 밀림 · 꼭짓점 차이) 붙는다
+MIN_H, MAX_H = 1.0, 600.0
+MIN_FLOORS, MAX_FLOORS = 1, 200
+TOP_EPS = 1e-3           # 벽 꼭대기(pivot) 판정 여유(m) — 이 위 정점은 통째로 올린다
+
+_lock = threading.Lock()  # 덮어쓰기 파일 · 장면 파일 쓰기는 한 번에 하나(같은 프로세스 안 동시 요청)
+
+
+# ---------------------------------------------------------------- 세로 늘이기(뷰어 buildingedit.js 와 같은 식)
+
+def wall_top(b: dict, height: float) -> float:
+    """그 높이일 때 벽 꼭대기(ENU 위 z) — 평지붕 = 바닥 + 높이, 박공 · 모임 · 외쪽 지붕 = 처마(높이 − 지붕 솟음, 2.2 m 이상).
+    build_building 과 같은 규칙(높이 2 m 미만은 2 m)."""
+    h = max(float(height), 2.0)
+    g = float(b["ground_min"])
+    rh = b.get("roof_height")
+    return g + (max(h - float(rh), 2.2) if rh else h)
+
+
+def stretch_y(y: np.ndarray, base: float, p0: float, p1: float) -> np.ndarray:
+    """세로 좌표 고치기 — 옛 벽 꼭대기 p0 위(지붕 · 난간 · 옥탑)는 p1 − p0 만큼 올리고, 그 밑(벽)은 바닥 base 기준으로 늘인다."""
+    y = np.asarray(y, dtype=np.float64)
+    if p0 - base <= 1e-6:
+        return y + (p1 - p0)
+    k = (p1 - base) / (p0 - base)
+    return np.where(y >= p0 - TOP_EPS, y + (p1 - p0), base + (y - base) * k)
+
+
+def restretch_glb(path: Path, bid: int, base: float, p0: float, p1: float, extras: dict) -> bool:
+    """GLB 안 건물 노드(extras.kind=building · id=bid)의 정점 높이(glTF y)를 고치고 extras 를 덧쓴다 — 고쳤으면 True.
+    float 정점 · 변환 없는 노드만(map3d GltfBuilder 형식). 압축 · 양자화 GLB 는 건드리지 않는다(False)."""
+    if not path.exists():
+        return False
+    data = bytearray(path.read_bytes())
+    magic, _, _ = struct.unpack_from("<4sII", data, 0)
+    if magic != b"glTF":
+        return False
+    jlen, jtype = struct.unpack_from("<I4s", data, 12)
+    if jtype != b"JSON":
+        return False
+    gl = json.loads(bytes(data[20:20 + jlen]).decode("utf-8"))
+    if gl.get("extensionsUsed"):
+        return False
+    bin_off = 20 + jlen + 8
+    node = next((n for n in gl.get("nodes", []) if (n.get("extras") or {}).get("kind") == "building"
+                 and (n.get("extras") or {}).get("id") == bid and "mesh" in n), None)
+    if node is None or any(k in node for k in ("matrix", "translation", "rotation", "scale")):
+        return False
+    for prim in gl["meshes"][node["mesh"]]["primitives"]:
+        acc = gl["accessors"][prim["attributes"]["POSITION"]]
+        if acc.get("componentType") != 5126 or acc.get("type") != "VEC3" or acc.get("sparse"):
+            return False
+        bv = gl["bufferViews"][acc["bufferView"]]
+        stride = bv.get("byteStride") or 12
+        start = bin_off + bv.get("byteOffset", 0) + acc.get("byteOffset", 0)
+        n = acc["count"]
+        raw = np.frombuffer(bytes(data[start:start + stride * (n - 1) + 12]), dtype=np.uint8)
+        pos = np.lib.stride_tricks.as_strided(raw.view(np.float32), shape=(n, 3), strides=(stride, 4)).astype(np.float64)
+        pos[:, 1] = stretch_y(pos[:, 1], base, p0, p1)
+        out = pos.astype(np.float32)
+        if stride == 12:
+            data[start:start + 12 * n] = out.tobytes()
+        else:
+            for i in range(n):
+                data[start + i * stride:start + i * stride + 12] = out[i].tobytes()
+        acc["min"] = [float(v) for v in out.min(axis=0)]
+        acc["max"] = [float(v) for v in out.max(axis=0)]
+    node["extras"] = {**node.get("extras", {}), **extras}
+    js = json.dumps(gl, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+    js += b" " * ((-len(js)) % 4)
+    rest = bytes(data[20 + jlen:])
+    out_b = struct.pack("<4sII", b"glTF", 2, 12 + 8 + len(js) + len(rest)) + struct.pack("<I4s", len(js), b"JSON") + js + rest
+    tmp = path.with_name(path.name + ".tmp")
+    tmp.write_bytes(out_b)
+    os.replace(tmp, path)
+    return True
+
+
+# ---------------------------------------------------------------- 자리 맞추기
+
+def _meters(lon0: float, lat0: float):
+    kx = 111320.0 * math.cos(math.radians(lat0))
+
+    def f(lon, lat):
+        return (lon - lon0) * kx, (lat - lat0) * 110540.0
+    return f
+
+
+def _shape(rec: dict, to_m) -> Polygon:
+    """바닥 윤곽(미터) — footprint 가 있으면 그것, 없으면(옛 장면) 중심 · 면적의 원."""
+    fp = rec.get("footprint")
+    if fp and len(fp) >= 4:
+        p = Polygon([to_m(x, y) for x, y in fp]).buffer(0)
+        if not p.is_empty and p.area > 0:
+            return p
+    cx, cy = to_m(*rec["center"])
+    return Point(cx, cy).buffer(math.sqrt(max(float(rec.get("area_m2") or 1.0), 1.0) / math.pi), 16)
+
+
+def iou(a: dict, b: dict) -> float:
+    """두 건물 자리(center · area_m2 · footprint)의 겹침 비율."""
+    to_m = _meters(*a["center"])
+    pa, pb = _shape(a, to_m), _shape(b, to_m)
+    inter = pa.intersection(pb).area
+    union = pa.union(pb).area
+    return inter / union if union > 0 else 0.0
+
+
+def match(items: list[dict], buildings: list[dict], threshold: float = MATCH_IOU) -> tuple[dict, list[dict]]:
+    """덮어쓰기 항목 → 건물 id(가장 많이 겹치는 것, IoU ≥ 임계, 건물 하나엔 가장 잘 겹치는 항목 하나). 반환 (uid → (id, iou), 못 붙인 항목)."""
+    cands = []
+    for it in items:
+        r = math.sqrt(max(float(it.get("area_m2") or 1.0), 1.0))
+        to_m = _meters(*it["center"])
+        for b in buildings:
+            if not b.get("center"):
+                continue
+            bx, by = to_m(*b["center"])
+            if math.hypot(bx, by) > 2 * (r + math.sqrt(max(float(b.get("area_m2") or 1.0), 1.0))) + 10:
+                continue
+            v = iou(it, b)
+            if v >= threshold:
+                cands.append((v, it["uid"], b["id"]))
+    cands.sort(reverse=True)
+    got, used = {}, set()
+    for v, uid, bid in cands:
+        if uid in got or bid in used:
+            continue
+        got[uid] = (bid, round(v, 3))
+        used.add(bid)
+    return got, [it for it in items if it["uid"] not in got]
+
+
+# ---------------------------------------------------------------- 저장
+
+def overrides_dir(data_dir) -> Path:
+    return Path(data_dir) / "overrides"
+
+
+def area_file(data_dir, bbox) -> Path:
+    """영역 파일 — 이름은 bbox(소수 5자리) 해시라 요청 값이 경로가 되지 않는다(경로 이동 불가)."""
+    key = hashlib.sha1(",".join(f"{float(v):.5f}" for v in bbox).encode("ascii")).hexdigest()[:16]
+    return overrides_dir(data_dir) / f"area-{key}.json"
+
+
+def _read(p: Path) -> dict:
+    try:
+        d = json.loads(p.read_text(encoding="utf-8"))
+        return d if isinstance(d, dict) and isinstance(d.get("items"), list) else {"items": []}
+    except (OSError, json.JSONDecodeError):
+        return {"items": []}
+
+
+def _write(p: Path, d: dict):
+    p.parent.mkdir(parents=True, exist_ok=True)
+    tmp = p.with_name(p.name + ".tmp")
+    tmp.write_text(json.dumps(d, ensure_ascii=False, indent=2), encoding="utf-8")
+    os.replace(tmp, p)
+
+
+def _files(data_dir):
+    d = overrides_dir(data_dir)
+    return sorted(d.glob("area-*.json")) if d.exists() else []
+
+
+def items_in(data_dir, bbox) -> list[dict]:
+    """장면 범위에 중심이 든 모든 덮어쓰기(어느 영역 파일이든 — 다시 굽기 영역이 조금 달라도)."""
+    out = []
+    for p in _files(data_dir):
+        for it in _read(p)["items"]:
+            c = it.get("center") or [None, None]
+            if c[0] is not None and bbox[0] <= c[0] <= bbox[2] and bbox[1] <= c[1] <= bbox[3]:
+                out.append(it)
+    return out
+
+
+def _put_item(data_dir, bbox, item: dict):
+    for p in _files(data_dir):
+        d = _read(p)
+        if any(it.get("uid") == item["uid"] for it in d["items"]):
+            d["items"] = [item if it.get("uid") == item["uid"] else it for it in d["items"]]
+            _write(p, d)
+            return
+    p = area_file(data_dir, bbox)
+    d = _read(p)
+    d["bbox"] = [float(v) for v in bbox]
+    d["items"].append(item)
+    _write(p, d)
+
+
+def _drop_items(data_dir, pred) -> int:
+    n = 0
+    for p in _files(data_dir):
+        d = _read(p)
+        keep = [it for it in d["items"] if not pred(it)]
+        if len(keep) != len(d["items"]):
+            n += len(d["items"]) - len(keep)
+            d["items"] = keep
+            _write(p, d)
+    return n
+
+
+# ---------------------------------------------------------------- 굽기(pipeline) 에서
+
+def apply_to_specs(specs, items: list[dict]) -> tuple[dict, dict, list[dict]]:
+    """다시 굽기 — 항목을 건물 사양에 붙여 높이 · 층수를 바꾼다(높이 출처 manual).
+    반환 (건물 id → manual 정보, 건물 id → 붙이기 전 자동 값, 못 붙인 항목)."""
+    if not items or not specs:
+        return {}, {}, list(items)
+    recs = []
+    for s in specs:
+        c = s.footprint_ll.centroid
+        to_m = _meters(c.x, c.y)
+        recs.append({"id": s.id, "center": [c.x, c.y], "footprint": [list(p) for p in s.footprint_ll.exterior.coords],
+                     "area_m2": Polygon([to_m(x, y) for x, y in s.footprint_ll.exterior.coords]).area})
+    got, unmatched = match(items, recs)
+    by_id = {s.id: s for s in specs}
+    manual, auto = {}, {}
+    for it in items:
+        if it["uid"] not in got:
+            continue
+        bid, v = got[it["uid"]]
+        s = by_id[bid]
+        auto[bid] = {"height": round(float(s.height), 2), "height_source": s.height_source, "levels": s.levels}
+        s.height, s.height_source = float(it["height"]), "manual"
+        s.levels = int(it["floors"]) if it.get("floors") else None
+        manual[bid] = {"uid": it["uid"], "height": float(it["height"]), "floors": it.get("floors"), "iou": v}
+    return manual, auto, unmatched
+
+
+def footprint_list(poly) -> list:
+    return [[round(x, 7), round(y, 7)] for x, y in poly.exterior.coords]
+
+
+# ---------------------------------------------------------------- 지금 장면에서(서버 REST)
+
+class HeightError(Exception):
+    def __init__(self, status: int, detail: str):
+        super().__init__(detail)
+        self.status, self.detail = status, detail
+
+
+def _recount(scene: dict):
+    bs = scene.get("buildings", [])
+    c = scene.setdefault("counts", {})
+
+    def count(key):
+        out = {}
+        for b in bs:
+            out[b.get(key)] = out.get(b.get(key), 0) + 1
+        return out
+    c["buildings_estimated"] = sum(1 for b in bs if b.get("estimated"))
+    c["buildings_by_height_source"] = count("height_source")
+    c["buildings_by_height_from"] = count("height_from")
+    ho = scene.setdefault("height_overrides", {"applied": 0, "unmatched": []})
+    ho["applied"] = sum(1 for b in bs if b.get("manual"))
+
+
+def _save_scene(job_dir: Path, scene: dict):
+    sj = job_dir / "scene.json"
+    tmp = sj.with_name("scene.json.tmp")
+    tmp.write_text(json.dumps(scene, ensure_ascii=False, indent=2), encoding="utf-8")
+    os.replace(tmp, sj)
+
+
+def _reshape(job_dir: Path, scene: dict, b: dict, new_h: float):
+    """그 건물 GLB 정점 · top_z 를 새 높이로, GLB 노드 extras(뷰어가 읽는 높이 · 출처)도 b 에 맞춘다. b 의 출처 · 층수는 먼저 고쳐 둔다."""
+    p0, p1 = wall_top(b, b["height"]), wall_top(b, new_h)
+    if "base_z" in b:
+        extras = {"height": round(new_h, 2), "height_source": b.get("height_source"), "levels": b.get("levels"),
+                  "estimated": bool(b.get("estimated"))}
+        for name in ("scene.glb", (scene.get("detail") or {}).get("glb") or "scene_detail.glb"):
+            restretch_glb(job_dir / name, b["id"], float(b["base_z"]), p0, p1, extras)
+        if b.get("top_z") is not None:
+            b["top_z"] = round(float(b["top_z"]) + (p1 - p0), 3)
+    b["height"] = round(new_h, 2)
+
+
+def set_height(data_dir, job_dir: Path, bid: int, height: float | None, floors: int | None = None) -> dict:
+    """그 장면 건물 높이를 직접 입력(height) 또는 자동으로 되돌리기(None) — 덮어쓰기 파일 · GLB · scene.json. 반환 = 고친 건물 줄."""
+    with _lock:
+        scene = json.loads((job_dir / "scene.json").read_text(encoding="utf-8"))
+        b = next((x for x in scene.get("buildings", []) if x.get("id") == bid), None)
+        if b is None:
+            raise HeightError(404, f"건물 {bid} 이 이 장면에 없습니다")
+        if height is None:
+            if not b.get("manual"):
+                return b
+            uid = b["manual"]["uid"]
+            _drop_items(data_dir, lambda it: it.get("uid") == uid)
+            a = b.get("auto") or {}
+            for k in ("height_source", "height_from", "levels", "estimated"):
+                if k in a:
+                    b[k] = a[k]
+            _reshape(job_dir, scene, b, float(a.get("height", b["height"])))
+            b.pop("manual", None)
+            b.pop("auto", None)
+        else:
+            if not b.get("center"):
+                raise HeightError(409, "이 장면은 건물 자리(중심)가 없어 직접 입력을 저장할 수 없습니다 — 다시 만들어 주세요")
+            if "auto" not in b:
+                b["auto"] = {k: b.get(k) for k in ("height", "height_source", "height_from", "levels", "estimated")}
+            uid = (b.get("manual") or {}).get("uid") or secrets.token_hex(6)
+            item = {"uid": uid, "center": b["center"], "area_m2": b.get("area_m2"), "footprint": b.get("footprint"),
+                    "height": round(float(height), 1), "floors": floors,
+                    "updated": dt.datetime.now().astimezone().isoformat(timespec="seconds")}
+            _put_item(data_dir, scene["bbox"], item)
+            b.update(height_source="manual", height_from="manual", estimated=False,
+                     manual={"uid": uid, "height": item["height"], "floors": floors})
+            if floors:
+                b["levels"] = floors
+            _reshape(job_dir, scene, b, item["height"])
+        _recount(scene)
+        _save_scene(job_dir, scene)
+        return b
+
+
+def reset_all(data_dir, job_dir: Path) -> list[dict]:
+    """그 장면 직접 입력 높이를 모두 자동으로 — 장면 범위의 못 붙인 항목도 지운다. 반환 = 되돌린 건물 줄(뷰어가 그대로 반영)."""
+    scene = json.loads((job_dir / "scene.json").read_text(encoding="utf-8"))
+    ids = [b["id"] for b in scene.get("buildings", []) if b.get("manual")]
+    rows = [set_height(data_dir, job_dir, bid, None) for bid in ids]
+    with _lock:
+        bbox = scene["bbox"]
