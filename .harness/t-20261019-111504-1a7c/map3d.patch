+def should_reattach_override_after_rebake_even_if_outline_moves(tmp_path, mbtiles, slope_dem):
+    scene = _bake(tmp_path, mbtiles, slope_dem)
+    fb = _flat(scene)
+    c = _client(tmp_path, mbtiles)
+    assert c.put(f"/api/jobs/j1/buildings/{fb['id']}/height", json={"height": 27.5, "floors": 9}).status_code == 200
+    # 영역 밖이 아닌 곳에 건물이 없는 직접 입력(못 붙음 — 지우지 않고 남겨 알린다)
+    heights._put_item(tmp_path / "data", scene["bbox"], {"uid": "lost", "center": [127.1035, 37.3628], "area_m2": 200.0,
+                                                          "footprint": None, "height": 9.0, "floors": 3})
+    # 다시 굽기(새 장면 id) — 바닥 윤곽이 약 1.5 m 밀려도 붙는다
+    again = _bake(tmp_path, mbtiles, slope_dem, job="j2", shift=(0.000015, 0.00001))
+    nb = _flat(again)
+    assert nb["height"] == 27.5 and nb["height_source"] == "manual" and nb["height_from"] == "manual" and nb["levels"] == 9
+    assert nb["manual"]["iou"] >= heights.MATCH_IOU and nb["auto"]["height"] == 12 and nb["auto"]["height_source"] == "user"
+    assert again["height_overrides"] == {"applied": 1, "unmatched": ["lost"]}
+    assert again["counts"]["buildings_by_height_source"]["manual"] == 1
+    assert any("다시 붙이지 못한 직접 입력" in w for w in again["warnings"])
+    assert nb["top_z"] - nb["ground_min"] > 27.5 - 0.2                             # 굽기도 새 높이로 세웠다
+    listed = {s["id"]: s for s in c.get("/api/jobs").json()["scenes"]}
+    assert listed["j2"]["manual_heights"] == 1 and listed["j2"]["manual_unmatched"] == 1
+    assert c.get("/api/jobs/j2/height-overrides").json()["unmatched"] == 1
+    # 새 장면에서 자동으로 되돌리면 굽기 전 자동 값으로
+    b = c.delete(f"/api/jobs/j2/buildings/{nb['id']}/height").json()["building"]
+    assert b["height"] == 12 and b["height_source"] == "user"
+    # 「모두 자동으로」 — 장면 범위의 못 붙인 것까지 지운다
+    assert c.put(f"/api/jobs/j2/buildings/{nb['id']}/height", json={"height": 15}).status_code == 200
+    r = c.delete("/api/jobs/j2/height-overrides")
+    assert r.status_code == 200 and r.json()["reset"] == 1 and r.json()["overrides"] == {"applied": 0, "unmatched": 0, "buildings": []}
+    assert [(b["id"], b["height"], b["height_source"]) for b in r.json()["buildings"]] == [(nb["id"], 12, "user")]
+    assert not [it for p in (tmp_path / "data" / "overrides").glob("area-*.json") for it in json.loads(p.read_text(encoding="utf-8"))["items"]]
+
