+    # 예시 장면 405 · 만드는 중 409
+    demo = tmp_path / "data" / "samples" / "demo"
+    shutil.copytree(tmp_path / "data" / "jobs" / "j1", demo)
+    assert c.put(f"/api/jobs/demo/buildings/{bid}/height", json={"height": 10}).status_code == 405
+    assert c.delete("/api/jobs/demo/height-overrides").status_code == 405
+    from map3d.jobs import Job
+    c.app.state.jobs.jobs["j1"] = Job(id="j1", dir=tmp_path / "data" / "jobs" / "j1", status="running")
