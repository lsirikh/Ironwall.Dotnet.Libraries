+// 건물 높이 직접 입력 — 3D 에서 건물 고르기 · 미리보기(세로 늘이기)의 순수 함수(three 무의존, node 시험 tests/building_check.mjs).
+//   늘이기 식은 서버 heights.py(wall_top · stretch_y)와 같다 — 판에서 본 미리보기와 「적용」 뒤 서버가 고친 GLB 가 같은 모양이다.
+//   GIS ↔ 3D 메시지
+//     보내는 것 {type:"building", id, origin, height, height_source, height_from, levels, area_m2, lon, lat, manual}
+//     받는 것   {type:"building.preview", id, height|null}  — 그 건물만 그 높이로(null = 원래대로)
+//               {type:"building.select", id|null}          — 윤곽 강조(null = 지움)
+//               {type:"building.commit", id, building:{…}} — 서버가 저장한 건물 줄(그 높이를 새 원래 모양으로)
+
+export const CLICK_DEAD_PX = 4;      // 누른 자리에서 이만큼(px) 안에서 뗐으면 클릭 — 넘으면 끌기 · 돌리기
+export const TOP_EPS = 1e-3;         // 벽 꼭대기 판정 여유(m) — heights.TOP_EPS
+export const MIN_H = 1, MAX_H = 600;
+
+/** 누름 → 뗌이 클릭인가(데드존 안). down 이 없으면(캔버스 밖에서 누름) 클릭 아님. */
+export function isClick(down, up, dead = CLICK_DEAD_PX) {
+  return !!down && !!up && Math.hypot(up[0] - down[0], up[1] - down[1]) <= dead;
+}
+
+/** 그 높이일 때 벽 꼭대기(glTF y) — 평지붕 = 바닥 + 높이, 경사 지붕 = 처마(높이 − 지붕 솟음, 2.2 m 이상). 2 m 밑은 2 m. */
+export function wallTop(b, height) {
+  const h = Math.max(Number(height), 2.0), g = Number(b.ground_min);
+  return b.roof_height ? g + Math.max(h - Number(b.roof_height), 2.2) : g + h;
+}
+
+/** 세로 좌표 하나 — 옛 벽 꼭대기 p0 위(지붕 · 난간 · 옥탑)는 p1 − p0 만큼 올리고, 그 밑(벽)은 바닥 base 기준으로 늘인다. */
+export function stretchY(y, base, p0, p1) {
+  if (p0 - base <= 1e-6) return y + (p1 - p0);
+  return y >= p0 - TOP_EPS ? y + (p1 - p0) : base + (y - base) * (p1 - base) / (p0 - base);
+}
+
+/** 정점 배열(x, y, z 반복) — src(원래 모양)를 늘여 dst 에 쓴다(x · z 는 그대로). dst 를 돌려준다. */
+export function stretchPositions(src, dst, base, p0, p1) {
+  for (let i = 0; i < src.length; i += 3) {
+    dst[i] = src[i]; dst[i + 1] = stretchY(src[i + 1], base, p0, p1); dst[i + 2] = src[i + 2];
+  }
+  return dst;
+}
+
+/** 고른 건물 → GIS 메시지. b = scene.json 건물 줄(없으면 GLB 노드 extras), at = 누른 자리 [lon, lat](중심이 없을 때). */
+export function buildingMessage(b, at) {
+  if (!b || !Number.isInteger(b.id)) return null;
+  const c = Array.isArray(b.center) && b.center.length === 2 ? b.center : at;
+  const num = (v) => (Number.isFinite(v) ? v : null);
+  return {
+    type: "building", id: b.id, origin: b.origin ?? null, height: num(b.height),
+    height_source: b.height_source ?? null, height_from: b.height_from ?? b.height_source ?? null,
+    levels: Number.isInteger(b.levels) ? b.levels : null, area_m2: num(b.area_m2),
+    lon: c ? num(c[0]) : null, lat: c ? num(c[1]) : null, manual: !!b.manual,
+  };
+}
+
+/** GIS → 3D 건물 메시지 검사 — 형식이 틀리면 null(그 메시지는 버린다). */
+export function parseHostBuilding(d) {
+  if (!d || typeof d.type !== "string") return null;
+  const okId = Number.isInteger(d.id) && d.id > 0;
+  if (d.type === "building.select") return d.id === null ? { type: d.type, id: null } : okId ? { type: d.type, id: d.id } : null;
+  if (!okId) return null;
+  if (d.type === "building.preview") {
+    if (d.height === null) return { type: d.type, id: d.id, height: null };
+    return Number.isFinite(d.height) && d.height >= MIN_H && d.height <= MAX_H ? { type: d.type, id: d.id, height: d.height } : null;
+  }
+  if (d.type === "building.commit") {
+    const b = d.building;
+    // 자동으로 되돌린 높이는 자료에 따라 1 m 밑일 수도 있다 — 양수면 받는다
+    return b && b.id === d.id && Number.isFinite(b.height) && b.height > 0 ? { type: d.type, id: d.id, building: b } : null;
+  }
+  return null;
+}
