+# 평지붕 큰 건물(난간 · 옥탑이 붙는다) · 박공 작은 건물
+FLAT = [[127.1010, 37.3610], [127.1013, 37.3610], [127.1013, 37.3612], [127.1010, 37.3612], [127.1010, 37.3610]]
+GABLE = [[127.1020, 37.3615], [127.1022, 37.3615], [127.1022, 37.3616], [127.1020, 37.3616], [127.1020, 37.3615]]
+
+
+def _settings(tmp_path, mbtiles):
+    return Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"), overpass_endpoints=[])
+
+
+def _bake(tmp_path, mbtiles, dem, job="j1", shift=(0.0, 0.0)):
+    gj = {"type": "FeatureCollection", "features": [
+        {"type": "Feature", "properties": {"height": 12},
+         "geometry": {"type": "Polygon", "coordinates": [[[x + shift[0], y + shift[1]] for x, y in FLAT]]}},
+        {"type": "Feature", "properties": {"roof_shape": "gabled"},
+         "geometry": {"type": "Polygon", "coordinates": [GABLE]}},
+    ]}
+    p = tmp_path / f"user-{job}.geojson"
+    p.write_text(json.dumps(gj), encoding="utf-8")
+    from conftest import BBOX
+    req = GenerateRequest(bbox=BBOX, params=SceneParams(zoom=16), dem_path=str(dem), buildings_geojson=str(p),
+                          offline=True, fill_gaps=False)
+    with httpx.Client(transport=httpx.MockTransport(lambda r: httpx.Response(404))) as dem_client:
+        return generate(req, _settings(tmp_path, mbtiles), tmp_path / "data" / "jobs" / job, dem_client=dem_client)
+
+
+def _all_ys(glb: Path, bid: int) -> np.ndarray:
+    raw = glb.read_bytes()
+    jlen = int.from_bytes(raw[12:16], "little")
+    gl = json.loads(raw[20:20 + jlen])
+    node = next(n for n in gl["nodes"] if (n.get("extras") or {}).get("id") == bid and (n.get("extras") or {}).get("kind") == "building")
+    out = []
+    for prim in gl["meshes"][node["mesh"]]["primitives"]:
+        acc = gl["accessors"][prim["attributes"]["POSITION"]]
+        bv = gl["bufferViews"][acc["bufferView"]]
+        start = 20 + jlen + 8 + bv.get("byteOffset", 0)
+        arr = np.frombuffer(raw[start:start + acc["count"] * 12], dtype=np.float32).reshape(-1, 3)
+        assert np.allclose(acc["max"], arr.max(axis=0)) and np.allclose(acc["min"], arr.min(axis=0))   # min/max 도 맞춘다
+        out.append(arr[:, 1])
+    return np.concatenate(out), node["extras"]
+
+
+def _client(tmp_path, mbtiles):
+    return TestClient(create_app(_settings(tmp_path, mbtiles)))
+
+
