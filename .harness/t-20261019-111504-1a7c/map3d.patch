+def should_keep_files_consistent_when_requests_race(tmp_path, mbtiles, slope_dem):
+    scene = _bake(tmp_path, mbtiles, slope_dem)
+    ids = [b["id"] for b in scene["buildings"]]
+    glb = tmp_path / "data" / "jobs" / "j1" / "scene.glb"
+    before = {b["id"]: (_all_ys(glb, b["id"])[0], b) for b in scene["buildings"]}
+    c = _client(tmp_path, mbtiles)
+    errors = []
+
+    def worker(k):
+        try:
+            for i in range(4):
+                r = c.put(f"/api/jobs/j1/buildings/{ids[k % 2]}/height", json={"height": 10 + k + i})
+                if r.status_code != 200:
+                    errors.append(r.text)
+        except Exception as ex:   # noqa: BLE001
+            errors.append(repr(ex))
+    ts = [threading.Thread(target=worker, args=(k,)) for k in range(8)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    assert not errors
+    saved = json.loads((tmp_path / "data" / "jobs" / "j1" / "scene.json").read_text(encoding="utf-8"))
+    items = [it for p in (tmp_path / "data" / "overrides").glob("area-*.json") for it in json.loads(p.read_text(encoding="utf-8"))["items"]]
+    assert len(items) == 2 and saved["height_overrides"]["applied"] == 2          # 건물마다 항목 하나
+    for b in saved["buildings"]:
+        it = next(x for x in items if x["uid"] == b["manual"]["uid"])
+        assert b["height"] == it["height"]                                          # 장면 · 파일이 같은 마지막 값
+        ys, extras = _all_ys(glb, b["id"])
+        assert extras["height"] == b["height"]
+        y0, b0 = before[b["id"]]
+        want = heights.stretch_y(y0, b0["base_z"], heights.wall_top(b0, b0["height"]), heights.wall_top(b0, b["height"]))
+        assert np.allclose(ys, want, atol=2e-3)                                     # GLB 정점도 마지막 값 한 번 늘인 것과 같다
+    assert not list((tmp_path / "data").rglob("*.tmp"))
+
