+        Assert.AreEqual("extract", _port.OverlayMode);
+    }
+
+    // ── 순수 규칙 ──
+
+    [DataTestMethod]
+    [DataRow(17d, 16.5d, 15d, null)]
+    [DataRow(17d, 16.5d, 16.5d, null)]
+    [DataRow(17d, 17d, 15d, SettingsValidation.Map3DExitOrderMessage)]
+    [DataRow(17d, 18d, 15d, SettingsValidation.Map3DExitOrderMessage)]
+    [DataRow(17d, 16.5d, 16.6d, SettingsValidation.Map3DPreloadOrderMessage)]
