+    /// <summary>
+    /// 3D 지도 줌 순서(칸 사이 규칙) — 2D 로 돌아가는 줌 &lt; 3D 로 바뀌는 줌, 미리 준비하는 줌 ≤ 2D 로 돌아가는 줌.
+    /// 숫자가 아닌 칸은 그 칸의 규칙이 알리므로 여기서는 넘어간다.
+    /// </summary>
+    public static string? Map3DZoomOrder(object? enterZoom, object? exitZoom, object? preloadZoom)
+    {
+        if (!TryNumber(enterZoom, out var enter) || !TryNumber(exitZoom, out var exit)) return null;
+        if (exit >= enter) return Map3DExitOrderMessage;
+        return TryNumber(preloadZoom, out var preload) && preload > exit ? Map3DPreloadOrderMessage : null;
+    }
+
