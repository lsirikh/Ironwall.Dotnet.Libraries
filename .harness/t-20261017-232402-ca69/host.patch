+﻿using Ironwall.Dotnet.Libraries.Base.Services;
+using Ironwall.Dotnet.Libraries.GMaps.Models;
+using Ironwall.Dotnet.Libraries.GMaps.Ui.Helpers;
+using System;
+using System.Threading.Tasks;
+
+namespace Dotnet.Monitoring.Solution.ViewModels.Panels.SetupPanels;
+/****************************************************************************
+   Purpose      : 설정 창 「3D 지도」 절 창구 — AppSettings.Map3D(라이브러리 Map3DModel)를 읽고 쓴다.
+   Note         : 칸마다의 setter 는 모델 한 벌을 고친 뒤 MapSettingsHelper.SaveMap3DAsync 로 절을 통째로 저장한다
+                  (파일 잠금으로 차례대로 쓰고, 쓸 때의 모델 전체가 들어간다). 저장이 끝나면 지도가 Map3DSaved 를 받아 다시 불러온다.
+                  줌 순서는 저장 전에 설정 창의 칸 사이 규칙(SettingsValidation.Map3DZoomOrder)이 막으므로 여기서 고치지 않는다.
+   Created On   : 2026-10-17 · Sensorway Co., Ltd.
+****************************************************************************/
+internal sealed class Map3DSettingsViewModel : IMap3DSettingsPort
+{
+    private readonly ILogService? _log;
+    private Map3DModel? _model;
+
+    public Map3DSettingsViewModel(ILogService log) => _log = log;
+
+    private Map3DModel Model => _model ??= MapSettingsHelper.LoadMap3D(_log);
+
+    public void Reload() => _model = MapSettingsHelper.LoadMap3D(_log);
+
+    public bool IsEnabled { get => Model.IsEnabled; set => Save(m => m.IsEnabled = value); }
+    public double EnterZoom { get => Model.EnterZoom; set => Save(m => m.EnterZoom = value); }
+    public double ExitZoom { get => Model.ExitZoom; set => Save(m => m.ExitZoom = value); }
+    public double PreloadZoom { get => Model.PreloadZoom; set => Save(m => m.PreloadZoom = value); }
+    public double GuideMinSeconds { get => Model.GuideMinSeconds; set => Save(m => m.GuideMinSeconds = value); }
+    public double AreaShowZoom { get => Model.AreaShowZoom; set => Save(m => m.AreaShowZoom = value); }
+    public int MaxAreaSideM { get => (int)Math.Round(Model.MaxAreaSideM); set => Save(m => m.MaxAreaSideM = value); }
+    public string OverlayMode { get => Model.OverlayMode; set => Save(m => m.OverlayMode = value); }
+
+    /// <summary>주소 — 끝 '/' 는 떼어 저장한다(지도가 쓰는 모양). 다듬은 값은 칸이 다시 읽어 맞춘다.</summary>
+    public string ServerUrl
+    {
+        get => Model.ServerUrl;
+        set
+        {
+            var probe = new Map3DModel { ServerUrl = value };
+            probe.Normalize();
+            Save(m => m.ServerUrl = probe.ServerUrl);
+        }
+    }
+
+    public bool UseCompositionHost { get => Model.UseCompositionHost; set => Save(m => m.UseCompositionHost = value); }
+
+    private void Save(Action<Map3DModel> change)
+    {
+        change(Model);
+        _ = SaveAsync(Model);
+    }
+
+    private async Task SaveAsync(Map3DModel model)
+    {
+        try { await MapSettingsHelper.SaveMap3DAsync(model, _log); }
+        catch (Exception ex) { _log?.Error($"[Map3D] 설정 저장 실패: {ex.Message}"); }
+    }
+}
