+        if (string.IsNullOrEmpty(text)) return EmptyMessage;
+        return Uri.TryCreate(text, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
+            ? null : HttpUrlMessage;
+    }
