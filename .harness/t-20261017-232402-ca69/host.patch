+
+namespace Dotnet.Monitoring.Solution.Tests.SetupPanels;
+
+/****************************************************************************
+   Purpose      : 설정 창 「3D 지도」 절(AppSettings.Map3D) — 칸 · 소제목 · 범위 검증 · 줌 순서(칸 사이 규칙) · "?" 도움말. 창 없이.
+                  진짜 창구(Map3DSettingsViewModel)는 setter 가 설정 파일 쓰기라 가짜 창구를 끼운다.
+   Created On   : 2026-10-17 · Sensorway Co., Ltd.
+****************************************************************************/
+[TestClass]
+public class Map3DSettingsSectionTests
+{
+    /// <summary>라이브러리 Map3DModel 기본값과 같은 가짜 창구 — 쓴 칸을 순서대로 적는다.</summary>
+    private sealed class FakeMap3DPort : IMap3DSettingsPort
+    {
+        public List<string> Writes { get; } = new();
+        public int Reloads { get; private set; }
+
+        private bool _enabled = true, _composition = true;
+        private double _enter = 17, _exit = 16.5, _preload = 15, _guide = 0.6, _area = 13;
+        private int _maxSide = 2000;
+        private string _mode = "tiles", _url = "http://127.0.0.1:8765";
+
+        public bool IsEnabled { get => _enabled; set { _enabled = value; Writes.Add(nameof(IsEnabled)); } }
+        public double EnterZoom { get => _enter; set { _enter = value; Writes.Add(nameof(EnterZoom)); } }
+        public double ExitZoom { get => _exit; set { _exit = value; Writes.Add(nameof(ExitZoom)); } }
+        public double PreloadZoom { get => _preload; set { _preload = value; Writes.Add(nameof(PreloadZoom)); } }
+        public double GuideMinSeconds { get => _guide; set { _guide = value; Writes.Add(nameof(GuideMinSeconds)); } }
+        public double AreaShowZoom { get => _area; set { _area = value; Writes.Add(nameof(AreaShowZoom)); } }
+        public int MaxAreaSideM { get => _maxSide; set { _maxSide = value; Writes.Add(nameof(MaxAreaSideM)); } }
+        public string OverlayMode { get => _mode; set { _mode = value; Writes.Add(nameof(OverlayMode)); } }
+        public string ServerUrl { get => _url; set { _url = value; Writes.Add(nameof(ServerUrl)); } }
+        public bool UseCompositionHost { get => _composition; set { _composition = value; Writes.Add(nameof(UseCompositionHost)); } }
+        public void Reload() => Reloads++;
+    }
+
+    private FakeMap3DPort _port = null!;
+
+    [TestInitialize]
+    public void Setup()
+    {
+        _port = new FakeMap3DPort();
+        RuntimeHelpers.RunModuleConstructor(typeof(HostHelp).Module.ModuleHandle);
+    }
+
+    private SettingsFormController Form()
+    {
+        var form = new SettingsFormController(new[] { SettingsCatalog.Map3DSection(() => _port) });
+        form.SelectFirst();
+        HeadlessAwait(form.EnterAsync(form.ActiveSection));
+        return form;
+    }
+
+    private static void HeadlessAwait(Task task) => task.GetAwaiter().GetResult();
+
+    private static SettingsFieldViewModel Field(SettingsFormController form, string key)
+        => form.Sections.SelectMany(s => s.Fields).First(f => f.Key == key);
+
+    // ── 절 모양 ──
+
+    [TestMethod]
+    public void should_list_ten_fields_under_three_groups_when_map3d_section_built()
+    {
+        var section = SettingsCatalog.Map3DSection(() => _port);
+
+        Assert.AreEqual("map3d", section.Key);
+        Assert.AreEqual("3D 지도", section.RailText);
+        Assert.AreEqual(HostHelp.SettingsMap3D, section.HelpKey);
+        Assert.AreEqual(string.Empty, section.Banner, "설명은 \"?\" 로 — 화면에 긴 글 금지");
+        CollectionAssert.AreEqual(
+            new[] { "사용", "3D 로 바뀌는 줌", "2D 로 돌아가는 줌", "미리 준비하는 줌", "안내 표시 시간",
+                    "영역 표시 줌", "영역 최대 크기", "기본 만들기 방식", "3D 서버 주소", "WPF 안에서 그리기" },
+            section.Fields.Select(f => f.Label).ToArray());
+        CollectionAssert.AreEqual(new[] { "전환", "영역", "연결" }, section.Fields.Select(f => f.Group).Distinct().ToArray());
+        Assert.IsTrue(section.Fields.All(f => f.ApiName.StartsWith("Map3D.", StringComparison.Ordinal)), "실제 키 = AppSettings.Map3D.*");
+    }
+
+    [TestMethod]
+    public void should_resolve_rail_icon_when_icon_name_is_a_real_pack_icon()
+    {
+        var section = SettingsCatalog.Map3DSection(() => _port);
+        Assert.IsTrue(Enum.TryParse<PackIconKind>(section.IconKind, ignoreCase: false, out _), $"PackIconKind 에 없는 이름 '{section.IconKind}'");
+    }
+
+    [TestMethod]
+    public void should_reload_port_when_section_entered()
+    {
+        Form();
+        Assert.AreEqual(1, _port.Reloads, "절에 들어갈 때 설정 파일을 다시 읽는다");
+    }
+
+    [TestMethod]
+    public void should_offer_three_bake_modes_when_overlay_mode_field_opened()
+    {
+        var form = Form();
+        var mode = Field(form, "map3d.OverlayMode");
+        CollectionAssert.AreEqual(new[] { "tiles", "composite", "extract" }, mode.Options.Select(o => o.Value).ToArray());
+        Assert.AreEqual("위성 타일만", mode.SelectedChoice?.Display);
+    }
+
+    // ── 줌 순서(칸 사이 규칙) ──
+
+    [TestMethod]
+    public void should_block_save_and_tell_reason_when_exit_zoom_is_not_below_enter_zoom()
+    {
+        var form = Form();
+        Field(form, "map3d.ExitZoom").Text = "17";
+
+        Assert.IsTrue(form.HasError);
+        Assert.IsFalse(form.CanApply, "줌 순서를 어기면 [저장] 꺼짐");
+        StringAssert.Contains(form.FooterText, SettingsValidation.Map3DExitOrderMessage);
+        Assert.AreEqual(0, form.Save());
+        Assert.AreEqual(0, _port.Writes.Count, "아무것도 쓰지 않는다");
+    }
+
+    [TestMethod]
+    public void should_block_save_when_preload_zoom_is_above_exit_zoom()
+    {
+        var form = Form();
+        Field(form, "map3d.PreloadZoom").Text = "16.6";
+
+        Assert.IsFalse(form.CanApply);
+        StringAssert.Contains(form.FooterText, SettingsValidation.Map3DPreloadOrderMessage);
+    }
+
+    [TestMethod]
+    public void should_save_in_order_when_all_zooms_raised_together()
+    {
+        var form = Form();
+        Field(form, "map3d.EnterZoom").Text = "19";
+        Field(form, "map3d.ExitZoom").Text = "18.5";
+        Field(form, "map3d.PreloadZoom").Text = "18";
+
+        Assert.IsTrue(form.CanApply);
+        Assert.AreEqual(3, form.Save());
+        CollectionAssert.AreEqual(new[] { "EnterZoom", "ExitZoom", "PreloadZoom" }, _port.Writes);
+        Assert.AreEqual((19d, 18.5d, 18d), (_port.EnterZoom, _port.ExitZoom, _port.PreloadZoom));
+        Assert.IsFalse(form.HasError);
+    }
+
+    [TestMethod]
+    public void should_clear_order_error_when_draft_is_reverted()
+    {
+        var form = Form();
+        Field(form, "map3d.EnterZoom").Text = "16";
+        Assert.IsTrue(form.HasError);
+
+        form.Revert();
+
+        Assert.IsFalse(form.HasError);
+        Assert.AreEqual(string.Empty, form.Sections[0].CheckError);
+    }
+
+    // ── 칸 하나의 범위 ──
+
+    [DataTestMethod]
+    [DataRow("map3d.EnterZoom", "21")]
+    [DataRow("map3d.AreaShowZoom", "9.5")]
+    [DataRow("map3d.MaxAreaSideM", "100")]
+    [DataRow("map3d.MaxAreaSideM", "6000")]
+    [DataRow("map3d.GuideMinSeconds", "3.5")]
+    [DataRow("map3d.ServerUrl", "ftp://10.0.0.5")]
+    [DataRow("map3d.ServerUrl", "")]
+    public void should_mark_field_error_when_value_out_of_range(string key, string text)
+    {
+        var form = Form();
+        var field = Field(form, key);
+        field.Text = text;
+
+        Assert.IsTrue(field.HasError, $"{key} = '{text}'");
+        Assert.IsFalse(form.CanApply);
+    }
+
+    [TestMethod]
+    public void should_write_server_url_and_switches_when_changed()
+    {
+        var form = Form();
+        Field(form, "map3d.ServerUrl").Text = "http://10.0.0.5:8765";
+        Field(form, "map3d.IsEnabled").BoolValue = false;
+        Field(form, "map3d.UseCompositionHost").BoolValue = false;
