+        assert c.put(url, json=bad).status_code == 422, bad
+    for bad in ({**good, "outline": [[127.1030, 37.3620], [127.1033, 37.3622], [127.1033, 37.3620], [127.1030, 37.3622]]},   # 자기 교차
+                {**good, "outline": [[127.1030, 37.3620], [127.1033, 37.3620], [True, 37.3622]]},
+                {**good, "outline": [[127.2, 37.36], [127.2003, 37.36], [127.2003, 37.3602]]}):              # 영역 밖
+        assert c.put(url, json=bad).status_code == 400, bad
+    for bad_uid in ("A1B2C3D4E5F6", "short", "a1b2c3d4e5f6a", "..", "a1b2c3d4e5f%2F"):
+        assert c.put(f"/api/jobs/j1/user-buildings/{bad_uid}", json=good).status_code in (404, 405, 422), bad_uid
+    for bad_job in ("nojob", "..", "a.b", "..%5Cj1"):
