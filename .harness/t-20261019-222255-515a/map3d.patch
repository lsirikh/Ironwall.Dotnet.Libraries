+"""직접 그린 건물(userbuildings.py · /api/jobs/{id}/user-buildings) — 저장 · 검증 · 굽기 우선 · 겹친 자동 건물 빼기 · 옥상 텍스처 ·
+외벽 방식 · 회전 영역 · 외부 자료 0건 · 다시 만들기 유지 · 3D 「건물 높이」 판으로 높이 고치기 · 뷰어 상자 미리보기(node)."""
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import httpx
+import numpy as np
+import pytest
+from fastapi.testclient import TestClient
+from shapely.geometry import Polygon
+
+from map3d import heights, userbuildings as UB
+from map3d import pipeline as PL
+from map3d.buildings import BuildingSpec
+from map3d.config import Settings
+from map3d.geo import parse_rect
+from map3d.params import SceneParams
+from map3d.pipeline import GenerateRequest, generate
+from map3d.server import create_app
+
+from test_heights import FLAT, GABLE, _all_ys, _bake, _settings
+from test_rotated_area import RECT, _gen, _rr, _square, _user_geojson
+from test_scenarios_f import BB, _building_nodes, _glb_json, _no_net, _node_materials, _offline
+from test_overlay import OV, _illustration
+
+UID, UID2 = "a1b2c3d4e5f6", "0123456789ab"
+# FLAT(지도 자료 평지붕 26 × 22 m)를 덮는 오각형 — 그 자리 자동 건물을 갈아 끼운다
+OVER_FLAT = [[127.10095, 37.36095], [127.10135, 37.36095], [127.10135, 37.36125], [127.10115, 37.36130], [127.10095, 37.36125]]
+# 빈 자리(자동 건물 없음) 사각형 약 26 × 22 m
+EMPTY = [[127.1030, 37.3620], [127.1033, 37.3620], [127.1033, 37.3622], [127.1030, 37.3622]]
+
+
+def _client(tmp_path, mbtiles):
+    return TestClient(create_app(_settings(tmp_path, mbtiles)))
+
+
+def _files(tmp_path):
+    return sorted((tmp_path / "data" / "user-buildings").glob("area-*.json"))
+
+
+# ---------------------------------------------------------------- 검증
+def should_reject_bad_outlines_and_accept_closed_ring_when_cleaning():
+    ok = UB.clean_outline(EMPTY + [EMPTY[0]])                       # 닫힌 고리도 받는다(끝점은 뺀다)
+    assert ok == EMPTY and len(ok) == 4
+    bad = [
+        None, "x", [[1, 2], [3, 4]],                                # 형식 · 3점 미만
+        [[127.1, 37.36], [127.1001, 37.36], [True, 37.3601]],       # 참 · 거짓
+        [[127.1, 37.36], [127.1001, 37.36], ["127.1", 37.3601]],    # 글
+        [[127.1, 37.36], [127.1001, 37.36], [float("nan"), 37.3601]],
+        [[127.1, 37.36], [127.1001, 37.36], [127.1, 95.0]],          # 범위 밖
+        [[127.1, 37.36], [127.1001, 37.36], [127.1, 37.3601, 5]],     # 세 숫자
+        [[127.1000, 37.3600], [127.1003, 37.3602], [127.1003, 37.3600], [127.1000, 37.3602]],   # 나비넥타이(자기 교차)
+        [[127.1, 37.36], [127.100001, 37.36], [127.1, 37.360001]],   # 너무 작다
+        [[127.0, 37.36], [127.03, 37.36], [127.03, 37.38]],          # 한 변 2 km 넘음
+        [[127.1 + i * 1e-6, 37.36 + (i % 2) * 1e-4] for i in range(201)],   # 꼭짓점 200 개 넘음
+    ]
+    for o in bad:
+        with pytest.raises(UB.UserBuildingError) as ex:
+            UB.clean_outline(o)
+        assert ex.value.status == 400, o
+
+
+def should_name_user_files_like_override_files_when_saving():
+    bbox = [127.1, 37.36, 127.104, 37.3632]
+    p = UB.area_file("D:/x", bbox)
