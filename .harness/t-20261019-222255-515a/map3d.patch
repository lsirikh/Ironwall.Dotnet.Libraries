+  eq(cleanOutline(Array.from({ length: 201 }, (_, i) => [i * 1e-5, (i % 2) * 1e-5])), null, "201 points");
+}
+// 서버 목록 → 아직 안 구운 것만 상자
+{
+  const list = { items: [
+    { uid: UID, outline: SQ, height: 18, baked_id: null },
+    { uid: "0123456789ab", outline: SQ, height: 9, baked_id: 4 },     // 구워짐 → 상자 없음(GLB 에 이미 있다)
+    { uid: "bad", outline: SQ, height: 9, baked_id: null },           // 형식 틀림 → 버림
+  ] };
+  eq(pendingBoxes(list).map((m) => m.uid), [UID], "pending only");
+  eq(pendingBoxes(null), [], "no list");
+  eq(pendingBoxes({}), [], "no items");
+}
+// 상자 모양 — 장면 평면(동 · 북 m), 반시계 고리, 바닥 = 꼭짓점 지면의 가장 낮은 값
+{
+  const origin = { lon: 127.102, lat: 37.3616 };
+  const toEnu = (lon, lat) => enuOf(origin, lon, lat);
+  const cw = [...SQ].reverse();                                        // 시계 방향으로 줘도
+  const { ring, base, area } = boxShape(cw, toEnu, (x, z) => 50 + x * 0.01 - z * 0.02);
+  let s = 0;
+  for (let i = 0; i < ring.length; i++) s += ring[i][0] * ring[(i + 1) % ring.length][1] - ring[(i + 1) % ring.length][0] * ring[i][1];
+  eq(s > 0, true, "ccw");
+  near(area, 26.5 * 22.2, 12, "area m2");                              // 약 26.5 × 22.2 m
+  const e0 = toEnu(SQ[0][0], SQ[0][1]);
+  eq(ring.some(([e, n]) => Math.abs(e - e0.x) < 1e-9 && Math.abs(n + e0.z) < 1e-9), true, "north = -z");
+  const grounds = SQ.map(([lon, lat]) => { const p = toEnu(lon, lat); return 50 + p.x * 0.01 - p.z * 0.02; });
+  near(base, Math.min(...grounds), 1e-9, "base = lowest ground");
+}
+// view.js 연결
+{
+  const src = readFileSync(new URL("../map3d/static/view.js", import.meta.url), "utf8");
+  for (const s of ["parseHostUserBuilding(data)", "onUserBuildingMessage(m)", "pendingBoxes(await r.json())", "loadUserBoxes()",
+    "ExtrudeGeometry(shape, { depth: m.height", "geo.rotateX(-Math.PI / 2)", "/user-buildings`", "scene.add(mesh)"])
+    if (!src.includes(s)) fails.push(`view.js lacks ${s}`);
+}
+
+if (fails.length) { console.log(fails.join("\n")); process.exit(1); }
+console.log("userbuilding ok");
