+    assert len(json.loads(files[0].read_text(encoding="utf-8"))["items"]) == 1
+    # 두 번째 · 하나 지우기 · 모두 지우기
+    assert c.put(f"/api/jobs/j1/user-buildings/{UID2}", json={"outline": OVER_FLAT, "height": 25}).json()["count"] == 2
+    assert c.delete(f"/api/jobs/j1/user-buildings/{UID}").json() == {"deleted": 1, "count": 1}
+    assert c.delete(f"/api/jobs/j1/user-buildings/{UID}").status_code == 404
+    assert c.delete("/api/jobs/j1/user-buildings").json() == {"deleted": 1, "count": 0}
+    assert c.get("/api/jobs/j1/user-buildings").json()["count"] == 0
+    assert not list((tmp_path / "data").rglob("*.tmp"))
+
+
+def should_reject_bad_input_paths_and_outside_area_without_writing(tmp_path, mbtiles, slope_dem):
+    _bake(tmp_path, mbtiles, slope_dem)
