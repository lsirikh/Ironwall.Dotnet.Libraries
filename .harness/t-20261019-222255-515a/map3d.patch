+"""직접 그린 건물 — 운영자가 GIS 2D 지도에서 위에서 본 윤곽을 그리고 높이를 넣으면, 굽기가 그 건물을 출처 "user" 로 우선 만든다.
+
+저장: data/user-buildings/area-<영역 키>.json — 영역 키는 건물 높이 직접 입력(heights.area_file)과 같은 bbox 해시라
+  요청 값이 경로가 되지 않는다. 항목 하나 = {uid, outline[[lon, lat] …](닫지 않은 꼭짓점), height, floors, name, created, updated}.
+굽기: 장면 범위(회전 영역은 회전 사각형)에 중심이 든 항목을 건물 사양(source "drawn" → scene.json origin "user")으로 넣고,
+  그 건물과 겹치는 자동 건물(지도 · 국가 · 사진)은 뺀다 — 겹친 넓이가 자동 건물 넓이의 OVERLAP_FRAC 이상이거나 IoU ≥ OVERLAP_IOU.
+  옥상 · 외벽 · 난간 · 옥탑 · 구운 그림자 · 평탄화는 다른 건물과 같은 길(정사영상 지붕 · 사진 텍스처 · 절차 외벽)을 탄다.
+"""
+from __future__ import annotations
+
+import datetime as dt
+import json
+import math
+import re
+import threading
+from pathlib import Path
+
+from shapely.geometry import Polygon
+
+from . import heights
+from .buildings import BuildingSpec, classify_use
+from .geo import scene_contains
+
+MIN_POINTS, MAX_POINTS = 3, 200
+MIN_AREA_M2 = 4.0            # 이보다 작은 윤곽은 건물로 보지 않는다(잘못 누름)
+MAX_SIDE_M = 2000.0          # 윤곽 한 변(감싸는 상자)의 상한 — 영역 상한과 같다
+OVERLAP_FRAC = 0.5           # 자동 건물 넓이 중 직접 그린 건물에 덮인 몫이 이 이상이면 뺀다
+OVERLAP_IOU = 0.3            # 또는 두 윤곽 IoU 가 이 이상이면 뺀다
+MAX_NAME = 60
+UID_RE = re.compile(r"^[0-9a-f]{12}$")
+SOURCE = "drawn"             # BuildingSpec.source — scene.json origin 은 "user"(pipeline.ORIGIN)
+ROOFS = ("flat", "gable", "cone", "dome")   # 원뿔 · 돔은 둥근 윤곽(탱크 규칙 buildings.is_round)에서만 — 아니면 평지붕으로 굽는다
+USES = {"auto": None, "commercial": "commercial", "industrial": "industrial", "residential": "residential"}   # 외벽 성격(None = 자동)
+
+_lock = threading.Lock()
+
+
+class UserBuildingError(Exception):
+    def __init__(self, status: int, detail: str):
+        super().__init__(detail)
+        self.status, self.detail = status, detail
+
+
+# ---------------------------------------------------------------- 검증
+
+def clean_outline(outline) -> list[list[float]]:
+    """윤곽 검사 → 닫지 않은 꼭짓점 목록(소수 7자리). 형식 · 개수 · 자기 교차 · 넓이가 틀리면 UserBuildingError(400)."""
+    if not isinstance(outline, list):
+        raise UserBuildingError(400, "outline 은 [[lon, lat], …] 목록이어야 합니다")
+    pts = []
+    for p in outline:
+        if (not isinstance(p, (list, tuple)) or len(p) != 2
+                or not all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in p)):
+            raise UserBuildingError(400, "outline 의 꼭짓점은 [lon, lat] 두 숫자여야 합니다")
+        lon, lat = float(p[0]), float(p[1])
+        if not (math.isfinite(lon) and math.isfinite(lat) and -180 <= lon <= 180 and -85 <= lat <= 85):
+            raise UserBuildingError(400, "outline 꼭짓점이 경위도 범위 밖입니다")
+        pts.append([round(lon, 7), round(lat, 7)])
+    if len(pts) >= 2 and pts[0] == pts[-1]:
+        pts = pts[:-1]                              # 닫힌 고리로 보내도 받는다
+    if not (MIN_POINTS <= len(pts) <= MAX_POINTS):
+        raise UserBuildingError(400, f"윤곽 꼭짓점은 {MIN_POINTS}~{MAX_POINTS}개여야 합니다")
+    poly = to_meters(pts)
+    if not poly.is_valid:
+        raise UserBuildingError(400, "윤곽 선이 서로 엇갈립니다(자기 교차)")
+    if poly.area < MIN_AREA_M2:
+        raise UserBuildingError(400, f"윤곽이 너무 작습니다({MIN_AREA_M2:.0f} m² 미만)")
+    minx, miny, maxx, maxy = poly.bounds
+    if max(maxx - minx, maxy - miny) > MAX_SIDE_M:
+        raise UserBuildingError(400, f"윤곽이 너무 큽니다(한 변 {MAX_SIDE_M:.0f} m 초과)")
+    return pts
+
+
+def to_meters(pts) -> Polygon:
+    """윤곽(경위도) → 첫 꼭짓점 기준 미터 다각형(heights 와 같은 근사)."""
+    to_m = heights._meters(pts[0][0], pts[0][1])
+    return Polygon([to_m(x, y) for x, y in pts])
+
+
+def center(pts) -> list[float]:
+    c = Polygon(pts).centroid
+    return [round(c.x, 7), round(c.y, 7)]
+
+
+# ---------------------------------------------------------------- 저장
+
+def user_dir(data_dir) -> Path:
+    return Path(data_dir) / "user-buildings"
+
+
+def area_file(data_dir, bbox) -> Path:
+    """영역 파일 — heights.area_file 과 같은 이름(bbox 해시)을 user-buildings 폴더에."""
+    return user_dir(data_dir) / heights.area_file(data_dir, bbox).name
+
+
+def _files(data_dir):
+    d = user_dir(data_dir)
+    return sorted(d.glob("area-*.json")) if d.exists() else []
+
+
+def items_in(data_dir, scene: dict) -> list[dict]:
+    """장면(bbox · 회전 영역 rect)에 중심이 든 직접 그린 건물(어느 영역 파일이든 — 다시 굽기 영역이 조금 달라도)."""
+    out = []
+    for p in _files(data_dir):
+        for it in heights._read(p)["items"]:
+            try:
+                c = center(it["outline"])
+            except (KeyError, TypeError, ValueError):
+                continue
+            if scene_contains(scene, c[0], c[1]):
+                out.append(it)
+    return out
+
+
+def put(data_dir, scene: dict, uid: str, outline, height: float, floors: int | None, name: str | None,
+        roof: str = "flat", use: str = "auto") -> dict:
+    """새로 넣거나(uid 처음) 고친다(같은 uid — 만든 시각은 그대로). 중심이 장면 밖이면 400. 반환 = 저장한 항목."""
+    if not UID_RE.match(uid or ""):
+        raise UserBuildingError(400, "uid 는 소문자 16진수 12자여야 합니다")
+    if roof not in ROOFS or use not in USES:
+        raise UserBuildingError(400, f"roof 는 {ROOFS}, use 는 {tuple(USES)} 중 하나여야 합니다")
+    pts = clean_outline(outline)
+    c = center(pts)
+    if not scene_contains(scene, c[0], c[1]):
+        raise UserBuildingError(400, "윤곽이 이 3D 영역 밖에 있습니다")
+    now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
+    item = {"uid": uid, "outline": pts, "height": round(float(height), 1), "floors": floors,
+            "name": (name or "").strip()[:MAX_NAME] or None, "roof": roof, "use": use, "created": now, "updated": now}
+    with _lock:
+        for p in _files(data_dir):
+            d = heights._read(p)
+            old = next((it for it in d["items"] if it.get("uid") == uid), None)
+            if old is not None:
+                item["created"] = old.get("created") or now
+                d["items"] = [item if it.get("uid") == uid else it for it in d["items"]]
+                heights._write(p, d)
+                return item
+        p = area_file(data_dir, scene["bbox"])
+        d = heights._read(p)
+        d["bbox"] = [float(v) for v in scene["bbox"]]
+        d["items"].append(item)
+        heights._write(p, d)
+    return item
+
+
+def set_height(data_dir, uid: str, height: float, floors: int | None) -> dict | None:
+    """그 건물 높이 · 층수만 고친다(3D 「건물 높이」 판) — 없으면 None."""
+    with _lock:
+        for p in _files(data_dir):
+            d = heights._read(p)
+            for it in d["items"]:
+                if it.get("uid") == uid:
+                    it.update(height=round(float(height), 1), floors=floors,
+                              updated=dt.datetime.now().astimezone().isoformat(timespec="seconds"))
+                    heights._write(p, d)
+                    return it
+    return None
+
+
+def _drop(data_dir, pred) -> int:
+    n = 0
+    with _lock:
+        for p in _files(data_dir):
+            d = heights._read(p)
+            keep = [it for it in d["items"] if not pred(it)]
+            if len(keep) != len(d["items"]):
+                n += len(d["items"]) - len(keep)
+                d["items"] = keep
+                heights._write(p, d)
+    return n
+
+
+def delete(data_dir, uid: str) -> bool:
+    return _drop(data_dir, lambda it: it.get("uid") == uid) > 0
+
+
+def delete_in(data_dir, scene: dict) -> int:
+    """「모두 지우기」 — 장면 범위에 중심이 든 직접 그린 건물을 모두 지운다."""
+    def inside(it):
+        try:
+            c = center(it["outline"])
+        except (KeyError, TypeError, ValueError):
+            return False
+        return scene_contains(scene, c[0], c[1])
+    return _drop(data_dir, inside)
+
+
+# ---------------------------------------------------------------- 굽기(pipeline) 에서
+
+def specs_of(items: list[dict], level_h: float) -> list[BuildingSpec]:
+    """직접 그린 건물 → 건물 사양(지붕 모양 · 외벽 성격은 그린 사람이 고른 것, 높이 출처 user · 이름이 있으면 name 태그).
+    원형 윤곽 + 돔/원뿔 = 탱크 규칙(buildings.is_round → 원기둥 벽 · 둥근 지붕 · 테두리). id 는 굽기가 다시 매긴다."""
+    out = []
+    for it in items:
+        tags = {"building": "yes", **({"name": it["name"]} if it.get("name") else {})}
+        roof = it.get("roof") if it.get("roof") in ROOFS else "flat"
+        out.append(BuildingSpec(id=0, source=SOURCE, source_id=f"{SOURCE}/{it['uid']}", footprint_ll=Polygon(it["outline"]),
+                                tags=tags, height=float(it["height"]), height_source="user",
+                                levels=int(it["floors"]) if it.get("floors") else max(1, round(float(it["height"]) / level_h)),
+                                roof_shape=roof, roof_source="user" if roof != "flat" else "default",
+                                use=USES.get(it.get("use")) or classify_use(tags)))
+    return out
+
+
+def overlaps(auto: Polygon, user: Polygon) -> bool:
+    """자동 건물을 뺄 만큼 겹치나 — 겹친 넓이 ÷ 자동 건물 넓이 ≥ OVERLAP_FRAC 또는 IoU ≥ OVERLAP_IOU.
+    넓이 비율은 경위도 그대로 셈한다(작은 영역에서 경위도 → 미터는 아핀 변환이라 비율이 같다)."""
+    if not auto.intersects(user) or auto.area <= 0:
+        return False
+    inter = auto.intersection(user).area
+    union = auto.union(user).area
+    return inter / auto.area >= OVERLAP_FRAC or (union > 0 and inter / union >= OVERLAP_IOU)
+
+
+def merge(specs: list[BuildingSpec], items: list[dict], level_h: float) -> tuple[list[BuildingSpec], dict]:
+    """직접 그린 건물을 넣고 겹치는 자동 건물을 뺀다 — 반환 (새 사양 목록, 집계 {applied, removed_auto, removed[출처별]})."""
+    users = specs_of(items, level_h)
+    kept, removed = [], {}
+    for s in specs:
+        if any(overlaps(s.footprint_ll, u.footprint_ll) for u in users):
+            removed[s.source] = removed.get(s.source, 0) + 1
+            continue
+        kept.append(s)
+    return kept + users, {"applied": len(users), "removed_auto": sum(removed.values()), "removed": removed}
