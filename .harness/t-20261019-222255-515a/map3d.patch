+def should_project_ortho_onto_outline_for_roof_texture_coordinates(tmp_path, mbtiles, slope_dem):
+    s1 = _bake(tmp_path, mbtiles, slope_dem)
+    _put(tmp_path, s1, UID, EMPTY, 12.0)
+    _bake(tmp_path, mbtiles, slope_dem, job="j2")
+    raw = (tmp_path / "data" / "jobs" / "j2" / "scene.glb").read_bytes()
+    jl = int.from_bytes(raw[12:16], "little")
+    g = json.loads(raw[20:20 + jl])
+    scene = json.loads((tmp_path / "data" / "jobs" / "j2" / "scene.json").read_text(encoding="utf-8"))
+    u = next(b for b in scene["buildings"] if b.get("user_uid") == UID)
+    node = _building_nodes(g)[u["id"]]
+    names = [m["name"] for m in g["materials"]]
+    roof = next(p for p in g["meshes"][node["mesh"]]["primitives"] if names[p.get("material", -1)] == "roof_ortho")
+
+    def arr(acc_i, n):
+        acc = g["accessors"][acc_i]
+        bv = g["bufferViews"][acc["bufferView"]]
+        start = 20 + jl + 8 + bv.get("byteOffset", 0) + acc.get("byteOffset", 0)
+        return np.frombuffer(raw[start:start + acc["count"] * 4 * n], dtype=np.float32).reshape(-1, n)
+    uv = arr(roof["attributes"]["TEXCOORD_0"], 2)
+    pos = arr(roof["attributes"]["POSITION"], 3)
+    # 지붕 = 윤곽을 정사영상에 투영 — 지붕 정점이 윤곽 안, UV 는 정사영상 안에서 동쪽일수록 U 크고 북쪽일수록 V 작다(위쪽 행)
+    o = scene["origin"]
+    lon = o["lon"] + pos[:, 0] / (111320.0 * np.cos(np.radians(o["lat"])))
+    lat = o["lat"] - pos[:, 2] / 110540.0
+    from shapely.geometry import Point
+    poly = Polygon(EMPTY).buffer(1e-5)
+    assert all(poly.contains(Point(a, b)) for a, b in zip(lon, lat))
+    assert 0.0 <= uv.min() and uv.max() <= 1.0
+    west, east = pos[:, 0].argmin(), pos[:, 0].argmax()
+    south, north = pos[:, 2].argmax(), pos[:, 2].argmin()
+    assert uv[west, 0] < uv[east, 0] and uv[north, 1] < uv[south, 1]
+    # 지붕 UV 넓이 비 ≈ 윤곽 넓이 ÷ 정사영상 넓이(투영이 윤곽 모양 그대로)
+    w_m = (scene["bbox"][2] - scene["bbox"][0]) * 111320.0 * np.cos(np.radians(o["lat"]))
+    assert (uv[:, 0].max() - uv[:, 0].min()) * w_m == pytest.approx(pos[:, 0].max() - pos[:, 0].min(), rel=0.15)
+
