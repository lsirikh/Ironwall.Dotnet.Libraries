new file mode 100644
index 0000000..41cdd1d
--- /dev/null
+++ b/map3d/static/userbuilding.js
@@ -0,0 +1,59 @@
+// 직접 그린 건물 상자 미리보기 — 다시 만들기 전, 저장한 윤곽 · 높이를 평지붕 상자로 보인다(three 무의존 순수 함수, node 시험 tests/userbuilding_check.mjs).
+//   받는 것 {type:"userbuilding.preview", uid, outline:[[lon, lat] …], height|null} — 그 건물 상자 넣기 · 바꾸기(null = 지움)
+//          {type:"userbuilding.clear"}                                            — 상자 모두 지움(「모두 지우기」)
+//   장면을 불러올 때는 GET /api/jobs/{job}/user-buildings 의 아직 안 구운(baked_id null) 건물을 상자로 보인다.
+
+export const UID_RE = /^[0-9a-f]{12}$/;
+export const MIN_H = 1, MAX_H = 600, MIN_POINTS = 3, MAX_POINTS = 200;
+
+/** 윤곽 검사 — [[lon, lat] …] 3~200 개(끝점이 첫 점과 같으면 뺀다), 아니면 null. */
+export function cleanOutline(outline) {
+  if (!Array.isArray(outline)) return null;
+  const pts = [];
+  for (const p of outline) {
+    if (!Array.isArray(p) || p.length !== 2 || !p.every((v) => typeof v === "number" && Number.isFinite(v))) return null;
+    if (Math.abs(p[0]) > 180 || Math.abs(p[1]) > 90) return null;
+    pts.push([p[0], p[1]]);
+  }
+  if (pts.length >= 2 && pts[0][0] === pts[pts.length - 1][0] && pts[0][1] === pts[pts.length - 1][1]) pts.pop();
+  return pts.length >= MIN_POINTS && pts.length <= MAX_POINTS ? pts : null;
+}
+
+/** GIS → 3D 메시지 검사 — 형식이 틀리면 null(버린다). */
+export function parseHostUserBuilding(d) {
+  if (!d || typeof d.type !== "string") return null;
+  if (d.type === "userbuilding.clear") return { type: d.type };
+  if (d.type !== "userbuilding.preview" || typeof d.uid !== "string" || !UID_RE.test(d.uid)) return null;
+  if (d.height === null) return { type: d.type, uid: d.uid, height: null };
+  const outline = cleanOutline(d.outline);
+  if (!outline || !Number.isFinite(d.height) || d.height < MIN_H || d.height > MAX_H) return null;
+  return { type: d.type, uid: d.uid, outline, height: d.height };
+}
+
+/** 서버 목록(GET …/user-buildings) → 상자로 보일 것(아직 안 구운 건물만). */
+export function pendingBoxes(list) {
+  const out = [];
+  for (const it of (list && Array.isArray(list.items) ? list.items : [])) {
+    if (it && it.baked_id == null) {
+      const m = parseHostUserBuilding({ type: "userbuilding.preview", uid: it.uid, outline: it.outline, height: it.height });
+      if (m) out.push(m);
+    }
+  }
+  return out;
+}
+
+/**
+ * 상자 모양 — 윤곽 경위도 → 장면 평면 [east, north](m, toEnu = camsync.enuOf 처럼 {x, z: −north} 를 돌려주는 함수),
+ * 반시계 방향으로 맞춘 고리. 바닥 높이는 꼭짓점 지면 높이(groundAt(x, z))의 가장 낮은 값(경사지에서 건물 밑이 뜨지 않게).
+ */
+export function boxShape(outline, toEnu, groundAt) {
+  const ring = outline.map(([lon, lat]) => { const p = toEnu(lon, lat); return [p.x, -p.z]; });
+  let area = 0;
+  for (let i = 0; i < ring.length; i++) {
+    const [x0, y0] = ring[i], [x1, y1] = ring[(i + 1) % ring.length];
+    area += x0 * y1 - x1 * y0;
+  }
+  if (area < 0) ring.reverse();
+  const base = Math.min(...ring.map(([e, n]) => groundAt(e, -n)));
+  return { ring, base, area: Math.abs(area) / 2 };
+}
