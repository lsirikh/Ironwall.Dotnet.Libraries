diff --git a/tests/overlay_screen_check.mjs b/tests/overlay_screen_check.mjs
new file mode 100644
index 0000000..ec9f469
--- /dev/null
+++ b/tests/overlay_screen_check.mjs
@@ -0,0 +1,46 @@
+// overlay-screen.js 시험 — 지켜볼 항목 해석 · 투영 → 화면 좌표 · 바뀐 것만 보내기(pytest 가 node 로 부른다).
+import { parseWatch, screenOf, ScreenReporter } from "../map3d/static/overlay-screen.js";
+
+const fails = [];
+const ok = (c, what) => { if (!c) fails.push(what); };
+
+const w = parseWatch({ type: "overlay.watch", items: [
+  { key: "cam:5", kind: "pids", id: 12, lon: 127.1, lat: 37.3, altM: 4 },
+  { key: "geo:1", lon: 127.2, lat: 37.4 },
+  { key: "trk", kind: "track", id: "3:7" },
+  { key: "", kind: "pids", id: 1 },
+  { key: "bad", kind: "pids" },
+  null,
+] });
+ok(w.length === 3, "valid watch items only");
+ok(w[0].kind === "pids" && w[0].id === 12 && w[0].altM === 4, "kind id alt kept");
+ok(w[1].kind === undefined && w[1].altM === 0, "geo only, alt 0");
+ok(w[2].id === "3:7" && w[2].lon === undefined, "track id string");
+ok(parseWatch(null).length === 0 && parseWatch({}).length === 0, "no items -> empty");
+
+let s = screenOf(0, 0, -10, 0, 0, 800, 600);
+ok(s.x === 400 && s.y === 300 && s.visible, "center");
+s = screenOf(-1, 1, -10, 10, 20, 800, 600);
+ok(s.x === 10 && s.y === 20 && s.visible, "top-left with host origin");
+s = screenOf(1.5, 0, -10, 0, 0, 800, 600);
+ok(s.x === 1000 && s.y === 300 && !s.visible, "in front but off screen keeps coords");
+s = screenOf(0, 0, 5, 0, 0, 800, 600);
+ok(s.x === null && s.y === null && !s.visible, "behind camera -> null");
+ok(screenOf(NaN, 0, -1, 0, 0, 800, 600).x === null, "NaN -> null");
+
+const r = new ScreenReporter();
+let c = r.changes([{ key: "a", x: 10, y: 10, visible: true }, { key: "b", x: null, y: null, visible: false }]);
+ok(c.length === 2, "first report sends all");
+c = r.changes([{ key: "a", x: 10.3, y: 10, visible: true }, { key: "b", x: null, y: null, visible: false }]);
+ok(c.length === 0, "sub-pixel change not sent");
+c = r.changes([{ key: "a", x: 12, y: 10, visible: true }, { key: "b", x: 5, y: 5, visible: true }]);
+ok(c.length === 2 && c[0].x === 12 && c[1].x === 5, "moved and became visible");
+c = r.changes([{ key: "b", x: 5, y: 5, visible: true }]);
+ok(c.length === 0 && !r.last.has("a"), "dropped key forgotten");
+c = r.changes([{ key: "a", x: 12, y: 10, visible: true }]);
+ok(c.length === 1, "re-added key sent again");
+r.reset();
+ok(r.changes([{ key: "a", x: 12, y: 10, visible: true }]).length === 1, "reset sends again");
+
+if (fails.length) { console.log(fails.join("\n")); process.exit(1); }
+console.log("overlay screen ok");
