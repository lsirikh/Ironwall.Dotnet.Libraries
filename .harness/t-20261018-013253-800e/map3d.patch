+// GIS 창 자리(overlay.watch → overlay.screen) — 그린 프레임 뒤에만, 바뀐 항목만(overlay-screen.js)
+let watch = [];
+const screens = new ScreenReporter();
+const projV = new THREE.Vector3(), camV = new THREE.Vector3();
+function watchPoint(w) {
+  if (w.kind !== undefined && overlay) { const p = overlay.anchorOf(w.kind, w.id); if (p) return p; }
+  if (w.lon === undefined || !sceneInfo) return null;
