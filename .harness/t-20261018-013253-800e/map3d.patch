+// GIS 창 자리 알림 — GIS 가 지켜볼 항목(overlay.watch: 마커 kind · id 또는 위경도)을 주면, 화면을 그린 뒤에 그 항목의
+//   화면 좌표(CSS px = WebView2 DIP, pick 의 screen 과 같은 기준)를 계산해 바뀐 것만 overlay.screen 으로 보낸다.
+//   카메라 팝업 등 GIS 창이 3D 에서 마커가 보이는 자리를 따라가게 한다. 마우스를 움직일 때마다가 아니라 그린 프레임 뒤에만,
+//   0.5 px 넘게 바뀐 항목만 보낸다(three 무의존 — 시험: tests/overlay_screen_check.mjs).
+
+export const SCREEN_EPS_PX = 0.5;
+
+// {type:"overlay.watch", items:[{key, kind?, id?, lon?, lat?, altM?}]} → 쓸 수 있는 항목만(key 필수 · kind+id 또는 lon+lat 중 하나 이상).
+export function parseWatch(msg) {
+  const out = [];
+  if (!msg || !Array.isArray(msg.items)) return out;
+  for (const it of msg.items) {
+    if (!it || typeof it.key !== "string" || !it.key) continue;
+    const w = { key: it.key };
+    if (typeof it.kind === "string" && it.kind && (Number.isInteger(it.id) || (typeof it.id === "string" && it.id))) { w.kind = it.kind; w.id = it.id; }
+    if (Number.isFinite(it.lon) && Number.isFinite(it.lat)) { w.lon = it.lon; w.lat = it.lat; w.altM = Number.isFinite(it.altM) ? it.altM : 0; }
+    if (w.kind || w.lon !== undefined) out.push(w);
+  }
+  return out;
+}
+
+// 투영 결과 → 화면 좌표. ndcX · ndcY = Vector3.project(-1~1 이 화면 안), camZ = 카메라 좌표계 z(앞이 음수).
+//   카메라 뒤(camZ ≥ 0)면 좌표가 뜻이 없어 x · y = null. 앞이면 화면 밖이어도 좌표를 준다(visible = 화면 안인가).
+export function screenOf(ndcX, ndcY, camZ, left, top, width, height) {
+  if (!(camZ < 0) || !Number.isFinite(ndcX) || !Number.isFinite(ndcY)) return { x: null, y: null, visible: false };
+  const x = left + (ndcX + 1) / 2 * width, y = top + (1 - ndcY) / 2 * height;
+  return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10, visible: ndcX >= -1 && ndcX <= 1 && ndcY >= -1 && ndcY <= 1 };
+}
+
+// 직전에 보낸 값과 비교해 바뀐 항목만 돌려준다. 목록에서 빠진 key 는 잊는다. reset() 뒤엔 전부 다시 보낸다.
+export class ScreenReporter {
+  constructor(eps = SCREEN_EPS_PX) { this.eps = eps; this.last = new Map(); }
+  reset() { this.last.clear(); }
+  changes(current) {
+    const out = [], keys = new Set();
+    for (const c of current) {
+      keys.add(c.key);
+      const p = this.last.get(c.key);
+      if (p && p.visible === c.visible && near(p.x, c.x, this.eps) && near(p.y, c.y, this.eps)) continue;
+      this.last.set(c.key, c);
+      out.push(c);
+    }
+    for (const k of [...this.last.keys()]) if (!keys.has(k)) this.last.delete(k);
+    return out;
+  }
+}
+
+function near(a, b, eps) { return a === null || b === null ? a === b : Math.abs(a - b) < eps; }
