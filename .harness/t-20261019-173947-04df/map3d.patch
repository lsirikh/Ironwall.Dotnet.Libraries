@@ -0,0 +1,269 @@
+"""회전 영역 — 지도가 돌아간 상태에서 그린 사각형 그대로 굽기(rect: 중심 · 가로 · 세로 · 회전각).
+
+자료는 감싸는 bbox 로 받고 장면은 회전 사각형으로 자른다. 장면 로컬 축 = 사각형 축(LocalFrame.rotation_deg),
+뷰어가 모델을 −회전각 돌려 세계 = ENU(camsync.sceneYaw). 회전 0 이면 bbox 경로 그대로(예전과 같은 결과)."""
+import json
+import math
+import shutil
+import subprocess
+from pathlib import Path
+
+import httpx
+import numpy as np
+import pytest
+import trimesh
+from fastapi.testclient import TestClient
+from PIL import Image
+from shapely.geometry import Polygon
+
+from map3d import heights
+from map3d.config import Settings
+from map3d.geo import LocalFrame, RotRect, parse_rect, scene_contains
+from map3d.params import SceneParams
+from map3d.pipeline import GenerateError, GenerateRequest, generate
+from map3d.server import create_app
+
+# conftest.BBOX(127.1000~127.1040, 37.3600~37.3632) 가운데 200 m × 120 m, 지도 방위 45°
+RECT = {"lon": 127.1020, "lat": 37.3616, "width_m": 200.0, "height_m": 120.0, "rotation_deg": 45.0}
+
+
+def _rr(**kw):
+    return parse_rect({**RECT, **kw})
+
+
+# ---------------------------------------------------------------- 기하
+@pytest.mark.parametrize("rot", [30.0, 45.0, 90.0, -60.0, 300.0])
+def should_round_trip_local_and_lonlat_when_rotated(rot):
+    rr = _rr(rotation_deg=rot)
+    x, y = np.array([0.0, 100.0, -100.0, 37.5]), np.array([0.0, 60.0, -60.0, -12.0])
+    lon, lat = rr.to_lonlat(x, y)
+    bx, by = rr.to_local(lon, lat)
+    assert np.allclose(bx, x, atol=1e-6) and np.allclose(by, y, atol=1e-6)
+    # 사각형 위쪽(로컬 +y)은 지도 방위 rot 를 가리킨다(북 0 · 시계)
+    lon1, lat1 = rr.to_lonlat(0.0, 50.0)
+    e, n, _ = LocalFrame(rr.lon, rr.lat).lonlat_to_enu(lon1, lat1)
+    assert math.degrees(math.atan2(e, n)) % 360 == pytest.approx(rot % 360, abs=1e-3)
+    assert math.hypot(e, n) == pytest.approx(50.0, abs=1e-3)      # 타원체 ENU 와 같은 길이
+
+
+def should_describe_corners_bbox_and_containment_when_rotated():
+    rr = _rr()
+    c = np.asarray(rr.corners())
+    sides = [math.dist(*map(lambda p: rr.to_local(*p), (c[i], c[(i + 1) % 4]))) for i in range(4)]
+    assert sides == pytest.approx([200, 120, 200, 120], abs=1e-6)
+    b = rr.bbox()
+    assert b[0] < c[:, 0].min() and b[2] > c[:, 0].max() and b[1] < c[:, 1].min() and b[3] > c[:, 1].max()
+    assert rr.bbox() == _rr().bbox()            # 같은 사각형 = 같은 bbox(높이 덮어쓰기 영역 키가 안정적)
+    assert rr.contains(rr.lon, rr.lat)
+    # 모서리 근처: 안쪽 1 m 는 안, 바깥 1 m 는 밖
+    for sx, sy in ((1, 1), (1, -1), (-1, 1), (-1, -1)):
+        assert rr.contains(*rr.to_lonlat(sx * 99.0, sy * 59.0))
+        assert not rr.contains(*rr.to_lonlat(sx * 101.0, sy * 59.0))
+        assert not rr.contains(*rr.to_lonlat(sx * 99.0, sy * 61.0))
+    # 감싸는 bbox 모서리는 회전 사각형 밖
+    assert not rr.contains(b[2] - 1e-5, b[3] - 1e-5)
+
+
+def should_fall_back_to_bbox_when_rotation_is_zero_or_rect_bad():
+    assert parse_rect(None) is None
+    assert parse_rect({**RECT, "rotation_deg": 0}) is None
+    assert parse_rect({**RECT, "rotation_deg": 360}) is None
+    assert parse_rect({**RECT, "rotation_deg": -720}) is None
+    assert parse_rect({**RECT, "rotation_deg": -60}).rotation_deg == pytest.approx(300)
+    for bad in ({**RECT, "width_m": 0}, {**RECT, "lat": 91}, {k: v for k, v in RECT.items() if k != "lon"},
+                {**RECT, "height_m": float("nan")}, [1, 2, 3], {**RECT, "rotation_deg": "x"}):
+        with pytest.raises(ValueError):
+            parse_rect(bad)
+
+
+def should_put_rect_up_on_local_y_when_frame_rotated():
+    f0 = LocalFrame(127.1020, 37.3616, 50.0)
+    f = LocalFrame(127.1020, 37.3616, 50.0, 45.0)
+    rr = _rr()
+    lon, lat = rr.to_lonlat([0.0, 80.0, 0.0], [50.0, 0.0, 0.0])
+    x, y, u = f.lonlat_to_enu(lon, lat, 50.0)
+    assert x == pytest.approx([0, 80, 0], abs=0.005) and y == pytest.approx([50, 0, 0], abs=0.005)
+    e, n, _ = f0.lonlat_to_enu(lon, lat, 50.0)
+    assert np.hypot(x, y) == pytest.approx(np.hypot(e, n), abs=1e-6)   # 회전만(길이 그대로)
+    back = f.enu_to_lonlat(x, y, u)
+    assert np.allclose(back[0], lon, atol=1e-10) and np.allclose(back[1], lat, atol=1e-10)
+    m = np.asarray(f.rot)
+    assert np.allclose(m @ m.T, np.eye(3), atol=1e-12)                  # 3D Tiles 변환도 직교
+
+
+# ---------------------------------------------------------------- 굽기
+def _square(rr, x, y, half=5.0):
+    lon, lat = rr.to_lonlat([x - half, x + half, x + half, x - half, x - half], [y - half, y - half, y + half, y + half, y - half])
+    return [[float(a), float(b)] for a, b in zip(lon, lat)]
+
+
+def _user_geojson(tmp_path, rr):
+    """A 가운데(안) · B 감싸는 bbox 모서리(사각형 밖) · C 오른쪽 변에 걸침(중심 안) · D 오른쪽 변 바로 밖(중심 밖) · 철책(사각형을 가로지름)."""
+    feats = []
+    for name, (x, y) in {"A": (0, 0), "B": (0, 95), "C": (95, 0), "D": (106, 0)}.items():
+        feats.append({"type": "Feature", "properties": {"height": 10, "name": name},
+                      "geometry": {"type": "Polygon", "coordinates": [_square(rr, x, y, 4.0 if name != "C" else 8.0)]}})
+    fl, fa = rr.to_lonlat([-150.0, 150.0], [10.0, 10.0])
+    feats.append({"type": "Feature", "properties": {"barrier": "fence"},
+                  "geometry": {"type": "LineString", "coordinates": [[float(a), float(b)] for a, b in zip(fl, fa)]}})
+    p = tmp_path / "rot.geojson"
+    p.write_text(json.dumps({"type": "FeatureCollection", "features": feats}), encoding="utf-8")
+    # B 는 감싸는 bbox 안(사각형 밖 모서리 자리)에 있어야 뜻이 있다 — 90° 배수면 bbox = 사각형이라 그런 자리가 없다
+    b = rr.bbox()
+    if rr.rotation_deg % 90:
+        for lo, la in _square(rr, 0, 95, 4.0):
+            assert b[0] <= lo <= b[2] and b[1] <= la <= b[3]
+    return p
+
+
+def _offline():
+    return (httpx.Client(transport=httpx.MockTransport(lambda r: httpx.Response(504))),
+            httpx.Client(transport=httpx.MockTransport(lambda r: httpx.Response(404))))
+
+
+def _gen(tmp_path, mbtiles, slope_dem, sub, rect=None, bbox=None, gj=None, overlay_mode="tiles", overlays=()):
+    s = Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"), overpass_endpoints=["https://a.example/api"])
+    rr = parse_rect(rect)
+    req = GenerateRequest(bbox=bbox or rr.bbox(), params=SceneParams(zoom=16), dem_path=str(slope_dem),
+                          buildings_geojson=str(gj) if gj else None, rect=rect, overlay_mode=overlay_mode, overlays=list(overlays))
+    oc, dc = _offline()
+    with oc, dc:
+        return generate(req, s, tmp_path / sub, osm_client=oc, dem_client=dc)
+
+
+def should_cut_scene_to_rotated_rect_when_baking(tmp_path, mbtiles, slope_dem):
+    rr = _rr()
+    gj = _user_geojson(tmp_path, rr)
+    sc = _gen(tmp_path, mbtiles, slope_dem, "r", rect=RECT, gj=gj)
+    # scene.json 회전 정보
+    assert sc["rotation_deg"] == 45.0 and sc["rect"]["rotation_deg"] == 45.0
+    assert sc["rect"]["width_m"] == 200.0 and sc["rect"]["height_m"] == 120.0 and len(sc["rect"]["corners"]) == 4
+    assert sc["size_m"] == [200.0, 120.0] and sc["bbox"] == list(rr.bbox())
+    assert sc["origin"]["lon"] == RECT["lon"] and sc["origin"]["lat"] == RECT["lat"]
+    assert sc["enu_rect"] == [-100.0, 100.0, -60.0, 60.0]
+    # 건물: 중심이 사각형 안인 A · C 만, C 는 사각형 테두리로 잘림 — 밖 건물 없음
+    names = sorted(b.get("tags", {}).get("name") or b.get("name") or "" for b in sc["buildings"])
+    assert len(sc["buildings"]) == 2, names
+    poly = Polygon(sc["rect"]["corners"]).buffer(2e-7)
+    for b in sc["buildings"]:
+        assert poly.contains(Polygon(b["footprint"])), b["footprint"]
+    areas = sorted(b["area_m2"] for b in sc["buildings"])
+    assert areas[0] == pytest.approx(64, rel=0.05)            # A 8 m × 8 m
+    assert areas[1] == pytest.approx(16 * 13, rel=0.08)       # C 16 m × 16 m 중 사각형 안 13 m
+    # 철책: 300 m 선이 200 m 사각형으로 잘림
+    assert sc["counts"]["fence_length_m"] == pytest.approx(200, abs=3)
+    # GLB: 모든 정점(지형 윗면 · 옆면 · 건물 · 철책)이 장면 로컬 사각형(±100, ±60) 안 — glTF x = 사각형 오른쪽, z = −사각형 위쪽
+    #   (잘린 철책 끝 기둥의 반 두께 0.05 m 까지)
+    g = trimesh.load(tmp_path / "r" / "scene.glb", force="scene")
+    v = np.vstack([geom.vertices for geom in g.dump()])
+    assert v[:, 0].min() >= -100.06 and v[:, 0].max() <= 100.06 and v[:, 2].min() >= -60.06 and v[:, 2].max() <= 60.06
+    assert v[:, 0].max() > 99.9 and v[:, 2].max() > 59.9   # 지형은 사각형 끝까지
+    # 3D Tiles 변환 = 회전 축 → ECEF(동쪽 단위벡터가 아니라 사각형 오른쪽)
+    ts = json.loads((tmp_path / "r" / "tileset.json").read_text(encoding="utf-8"))
+    assert ts["root"]["boundingVolume"]["box"][3] == pytest.approx(100) and ts["root"]["boundingVolume"]["box"][7] == pytest.approx(60)
+    req = json.loads((tmp_path / "r" / "request.json").read_text(encoding="utf-8"))
+    assert req["rect"] == RECT and GenerateRequest.from_json(req).rect == RECT
+    assert (tmp_path / "r" / "thumbnail.png").exists()
