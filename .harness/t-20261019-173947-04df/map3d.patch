+@dataclass(frozen=True)
+class RotRect:
+    """회전 영역 — 중심(lon, lat) · 가로 · 세로(m) · 회전각(도). 회전각 = 그릴 때 지도 방위(사각형 위쪽 변이 가리키는 방위, 북 0 · 시계).
+    위경도 ↔ 사각형 로컬(x 오른쪽 · y 위쪽, m)은 중심 위도의 등장방형 근사 — 1° 길이는 WGS84 타원체의 묘유선 · 자오선 곡률 반지름으로
+    (GIS Map3DMath.Map3DRotRect 와 같은 식). 구(球)로 셈하면 LocalFrame(타원체 ENU)과 0.1~0.3 % 어긋나 2 km 영역 모서리가 수 m 틀어진다."""
+
+    lon: float
+    lat: float
+    width_m: float
+    height_m: float
+    rotation_deg: float
+
+    def _k(self):
+        e2, s2 = 6.69437999014e-3, math.sin(math.radians(self.lat)) ** 2
+        n_r = WGS84_A / math.sqrt(1 - e2 * s2)                 # 묘유선 곡률 반지름(동서)
+        m_r = WGS84_A * (1 - e2) / (1 - e2 * s2) ** 1.5        # 자오선 곡률 반지름(남북)
+        return math.radians(1.0) * n_r * math.cos(math.radians(self.lat)), math.radians(1.0) * m_r
+
+    def to_lonlat(self, x, y):
+        b = math.radians(self.rotation_deg)
+        x, y = np.asarray(x, dtype=np.float64), np.asarray(y, dtype=np.float64)
+        e, n = x * math.cos(b) + y * math.sin(b), -x * math.sin(b) + y * math.cos(b)
+        kx, ky = self._k()
+        return self.lon + e / kx, self.lat + n / ky
+
+    def to_local(self, lon, lat):
+        b = math.radians(self.rotation_deg)
+        kx, ky = self._k()
+        e, n = (np.asarray(lon, dtype=np.float64) - self.lon) * kx, (np.asarray(lat, dtype=np.float64) - self.lat) * ky
+        return e * math.cos(b) - n * math.sin(b), e * math.sin(b) + n * math.cos(b)
+
+    def corners(self) -> list[list[float]]:
+        """네 모서리 [lon, lat] — 왼쪽 아래 · 오른쪽 아래 · 오른쪽 위 · 왼쪽 위(사각형 로컬 기준)."""
+        hw, hh = self.width_m / 2, self.height_m / 2
+        lon, lat = self.to_lonlat([-hw, hw, hw, -hw], [-hh, -hh, hh, hh])
+        return [[float(a), float(b)] for a, b in zip(lon, lat)]
+
+    def bbox(self, pad_deg: float = 1e-5) -> tuple[float, float, float, float]:
+        """감싸는 북쪽 정렬 bbox(자료 받기 · 장면 찾기 · 높이 덮어쓰기 영역 키) — 소수 7자리로 고정해 같은 사각형이면 늘 같은 값."""
+        c = np.asarray(self.corners())
+        return (round(float(c[:, 0].min()) - pad_deg, 7), round(float(c[:, 1].min()) - pad_deg, 7),
+                round(float(c[:, 0].max()) + pad_deg, 7), round(float(c[:, 1].max()) + pad_deg, 7))
+
+    def contains(self, lon, lat) -> bool:
+        x, y = self.to_local(lon, lat)
+        return bool(abs(x) <= self.width_m / 2 + 1e-6 and abs(y) <= self.height_m / 2 + 1e-6)
+
+    def to_json(self) -> dict:
+        return {"lon": self.lon, "lat": self.lat, "width_m": self.width_m, "height_m": self.height_m,
+                "rotation_deg": self.rotation_deg}
+
+
+def parse_rect(d) -> RotRect | None:
+    """요청 rect {lon, lat, width_m, height_m, rotation_deg} → RotRect. 회전각이 0(360 의 배수)이면 None(북쪽 정렬 bbox 경로 그대로)."""
+    if d is None:
+        return None
+    if not isinstance(d, dict):
+        raise ValueError("rect 는 {lon, lat, width_m, height_m, rotation_deg} 여야 합니다")
+    try:
+        lon, lat, w, h, r = (float(d[k]) for k in ("lon", "lat", "width_m", "height_m", "rotation_deg"))
+    except (KeyError, TypeError, ValueError):
+        raise ValueError("rect 는 lon · lat · width_m · height_m · rotation_deg 다섯 숫자가 필요합니다") from None
+    if not all(math.isfinite(v) for v in (lon, lat, w, h, r)):
+        raise ValueError("rect 값이 수가 아닙니다")
+    if not (-180 <= lon <= 180 and -85 <= lat <= 85 and w > 0 and h > 0):
+        raise ValueError(f"rect 범위가 잘못되었습니다: {d}")
+    r = r % 360.0
+    if r < 1e-9 or 360.0 - r < 1e-9:
+        return None
+    return RotRect(lon, lat, w, h, r)
+
+
+def scene_rect(scene: dict) -> RotRect | None:
+    """scene.json 의 rect(회전 영역) — 없거나 잘못됐으면 None."""
+    try:
+        return parse_rect(scene.get("rect"))
+    except ValueError:
+        return None
+
+
+def scene_contains(scene: dict, lon: float, lat: float) -> bool:
+    """장면이 그 지점을 덮는가 — 회전 영역이면 회전 사각형 안, 아니면 bbox 안(경계 포함)."""
+    rr = scene_rect(scene)
+    if rr is not None:
+        return rr.contains(lon, lat)
+    b = scene.get("bbox")
+    return bool(b) and b[0] <= lon <= b[2] and b[1] <= lat <= b[3]
+
+
 def parse_bbox(text) -> tuple[float, float, float, float]:
     if isinstance(text, (list, tuple)):
         vals = [float(v) for v in text]
