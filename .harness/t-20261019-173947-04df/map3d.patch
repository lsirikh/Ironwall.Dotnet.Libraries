+    jobs = tmp_path / "data" / "jobs"
+    (jobs / "rot").mkdir(parents=True)
+    (jobs / "rot" / "scene.json").write_text(json.dumps({"created": "2026-10-19T00:00:00", "bbox": list(rr.bbox()),
