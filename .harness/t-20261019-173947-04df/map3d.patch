+def should_accept_rect_and_find_scene_inside_rotated_rect_only(tmp_path, mbtiles):
+    c = TestClient(create_app(Settings(mbtiles_path=str(mbtiles), data_dir=str(tmp_path / "data"))))
+    jm = c.app.state.jobs
+    got = []
+
+    class _J:
+        def to_dict(self):
+            return {"id": "x", "status": "queued"}
+    jm.submit = lambda req: (got.append(req), _J())[1]
+    r = c.post("/api/jobs", json={"bbox": [127.1, 37.36, 127.101, 37.361], "rect": RECT, "enter_zoom": 17})
+    assert r.status_code == 202 and got[0].rect == RECT and got[0].bbox == _rr().bbox()
+    assert c.post("/api/jobs", json={"bbox": [127.1, 37.36, 127.101, 37.361], "rect": {**RECT, "width_m": 0}}).status_code == 400
+    assert c.post("/api/jobs", json={"bbox": [127.1, 37.36, 127.101, 37.361], "rect": {**RECT, "width_m": 9000}}).status_code == 400
+    r = c.post("/api/jobs", json={"bbox": [127.1, 37.36, 127.101, 37.361], "rect": {**RECT, "rotation_deg": 0}})
+    assert r.status_code == 202 and got[-1].bbox == (127.1, 37.36, 127.101, 37.361)   # 회전 0 = bbox 그대로
+    # 장면 찾기 — 회전 영역은 회전 사각형 안만
