+// 회전 영역 뷰어 순수 함수 시험 — 처음 시점(fitAreaView) · 축소 한계(maxOrbitDistance) · 모델 회전(sceneYaw) · 높이표(makeHeightField yaw).
+//   pytest(test_rotated_area.py)가 node 로 부른다.
+import { areaOf, cameraFromMap, enuOf, fitAreaView, maxOrbitDistance, sceneYaw } from "../map3d/static/camsync.js";
+import { makeHeightField } from "../map3d/static/overlay-geom.js";
+
+const fails = [];
+const near = (a, b, tol, what) => { if (!(Math.abs(a - b) <= tol)) fails.push(`${what}: ${a} != ${b}`); };
+const D2R = Math.PI / 180, R = 6378137;
+const sub = (a, b) => ({ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z });
+const dot = (a, b) => a.x * b.x + a.y * b.y + a.z * b.z;
+const cross = (a, b) => ({ x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x });
+const norm = (a) => { const l = Math.hypot(a.x, a.y, a.z); return { x: a.x / l, y: a.y / l, z: a.z / l }; };
+
+// 회전 사각형(map3d.geo.RotRect 와 같은 식) — 로컬 x 오른쪽 · y 위쪽(m) → 경위도
+function rect(lon, lat, w, h, rot) {
+  const k = { x: D2R * R * Math.cos(lat * D2R), y: D2R * R }, b = rot * D2R;
+  const ll = (x, y) => [lon + (x * Math.cos(b) + y * Math.sin(b)) / k.x, lat + (-x * Math.sin(b) + y * Math.cos(b)) / k.y];
+  return { lon, lat, width_m: w, height_m: h, rotation_deg: rot, ll,
+           corners: [ll(-w / 2, -h / 2), ll(w / 2, -h / 2), ll(w / 2, h / 2), ll(-w / 2, h / 2)] };
+}
+
+// 화면 투영(카메라 축 = three.js lookAt) — [-1, 1] 화면 비율
+function project(c, origin, lon, lat, aspect, fov = 50) {
+  const e = enuOf(origin, lon, lat), pos = c.position, t = c.target;
+  const back = norm(sub(pos, t)), right = norm(cross({ x: 0, y: 1, z: 0 }, back)), up = cross(back, right);
+  const v = sub({ x: e.x, y: 0, z: e.z }, pos), tanY = Math.tan(fov / 2 * D2R), depth = -dot(v, back);
+  return { x: dot(v, right) / (depth * tanY * aspect), y: dot(v, up) / (depth * tanY), depth };
+}
+
+// 1) 영역 해석 — 회전 영역은 그 중심 · 네 모서리 · 회전각, bbox 는 예전 그대로
+{
+  const r = rect(127.102, 37.3616, 200, 120, 45);
+  const a = areaOf(r);
+  near(a.c.lon, r.lon, 0, "area center lon"); near(a.rotation, 45, 0, "area rotation");
+  if (a.corners !== r.corners) fails.push("area corners");
+  const b = areaOf([127.1, 37.36, 127.104, 37.3632]);
+  near(b.c.lon, 127.102, 1e-12, "bbox center"); near(b.rotation, 0, 0, "bbox rotation");
+  if (b.corners.length !== 4 || b.corners[2][0] !== 127.104 || b.corners[2][1] !== 37.3632) fails.push("bbox corners");
+}
+
+// 2) 처음 시점 — 그릴 때 방위로 보면 사각형이 반듯하게(위 두 모서리 같은 높이 · 좌우 대칭) 화면에 꽉 찬다
+for (const rot of [30, 45, 90, -60]) {
+  const r = rect(127.102, 37.3616, 200, 120, rot);
+  for (const [w, h, pitch] of [[1600, 900, 60], [900, 1200, 45], [1920, 1080, 0]]) {
+    const v = fitAreaView(r, 50, w, h, { pitch, bearing: rot, margin: 0.1 });
+    near(v.lon, r.lon, 1e-12, "fit center lon"); near(v.lat, r.lat, 1e-12, "fit center lat");
+    const c = cameraFromMap(r, v, 50, h, 0);
+    const s = r.corners.map(([lon, lat]) => project(c, r, lon, lat, w / h));
+    if (s.some((p) => !(p.depth > 0))) fails.push(`fit r${rot}: corner behind camera`);
+    near(Math.max(...s.map((p) => Math.max(Math.abs(p.x), Math.abs(p.y)))), 0.9, 1e-3, `fit r${rot} ${w}x${h} p${pitch} tight`);
+    // 모서리 0 왼쪽 아래 · 1 오른쪽 아래 · 2 오른쪽 위 · 3 왼쪽 위 — 반듯하면 아래 · 위 변이 화면에 수평, 좌우 대칭
+    near(s[0].y, s[1].y, 1e-9, `fit r${rot} bottom edge level`); near(s[2].y, s[3].y, 1e-9, `fit r${rot} top edge level`);
+    near(s[0].x, -s[1].x, 1e-9, `fit r${rot} symmetric`);
+    if (!(s[3].y > s[0].y)) fails.push(`fit r${rot}: rect top should be up on screen`);
+  }
+  // 회전 영역 중심 · 모서리로 셈 — 같은 사각형을 감싸는 bbox 로 보는 것보다 가깝다(꽉 찬다)
+  const xs = r.corners.map((p) => p[0]), ys = r.corners.map((p) => p[1]);
+  const box = [Math.min(...xs), Math.min(...ys), Math.max(...xs), Math.max(...ys)];
+  if (rot % 90 !== 0 && !(fitAreaView(r, 50, 1600, 900, { bearing: rot }).distance < fitAreaView(box, 50, 1600, 900, { bearing: rot }).distance - 1))
+    fails.push(`fit r${rot}: rotated rect should fit closer than its bbox`);
+}
+
+// 3) 축소 한계 — 회전 사각형 기준(사각형 방위에서 0 · 45 · 90 · 135), 어느 방위로 돌려도 영역 전체가 들어온다
+{
+  const r = rect(127.102, 37.3616, 200, 120, 45);
+  const max = maxOrbitDistance(r, 50, 1600, 900, 60);
+  near(max, 1.3 * Math.max(...[0, 45, 90, 135].map((b) => fitAreaView(r, 50, 1600, 900, { pitch: 60, bearing: 45 + b, margin: 0 }).distance)), 1e-6, "max = 1.3 x fit(rect)");
+  for (const b of [0, 20, 45, 90, 160, 225, 300]) {
+    const tight = fitAreaView(r, 50, 1600, 900, { pitch: 60, bearing: b, margin: 0 });
+    if (!(tight.distance * 1.15 <= max)) fails.push(`max distance rect: whole area b${b}`);
+  }
+  if (!(max < 2 * fitAreaView(r, 50, 1600, 900, { pitch: 60, bearing: 45 }).distance)) fails.push("max distance rect: only a bit beyond home");
+  // 예전 bbox 장면은 그대로(0 · 45 · 90 · 135)
+  const bb = [127.105, 37.364, 127.112, 37.369];
+  near(maxOrbitDistance(bb, 50, 1600, 900, 60), 1.3 * Math.max(...[0, 45, 90, 135].map((b) => fitAreaView(bb, 50, 1600, 900, { pitch: 60, bearing: b, margin: 0 }).distance)), 1e-9, "bbox max unchanged");
+}
+
+// 4) 모델 회전 — 장면 GLB(사각형 축: x 오른쪽 · z −위쪽)를 rotation.y = sceneYaw 로 돌리면 세계 = ENU(enuOf)
+for (const rot of [30, 45, 90, -60, 300]) {
+  const r = rect(127.102, 37.3616, 200, 120, rot);
+  const yaw = sceneYaw({ rect: { rotation_deg: rot } });
+  for (const [x, y] of [[0, 50], [80, 0], [-100, -60], [37, 12]]) {
+    const lx = x, lz = -y;   // GLB 로컬
+    const wx = lx * Math.cos(yaw) + lz * Math.sin(yaw), wz = -lx * Math.sin(yaw) + lz * Math.cos(yaw);   // three.js Ry
+    const [lon, lat] = r.ll(x, y), e = enuOf(r, lon, lat);
+    near(wx, e.x, 1e-6, `yaw r${rot} x`); near(wz, e.z, 1e-6, `yaw r${rot} z`);
+  }
+}
+near(sceneYaw({ bbox: [1, 2, 3, 4] }), 0, 0, "no rect -> 0"); near(sceneYaw(null), 0, 0, "null -> 0");
+near(sceneYaw({ rect: { rotation_deg: 0 } }), 0, 0, "rect 0 -> 0");
+
+// 5) 높이표 — 회전 영역 지형(세계 축에 기운 격자)도 정점 높이를 그대로 읽는다(yaw 로 되돌려 표를 만든다)
+{
+  const nx = 6, ny = 4, yaw = -45 * D2R, hf = (x, z) => 50 + 0.1 * x + 0.02 * z;   // 로컬 평면(삼각형 보간이 정확)
+  const loc = [], wld = [];
+  for (let i = 0; i < ny; i++) for (let j = 0; j < nx; j++) {
+    const x = -100 + 40 * j, z = -60 + 40 * i, y = hf(x, z);
+    loc.push(x, y, z);
+    wld.push(x * Math.cos(yaw) + z * Math.sin(yaw), y, -x * Math.sin(yaw) + z * Math.cos(yaw));
+  }
+  const field = makeHeightField(Float32Array.from(wld), nx, ny, yaw);
+  if (!field) fails.push("height field yaw: null");
+  else for (const [x, z] of [[0, 0], [33, -12], [-90, 50], [95, 55]]) {
+    const wx = x * Math.cos(yaw) + z * Math.sin(yaw), wz = -x * Math.sin(yaw) + z * Math.cos(yaw);
+    near(field.sample(wx, wz), hf(x, z), 1e-3, `height field yaw at ${x},${z}`);
+  }
+  // yaw 없이 같은(기운) 정점을 주면 축 정렬 격자가 아니라 읽을 수 없다 — 그래서 yaw 가 필요하다
+  const plain = makeHeightField(Float32Array.from(wld), nx, ny);
+  if (plain && Math.abs(plain.sample(0, 0) - hf(0, 0)) < 1e-3 && Math.abs(plain.sample(50, 20) - hf(50 * Math.cos(-yaw) + 20 * Math.sin(-yaw), -50 * Math.sin(-yaw) + 20 * Math.cos(-yaw))) < 1e-3)
+    fails.push("height field without yaw unexpectedly right");
+  // yaw 0 은 예전과 같다
+  const a = makeHeightField(Float32Array.from(loc), nx, ny), b = makeHeightField(Float32Array.from(loc), nx, ny, 0);
+  for (const [x, z] of [[0, 0], [33, -12]]) near(a.sample(x, z), b.sample(x, z), 0, "yaw 0 same");
+}
+
+if (fails.length) { console.log(fails.join("\n")); process.exit(1); }
+console.log("rotated ok");
