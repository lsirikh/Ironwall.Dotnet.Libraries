+// GIS 방향 링 · 이동 단추(camera.nudge · camera.preset, 2026-10-19) — 지금 자세(view)에서 다음 자세를 셈한다.
+//   bearingDelta · pitchDelta = 도, forward · right = 카메라 거리(distance) 비율(바라보는 방향 기준 지면 이동 — 멀리서 보면 멀리 간다),
+//   zoom = 줌 단계(+ 확대). 기울기는 0~85(cameraFromMap 한계), 바라볼 점은 장면 영역 안(clampToArea). 거리 한계는 궤도 조작이 맞춘다.
+export const NAV_MAX_PITCH = 85;
+export function nudgeView(view, m, { distance = 0, area = null } = {}) {
+  const num = (v) => (Number.isFinite(v) ? v : 0);
+  const bearing = ((((view.bearing ?? 0) + num(m.bearingDelta)) % 360) + 360) % 360;
+  const pitch = Math.max(0, Math.min(NAV_MAX_PITCH, (view.pitch ?? 0) + num(m.pitchDelta)));
+  const b = bearing * D2R, f = num(m.forward) * distance, r = num(m.right) * distance;
+  // 화면 위쪽 = 방위 b 쪽(동 = sin b · 북 = cos b), 오른쪽 = 그에 90° 시계
+  const east = f * Math.sin(b) + r * Math.cos(b), north = f * Math.cos(b) - r * Math.sin(b);
+  let ll = lonLatOf({ lon: view.lon, lat: view.lat }, east, -north);
+  if (area) ll = clampToArea(area, ll.lon, ll.lat);
+  return { lon: ll.lon, lat: ll.lat, zoom: view.zoom + num(m.zoom), bearing, pitch };
+}
+// 정해 둔 시점 — north = 정북(방위 0), top = 위에서 보기(기울기 0), default = 처음 진입 기울기(defaultPitch). 나머지는 그대로. 모르는 이름은 null.
+export function presetView(view, name, defaultPitch = 60) {
+  if (name === "north") return { ...view, bearing: 0 };
+  if (name === "top") return { ...view, pitch: 0 };
+  if (name === "default") return { ...view, pitch: defaultPitch };
+  return null;
+}
+// 점을 영역(bbox 또는 회전 영역 rect) 안으로 — 영역 축(회전각)에서 가장 가까운 안쪽 점.
+export function clampToArea(area, lon, lat) {
+  const { c, corners, rotation } = areaOf(area);
+  const t = rotation * D2R, cos = Math.cos(t), sin = Math.sin(t);
+  // 영역 축 좌표(map3d.geo.RotRect 와 같은 규약): 동 = u cos + v sin, 북 = −u sin + v cos (장면 z = −북)
+  const toUV = (e) => ({ u: e.x * cos + e.z * sin, v: e.x * sin - e.z * cos });
+  let uMin = Infinity, uMax = -Infinity, vMin = Infinity, vMax = -Infinity;
+  for (const [lo, la] of corners) {
+    const q = toUV(enuOf(c, lo, la));
+    uMin = Math.min(uMin, q.u); uMax = Math.max(uMax, q.u); vMin = Math.min(vMin, q.v); vMax = Math.max(vMax, q.v);
+  }
+  const p = toUV(enuOf(c, lon, lat));
+  const u = Math.max(uMin, Math.min(uMax, p.u)), v = Math.max(vMin, Math.min(vMax, p.v));
+  if (u === p.u && v === p.v) return { lon, lat };
+  return lonLatOf(c, u * cos + v * sin, u * sin - v * cos);
+}
