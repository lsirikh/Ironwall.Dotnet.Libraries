+        var pa = a.Position;
+
+        Key(rig, K.OemOpenBrackets);                          // -1° 미리보기(확정 전)
+        rig.Vm.UndoCommand!.Execute(null);                      // 먼저 확정 → 그 회전(마지막 것)만 되돌린다
+        await Task.Delay(800);
+
+        Assert.False(Group(rig).IsRotating);
