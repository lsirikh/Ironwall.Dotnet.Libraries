+class _CountingJson:
+    """jobs.json 대신 — scene.json 을 몇 번 읽었나 센다."""
+    JSONDecodeError = json.JSONDecodeError
+
+    def __init__(self):
+        self.loads_n = 0
+
+    def loads(self, s, *a, **k):
+        self.loads_n += 1
+        return json.loads(s, *a, **k)
+
+    def dumps(self, *a, **k):
+        return json.dumps(*a, **k)
+
