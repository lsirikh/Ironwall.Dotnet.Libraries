+    (jobs_dir / "j3" / "scene.json").write_text(json.dumps(s), encoding="utf-8")
+    assert c.get("/api/scenes/at", params=at).json()["id"] == "j3"
+    # 직접 그린 건물 수(/api/jobs)는 파일 기준 그대로 바로 반영
+    assert c.put(f"/api/jobs/j1/user-buildings/{UID}", json={"outline": EMPTY, "height": 9}).status_code == 200
+    assert next(x for x in c.get("/api/jobs").json()["scenes"] if x["id"] == "j1")["user_buildings"] == 1
