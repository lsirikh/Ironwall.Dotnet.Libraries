+# ---------------------------------------------------------------- B1 첫 로드 동안 취소
+def _fake_ort(monkeypatch, delay):
+    made = []
+
+    class SlowSession:
+        def __init__(self, path, opt=None, providers=None):
+            time.sleep(delay)
+            made.append(path)
+    fake = types.SimpleNamespace(InferenceSession=SlowSession, SessionOptions=lambda: types.SimpleNamespace())
+    monkeypatch.setitem(sys.modules, "onnxruntime", fake)
+    return made
+
