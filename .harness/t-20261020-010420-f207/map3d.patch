@@ -0,0 +1,350 @@
+"""정적 검토 후속 결함 — 재현 시험(수정 전 실패 · 수정 후 통과).
+
+10 높이 판 저장: GLB 고치기 실패 시 저장 파일 · scene.json · GLB 가 어긋남, 층수 없이 높이만 바꾸면 levels 가 옛 값.
+11 만들다 실패 · 취소한 작업(scene.json 없음)에 고치기 · 목록 요청 → 500, /api/scenes/at 이 매번 모든 scene.json · 직접 그린 건물 파일을 읽음.
+12 깨진 저장 파일(JSON)을 빈 목록으로 읽어 다음 저장이 덮어씀.
+B1 LaMa · SAM 첫 로드(InferenceSession 생성) 동안 굽기 취소가 안 먹음.
+B2 직접 그린 원형 + 돔 · 원뿔 — 입력 높이 = 꼭대기(박공과 같은 기준).
+B3 고른 지붕을 못 지으면(ㄱ자 박공 · 사각 돔) scene.json roof_shape 가 실제 지은 모양과 어긋남.
+"""
+import json
+import math
+import shutil
+import sys
+import threading
+import time
+import types
+from pathlib import Path
+
+import numpy as np
+import pytest
+from fastapi.testclient import TestClient
+
+from map3d import cancel, heights, inpaint, jobs as jobs_mod, sam, userbuildings as UB
+from map3d.buildings import BuildingSpec, build_building
+from map3d.dem import DemSource, load_geotiff
+from map3d.geo import LocalFrame
+from map3d.jobs import Job
+from map3d.server import create_app
+from map3d.terrain import build_grid
+
+from test_heights import _all_ys, _bake, _flat, _settings
+from test_userbuildings import EMPTY, UID, UID2, _files
+
+from test_cancel import _in_cancellable_thread
+
+
+def _client(tmp_path, mbtiles):
+    return TestClient(create_app(_settings(tmp_path, mbtiles)), raise_server_exceptions=False)
+
+
+def _scene(tmp_path, job):
+    return json.loads((tmp_path / "data" / "jobs" / job / "scene.json").read_text(encoding="utf-8"))
+
+
+def _circle(cx, cy, r=0.00012, n=32):
+    """반지름 약 10 m 32각(경도 쪽은 위도 37.36° 에서 늘려 원으로)."""
+    return [[cx + r * math.cos(2 * math.pi * k / n) / 0.7944, cy + r * math.sin(2 * math.pi * k / n)] for k in range(n)]
+
+
+# ---------------------------------------------------------------- 10 높이 판 저장 — 한꺼번에(어긋나지 않게)
+def _fail_after_real_rewrite(monkeypatch):
+    """GLB 를 실제로 고친 뒤 실패(다른 프로그램이 파일을 잡고 있어 다음 파일 교체 실패를 흉내)."""
+    real = heights.restretch_glb
+
+    def boom(*a, **k):
+        real(*a, **k)
+        raise PermissionError("시험: GLB 파일 잠김")
+    monkeypatch.setattr(heights, "restretch_glb", boom)
+
+
+def should_leave_user_file_scene_and_glb_unchanged_when_glb_rewrite_fails_for_drawn_building(tmp_path, mbtiles, slope_dem, monkeypatch):
+    s1 = _bake(tmp_path, mbtiles, slope_dem)
+    UB.put(tmp_path / "data", s1, UID, EMPTY, 12.0, None, None)
+    s2 = _bake(tmp_path, mbtiles, slope_dem, job="j2")
+    u = next(b for b in s2["buildings"] if b.get("user_uid") == UID)
+    jd = tmp_path / "data" / "jobs" / "j2"
+    glb0, sj0, f0 = (jd / "scene.glb").read_bytes(), (jd / "scene.json").read_bytes(), _files(tmp_path)[0].read_bytes()
+    _fail_after_real_rewrite(monkeypatch)
+    r = _client(tmp_path, mbtiles).put(f"/api/jobs/j2/buildings/{u['id']}/height", json={"height": 21.0, "floors": 7})
+    assert r.status_code == 500
+    assert _files(tmp_path)[0].read_bytes() == f0, "직접 그린 건물 파일만 21 m 로 바뀌었다(scene.json 은 12 m)"
+    assert (jd / "scene.json").read_bytes() == sj0
+    assert (jd / "scene.glb").read_bytes() == glb0, "GLB 만 늘어나 scene.json 높이와 어긋났다"
+
+
+def should_leave_override_file_scene_and_glb_unchanged_when_glb_rewrite_fails_for_auto_building(tmp_path, mbtiles, slope_dem, monkeypatch):
+    s1 = _bake(tmp_path, mbtiles, slope_dem)
+    jd = tmp_path / "data" / "jobs" / "j1"
+    glb0, sj0 = (jd / "scene.glb").read_bytes(), (jd / "scene.json").read_bytes()
+    _fail_after_real_rewrite(monkeypatch)
+    r = _client(tmp_path, mbtiles).put(f"/api/jobs/j1/buildings/{_flat(s1)['id']}/height", json={"height": 30.0})
+    assert r.status_code == 500
+    assert not list((tmp_path / "data" / "overrides").glob("area-*.json")), "덮어쓰기 파일에만 30 m 가 남았다"
+    assert (jd / "scene.json").read_bytes() == sj0 and (jd / "scene.glb").read_bytes() == glb0
+
+
+def should_recount_levels_from_height_when_floors_omitted(tmp_path, mbtiles, slope_dem):
+    """층수 없이 높이만 바꾸면 다시 굽기는 높이 ÷ 층고로 층수를 셈한다 — 지금 장면 levels · GLB extras 도 같은 값."""
+    s1 = _bake(tmp_path, mbtiles, slope_dem)
+    UB.put(tmp_path / "data", s1, UID, EMPTY, 12.0, None, None)
+    s2 = _bake(tmp_path, mbtiles, slope_dem, job="j2")
+    u = next(b for b in s2["buildings"] if b.get("user_uid") == UID)
+    c = _client(tmp_path, mbtiles)
+    assert c.put(f"/api/jobs/j2/buildings/{u['id']}/height", json={"height": 21.0, "floors": 7}).json()["building"]["levels"] == 7
+    b = c.put(f"/api/jobs/j2/buildings/{u['id']}/height", json={"height": 30.0}).json()["building"]
+    assert b["levels"] == 10, f"levels 가 옛 값 {b['levels']}(파일 floors 는 None → 다시 굽기 10)"
+    assert _all_ys(tmp_path / "data" / "jobs" / "j2" / "scene.glb", u["id"])[1]["levels"] == 10
+    s3 = _bake(tmp_path, mbtiles, slope_dem, job="j3")
+    assert next(x for x in s3["buildings"] if x.get("user_uid") == UID)["levels"] == 10
+    # 자동 건물(높이 직접 입력)도 같다
+    fid = _flat(s2)["id"]
+    assert c.put(f"/api/jobs/j2/buildings/{fid}/height", json={"height": 30.0, "floors": 9}).json()["building"]["levels"] == 9
+    assert c.put(f"/api/jobs/j2/buildings/{fid}/height", json={"height": 33.0}).json()["building"]["levels"] == 11
+    s4 = _bake(tmp_path, mbtiles, slope_dem, job="j4")
+    assert next(x for x in s4["buildings"] if x.get("manual"))["levels"] == 11
+
+
+# ---------------------------------------------------------------- 11 실패 · 취소 작업 · 장면 목록 캐시
+def should_answer_404_when_job_has_no_scene_after_error_or_cancel(tmp_path, mbtiles, slope_dem):
+    _bake(tmp_path, mbtiles, slope_dem)
