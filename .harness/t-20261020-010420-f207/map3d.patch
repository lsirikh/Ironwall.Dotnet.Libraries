+def should_cancel_quickly_while_lama_session_loads(tmp_path, monkeypatch):
+    made = _fake_ort(monkeypatch, 3.0)                       # 실기 첫 로드 15 초를 3 초로
+    (name, digest), = inpaint.MODEL_FILES.items()
+    (tmp_path / name).write_bytes(b"x")
+    monkeypatch.setattr(inpaint, "_sha256", lambda p: digest)
+    monkeypatch.setattr(inpaint, "_SESSIONS", {})
+    ex, late = _in_cancellable_thread(lambda: inpaint._session(tmp_path), 0.3)
+    assert isinstance(ex, cancel.Cancelled), f"취소가 안 먹었다(예외 {ex!r})"
+    assert late < 1.0, f"취소 뒤 {late:.1f}s 더 걸렸다"
+    for _ in range(50):                                      # 로드는 뒤에서 끝까지 — 다음 굽기가 바로 쓴다
+        if inpaint._SESSIONS:
+            break
+        time.sleep(0.1)
+    assert len(inpaint._SESSIONS) == 1 and len(made) == 1
