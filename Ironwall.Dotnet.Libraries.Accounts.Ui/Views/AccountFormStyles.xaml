<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		계정 셀프서비스 창(B3 — 로그인 · 로그아웃 · 내 정보 · 사용자 추가 · 사용자 변경 · 비밀번호 변경 · 계정 삭제)의 입력 칸 스타일.
		정본: docs/analyses/window-design-inventory-analysis.md B3 · 커널 다이얼로그 틀(Utils ConsoleDialogFrame) · 콘솔 상세 폼(AccountDetailFormView Form.TextBox).

		왜 여기 따로 두나:
		· 옛 창은 호스트 앱에만 있는 스타일(TextBoxInput · PasswordBoxInput · TextBlockTitle · ButtonIcon …)을 StaticResource 로 찾았다 —
		  MDIX 밑줄 칸 + Opacity 0.75 라 콘솔 폼과 다른 앱처럼 보였고, 호스트 없이는(미리보기 · 헤드리스 시험) 뷰를 띄울 수도 없었다.
		· 이 사전은 토큰(DynamicResource)만 쓰고 바깥 키를 StaticResource 로 찾지 않는다 — 어디서 병합해도 그대로 읽힌다.
		규칙: ① 색은 전부 DynamicResource(캐싱 · Frozen 금지) ② 상태는 색이 아니라 형태(포커스 = 두 겹 윤곽, 오류 = 굵은 테두리 + 글)
		③ 이 사전의 글은 뷰 XAML 에 직접 놓인 TextBlock 이 쓴다 — 템플릿 안 TextBlock 은 UIA 기본 보기에서 빠진다(시험이 라벨을 글로 찾는다).
	-->

	<!--  ───────── 입력 오류 — 칸 둘레 굵은 위험 테두리 + 아래 한 줄(색만으로 말하지 않는다: ⚠ 글리프)  ─────────  -->
	<ControlTemplate x:Key="Acct.ValidationError">
		<DockPanel LastChildFill="True">
			<TextBlock
				Margin="1,2,0,0"
				DockPanel.Dock="Bottom"
				FontSize="11"
				Foreground="{DynamicResource StatusCriticalBrush}"
				IsHitTestVisible="False"
				Text="{Binding ElementName=Placeholder, Path=AdornedElement.(Validation.Errors)/ErrorContent, StringFormat=⚠ {0}}"
				TextWrapping="Wrap" />
			<Border
				BorderBrush="{DynamicResource StatusCriticalBrush}"
				BorderThickness="2"
				CornerRadius="4"
				IsHitTestVisible="False">
				<AdornedElementPlaceholder x:Name="Placeholder" />
			</Border>
		</DockPanel>
	</ControlTemplate>

	<!--  ───────── 글 칸 — 콘솔 상세 폼(Form.TextBox)과 같은 치수 · 토큰  ─────────  -->
	<Style x:Key="Acct.TextBox" TargetType="TextBox">
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="6,0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Validation.ErrorTemplate" Value="{StaticResource Acct.ValidationError}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="TextBox">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4"
							SnapsToDevicePixels="True">
							<!--  Style=null — 앱의 암시적(MDIX) ScrollViewer 스타일이 글 칸 안쪽을 다시 그리지 않게  -->
							<ScrollViewer
								x:Name="PART_ContentHost"
								Margin="{TemplateBinding Padding}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								Focusable="False"
								HorizontalScrollBarVisibility="Hidden"
								Style="{x:Null}"
								VerticalScrollBarVisibility="Hidden" />
						</Border>
						<!--  포커스는 색이 아니라 윤곽(형태) — 라이트에서 Primary = Selection = FocusRing 이 같은 색이다  -->
						<Border
							x:Name="Ring"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="4"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Ring" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--  읽기 전용 = 가라앉지 않은 판(값을 읽을 수는 있다)  -->
						<Trigger Property="IsReadOnly" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
						</Trigger>
						<!--  꺼짐도 읽혀야 한다 — 투명도가 아니라 글자 TextSecondary + 판 Surface  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ───────── 비밀번호 칸 — 글 칸과 같은 모양  ─────────  -->
	<Style x:Key="Acct.PasswordBox" TargetType="PasswordBox">
		<Setter Property="Height" Value="30" />
		<Setter Property="Padding" Value="6,0" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="PasswordChar" Value="*" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="Validation.ErrorTemplate" Value="{StaticResource Acct.ValidationError}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="PasswordBox">
					<Grid>
						<Border
							x:Name="Bd"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="4"
							SnapsToDevicePixels="True">
							<ScrollViewer
								x:Name="PART_ContentHost"
								Margin="{TemplateBinding Padding}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
								Focusable="False"
								HorizontalScrollBarVisibility="Hidden"
								Style="{x:Null}"
								VerticalScrollBarVisibility="Hidden" />
						</Border>
						<Border
							x:Name="Ring"
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="2"
							CornerRadius="4"
							IsHitTestVisible="False"
							Visibility="Collapsed" />
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>
						<Trigger Property="IsKeyboardFocused" Value="True">
							<Setter TargetName="Ring" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
							<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		칸 이름 — ConsoleField.Header 에 <b>직접</b> 놓는 TextBlock 에 준다. 글자(string)로 Header 를 주면 커널 템플릿이 만든 TextBlock 이
		UIA 기본 보기에서 빠져, 라벨 옆 칸을 찾는 자동화(EditBesideLabel "직급")가 길을 잃는다.
	-->
	<Style x:Key="Acct.FieldLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<!--  읽기 전용 값(아이디 등) — 칸 높이(30)에 맞춰 가운데  -->
	<Style x:Key="Acct.Value" TargetType="TextBlock">
		<Setter Property="MinHeight" Value="30" />
		<Setter Property="Padding" Value="0,6,0,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<!--  본문 안내 글  -->
	<Style x:Key="Acct.BodyText" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<!--  덧말(작은 안내) — Muted 는 작은 글씨에서 AA 에 못 미친다 → Secondary  -->
	<Style x:Key="Acct.Hint" TargetType="TextBlock">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<!--  콤보는 여기서 스타일을 주지 않는다 — 명시 스타일은 앱의 암시적 콤보(콘솔 상세 폼과 같은 것)를 끊는다. 뷰에서 치수만 준다.  -->
</ResourceDictionary>
