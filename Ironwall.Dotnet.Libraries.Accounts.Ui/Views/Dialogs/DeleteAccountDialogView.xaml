<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.DeleteAccountDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:DesignHeight="450"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<md:DialogHost
		CloseOnClickAway="False"
		DialogTheme="Inherit"
		Identifier="DeleteAccountDialogView">

		<md:Card
			x:Name="CardContents"
			Width="450"
			Height="280"
			MinWidth="300"
			MinHeight="250"
			Padding="20"
			VerticalAlignment="Stretch"
			md:ThemeAssist.Theme="Inherit"
			Opacity="1"
			UniformCornerRadius="8">
			<Grid HorizontalAlignment="Center">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="5*" />
					<ColumnDefinition Width="5*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="1*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4*" />
					<RowDefinition Height="2*" />
				</Grid.RowDefinitions>
				<!--  시안 헤더 바 (LayerPanel 패턴)  -->
				<Border
					Grid.Row="0"
					Grid.ColumnSpan="2"
					Margin="-20,-20,-20,8"
					Style="{StaticResource ModernDialogHeader}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<md:PackIcon
							Width="20"
							Height="20"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource OnPrimaryFixedBrush}"
							Kind="AccountRemove" />
						<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="계정삭제" />
					</StackPanel>
				</Border>

				<Grid
					Grid.Row="2"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					Width="400">
					<Grid.RowDefinitions>
						<RowDefinition Height="4*" />
						<RowDefinition Height="6*" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>

					<Grid
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						VerticalAlignment="Center">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*" />
							<ColumnDefinition Width="8*" />
						</Grid.ColumnDefinitions>
						<md:PackIcon
							Grid.Row="0"
							Grid.Column="0"
							Kind="Alert"
							Style="{StaticResource SubDialogIcon}" />
						<TextBlock
							Grid.Row="0"
							Grid.Column="1"
							Style="{StaticResource SubDialogText}"
							Text="정말 계정을 삭제하시겠습니까?" />
					</Grid>
					<Grid
						Grid.Row="1"
						Grid.ColumnSpan="2"
						VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="7*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="7*" />
							<RowDefinition Height="3*" />
						</Grid.RowDefinitions>
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="비밀번호" />

						<PasswordBox
							x:Name="InputPassword"
							Grid.Row="0"
							Grid.Column="1"
							md:HintAssist.Hint="비밀번호"
							utilPass:PasswordBoxAssistant.BindPassword="True"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<!--  시각적 Validation 담당  -->
							<utilPass:PasswordBoxAssistant.BoundPassword>
								<Binding
									Mode="TwoWay"
									Path="InputPassword"
									UpdateSourceTrigger="PropertyChanged">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule Max="20" Min="8" />
									</Binding.ValidationRules>
								</Binding>
							</utilPass:PasswordBoxAssistant.BoundPassword>
						</PasswordBox>
					</Grid>
				</Grid>

				<Grid
					Grid.Row="4"
					Grid.ColumnSpan="2"
					Margin="0,10,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="5*" />
						<ColumnDefinition Width="5*" />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="ClickOk"
						Grid.Column="0"
						Margin="10,0"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						확인
					</Button>
					<Button
						x:Name="ClickCancel"
						Grid.Column="1"
						Margin="10,0"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						취소
					</Button>
				</Grid>
			</Grid>
		</md:Card>
	</md:DialogHost>
</UserControl>
