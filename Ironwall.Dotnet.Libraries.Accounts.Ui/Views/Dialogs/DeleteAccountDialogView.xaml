<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.DeleteAccountDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:DesignHeight="450"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">
	<!--
		계정 삭제(내 정보 → [계정 삭제]) — B3(window-design-inventory-analysis.md #22). 커널 다이얼로그 틀 T4 · S 400.
		옛 모양: md:Card 400×280 + 시안 머리(ModernDialogHeader) + 주색 [확인].
		· 지우는 창이다 — 주 동작은 위험색(Console.Button.Danger) · 글은 "삭제", 머리 둘째 줄에 <b>대상 계정</b>을 적는다(T4 정의 L1502).
		· 첫 포커스는 틀 규칙 그대로(머리 ✕ = 취소) — Enter 한 번에 지워지지 않는다([삭제] 는 IsDefault 가 아니다).
		· x:Name(InputPassword · ClickOk · ClickCancel) 그대로. ESC · 머리 ✕ = [취소](DialogCancelRoute).
		  UI 시험은 이 창에서 [취소] 만 누른다(ClickOk 금지 — DestructiveGuard).
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Accounts.Ui;component/Views/AccountFormStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<md:DialogHost
		CloseOnClickAway="False"
		DialogTheme="Inherit"
		Identifier="DeleteAccountDialogView">
		<dlg:ConsoleDialogFrame
			x:Name="CardContents"
			DialogKey="Accounts.DeleteAccount"
			Kind="{Binding ViewModel.Username}"
			PrimaryText=""
			SecondaryInvoked="OnSecondaryInvoked"
			SecondaryText=""
			Size="Small"
			Title="계정 삭제">

			<dlg:ConsoleDialogFrame.FooterActions>
				<StackPanel Orientation="Horizontal">
					<Button
						x:Name="ClickCancel"
						Height="34"
						MinWidth="80"
						Margin="0,0,8,0"
						cal:Message.Attach="ClickCancel"
						Content="취소"
						Style="{StaticResource Console.Button}" />
					<Button
						x:Name="ClickOk"
						Height="34"
						MinWidth="80"
						cal:Message.Attach="ClickOk"
						Content="삭제"
						Style="{StaticResource Console.Button.Danger}" />
				</StackPanel>
			</dlg:ConsoleDialogFrame.FooterActions>

			<StackPanel>
				<DockPanel Margin="0,2,0,14" LastChildFill="True">
					<!--  무게는 색이 아니라 글리프로  -->
					<md:PackIcon
						Width="22"
						Height="22"
						Margin="0,0,12,0"
						VerticalAlignment="Top"
						DockPanel.Dock="Left"
						Foreground="{DynamicResource StatusCriticalBrush}"
						Kind="AlertOutline" />
					<StackPanel>
						<TextBlock
							FontWeight="SemiBold"
							Style="{StaticResource Acct.BodyText}"
							Text="정말 계정을 삭제하시겠습니까?" />
						<TextBlock
							Margin="0,6,0,0"
							Style="{StaticResource Acct.Hint}"
							Text="삭제한 계정은 되돌릴 수 없습니다. 확인을 위해 비밀번호를 입력하세요." />
					</StackPanel>
				</DockPanel>

				<c:ConsoleField Margin="0,4,0,14">
					<c:ConsoleField.Header>
						<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="비밀번호" />
					</c:ConsoleField.Header>
					<PasswordBox
						x:Name="InputPassword"
						utilPass:PasswordBoxAssistant.BindPassword="True"
						Style="{StaticResource Acct.PasswordBox}">
						<!--  시각적 Validation 담당  -->
						<utilPass:PasswordBoxAssistant.BoundPassword>
							<Binding
								Mode="TwoWay"
								Path="InputPassword"
								UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<utils:StringLengthValidationRule Max="20" Min="8" />
								</Binding.ValidationRules>
							</Binding>
						</utilPass:PasswordBoxAssistant.BoundPassword>
					</PasswordBox>
				</c:ConsoleField>
			</StackPanel>
		</dlg:ConsoleDialogFrame>
	</md:DialogHost>
</UserControl>
