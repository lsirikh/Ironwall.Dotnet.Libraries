<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.EditorDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enum="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

		<md:Card
			x:Name="CardContents"
			Width="500"
			Height="600"
			MinWidth="350"
			MinHeight="550"
			Padding="20"
			VerticalAlignment="Stretch"
			md:ThemeAssist.Theme="Dark"
			Background="{DynamicResource SurfaceBrush}"
			Opacity="1"
			UniformCornerRadius="8">
			<Grid HorizontalAlignment="Center">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<!--  시안 헤더 바 (LayerPanel 패턴)  -->
				<Border
					Grid.Row="0"
					Margin="-20,-20,-20,8"
					Style="{StaticResource ModernDialogHeader}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<md:PackIcon
							Width="20"
							Height="20"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource OnPrimaryFixedBrush}"
							Kind="AccountEdit" />
						<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="사용자 변경" />
					</StackPanel>
				</Border>
				<ScrollViewer
					Grid.Row="2"
					Height="390"
					VerticalScrollBarVisibility="Auto">

					<Grid Width="400">
						<Grid.Resources>
							<Style BasedOn="{StaticResource TextBlockTitle}" TargetType="TextBlock">
								<Setter Property="FontSize" Value="16" />
								<Setter Property="Opacity" Value="0.8" />
							</Style>
						</Grid.Resources>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="5*" />
							<ColumnDefinition Width="2*" />
						</Grid.ColumnDefinitions>

						<!--  IdUser  -->
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="아이디" />
						<TextBox
							x:Name="Username"
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="아이디"
							IsEnabled="False"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Username}" />

						<!--  IdUser  -->
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="비밀번호" />
						<!--<PasswordBox Style="{StaticResource PasswordBoxInput}"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     x:Name="AccountViewModel_Password"
                                     PasswordChar="*"
                                     IsEnabled="False"
                                     md:HintAssist.Hint="비밀번호">
							<i:Interaction.Behaviors>
								<behaviors:PasswordBehavior Password="{Binding AccountViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</i:Interaction.Behaviors>
						</PasswordBox>-->

						<PasswordBox
							x:Name="Password"
							Grid.Row="1"
							Grid.Column="1"
							md:HintAssist.Hint="비밀번호"
							utilPass:PasswordBoxAssistant.BindPassword="True"
							IsEnabled="False"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<!--  시각적 Validation 담당  -->
							<utilPass:PasswordBoxAssistant.BoundPassword>
								<Binding
									Mode="TwoWay"
									Path="ViewModel.Password"
									UpdateSourceTrigger="PropertyChanged">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule Max="20" Min="8" />
									</Binding.ValidationRules>
								</Binding>
							</utilPass:PasswordBoxAssistant.BoundPassword>
						</PasswordBox>

						<Button
							x:Name="ClickResetPassword"
							Grid.Row="1"
							Grid.Column="2"
							Style="{StaticResource MaterialDesignFlatButton}">
							<Button.Content>
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
									<md:PackIcon
										Width="{StaticResource WidthIconSmall}"
										Height="{StaticResource HeightIconSmall}"
										Kind="Eraser" />
								</StackPanel>
							</Button.Content>

						</Button>

						<!--  Level  -->
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="등급" />
						<StackPanel
							Grid.Row="2"
							Grid.Column="1"
							Grid.ColumnSpan="2">
							<ComboBox
								x:Name="LevelComboBox"
								ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type enum:EnumUserRole}}}"
								SelectedItem="{Binding ViewModel.Role, UpdateSourceTrigger=PropertyChanged}"
								Style="{StaticResource ComboBoxContent}">
								<ComboBox.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel />
									</ItemsPanelTemplate>
								</ComboBox.ItemsPanel>
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
								<ComboBox.ItemContainerStyle>
									<Style BasedOn="{StaticResource ComboBoxItemContent}" TargetType="ComboBoxItem" />
								</ComboBox.ItemContainerStyle>
							</ComboBox>
						</StackPanel>

						<!--  RegisterName  -->
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="이름" />

						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="이름"
							md:ValidationAssist.HorizontalAlignment="Left"
							Style="{StaticResource TextBoxInput}">
							<TextBox.Text>
								<Binding
									Mode="TwoWay"
									Path="ViewModel.Name"
									UpdateSourceTrigger="LostFocus">
									<Binding.ValidationRules>
										<utils:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
									</Binding.ValidationRules>
								</Binding>
							</TextBox.Text>
						</TextBox>


						<!--  EmployeeNumber  -->
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="사번" />
						<TextBox
							x:Name="EditorEmployeeNumber"
							Grid.Row="4"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="사원번호"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.EmployeeNumber}" />

						<!--  Birth  -->
						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="생년월일" />
						<StackPanel
							Grid.Row="5"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="1990-10-10"
							md:ValidationAssist.HorizontalAlignment="Left">
							<DatePicker SelectedDate="{Binding ViewModel.Birth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource DatePickerContent}" />
						</StackPanel>

						<!--  Phone  -->
						<TextBlock
							Grid.Row="6"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="전화번호" />
						<TextBox
							x:Name="EditorPhone"
							Grid.Row="6"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="전화번호"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
							<i:Interaction.Behaviors>
								<behavior:NumericOnlyBehavior />
							</i:Interaction.Behaviors>
						</TextBox>

						<!--  Address  -->
						<TextBlock
							Grid.Row="7"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="주소" />
						<TextBox
							x:Name="EditorAddress"
							Grid.Row="7"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="주소"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Address}" />

						<!--  EMail  -->
						<TextBlock
							Grid.Row="8"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="이메일" />
						<TextBox
							x:Name="EditorEmail"
							Grid.Row="8"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="이메일"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.EMail}" />

						<!--  Image  -->
						<TextBlock
							Grid.Row="9"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="사진" />
						<TextBox
							x:Name="EditorImage"
							Grid.Row="9"
							Grid.Column="1"
							md:HintAssist.Hint="사진"
							IsEnabled="False"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Image}" />
						<!--  open file  -->
						<Button
							x:Name="ClickAddPicture"
							Grid.Row="9"
							Grid.Column="2"
							VerticalAlignment="Center"
							IsDefault="True"
							Style="{StaticResource MaterialDesignFlatButton}">
							<Button.Content>
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
									<md:PackIcon
										Width="{StaticResource WidthIconSmall}"
										Height="{StaticResource HeightIconSmall}"
										Kind="ImageAdd" />
								</StackPanel>
							</Button.Content>
						</Button>

						<!--  Position  -->
						<TextBlock
							Grid.Row="10"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="직급" />
						<TextBox
							x:Name="EditorPosition"
							Grid.Row="10"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="직급"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Position}" />

						<!--  Department  -->
						<TextBlock
							Grid.Row="11"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="부서" />
						<TextBox
							x:Name="EditorDepartment"
							Grid.Row="11"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="부서"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Department}" />

						<!--  Company  -->
						<TextBlock
							Grid.Row="12"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="회사" />
						<TextBox
							x:Name="EditorCompany"
							Grid.Row="12"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="회사"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Company}" />

						<!--  USED  -->
						<TextBlock
							Grid.Row="13"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="상태" />
						<StackPanel
							Grid.Row="13"
							Grid.Column="1"
							Grid.ColumnSpan="2">
							<ComboBox
								x:Name="UsedComboBox"
								ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type enum:EnumUsedType}}}"
								SelectedItem="{Binding ViewModel.Used, UpdateSourceTrigger=PropertyChanged}"
								Style="{StaticResource ComboBoxContent}">

								<ComboBox.ItemsPanel>
									<ItemsPanelTemplate>
										<VirtualizingStackPanel />
									</ItemsPanelTemplate>
								</ComboBox.ItemsPanel>
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
								<ComboBox.ItemContainerStyle>
									<Style BasedOn="{StaticResource ComboBoxItemContent}" TargetType="ComboBoxItem" />
								</ComboBox.ItemContainerStyle>
							</ComboBox>
						</StackPanel>
					</Grid>
				</ScrollViewer>

				<Separator
					Grid.Row="3"
					Margin="0,10"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<!--  Button Group  -->
				<Grid
					Grid.Row="4"
					Margin="0,10"
					VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="5*" />
						<ColumnDefinition Width="5*" />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="ClickOk"
						Grid.Column="0"
						Margin="10,0"
						VerticalAlignment="Center"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<TextBlock Style="{StaticResource ButtonTextBlock}" Text="확인" />
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickCancel"
						Grid.Column="1"
						Margin="10,0"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<TextBlock Style="{StaticResource ButtonTextBlock}" Text="취소" />
						</Button.Content>
					</Button>
				</Grid>

			</Grid>
		</md:Card>
</UserControl>
