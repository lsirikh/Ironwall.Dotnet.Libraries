<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.EditorDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:enum="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">
	<!--
		사용자 변경 — B3(window-design-inventory-analysis.md #20). 커널 다이얼로그 틀 T4 · M 560.
		옛 모양: md:Card 400×550 + md:ThemeAssist.Theme="Dark" 고정(라이트에서도 어두운 MDIX 칸) + 시안 머리(ModernDialogHeader).
		· 절 · 칸 이름은 계정 콘솔 상세 폼(AccountFieldCatalog)과 같다: 신원 · 소속 · 역할 · 인적사항.
		· 확인 · 취소는 x:Name 버튼 그대로(FooterActions + Message.Attach). ESC · 머리 ✕ = [취소](DialogCancelRoute).
		· 사진 고르기(Win32 OpenFileDialog)는 그대로다(#44 유지 권고).
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Accounts.Ui;component/Views/AccountFormStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<utils:ImageConverter x:Key="ImageConverter" />
			<conv:RoleDisplayConverter x:Key="RoleText" />
			<conv:UsedDisplayConverter x:Key="UsedText" />
		</ResourceDictionary>
	</UserControl.Resources>

	<dlg:ConsoleDialogFrame
		x:Name="CardContents"
		DialogKey="Accounts.Editor"
		Kind="{Binding ViewModel.Username}"
		PrimaryText=""
		SecondaryInvoked="OnSecondaryInvoked"
		SecondaryText=""
		Size="Medium"
		Title="사용자 변경">

		<dlg:ConsoleDialogFrame.FooterActions>
			<StackPanel Orientation="Horizontal">
				<Button
					x:Name="ClickCancel"
					Height="34"
					MinWidth="92"
					Margin="0,0,8,0"
					cal:Message.Attach="ClickCancel"
					Content="취소"
					Style="{StaticResource Console.Button}" />
				<Button
					x:Name="ClickOk"
					Height="34"
					MinWidth="92"
					cal:Message.Attach="ClickOk"
					Content="확인"
					Style="{StaticResource Console.Button.Primary}" />
			</StackPanel>
		</dlg:ConsoleDialogFrame.FooterActions>

		<StackPanel>
			<c:ConsoleSection Margin="0" Header="신원">
				<StackPanel>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="아이디" />
						</c:ConsoleField.Header>
						<TextBox
							x:Name="Username"
							IsEnabled="False"
							Style="{StaticResource Acct.TextBox}"
							Text="{Binding ViewModel.Username}" />
					</c:ConsoleField>

					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="비밀번호" />
						</c:ConsoleField.Header>
						<DockPanel LastChildFill="True">
							<Button
								x:Name="ClickResetPassword"
								Height="30"
								Margin="8,0,0,0"
								DockPanel.Dock="Right"
								Style="{StaticResource Console.Button}"
								ToolTip="비밀번호를 초기화합니다">
								<StackPanel Orientation="Horizontal">
									<md:PackIcon
										Width="16"
										Height="16"
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										Kind="Eraser" />
									<TextBlock VerticalAlignment="Center" Text="초기화" />
								</StackPanel>
							</Button>
							<PasswordBox
								x:Name="Password"
								utilPass:PasswordBoxAssistant.BindPassword="True"
								IsEnabled="False"
								Style="{StaticResource Acct.PasswordBox}">
								<utilPass:PasswordBoxAssistant.BoundPassword>
									<Binding
										Mode="TwoWay"
										Path="ViewModel.Password"
										UpdateSourceTrigger="PropertyChanged">
										<Binding.ValidationRules>
											<utils:StringLengthValidationRule Max="20" Min="8" />
										</Binding.ValidationRules>
									</Binding>
								</utilPass:PasswordBoxAssistant.BoundPassword>
							</PasswordBox>
						</DockPanel>
					</c:ConsoleField>

					<c:ConsoleField Margin="0,4,0,14">
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="성명" />
						</c:ConsoleField.Header>
						<TextBox Style="{StaticResource Acct.TextBox}">
							<TextBox.Text>
								<Binding
									Mode="TwoWay"
									Path="ViewModel.Name"
									UpdateSourceTrigger="LostFocus">
									<Binding.ValidationRules>
										<utils:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
									</Binding.ValidationRules>
								</Binding>
							</TextBox.Text>
						</TextBox>
					</c:ConsoleField>
				</StackPanel>
			</c:ConsoleSection>

			<c:ConsoleSection Header="소속 · 역할">
				<StackPanel>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="구분" />
						</c:ConsoleField.Header>
						<ComboBox
							x:Name="LevelComboBox"
							Height="30"
							FontSize="13"
							Foreground="{DynamicResource TextPrimaryBrush}"
							ItemsSource="{Binding ViewModel.AvailableRoles}"
							SelectedItem="{Binding ViewModel.Role, UpdateSourceTrigger=PropertyChanged}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<!--  저장 값은 열거형 그대로, 글은 "관리자 · 사용자"(A-21)  -->
									<TextBlock Text="{Binding Converter={StaticResource RoleText}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</c:ConsoleField>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="상태" />
						</c:ConsoleField.Header>
						<ComboBox
							x:Name="UsedComboBox"
							Height="30"
							FontSize="13"
							Foreground="{DynamicResource TextPrimaryBrush}"
							ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type enum:EnumUsedType}}}"
							SelectedItem="{Binding ViewModel.Used, UpdateSourceTrigger=PropertyChanged}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<!--  USED / NOT_USED 가 아니라 "사용 / 미사용"(A-48) — 콘솔 목록과 같은 말  -->
									<TextBlock Text="{Binding Converter={StaticResource UsedText}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</c:ConsoleField>
				</StackPanel>
			</c:ConsoleSection>

			<c:ConsoleSection Header="인적사항">
				<StackPanel>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="사번" />
						</c:ConsoleField.Header>
						<TextBox
							x:Name="EditorEmployeeNumber"
							Style="{StaticResource Acct.TextBox}"
							Text="{Binding ViewModel.EmployeeNumber}" />
					</c:ConsoleField>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="전화" />
						</c:ConsoleField.Header>
						<TextBox
							x:Name="EditorPhone"
							Style="{StaticResource Acct.TextBox}"
							Text="{Binding ViewModel.Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
							<i:Interaction.Behaviors>
								<behavior:NumericOnlyBehavior />
							</i:Interaction.Behaviors>
						</TextBox>
					</c:ConsoleField>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="이메일" />
						</c:ConsoleField.Header>
						<TextBox
							x:Name="EditorEmail"
							Style="{StaticResource Acct.TextBox}"
							Text="{Binding ViewModel.EMail}" />
					</c:ConsoleField>

					<!--  사진 — 미리보기(등록 여부 식별) + 변경/삭제 (관리자: 대상 계정 {id} 사진 — Admin_Photo_Upload)  -->
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="사진" />
						</c:ConsoleField.Header>
						<StackPanel Orientation="Horizontal">
							<!--  미리보기: 사진 없으면 기본 아바타(ImageConverter), http photo_url 은 직접 렌더  -->
							<Border
								Width="56"
								Height="56"
								Background="{DynamicResource SurfaceSunkenBrush}"
								BorderBrush="{DynamicResource DividerBrush}"
								BorderThickness="1"
								CornerRadius="4">
								<Image
									Source="{Binding ViewModel.Image, Mode=OneWay, Converter={StaticResource ImageConverter}, ConverterParameter='Full'}"
									Stretch="UniformToFill"
									ToolTip="{Binding ViewModel.Image}" />
							</Border>
							<Button
								x:Name="ClickAddPicture"
								Height="30"
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								Style="{StaticResource Console.Button.Ghost}"
								ToolTip="사진 변경(대상 계정)">
								<StackPanel Orientation="Horizontal">
									<md:PackIcon
										Width="16"
										Height="16"
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										Kind="ImageAdd" />
									<TextBlock VerticalAlignment="Center" Text="변경" />
								</StackPanel>
							</Button>
							<Button
								x:Name="ClickDeletePicture"
								Height="30"
								Margin="4,0,0,0"
								VerticalAlignment="Center"
								Style="{StaticResource Console.Button.Ghost}"
								ToolTip="사진 삭제(대상 계정)">
								<StackPanel Orientation="Horizontal">
									<md:PackIcon
										Width="16"
										Height="16"
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										Kind="Delete" />
									<TextBlock VerticalAlignment="Center" Text="삭제" />
								</StackPanel>
							</Button>
						</StackPanel>
					</c:ConsoleField>

					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="직급" />
						</c:ConsoleField.Header>
						<TextBox
							x:Name="EditorPosition"
							Style="{StaticResource Acct.TextBox}"
							Text="{Binding ViewModel.Position}" />
					</c:ConsoleField>
					<c:ConsoleField>
						<c:ConsoleField.Header>
							<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="부서" />
						</c:ConsoleField.Header>
						<TextBox
							x:Name="EditorDepartment"
							Style="{StaticResource Acct.TextBox}"
							Text="{Binding ViewModel.Department}" />
					</c:ConsoleField>
				</StackPanel>
			</c:ConsoleSection>
		</StackPanel>
	</dlg:ConsoleDialogFrame>
</UserControl>
