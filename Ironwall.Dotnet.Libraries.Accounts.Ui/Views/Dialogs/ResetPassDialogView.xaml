<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.ResetPassDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">
	<!--
		비밀번호 변경(내 정보 → [변경]) — B3(window-design-inventory-analysis.md #21). 커널 다이얼로그 틀 T4 · S 400.
		옛 모양: md:Card 400×300 + 시안 머리(ModernDialogHeader). 세 칸의 x:Name(InputPassword · NewPassword · NewPasswordConfirm)은
		UI 시험(ChangeOwnPassword)이 이름으로 찾는다 — 그대로. [변경] · [취소] 도 x:Name 그대로(FooterActions + Message.Attach).
		ESC · 머리 ✕ = [취소](DialogCancelRoute). 뜨면 첫 칸(현재 비밀번호)에 포커스(코드 숨김).
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Accounts.Ui;component/Views/AccountFormStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<!--  뷰 전체 DataContext(ViewModel)를 상속받아서 Data 에 할당  -->
			<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		</ResourceDictionary>
	</UserControl.Resources>

	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="ResetPasswordDialogView">
		<dlg:ConsoleDialogFrame
			x:Name="CardContents"
			DialogKey="Accounts.ResetPassword"
			Message="새 비밀번호는 8자 이상 20자 이하로 입력하세요."
			PrimaryText=""
			SecondaryInvoked="OnSecondaryInvoked"
			SecondaryText=""
			Size="Small"
			Title="비밀번호 변경">

			<dlg:ConsoleDialogFrame.FooterActions>
				<StackPanel Orientation="Horizontal">
					<Button
						x:Name="ClickCancel"
						Height="34"
						MinWidth="80"
						Margin="0,0,8,0"
						cal:Message.Attach="ClickCancel"
						Content="취소"
						Style="{StaticResource Console.Button}" />
					<Button
						x:Name="ClickOk"
						Height="34"
						MinWidth="80"
						cal:Message.Attach="ClickOk"
						Content="변경"
						Style="{StaticResource Console.Button.Primary}" />
				</StackPanel>
			</dlg:ConsoleDialogFrame.FooterActions>

			<StackPanel c:ConsoleField.LabelWidth="110">
				<c:ConsoleField Margin="0,4,0,14">
					<c:ConsoleField.Header>
						<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="현재 비밀번호" />
					</c:ConsoleField.Header>
					<PasswordBox
						x:Name="InputPassword"
						utilPass:PasswordBoxAssistant.BindPassword="True"
						Style="{StaticResource Acct.PasswordBox}">
						<!--  시각적 Validation 담당  -->
						<utilPass:PasswordBoxAssistant.BoundPassword>
							<Binding
								Mode="TwoWay"
								Path="InputPassword"
								UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<utils:StringLengthValidationRule Max="20" Min="8" />
								</Binding.ValidationRules>
							</Binding>
						</utilPass:PasswordBoxAssistant.BoundPassword>
					</PasswordBox>
				</c:ConsoleField>

				<c:ConsoleField Margin="0,4,0,14">
					<c:ConsoleField.Header>
						<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="새 비밀번호" />
					</c:ConsoleField.Header>
					<PasswordBox
						x:Name="NewPassword"
						utilPass:PasswordBoxAssistant.BindPassword="True"
						Style="{StaticResource Acct.PasswordBox}">
						<utilPass:PasswordBoxAssistant.BoundPassword>
							<Binding
								Mode="TwoWay"
								Path="NewPassword"
								UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<utils:StringLengthValidationRule Max="20" Min="8" />
								</Binding.ValidationRules>
							</Binding>
						</utilPass:PasswordBoxAssistant.BoundPassword>
					</PasswordBox>
				</c:ConsoleField>

				<c:ConsoleField Margin="0,4,0,14">
					<c:ConsoleField.Header>
						<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="새 비밀번호 확인" />
					</c:ConsoleField.Header>
					<PasswordBox
						x:Name="NewPasswordConfirm"
						utilPass:PasswordBoxAssistant.BindPassword="True"
						Style="{StaticResource Acct.PasswordBox}">
						<utilPass:PasswordBoxAssistant.BoundPassword>
							<Binding
								Mode="TwoWay"
								Path="NewPasswordConfirm"
								UpdateSourceTrigger="PropertyChanged">
								<Binding.ValidationRules>
									<utils:PassConfirmValidationRule ValidatesOnTargetUpdated="True">
										<utils:PassConfirmValidationRule.Parameters>
											<utils:PassConfirmValidationParameters BasicString="{Binding Data.NewPassword, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" />
										</utils:PassConfirmValidationRule.Parameters>
									</utils:PassConfirmValidationRule>
								</Binding.ValidationRules>
							</Binding>
						</utilPass:PasswordBoxAssistant.BoundPassword>
					</PasswordBox>
				</c:ConsoleField>
			</StackPanel>
		</dlg:ConsoleDialogFrame>
	</md:DialogHost>
</UserControl>
