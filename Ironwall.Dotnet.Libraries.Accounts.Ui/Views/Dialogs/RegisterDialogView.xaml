<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.RegisterDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">
	<!--
		사용자 추가 — B3(window-design-inventory-analysis.md #19). 커널 다이얼로그 틀 T4 · M 560.
		V-36 은 틀 모양을 손으로 베꼈다(머리 · 바닥 줄 Border) — 이제 틀(ConsoleDialogFrame) 자체를 쓴다.
		· 확인 · 취소 · 아이디 · 비밀번호 칸은 x:Name(Caliburn 바인딩 · 호스트 UiTests 식별자) 그대로. 확인 · 취소는 틀의 버튼 줄
		  오른쪽(FooterActions)에 앉히고 Message.Attach 로 잇는다(틀의 자기 속성 안은 Caliburn 이름 관례가 닿지 않는다).
		· ESC · 머리 ✕ = [취소](DialogCancelRoute).
		· Enter 가 사진 고르기(Win32 창)를 열던 것을 없앴다 — 옛 [사진 추가] 버튼의 IsDefault=True 를 뺐다.
		· 칸 이름 · 순서는 계정 콘솔 상세 폼(AccountFieldCatalog: 신원 → 인적사항)과 같다.
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Accounts.Ui;component/Views/AccountFormStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<!--  뷰 전체 DataContext(ViewModel)를 상속받아서 Data 에 할당  -->
			<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		</ResourceDictionary>
	</UserControl.Resources>

	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="RegisterDialog">
		<dlg:ConsoleDialogFrame
			x:Name="CardContents"
			DialogKey="Accounts.Register"
			Message="아이디 5~20자 · 비밀번호 8~20자 · 성명 필수"
			PrimaryText=""
			SecondaryInvoked="OnSecondaryInvoked"
			SecondaryText=""
			Size="Medium"
			Title="사용자 추가">

			<dlg:ConsoleDialogFrame.FooterActions>
				<StackPanel Orientation="Horizontal">
					<Button
						x:Name="ClickCancel"
						Height="34"
						MinWidth="92"
						Margin="0,0,8,0"
						cal:Message.Attach="ClickCancel"
						Content="취소"
						Style="{StaticResource Console.Button}" />
					<Button
						x:Name="ClickOk"
						Height="34"
						MinWidth="92"
						cal:Message.Attach="ClickOk"
						Content="확인"
						Style="{StaticResource Console.Button.Primary}" />
				</StackPanel>
			</dlg:ConsoleDialogFrame.FooterActions>

			<StackPanel>
				<c:ConsoleSection Margin="0" Header="신원">
					<StackPanel>
						<c:ConsoleField Margin="0,4,0,14">
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="아이디" />
							</c:ConsoleField.Header>
							<TextBox x:Name="Username" Style="{StaticResource Acct.TextBox}">
								<i:Interaction.Behaviors>
									<behavior:TextBoxFocusAndCaretBehavior />
								</i:Interaction.Behaviors>
								<TextBox.Text>
									<Binding Path="Username" UpdateSourceTrigger="LostFocus">
										<Binding.ValidationRules>
											<utils:StringLengthValidationRule
												Max="20"
												Min="5"
												ValidatesOnTargetUpdated="True" />
										</Binding.ValidationRules>
									</Binding>
								</TextBox.Text>
							</TextBox>
						</c:ConsoleField>

						<c:ConsoleField Margin="0,4,0,14">
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="비밀번호" />
							</c:ConsoleField.Header>
							<PasswordBox
								x:Name="RegisterPass"
								utilPass:PasswordBoxAssistant.BindPassword="True"
								Style="{StaticResource Acct.PasswordBox}">
								<!--  시각적 Validation 담당  -->
								<utilPass:PasswordBoxAssistant.BoundPassword>
									<Binding
										Mode="TwoWay"
										Path="RegisterPass"
										UpdateSourceTrigger="PropertyChanged">
										<Binding.ValidationRules>
											<utils:StringLengthValidationRule Max="20" Min="8" />
										</Binding.ValidationRules>
									</Binding>
								</utilPass:PasswordBoxAssistant.BoundPassword>
							</PasswordBox>
						</c:ConsoleField>

						<c:ConsoleField Margin="0,4,0,14">
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="비밀번호 확인" />
							</c:ConsoleField.Header>
							<PasswordBox
								x:Name="PasswordConfirm"
								utilPass:PasswordBoxAssistant.BindPassword="True"
								Style="{StaticResource Acct.PasswordBox}">
								<utilPass:PasswordBoxAssistant.BoundPassword>
									<Binding
										Mode="TwoWay"
										Path="PasswordConfirm"
										UpdateSourceTrigger="PropertyChanged">
										<Binding.ValidationRules>
											<utils:PassConfirmValidationRule ValidatesOnTargetUpdated="True">
												<utils:PassConfirmValidationRule.Parameters>
													<utils:PassConfirmValidationParameters BasicString="{Binding Data.RegisterPass, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" />
												</utils:PassConfirmValidationRule.Parameters>
											</utils:PassConfirmValidationRule>
										</Binding.ValidationRules>
									</Binding>
								</utilPass:PasswordBoxAssistant.BoundPassword>
							</PasswordBox>
						</c:ConsoleField>

						<c:ConsoleField Margin="0,4,0,14">
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="성명" />
							</c:ConsoleField.Header>
							<TextBox AutomationProperties.AutomationId="Accounts.Register.NameInput" Style="{StaticResource Acct.TextBox}">
								<TextBox.Text>
									<Binding Path="Name" UpdateSourceTrigger="LostFocus">
										<Binding.ValidationRules>
											<utils:StringLengthValidationRule
												Max="10"
												Min="2"
												ValidatesOnTargetUpdated="True" />
										</Binding.ValidationRules>
									</Binding>
								</TextBox.Text>
							</TextBox>
						</c:ConsoleField>
					</StackPanel>
				</c:ConsoleSection>

				<c:ConsoleSection Header="인적사항">
					<StackPanel>
						<c:ConsoleField>
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="사번" />
							</c:ConsoleField.Header>
							<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.EmployeeNumber}" />
						</c:ConsoleField>
						<c:ConsoleField>
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="전화" />
							</c:ConsoleField.Header>
							<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
								<i:Interaction.Behaviors>
									<behavior:NumericOnlyBehavior />
								</i:Interaction.Behaviors>
							</TextBox>
						</c:ConsoleField>
						<c:ConsoleField>
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="이메일" />
							</c:ConsoleField.Header>
							<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.EMail}" />
						</c:ConsoleField>
						<c:ConsoleField>
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="사진" />
							</c:ConsoleField.Header>
							<DockPanel LastChildFill="True">
								<!--  사진 고르기 — Win32 파일 창(#44 유지). Enter 로 열리지 않게 IsDefault 를 두지 않는다  -->
								<Button
									x:Name="ClickAddPicture"
									Height="30"
									Margin="8,0,0,0"
									AutomationProperties.Name="사진 추가"
									DockPanel.Dock="Right"
									Style="{StaticResource Console.Button.Ghost}"
									ToolTip="사진 추가">
									<md:PackIcon
										Width="16"
										Height="16"
										Kind="ImageAdd" />
								</Button>
								<TextBox
									IsReadOnly="True"
									Style="{StaticResource Acct.TextBox}"
									Text="{Binding ViewModel.Image, Mode=OneWay}"
									ToolTip="{Binding ViewModel.Image}" />
							</DockPanel>
						</c:ConsoleField>
						<c:ConsoleField>
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="직급" />
							</c:ConsoleField.Header>
							<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.Position}" />
						</c:ConsoleField>
						<c:ConsoleField>
							<c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="부서" />
							</c:ConsoleField.Header>
							<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.Department}" />
						</c:ConsoleField>
					</StackPanel>
				</c:ConsoleSection>
			</StackPanel>
		</dlg:ConsoleDialogFrame>
	</md:DialogHost>
</UserControl>
