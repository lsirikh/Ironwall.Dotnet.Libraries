<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.RegisterDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  뷰 전체 DataContext(ViewModel)를 상속받아서 Data 에 할당  -->
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
	</UserControl.Resources>
	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="RegisterDialog">
		<md:Card
			x:Name="CardContents"
			Width="450"
			Height="550"
			MinWidth="350"
			MinHeight="550"
			Padding="20"
			Opacity="0.9"
			UniformCornerRadius="8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<!--  시안 헤더 바 (LayerPanel 패턴)  -->
				<Border
					Grid.Row="0"
					Margin="-20,-20,-20,8"
					Style="{StaticResource ModernDialogHeader}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<md:PackIcon
							Width="20"
							Height="20"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource OnPrimaryFixedBrush}"
							Kind="AccountAdd" />
						<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="사용자 추가" />
					</StackPanel>
				</Border>
				<ScrollViewer
					Grid.Row="2"
					Height="400"
					VerticalScrollBarVisibility="Auto">

					<Grid Margin="10,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="4*" />
							<ColumnDefinition Width="2*" />
						</Grid.ColumnDefinitions>

						<!--  ID  -->
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="아이디" />
						<TextBox
							x:Name="Username"
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="아이디"
							Style="{StaticResource TextBoxInput}">
							<i:Interaction.Behaviors>
								<behavior:TextBoxFocusAndCaretBehavior />
							</i:Interaction.Behaviors>
							<TextBox.Text>
								<Binding Path="Username" UpdateSourceTrigger="LostFocus">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule
											Max="20"
											Min="5"
											ValidatesOnTargetUpdated="True" />
									</Binding.ValidationRules>
								</Binding>
							</TextBox.Text>
						</TextBox>

						<!--  RegisterPass  -->
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="비밀번호" />
						<PasswordBox
							x:Name="RegisterPass"
							Grid.Row="1"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="비밀번호"
							utilPass:PasswordBoxAssistant.BindPassword="True"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<!--  값 → VM 동기화만 담당  -->
							<!--<i:Interaction.Behaviors>
								<behavior:PasswordSyncBehavior Target="{Binding RegisterPass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</i:Interaction.Behaviors>-->

							<!--  시각적 Validation 담당  -->
							<utilPass:PasswordBoxAssistant.BoundPassword>
								<Binding
									Mode="TwoWay"
									Path="RegisterPass"
									UpdateSourceTrigger="PropertyChanged">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule Max="20" Min="8" />
									</Binding.ValidationRules>
								</Binding>
							</utilPass:PasswordBoxAssistant.BoundPassword>
						</PasswordBox>

						<!--  PasswordConfirm  -->
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="비밀번호확인" />
						<PasswordBox
							x:Name="PasswordConfirm"
							Grid.Row="2"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="비밀번호 확인"
							utilPass:PasswordBoxAssistant.BindPassword="True"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<!--  값 동기화 (PasswordBox → ViewModel.PasswordConfirm)  -->
							<!--<i:Interaction.Behaviors>
								<behavior:PasswordSyncBehavior Target="{Binding PasswordConfirm, Mode=TwoWay}" />
							</i:Interaction.Behaviors>-->

							<utilPass:PasswordBoxAssistant.BoundPassword>
								<Binding
									Mode="TwoWay"
									Path="PasswordConfirm"
									UpdateSourceTrigger="PropertyChanged">
									<Binding.ValidationRules>
										<utils:PassConfirmValidationRule ValidatesOnTargetUpdated="True">
											<utils:PassConfirmValidationRule.Parameters>
												<utils:PassConfirmValidationParameters BasicString="{Binding Data.RegisterPass, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" />
											</utils:PassConfirmValidationRule.Parameters>
										</utils:PassConfirmValidationRule>
									</Binding.ValidationRules>
								</Binding>
							</utilPass:PasswordBoxAssistant.BoundPassword>
						</PasswordBox>

						<!--  RegisterName  -->
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="이름" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="이름"
							md:ValidationAssist.HorizontalAlignment="Left"
							Style="{StaticResource TextBoxInput}">
							<TextBox.Text>
								<Binding Path="Name" UpdateSourceTrigger="LostFocus">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule
											Max="10"
											Min="2"
											ValidatesOnTargetUpdated="True" />
									</Binding.ValidationRules>
								</Binding>
							</TextBox.Text>
						</TextBox>

						<!--  EmployeeNumber  -->
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="사번" />
						<TextBox
							Grid.Row="4"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="사원번호"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.EmployeeNumber}" />

						<!--  Birth  -->
						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="생년월일" />
						<StackPanel
							Grid.Row="5"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="1990-10-10"
							md:ValidationAssist.HorizontalAlignment="Left">
							<!--<DatePicker SelectedDate="{Binding ViewModel.Birth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource StringToDateConverter}}" Style="{StaticResource DatePickerContent}" />-->
							<DatePicker SelectedDate="{Binding ViewModel.Birth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource DatePickerContent}" />
						</StackPanel>

						<!--  Phone  -->
						<TextBlock
							Grid.Row="6"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="전화번호" />
						<TextBox
							Grid.Row="6"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="전화번호"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
							<i:Interaction.Behaviors>
								<behavior:NumericOnlyBehavior />
							</i:Interaction.Behaviors>
						</TextBox>

						<!--  Password  -->
						<TextBlock
							Grid.Row="7"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="주소" />
						<TextBox
							Grid.Row="7"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="주소"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Address}" />

						<!--  EMail  -->
						<TextBlock
							Grid.Row="8"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="이메일" />
						<TextBox
							Grid.Row="8"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="이메일"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.EMail}" />

						<!--  Image  -->
						<TextBlock
							Grid.Row="9"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="사진" />
						<TextBox
							Grid.Row="9"
							Grid.Column="1"
							VerticalAlignment="Center"
							md:HintAssist.Hint="사진"
							IsEnabled="False"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Image}" />

						<!--  open file  -->
						<Button
							x:Name="ClickAddPicture"
							Grid.Row="9"
							Grid.Column="2"
							VerticalAlignment="Center"
							IsDefault="True"
							Style="{StaticResource MaterialDesignFlatButton}">
							<Button.Content>
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
									<md:PackIcon
										Width="{StaticResource WidthIconSmall}"
										Height="{StaticResource HeightIconSmall}"
										Kind="ImageAdd" />
								</StackPanel>
							</Button.Content>
						</Button>

						<!--  Position  -->
						<TextBlock
							Grid.Row="10"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="직급" />
						<TextBox
							Grid.Row="10"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="직급"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Position}" />

						<!--  Department  -->
						<TextBlock
							Grid.Row="11"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="부서" />
						<TextBox
							Grid.Row="11"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="부서"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Department}" />

						<!--  Company  -->
						<TextBlock
							Grid.Row="12"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="회사" />
						<TextBox
							Grid.Row="12"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="회사"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Company}" />
					</Grid>
				</ScrollViewer>

				<Separator
					Grid.Row="3"
					Margin="0,10"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<!--  Button Group  -->
				<Grid Grid.Row="4" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="5*" />
						<ColumnDefinition Width="5*" />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="ClickOk"
						Grid.Column="0"
						Margin="10,0"
						VerticalAlignment="Center"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="확인" />
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickCancel"
						Grid.Column="1"
						Margin="10,0"
						VerticalAlignment="Center"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Text="취소" />
						</Button.Content>
					</Button>
				</Grid>
			</Grid>
		</md:Card>
	</md:DialogHost>
</UserControl>
