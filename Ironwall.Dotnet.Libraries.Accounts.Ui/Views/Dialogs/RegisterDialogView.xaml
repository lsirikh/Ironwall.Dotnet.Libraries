<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs.RegisterDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  뷰 전체 DataContext(ViewModel)를 상속받아서 Data 에 할당  -->
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
	</UserControl.Resources>
	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="RegisterDialog">
		<!--
			V-36 — 콘솔 다이얼로그 규격(커널 ConsoleDialogFrame 과 같은 모양 — 카드 테두리 TextMuted · 모서리 10 · 그림자)으로 맞춘다: 머리 40 · SurfaceAlt · 굵은 제목 ·
			스크롤하는 몸통 · SurfaceAlt 바닥 줄에 오른쪽 정렬 [취소](Console.Button) → [확인](Console.Button.Primary).
			옛 모양은 청록 머리 띠(ModernDialogHeader) + 전폭 두 칸 버튼이라 콘솔 안에서 혼자 다른 창처럼 보였다.
			틀(ConsoleDialogFrame) 자체를 쓰지 않는 까닭: 호스트 DialogHost 가 이 뷰를 띄우고, 확인 · 취소 · 아이디 · 비밀번호 칸이
			x:Name(Caliburn 바인딩 · 호스트 UiTests 의 식별자)으로 묶여 있어 그 이름들을 그대로 두어야 한다.
		-->
		<Border
			x:Name="CardContents"
			Width="560"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="{DynamicResource SurfaceBrush}"
			TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
			BorderBrush="{DynamicResource TextMutedBrush}"
			BorderThickness="1"
			CornerRadius="10">
			<Border.Effect>
				<DropShadowEffect
					BlurRadius="18"
					Direction="270"
					Opacity="0.28"
					ShadowDepth="4"
					Color="Black" />
			</Border.Effect>
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<!--  머리 — SurfaceAlt · 아래 구분선(ConsoleDialogFrame ① 과 같은 치수)  -->
				<Border
					Grid.Row="0"
					MinHeight="40"
					Padding="20,10"
					Background="{DynamicResource SurfaceAltBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,0,0,1"
					CornerRadius="9,9,0,0">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="15"
						FontWeight="Bold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="사용자 추가" />
				</Border>
				<ScrollViewer
					Grid.Row="2"
					MaxHeight="440"
					VerticalScrollBarVisibility="Auto">

					<Grid Margin="10,12,20,8">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="4*" />
							<ColumnDefinition Width="2*" />
						</Grid.ColumnDefinitions>

						<!--  ID  -->
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="아이디" />
						<TextBox
							x:Name="Username"
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="아이디"
							Style="{StaticResource TextBoxInput}">
							<i:Interaction.Behaviors>
								<behavior:TextBoxFocusAndCaretBehavior />
							</i:Interaction.Behaviors>
							<TextBox.Text>
								<Binding Path="Username" UpdateSourceTrigger="LostFocus">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule
											Max="20"
											Min="5"
											ValidatesOnTargetUpdated="True" />
									</Binding.ValidationRules>
								</Binding>
							</TextBox.Text>
						</TextBox>

						<!--  RegisterPass  -->
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="비밀번호" />
						<PasswordBox
							x:Name="RegisterPass"
							Grid.Row="1"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="비밀번호"
							utilPass:PasswordBoxAssistant.BindPassword="True"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<!--  값 → VM 동기화만 담당  -->
							<!--<i:Interaction.Behaviors>
								<behavior:PasswordSyncBehavior Target="{Binding RegisterPass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</i:Interaction.Behaviors>-->

							<!--  시각적 Validation 담당  -->
							<utilPass:PasswordBoxAssistant.BoundPassword>
								<Binding
									Mode="TwoWay"
									Path="RegisterPass"
									UpdateSourceTrigger="PropertyChanged">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule Max="20" Min="8" />
									</Binding.ValidationRules>
								</Binding>
							</utilPass:PasswordBoxAssistant.BoundPassword>
						</PasswordBox>

						<!--  PasswordConfirm  -->
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="비밀번호 확인" />
						<PasswordBox
							x:Name="PasswordConfirm"
							Grid.Row="2"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							md:HintAssist.Hint="비밀번호 확인"
							utilPass:PasswordBoxAssistant.BindPassword="True"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<!--  값 동기화 (PasswordBox → ViewModel.PasswordConfirm)  -->
							<!--<i:Interaction.Behaviors>
								<behavior:PasswordSyncBehavior Target="{Binding PasswordConfirm, Mode=TwoWay}" />
							</i:Interaction.Behaviors>-->

							<utilPass:PasswordBoxAssistant.BoundPassword>
								<Binding
									Mode="TwoWay"
									Path="PasswordConfirm"
									UpdateSourceTrigger="PropertyChanged">
									<Binding.ValidationRules>
										<utils:PassConfirmValidationRule ValidatesOnTargetUpdated="True">
											<utils:PassConfirmValidationRule.Parameters>
												<utils:PassConfirmValidationParameters BasicString="{Binding Data.RegisterPass, Source={StaticResource proxy}, UpdateSourceTrigger=PropertyChanged}" />
											</utils:PassConfirmValidationRule.Parameters>
										</utils:PassConfirmValidationRule>
									</Binding.ValidationRules>
								</Binding>
							</utilPass:PasswordBoxAssistant.BoundPassword>
						</PasswordBox>

						<!--  RegisterName  -->
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="성명" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Accounts.Register.NameInput"
							md:HintAssist.Hint="성명"
							md:ValidationAssist.HorizontalAlignment="Left"
							Style="{StaticResource TextBoxInput}">
							<TextBox.Text>
								<Binding Path="Name" UpdateSourceTrigger="LostFocus">
									<Binding.ValidationRules>
										<utils:StringLengthValidationRule
											Max="10"
											Min="2"
											ValidatesOnTargetUpdated="True" />
									</Binding.ValidationRules>
								</Binding>
							</TextBox.Text>
						</TextBox>

						<!--  EmployeeNumber  -->
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="사번" />
						<TextBox
							Grid.Row="4"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="사번"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.EmployeeNumber}" />

						<!--  Phone  -->
						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="전화" />
						<TextBox
							Grid.Row="5"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="전화"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
							<i:Interaction.Behaviors>
								<behavior:NumericOnlyBehavior />
							</i:Interaction.Behaviors>
						</TextBox>

						<!--  EMail  -->
						<TextBlock
							Grid.Row="6"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="이메일" />
						<TextBox
							Grid.Row="6"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="이메일"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.EMail}" />

						<!--  Image  -->
						<TextBlock
							Grid.Row="7"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="사진" />
						<TextBox
							Grid.Row="7"
							Grid.Column="1"
							VerticalAlignment="Center"
							md:HintAssist.Hint="사진"
							IsEnabled="False"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Image}" />

						<!--  open file  -->
						<Button
							x:Name="ClickAddPicture"
							Grid.Row="7"
							Grid.Column="2"
							VerticalAlignment="Center"
							IsDefault="True"
							Style="{StaticResource Console.Button.Ghost}">
							<Button.Content>
								<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
									<md:PackIcon
										Width="{StaticResource WidthIconSmall}"
										Height="{StaticResource HeightIconSmall}"
										Kind="ImageAdd" />
								</StackPanel>
							</Button.Content>
						</Button>

						<!--  Position  -->
						<TextBlock
							Grid.Row="8"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="직급" />
						<TextBox
							Grid.Row="8"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="직급"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Position}" />

						<!--  Department  -->
						<TextBlock
							Grid.Row="9"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="부서" />
						<TextBox
							Grid.Row="9"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							VerticalAlignment="Center"
							md:HintAssist.Hint="부서"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding ViewModel.Department}" />
					</Grid>
				</ScrollViewer>

				<!--  바닥 줄 — SurfaceAlt · 위 구분선 · 오른쪽 끝에 보조 → 주 동작(ConsoleDialogFrame ③ 과 같은 치수)  -->
				<Border
					Grid.Row="4"
					Padding="20,12"
					Background="{DynamicResource SurfaceAltBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,1,0,0"
					CornerRadius="0,0,9,9">
					<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
						<Button
							x:Name="ClickCancel"
							Margin="0,0,8,0"
							Content="취소"
							Style="{StaticResource Console.Button}" />
						<Button
							x:Name="ClickOk"
							Content="확인"
							Style="{StaticResource Console.Button.Primary}" />
					</StackPanel>
				</Border>
			</Grid>
		</Border>
	</md:DialogHost>
</UserControl>
