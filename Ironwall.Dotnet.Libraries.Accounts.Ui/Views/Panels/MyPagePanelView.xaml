<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.MyPagePanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="MyPagePanel">
		<md:Card
			x:Name="CardContents"
			Width="550"
			Height="610"
			MinWidth="400"
			MinHeight="400"
			Padding="20"
			Opacity="0.95"
			UniformCornerRadius="8">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  시안 헤더 바 (LayerPanel 패턴)  -->
				<Border
					Grid.Row="0"
					Margin="-20,-20,-20,8"
					Style="{StaticResource ModernDialogHeader}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<md:PackIcon
							Width="20"
							Height="20"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource OnPrimaryFixedBrush}"
							Kind="AccountDetails" />
						<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="내 정보" />
					</StackPanel>
				</Border>

				<StackPanel Grid.Row="2" Orientation="Vertical">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="1*" />
							<ColumnDefinition Width="1*" />
						</Grid.ColumnDefinitions>

						<Grid
							Grid.Row="0"
							Grid.RowSpan="11"
							Grid.Column="0"
							Margin="15"
							HorizontalAlignment="Center"
							VerticalAlignment="Center">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition />
							</Grid.RowDefinitions>
							<Image
								Grid.Row="0"
								Width="120"
								Height="120"
								Source="{Binding ViewModel.Image, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource ImageConverter}, ConverterParameter='Full'}"
								Stretch="Uniform"
								ToolTip="{Binding ViewModel.Image}" />

							<Button
								x:Name="ClickClearPicture"
								Margin="0,-5,-5,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Style="{StaticResource MaterialDesignIconButton}"
								ToolTip="사진 제거하기">
								<Button.Content>
									<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
										<md:PackIcon Kind="ImageMinus" Style="{StaticResource ButtonIcon}" />
									</StackPanel>
								</Button.Content>
							</Button>
							<Button
								x:Name="ClickAddPicture"
								Grid.Row="1"
								Style="{StaticResource MaterialDesignFlatButton}"
								ToolTip="사진 추가하기">
								<Button.Content>
									<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
										<md:PackIcon Kind="ImageAdd" Style="{StaticResource ButtonIcon}" />
										<TextBlock Style="{StaticResource ButtonTextBlock}" Text="추가하기" />
									</StackPanel>
								</Button.Content>
							</Button>
						</Grid>

						<Separator
							Grid.Row="0"
							Grid.RowSpan="12"
							Grid.Column="1"
							Style="{StaticResource SeparatorVerticalStyle}" />
						<!--  IdUser  -->
						<ScrollViewer
							Grid.Row="0"
							Grid.Column="2"
							Grid.ColumnSpan="3"
							Height="370"
							VerticalScrollBarVisibility="Auto">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="3*" />
									<ColumnDefinition Width="1*" />
									<ColumnDefinition Width="1*" />
								</Grid.ColumnDefinitions>
								<Grid Grid.Row="0" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="아이디" />
									<TextBlock
										Grid.Column="1"
										Style="{StaticResource TextBlockContent}"
										Text="{Binding ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  Password  -->
								<Grid Grid.Row="1" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="5*" />
										<ColumnDefinition Width="2*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="비밀번호" />
									<PasswordBox
										x:Name="EditorPassword"
										Grid.Column="1"
										md:HintAssist.Hint="비밀번호"
										IsEnabled="False"
										PasswordChar="*"
										Style="{StaticResource PasswordBoxInput}">
										<i:Interaction.Behaviors>
											<behavior:PasswordBehavior Password="{Binding ViewModel.Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
										</i:Interaction.Behaviors>
									</PasswordBox>
									<Button
										x:Name="ClickPasswordReset"
										Grid.Column="2"
										Style="{StaticResource MaterialDesignFlatButton}">
										<Button.Content>
											<StackPanel VerticalAlignment="Center">
												<md:PackIcon Kind="PasswordReset" Style="{StaticResource ButtonIcon}" />
											</StackPanel>
										</Button.Content>
									</Button>
								</Grid>
								<!--  Name  -->
								<Grid Grid.Row="2" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="이름" />
									<TextBox
										x:Name="EditorMyPageName"
										Grid.Column="1"
										md:HintAssist.Hint="이름"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}">
										<TextBox.Text>
											<Binding
												Mode="TwoWay"
												Path="ViewModel.Name"
												UpdateSourceTrigger="LostFocus">
												<Binding.ValidationRules>
													<utils:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
												</Binding.ValidationRules>
											</Binding>
										</TextBox.Text>
									</TextBox>

								</Grid>
								<!--  EmployeeNumber  -->
								<Grid Grid.Row="3" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="사원번호" />
									<TextBox
										x:Name="EditorMyPageEmployeeNumber"
										Grid.Column="1"
										md:HintAssist.Hint="사원번호"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.EmployeeNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  Birth  -->
								<Grid Grid.Row="4" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="생년월일" />
									<StackPanel
										Grid.Column="1"
										md:HintAssist.Hint="1990-10-10"
										md:ValidationAssist.HorizontalAlignment="Left"
										DataContext="{Binding ViewModel}">
										<!--<DatePicker SelectedDate="{Binding ViewModel.Birth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource StringToDateConverter}}" Style="{StaticResource DatePickerContent}" />-->
										<DatePicker SelectedDate="{Binding Birth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Style="{StaticResource DatePickerContent}" />
									</StackPanel>
								</Grid>
								<!--  Phone  -->
								<Grid Grid.Row="5" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="전화번호" />
									<TextBox
										Grid.Column="1"
										md:HintAssist.Hint="전화번호"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  Address  -->
								<Grid Grid.Row="6" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="주소" />
									<TextBox
										Grid.Column="1"
										md:HintAssist.Hint="주소"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  EMail  -->
								<Grid Grid.Row="7" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="이메일" />
									<TextBox
										Grid.Column="1"
										md:HintAssist.Hint="이메일"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.EMail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  Position  -->
								<Grid Grid.Row="8" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="직급" />
									<TextBox
										Grid.Column="1"
										md:HintAssist.Hint="직급"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  Department  -->
								<Grid Grid.Row="9" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="부서" />
									<TextBox
										Grid.Column="1"
										md:HintAssist.Hint="부서"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.Department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  Company  -->
								<Grid Grid.Row="10" Grid.ColumnSpan="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3*" />
										<ColumnDefinition Width="7*" />
									</Grid.ColumnDefinitions>

									<TextBlock
										Grid.Column="0"
										Style="{StaticResource TextBlockTitle}"
										Text="회사" />
									<TextBox
										Grid.Column="1"
										md:HintAssist.Hint="회사"
										md:ValidationAssist.HorizontalAlignment="Left"
										Style="{StaticResource TextBoxInput}"
										Text="{Binding ViewModel.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
							</Grid>
						</ScrollViewer>

					</Grid>
				</StackPanel>


				<!--  Button Group  -->
				<Grid Grid.Row="4" VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="5*" />
						<ColumnDefinition Width="5*" />
						<ColumnDefinition Width="5*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="1*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="1*" />
					</Grid.RowDefinitions>
					<Button
						x:Name="ClickDeleteAccount"
						Grid.Row="0"
						Grid.Column="0"
						Margin="10,0"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="AccountRemove" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="계정삭제" />
							</StackPanel>
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickResetAccount"
						Grid.Row="0"
						Grid.Column="1"
						Margin="10,0"
						VerticalAlignment="Center"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						IsDefault="True"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="AccountReactivate" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="초기화" />
							</StackPanel>
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickApplyAccount"
						Grid.Row="0"
						Grid.Column="2"
						Margin="10,0"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignOutlinedButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="AccountCheck" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="적용" />
							</StackPanel>
						</Button.Content>
					</Button>

					<Separator
						Grid.Row="1"
						Grid.ColumnSpan="4"
						Background="{DynamicResource DividerBrush}"
						Style="{StaticResource MaterialDesignLightSeparator}" />

					<Button
						x:Name="ClickCancel"
						Grid.Row="2"
						Grid.ColumnSpan="3"
						Margin="0,10,0,0"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Cancel" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="닫기" />
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>

			</Grid>
		</md:Card>

	</md:DialogHost>
</UserControl>
