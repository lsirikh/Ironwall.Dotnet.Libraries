<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.MyPagePanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">
	<!--
		내 정보 — B3(window-design-inventory-analysis.md #10). 커널 다이얼로그 틀 T4 · M 560.
		옛 모양: md:Card 560×500(Opacity 0.95) + 시안 머리(ModernDialogHeader) + 머리 안 ✕(ClickCancel).
		· 절 · 칸은 콘솔 상세 폼과 같은 이름 · 순서(AccountFieldCatalog: 신원 → 인적사항, 성명 · 사번 · 전화 …).
		· 칸 이름은 ConsoleField.Header 에 직접 놓은 TextBlock — UI 시험이 라벨 옆 칸을 찾는다(EditBesideLabel "직급").
		· 버튼 줄: 왼쪽 [계정 삭제](떨어뜨려 둔 파괴 동작) · 오른쪽 [초기화] [닫기] [적용]. 전부 x:Name 버튼 그대로(Message.Attach 로 잇는다).
		  ESC · 머리 ✕ = [닫기](ClickCancel — 코드 숨김 → DialogCancelRoute).
		· [계정 삭제] 가 꺼진 까닭(서버 모드)은 툴팁으로 말한다(DeleteAccountBlockedReason · 0e314a6e).
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Accounts.Ui;component/Views/AccountFormStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<!--  호스트 앱 전용 키에 기대지 않는다 — 사용자 변경 창과 같이 제 변환기를 둔다  -->
			<utils:ImageConverter x:Key="ImageConverter" />
		</ResourceDictionary>
	</UserControl.Resources>

	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="MyPagePanel">
		<dlg:ConsoleDialogFrame
			x:Name="CardContents"
			DialogKey="Accounts.MyPage"
			Kind="{Binding ViewModel.Username}"
			PrimaryText=""
			SecondaryInvoked="OnSecondaryInvoked"
			SecondaryText=""
			Size="Medium"
			Title="내 정보">

			<dlg:ConsoleDialogFrame.FooterExtra>
				<Button
					x:Name="ClickDeleteAccount"
					Height="34"
					cal:Message.Attach="ClickDeleteAccount"
					Style="{StaticResource Console.Button.Danger}"
					ToolTip="{Binding DeleteAccountBlockedReason}"
					ToolTipService.ShowOnDisabled="True">
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Kind="AccountRemove" />
						<TextBlock VerticalAlignment="Center" Text="계정 삭제" />
					</StackPanel>
				</Button>
			</dlg:ConsoleDialogFrame.FooterExtra>

			<dlg:ConsoleDialogFrame.FooterActions>
				<StackPanel Orientation="Horizontal">
					<Button
						x:Name="ClickResetAccount"
						Height="34"
						MinWidth="80"
						Margin="0,0,8,0"
						cal:Message.Attach="ClickResetAccount"
						Content="초기화"
						IsDefault="True"
						Style="{StaticResource Console.Button}"
						ToolTip="서버에 저장된 내 정보로 되돌립니다" />
					<Button
						x:Name="ClickCancel"
						Height="34"
						MinWidth="80"
						Margin="0,0,8,0"
						cal:Message.Attach="ClickCancel"
						Content="닫기"
						Style="{StaticResource Console.Button}" />
					<Button
						x:Name="ClickApplyAccount"
						Height="34"
						MinWidth="80"
						cal:Message.Attach="ClickApplyAccount"
						Content="적용"
						Style="{StaticResource Console.Button.Primary}" />
				</StackPanel>
			</dlg:ConsoleDialogFrame.FooterActions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<!--  사진 — 미리보기 + 제거(모서리) + 추가  -->
				<StackPanel
					Grid.Column="0"
					Width="120"
					Margin="0,14,20,0"
					VerticalAlignment="Top">
					<Grid Width="120" Height="120">
						<Border
							Background="{DynamicResource SurfaceSunkenBrush}"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="1"
							CornerRadius="6">
							<Image
								Margin="1"
								Source="{Binding ViewModel.Image, Mode=OneWay, Converter={StaticResource ImageConverter}, ConverterParameter='Full'}"
								Stretch="Uniform"
								ToolTip="{Binding ViewModel.Image}" />
						</Border>
						<Button
							x:Name="ClickClearPicture"
							Margin="0,4,4,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							AutomationProperties.Name="사진 제거"
							Style="{StaticResource Console.Button.Icon}"
							ToolTip="사진 제거하기">
							<md:PackIcon
								Width="16"
								Height="16"
								Kind="ImageMinus" />
						</Button>
					</Grid>
					<Button
						x:Name="ClickAddPicture"
						Height="30"
						Margin="0,8,0,0"
						HorizontalAlignment="Stretch"
						Style="{StaticResource Console.Button.Ghost}"
						ToolTip="사진 추가하기">
						<StackPanel Orientation="Horizontal">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Kind="ImageAdd" />
							<TextBlock VerticalAlignment="Center" Text="추가하기" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel Grid.Column="1">
					<c:ConsoleSection Margin="0" Header="신원">
						<StackPanel>
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="아이디" />
								</c:ConsoleField.Header>
								<TextBlock Style="{StaticResource Acct.Value}" Text="{Binding ViewModel.Username, Mode=OneWay}" />
							</c:ConsoleField>

							<!--  비밀번호는 여기서 고치지 않는다(칸은 꺼짐) — [변경] 이 전용 창을 연다  -->
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="비밀번호" />
								</c:ConsoleField.Header>
								<DockPanel LastChildFill="True">
									<Button
										x:Name="ClickPasswordReset"
										Height="30"
										Margin="8,0,0,0"
										DockPanel.Dock="Right"
										Style="{StaticResource Console.Button}"
										ToolTip="비밀번호 변경">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="16"
												Height="16"
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												Kind="PasswordReset" />
											<TextBlock VerticalAlignment="Center" Text="변경" />
										</StackPanel>
									</Button>
									<PasswordBox
										x:Name="EditorPassword"
										IsEnabled="False"
										Style="{StaticResource Acct.PasswordBox}">
										<i:Interaction.Behaviors>
											<behavior:PasswordBehavior Password="{Binding ViewModel.Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
										</i:Interaction.Behaviors>
									</PasswordBox>
								</DockPanel>
							</c:ConsoleField>

							<c:ConsoleField Margin="0,4,0,14">
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="성명" />
								</c:ConsoleField.Header>
								<TextBox x:Name="EditorMyPageName" Style="{StaticResource Acct.TextBox}">
									<TextBox.Text>
										<Binding
											Mode="TwoWay"
											Path="ViewModel.Name"
											UpdateSourceTrigger="LostFocus">
											<Binding.ValidationRules>
												<utils:NotEmptyValidationRule ValidatesOnTargetUpdated="True" />
											</Binding.ValidationRules>
										</Binding>
									</TextBox.Text>
								</TextBox>
							</c:ConsoleField>
						</StackPanel>
					</c:ConsoleSection>

					<c:ConsoleSection Header="인적사항">
						<StackPanel>
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="사번" />
								</c:ConsoleField.Header>
								<TextBox
									x:Name="EditorMyPageEmployeeNumber"
									IsReadOnly="{Binding IsEmployeeNumberReadOnly, Mode=OneWay}"
									Style="{StaticResource Acct.TextBox}"
									Text="{Binding ViewModel.EmployeeNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="전화" />
								</c:ConsoleField.Header>
								<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="이메일" />
								</c:ConsoleField.Header>
								<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.EMail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="직급" />
								</c:ConsoleField.Header>
								<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField>
								<c:ConsoleField.Header>
									<TextBlock Style="{StaticResource Acct.FieldLabel}" Text="부서" />
								</c:ConsoleField.Header>
								<TextBox Style="{StaticResource Acct.TextBox}" Text="{Binding ViewModel.Department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
						</StackPanel>
					</c:ConsoleSection>
				</StackPanel>
			</Grid>
		</dlg:ConsoleDialogFrame>
	</md:DialogHost>
</UserControl>
