<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.LogoutPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="LogoutPanel">

		<md:Card
			x:Name="CardContents"
			Width="400"
			Height="250"
			MinWidth="300"
			MinHeight="200"
			Padding="20"
			Opacity="0.9"
			UniformCornerRadius="10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="1*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  Login 제목 세팅  -->
				<StackPanel
					Grid.Row="0"
					VerticalAlignment="Center"
					Orientation="Horizontal">
					<md:PackIcon Kind="LogoutVariant" Style="{StaticResource DialogTitleIcon}" />
					<TextBlock Style="{StaticResource DialogTitle}" Text="Logout" />
				</StackPanel>

				<Separator
					Grid.Row="1"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<Grid
					Grid.Row="2"
					Margin="10"
					VerticalAlignment="Top">

					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<md:PackIcon
						Grid.Row="0"
						Grid.Column="0"
						Kind="Alert"
						Style="{StaticResource SubDialogIcon}" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource SubDialogText}"
						Text="정말로 로그아웃 하시겠습니까?" />
				</Grid>

				<Separator
					Grid.Row="3"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />


				<Grid Grid.Row="4" Margin="0,10,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="ClickOk"
						Grid.Column="0"
						Margin="10,0,5,0"
						VerticalAlignment="Center"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
								<TextBlock
									Style="{StaticResource ButtonTextBlock}"
									Text="확인"
									TextAlignment="Center" />
							</StackPanel>
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickCancel"
						Grid.Column="1"
						Margin="5,0,10,0"
						VerticalAlignment="Center"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Cancel" Style="{StaticResource ButtonIcon}" />
								<TextBlock
									Style="{StaticResource ButtonTextBlock}"
									Text="취소"
									TextAlignment="Center" />
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>
			</Grid>

		</md:Card>
	</md:DialogHost>


</UserControl>
