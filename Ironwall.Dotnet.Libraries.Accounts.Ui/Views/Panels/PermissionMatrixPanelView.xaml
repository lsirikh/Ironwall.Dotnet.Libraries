<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.PermissionMatrixPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<Grid Margin="6">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
			<TextBlock
				VerticalAlignment="Center"
				DockPanel.Dock="Left"
				FontSize="15"
				FontWeight="SemiBold"
				Text="권한 설정 (그룹 × 모듈)" />
			<Button
				DockPanel.Dock="Right"
				Padding="6,2"
				Background="Transparent"
				BorderThickness="0"
				ToolTip="갱신">
				<cal:Message.Attach>[Event Click] = [Action OnClickReloadButton()]</cal:Message.Attach>
				<md:PackIcon Width="22" Height="22" Kind="Refresh" />
			</Button>
		</DockPanel>
		<DataGrid
			Grid.Row="1"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			IsReadOnly="True"
			ItemsSource="{Binding Rows}">
			<DataGrid.Columns>
				<DataGridTextColumn Width="130" Binding="{Binding GroupName}" Header="그룹" />
				<DataGridTextColumn Width="150" Binding="{Binding Module}" Header="모듈" />
				<DataGridCheckBoxColumn Width="60" Binding="{Binding View}" Header="조회" />
				<DataGridCheckBoxColumn Width="60" Binding="{Binding Edit}" Header="편집" />
				<DataGridCheckBoxColumn Width="60" Binding="{Binding Delete}" Header="삭제" />
				<DataGridCheckBoxColumn Width="60" Binding="{Binding Control}" Header="제어" />
				<DataGridTextColumn Width="*" Header="" />
			</DataGrid.Columns>
		</DataGrid>
		<TextBlock
			Grid.Row="2"
			Margin="0,6,0,0"
			FontSize="11"
			Opacity="0.7"
			Text="※ 조회 전용 — 기존 그룹 권한 편집/저장은 서버 v5.0 권한수정 API 후 활성화 (현재 서버가 변경 차단)." />
	</Grid>
</UserControl>
