<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.PermissionMatrixPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="900"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<Grid Margin="6">
		<!--  ① 그룹 목록 (요약)  -->
		<Grid Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
				<TextBlock DockPanel.Dock="Left" Style="{StaticResource PanelSectionLabel}" Text="권한 그룹" />
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button Style="{StaticResource ModernToolbarButton}" ToolTip="그룹 추가">
						<cal:Message.Attach>[Event Click] = [Action OnClickAddGroup()]</cal:Message.Attach>
						<md:PackIcon Width="20" Height="20" Kind="AccountMultiplePlus" />
					</Button>
					<Button Style="{StaticResource ModernToolbarButton}" ToolTip="그룹 삭제">
						<cal:Message.Attach>[Event Click] = [Action OnClickRemoveGroup()]</cal:Message.Attach>
						<md:PackIcon Width="20" Height="20" Kind="AccountMultipleMinus" />
					</Button>
					<Button Style="{StaticResource ModernToolbarButton}" ToolTip="갱신">
						<cal:Message.Attach>[Event Click] = [Action OnClickReloadButton()]</cal:Message.Attach>
						<md:PackIcon Width="20" Height="20" Kind="Refresh" />
					</Button>
				</StackPanel>
			</DockPanel>
			<DataGrid
				Grid.Row="1"
				cal:Message.Attach="[Event MouseDoubleClick] = [Action OnClickGroupDetail()]"
				AutoGenerateColumns="False"
				Background="Transparent"
				CanUserAddRows="False"
				CellStyle="{StaticResource ModernDataGridCell}"
				ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
				IsReadOnly="True"
				ItemsSource="{Binding Groups}"
				RowHeight="40"
				RowStyle="{StaticResource ModernDataGridRow}"
				SelectedItem="{Binding SelectedGroup}"
				Style="{StaticResource ModernDataGrid}">
				<DataGrid.Columns>
					<DataGridTextColumn Width="200" Binding="{Binding GroupName}" Header="그룹" />
					<DataGridTextColumn Width="90" Binding="{Binding UserCount}" Header="사용자" />
					<DataGridTextColumn Width="80" Binding="{Binding Active}" Header="활성" />
					<DataGridTextColumn Width="*" Binding="{Binding Summary}" Header="권한 요약" />
				</DataGrid.Columns>
			</DataGrid>
			<TextBlock
				Grid.Row="2"
				Margin="0,8,0,0"
				Style="{StaticResource PanelFieldLabel}"
				Text="※ 그룹을 더블클릭하면 전체 권한(모듈 × 동작)을 볼 수 있습니다. 그룹 추가/삭제·편집저장은 서버 v5.0 후속." />
		</Grid>

		<!--  ② 그룹 상세 (모듈 × 동작 매트릭스)  -->
		<Grid Visibility="{Binding IsDetailView, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
				<Button DockPanel.Dock="Left" Style="{StaticResource ModernToolbarButton}" ToolTip="목록으로">
					<cal:Message.Attach>[Event Click] = [Action ClickBackToList()]</cal:Message.Attach>
					<md:PackIcon Width="20" Height="20" Kind="ArrowLeft" />
				</Button>
				<TextBlock
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					Style="{StaticResource PanelSectionLabel}"
					Text="{Binding DetailGroupName, StringFormat='권한 — {0}'}" />
			</DockPanel>
			<DataGrid
				Grid.Row="1"
				AutoGenerateColumns="False"
				Background="Transparent"
				CanUserAddRows="False"
				CellStyle="{StaticResource ModernDataGridCell}"
				ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
				IsReadOnly="True"
				ItemsSource="{Binding Modules}"
				RowHeight="40"
				RowStyle="{StaticResource ModernDataGridRow}"
				Style="{StaticResource ModernDataGrid}">
				<DataGrid.Columns>
					<DataGridTextColumn Width="220" Binding="{Binding ModuleDisplay}" Header="모듈" />
					<DataGridTemplateColumn Width="90" Header="조회">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									HorizontalAlignment="Center"
									Focusable="False"
									IsChecked="{Binding View, Mode=OneWay}"
									IsEnabled="{Binding ViewEnabled}"
									IsHitTestVisible="False" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Width="90" Header="편집">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									HorizontalAlignment="Center"
									Focusable="False"
									IsChecked="{Binding Edit, Mode=OneWay}"
									IsEnabled="{Binding EditEnabled}"
									IsHitTestVisible="False" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Width="90" Header="삭제">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									HorizontalAlignment="Center"
									Focusable="False"
									IsChecked="{Binding Delete, Mode=OneWay}"
									IsEnabled="{Binding DeleteEnabled}"
									IsHitTestVisible="False" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTemplateColumn Width="90" Header="제어">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									HorizontalAlignment="Center"
									Focusable="False"
									IsChecked="{Binding Control, Mode=OneWay}"
									IsEnabled="{Binding ControlEnabled}"
									IsHitTestVisible="False" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
					<DataGridTextColumn Width="*" Header="" />
				</DataGrid.Columns>
			</DataGrid>
			<DockPanel Grid.Row="2" Margin="0,8,0,0">
				<Button
					Width="110"
					DockPanel.Dock="Right"
					Content="저장 🔒"
					IsEnabled="False"
					Style="{StaticResource ModernSecondaryButton}"
					ToolTip="서버 v5.0 권한수정 API 후 활성화" />
				<TextBlock
					VerticalAlignment="Center"
					Style="{StaticResource PanelFieldLabel}"
					Text="※ 비활성(흐림) 칸은 해당 모듈에 그 동작이 없음. 조회 전용 — 편집저장은 서버 v5.0 후속." />
			</DockPanel>
		</Grid>
	</Grid>
</UserControl>
