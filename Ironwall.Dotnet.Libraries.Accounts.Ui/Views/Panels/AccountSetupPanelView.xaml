<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.AccountSetupPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignHeight="560"
	d:DesignWidth="700"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
	</UserControl.Resources>

	<!--  세션 정책 — GET/PUT /settings/session. 폼(스크롤) ↔ 액션바(하단 고정) 분리: 필드 6→11개로 늘어 버튼이 스크롤에 묻히지 않게 Grid Row0=* ScrollViewer / Row1=Auto 액션바.  -->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ── 폼(스크롤) ──  -->
		<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="24,20,24,16">

				<!--  헤더  -->
				<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
					<md:PackIcon
						Width="22"
						Height="22"
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Kind="ShieldLockOutline" />
					<TextBlock
						FontSize="18"
						FontWeight="Bold"
						Text="세션 정책" />
				</StackPanel>
				<TextBlock
					Margin="0,0,0,16"
					FontSize="12"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="바꾼 값은 다음 로그인부터 적용됩니다." />

				<!--  상태 배너(미배포/미가용)  -->
				<Border
					Margin="0,0,0,16"
					Padding="10,8"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource StatusCriticalBrush}"
					BorderThickness="1"
					CornerRadius="4">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasServerStatus}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<TextBlock
						Foreground="{DynamicResource StatusCriticalBrush}"
						Text="{Binding ServerStatus}"
						TextWrapping="Wrap" />
				</Border>

				<!--  기본 세션·잠금 (기존)  -->
				<Grid IsEnabled="{Binding ServerSettingsAvailable}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="220" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="로그인 유지 시간 — 시간 (1~168)" />
					<TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBoxInput}" Text="{Binding TimeoutHours, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="자동 재로그인 허용 기간 — 일 (1~90)" />
					<TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBoxInput}" Text="{Binding RefreshDays, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="잠금까지 비밀번호 오류 횟수 (0=잠그지 않음, 3~20)" />
					<TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="Console.Accounts.SessionSetup.LockoutThreshold" Style="{StaticResource TextBoxInput}" Text="{Binding LockoutThreshold, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="잠금 자동 해제 — 분 (0=직접 풀 때까지, 1~1440)" />
					<TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource TextBoxInput}" Text="{Binding LockoutDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="로그인 유지 시간 적용" />
					<ToggleButton Grid.Row="8" Grid.Column="1" HorizontalAlignment="Left" IsChecked="{Binding SessionPolicyEnabled}" Style="{StaticResource Console.ToggleSwitch}" />
				</Grid>

				<!--  동시 세션 정책 (v6.3 신규)  -->
				<TextBlock
					Margin="0,22,0,10"
					FontSize="13"
					FontWeight="Bold"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="동시 로그인" />
				<Separator Margin="0,0,0,10" Background="{DynamicResource DividerBrush}" />

									<Grid IsEnabled="{Binding ServerSettingsAvailable}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="220" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  ① 동시 세션 정책  -->
					<TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
						Text="같은 계정의 동시 로그인"
						ToolTip="여러 곳 동시 로그인을 허용하면 같은 계정이 여러 곳에서 로그인해 있어도 서로 끊기지 않습니다. 다음 로그인부터 적용됩니다." />
					<ComboBox Grid.Row="0" Grid.Column="1"
						SelectedValuePath="Tag"
						SelectedValue="{Binding ConcurrencyPolicy, Mode=TwoWay}">
						<!--  서버 기본값이 allow(다중 공존)라 첫 항목도 allow — 목록 순서가 기본값을 오인시키지 않게 한다. 저장 값은 Tag, 글은 운영자 말(A-40).  -->
						<ComboBoxItem Content="여러 곳 동시 로그인 허용" Tag="allow" />
						<ComboBoxItem Content="새 로그인 시 기존 로그인 종료" Tag="evict_all" />
					</ComboBox>

					<!--  ② 최대 동시 세션 수 — allow일 때만 활성  -->
					<TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
						IsEnabled="{Binding IsAllowPolicy}"
													Text="최대 동시 로그인 수 (0=제한 없음, 0~100)"
							ToolTip="여러 곳 동시 로그인을 허용할 때만 적용됩니다. 이 수를 넘으면 가장 오래된 로그인부터 끊습니다." />
					<TextBox Grid.Row="2" Grid.Column="1"
						IsEnabled="{Binding IsAllowPolicy}"
						Style="{StaticResource TextBoxInput}"
						Text="{Binding MaxConcurrentSessions, UpdateSourceTrigger=PropertyChanged}" />

					<!--  ③ 자기 세션 교체 허용 — allow일 때만 활성  -->
					<TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
						IsEnabled="{Binding IsAllowPolicy}"
													Text="같은 프로그램에서 다시 로그인하면 이전 로그인 교체"
							TextWrapping="Wrap"
							ToolTip="같은 프로그램에서 다시 로그인하면 그 프로그램의 이전 로그인만 끊습니다. 여러 곳 동시 로그인을 허용할 때만 적용됩니다." />
					<ToggleButton Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
						IsEnabled="{Binding IsAllowPolicy}"
						IsChecked="{Binding SessionSelfReplaceEnabled}"
						Style="{StaticResource Console.ToggleSwitch}" />

					<!--  ④ 세션 이력 보존 — 일  -->
					<TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
													Text="로그인 기록 보존 — 일 (0=지우지 않음, 0~3650)"
							ToolTip="0이면 지우지 않습니다. 그보다 크면 로그아웃 · 만료된 오래된 기록을 정해진 날수가 지난 뒤 지웁니다." />
					<TextBox Grid.Row="6" Grid.Column="1"
						Style="{StaticResource TextBoxInput}"
						Text="{Binding SessionHistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" />

					<!--
						⑤ 로그인 이상탐지 이벤트 — 서버 기능이 아직 없어(켜도 동작 없음) 숨겼다(A-42). 값은 VM 이 불러온 그대로 되돌려 보낸다.
						인증 모드(읽기 전용 배포 설정) 줄도 운영자가 쓸 데가 없어 뺐다(A-43).
					-->
				</Grid>

			</StackPanel>
		</ScrollViewer>

		<!--  ── 하단 고정 액션바(스크롤 밖) ──  -->
		<!--
			바뀐 것이 있을 때만 켜지는 저장 막대(T2) — 왼쪽에 "변경 N건", 오른쪽에 [되돌리기][저장](A-45). 콘솔 안에서는 [새로고침] 을 접는다(툴바 [갱신], A-46).
			V-35 — 콘솔 상세 칸의 바닥 막대와 같은 규격으로 맞춘다: 위아래 여백 10 · 단추 32(고정 폭 없음) · 오른쪽 끝에 보조 → 주 동작.
			종전엔 폭 120 의 [저장] 만 홀로 서 있어 잘못 바꾼 값을 되돌릴 길이 툴바 [갱신] 뿐이었다.
			[되돌리기] 는 x:Name 을 새로 쓰지 않고 cal:Message.Attach 로 잇는다(CanClickRevert 가드가 그대로 붙는다).
		-->
		<Border
			Grid.Row="1"
			Padding="24,10,16,10"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0">
			<DockPanel LastChildFill="True">
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button
						x:Name="ClickReload"
						Margin="0,0,8,0"
						Content="새로고침"
						Style="{StaticResource Console.Button.Ghost}"
						Visibility="{Binding ShowReloadButton, Converter={StaticResource BoolToVisibility}}" />
					<Button
						Margin="0,0,8,0"
						cal:Message.Attach="ClickRevert"
						AutomationProperties.AutomationId="Console.Accounts.SessionSetup.Revert"
						Content="되돌리기"
						Style="{StaticResource Console.Button}"
						ToolTip="바꾼 칸을 마지막으로 불러온 값으로 되돌립니다" />
					<Button
						x:Name="ClickSave"
						AutomationProperties.AutomationId="Console.Accounts.SessionSetup.Save"
						Content="저장"
						Style="{StaticResource Console.Button.Primary}" />
				</StackPanel>
				<TextBlock
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Console.Accounts.SessionSetup.Changes"
					FontSize="12"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding ChangeSummaryText}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
