<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.AccountSetupPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignHeight="500"
	d:DesignWidth="700"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<!--  세션 정책 — 전부 서버 세션 정책(GET/PUT /settings/session)을 불러와 설정·저장. 단일 일관 폼.  -->
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="24,20,24,20">

			<!--  헤더  -->
			<StackPanel Margin="0,0,0,4" Orientation="Horizontal">
				<md:PackIcon
					Width="22"
					Height="22"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Kind="ShieldLockOutline" />
				<TextBlock
					FontSize="18"
					FontWeight="Bold"
					Text="세션 정책" />
			</StackPanel>
			<TextBlock
				Margin="0,0,0,16"
				FontSize="12"
				Foreground="{DynamicResource TextSecondaryBrush}"
				Text="서버가 발급하는 세션/토큰 정책. 변경은 신규 발급 토큰부터 적용됩니다." />

			<!--  상태 배너(미배포/미가용) — 자체완결 DataTrigger(외부 컨버터 비의존)  -->
			<Border
				Margin="0,0,0,16"
				Padding="10,8"
				Background="{DynamicResource SurfaceBrush}"
				BorderBrush="{DynamicResource StatusCriticalBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<Border.Style>
					<Style TargetType="Border">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding HasServerStatus}" Value="True">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<TextBlock
					Foreground="{DynamicResource StatusCriticalBrush}"
					Text="{Binding ServerStatus}"
					TextWrapping="Wrap" />
			</Border>

			<!--  편집 폼 — 서버 가용 시에만 활성  -->
			<Grid IsEnabled="{Binding ServerSettingsAvailable}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="150" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="12" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="세션(액세스 토큰) 만료 — 시간 (1~168)" />
				<TextBox
					Grid.Row="0"
					Grid.Column="1"
					Style="{StaticResource TextBoxInput}"
					Text="{Binding TimeoutHours, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="Refresh 유효기간 — 일 (1~90)" />
				<TextBox
					Grid.Row="2"
					Grid.Column="1"
					Style="{StaticResource TextBoxInput}"
					Text="{Binding RefreshDays, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="4"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="로그인 잠금 임계 — 횟수 (0=비활성, 3~20)" />
				<TextBox
					Grid.Row="4"
					Grid.Column="1"
					Style="{StaticResource TextBoxInput}"
					Text="{Binding LockoutThreshold, UpdateSourceTrigger=PropertyChanged}" />

					<TextBlock
						Grid.Row="6"
						Grid.Column="0"
						VerticalAlignment="Center"
						Text="잠금 자동해제 — 분 (0=영구, 1~1440)" />
					<TextBox
						Grid.Row="6"
						Grid.Column="1"
						Style="{StaticResource TextBoxInput}"
						Text="{Binding LockoutDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="8"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="세션 만료 사용" />
				<ToggleButton
					Grid.Row="8"
					Grid.Column="1"
					HorizontalAlignment="Left"
					IsChecked="{Binding SessionPolicyEnabled}"
					Style="{StaticResource MaterialDesignSwitchToggleButton}" />
			</Grid>

			<!--  읽기전용(배포/.env 전용)  -->
			<Border
				Margin="0,18,0,0"
				Padding="10,8"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<StackPanel Orientation="Horizontal">
					<TextBlock VerticalAlignment="Center" Text="인증 모드 (읽기전용, 배포 설정): " />
					<TextBlock
						VerticalAlignment="Center"
						FontWeight="Bold"
						Text="{Binding AuthMode}" />
				</StackPanel>
			</Border>

			<!--  액션  -->
			<StackPanel
				Margin="0,20,0,0"
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					x:Name="ClickReload"
					Width="100"
					Margin="0,0,8,0"
					Content="새로고침"
					Style="{StaticResource MaterialDesignFlatButton}" />
				<Button
					x:Name="ClickSave"
					Width="120"
					Content="저장"
					Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
			</StackPanel>

		</StackPanel>
	</ScrollViewer>
</UserControl>
