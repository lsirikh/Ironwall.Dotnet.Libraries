<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.AuditLogPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<Grid Margin="6">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
			<TextBlock
				VerticalAlignment="Center"
				DockPanel.Dock="Left"
				FontSize="15"
				FontWeight="SemiBold"
				Text="감사 로그" />
			<Button
				DockPanel.Dock="Right"
				Padding="6,2"
				Background="Transparent"
				BorderThickness="0"
				ToolTip="갱신">
				<cal:Message.Attach>[Event Click] = [Action OnClickReloadButton()]</cal:Message.Attach>
				<md:PackIcon Width="22" Height="22" Kind="Refresh" />
			</Button>
		</DockPanel>
		<DataGrid
			Grid.Row="1"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			IsReadOnly="True"
			ItemsSource="{Binding Items}">
			<DataGrid.Columns>
				<DataGridTextColumn Width="150" Binding="{Binding CreatedAt}" Header="시각" />
				<DataGridTextColumn Width="120" Binding="{Binding ActionType}" Header="동작" />
				<DataGridTextColumn Width="70" Binding="{Binding ActionStatus}" Header="상태" />
				<DataGridTextColumn Width="110" Binding="{Binding ResourceType}" Header="대상" />
				<DataGridTextColumn Width="140" Binding="{Binding ResourceName}" Header="대상명" />
				<DataGridTextColumn Width="110" Binding="{Binding ActorLoginId}" Header="행위자" />
				<DataGridTextColumn Width="110" Binding="{Binding IpAddress}" Header="IP" />
				<DataGridTextColumn Width="*" Binding="{Binding Description}" Header="설명" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
