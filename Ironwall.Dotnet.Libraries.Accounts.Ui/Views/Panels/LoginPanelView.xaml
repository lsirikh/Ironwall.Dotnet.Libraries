<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.LoginPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:Background="#88000000"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="LoginPanel">
		<md:Card x:Name="CardContents">
			<!--  애니메이션 트리거  -->
			<md:Card.Style>
				<Style BasedOn="{StaticResource MaterialDesignElevatedCard}" TargetType="md:Card">
					<!--  기본 BorderBrush 설정  -->
					<Setter Property="Width" Value="400" />
					<Setter Property="Height" Value="400" />
					<Setter Property="Padding" Value="20" />
					<Setter Property="Opacity" Value="0.9" />
					<Setter Property="UniformCornerRadius" Value="15" />
					<Style.Triggers>

						<DataTrigger Binding="{Binding IsLoginFailed}" Value="True">
							<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter Property="BorderThickness" Value="3" />
							<Setter Property="Width" Value="406" />
							<Setter Property="Height" Value="406" />
							<Setter Property="UniformCornerRadius" Value="15" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</md:Card.Style>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="1*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="2.5*" />
					<RowDefinition Height="1*" />
					<RowDefinition Height="1.2*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  Login 제목 세팅  -->
				<StackPanel Grid.Row="0" Orientation="Vertical">
					<StackPanel Orientation="Horizontal">
						<md:PackIcon Kind="AccountKey" Style="{StaticResource DialogTitleIcon}" />
						<TextBlock Style="{StaticResource DialogTitle}" Text="Login" />
					</StackPanel>
				</StackPanel>
				<Separator
					Grid.Row="1"
					Margin="0,10"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<Grid Grid.Row="2" VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Style="{StaticResource TextBlockTitle}"
						Text="아이디(ID)" />
					<TextBox
						x:Name="TextBoxID"
						Grid.Column="2"
						Style="{StaticResource TextBoxInput}"
						Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
						<i:Interaction.Behaviors>
							<behavior:TextBoxFocusAndCaretBehavior />
						</i:Interaction.Behaviors>
					</TextBox>
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Style="{StaticResource TextBlockTitle}"
						Text="비밀번호(PW)" />
					<PasswordBox
						x:Name="TextBoxPW"
						Grid.Row="2"
						Grid.Column="2"
						PasswordChar="*"
						Style="{StaticResource PasswordBoxInput}">
						<i:Interaction.Behaviors>
							<behavior:PasswordBehavior Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</i:Interaction.Behaviors>
					</PasswordBox>

				</Grid>
				<Grid Grid.Row="3">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Style="{StaticResource TextBlockTitle}"
						Text="아이디를 저장하시겠습니까?" />
					<CheckBox
						Grid.Column="2"
						Margin="10,0"
						HorizontalAlignment="Right"
						IsChecked="{Binding IsUsernameSaved, Mode=TwoWay}" />
				</Grid>


				<Grid
					Grid.Row="4"
					Margin="0,5"
					VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="ClickOk"
						Grid.Column="0"
						Margin="5,0"
						VerticalAlignment="Center"
						IsDefault="True"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
								<TextBlock
									Width="50"
									Style="{StaticResource ButtonTextBlock}"
									Text="확인"
									TextAlignment="Center" />
							</StackPanel>
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickCancel"
						Grid.Column="1"
						Margin="5,0"
						VerticalAlignment="Center"
						IsDefault="True"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Cancel" Style="{StaticResource ButtonIcon}" />
								<TextBlock
									Width="50"
									Style="{StaticResource ButtonTextBlock}"
									Text="취소"
									TextAlignment="Center" />
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>

				<Separator
					Grid.Row="5"
					Margin="0,5"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<Grid Grid.Row="6" Margin="0,5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="7*" />
						<ColumnDefinition Width="5.5*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						VerticalAlignment="Center"
						Style="{StaticResource MaterialDesignBody2TextBlock}"
						Text="※ 회원가입이 필요하시면..." />
					<Button
						x:Name="ClickRegister"
						Grid.Column="1"
						VerticalAlignment="Center"
						md:RippleAssist.IsCentered="True"
						Style="{StaticResource MaterialDesignFlatButton}"
						ToolTip="가입하기">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Register" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="Register" />
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>
				<!--  Result TextBlock with conditional coloring  -->
				<StackPanel Grid.Row="7" VerticalAlignment="Bottom">
					<TextBlock Text="{Binding Result}">
						<TextBlock.Style>
							<Style BasedOn="{StaticResource MaterialDesignBody2TextBlock}" TargetType="TextBlock">
								<Setter Property="Foreground" Value="Black" />
								<Setter Property="FontWeight" Value="Bold" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsLoginSuccess}" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource StatusNormalBrush}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsLoginFailed}" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>
			</Grid>

		</md:Card>
	</md:DialogHost>
</UserControl>
