<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.LoginPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:Background="#88000000"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<md:DialogHost
		x:Name="DialogHost"
		DialogTheme="Inherit"
		Identifier="LoginPanel">
		<md:Card x:Name="CardContents">
			<!--  애니메이션 트리거  -->
			<md:Card.Style>
				<Style BasedOn="{StaticResource MaterialDesignElevatedCard}" TargetType="md:Card">
					<!--  기본 BorderBrush 설정  -->
					<Setter Property="Width" Value="400" />
					<Setter Property="Height" Value="300" />
					<Setter Property="Padding" Value="20" />
					<Setter Property="Opacity" Value="1" />
					<Setter Property="UniformCornerRadius" Value="8" />
					<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
					<Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
					<Setter Property="md:ThemeAssist.Theme" Value="Dark" />
					<Style.Triggers>

						<DataTrigger Binding="{Binding IsLoginFailed}" Value="True">
							<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter Property="BorderThickness" Value="3" />
							<Setter Property="Height" Value="356" />
							<Setter Property="Width" Value="406" />
							<Setter Property="UniformCornerRadius" Value="8" />
						</DataTrigger>
						<DataTrigger Binding="{Binding IsLoginSuccess}" Value="True">
							<Setter Property="BorderBrush" Value="{DynamicResource StatusNormalBrush}" />
							<Setter Property="BorderThickness" Value="3" />
							<Setter Property="Height" Value="356" />
							<Setter Property="Width" Value="406" />
							<Setter Property="UniformCornerRadius" Value="8" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</md:Card.Style>

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  시안 헤더 바 (LayerPanel 표준 패턴, 네거티브 마진으로 카드 가장자리까지)  -->
				<Border
					Grid.Row="0"
					Margin="-20,-20,-20,14"
					Style="{StaticResource ModernDialogHeader}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<md:PackIcon
							Width="20"
							Height="20"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource OnPrimaryFixedBrush}"
							Kind="AccountKey" />
						<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="Login" />
					</StackPanel>
				</Border>

				<Grid Grid.Row="1" VerticalAlignment="Center">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="10" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Style="{StaticResource TextBlockTitle}"
						Text="아이디(ID)" />
					<TextBox
						x:Name="TextBoxID"
						Grid.Column="2"
						Style="{StaticResource TextBoxInput}"
						Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
						<i:Interaction.Behaviors>
							<behavior:TextBoxFocusAndCaretBehavior />
						</i:Interaction.Behaviors>
					</TextBox>
					<TextBlock
						Grid.Row="2"
						Grid.Column="0"
						Style="{StaticResource TextBlockTitle}"
						Text="비밀번호(PW)" />
					<Grid Grid.Row="2" Grid.Column="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<!--  마스킹 PW (눈 버튼 누르는 동안 숨김)  -->
						<PasswordBox
							x:Name="TextBoxPW"
							Grid.Column="0"
							PasswordChar="*">
							<PasswordBox.Style>
								<Style BasedOn="{StaticResource PasswordBoxInput}" TargetType="PasswordBox">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsPressed, ElementName=EyePeek}" Value="True">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</PasswordBox.Style>
							<i:Interaction.Behaviors>
								<behavior:PasswordBehavior Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</i:Interaction.Behaviors>
						</PasswordBox>
						<!--  평문 PW (눈 버튼 누르는 동안만 표시, 읽기전용)  -->
						<TextBox
							Grid.Column="0"
							IsReadOnly="True"
							Text="{Binding Password, Mode=OneWay}">
							<TextBox.Style>
								<Style BasedOn="{StaticResource TextBoxInput}" TargetType="TextBox">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsPressed, ElementName=EyePeek}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBox.Style>
						</TextBox>
						<!--  눈알 아이콘 — 누르고 있는 동안 평문 표시(hold-to-reveal)  -->
						<Button
							x:Name="EyePeek"
							Grid.Column="1"
							Width="32"
							Margin="4,0,0,0"
							Padding="0"
							Background="Transparent"
							BorderThickness="0"
							Focusable="False"
							Style="{StaticResource MaterialDesignFlatButton}"
							ToolTip="누르고 있는 동안 비밀번호 표시">
							<md:PackIcon
								Width="20"
								Height="20"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Kind="EyeOutline" />
						</Button>
					</Grid>

				</Grid>
				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Style="{StaticResource TextBlockTitle}"
						Text="아이디를 저장하시겠습니까?" />
					<CheckBox
						Grid.Column="2"
						Margin="10,0"
						HorizontalAlignment="Right"
						IsChecked="{Binding IsUsernameSaved, Mode=TwoWay}" />
				</Grid>


				<Grid
					Grid.Row="3"
					Margin="0,5"
					VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition />
					</Grid.ColumnDefinitions>
					<Button
						x:Name="ClickOk"
						Grid.Column="0"
						Margin="5,0"
						VerticalAlignment="Center"
						IsDefault="True"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
								<TextBlock
									Width="50"
									Style="{StaticResource ButtonTextBlock}"
									Text="확인"
									TextAlignment="Center" />
							</StackPanel>
						</Button.Content>
					</Button>
					<Button
						x:Name="ClickCancel"
						Grid.Column="1"
						Margin="5,0"
						VerticalAlignment="Center"
						IsDefault="True"
						Style="{StaticResource MaterialDesignFlatDarkBgButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Cancel" Style="{StaticResource ButtonIcon}" />
								<TextBlock
									Width="50"
									Style="{StaticResource ButtonTextBlock}"
									Text="취소"
									TextAlignment="Center" />
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>

				<Separator
					Grid.Row="4"
					Margin="0,5"
					Background="{DynamicResource DividerBrush}"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<Grid Grid.Row="5" Margin="0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="7*" />
						<ColumnDefinition Width="5.5*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						VerticalAlignment="Center"
						Style="{StaticResource MaterialDesignBody2TextBlock}"
						Text="※ 회원가입이 필요하시면..." />
					<Button
						x:Name="ClickRegister"
						Grid.Column="1"
						VerticalAlignment="Center"
						md:RippleAssist.IsCentered="True"
						Style="{StaticResource MaterialDesignFlatButton}"
						ToolTip="가입하기">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Register" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="Register" />
							</StackPanel>
						</Button.Content>
					</Button>
				</Grid>
				<!--  Result TextBlock with conditional coloring  -->
				<StackPanel Grid.Row="6" VerticalAlignment="Bottom">
					<TextBlock Text="{Binding Result}">
						<TextBlock.Style>
							<Style BasedOn="{StaticResource MaterialDesignBody2TextBlock}" TargetType="TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
								<Setter Property="FontWeight" Value="Bold" />
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsLoginSuccess}" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource StatusNormalBrush}" />
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding IsLoginFailed}" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>
			</Grid>

		</md:Card>
	</md:DialogHost>
</UserControl>
