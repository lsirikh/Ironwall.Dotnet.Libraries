<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.UserSessionPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:DesignHeight="450"
	d:DesignWidth="900"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<UserControl.Resources>
		<!--  ISO(+09:00) string? → "yyyy-MM-dd HH:mm" 표시(파싱 실패 시 원문 폴백). 색 무관.  -->
		<utils:IsoDateStringConverter x:Key="IsoDateStringConverter" />
	</UserControl.Resources>
	<!--  탭 콘텐츠 — 색은 100% DynamicResource 토큰. (세션 정책 영역은 EXT-10에서 상단 추가 예정)  -->
	<Grid Margin="6">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
			<TextBlock
				DockPanel.Dock="Left"
				VerticalAlignment="Center"
				Style="{StaticResource PanelSectionLabel}"
				Text="접속 세션 모니터" />

			<!--  갱신 (우측 끝)  -->
			<Button DockPanel.Dock="Right" Style="{StaticResource ModernToolbarButton}" ToolTip="갱신">
				<cal:Message.Attach>[Event Click] = [Action OnClickReloadButton()]</cal:Message.Attach>
				<md:PackIcon Width="20" Height="20" Kind="Refresh" />
			</Button>

			<!--  활성만 필터 (우측)  -->
			<CheckBox
				DockPanel.Dock="Right"
				Margin="0,0,12,0"
				VerticalAlignment="Center"
				Content="활성만"
				Foreground="{DynamicResource MaterialDesignBody}"
				IsChecked="{Binding IsActiveOnly, Mode=TwoWay}" />

			<!--  로드/전체 건수 (우측)  -->
			<TextBlock
				DockPanel.Dock="Right"
				Margin="0,0,12,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource MaterialDesignBodyLight}"
				Text="{Binding LoadedCountText}" />
		</DockPanel>
		<DataGrid
			Grid.Row="1"
			RowHeight="38"
			AutoGenerateColumns="False"
			Background="Transparent"
			CanUserAddRows="False"
			CellStyle="{StaticResource ModernDataGridCell}"
			ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
			IsReadOnly="True"
			ItemsSource="{Binding Items}"
			RowStyle="{StaticResource ModernDataGridRow}"
			Style="{StaticResource ModernDataGrid}">
			<i:Interaction.Behaviors>
				<behavior:DataGridScrollEndBehavior Command="{Binding LoadMoreCommand}" Threshold="50" />
			</i:Interaction.Behaviors>
			<DataGrid.Columns>
				<DataGridTextColumn Width="130" Binding="{Binding LoginId}" Header="사용자" />
				<DataGridTextColumn Width="90" Binding="{Binding Role}" Header="역할" />
				<DataGridTextColumn Width="130" Binding="{Binding IpAddress}" Header="IP" />
				<DataGridCheckBoxColumn Width="60" Binding="{Binding IsActive}" Header="활성" />
				<DataGridTextColumn Width="140" Binding="{Binding ExpiresAt, Converter={StaticResource IsoDateStringConverter}}" Header="만료" />
				<DataGridTextColumn Width="140" Binding="{Binding LoggedOutAt, Converter={StaticResource IsoDateStringConverter}}" Header="로그아웃" />
				<DataGridTextColumn Width="130" Binding="{Binding LogoutReason}" Header="사유" />
				<DataGridTextColumn Width="140" Binding="{Binding CreatedAt, Converter={StaticResource IsoDateStringConverter}}" Header="로그인시각" />
				<DataGridTemplateColumn Width="120" Header="관리">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
								<!--  이 세션만 강제 로그아웃  -->
								<Button
									VerticalAlignment="Center"
									IsEnabled="{Binding IsActive}"
									Style="{StaticResource ModernToolbarButton}"
									ToolTip="이 세션 강제 로그아웃">
									<cal:Message.Attach>[Event Click] = [Action OnClickForceLogout($dataContext)]</cal:Message.Attach>
									<md:PackIcon Width="20" Height="20" Kind="LogoutVariant" />
								</Button>
								<!--  이 사용자의 활성 세션 전체 종료(DELETE /user-sessions/user/{id})  -->
								<Button
									VerticalAlignment="Center"
									IsEnabled="{Binding IsActive}"
									Style="{StaticResource ModernToolbarButton}"
									ToolTip="이 사용자 전체 세션 종료">
									<cal:Message.Attach>[Event Click] = [Action OnClickForceLogoutAllUserSessions($dataContext)]</cal:Message.Attach>
									<md:PackIcon Width="20" Height="20" Kind="AccountMultipleRemove" />
								</Button>
							</StackPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
