<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Accounts.Ui.Views.Panels.UserSessionPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<Grid Margin="6">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
			<TextBlock
				VerticalAlignment="Center"
				DockPanel.Dock="Left"
				FontSize="15"
				FontWeight="SemiBold"
				Text="접속 세션 모니터" />
			<Button
				DockPanel.Dock="Right"
				Padding="6,2"
				Background="Transparent"
				BorderThickness="0"
				ToolTip="갱신">
				<cal:Message.Attach>[Event Click] = [Action OnClickReloadButton()]</cal:Message.Attach>
				<md:PackIcon Width="22" Height="22" Kind="Refresh" />
			</Button>
		</DockPanel>
		<DataGrid
			Grid.Row="1"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			IsReadOnly="True"
			ItemsSource="{Binding Items}">
			<DataGrid.Columns>
				<DataGridTextColumn Width="120" Binding="{Binding LoginId}" Header="사용자" />
				<DataGridTextColumn Width="90" Binding="{Binding Role}" Header="역할" />
				<DataGridTextColumn Width="120" Binding="{Binding IpAddress}" Header="IP" />
				<DataGridCheckBoxColumn Width="60" Binding="{Binding IsActive}" Header="활성" />
				<DataGridTextColumn Width="150" Binding="{Binding ExpiresAt}" Header="만료" />
				<DataGridTextColumn Width="150" Binding="{Binding LoggedOutAt}" Header="로그아웃" />
				<DataGridTextColumn Width="120" Binding="{Binding LogoutReason}" Header="사유" />
				<DataGridTextColumn Width="*" Binding="{Binding CreatedAt}" Header="로그인시각" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
