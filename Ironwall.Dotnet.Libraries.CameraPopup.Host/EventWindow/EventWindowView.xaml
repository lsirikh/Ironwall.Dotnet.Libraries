<Window
    x:Class="Ironwall.Dotnet.Libraries.CameraPopup.Host.EventWindow.EventWindowView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.CameraPopup.Host.EventWindow"
    Title="{Binding WindowTitle}"
    WindowStyle="None"
    ResizeMode="CanResize"
    ShowActivated="False"
    ShowInTaskbar="True"
    MinWidth="320"
    MinHeight="200"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    FontFamily="{DynamicResource UiFont}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    Background="{DynamicResource BgBrush}"
    AutomationProperties.AutomationId="{Binding AutomationId}">

    <!--
        이벤트 창 한 장(T-05, 스토리보드 §3). 머리(끌어서 창 이동) · 타일 격자 · 꼬리.
        탐지 = 빨간 2px 테두리 + "탐지" 배지 / 장애 = 주황 1px 테두리 + "장애" 배지 — 배지 글자로도 구분(색만 아님).
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDetection}" Value="True">
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <!-- ══ 머리 ══ -->
            <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,3,4,3"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                    AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Header}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Badge" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource CameraPopup.OnWarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetection}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource CameraPopup.OnCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold"
                                   AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Badge}" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding HeaderText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.HeaderText}" />
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                               AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Time}" />
                    <TextBlock Grid.Column="3" Text="{Binding CameraCountText}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,8,0"
                               AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.CameraCount}" />
                    <ToggleButton Grid.Column="4" Style="{StaticResource CameraPopup.PinToggle}" IsChecked="{Binding IsPinned, Mode=TwoWay}"
                                  ToolTip="고정 — 자동으로 닫지 않고 오래된 창 정리에서도 빠진다"
                                  AutomationProperties.Name="고정"
                                  AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.PinButton}" />
                    <Button Grid.Column="5" Style="{StaticResource CameraPopup.HeaderButton}" Content="✕" Margin="4,0,0,0"
                            ToolTip="닫기" Click="OnCloseClick"
                            AutomationProperties.Name="닫기"
                            AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.CloseButton}" />
                </Grid>
            </Border>

            <!-- ══ 꼬리 ══ -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0" Padding="10,3"
                    AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Footer}">
                <DockPanel TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ExtraText}" Margin="12,0,0,0"
                               AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Footer.Extra}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CloseConditionsText}"
                                   AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Footer.Conditions}" />
                        <TextBlock Text="{Binding TimerText}" Margin="14,0,0,0" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Footer.Timer}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══ 타일 격자 + 끌기 겹 ══ -->
            <Grid x:Name="TilesHost" Background="{DynamicResource BorderBrush}">
                <ItemsControl x:Name="TilesItems" ItemsSource="{Binding Tiles}" Focusable="False" Margin="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:TileView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 끌기 겹: 삽입 위치(세로 막대) · 고스트(테두리 + 그림자). 컨테이너에 값을 쓰지 않는다. -->
                <Canvas x:Name="DragLayer" IsHitTestVisible="False">
                    <Rectangle x:Name="InsertBar" Width="4" Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Border x:Name="Ghost" BorderThickness="2" BorderBrush="{DynamicResource PrimaryBrush}"
                            Background="{DynamicResource SurfaceTranslucentBrush}" CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="8,4" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" />
                        </Border.Effect>
                        <TextBlock x:Name="GhostText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                </Canvas>
            </Grid>
        </DockPanel>
    </Border>
</Window>
