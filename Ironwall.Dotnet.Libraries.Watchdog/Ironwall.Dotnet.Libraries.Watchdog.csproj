<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <AssemblyName>Ironwall.Dotnet.Libraries.Watchdog</AssemblyName>
    <RootNamespace>Ironwall.Dotnet.Libraries.Watchdog</RootNamespace>
    <Version>1.0</Version>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ironwall.Dotnet.Libraries.Watchdog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 공유 계약: Base의 순수 소스를 링크 컴파일(DLL 미참조 — 감시대상과 코드 격리) -->
    <Compile Include="..\Ironwall.Dotnet.Libraries.Base\Services\Startup\WatchdogState.cs" Link="Contract\WatchdogState.cs" />
    <Compile Include="..\Ironwall.Dotnet.Libraries.Base\Services\Startup\WatchdogStatus.cs" Link="Contract\WatchdogStatus.cs" />
    <Compile Include="..\Ironwall.Dotnet.Libraries.Base\Services\Startup\WatchdogNaming.cs" Link="Contract\WatchdogNaming.cs" />
    <Compile Include="..\Ironwall.Dotnet.Libraries.Base\Services\Startup\WatchdogHeartbeat.cs" Link="Contract\WatchdogHeartbeat.cs" />
    <Compile Include="..\Ironwall.Dotnet.Libraries.Base\Services\IClock.cs" Link="Contract\IClock.cs" />
    <Compile Include="..\Ironwall.Dotnet.Libraries.Base\Services\SystemClock.cs" Link="Contract\SystemClock.cs" />
  </ItemGroup>

</Project>
