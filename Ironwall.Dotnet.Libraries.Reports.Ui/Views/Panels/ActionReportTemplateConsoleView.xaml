<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ActionReportTemplateConsoleView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:vm="clr-namespace:Ironwall.Dotnet.Libraries.Reports.Ui.ViewModels.Panels"
	AutomationProperties.AutomationId="Reports.ActionReportTemplate.Console.Root"
	AutomationProperties.Name="조치보고 문구 관리"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		조치보고 문구 관리 콘솔 — 목록(드래그 재정렬) + 상세(등록 · 수정). 커널만 쓴다: ConsoleShell · ConsoleRail ·
		ConsoleToolbar · ConsoleDetailHost(여섯 상태 · 고정 적용 막대) · 드래그 behaviors(CaptureDragBehavior ·
		ReorderKeyboardBehavior · DropZone · DragHandle). 정본 참조: Reports.Ui/Views/Panels/ReportTemplateDetailView.xaml
		(드래그 재사용의 실제 레퍼런스) · docs/design/action-report-custom-template-wireframe.html §3(치수 근거,
		840×640 바운드 박스 — 순서 변경만 ▲▼ 대신 드래그로 갱신, 2026-09-06 전사 방침).
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationId 만.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<local:BoolInverseConverter x:Key="BoolInverse" />
		<local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
		<local:RailIconKindConverter x:Key="IconKind" />

		<Style x:Key="Form.TextBox" TargetType="TextBox">
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>

		<!--
			A5 — 줄 안의 [수정] · [삭제] 를 같은 모양(테두리 · 높이 26 · 본문 글꼴)으로 맞춘다. 옛 것은 [수정]이 테두리 없는
			11px 고정폭 글자, [삭제]만 빨간 테두리라 한 줄에 두 모양이 섰다. 위험은 테두리 색(형태)으로만 더 말한다.
		-->
		<Style
			x:Key="Row.Button"
			BasedOn="{StaticResource Console.Button.Mini}"
			TargetType="Button">
			<Setter Property="Height" Value="26" />
			<Setter Property="MinWidth" Value="44" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontFamily" Value="{DynamicResource MaterialDesignFont}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>
		<!--
			V-33 — ▲▼ 도 [순서 되돌리기] 와 같은 까닭으로 늘 테두리를 두른다. 커널 Mini 는 Ghost 바탕이라 켜지면 글자만,
			꺼지면 테두리 · 판이 생겨 "누를 수 있을 때가 덜 단추처럼" 보였다(모양이 거꾸로).
		-->
		<Style
			x:Key="Reorder.Button"
			BasedOn="{StaticResource Console.Button.Mini}"
			TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		<Style
			x:Key="Row.Button.Danger"
			BasedOn="{StaticResource Console.Button.Mini.Danger}"
			TargetType="Button">
			<Setter Property="Height" Value="26" />
			<Setter Property="MinWidth" Value="44" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontFamily" Value="{DynamicResource MaterialDesignFont}" />
		</Style>
	</UserControl.Resources>

	<!--  A10 — 부제 "문구 관리" 를 뺀다. 제목 "조치보고 문구" 뒤에 붙어 "문구" 가 한 줄에 세 번 섰다.  -->
	<c:ConsoleShell
		Title="조치보고 문구"
		ConsoleKey="ActionReportTemplates"
		DetailWidth="360"
		IsDetailRequested="{Binding Detail.IsDetailRequested}">

		<!--
			머리 오른쪽 — 닫기 ✕ 하나(호스트가 이 패널을 모달로 띄운다).
			U-17 — 옛 머리는 "문구 관리 · 닫기" 였다. 바로 왼쪽 부제가 이미 "문구 관리" 라 같은 말이 한 줄에 두 번 섰고,
			닫기만 글자 버튼이라 다른 콘솔과 모양이 달랐다. 자동화용 이름은 뿌리의 AutomationProperties.Name 으로 옮겼다.
			★ 예전에 여기 있던 "문구를 모두 삭제하고 서버를 재기동하면 기본 5건이 복원됩니다" 문구는 제거한 그대로다 —
			  시드 스크립트가 있는 테스트/개발 서버의 동작이지 운용자가 볼 안내가 아니다(코디네이터 확인, 2026-09-24).
		-->
		<c:ConsoleShell.HeaderContent>
			<Button
				AutomationProperties.AutomationId="Reports.ActionReportTemplate.Console.CloseButton"
				AutomationProperties.Name="조치보고 문구 닫기"
				Click="OnClose"
				Style="{StaticResource Console.Button.Close}" />
		</c:ConsoleShell.HeaderContent>

		<!--  레일 — 항목 1개. 다중 모드가 없는 화면에서도 커널 크롬(제목 · 부제)을 일관되게 쓴다.  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.ActionReportTemplates.Rail"
				ConsoleKey="ActionReportTemplates"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Resources>
					<!--  아이콘 토큰 → PackIcon(보고서 콘솔과 같은 방식 — 싱글턴 뷰모델이 시각 요소를 쥐지 않는다).  -->
					<DataTemplate DataType="{x:Type vm:ReportRailIcon}">
						<md:PackIcon
							Width="18"
							Height="18"
							Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
					</DataTemplate>
				</c:ConsoleRail.Resources>
				<c:ConsoleRail.Footer>
					<TextBlock
						AutomationProperties.AutomationId="Console.ActionReportTemplates.Rail.Footer"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding RailFooterText}"
						TextWrapping="WrapWithOverflow" />
				</c:ConsoleRail.Footer>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<!--
			툴바 — [+ 문구 추가] · [삭제] · [갱신] · [되돌리기](Extra, 마지막 재정렬 1회분).
			V-33 — [순서 되돌리기] 는 테두리 있는 보통 단추(Console.Button)다. Ghost 는 꺼지면 테두리 · 판이 생기고 켜지면
			글자만 남아, 누를 수 있을 때가 오히려 덜 단추처럼 보였다(꺼짐=테두리 · 켜짐=글자, 모양이 거꾸로).
		-->
		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="{Binding AddBlockedReason}"
				AddText="새 문구"
				CanAdd="{Binding CanAdd}"
				CanDelete="{Binding CanDelete}"
				CanRefresh="{Binding CanReload}"
				ConsoleKey="ActionReportTemplates"
				DeleteClick="OnDelete"
				DeleteDisabledReason="{Binding DeleteBlockedReason}"
				RefreshClick="OnReload"
				ShowSearch="False">
				<c:ConsoleToolbar.Extra>
					<Button
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.UndoReorderButton"
						Click="OnUndoReorder"
						Content="↶ 순서 되돌리기"
						IsEnabled="{Binding CanUndoReorder}"
						Style="{StaticResource Console.Button}"
						ToolTip="{Binding UndoReorderText}"
						ToolTipService.ShowOnDisabled="True" />
				</c:ConsoleToolbar.Extra>
			</c:ConsoleToolbar>
		</c:ConsoleShell.Toolbar>

		<!--  목록 — 전량 로딩(가상화·무한스크롤 없음). 드래그 손잡이는 handle-only.  -->
		<c:ConsoleShell.List>
			<Grid ClipToBounds="True" IsEnabled="{Binding IsReordering, Converter={StaticResource BoolInverse}}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!--  키보드 · 단추 폴백 — 목록 위에 둔다(아래 두면 긴 목록에 밀려 화면 밖으로 나간다).  -->
				<DockPanel Grid.Row="0" Margin="12,8,12,4" LastChildFill="True">
					<Button
						Margin="4,0,0,0"
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.MoveDownButton"
						Click="OnMoveDown"
						Content="▼"
						DockPanel.Dock="Right"
						IsEnabled="{Binding CanMoveSelected}"
						Style="{StaticResource Reorder.Button}"
						ToolTip="{Binding MoveDownToolTip}" />
					<Button
						Margin="4,0,0,0"
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.MoveUpButton"
						Click="OnMoveUp"
						Content="▲"
						DockPanel.Dock="Right"
						IsEnabled="{Binding CanMoveSelected}"
						Style="{StaticResource Reorder.Button}"
						ToolTip="{Binding MoveUpToolTip}" />
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.ReorderHint"
						FontSize="11"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="문구를 끌거나, 고른 뒤 Alt+↑/↓ 또는 오른쪽 ▲▼ 로 순서를 바꿉니다."
						TextWrapping="Wrap" />
				</DockPanel>

				<Grid Grid.Row="1">
					<ListBox
						Padding="12,0,12,12"
						drag:DropZone.Handler="{Binding Drop}"
						drag:DropZone.IsReorder="True"
						drag:DropZone.Key="action-report-template"
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.List"
						ItemsSource="{Binding Items}"
						Loaded="OnListLoaded"
						SelectionChanged="OnListSelectionChanged"
						SelectionMode="Single"
						Style="{StaticResource Console.ReorderList}">
						<b:Interaction.Behaviors>
							<!--  손잡이에서만 끌기가 시작된다 · 데드존 8.0 미만은 클릭 폴백  -->
							<drag:CaptureDragBehavior
								DisplayMemberPath="Display"
								Handler="{Binding Drop}"
								IsDragEnabled="{Binding CanEdit}"
								KeyboardFallback="문구를 고른 뒤 Alt+↑ · Alt+↓ 로 옮깁니다" />
							<!--  키보드 폴백 — 드래그 · ▲▼ 단추와 같은 담당을 부른다(회귀 단언은 이 경로로)  -->
							<drag:ReorderKeyboardBehavior Handler="{Binding Drop}" IsReorderEnabled="{Binding CanEdit}" />
						</b:Interaction.Behaviors>

						<ListBox.ItemTemplate>
							<DataTemplate>
								<DockPanel Height="38" LastChildFill="True">
									<drag:DragHandle
										Width="20"
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										AutomationProperties.AutomationId="{Binding Id, StringFormat=Reports.ActionReportTemplate.DragHandle.{0}}"
										DockPanel.Dock="Left"
										ToolTip="끌어서 순서를 바꿉니다 · Alt+↑ / Alt+↓ 로도 됩니다" />
									<!--  A1 — 순번은 화면 순서(1부터). 서버 display_order(0부터)를 그대로 내지 않는다.  -->
									<TextBlock
										Width="24"
										Margin="0,0,8,0"
										VerticalAlignment="Center"
										AutomationProperties.AutomationId="{Binding Id, StringFormat=Reports.ActionReportTemplate.PositionText.{0}}"
										DockPanel.Dock="Left"
										FontFamily="{DynamicResource MonoFont}"
										FontSize="11.5"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Position}"
										TextAlignment="Right" />
									<!--  A4 · A5 — 두 단추 같은 모양, [삭제]는 권한 · 서버 지원이 있을 때만 켠다(꺼지면 까닭을 도움말로).  -->
									<StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
										<Button
											Margin="4,0,0,0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Reports.ActionReportTemplate.EditButton.{0}}"
											Click="OnEditRow"
											Content="{Binding DataContext.RowEditText, RelativeSource={RelativeSource AncestorType=ListBox}}"
											Style="{StaticResource Row.Button}" />
										<Button
											Margin="4,0,0,0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Reports.ActionReportTemplate.DeleteButton.{0}}"
											Click="OnDeleteRow"
											Content="삭제"
											IsEnabled="{Binding DataContext.CanDeletePermission, RelativeSource={RelativeSource AncestorType=ListBox}}"
											Style="{StaticResource Row.Button.Danger}"
											ToolTip="{Binding DataContext.RowDeleteToolTip, RelativeSource={RelativeSource AncestorType=ListBox}}" />
									</StackPanel>
									<TextBlock
										Margin="4,0,8,0"
										VerticalAlignment="Center"
										AutomationProperties.AutomationId="{Binding AutomationId}"
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding Display}"
										TextTrimming="CharacterEllipsis"
										ToolTip="{Binding Display}" />
								</DockPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<!--
						빈 상태 — 커널 ConsoleEmptyState(글리프 + 무엇이 비었나 + 다음 할 일). 제목 글은 옛 자동화 식별자
						(Reports.ActionReportTemplate.EmptyStateText)를 지닌 TextBlock 으로 Action 자리에 싣는다 —
						ConsoleEmptyState 는 UIA 피어가 없어 거기 붙인 식별자는 자동화 트리에 나오지 않는다.
					-->
					<c:ConsoleEmptyState
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.EmptyState"
						Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
						<c:ConsoleEmptyState.Action>
							<StackPanel Margin="0,-2,0,0">
								<TextBlock
									MaxWidth="320"
									HorizontalAlignment="Center"
									AutomationProperties.AutomationId="Reports.ActionReportTemplate.EmptyStateText"
									FontSize="13.5"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding EmptyStateText}"
									TextAlignment="Center"
									TextWrapping="WrapWithOverflow" />
								<TextBlock
									MaxWidth="320"
									Margin="0,5,0,0"
									HorizontalAlignment="Center"
									AutomationProperties.AutomationId="Reports.ActionReportTemplate.EmptyStateHint"
									FontSize="12.5"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding EmptyStateHint}"
									TextAlignment="Center"
									TextWrapping="WrapWithOverflow"
									Visibility="{Binding EmptyStateHint, Converter={StaticResource NotEmptyToVisibility}}" />
							</StackPanel>
						</c:ConsoleEmptyState.Action>
					</c:ConsoleEmptyState>
				</Grid>
			</Grid>
		</c:ConsoleShell.List>

		<!--  상태 띠 — 건수 + 방금 한 일  -->
		<c:ConsoleShell.StatusBar>
			<Border
				Padding="12,5"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<DockPanel LastChildFill="True">
					<!--  A11 — 오른쪽 18 은 호스트 틀의 크기 조절 손잡이(16×16) 자리다. 없으면 글 끝이 손잡이에 닿았다.  -->
					<TextBlock
						Margin="12,0,18,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Console.ActionReportTemplates.Status.Message"
						DockPanel.Dock="Right"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding StatusText}"
						TextTrimming="CharacterEllipsis" />
					<!--  다른 곳에서 문구 목록이 바뀌었는데(서버 SYNC_ACTION_REPORT_TEMPLATE) 적고 있던 문구 · 끌기 때문에 다시 읽지 않았다 — 덮지 않고 알린다  -->
					<StackPanel
						Margin="12,0,0,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Right"
						Orientation="Horizontal"
						Visibility="{Binding IsExternallyChanged, Converter={StaticResource BoolToVisibility}}">
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.ActionReportTemplates.Status.ExternalChange"
							FontSize="12"
							Foreground="{DynamicResource StatusWarningBrush}"
							Text="{Binding ExternalChangeText}" />
						<Button
							Margin="6,0,0,0"
							AutomationProperties.AutomationId="Console.ActionReportTemplates.Status.ExternalChangeReload"
							Click="OnReload"
							Content="{Binding ExternalChangeActionText}"
							IsEnabled="{Binding CanReload}"
							Style="{StaticResource Console.Button.Mini}"
							ToolTip="서버의 지금 문구 목록을 다시 읽습니다. 적용하지 않은 문구가 있으면 먼저 적용하거나 되돌려야 합니다." />
					</StackPanel>
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Reports.ActionReportTemplate.CountText"
						DockPanel.Dock="Left"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding CountText}" />
				</DockPanel>
			</Border>
		</c:ConsoleShell.StatusBar>

		<!--  상세 — 여섯 상태 + 고정 적용 막대. 등록 · 수정 한 폼뿐이라 레일 분기 없이 그대로 얹는다.  -->
		<c:ConsoleShell.Detail>
			<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="{Binding Detail.ApplyText}"
				Banner="{Binding Detail.Banner}"
				CanApply="{Binding DetailCanApply}"
				CanRevert="{Binding Detail.CanRevert}"
				ConsoleKey="ActionReportTemplates"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding DetailFooterText}"
				IsDirty="{Binding Detail.IsDirty}"
				IsReadOnly="{Binding Detail.IsReadOnly}"
				Kind="{Binding Detail.Kind}"
				RevertClick="OnRevert"
				RevertText="{Binding Detail.RevertText}"
				ShakeToken="{Binding Detail.ShakeToken}"
				ShowButtons="{Binding Detail.ShowButtons}"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding Detail.Title}">
				<Grid>
				<!--
					V-32 — 고른 문구도 새로 적는 문구도 없으면 빈 문구 칸 · "0 / 500자" 대신 빈 상태(무엇이 비었고 무엇을 하면 되는지).
					바닥 막대는 커널 여섯 상태가 이미 접는다(선택 없음 = 단추 없음).
				-->
				<c:ConsoleEmptyState
					Padding="16,48,16,16"
					VerticalAlignment="Top"
					AutomationProperties.AutomationId="Reports.ActionReportTemplate.DetailEmptyState"
					Glyph="M4,5 H20 V16 H9 L5,20 V16 H4 Z M8,9 H16 M8,12 H13"
					Hint="{Binding DetailEmptyHint}"
					IsHitTestVisible="False"
					Title="{x:Static vm:ActionReportTemplateConsoleViewModel.DetailEmptyTitle}"
					Visibility="{Binding IsDetailEmpty, Converter={StaticResource BoolToVisibility}}" />
				<StackPanel Margin="0,4,0,0" Visibility="{Binding IsDetailFormVisible, Converter={StaticResource BoolToVisibility}}">
					<c:ConsoleSection Header="문구">
						<StackPanel>
							<c:ConsoleField
								ApiName="content"
								Header="문구 *"
								IsTouched="{Binding IsContentTouched}">
								<TextBox
									MinHeight="120"
									AcceptsReturn="True"
									AutomationProperties.AutomationId="Reports.ActionReportTemplate.ContentTextBox"
									IsEnabled="{Binding Detail.IsReadOnly, Converter={StaticResource BoolInverse}}"
									MaxLength="500"
									Style="{StaticResource Form.TextBox}"
									Text="{Binding DraftContent, UpdateSourceTrigger=PropertyChanged}"
									TextWrapping="Wrap" />
							</c:ConsoleField>
							<DockPanel Margin="0,4,0,0" LastChildFill="False">
								<TextBlock
									AutomationProperties.AutomationId="Reports.ActionReportTemplate.CharCountText"
									DockPanel.Dock="Left"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding DraftContentCountText}" />
							</DockPanel>
							<TextBlock
								Margin="0,4,0,0"
								AutomationProperties.AutomationId="Reports.ActionReportTemplate.ValidationText"
								FontSize="11"
								Foreground="{DynamicResource StatusCriticalBrush}"
								Text="{Binding DraftValidationMessage, StringFormat='▲ {0}'}"
								TextWrapping="Wrap"
								Visibility="{Binding DraftValidationMessage, Converter={StaticResource NotEmptyToVisibility}}" />
						</StackPanel>
					</c:ConsoleSection>
				</StackPanel>
				</Grid>
			</c:ConsoleDetailHost>
		</c:ConsoleShell.Detail>
	</c:ConsoleShell>
</UserControl>
