<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 툴바 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,8">
            <TextBlock Text="상태" VerticalAlignment="Center" Margin="2,0,6,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox Width="140" ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}" />
            <Button x:Name="LoadAsync" Content="검색" Width="72" Margin="8,0,0,0" />
            <Button x:Name="Preview" Content="미리보기" Width="90" Margin="16,0,0,0"
                    IsEnabled="{Binding CanDownload}" />
            <Button x:Name="Download" Content="PDF 다운로드" Width="110" Margin="6,0,0,0"
                    IsEnabled="{Binding CanDownload}" />
        </StackPanel>

        <!-- 목록 -->
        <DataGrid Grid.Row="1" x:Name="Items" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectedItem="{Binding SelectedItem}" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="Transparent" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="유형" Binding="{Binding ReportType}" Width="90" />
                <DataGridTextColumn Header="기간" Binding="{Binding PeriodType}" Width="70" />
                <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="110" />
                <DataGridTextColumn Header="생성일시" Binding="{Binding CreatedAt}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 빈 상태 -->
        <TextBlock Grid.Row="1" Text="생성된 보고서가 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="2" Margin="4,6,0,0" Foreground="{DynamicResource TextMutedBrush}"
                   Text="{Binding Items.Count, StringFormat=로드 {0}건}" />
    </Grid>
</UserControl>
