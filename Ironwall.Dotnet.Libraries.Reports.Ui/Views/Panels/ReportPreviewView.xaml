<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 툴바: 줌 · PDF (제목은 오버레이 헤더가 담당) -->
        <DockPanel Grid.Row="0" Margin="12,10,12,8">
            <Button DockPanel.Dock="Right" x:Name="Download" Content="PDF 다운로드" MinWidth="112"
                    Style="{StaticResource ModernPrimaryButton}" />
            <Button DockPanel.Dock="Right" x:Name="DownloadCsv" Content="상세 CSV" MinWidth="90" Margin="0,0,8,0"
                    Style="{StaticResource ModernSecondaryButton}" ToolTip="선택 유형 전량 이벤트 CSV(엑셀 호환)" />
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CsvTypes}" SelectedItem="{Binding SelectedCsvType}"
                      DisplayMemberPath="Display" Width="100" Margin="0,0,8,0" VerticalAlignment="Center"
                      Style="{StaticResource ModernComboBox}" ToolTip="CSV 유형" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="확대" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource PanelFieldLabel}" />
                <Button x:Name="ZoomOut" Content="−" Width="32" Padding="0" ToolTip="축소"
                        Style="{StaticResource ModernSecondaryButton}" />
                <TextBlock Text="{Binding ZoomText}" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center"
                           Margin="4,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button x:Name="ZoomIn" Content="+" Width="32" Padding="0" ToolTip="확대"
                        Style="{StaticResource ModernSecondaryButton}" />
                <Button x:Name="ZoomReset" Content="100%" MinWidth="52" Margin="8,0,0,0" ToolTip="원본 크기"
                        Style="{StaticResource ModernTextButton}" />
                <TextBlock Text="불러오는 중…" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource B2V}}" />
                <!-- 다운로드 실패 인라인 안내 (WebView2 airspace 때문에 팝업 대신 툴바 표기) -->
                <TextBlock Text="{Binding DownloadStatus}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#FF6B6B" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="380"
                           Visibility="{Binding HasDownloadStatus, Converter={StaticResource B2V}}" />
            </StackPanel>
        </DockPanel>

        <!-- HTML embed (서버 자립형 HTML, 인라인 Chart.js). 넘치면 WebView2가 스크롤바 자동 표시 -->
        <Border Grid.Row="1" Margin="12,0,12,12" CornerRadius="4" ClipToBounds="True" MinHeight="360"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="White">
            <wv2:WebView2 x:Name="Browser" MinHeight="340" ZoomFactor="{Binding ZoomFactor, Mode=TwoWay}" />
        </Border>
    </Grid>
</UserControl>
