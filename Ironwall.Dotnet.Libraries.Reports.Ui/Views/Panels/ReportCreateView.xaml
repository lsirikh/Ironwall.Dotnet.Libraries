<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 정형/비정형 토글 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="유형:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ToggleButton IsChecked="{Binding IsCustom}" Content="비정형(CUSTOM) — 컴포넌트 선택" Padding="10,4" />
            <TextBlock Text="  (해제 시 정형 STANDARD: 전 섹션)" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <!-- 공통 폼 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="제목 *" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
            <TextBlock Text="기간 *" Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"
                      DisplayMemberPath="Display" Width="180" HorizontalAlignment="Left" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 비정형 컴포넌트 목록 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="0,0,0,8"
                Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Components">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled}" Margin="2" Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" />
                                    <TextBlock Text="{Binding Category, StringFormat=  ({0})}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 생성 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="Generate" Content="생성" Width="90" IsEnabled="{Binding CanGenerate}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
