<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 보고서 종류 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="보고서 종류" Style="{StaticResource PanelFieldLabel}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <RadioButton Content="표준 전체" GroupName="ReportKind" IsChecked="{Binding IsStandard, Mode=TwoWay}"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <RadioButton Content="템플릿 기반" GroupName="ReportKind" IsChecked="{Binding IsTemplateBased, Mode=TwoWay}"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
            <TextBlock Text="  (표준 = 전 섹션 · 템플릿 = 선택 구성)" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
        </StackPanel>

        <!-- 템플릿 선택 (템플릿 기반일 때만) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10"
                    Visibility="{Binding IsTemplateBased, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="템플릿 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"
                      Style="{StaticResource ModernComboBox}" Width="320" HorizontalAlignment="Left" />
            <TextBlock Text="※ 템플릿은 '템플릿' 탭에서 추가/수정합니다." Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 제목 + 기간 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="제목 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                     md:HintAssist.Hint="보고서 제목" Margin="0,0,0,10" />
            <TextBlock Text="기간 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Display"
                      Style="{StaticResource ModernComboBox}" Width="200" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- 생성 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="Generate" Content="생성" MinWidth="96" Style="{StaticResource ModernPrimaryButton}"
                    IsEnabled="{Binding CanGenerate}" />
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                         Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource PrimaryBrush}"
                         Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                       Style="{StaticResource PanelFieldLabel}" />
        </StackPanel>
    </Grid>
</UserControl>
