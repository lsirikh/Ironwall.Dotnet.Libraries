<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportCreateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    AutomationProperties.AutomationId="Reports.Create.Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 보고서 종류 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="보고서 종류" Style="{StaticResource PanelFieldLabel}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <RadioButton Content="표준 전체" GroupName="ReportKind" IsChecked="{Binding IsStandard, Mode=TwoWay}"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="Reports.Create.StandardRadio" />
            <RadioButton Content="템플릿 기반" GroupName="ReportKind" IsChecked="{Binding IsTemplateBased, Mode=TwoWay}"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="18,0,0,0" AutomationProperties.AutomationId="Reports.Create.TemplateRadio" />
            <TextBlock Text="  (표준 = 전 섹션 · 템플릿 = 선택 구성)" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
        </StackPanel>

        <!-- 템플릿 선택 (템플릿 기반일 때만) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10"
                    Visibility="{Binding IsTemplateBased, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="템플릿 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name"
                      Style="{StaticResource ModernComboBox}" Width="320" HorizontalAlignment="Left" AutomationProperties.AutomationId="Reports.Create.TemplateComboBox" />
            <TextBlock Text="※ 템플릿은 '템플릿' 탭에서 추가/수정합니다." Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 제목 + 기간 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="제목 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                     md:HintAssist.Hint="보고서 제목" Margin="0,0,0,10" AutomationProperties.AutomationId="Reports.Create.TitleTextBox" />
            <TextBlock Text="기간 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton Content="프리셋" GroupName="RangeKind" IsChecked="{Binding IsPreset, Mode=TwoWay}"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="Reports.Create.PresetRadio" />
                <RadioButton Content="직접 지정(달력)" GroupName="RangeKind" IsChecked="{Binding IsCustomRange, Mode=TwoWay}"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="18,0,0,0" AutomationProperties.AutomationId="Reports.Create.CustomRangeRadio" />
            </StackPanel>
            <!-- 프리셋(7d/30d/…) -->
            <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Display"
                      Style="{StaticResource ModernComboBox}" Width="200" HorizontalAlignment="Left"
                      Visibility="{Binding IsPreset, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="Reports.Create.PeriodComboBox" />
            <!-- 직접 지정: 시작 ~ 끝 (달력). ※ 서버 커스텀 날짜 반영 후 정식 동작 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        Visibility="{Binding IsCustomRange, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DatePicker SelectedDate="{Binding StartDate}" Width="150" AutomationProperties.AutomationId="Reports.Create.StartDatePicker" />
                <TextBlock Text="~" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextMutedBrush}" />
                <DatePicker SelectedDate="{Binding EndDate}" Width="150" AutomationProperties.AutomationId="Reports.Create.EndDatePicker" />
                <TextBlock Text="(끝일 포함)" VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 심각도 필터(시스템 이벤트 계열에만 적용 · 미선택=전 심각도) -->
        <StackPanel Grid.Row="3" VerticalAlignment="Top" Margin="0,12,0,0">
            <TextBlock Text="심각도 필터" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <ItemsControl ItemsSource="{Binding Severities}"
                          AutomationProperties.AutomationId="Reports.Create.SeverityList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  AutomationProperties.AutomationId="{Binding Value, StringFormat=Reports.Create.Severity.{0}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding SeveritySummary, StringFormat=※ 시스템 이벤트 집계·표·CSV 에만 적용됩니다 — 현재: {0}}" />
        </StackPanel>

        <!-- 생성 -->
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Generate" Content="생성" MinWidth="96" Style="{StaticResource ModernPrimaryButton}"
                        AutomationProperties.AutomationId="Reports.Create.GenerateButton"
                        IsEnabled="{Binding CanGenerate}" />
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                             Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Style="{StaticResource PanelFieldLabel}" AutomationProperties.AutomationId="Reports.Create.StatusText" />
            </StackPanel>
            <!-- 진행률 결정형 바 (서버 progress_pct, 생성 중만) -->
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding GenProgress}" Height="6" Margin="0,10,0,0"
                         Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource PrimaryBrush}"
                         Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
