<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportTemplateDetailView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
	<!--
		템플릿 상세 칸 — 560 오버레이를 없애고 오른쪽 칸에서 고친다(설계 정본 L1282:
		이름 · 설명 · 기본기간 · 구성 체크리스트). 손댄 칸만 [적용] 때 나간다.

		★ 드래그(all-windows-drag-wireframe.html L355-356): 이 창에서 허용된 유일한 드래그가
		  "템플릿 구성 순서"다. 서버에 order 필드가 있음을 확인하고 만들었다.
		  커널만 쓴다(캡처 드래그 · 삽입선 · 고스트 · 데드존 8.0) · 키보드 폴백 Alt+↑/↓ ·
		  Esc 제자리 복귀 · 되돌리기 · 형태로 보이는 피드백. 서버 왕복은 0회다(적용 때 PATCH 1건).
	-->
	<UserControl.Resources>
		<ResourceDictionary>
		<ResourceDictionary.MergedDictionaries>
			<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Reports.Ui;component/Views/Panels/ReportStyles.xaml" />
		</ResourceDictionary.MergedDictionaries>

		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<Style x:Key="Form.TextBox" TargetType="TextBox">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<StackPanel>
		<c:ConsoleSection Header="기본 정보">
			<StackPanel>
				<c:ConsoleField
					ApiName="name"
					Header="이름 *"
					IsTouched="{Binding IsNameTouched}">
					<TextBox
						AutomationProperties.AutomationId="Reports.Detail.Field.name"
						IsEnabled="{Binding EditViewModel.CanEdit}"
						Style="{StaticResource Form.TextBox}"
						Text="{Binding EditViewModel.Name, UpdateSourceTrigger=PropertyChanged}" />
				</c:ConsoleField>

				<c:ConsoleField
					ApiName="description"
					Header="설명"
					IsTouched="{Binding IsDescriptionTouched}">
					<TextBox
						MinHeight="52"
						Padding="6,4"
						AcceptsReturn="True"
						AutomationProperties.AutomationId="Reports.Detail.Field.description"
						Background="{DynamicResource SurfaceSunkenBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						CaretBrush="{DynamicResource TextPrimaryBrush}"
						FontSize="13"
						Foreground="{DynamicResource TextPrimaryBrush}"
						IsEnabled="{Binding EditViewModel.CanEdit}"
						Text="{Binding EditViewModel.Description, UpdateSourceTrigger=PropertyChanged}"
						TextWrapping="Wrap" />
				</c:ConsoleField>

				<c:ConsoleField
					ApiName="default_period"
					Header="기본 기간"
					IsTouched="{Binding IsPeriodTouched}">
					<ComboBox
						Height="30"
						AutomationProperties.AutomationId="Reports.Detail.Field.default_period"
						DisplayMemberPath="Display"
						FontSize="13"
						IsEnabled="{Binding EditViewModel.CanEdit}"
						ItemsSource="{Binding EditViewModel.Periods}"
						SelectedItem="{Binding EditViewModel.SelectedPeriod}" />
				</c:ConsoleField>
			</StackPanel>
		</c:ConsoleSection>

		<!--  구성 체크리스트 + 순서(드래그 1순위, 키보드 폴백 동반)  -->
		<c:ConsoleSection
			AxisName="components"
			CountText="{Binding EditViewModel.ComponentSummary}"
			Header="구성 요소">
			<StackPanel>
				<!--  폴백은 목록 <b>위</b>에 둔다 — 아래에 두면 긴 목록에 밀려 화면 밖으로 나간다(자동화가 못 짚는다).  -->
				<DockPanel Margin="0,0,0,6" LastChildFill="True">
					<Button
						Margin="4,0,0,0"
						AutomationProperties.AutomationId="Reports.Detail.MoveDownButton"
						Click="OnMoveDown"
						Content="▼"
						DockPanel.Dock="Right"
						IsEnabled="{Binding EditViewModel.CanEdit}"
						Style="{StaticResource ConsoleMiniButton}"
						ToolTip="고른 줄을 아래로 (Alt+↓)" />
					<Button
						Margin="4,0,0,0"
						AutomationProperties.AutomationId="Reports.Detail.MoveUpButton"
						Click="OnMoveUp"
						Content="▲"
						DockPanel.Dock="Right"
						IsEnabled="{Binding EditViewModel.CanEdit}"
						Style="{StaticResource ConsoleMiniButton}"
						ToolTip="고른 줄을 위로 (Alt+↑)" />
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Reports.Detail.ReorderHint"
						FontSize="11"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="{Binding ReorderHint}"
						TextWrapping="Wrap" />
				</DockPanel>

				<ListBox
					drag:DropZone.Handler="{Binding EditViewModel.Drop}"
					drag:DropZone.IsReorder="True"
					drag:DropZone.Key="report-template-component"
					AutomationProperties.AutomationId="Reports.Detail.ComponentList"
					ItemsSource="{Binding EditViewModel.Board.Items}"
					SelectionMode="Extended"
					Style="{StaticResource Console.ReorderList}">
					<b:Interaction.Behaviors>
						<!--  손잡이에서만 끌기가 시작된다 · 데드존 8.0 미만은 클릭 폴백  -->
						<drag:CaptureDragBehavior
							DisplayMemberPath="Display"
							Handler="{Binding EditViewModel.Drop}"
							IsDragEnabled="{Binding EditViewModel.CanEdit}"
							KeyboardFallback="줄을 고른 뒤 Alt+↑ · Alt+↓ 로 옮긴다" />
						<!--  키보드 폴백 — 드래그와 같은 담당을 부른다(회귀 단언은 이 경로로)  -->
						<drag:ReorderKeyboardBehavior
							Handler="{Binding EditViewModel.Drop}"
							IsReorderEnabled="{Binding EditViewModel.CanEdit}" />
					</b:Interaction.Behaviors>

					<ListBox.ItemTemplate>
						<DataTemplate>
							<DockPanel Height="34" LastChildFill="True">
								<drag:DragHandle
									Width="18"
									Margin="0,0,2,0"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding Id, StringFormat=Reports.Detail.DragHandle.{0}}"
									DockPanel.Dock="Left"
									ToolTip="끌어서 순서를 바꿉니다 · Alt+↑ / Alt+↓ 로도 됩니다" />
								<CheckBox
									Margin="2,0,8,0"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding AutomationId}"
									DockPanel.Dock="Left"
									IsChecked="{Binding IsEnabled}" />
								<TextBlock
									MinWidth="52"
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									DockPanel.Dock="Right"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding ChartTypeLabel}"
									TextAlignment="Right" />
								<StackPanel VerticalAlignment="Center">
									<TextBlock
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding Display}"
										TextTrimming="CharacterEllipsis"
										ToolTip="{Binding Description}" />
									<TextBlock
										FontSize="10.5"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Category}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</DockPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>
		</c:ConsoleSection>

		<!--  저장 결과 — 팝업이 아니라 인라인  -->
		<TextBlock
			Margin="0,8,0,0"
			AutomationProperties.AutomationId="Reports.Detail.TemplateStatusText"
			FontSize="11.5"
			Foreground="{DynamicResource TextSecondaryBrush}"
			Text="{Binding EditViewModel.StatusText}"
			TextWrapping="Wrap"
			Visibility="{Binding EditViewModel.HasStatus, Converter={StaticResource BoolToVisibility}}" />
	</StackPanel>
</UserControl>
