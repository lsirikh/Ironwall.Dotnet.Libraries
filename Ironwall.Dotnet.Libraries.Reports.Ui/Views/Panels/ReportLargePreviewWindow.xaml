<Window
	x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportLargePreviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="880"
	Height="720"
	MinWidth="520"
	MinHeight="420"
	AutomationProperties.AutomationId="Reports.LargePreview.Window"
	Background="{DynamicResource SurfaceBrush}"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<!--
		[크게 보기] — 설계 정본 L1269 · L1278("크게 보기만 모달").
		★ 인-윈도우 다이얼로그가 아니라 <b>자체 HWND 를 갖는 최상위 창</b>이다. WebView2 는 네이티브 창이라
		  같은 최상위 창 안에서는 WPF 를 그 위에 못 그린다 — 창을 나누는 것이 공역 문제의 근본 회피책이다.
		  크기 기준은 목업의 다이얼로그 폭 사다리(S400 / M560 / L720)보다 큰 탐지 신호 이력(880) 을 따랐다.
	-->

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
			Padding="14,8"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1">
			<DockPanel LastChildFill="True">
				<!--  R32 — 다른 콘솔과 같은 ✕(커널 Console.Button.Close). 글자 "닫기" 고스트 단추는 이 창에만 있었다.  -->
				<Button
					Margin="6,0,0,0"
					AutomationProperties.AutomationId="Reports.LargePreview.CloseButton"
					AutomationProperties.Name="미리보기 닫기"
					Click="OnClose"
					DockPanel.Dock="Right"
					Style="{StaticResource Console.Button.Close}" />
				<Button
					Margin="0,0,6,0"
					AutomationProperties.AutomationId="Reports.LargePreview.ZoomResetButton"
					Click="OnZoomReset"
					Content="100%"
					DockPanel.Dock="Right"
					Style="{StaticResource Console.Button.Mini}" />
				<Button
					Margin="0,0,4,0"
					AutomationProperties.AutomationId="Reports.LargePreview.ZoomInButton"
					Click="OnZoomIn"
					Content="＋"
					DockPanel.Dock="Right"
					Style="{StaticResource Console.Button.Mini}" />
				<Button
					Margin="0,0,4,0"
					AutomationProperties.AutomationId="Reports.LargePreview.ZoomOutButton"
					Click="OnZoomOut"
					Content="−"
					DockPanel.Dock="Right"
					Style="{StaticResource Console.Button.Mini}" />
				<TextBlock
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Reports.LargePreview.TitleText"
					FontSize="13"
					FontWeight="Medium"
					Foreground="{DynamicResource TextPrimaryBrush}"
					Text="{Binding ReportTitle, RelativeSource={RelativeSource AncestorType=Window}}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>

		<Border
			Grid.Row="1"
			Margin="12"
			Background="White"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1"
			ClipToBounds="True"
			CornerRadius="4"
			Loaded="OnHostLoaded" />
	</Grid>
</Window>
