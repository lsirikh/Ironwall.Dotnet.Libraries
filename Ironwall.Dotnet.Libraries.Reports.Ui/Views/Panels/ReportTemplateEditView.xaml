<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportTemplateEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 기본 정보 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="이름 *" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                     md:HintAssist.Hint="템플릿 이름" Margin="0,0,0,10" />
            <TextBlock Text="설명" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"
                     md:HintAssist.Hint="템플릿 설명(선택)" TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="3"
                     Margin="0,0,0,10" />
        </StackPanel>

        <!-- 옵션 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="기본기간" Style="{StaticResource PanelFieldLabel}" Margin="0,0,0,2" />
                <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Display"
                          Style="{StaticResource ModernComboBox}" Width="180" HorizontalAlignment="Left" />
            </StackPanel>
            <CheckBox Content="공개(is_public)" IsChecked="{Binding IsPublic}" VerticalAlignment="Bottom" Margin="24,0,0,6"
                      Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>

        <!-- 컴포넌트 -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="컴포넌트" Style="{StaticResource PanelSectionLabel}" />
            <Border Grid.Row="1" Style="{StaticResource StandardPanelCard}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Components">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled}" Margin="2,3" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Category, StringFormat=  ({0})}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 액션 -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource PanelFieldLabel}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Cancel" Content="취소" MinWidth="80" Style="{StaticResource ModernSecondaryButton}" />
                <Button x:Name="Save" Content="저장" MinWidth="96" Margin="8,0,0,0"
                        Style="{StaticResource ModernPrimaryButton}" IsEnabled="{Binding CanSave}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
