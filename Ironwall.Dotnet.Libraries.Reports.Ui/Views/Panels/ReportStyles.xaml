<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--
		보고서 콘솔 전용 소품 스타일.
		※ 커널의 `Console.Button.*` 는 Utils 의 <b>테마 사전</b>(Generic.xaml) 안에만 있어 앱 스코프의
		  StaticResource 로는 해소되지 않는다(실측: "리소스를 찾을 수 없습니다"). 그래서 공용 스타일은
		  Theme 프로젝트의 Modern* 키를 쓰고, 그 사다리에 없는 <b>작은 단추</b>만 여기서 만든다.
		  색은 전부 DynamicResource 토큰이라 테마 전환에 동참한다.
	-->
	<Style x:Key="ConsoleMiniButton" TargetType="Button">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Height" Value="26" />
		<Setter Property="Padding" Value="8,0" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="4">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.45" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!--
		다크에서 ModernPrimaryButton 은 꺼져 있어도 켜진 것과 똑같이 그려진다(가득 찬 teal + 흰 글자).
		그 스타일은 Theme 프로젝트에 있고 이 노드의 손대는 범위 밖이라, <b>여기서만</b> 흐리게 덮는다.
		Theme 쪽 결함은 그대로 남아 있다 — 통합자에게 보고한다.
	-->
	<Style
		x:Key="ConsolePrimaryButton"
		BasedOn="{StaticResource ModernPrimaryButton}"
		TargetType="Button">
		<Style.Triggers>
			<Trigger Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value="0.42" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
