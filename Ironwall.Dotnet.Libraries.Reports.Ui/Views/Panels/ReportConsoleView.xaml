<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- 중앙 정렬 바운드 박스 (전체화면 stretch 방지 — 계정 패널류 크기) -->
    <Border Width="960" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 헤더 (시안 바 표준) -->
            <Border Grid.Row="0" Style="{StaticResource ModernDialogHeader}" CornerRadius="10,10,0,0">
                <DockPanel VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" x:Name="Close" Style="{StaticResource ModernPanelCloseButton}" />
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="FileChartOutline" Width="18" Height="18" VerticalAlignment="Center"
                                     Foreground="{DynamicResource OnPrimaryFixedBrush}" />
                        <TextBlock Text="보고서 관리" Margin="8,0,0,0" Style="{StaticResource ModernDialogHeaderText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 본문: 탭 + 미리보기/수정 오버레이 -->
            <Grid Grid.Row="1">
                <TabControl Background="Transparent" BorderThickness="0" Margin="12,8">
                    <TabItem Header="목록">
                        <ContentControl x:Name="ListViewModel" Margin="5,8,5,0" />
                    </TabItem>
                    <TabItem Header="생성">
                        <ContentControl x:Name="CreateViewModel" Margin="5,8,5,0" />
                    </TabItem>
                    <TabItem Header="템플릿">
                        <ContentControl x:Name="TemplateViewModel" Margin="5,8,5,0" />
                    </TabItem>
                </TabControl>

                <!-- 미리보기 오버레이 (본문 채움 → WebView2 확정 높이 + 스크롤/줌) -->
                <Grid Background="#CC0C1117" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Style="{StaticResource ModernDialogPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ModernDialogHeader}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="ClosePreview" Style="{StaticResource ModernPanelCloseButton}" />
                                    <TextBlock Text="미리보기" Style="{StaticResource ModernDialogHeaderText}" />
                                </DockPanel>
                            </Border>
                            <ContentControl Grid.Row="1" x:Name="PreviewViewModel" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 템플릿 수정 오버레이 -->
                <Grid Background="#CC0C1117" Visibility="{Binding IsEditVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="560" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Style="{StaticResource ModernDialogPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ModernDialogHeader}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="CloseEdit" Style="{StaticResource ModernPanelCloseButton}" />
                                    <TextBlock Text="{Binding EditViewModel.DialogTitle}" Style="{StaticResource ModernDialogHeaderText}" />
                                </DockPanel>
                            </Border>
                            <ContentControl Grid.Row="1" x:Name="EditViewModel" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 풋터 -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,10,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,8">
                    <TextBlock Text="보고서 콘솔" VerticalAlignment="Center"
                               Style="{StaticResource PanelFieldLabel}" Foreground="{DynamicResource TextMutedBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
