<UserControl
    x:Class="Ironwall.Dotnet.Libraries.Reports.Ui.Views.Panels.ReportConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    MinWidth="900" MinHeight="560">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="9,9,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <md:PackIcon Kind="FileChartOutline" Width="18" Height="18" VerticalAlignment="Center"
                                 Foreground="{DynamicResource OnPrimaryFixedBrush}" />
                    <TextBlock Text="보고서 관리" Margin="8,0,0,0" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{DynamicResource OnPrimaryFixedBrush}" />
                </StackPanel>
            </Border>

            <!-- 본문: 탭 + 미리보기 오버레이 -->
            <Grid Grid.Row="1">
                <TabControl Background="Transparent" BorderThickness="0" Margin="8">
                    <TabItem Header="목록">
                        <ContentControl x:Name="ListViewModel" />
                    </TabItem>
                    <TabItem Header="생성">
                        <ContentControl x:Name="CreateViewModel" />
                    </TabItem>
                    <TabItem Header="템플릿">
                        <ContentControl x:Name="TemplateViewModel" />
                    </TabItem>
                </TabControl>

                <!-- 미리보기 오버레이 -->
                <Grid Background="#CC0C1117" Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="720" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="7,7,0,0">
                                <DockPanel Margin="12,6">
                                    <Button DockPanel.Dock="Right" x:Name="ClosePreview" Content="✕"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource OnPrimaryFixedBrush}" />
                                    <TextBlock Text="미리보기" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource OnPrimaryFixedBrush}" />
                                </DockPanel>
                            </Border>
                            <ContentControl Grid.Row="1" x:Name="PreviewViewModel" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 풋터 -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,9,9">
                <DockPanel Margin="14,0">
                    <Button DockPanel.Dock="Right" x:Name="Close" Content="닫기" Width="90" VerticalAlignment="Center" />
                    <TextBlock Text="보고서 콘솔 (GOP)" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
