<Window x:Class="Ironwall.Dotnet.Libraries.ViewModel.Views.Splash.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Image Source="pack://application:,,,/Resources/Images/SplashScreen.png" Stretch="UniformToFill"/>
        <Border Background="#AA1B2631"/>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Grid.Row="0"
                   Source="pack://application:,,,/Resources/Images/Company_Logo.png"
                   Width="100" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.9"/>
            <StackPanel Grid.Row="0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding ProductName}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="#AAFFFFFF"/>
            </StackPanel>
            <ProgressBar Grid.Row="1" Value="{Binding ProgressValue, Mode=OneWay}"
                         Minimum="0" Maximum="100" Height="12"
                         Foreground="#FF007ACC" Background="#44FFFFFF"/>
            <TextBlock Grid.Row="3" Text="{Binding Message}" FontSize="11" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
