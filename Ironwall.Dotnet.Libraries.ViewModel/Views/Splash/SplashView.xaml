<Window
	x:Class="Ironwall.Dotnet.Libraries.ViewModel.Views.Splash.SplashView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Width="520"
	AllowsTransparency="True"
	Background="Transparent"
	ResizeMode="NoResize"
	ShowInTaskbar="False"
	SizeToContent="Height"
	Title="시작하는 중"
	Topmost="True"
	WindowStartupLocation="CenterScreen"
	WindowStyle="None">
	<!--
		기동 화면 — B8(window-design-inventory #6). 커널 다이얼로그 카드와 같은 모양(표면 · 흐린 글자색 테두리 · 모서리 10 · 그림자).
		옛 모양: 사진 전체에 검정 반투명 막 + 흰 글씨 고정 — 테마와 무관하게 늘 어두웠다.
		이제 사진은 위쪽 띠로만 두고(사진은 원래 어두운 그림이라 막을 씌우지 않는다), 글 · 진행 막대는 표면 토큰 위에 둔다 —
		색은 전부 DynamicResource 토큰이라 라이트 · 다크 어느 쪽이든 읽힌다(앱 리소스는 이 창이 뜨기 전에 이미 병합돼 있다).
		그림은 코드 숨김이 불러 준다(Art · Logo) — 못 불러도 창은 뜬다(띠는 가라앉은 표면색으로 남는다).
	-->
	<Border
		Margin="12"
		Background="{DynamicResource SurfaceBrush}"
		BorderBrush="{DynamicResource TextMutedBrush}"
		BorderThickness="1"
		CornerRadius="10">
		<Border.Effect>
			<DropShadowEffect
				BlurRadius="18"
				Direction="270"
				Opacity="0.28"
				ShadowDepth="4"
				Color="Black" />
		</Border.Effect>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="200" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  ① 그림 띠 — 위 두 모서리만 둥글게(카드 폭 520 − 여백 24 − 테두리 2 = 494)  -->
			<Grid Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}">
				<Grid.Clip>
					<PathGeometry Figures="M0,9 A9,9 0 0 1 9,0 L485,0 A9,9 0 0 1 494,9 L494,200 L0,200 Z" />
				</Grid.Clip>
				<!--  위 끝에 맞춘다 — 사진 위쪽 띠에 제품 표지(IRON WALL)가 있다  -->
				<Image
					VerticalAlignment="Top"
					Source="{Binding Art, RelativeSource={RelativeSource AncestorType=Window}}"
					Stretch="UniformToFill" />
			</Grid>

			<!--  ② 상태 — 이름 · 판 · 진행 · 지금 하는 일  -->
			<Border
				Grid.Row="1"
				Padding="20,14,20,16"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<StackPanel>
					<DockPanel LastChildFill="True">
						<Image
							Height="24"
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							DockPanel.Dock="Right"
							Source="{Binding Logo, RelativeSource={RelativeSource AncestorType=Window}}"
							Stretch="Uniform" />
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								FontSize="17"
								FontWeight="Bold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding ProductName}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock
								Margin="0,2,0,0"
								FontSize="12"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{Binding VersionText, StringFormat=버전 {0}}" />
						</StackPanel>
					</DockPanel>

					<!--
						진행 막대 — 템플릿을 여기서 둔다. 앱의 암시적 MD 막대는 값이 바뀔 때마다 미끄러지는 애니메이션이라
						기동 중 잦은 보고에 늘 뒤처져 보였고, 바탕 · 채움 색도 MD 팔레트를 따랐다(토큰이 아니다).
					-->
					<ProgressBar
						Height="6"
						Margin="0,14,0,0"
						Background="{DynamicResource SurfaceSunkenBrush}"
						Foreground="{DynamicResource PrimaryBrush}"
						Maximum="100"
						Minimum="0"
						Value="{Binding ProgressValue, Mode=OneWay}">
						<ProgressBar.Template>
							<ControlTemplate TargetType="ProgressBar">
								<Grid>
									<Border
										x:Name="PART_Track"
										Background="{TemplateBinding Background}"
										CornerRadius="3" />
									<Border
										x:Name="PART_Indicator"
										HorizontalAlignment="Left"
										Background="{TemplateBinding Foreground}"
										CornerRadius="3" />
								</Grid>
							</ControlTemplate>
						</ProgressBar.Template>
					</ProgressBar>

					<DockPanel Margin="0,8,0,0" LastChildFill="True">
						<TextBlock
							Margin="12,0,0,0"
							DockPanel.Dock="Right"
							FontSize="12.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding PercentText}" />
						<TextBlock
							FontSize="12.5"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding Message}"
							TextTrimming="CharacterEllipsis" />
					</DockPanel>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</Window>
