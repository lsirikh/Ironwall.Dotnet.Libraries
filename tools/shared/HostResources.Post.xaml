<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--
		D-28 / D-2026-09-23 — shared preview-tool resource stack, part 2 of 2 (see HostResources.Pre.xaml
		for part 1 and the MahApps.Metro / BundledTheme split rationale).

		Mirrors the host app's App.xaml VERBATIM, in the host's order, from MaterialDesign3.Defaults.xaml
		through Theme.Current.xaml (C:\workspace_app\Dotnet.Monitoring.Solution\Dotnet.Monitoring.Solution\App.xaml:28-41).

		Linked (not copied) into every tools/*-console-preview project and console-gallery — see
		HostResources.Pre.xaml for the full D-28 rationale and the phantom-defect evidence.

		Deliberately STOPS at Theme.Current.xaml and OMITS
		pack://application:,,,/Dotnet.Monitoring.Solution;component/Resources/ResourceDictionary.xaml
		(host App.xaml:45) — that assembly IS the host app itself; tools must never load it. A preview that
		needs one of that dictionary's app-local keys (e.g. AccountsConsolePreview needs "TextBoxInput"
		because AccountConsolePanelView looks it up as a StaticResource) re-declares just that key locally
		in its own App.xaml instead of silently faking or loading the host assembly.
	-->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ProgressBar.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Flipper.xaml" />
		<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Card.xaml" />
		<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Theme;component/Themes/Theme.Current.xaml" />
	</ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
