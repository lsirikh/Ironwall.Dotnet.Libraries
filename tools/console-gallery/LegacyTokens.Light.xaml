<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--  측정용 "고치기 전" 토큰 (라이트) — 도구 전용. 제품에서는 아무도 병합하지 않는다.  -->
	<SolidColorBrush x:Key="BorderBrush" Color="#8FA0B3" />
	<SolidColorBrush x:Key="DividerBrush" Color="#B4C0CE" />
	<SolidColorBrush x:Key="RowLineBrush" Color="#B4C0CE" />
	<SolidColorBrush x:Key="TintWarningBrush" Color="#22B26A00" />
</ResourceDictionary>
