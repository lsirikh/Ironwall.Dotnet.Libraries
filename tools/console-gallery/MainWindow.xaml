<Window
	x:Class="ConsoleGallery.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:d="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	Title="콘솔 커널 갤러리 — 가짜 데이터 · 서버 호출 0"
	Width="1500"
	Height="900"
	Background="{DynamicResource BgBrush}"
	WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<Style x:Key="Chip" TargetType="Border">
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="Padding" Value="10,4" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>
		<Style x:Key="FieldBox" TargetType="TextBox">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>
	</Window.Resources>

	<DockPanel>
		<!--  무대 조작: 창 폭(세 배치) · 테마 · 상세 여섯 상태  -->
		<Border
			Padding="12,8"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top">
			<WrapPanel>
				<TextBlock
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="콘솔 폭" />
				<Slider
					x:Name="WidthSlider"
					Width="260"
					Margin="8,0"
					VerticalAlignment="Center"
					IsSnapToTickEnabled="True"
					Maximum="1460"
					Minimum="700"
					TickFrequency="10"
					Value="1280" />
				<TextBlock
					x:Name="WidthText"
					Width="200"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					Foreground="{DynamicResource TextPrimaryBrush}" />
				<Button
					Margin="4,0"
					Padding="10,3"
					Click="OnToggleTheme"
					Content="라이트 / 다크" />
				<CheckBox
					x:Name="ReadOnlyCheck"
					Margin="12,0"
					VerticalAlignment="Center"
					Click="OnReadOnlyChanged"
					Content="읽기 전용(권한 없음)"
					Foreground="{DynamicResource TextPrimaryBrush}" />
				<TextBlock
					Margin="12,0,6,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="상세 상태:" />
				<Button Margin="2,0" Padding="8,3" Click="OnStateNone" Content="선택 없음" />
				<Button Margin="2,0" Padding="8,3" Click="OnStateSingle" Content="한 개" />
				<Button Margin="2,0" Padding="8,3" Click="OnStateMultiple" Content="여러 개" />
				<Button Margin="2,0" Padding="8,3" Click="OnStateCreate" Content="새로 등록" />
				<Button Margin="2,0" Padding="8,3" Click="OnStateDirty" Content="미적용 변경" />
			</WrapPanel>
		</Border>

		<Border
			x:Name="Stage"
			Width="1282"
			Height="762"
			Margin="16"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1">
			<c:ConsoleShell
				x:Name="Shell"
				Title="장비"
				ConsoleKey="Gallery"
				IsDetailRequested="{Binding Detail.IsDetailRequested}"
				Subtitle="{Binding Detail.TypeName}">
				<c:ConsoleShell.Rail>
					<c:ConsoleRail
						ConsoleKey="Gallery"
						IsCompact="{Binding IsRailCompact, ElementName=Shell}"
						ItemsSource="{Binding Rail}"
						SelectionChanged="OnRailChanged"
						SelectedItem="{Binding ActiveRail, Mode=TwoWay}">
						<c:ConsoleRail.Footer>
							<StackPanel>
								<TextBlock FontSize="12.5"><Run Text="전체 " /><Run FontWeight="SemiBold" Text="{Binding TotalCount, Mode=OneWay}" /><Run Text="대" /></TextBlock>
								<TextBlock FontSize="12.5" Foreground="{DynamicResource StatusCriticalBrush}"><Run Text="장애 " /><Run FontWeight="SemiBold" Text="{Binding BadCount, Mode=OneWay}" /><Run Text="대" /></TextBlock>
							</StackPanel>
						</c:ConsoleRail.Footer>
					</c:ConsoleRail>
				</c:ConsoleShell.Rail>

				<c:ConsoleShell.Toolbar>
					<c:ConsoleToolbar
						AddClick="OnAdd"
						CanAdd="{Binding CanEdit}"
						CanDelete="{Binding CanDelete}"
						ColumnsText="열 6/9"
						ConsoleKey="Gallery"
						DeleteClick="OnDelete"
						DeleteDisabledReason="{Binding DeleteReason}"
						RefreshClick="OnRefresh"
						SearchPlaceholder="장비번호·이름 검색"
						SearchText="{Binding Search, Mode=TwoWay}" />
				</c:ConsoleShell.Toolbar>

				<c:ConsoleShell.List>
					<DataGrid
						x:Name="DeviceGrid"
						IsReadOnly="True"
						ItemsSource="{Binding Rows}"
						PreviewMouseLeftButtonDown="OnGridPreviewMouseDown"
						SelectionChanged="OnSelectionChanged"
						Style="{StaticResource Console.DataGrid}">
						<b:Interaction.Behaviors>
							<!--  장비 N건 → 그룹 · 부대 · 서버. 같은 일은 상세 칸의 "소속" 편집으로도 된다.  -->
							<d:CaptureDragBehavior
								DisplayMemberPath="Name"
								Handler="{Binding}"
								IsDragEnabled="{Binding CanEdit}"
								KeyboardFallback="상세 칸 '소속' 편집" />
						</b:Interaction.Behaviors>
						<DataGrid.Columns>
							<DataGridTemplateColumn Width="26" CellStyle="{StaticResource Console.DataGrid.Cell.Flush}">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<d:DragHandle AutomationProperties.AutomationId="{Binding Number, StringFormat=Console.Gallery.DragHandle.{0}}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn Width="70" Binding="{Binding Status}" Header="상태" />
							<DataGridTextColumn Width="90" Binding="{Binding Number}" Header="장비번호" />
							<DataGridTextColumn Width="*" Binding="{Binding Name}" Header="장비명" />
							<DataGridTextColumn Width="110" Binding="{Binding Kind}" Header="종류" />
							<DataGridTextColumn Width="110" Binding="{Binding Unit}" Header="부대" />
							<DataGridTextColumn Width="110" Binding="{Binding Group}" Header="그룹" />
						</DataGrid.Columns>
					</DataGrid>
				</c:ConsoleShell.List>

				<c:ConsoleShell.StatusBar>
					<Border
						Padding="12,6"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,1,0,0">
						<StackPanel>
							<!--  놓을 곳 — 끄는 동안 형태로 가능 · 불가를 보인다  -->
							<DockPanel LastChildFill="True">
								<TextBlock
									Width="44"
									Margin="0,5,0,0"
									VerticalAlignment="Top"
									DockPanel.Dock="Left"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="놓을 곳" />
								<ItemsControl ItemsSource="{Binding Zones}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<d:DropZoneChrome
												Margin="0,2,6,2"
												d:DropZone.Key="{Binding ZoneKey}"
												CornerRadius="12">
												<Border Margin="0" Style="{StaticResource Chip}">
													<TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding Label}" />
												</Border>
											</d:DropZoneChrome>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</DockPanel>
							<!--  Draft 트레이 — N회 호출은 쌓았다가 [적용]  -->
							<DockPanel Margin="0,6,0,0" LastChildFill="True">
								<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
									<Button
										Padding="10,2"
										Click="OnDraftRevert"
										Content="되돌리기"
										IsEnabled="{Binding Tray.CanRevert}"
										Style="{StaticResource Console.Button}" />
									<Button
										Margin="6,0,0,0"
										Padding="10,2"
										Click="OnDraftApply"
										Content="적용"
										IsEnabled="{Binding Tray.CanApply}"
										Style="{StaticResource Console.Button.Primary}" />
								</StackPanel>
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding Tray.Message}" />
							</DockPanel>
							<ItemsControl ItemsSource="{Binding Tray.Entries}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
											<Run Text="{Binding CallKind, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Description, Mode=OneWay}" />
										</TextBlock>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</c:ConsoleShell.StatusBar>

				<c:ConsoleShell.Detail>
					<c:ConsoleDetailHost
						ApplyClick="OnApply"
						ApplyText="{Binding Detail.ApplyText}"
						Banner="{Binding Detail.Banner}"
						CanApply="{Binding Detail.CanApply}"
						CanRevert="{Binding Detail.CanRevert}"
						ConsoleKey="Gallery"
						DetailWidth="{Binding DetailWidth, ElementName=Shell, Mode=TwoWay}"
						FooterText="{Binding Detail.FooterText}"
						IsDirty="{Binding Detail.IsDirty}"
						IsReadOnly="{Binding Detail.IsReadOnly}"
						Kind="{Binding Detail.Kind}"
						RevertClick="OnRevert"
						RevertText="{Binding Detail.RevertText}"
						ShakeToken="{Binding Detail.ShakeToken}"
						ShowButtons="{Binding Detail.ShowButtons}"
						ShowWidthTools="{Binding IsDetailDocked, ElementName=Shell}"
						Title="{Binding Detail.Title}">
						<StackPanel x:Name="Form" IsEnabled="{Binding IsFormEnabled}">
							<c:ConsoleSection Margin="0" Header="장비 공통">
								<StackPanel>
									<c:ConsoleField
										ApiName="category_device"
										Header="카테고리"
										IsLocked="True"
										Note="경로가 정본 · 불변">
										<TextBlock VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding ActiveRail.Key}" />
									</c:ConsoleField>
									<c:ConsoleField x:Name="NumberField" ApiName="number_device" Header="장비번호">
										<TextBox x:Name="NumberBox" Style="{StaticResource FieldBox}" TextChanged="OnFieldChanged" Tag="number_device" />
									</c:ConsoleField>
									<c:ConsoleField x:Name="NameField" ApiName="name_device" Header="이름">
										<TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" TextChanged="OnFieldChanged" Tag="name_device" />
									</c:ConsoleField>
									<c:ConsoleField x:Name="UnitField" ApiName="unit_id" Header="부대">
										<TextBox x:Name="UnitBox" Style="{StaticResource FieldBox}" TextChanged="OnFieldChanged" Tag="unit_id" />
									</c:ConsoleField>
								</StackPanel>
							</c:ConsoleSection>

							<!--  순서 드래그 — 부품 목록. 같은 일은 Alt+↑↓.  -->
							<c:ConsoleSection AxisName="hardware_spec.components[]" CountText="{Binding Parts.Count}" Header="부품">
								<ListBox
									x:Name="PartsList"
									d:DropZone.IsReorder="True"
									d:DropZone.Key="parts"
									ItemsSource="{Binding Parts}"
									Style="{StaticResource Console.ReorderList}">
									<b:Interaction.Behaviors>
										<d:CaptureDragBehavior Handler="{Binding}" KeyboardFallback="Alt+↑↓" />
										<d:ReorderKeyboardBehavior Handler="{Binding}" />
									</b:Interaction.Behaviors>
									<ListBox.ItemTemplate>
										<DataTemplate>
											<DockPanel Height="30">
												<d:DragHandle DockPanel.Dock="Left" />
												<TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding}" />
											</DockPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</c:ConsoleSection>

							<c:ConsoleSection AxisName="device_status" Header="상태 축" TagKind="Observed">
								<c:NotReceivedBox ReloadHint="GET /api/devices/cameras/12" SectionName="device_status" />
							</c:ConsoleSection>

							<c:ConsoleSection AxisName="device_config" Header="설정 축" TagKind="Intent">
								<TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="비어 있습니다 ({}) — 네 키 골격은 항상 실립니다" TextWrapping="Wrap" />
							</c:ConsoleSection>
						</StackPanel>
					</c:ConsoleDetailHost>
				</c:ConsoleShell.Detail>
			</c:ConsoleShell>
		</Border>
	</DockPanel>
</Window>
