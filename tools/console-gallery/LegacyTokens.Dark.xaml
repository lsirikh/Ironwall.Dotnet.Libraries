<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--  측정용 "고치기 전" 토큰 (다크) — 도구 전용. 제품에서는 아무도 병합하지 않는다.  -->
	<SolidColorBrush x:Key="BorderBrush" Color="#2C3A48" />
	<SolidColorBrush x:Key="DividerBrush" Color="#243140" />
	<SolidColorBrush x:Key="RowLineBrush" Color="#243140" />
	<SolidColorBrush x:Key="TintWarningBrush" Color="#33FFB02E" />
</ResourceDictionary>
