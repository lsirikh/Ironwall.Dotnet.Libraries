<Application
	x:Class="AccountsConsolePreview.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	Startup="OnStartup">
	<Application.Resources>
		<ResourceDictionary>
			<!--  Same order as the host App.xaml: MDIX bundle, MD3 defaults, then the Ironwall theme (tokens + console styles).  -->
			<ResourceDictionary.MergedDictionaries>
				<md:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Amber" />
				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
				<ResourceDictionary Source="pack://application:,,,/Ironwall.Dotnet.Libraries.Theme;component/Themes/Theme.Current.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!--
				호스트 앱에만 있는 스타일 — 라이브러리 뷰(AccountSetupPanelView)가 이것을 StaticResource 로 찾는다.
				미리보기에는 호스트가 없으므로 같은 이름의 최소 대역을 둔다(보고서의 커널/호스트 공백 항목).
			-->
			<Style x:Key="TextBoxInput" TargetType="TextBox">
				<Setter Property="Height" Value="30" />
				<Setter Property="Padding" Value="6,0" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
				<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
