<Application
	x:Class="AccountsConsolePreview.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	Startup="OnStartup">
	<Application.Resources>
		<ResourceDictionary>
			<!--
				D-28 (2026-09-23): merges the HOST's exact list (MahApps → BundledTheme → MD3 defaults/MDIX → Theme.Current),
				not an approximation of it — see tools/shared/HostResources.Pre.xaml and .Post.xaml for the line-by-line
				mapping to Dotnet.Monitoring.Solution/App.xaml and why this used to be MDIX-only (phantom teal-block /
				Path-text defect). BundledTheme stays local (not in the shared files) so App.xaml.cs's ApplyDark() can
				still find it via Resources.MergedDictionaries.OfType<BundledTheme>().
			-->
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="HostResources.Pre.xaml" />
				<md:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="Amber" />
				<ResourceDictionary Source="HostResources.Post.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!--
				호스트 앱에만 있는 스타일 — 라이브러리 뷰(AccountSetupPanelView)가 이것을 StaticResource 로 찾는다.
				미리보기에는 호스트가 없으므로 같은 이름의 최소 대역을 둔다(보고서의 커널/호스트 공백 항목).
			-->
			<Style x:Key="TextBoxInput" TargetType="TextBox">
				<Setter Property="Height" Value="30" />
				<Setter Property="Padding" Value="6,0" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
				<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>
