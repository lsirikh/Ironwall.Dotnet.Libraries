<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Device console preview (device-console-redesign TEST-02): shows the real DeviceDashboardView + view model on fake data,
    with no host app and no server. Run: dotnet run  |  snapshots: dotnet run (two dashes)snapshot <folder>
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>DeviceConsolePreview</RootNamespace>
    <AssemblyName>DeviceConsolePreview</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Ironwall.Dotnet.Libraries.Devices.Ui\Ironwall.Dotnet.Libraries.Devices.Ui.csproj" />
    <ProjectReference Include="..\..\Ironwall.Dotnet.Libraries.Theme\Ironwall.Dotnet.Libraries.Theme.csproj" />
  </ItemGroup>

</Project>
