<Window
    x:Class="Ironwall.Dotnet.Libraries.Gateway.Views.GatewayGroupPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://caliburnmicro.com"
    Title="그룹 선택"
    Width="300"
    Height="400"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Items}" BorderThickness="1" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Width="72" Margin="0,0,8,0"
                    cal:Message.Attach="[Event Click] = [Action Confirm]" />
            <Button Content="취소" Width="72"
                    cal:Message.Attach="[Event Click] = [Action Cancel]" />
        </StackPanel>
    </Grid>
</Window>
