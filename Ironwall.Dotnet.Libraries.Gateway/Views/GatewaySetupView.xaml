<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Gateway.Views.GatewaySetupView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Gateway.Behaviors"
	xmlns:console="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:converter="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="{DynamicResource SurfaceBrush}"
	d:Height="600"
	d:Width="900"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<!--
		외부 연동 이벤트 — 설정 콘솔의 [외부 연동] 절이 LegacyContent 로 그대로 얹는 뷰(호스트 SettingsCatalog.GatewaySection).
		B10(window-design-inventory-analysis.md #18a) — 둘레(설정 콘솔)와 단추 넷은 커널인데 목록 · 칸 · 상태 줄이 MDIX 기본(밑줄 칸 · Teal 스피너 ·
		고정 색 숫자)이었다. 이제 콘솔 말로 쓴다 — ConsoleSection(절) · Console.DataGrid(행 38 · 정렬/열 이동 끔) · Console.CheckBox · 토큰 글 칸.
		지키는 것: 동작 배선(ButtonClickBehavior · 선택 동기화 · Esc 선택 해제) · 바인딩 전부 · 상태 줄의 "전체 개수" 글(호스트 SetupSweep T-SET018 앵커).
		색은 토큰만 — 숫자를 색으로 가르지 않는다(굵기로).
	-->

	<UserControl.Resources>
		<!--  뷰 전체 DataContext(ViewModel)를 상속받아서 Data 에 할당  -->
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		<converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converter:BoolToInverseVisibleConverter x:Key="BoolToInverseVisibleConverter" />

		<!--
			목록 칸 안의 글 칸(고칠 때) — 콘솔 입력 규격의 토큰 판(가라앉은 판 · 포커스 윤곽 색 테두리). 명시 스타일이라 앱의 MDIX 밑줄 칸이 끊긴다.
			템플릿은 주지 않는다 — 템플릿 부품 이름(PART_ContentHost)을 이 뷰에 새로 들이지 않으려고(x:Name 불변 규칙). 테두리 · 판 · 글은 아래 토큰을 그대로 그린다.
		-->
		<Style x:Key="Gw.CellTextBox" TargetType="TextBox">
			<Setter Property="Height" Value="28" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
		</Style>

		<Style
			x:Key="Gw.CellText.Center"
			BasedOn="{StaticResource Console.DataGrid.CellText}"
			TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center" />
		</Style>

		<Style x:Key="Gw.Status.Label" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		</Style>

		<Style x:Key="Gw.Status.Count" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="6,0,2,0" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
	</UserControl.Resources>

	<console:ConsoleSection Margin="0,4,0,0" Header="연동 이벤트">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="8" />
				<RowDefinition Height="290" />
				<RowDefinition Height="8" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--
				상단 버튼 — S16(설정 창 '외부 연동' 절): 예전에는 글자 없는 아이콘 넷(도움말 "추가하기/삭제하기/갱신하기/저장하기")이
				고정 폭 칸에 흩어져 있어 무슨 단추인지 눌러 봐야 알았다. 커널 테두리 단추(높이 32) + 아이콘 + 한국어 글자로 오른쪽에 모은다.
				동작 배선(ButtonClickBehavior)은 그대로다.
			-->
			<StackPanel
				Grid.Row="0"
				HorizontalAlignment="Right"
				Orientation="Horizontal">
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="연동 이벤트를 한 줄 추가합니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickInsertButton" />
					</i:Interaction.Behaviors>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Kind="Plus" />
						<TextBlock VerticalAlignment="Center" Text="추가" />
					</StackPanel>
				</Button>
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="고른 연동 이벤트를 지웁니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickDeleteButton" />
					</i:Interaction.Behaviors>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Kind="Delete" />
						<TextBlock VerticalAlignment="Center" Text="삭제" />
					</StackPanel>
				</Button>
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="목록을 다시 불러옵니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickReloadButton" />
					</i:Interaction.Behaviors>
					<Grid>
						<ProgressBar
							Width="16"
							Height="16"
							Foreground="{DynamicResource PrimaryBrush}"
							IsIndeterminate="True"
							Style="{DynamicResource MaterialDesignCircularProgressBar}"
							Visibility="{Binding ReloadButtonEnable, Converter={StaticResource BoolToInverseVisibleConverter}}" />
						<StackPanel Orientation="Horizontal" Visibility="{Binding ReloadButtonEnable, Converter={StaticResource BooleanToVisibilityConverter}}">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Kind="Refresh" />
							<TextBlock VerticalAlignment="Center" Text="새로 고침" />
						</StackPanel>
					</Grid>
				</Button>
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="바꾼 내용을 바로 저장합니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickSaveButton" />
					</i:Interaction.Behaviors>
					<Grid>
						<ProgressBar
							Width="16"
							Height="16"
							Foreground="{DynamicResource PrimaryBrush}"
							IsIndeterminate="True"
							Style="{DynamicResource MaterialDesignCircularProgressBar}"
							Visibility="{Binding SaveButtonEnable, Converter={StaticResource BoolToInverseVisibleConverter}}" />
						<StackPanel Orientation="Horizontal" Visibility="{Binding SaveButtonEnable, Converter={StaticResource BooleanToVisibilityConverter}}">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Kind="ContentSave" />
							<TextBlock VerticalAlignment="Center" Text="저장" />
						</StackPanel>
					</Grid>
				</Button>
			</StackPanel>

			<!--  목록 — 콘솔 목록 판(테두리 1 · 반경 4) 안에 커널 그리드  -->
			<Border
				Grid.Row="2"
				Background="{DynamicResource SurfaceBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<Grid>
					<!--  불러오는 중 — 스피너는 토큰 색(Teal 기본값을 끊는다)  -->
					<ProgressBar
						Width="28"
						Height="28"
						Foreground="{DynamicResource PrimaryBrush}"
						IsIndeterminate="True">
						<ProgressBar.Style>
							<Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding ReloadButtonEnable}" Value="False">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ProgressBar.Style>
					</ProgressBar>

					<DataGrid
						CanUserAddRows="False"
						CanUserDeleteRows="False"
						ItemsSource="{Binding ViewModelProvider}"
						SelectionMode="Extended"
						Style="{StaticResource Console.DataGrid}"
						Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
						<i:Interaction.Behaviors>
							<behavior:ClearSelectionOnEscBehavior />
							<behavior_inner:GatewayEventSelectedItemsBehavior SelectedItems="{Binding SelectedItems, Mode=TwoWay}" />
						</i:Interaction.Behaviors>

						<DataGrid.Columns>
							<!--  번호  -->
							<DataGridTextColumn
								Width="60"
								Binding="{Binding Index}"
								ElementStyle="{StaticResource Gw.CellText.Center}"
								Header="번호"
								IsReadOnly="True" />

							<!--  이벤트명  -->
							<DataGridTemplateColumn Width="2*" Header="이벤트명">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Style="{StaticResource Console.DataGrid.CellText}" Text="{Binding EventName}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
								<DataGridTemplateColumn.CellEditingTemplate>
									<DataTemplate>
										<TextBox Style="{StaticResource Gw.CellTextBox}" Text="{Binding EventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellEditingTemplate>
							</DataGridTemplateColumn>

							<!--  그룹  -->
							<DataGridTemplateColumn Width="140" Header="그룹">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Style="{StaticResource Gw.CellText.Center}" Text="{Binding GroupNames}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
								<DataGridTemplateColumn.CellEditingTemplate>
									<DataTemplate>
										<ComboBox
											Height="28"
											VerticalAlignment="Center"
											DisplayMemberPath="Name"
											FontSize="13"
											Foreground="{DynamicResource TextPrimaryBrush}"
											IsEditable="False"
											ItemsSource="{Binding Data.AllDeviceGroups, Source={StaticResource proxy}}"
											SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellEditingTemplate>
							</DataGridTemplateColumn>

							<!--  사용  -->
							<DataGridTemplateColumn Width="100" Header="사용">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<CheckBox
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											IsChecked="{Binding IsEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
											Style="{StaticResource Console.CheckBox}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<!--  설명  -->
							<DataGridTemplateColumn Width="3*" Header="설명">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Style="{StaticResource Console.DataGrid.CellText}" Text="{Binding Description}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
								<DataGridTemplateColumn.CellEditingTemplate>
									<DataTemplate>
										<TextBox Style="{StaticResource Gw.CellTextBox}" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</DataTemplate>
								</DataGridTemplateColumn.CellEditingTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>

					<!--  S16 — 빈 목록은 아무 안내 없는 빈 판이었다. 무엇이 비었고 무엇을 하면 되는지 말한다(불러오는 중에는 숨긴다).  -->
					<console:ConsoleEmptyState
						Margin="0,36,0,0"
						Hint="[추가]를 눌러 연동 이벤트를 만드세요"
						IsHitTestVisible="False"
						Title="등록된 연동 이벤트가 없습니다">
						<console:ConsoleEmptyState.Style>
							<Style TargetType="console:ConsoleEmptyState">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding ViewModelProvider.Count}" Value="0" />
											<Condition Binding="{Binding ReloadButtonEnable}" Value="True" />
										</MultiDataTrigger.Conditions>
										<Setter Property="Visibility" Value="Visible" />
									</MultiDataTrigger>
								</Style.Triggers>
							</Style>
						</console:ConsoleEmptyState.Style>
					</console:ConsoleEmptyState>
				</Grid>
			</Border>

			<!--  상태 줄 — 콘솔 상태 띠와 같은 판(SurfaceAlt · 구분선). 숫자는 색이 아니라 굵기로.  -->
			<Border
				Grid.Row="4"
				Padding="12,6"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<StackPanel Orientation="Horizontal">
					<TextBlock Style="{StaticResource Gw.Status.Label}" Text="선택 개수" />
					<TextBlock Style="{StaticResource Gw.Status.Count}" Text="{Binding SelectedItemCount}" />
					<TextBlock Style="{StaticResource Gw.Status.Label}" Text="개" />
					<Rectangle
						Width="1"
						Height="12"
						Margin="14,0"
						VerticalAlignment="Center"
						Fill="{DynamicResource DividerBrush}" />
					<TextBlock Style="{StaticResource Gw.Status.Label}" Text="전체 개수" />
					<TextBlock Style="{StaticResource Gw.Status.Count}" Text="{Binding ViewModelProvider.Count}" />
					<TextBlock Style="{StaticResource Gw.Status.Label}" Text="개" />
				</StackPanel>
			</Border>
		</Grid>
	</console:ConsoleSection>
</UserControl>
