<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Gateway.Views.GatewaySetupView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Gateway.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:console="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:converter="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Gateway.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="{DynamicResource SurfaceBrush}"
	d:Height="600"
	d:Width="900"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  뷰 전체 DataContext(ViewModel)를 상속받아서 Data 에 할당  -->
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		<converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converter:BoolToInverseVisibleConverter x:Key="BoolToInverseVisibleConverter" />
	</UserControl.Resources>

	<Grid Margin="10,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="16" />
			<RowDefinition Height="290" />
			<RowDefinition Height="10" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--
			상단 버튼 — S16(설정 창 '외부 연동' 절): 예전에는 글자 없는 아이콘 넷(도움말 "추가하기/삭제하기/갱신하기/저장하기")이
			고정 폭 칸에 흩어져 있어 무슨 단추인지 눌러 봐야 알았다. 커널 테두리 단추(높이 32) + 아이콘 + 한국어 글자로 오른쪽에 모은다.
			동작 배선(ButtonClickBehavior)은 그대로다.
		-->
		<StackPanel
			Grid.Row="0"
			Margin="0,4,0,0"
			HorizontalAlignment="Right"
			Orientation="Horizontal">
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="연동 이벤트를 한 줄 추가합니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickInsertButton" />
					</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Kind="Plus" />
							<TextBlock VerticalAlignment="Center" Text="추가" />
						</StackPanel>
				</Button>
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="고른 연동 이벤트를 지웁니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickDeleteButton" />
					</i:Interaction.Behaviors>
						<StackPanel Orientation="Horizontal">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Kind="Delete" />
							<TextBlock VerticalAlignment="Center" Text="삭제" />
						</StackPanel>
				</Button>
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="목록을 다시 불러옵니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickReloadButton" />
					</i:Interaction.Behaviors>
						<Grid>
							<ProgressBar
								Width="16"
								Height="16"
								IsIndeterminate="True"
								Style="{DynamicResource MaterialDesignCircularProgressBar}"
								Visibility="{Binding ReloadButtonEnable, Converter={StaticResource BoolToInverseVisibleConverter}}" />
							<StackPanel Orientation="Horizontal" Visibility="{Binding ReloadButtonEnable, Converter={StaticResource BooleanToVisibilityConverter}}">
								<md:PackIcon
									Width="16"
									Height="16"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Kind="Refresh" />
								<TextBlock VerticalAlignment="Center" Text="새로 고침" />
							</StackPanel>
						</Grid>
				</Button>
				<Button
					Margin="8,0,0,0"
					IsEnabled="{Binding IsButtonEnable}"
					Style="{StaticResource Console.Button}"
					ToolTip="바꾼 내용을 바로 저장합니다">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickSaveButton" />
					</i:Interaction.Behaviors>
						<Grid>
							<ProgressBar
								Width="16"
								Height="16"
								IsIndeterminate="True"
								Style="{DynamicResource MaterialDesignCircularProgressBar}"
								Visibility="{Binding SaveButtonEnable, Converter={StaticResource BoolToInverseVisibleConverter}}" />
							<StackPanel Orientation="Horizontal" Visibility="{Binding SaveButtonEnable, Converter={StaticResource BooleanToVisibilityConverter}}">
								<md:PackIcon
									Width="16"
									Height="16"
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									Kind="ContentSave" />
								<TextBlock VerticalAlignment="Center" Text="저장" />
							</StackPanel>
						</Grid>
				</Button>
		</StackPanel>

		<!--  DataGrid 및 ProgressBar 영역  -->
		<Grid Grid.Row="2">
			<!--  ProgressBar (로딩 중)  -->
			<Grid Height="300">
				<ProgressBar
					Width="100"
					Height="20"
					IsIndeterminate="True">
					<ProgressBar.Style>
                        <Style BasedOn="{StaticResource MaterialDesignCircularProgressBar}" TargetType="ProgressBar">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding ReloadButtonEnable}" Value="False">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ProgressBar.Style>
				</ProgressBar>
			</Grid>

			<!--  DataGrid  -->
			<DataGrid
				AutoGenerateColumns="False"
				CanUserAddRows="False"
				CanUserDeleteRows="False"
				Background="Transparent"
				BorderThickness="1"
				ItemsSource="{Binding ViewModelProvider}"
				SelectionMode="Extended"
				Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
				<i:Interaction.Behaviors>
					<behavior:ClearSelectionOnEscBehavior />
					<behavior_inner:GatewayEventSelectedItemsBehavior SelectedItems="{Binding SelectedItems, Mode=TwoWay}" />
				</i:Interaction.Behaviors>

				<DataGrid.Columns>
					<!--  No (Index)  -->
					<DataGridTextColumn
						Width="60"
						Binding="{Binding Index}"
						Header="번호"
						IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Center" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>

					<!--  ID  -->
					<!--<DataGridTextColumn
						Width="80"
						Binding="{Binding Id}"
						Header="아이디"
						IsReadOnly="True">
						<DataGridTextColumn.ElementStyle>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Center" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
						</DataGridTextColumn.ElementStyle>
					</DataGridTextColumn>-->

					<!--  이벤트명  -->
					<DataGridTemplateColumn Width="2*" Header="이벤트명">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Text="{Binding EventName}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate>
								<TextBox VerticalAlignment="Center" Text="{Binding EventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>

					<!--  그룹  -->
					<DataGridTemplateColumn Width="140" Header="그룹">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Text="{Binding GroupNames}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate>
								<ComboBox
									IsEditable="False"
									ItemsSource="{Binding Data.AllDeviceGroups, Source={StaticResource proxy}}"
									SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
									DisplayMemberPath="Name" />
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>

					<!--  사용 (CheckBox)  -->
					<DataGridTemplateColumn Width="100" Header="사용">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									IsChecked="{Binding IsEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<!--  설명  -->
					<DataGridTemplateColumn Width="3*" Header="설명">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock
									HorizontalAlignment="Left"
									VerticalAlignment="Center"
									Text="{Binding Description}"
									TextTrimming="CharacterEllipsis" />
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
						<DataGridTemplateColumn.CellEditingTemplate>
							<DataTemplate>
								<TextBox VerticalAlignment="Center" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</DataTemplate>
						</DataGridTemplateColumn.CellEditingTemplate>
					</DataGridTemplateColumn>

				</DataGrid.Columns>
			</DataGrid>

			<!--  S16 — 빈 목록은 아무 안내 없는 빈 판이었다. 무엇이 비었고 무엇을 하면 되는지 말한다(불러오는 중에는 숨긴다).  -->
			<console:ConsoleEmptyState
				Margin="0,36,0,0"
				Hint="[추가]를 눌러 연동 이벤트를 만드세요"
				IsHitTestVisible="False"
				Title="등록된 연동 이벤트가 없습니다">
				<console:ConsoleEmptyState.Style>
					<Style TargetType="console:ConsoleEmptyState">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<MultiDataTrigger>
								<MultiDataTrigger.Conditions>
									<Condition Binding="{Binding ViewModelProvider.Count}" Value="0" />
									<Condition Binding="{Binding ReloadButtonEnable}" Value="True" />
								</MultiDataTrigger.Conditions>
								<Setter Property="Visibility" Value="Visible" />
							</MultiDataTrigger>
						</Style.Triggers>
					</Style>
				</console:ConsoleEmptyState.Style>
			</console:ConsoleEmptyState>
		</Grid>

		<!--  하단 상태 영역  -->
		<Border
			Grid.Row="4"
			Padding="10,8"
			Background="{DynamicResource SurfaceAltBrush}"
			TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1"
			CornerRadius="4">
			<StackPanel Orientation="Horizontal">
				<TextBlock
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="Medium"
					Text="선택 개수 : " />
				<TextBlock
					Margin="5,0,0,0"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="Bold"
					Foreground="{DynamicResource PrimaryBrush}"
					Text="{Binding SelectedItemCount}" />
				<TextBlock
					Margin="3,0,0,0"
					VerticalAlignment="Center"
					FontSize="14"
					Text="개" />

				<TextBlock
					Margin="30,0,0,0"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="Medium"
					Text="전체 개수 : " />
				<TextBlock
					Margin="5,0,0,0"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="Bold"
					Foreground="{DynamicResource StatusNormalBrush}"
					Text="{Binding ViewModelProvider.Count}" />
				<TextBlock
					Margin="3,0,0,0"
					VerticalAlignment="Center"
					FontSize="14"
					Text="개" />
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
