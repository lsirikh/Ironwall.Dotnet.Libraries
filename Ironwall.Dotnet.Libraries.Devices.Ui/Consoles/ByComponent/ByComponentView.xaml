<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.ByComponent.ByComponentView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="600"
	d:DesignWidth="900"
	AutomationProperties.AutomationId="Console.Devices.ByComponent"
	mc:Ignorable="d">
	<!--
		"부품으로 찾기" 탭 (FR-17) — 읽기 전용 조회 화면.
		· 필터 3종(유형 콤보 · 상태 칩 · 건강 칩)은 전부 SelectionChanged 에서 SearchAsync 를 직접 부른다
		  (ByComponentViewModel 의 프로퍼티 세터는 값만 바꾸고 스스로 서버를 부르지 않는다 — VM 의 remarks 참조).
		· 칩은 색이 아니라 굵기 + 두꺼운 테두리로 선택을 표시한다(drag-first-ux.md 시각 규칙과 같은 취지).
		· DataGrid 는 고정 높이를 주지 않는다 — 행 * 로 늘어난다.
	-->
	<!--
		칩 — 커널 정본 Console.Chip.ListBoxItem(Theme/Themes/Styles.Console.xaml)을 그대로 쓴다.
		로컬 ByComponent.Chip 은 이관 후 삭제했다(U-12/U-13) — IsSelected 에서 BorderThickness 를
		1→2 로 키우고 글자도 Bold 로 얹어 두 방향으로 폭이 흔들렸다. 커널 판은 테두리를 늘 1 로
		고정하고 두꺼운 링은 레이아웃 밖 오버레이로, Bold 폭은 고스트로 미리 예약한다.
	-->
	<UserControl.Resources />
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  툴바 — 부품 유형 콤보 · 상태 칩 · 건강 칩  -->
		<Border
			Grid.Row="0"
			Padding="12,8"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1">
			<WrapPanel Orientation="Horizontal">
				<TextBlock
					Margin="0,0,6,0"
					VerticalAlignment="Center"
					FontSize="12"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="부품" />
				<ComboBox
					Width="220"
					Margin="0,0,18,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Console.Devices.ByComponent.Type"
					DisplayMemberPath="Display"
					ItemsSource="{Binding ComponentTypes}"
					SelectedItem="{Binding SelectedComponentType, Mode=TwoWay}"
					SelectionChanged="OnFilterSelectionChanged" />

				<ListBox
					Margin="0,0,18,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Console.Devices.ByComponent.States"
					BorderThickness="0"
					Background="Transparent"
					ItemContainerStyle="{StaticResource Console.Chip.ListBoxItem}"
					DisplayMemberPath="Display"
					ItemsSource="{Binding StateChips}"
					SelectedValue="{Binding SelectedState, Mode=TwoWay}"
					SelectedValuePath="Code"
					SelectionChanged="OnFilterSelectionChanged"
					SelectionMode="Single">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>

				<ListBox
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Console.Devices.ByComponent.Health"
					BorderThickness="0"
					Background="Transparent"
					DisplayMemberPath="Display"
					ItemContainerStyle="{StaticResource Console.Chip.ListBoxItem}"
					ItemsSource="{Binding HealthChips}"
					SelectedItem="{Binding SelectedHealth, Mode=TwoWay}"
					SelectionChanged="OnFilterSelectionChanged"
					SelectionMode="Single">
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
				</ListBox>
			</WrapPanel>
		</Border>

		<!--
			결과 그리드 — 읽기 전용 7열. 정렬 · 열 재정렬은 Console.DataGrid 스타일이 이미 끈다.
			열마다 CellStyle 을 <b>직접</b> 건다 — 비워 두면 MDIX 의 암시적 DataGridCell 스타일이 이겨
			고른 행이 회색 칸으로 갈라진다(K-07).
		-->
		<Grid Grid.Row="1">
			<DataGrid
				AutomationProperties.AutomationId="Console.Devices.ByComponent.Grid"
				IsReadOnly="True"
				ItemsSource="{Binding Rows}"
				Style="{StaticResource Console.DataGrid}">
			<DataGrid.Columns>
				<!--  U-18 D-4 4.5 — 장비 열이 남은 폭을 받고 이름은 말줄임 + 툴팁(예전: 140 고정 · 잘림 · 가로 스크롤).  -->
				<DataGridTemplateColumn
					Width="*"
					MinWidth="80"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="장비">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<DockPanel LastChildFill="True">
								<TextBlock
									VerticalAlignment="Center"
									DockPanel.Dock="Left"
									FontFamily="{DynamicResource MonoFont}"
									Text="{Binding DeviceNumber}" />
								<TextBlock
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									Text="{Binding DeviceName}"
									TextTrimming="CharacterEllipsis"
									ToolTip="{Binding DeviceName}" />
							</DockPanel>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTextColumn
					Width="90"
					Binding="{Binding CategoryText}"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="카테고리" />
				<!--  부품 이름 = label → 카탈로그 한글 → 내장 사전 → key(공용 부품 사전, component-display-unify FR-01). key 원문은 툴팁.  -->
				<DataGridTextColumn
					Width="120"
					Binding="{Binding ComponentName}"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="부품 이름">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="TextTrimming" Value="CharacterEllipsis" />
							<Setter Property="ToolTip" Value="{Binding ComponentKey}" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn
					Width="90"
					Binding="{Binding StateText}"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="상태">
					<!--  모르는 상태는 "알 수 없음 (원문)" — 원문을 숨기지 않는다(공용 부품 사전). 툴팁에도 받은 값.  -->
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="ToolTip" Value="{Binding StateTooltip}" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTemplateColumn
					Width="100"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="건강">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<!--
								배지 글자에 지역 Foreground 를 두지 않는다 — 지역 값은 Console.Pill 이 물려 주는
								TextElement.Foreground 를 이겨, 커널이 토큰을 고쳐도 아무 일도 일어나지 않는다.
								뜻은 점(Console.Pill.Dot)과 테두리가 나른다.
							-->
							<Border x:Name="Pill" Style="{StaticResource Console.Pill}">
								<StackPanel Orientation="Horizontal">
									<Ellipse x:Name="Dot" Style="{StaticResource Console.Pill.Dot}" />
									<TextBlock VerticalAlignment="Center" Text="{Binding HealthText}" />
								</StackPanel>
							</Border>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding HealthKind}" Value="Ok">
									<Setter TargetName="Pill" Property="Style" Value="{StaticResource Console.Pill.Normal}" />
									<Setter TargetName="Dot" Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding HealthKind}" Value="Warn">
									<Setter TargetName="Pill" Property="Style" Value="{StaticResource Console.Pill.Warning}" />
									<Setter TargetName="Dot" Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
								</DataTrigger>
								<DataTrigger Binding="{Binding HealthKind}" Value="Crit">
									<Setter TargetName="Pill" Property="Style" Value="{StaticResource Console.Pill.Critical}" />
									<Setter TargetName="Dot" Property="Fill" Value="{DynamicResource StatusCriticalBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<!--  사유(FR-03) — 고장 · 저하일 때만. 서버 행에는 사유가 없어 장비 캐시의 관측에서 읽는다.  -->
				<DataGridTextColumn
					Width="110"
					Binding="{Binding FaultReason}"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="사유">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="TextTrimming" Value="CharacterEllipsis" />
							<Setter Property="ToolTip" Value="{Binding FaultReason}" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
				<DataGridTextColumn
					Width="150"
					MinWidth="150"
					Binding="{Binding LastChangeText}"
					CellStyle="{StaticResource Console.DataGrid.Cell}"
					Header="마지막 변화">
					<DataGridTextColumn.ElementStyle>
						<Style TargetType="TextBlock">
							<Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter Property="TextTrimming" Value="CharacterEllipsis" />
							<Setter Property="ToolTip" Value="{Binding LastChangeText}" />
						</Style>
					</DataGridTextColumn.ElementStyle>
				</DataGridTextColumn>
			</DataGrid.Columns>
			</DataGrid>

			<!--
				빈 결과 — 몸통이 통째로 비면(잉크 0.0% 실측) 왜 비었는지 30px 상태 줄 하나만 설명하게 된다.
				자리는 커널의 ConsoleEmptyState 가 만든다 — 문구만 이 창이 넣는다.
			-->
			<c:ConsoleEmptyState
				AutomationProperties.AutomationId="Console.Devices.ByComponent.Empty"
				Glyph="M9.5,3 A6.5,6.5 0 0,1 16,9.5 A6.5,6.5 0 0,1 9.5,16 A6.5,6.5 0 0,1 3,9.5 A6.5,6.5 0 0,1 9.5,3 M14.2,14.2 L20,20"
				Hint="부품 유형이나 상태 · 건강 칩을 바꿔 보세요"
				IsHitTestVisible="False"
				Title="{Binding StatusText}">
				<c:ConsoleEmptyState.Style>
					<Style BasedOn="{StaticResource {x:Type c:ConsoleEmptyState}}" TargetType="c:ConsoleEmptyState">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding Rows.Count}" Value="0">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</c:ConsoleEmptyState.Style>
			</c:ConsoleEmptyState>
		</Grid>

		<!--  상태 줄 — "조건에 맞는 부품 N건" / "조건에 맞는 부품이 없습니다" / 오류 문장.  -->
		<Border
			Grid.Row="2"
			Padding="12,6"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0">
			<TextBlock
				AutomationProperties.AutomationId="Console.Devices.ByComponent.Status"
				FontSize="12"
				Foreground="{DynamicResource TextSecondaryBrush}"
				Text="{Binding StatusText}" />
		</Border>
	</Grid>
</UserControl>
