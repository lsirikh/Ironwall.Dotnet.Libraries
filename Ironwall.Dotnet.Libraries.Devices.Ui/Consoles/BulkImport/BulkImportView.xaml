<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.BulkImport.BulkImportView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	AutomationProperties.AutomationId="Devices.BulkImport"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		장비 대량 등록 미리보기 판(device-bulk-import) — 목록 칸 위에 덮인다. 서버에는 [등록] 때만 쓴다(Temp-state Draft).
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationId 만. 설명은 "?" 에.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<!--  칸 칩 — 보통 · 바뀐 칸(강조 테두리) · 오류(붉은 테두리 + 툴팁 사유). 색만이 아니라 테두리 굵기로도 가른다.  -->
		<Style x:Key="BulkCellChip" TargetType="Border">
			<Setter Property="Margin" Value="0,2,6,2" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsChanged}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="Background" Value="{DynamicResource TintAccentBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsError}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="Background" Value="{DynamicResource TintCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Border
		Background="{DynamicResource SurfaceBrush}"
		BorderBrush="{DynamicResource DividerBrush}"
		BorderThickness="0,0,0,1">
		<DockPanel LastChildFill="True">
			<!--  머리 — 파일 이름 · 판정 건수 · "?" · [닫기]  -->
			<DockPanel
				Margin="12,10,12,6"
				DockPanel.Dock="Top"
				LastChildFill="True">
				<Button
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.BulkImport.Close"
					Click="OnClose"
					Content="닫기"
					DockPanel.Dock="Right"
					Style="{StaticResource Console.Button.Ghost}" />
				<c:HelpTip
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					HelpKey="Devices.BulkImport" />
				<StackPanel VerticalAlignment="Center">
					<TextBlock
						AutomationProperties.AutomationId="Devices.BulkImport.FileName"
						FontSize="14"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding FileName}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						Margin="0,2,0,0"
						AutomationProperties.AutomationId="Devices.BulkImport.Summary"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding SummaryText}" />
					<TextBlock
						Margin="0,2,0,0"
						AutomationProperties.AutomationId="Devices.BulkImport.Ignored"
						FontSize="12"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="{Binding IgnoredText}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding IgnoredText}" />
				</StackPanel>
			</DockPanel>

			<!--  바닥 — 진행 · 한 줄 소식 · "오류 줄 빼고" · [결과 받기] · [실패 줄 다시] · [취소] · [등록]  -->
			<Border
				Padding="12,8"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0"
				DockPanel.Dock="Bottom">
				<DockPanel LastChildFill="True">
					<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
						<CheckBox
							Margin="0,0,12,0"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.BulkImport.ExcludeErrors"
							Content="오류 줄 빼고 등록"
							IsChecked="{Binding ExcludeErrorRows, Mode=TwoWay}"
							Style="{StaticResource Console.CheckBox}" />
						<Button
							Margin="0,0,8,0"
							AutomationProperties.AutomationId="Devices.BulkImport.SaveResult"
							Click="OnSaveResult"
							Content="결과 받기"
							IsEnabled="{Binding CanSaveResult}"
							Style="{StaticResource Console.Button}" />
						<Button
							Margin="0,0,8,0"
							AutomationProperties.AutomationId="Devices.BulkImport.Retry"
							Click="OnRetry"
							Content="실패 줄 다시"
							IsEnabled="{Binding CanRetry}"
							Style="{StaticResource Console.Button}" />
						<Button
							Margin="0,0,8,0"
							AutomationProperties.AutomationId="Devices.BulkImport.Cancel"
							Click="OnCancel"
							Content="멈추기"
							Style="{StaticResource Console.Button}"
							Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
						<Button
							AutomationProperties.AutomationId="Devices.BulkImport.Register"
							Click="OnRegister"
							Content="등록"
							IsEnabled="{Binding CanRegister}"
							Style="{StaticResource Console.Button.Primary}"
							ToolTip="{Binding RegisterBlockedReason}"
							ToolTipService.ShowOnDisabled="True" />
					</StackPanel>
					<StackPanel VerticalAlignment="Center">
						<ProgressBar
							Height="4"
							Margin="0,0,12,4"
							AutomationProperties.AutomationId="Devices.BulkImport.Progress"
							Maximum="{Binding ProgressMaximum}"
							Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
							Value="{Binding ProgressValue, Mode=OneWay}" />
						<TextBlock
							Margin="0,0,12,0"
							AutomationProperties.AutomationId="Devices.BulkImport.Status"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding StatusText}"
							TextTrimming="CharacterEllipsis"
							ToolTip="{Binding StatusText}" />
					</StackPanel>
				</DockPanel>
			</Border>

			<!--  표 — 줄 · 시트 · 판정 · 이름 · 칸 칩 · 사유/결과. 2,000 줄도 가볍게(가상화).  -->
			<ItemsControl
				AutomationProperties.AutomationId="Devices.BulkImport.Rows"
				ItemsSource="{Binding Rows}"
				VirtualizingPanel.IsVirtualizing="True"
				VirtualizingPanel.ScrollUnit="Pixel"
				VirtualizingPanel.VirtualizationMode="Recycling">
				<ItemsControl.Template>
					<ControlTemplate TargetType="ItemsControl">
						<ScrollViewer
							CanContentScroll="True"
							Focusable="False"
							HorizontalScrollBarVisibility="Disabled"
							VerticalScrollBarVisibility="Auto">
							<ItemsPresenter />
						</ScrollViewer>
					</ControlTemplate>
				</ItemsControl.Template>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<VirtualizingStackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border
							Padding="12,6"
							AutomationProperties.AutomationId="{Binding Line, StringFormat=Devices.BulkImport.Row.{0}}"
							AutomationProperties.Name="{Binding Name}"
							BorderBrush="{DynamicResource RowLineBrush}"
							BorderThickness="0,0,0,1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="48" />
									<ColumnDefinition Width="64" />
									<ColumnDefinition Width="56" />
									<ColumnDefinition Width="160" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									VerticalAlignment="Top"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding Line, StringFormat={}{0}줄}" />
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Top"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding SheetName}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									Grid.Column="2"
									VerticalAlignment="Top"
									FontSize="12"
									FontWeight="SemiBold"
									Text="{Binding VerdictText}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsError}" Value="True">
													<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<StackPanel Grid.Column="3" Margin="0,0,8,0">
									<TextBlock
										FontSize="13"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis" />
									<TextBlock
										FontSize="12"
										Text="{Binding ResultText}">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground" Value="{DynamicResource StatusNormalBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsFailed}" Value="True">
														<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</StackPanel>
								<StackPanel Grid.Column="4">
									<ItemsControl Focusable="False" ItemsSource="{Binding Cells}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Style="{StaticResource BulkCellChip}" ToolTip="{Binding ToolTipText}">
													<TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
														<Run Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Header, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Display, Mode=OneWay}" />
													</TextBlock>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock
										Margin="0,2,0,0"
										FontSize="12"
										Foreground="{DynamicResource StatusCriticalBrush}"
										Text="{Binding ReasonText}"
										TextWrapping="WrapWithOverflow" />
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</DockPanel>
	</Border>
</UserControl>
