<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Servers.ServerMonitorView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:consoles="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Servers"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		서버 모니터(N-12) — 레일 184 · 목록 + 지표 띠 · 상세 340.
		정본: docs/design/window-layout-system-storyboard.html L1330-1365 · all-windows-drag-wireframe.html L368-372.
		치수와 폭별 도킹/서랍/접힘은 ConsoleShell 이 맡는다. x:Name 은 쓰지 않는다(CM 바인딩 지시자) — 계측은 AutomationId 만.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<local:PackIconNameConverter x:Key="IconKind" />
		<local:InverseBoolConverter x:Key="NotBool" />
		<local:TextToVisibilityConverter x:Key="TextToVisibility" />
		<local:MetricBarWidthConverter x:Key="BarWidth" />

		<!--  놓을 수 없음 = 사선 해치. 색이 아니라 형태로 말한다(라이트에서 주색·선택색이 같은 색이다).  -->
		<DrawingBrush
			x:Key="Servers.Drop.Blocked"
			TileMode="Tile"
			Viewport="0,0,8,8"
			ViewportUnits="Absolute">
			<DrawingBrush.Drawing>
				<GeometryDrawing Geometry="M0,8 L8,0">
					<GeometryDrawing.Pen>
						<Pen Brush="{DynamicResource BorderBrush}" Thickness="1" />
					</GeometryDrawing.Pen>
				</GeometryDrawing>
			</DrawingBrush.Drawing>
		</DrawingBrush>

		<Style x:Key="Servers.FieldBox" TargetType="TextBox">
			<Setter Property="Height" Value="28" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>

		<Style x:Key="Servers.Chip" TargetType="Border">
			<Setter Property="Padding" Value="8,3" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
		</Style>
	</UserControl.Resources>

	<c:ConsoleShell
		Title="서버"
		ConsoleKey="Servers"
		IsDetailRequested="{Binding Detail.IsDetailRequested}"
		Loaded="OnShellLoaded"
		Subtitle="{Binding ListStatusText}">

		<!--  레일 — 전체 · 유형 4 + 기타 · ─ · 시스템 이벤트 (SB L1340-1342). 아래는 합계와 부대 필터.  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.Servers.Rail"
				ConsoleKey="Servers"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Resources>
					<DataTemplate DataType="{x:Type consoles:ConsoleIconToken}">
						<md:PackIcon
							Width="18"
							Height="18"
							Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
					</DataTemplate>
				</c:ConsoleRail.Resources>
				<c:ConsoleRail.Footer>
					<StackPanel>
						<TextBlock
							AutomationProperties.AutomationId="Console.Servers.Rail.Footer"
							FontSize="12.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding RailFooterText}"
							TextWrapping="Wrap" />

						<!--  부대 필터 — 8.0 이상에서만 뜻이 있어 그 밖에서는 아예 감춘다(비활성이 아니라).  -->
						<StackPanel Margin="0,10,0,0" Visibility="{Binding IsUnitEra, Converter={StaticResource BoolToVisibility}}">
							<TextBlock
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="부대" />
							<ComboBox
								Margin="0,3,0,0"
								AutomationProperties.AutomationId="Console.Servers.UnitFilter"
								DisplayMemberPath="Name"
								FontSize="12.5"
								ItemsSource="{Binding UnitOptions}"
								SelectedItem="{Binding SelectedUnit, Mode=TwoWay}" />
							<CheckBox
								Margin="0,5,0,0"
								AutomationProperties.AutomationId="Console.Servers.IncludeDescendants"
								Content="예하 포함"
								FontSize="12"
								Foreground="{DynamicResource TextSecondaryBrush}"
								IsChecked="{Binding IncludeDescendants, Mode=TwoWay}" />
						</StackPanel>
					</StackPanel>
				</c:ConsoleRail.Footer>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="{Binding AddBlockedReason}"
				CanAdd="{Binding CanAdd}"
				CanDelete="{Binding CanDelete}"
				CanRefresh="{Binding CanReload}"
				ColumnsClick="OnColumns"
				ConsoleKey="Servers"
				DeleteClick="OnDelete"
				DeleteDisabledReason="{Binding DeleteBlockedReason}"
				Loaded="OnToolbarLoaded"
				RefreshClick="OnReload"
				SearchPlaceholder="이름 · 주소 · 유형 검색"
				SearchText="{Binding SearchText, Mode=TwoWay}"
				ShowSearch="{Binding IsServerList}" />
		</c:ConsoleShell.Toolbar>

		<c:ConsoleShell.List>
			<Grid ClipToBounds="True">
				<!--  시스템 이벤트 — 받은 것이 없다. 빈 목록을 그리지 않고 왜 비었는지 말한다.  -->
				<Border
					Margin="16"
					VerticalAlignment="Top"
					Visibility="{Binding IsSystemEvents, Converter={StaticResource BoolToVisibility}}">
					<c:NotReceivedBox
						AutomationProperties.AutomationId="Console.Servers.SystemEvents.NotReceived"
						ReloadHint="{Binding SystemEventsNote}"
						SectionName="시스템 이벤트" />
				</Border>

				<DockPanel LastChildFill="True" Visibility="{Binding IsServerList, Converter={StaticResource BoolToVisibility}}">
					<!--  지표 띠 — 한 대를 고르면 목록 아래에 붙는다(SB L1345-1346).  -->
					<Border
						Padding="12,8"
						AutomationProperties.AutomationId="Console.Servers.MetricBand"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,1,0,0"
						DockPanel.Dock="Bottom"
						Visibility="{Binding IsMetricBandVisible, Converter={StaticResource BoolToVisibility}}">
						<StackPanel>
							<ItemsControl Focusable="False" ItemsSource="{Binding MetricCells}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="4" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border
											Margin="0,0,10,0"
											Padding="10,6"
											AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Servers.Metric.{0}}"
											Background="{DynamicResource SurfaceBrush}"
											BorderBrush="{DynamicResource BorderBrush}"
											BorderThickness="1"
											CornerRadius="4">
											<StackPanel>
												<DockPanel LastChildFill="False">
													<TextBlock
														FontSize="12"
														Foreground="{DynamicResource TextMutedBrush}"
														Text="{Binding Label}" />
													<!--  임계 배지 — 서버가 판정해 보낸 것만. 형태(▲)로도 구분한다.  -->
													<Border
														Padding="6,1"
														Background="{DynamicResource TintWarningBrush}"
														BorderBrush="{DynamicResource StatusWarningBrush}"
														BorderThickness="1"
														CornerRadius="8"
														DockPanel.Dock="Right"
														Visibility="{Binding BadgeText, Converter={StaticResource TextToVisibility}}">
														<TextBlock
															FontSize="10.5"
															Foreground="{DynamicResource TextPrimaryBrush}"
															Text="{Binding BadgeText}" />
													</Border>
												</DockPanel>
												<TextBlock
													Margin="0,2,0,0"
													FontFamily="Consolas"
													FontSize="17"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding ValueText}" />
												<Border
													Height="4"
													Margin="0,5,0,0"
													Background="{DynamicResource SurfaceSunkenBrush}"
													CornerRadius="2">
													<Rectangle
														HorizontalAlignment="Left"
														Fill="{DynamicResource PrimaryBrush}"
														RadiusX="2"
														RadiusY="2">
														<Rectangle.Width>
															<MultiBinding Converter="{StaticResource BarWidth}">
																<Binding Path="Ratio" />
																<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}" />
															</MultiBinding>
														</Rectangle.Width>
													</Rectangle>
												</Border>
												<TextBlock
													Margin="0,4,0,0"
													FontSize="11"
													Foreground="{DynamicResource TextMutedBrush}"
													Text="{Binding DetailText}" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock
								Margin="2,6,0,0"
								FontSize="11"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding MetricNote}" />
						</StackPanel>
					</Border>

					<DataGrid
						AutomationProperties.AutomationId="Console.Servers.Grid"
						IsReadOnly="True"
						ItemsSource="{Binding Rows}"
						Loaded="OnGridLoaded"
						SelectionChanged="OnGridSelectionChanged"
						Style="{StaticResource Console.DataGrid}">
						<DataGrid.RowStyle>
							<Style BasedOn="{StaticResource Console.DataGrid.Row}" TargetType="DataGridRow">
								<!--  행마다 Id — 자동화가 "이 서버" 를 짚을 수 있어야 쓰기 안전 계약을 지킬 수 있다.  -->
								<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Servers.Console.Row.{0}}" />
								<!--  행이 곧 드롭존이다 — 장비를 끌어 여기에 놓는다.  -->
								<Setter Property="drag:DropZone.Key" Value="server-row" />
								<Setter Property="drag:DropZone.Handler" Value="{Binding DataContext.Assign, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								<Style.Triggers>
									<!--  놓을 수 있음 = 위아래 얇은 선 / 지금 그 위 = 굵은 테두리 / 놓을 수 없음 = 사선 해치.  -->
									<DataTrigger Binding="{Binding (drag:DropZone.State), RelativeSource={RelativeSource Self}}" Value="Available">
										<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
										<Setter Property="BorderThickness" Value="0,1,0,1" />
									</DataTrigger>
									<DataTrigger Binding="{Binding (drag:DropZone.State), RelativeSource={RelativeSource Self}}" Value="Hover">
										<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
										<Setter Property="BorderThickness" Value="2" />
									</DataTrigger>
									<DataTrigger Binding="{Binding (drag:DropZone.State), RelativeSource={RelativeSource Self}}" Value="Blocked">
										<Setter Property="Background" Value="{StaticResource Servers.Drop.Blocked}" />
										<Setter Property="ToolTip" Value="이 서버 유형은 장비를 받지 않습니다" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</DataGrid.RowStyle>
					</DataGrid>
				</DockPanel>
			</Grid>
		</c:ConsoleShell.List>

		<!--  상태 띠 — 건수 · 방금 한 일 · 되돌리기 · 배정 트레이(끄는 곳)  -->
		<c:ConsoleShell.StatusBar>
			<Border
				Padding="12,5"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<StackPanel>
					<DockPanel LastChildFill="True">
						<Button
							Margin="8,0,0,0"
							Padding="8,1"
							AutomationProperties.AutomationId="Console.Servers.Assign.Undo"
							Click="OnUndoAssign"
							Content="되돌리기"
							DockPanel.Dock="Right"
							FontSize="12"
							Visibility="{Binding CanUndoAssign, Converter={StaticResource BoolToVisibility}}" />
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Servers.Status.Message"
							DockPanel.Dock="Right"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding StatusText}"
							TextTrimming="CharacterEllipsis" />
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Servers.Status.Count"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding ListStatusText}" />
					</DockPanel>

					<!--  배정 트레이 — 여기서 끌어 위의 서버 행에 놓는다. 같은 일을 [배정] 단추로도 한다(키보드 폴백).  -->
					<DockPanel
						Margin="0,5,0,0"
						LastChildFill="True"
						Visibility="{Binding HasAssignCandidates, Converter={StaticResource BoolToVisibility}}">
						<TextBlock
							Width="44"
							Margin="0,4,0,0"
							VerticalAlignment="Top"
							DockPanel.Dock="Left"
							FontSize="12"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="스피커" />
						<Button
							Margin="8,0,0,0"
							Padding="10,2"
							VerticalAlignment="Top"
							AutomationProperties.AutomationId="Console.Servers.Assign.Button"
							Click="OnAssignSelection"
							Content="배정"
							DockPanel.Dock="Right"
							FontSize="12"
							IsEnabled="{Binding CanAssignSelection}"
							ToolTip="{Binding AssignHint}" />
						<ListBox
							AutomationProperties.AutomationId="Console.Servers.Assign.Tray"
							Background="Transparent"
							BorderThickness="0"
							ItemsSource="{Binding AssignCandidates}"
							Loaded="OnTrayLoaded"
							SelectionMode="Extended">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,2,6,2" Style="{StaticResource Servers.Chip}">
										<StackPanel Orientation="Horizontal">
											<!--  손잡이에서만 끌기가 시작된다 — 행 본체 좌드래그는 범위선택과 충돌한다.  -->
											<drag:DragHandle
												Width="14"
												Margin="0,0,4,0"
												AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Servers.Assign.Handle.{0}}"
												ToolTip="끌어서 서버 행에 놓습니다" />
											<TextBlock
												FontSize="12"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Text="{Binding Name}" />
											<TextBlock
												Margin="6,0,0,0"
												FontSize="11"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding ServerText}" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
							<b:Interaction.Behaviors>
								<drag:CaptureDragBehavior
									DisplayMemberPath="Name"
									Handler="{Binding Assign}"
									KeyboardFallback="칩을 고르고 서버 행을 고른 뒤 [배정] 을 누릅니다" />
							</b:Interaction.Behaviors>
						</ListBox>
					</DockPanel>
				</StackPanel>
			</Border>
		</c:ConsoleShell.StatusBar>

		<!--  상세 340 — 접속 · 설정 · 상태(관측) · 소속 부대 · 최근 시스템 이벤트 (SB L1347-1351)  -->
		<c:ConsoleShell.Detail>
			<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="{Binding Detail.ApplyText}"
				Banner="{Binding Detail.Banner}"
				CanApply="{Binding Detail.CanApply}"
				CanRevert="{Binding Detail.CanRevert}"
				ConsoleKey="Servers"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding Detail.FooterText}"
				IsDirty="{Binding Detail.IsDirty}"
				IsReadOnly="{Binding Detail.IsReadOnly}"
				Kind="{Binding Detail.Kind}"
				RevertClick="OnRevert"
				RevertText="{Binding Detail.RevertText}"
				ShakeToken="{Binding Detail.ShakeToken}"
				ShowButtons="{Binding Detail.ShowButtons}"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding Detail.Title}">
				<StackPanel Margin="14,10,14,8">
					<!--  [설정 수정] [지표 이력] (SB L1351)  -->
					<StackPanel Margin="0,0,0,8" Orientation="Horizontal">
						<Button
							Margin="0,0,6,0"
							AutomationProperties.AutomationId="Console.Servers.Detail.BeginEdit"
							Click="OnBeginEdit"
							Content="설정 수정"
							IsEnabled="{Binding CanBeginEdit}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<Button
							AutomationProperties.AutomationId="Console.Servers.Detail.MetricHistory"
							Click="OnShowHistory"
							Content="지표 이력"
							IsEnabled="{Binding CanShowHistory}"
							Style="{StaticResource MaterialDesignFlatButton}" />
					</StackPanel>

					<!--  등록 폼의 분류 — 서버 유형은 분류가 쥔다. 상태 칸은 없다(관측 필드를 쓰면 422).  -->
					<c:ConsoleSection
						AxisName="category_id"
						Header="분류"
						TagKind="Intent"
						Visibility="{Binding Detail.IsCreating, Converter={StaticResource BoolToVisibility}}">
						<c:ConsoleField ApiName="category_id" Header="분류">
							<ComboBox
								AutomationProperties.AutomationId="Console.Servers.Detail.Category"
								DisplayMemberPath="Display"
								ItemsSource="{Binding CategoryOptions}"
								SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
						</c:ConsoleField>
					</c:ConsoleSection>

					<c:ConsoleSection AxisName="connection" Header="접속" TagKind="Intent">
						<StackPanel>
							<c:ConsoleField ApiName="name" Header="이름">
								<TextBox
									AutomationProperties.AutomationId="Console.Servers.Detail.Name"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="ip_address" Header="주소">
								<TextBox
									AutomationProperties.AutomationId="Console.Servers.Detail.Ip"
									FontFamily="Consolas"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding IpText, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="port" Header="포트">
								<TextBox
									AutomationProperties.AutomationId="Console.Servers.Detail.Port"
									FontFamily="Consolas"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="hostname" Header="호스트명">
								<TextBox
									AutomationProperties.AutomationId="Console.Servers.Detail.Hostname"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding HostnameText, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="user_name" Header="계정">
								<TextBox
									AutomationProperties.AutomationId="Console.Servers.Detail.UserName"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding UserNameText, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<!--  비밀번호는 마스킹 편집기로만 다룬다. 읽으면 언제나 빈 글자라 화면·PNG·자동화 어디에도 원문이 남지 않는다.  -->
							<c:ConsoleField
								ApiName="user_password"
								Header="비밀번호"
								Note="{Binding PasswordNote}">
								<PasswordBox
									Height="28"
									Padding="6,0"
									AutomationProperties.AutomationId="Console.Servers.Detail.Password"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									Foreground="{DynamicResource TextPrimaryBrush}"
									IsEnabled="{Binding IsEditing}"
									PasswordChanged="OnPasswordChanged"
									VerticalContentAlignment="Center" />
							</c:ConsoleField>
						</StackPanel>
					</c:ConsoleSection>

					<!--  설정 — server_config(모드 · 임계). 옛 프록시 설정 창이 여기로 흡수됐다(SB L1361).  -->
					<c:ConsoleSection AxisName="server_config" Header="설정" TagKind="Intent">
						<StackPanel>
							<c:ConsoleField ApiName="modes" Header="운용 모드">
								<TextBlock
									AutomationProperties.AutomationId="Console.Servers.Detail.OperationMode"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding OperationModeText}"
									TextWrapping="Wrap" />
							</c:ConsoleField>
							<Grid Margin="0,4,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="72" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock
									Grid.Row="0"
									Grid.Column="1"
									Margin="2,0,2,2"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="경고" />
								<TextBlock
									Grid.Row="0"
									Grid.Column="2"
									Margin="2,0,2,2"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="위험" />

								<TextBlock
									Grid.Row="1"
									Grid.Column="0"
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="CPU %" />
								<TextBox
									Grid.Row="1"
									Grid.Column="1"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.CpuWarning"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding CpuWarningText, UpdateSourceTrigger=PropertyChanged}" />
								<TextBox
									Grid.Row="1"
									Grid.Column="2"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.CpuCritical"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding CpuCriticalText, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock
									Grid.Row="2"
									Grid.Column="0"
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="메모리 %" />
								<TextBox
									Grid.Row="2"
									Grid.Column="1"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.RamWarning"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding RamWarningText, UpdateSourceTrigger=PropertyChanged}" />
								<TextBox
									Grid.Row="2"
									Grid.Column="2"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.RamCritical"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding RamCriticalText, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock
									Grid.Row="3"
									Grid.Column="0"
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="디스크 %" />
								<TextBox
									Grid.Row="3"
									Grid.Column="1"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.DiskWarning"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding DiskWarningText, UpdateSourceTrigger=PropertyChanged}" />
								<TextBox
									Grid.Row="3"
									Grid.Column="2"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.DiskCritical"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding DiskCriticalText, UpdateSourceTrigger=PropertyChanged}" />

								<TextBlock
									Grid.Row="4"
									Grid.Column="0"
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="네트워크" />
								<TextBox
									Grid.Row="4"
									Grid.Column="1"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.NetworkWarning"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding NetworkWarningText, UpdateSourceTrigger=PropertyChanged}" />
								<TextBox
									Grid.Row="4"
									Grid.Column="2"
									Margin="2"
									AutomationProperties.AutomationId="Console.Servers.Detail.Threshold.NetworkCritical"
									IsEnabled="{Binding IsEditing}"
									Style="{StaticResource Servers.FieldBox}"
									Text="{Binding NetworkCriticalText, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>
							<TextBlock
								Margin="2,6,0,0"
								AutomationProperties.AutomationId="Console.Servers.Detail.Validation"
								FontSize="11.5"
								Foreground="{DynamicResource StatusCriticalBrush}"
								Text="{Binding ValidationText}"
								TextWrapping="Wrap"
								Visibility="{Binding ValidationText, Converter={StaticResource TextToVisibility}}" />
						</StackPanel>
					</c:ConsoleSection>

					<!--  상태 — 관측. 보고가 없으면 칸이 아니라 미수신 상자를 그린다(SB L1358).  -->
					<c:ConsoleSection AxisName="status" Header="상태" TagKind="Observed">
						<StackPanel>
							<StackPanel Visibility="{Binding IsStatusReceived, Converter={StaticResource BoolToVisibility}}">
								<c:ConsoleField ApiName="status" Header="상태">
									<TextBlock
										AutomationProperties.AutomationId="Console.Servers.Detail.Status"
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding ObservedStatusText}" />
								</c:ConsoleField>
								<c:ConsoleField
									ApiName="updated_at"
									Header="마지막 변화"
									Note="마지막 전이 시각입니다 — 마지막 수신이 아닙니다">
									<TextBlock
										AutomationProperties.AutomationId="Console.Servers.Detail.LastChange"
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding ObservedLastChangeText}" />
								</c:ConsoleField>
							</StackPanel>
							<c:NotReceivedBox
								AutomationProperties.AutomationId="Console.Servers.Detail.Status.NotReceived"
								ReloadHint="서버 매니저가 보고하면 채워집니다"
								SectionName="상태(관측)"
								Visibility="{Binding IsStatusReceived, Converter={StaticResource NotBool}}" />
							<TextBlock
								Margin="2,6,0,0"
								FontSize="11"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding StatusIsObservedNote}"
								TextWrapping="Wrap" />
						</StackPanel>
					</c:ConsoleSection>

					<c:ConsoleSection AxisName="unit_id" Header="소속 부대" TagKind="Observed">
						<TextBlock
							AutomationProperties.AutomationId="Console.Servers.Detail.Unit"
							FontSize="12.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding UnitSectionText}"
							TextWrapping="Wrap" />
					</c:ConsoleSection>

					<c:ConsoleSection AxisName="system_events" Header="최근 시스템 이벤트" TagKind="Observed">
						<c:NotReceivedBox
							AutomationProperties.AutomationId="Console.Servers.Detail.SystemEvents.NotReceived"
							ReloadHint="{Binding SystemEventsNote}"
							SectionName="최근 시스템 이벤트 5" />
					</c:ConsoleSection>
				</StackPanel>
			</c:ConsoleDetailHost>
		</c:ConsoleShell.Detail>
	</c:ConsoleShell>
</UserControl>
