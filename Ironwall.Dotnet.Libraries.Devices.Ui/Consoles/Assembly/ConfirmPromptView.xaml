<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Assembly.ConfirmPromptView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		예 · 아니오 — T4 · S 400(스토리보드 #h-dlg L1446 확인 팝업).
		ESC · Enter · 첫 포커스(취소)는 틀이 정한다. 옛 AutomationId 는 그대로 둔다 — 자동화가 이미 쓰고 있다.
	-->
	<dlg:ConsoleDialogFrame
		Backdrop="{DynamicResource BgBrush}"
		DialogKey="Devices.Assembly.Confirm"
		PrimaryAutomationId="Devices.Assembly.Confirm.Accept"
		PrimaryInvoked="OnAccept"
		PrimaryText="예"
		SecondaryAutomationId="Devices.Assembly.Confirm.Cancel"
		SecondaryInvoked="OnCancel"
		SecondaryText="아니오"
		Size="Small"
		Title="{Binding DisplayName}">
		<dlg:ConsoleDialogText
			AutomationProperties.AutomationId="Devices.Assembly.Confirm.Message"
			VerticalAlignment="Top"
			FontSize="13"
			Foreground="{DynamicResource TextPrimaryBrush}"
			Text="{Binding Message}"
			TextWrapping="Wrap" />
	</dlg:ConsoleDialogFrame>
</UserControl>
