<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Assembly.ConfirmPromptView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Background="{DynamicResource SurfaceBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	PreviewKeyDown="OnPreviewKeyDown">
	<DockPanel Margin="16,14" LastChildFill="True">
		<StackPanel
			Margin="0,12,0,0"
			HorizontalAlignment="Right"
			DockPanel.Dock="Bottom"
			Orientation="Horizontal">
			<Button
				Margin="0,0,6,0"
				AutomationProperties.AutomationId="Devices.Assembly.Confirm.Cancel"
				Click="OnCancel"
				Content="아니오"
				Style="{StaticResource MaterialDesignOutlinedButton}" />
			<Button
				MinWidth="88"
				AutomationProperties.AutomationId="Devices.Assembly.Confirm.Accept"
				IsDefault="True"
				Click="OnAccept"
				Content="예" />
		</StackPanel>
		<StackPanel>
			<TextBlock
				FontSize="15"
				FontWeight="Bold"
				Text="{Binding DisplayName}" />
			<ScrollViewer MaxHeight="140" Margin="0,10,0,0" Style="{StaticResource Console.ScrollViewer}" VerticalScrollBarVisibility="Auto">
				<TextBlock
					AutomationProperties.AutomationId="Devices.Assembly.Confirm.Message"
					FontSize="13"
					Foreground="{DynamicResource TextPrimaryBrush}"
					Text="{Binding Message}"
					TextWrapping="Wrap" />
			</ScrollViewer>
		</StackPanel>
	</DockPanel>
</UserControl>
