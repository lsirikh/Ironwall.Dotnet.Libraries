<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Assembly.RegisterFromPresetView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:asm="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Assembly"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:pw="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	Background="{DynamicResource SurfaceBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	PreviewKeyDown="OnPreviewKeyDown">
	<!--
		프리셋으로 장비 만들기(device-assembly-preset FR-12 ~ FR-14). 정본 목업 L312-351.
		왼쪽: 프리셋 고르기 + 프리셋이 담지 않는 개체 정보만. 오른쪽: 보낼 내용 — 이대로 나간다(POST 1건).
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<asm:CategoryTextConverter x:Key="CategoryText" />
		<Style x:Key="Reg.TextBox" TargetType="TextBox">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		<Style x:Key="Reg.Hint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</UserControl.Resources>

	<DockPanel LastChildFill="True">
		<Border
			Padding="16,10"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top">
			<StackPanel>
				<TextBlock
					FontSize="15"
					FontWeight="Bold"
					Text="프리셋으로 장비 만들기" />
				<TextBlock
					Margin="0,2,0,0"
					Style="{StaticResource Reg.Hint}"
					Text="프리셋이 구조(부품 · 설정)를 대고, 여기서는 그 장비만의 것(번호 · 이름 · 접속)만 넣는다. 보내는 것은 POST 1건 — 실패하면 아무것도 만들어지지 않는다." />
			</StackPanel>
		</Border>

		<Border
			Padding="16,8"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0"
			DockPanel.Dock="Bottom">
			<DockPanel LastChildFill="True">
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
					<Button
						Margin="0,0,6,0"
						AutomationProperties.AutomationId="Devices.Assembly.Register.Cancel"
						Click="OnCancel"
						Content="취소"
						Style="{StaticResource MaterialDesignOutlinedButton}" />
					<Button
						MinWidth="96"
						AutomationProperties.AutomationId="Devices.Assembly.Register.Submit"
						IsDefault="True"
						Click="OnRegister"
						Content="등록"
						IsEnabled="{Binding CanRegister}" />
				</StackPanel>
				<TextBlock
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Assembly.Register.Message"
					FontSize="12.5"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding Message}"
					TextWrapping="Wrap" />
			</DockPanel>
		</Border>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="420" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ScrollViewer Style="{StaticResource Console.ScrollViewer}" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="16,10">
					<c:ConsoleSection Header="프리셋" Visibility="{Binding ShowsPresetList, Converter={StaticResource BoolToVisibility}}">
						<StackPanel>
							<c:ConsoleField ApiName="category_device" Header="카테고리">
								<ComboBox
									AutomationProperties.AutomationId="Devices.Assembly.Register.Category"
									ItemsSource="{Binding Categories}"
									SelectedItem="{Binding Category}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding Converter={StaticResource CategoryText}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</c:ConsoleField>
							<ListBox
								MaxHeight="150"
								Margin="0,6,0,0"
								AutomationProperties.AutomationId="Devices.Assembly.Register.Presets"
								DisplayMemberPath="Name"
								ItemsSource="{Binding Presets}"
								SelectedItem="{Binding SelectedPreset}" />
						</StackPanel>
					</c:ConsoleSection>

					<TextBlock
						Margin="0,6,0,0"
						FontSize="12.5"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding PresetSummary}"
						TextWrapping="Wrap" />

					<c:ConsoleSection Header="이 장비만의 것">
						<StackPanel>
							<c:ConsoleField ApiName="number_device" Header="장비번호 *">
								<TextBox
									AutomationProperties.AutomationId="Devices.Assembly.Register.Field.number_device"
									FontFamily="Consolas"
									Style="{StaticResource Reg.TextBox}"
									Text="{Binding DeviceNumber, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="name_device" Header="이름 *">
								<TextBox
									AutomationProperties.AutomationId="Devices.Assembly.Register.Field.name_device"
									Style="{StaticResource Reg.TextBox}"
									Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField
								ApiName="controller_id"
								Header="소속 제어기 *"
								Visibility="{Binding ShowsController, Converter={StaticResource BoolToVisibility}}">
								<ComboBox
									AutomationProperties.AutomationId="Devices.Assembly.Register.Field.controller_id"
									DisplayMemberPath="DeviceName"
									ItemsSource="{Binding Controllers}"
									SelectedItem="{Binding Controller}" />
							</c:ConsoleField>
						</StackPanel>
					</c:ConsoleSection>

					<c:ConsoleSection
						AxisName="connection"
						Header="접속"
						Visibility="{Binding ShowsConnection, Converter={StaticResource BoolToVisibility}}">
						<StackPanel>
							<c:ConsoleField ApiName="connection.ip_address" Header="IP">
								<TextBox
									AutomationProperties.AutomationId="Devices.Assembly.Register.Field.ip_address"
									FontFamily="Consolas"
									Style="{StaticResource Reg.TextBox}"
									Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="connection.ip_port" Header="포트">
								<TextBox
									AutomationProperties.AutomationId="Devices.Assembly.Register.Field.ip_port"
									FontFamily="Consolas"
									Style="{StaticResource Reg.TextBox}"
									Text="{Binding IpPort, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField
								ApiName="connection.credentials.user_name"
								Header="사용자명"
								Visibility="{Binding ShowsCredentials, Converter={StaticResource BoolToVisibility}}">
								<TextBox Style="{StaticResource Reg.TextBox}" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField
								ApiName="connection.credentials.user_password"
								Header="비밀번호"
								Visibility="{Binding ShowsCredentials, Converter={StaticResource BoolToVisibility}}">
								<!--  BindPassword 가 BoundPassword 보다 먼저 와야 한다 — 순서가 바뀌면 붙는 순간 빈 값을 되써 넣는다  -->
								<PasswordBox
									Height="30"
									Padding="6,0"
									VerticalContentAlignment="Center"
									pw:PasswordBoxAssistant.BindPassword="True"
									pw:PasswordBoxAssistant.BoundPassword="{Binding UserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									Foreground="{DynamicResource TextPrimaryBrush}" />
							</c:ConsoleField>
						</StackPanel>
					</c:ConsoleSection>

					<ItemsControl
						Margin="0,8,0,0"
						Focusable="False"
						ItemsSource="{Binding Problems}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding StringFormat=⚠ {0}}"
									TextWrapping="Wrap" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>

			<Border
				Grid.Column="1"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="1,0,0,0">
				<DockPanel Margin="14,10" LastChildFill="True">
					<StackPanel DockPanel.Dock="Top">
						<TextBlock
							FontSize="13"
							FontWeight="SemiBold"
							Text="보낼 내용" />
						<TextBlock
							Margin="0,2,0,8"
							Style="{StaticResource Reg.Hint}"
							Text="이 프리셋으로 만들면 이렇게 나간다 — POST 1건. 유형 공통 사실(states · commands …)과 관측값은 실리지 않는다." />
					</StackPanel>
					<Border
						Background="{DynamicResource SurfaceSunkenBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="1"
						CornerRadius="4">
						<ScrollViewer HorizontalScrollBarVisibility="Auto" Style="{StaticResource Console.ScrollViewer}" VerticalScrollBarVisibility="Auto">
							<TextBlock
								Margin="10"
								AutomationProperties.AutomationId="Devices.Assembly.Register.Preview"
								FontFamily="Consolas"
								FontSize="12"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding PreviewJson}" />
						</ScrollViewer>
					</Border>
				</DockPanel>
			</Border>
		</Grid>
	</DockPanel>
</UserControl>
