<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:blocks="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Assembly.Blocks">
	<!--
		부품 블록의 기본 스타일 (device-assembly-preset PRD FR-04 · NFR-04).
		Themes/Generic.xaml 이 이 사전을 병합한다 — 호스트 앱은 아무것도 병합하지 않아도 된다.

		규칙: ① 색은 전부 DynamicResource 토큰(캐싱·Frozen 금지 — 테마 전환 고착 선례)
		      ② 뜻은 색이 아니라 형태로(가족=바깥선 · 선택=왼쪽 세로 바 · 드롭=가로선은 보드의 몫)
		      ③ 점선 어휘는 {2,2}(비가동) 만 쓴다 — {4,3} 그룹선택 · {5,3} 러버밴드 · {6,4} 드롭선은 이미 배정됨
		      ④ 앰버(AccentBrush) 는 상태색으로 쓰지 않는다(StatusWarning 과 1.14:1, Draft 미저장이 선점)
		      ⑤ 애니메이션 · 스토리보드 없음(RDP Tier 0)
		      ⑥ x:Name 은 템플릿 범위 안(PART_*) 에만 — 바깥에 쓰면 CM 바인딩 지시자와 충돌한다
	-->

	<Style TargetType="{x:Type blocks:ComponentBlock}">
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="13,6,10,6" />
		<Setter Property="MinWidth" Value="140" />
		<Setter Property="MinHeight" Value="46" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type blocks:ComponentBlock}">
					<Grid Background="Transparent">
						<!--
							바깥선은 Canvas 에 담는다 — Path 의 원하는 크기는 곧 기하 경계라,
							바로 Grid 에 두면 (선 두께 절반만큼) 매 패스마다 커지는 레이아웃 루프가 생긴다.
							Canvas 는 자식을 무한대로 재고 자신은 0 을 보고하므로 루프가 원천 봉쇄된다.
						-->
						<Canvas ClipToBounds="False" IsHitTestVisible="False">
							<Path
								x:Name="PART_Outline"
								Data="{TemplateBinding OutlineGeometry}"
								Fill="{TemplateBinding Background}"
								Stroke="{TemplateBinding BorderBrush}"
								StrokeLineJoin="Round"
								StrokeThickness="1" />
							<!--  광학 가족의 원 표지(다른 가족은 Data 가 null 이라 아무것도 그려지지 않는다)  -->
							<Path
								x:Name="PART_OpticsMark"
								Data="{TemplateBinding OpticsMarkGeometry}"
								Stroke="{DynamicResource TextSecondaryBrush}"
								StrokeThickness="1.2" />
						</Canvas>

						<!--  선택 = 왼쪽 3px 세로 바. 블록 형태로 잘라 마름모 · 육각에서도 삐져나오지 않는다.  -->
						<Grid Clip="{TemplateBinding OutlineGeometry}" IsHitTestVisible="False">
							<Border
								x:Name="PART_SelectionBar"
								Width="3"
								HorizontalAlignment="Left"
								Background="{DynamicResource PrimaryBrush}"
								Visibility="Collapsed" />
						</Grid>

						<Grid Margin="{TemplateBinding Padding}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock
									x:Name="PART_Title"
									FontSize="{TemplateBinding FontSize}"
									Foreground="{TemplateBinding Foreground}"
									Text="{TemplateBinding Title}"
									TextTrimming="CharacterEllipsis" />
								<!--  key · 유형 코드는 고정폭 — 사람이 글자를 세어야 하는 값이다  -->
								<TextBlock
									x:Name="PART_Subtitle"
									FontFamily="Consolas, D2Coding, Courier New"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{TemplateBinding Subtitle}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>

							<StackPanel
								Grid.Column="1"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<!--  상태 없는 유형 표지 — 조립 때 알려 줘야 "상태가 왜 안 오냐"가 안 생긴다  -->
								<TextBlock
									x:Name="PART_NoState"
									Margin="4,0,0,0"
									VerticalAlignment="Center"
									FontSize="13"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="&#x2298;"
									ToolTip="상태 없음 — 이 유형은 동작 상태를 보고하지 않습니다(건강만)."
									Visibility="Collapsed" />

								<Border
									x:Name="PART_Channel"
									Margin="6,0,0,0"
									Padding="5,1"
									VerticalAlignment="Center"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="1"
									CornerRadius="3">
									<TextBlock
										FontFamily="Consolas, D2Coding, Courier New"
										FontSize="10.5"
										Foreground="{DynamicResource TextSecondaryBrush}"
										Text="{TemplateBinding ChannelText}" />
								</Border>

								<!--  키 중복 등 — 글리프(형태) 와 윤곽색이 같이 바뀐다. 색 단독으로 뜻을 싣지 않는다.  -->
								<TextBlock
									x:Name="PART_Error"
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									FontSize="13"
									FontWeight="SemiBold"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="&#x26A0;"
									ToolTip="{TemplateBinding ErrorText}"
									Visibility="Collapsed" />
							</StackPanel>
						</Grid>
					</Grid>

					<ControlTemplate.Triggers>
						<!--  빈 글은 컨트롤이 null 로 모아 준다(CoerceText) — 트리거 하나로 접는다  -->
						<Trigger Property="Title" Value="{x:Null}">
							<Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Subtitle" Value="{x:Null}">
							<Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="ChannelText" Value="{x:Null}">
							<Setter TargetName="PART_Channel" Property="Visibility" Value="Collapsed" />
						</Trigger>

						<!--  팔레트 칩 = 한 줄  -->
						<Trigger Property="IsCompact" Value="True">
							<Setter TargetName="PART_Subtitle" Property="Visibility" Value="Collapsed" />
							<Setter Property="MinHeight" Value="30" />
							<Setter Property="MinWidth" Value="120" />
							<Setter Property="Padding" Value="11,3,8,3" />
						</Trigger>

						<!--  글자는 윤곽 안에 — 육각 · 마름모는 양 끝이 좁아 안쪽으로 더 들인다(안 들이면 글자가 도형 밖으로 나간다)  -->
						<Trigger Property="Family" Value="PowerEnvironment">
							<Setter Property="Padding" Value="24,6,22,6" />
						</Trigger>
						<Trigger Property="Family" Value="Network">
							<Setter Property="Padding" Value="78,6,78,6" />
							<Setter Property="MinHeight" Value="72" />
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsCompact" Value="True" />
								<Condition Property="Family" Value="PowerEnvironment" />
							</MultiTrigger.Conditions>
							<Setter Property="Padding" Value="20,3,18,3" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsCompact" Value="True" />
								<Condition Property="Family" Value="Network" />
							</MultiTrigger.Conditions>
							<Setter Property="Padding" Value="40,3,40,3" />
							<Setter Property="MinHeight" Value="36" />
						</MultiTrigger>
						<Trigger Property="ReportsState" Value="False">
							<Setter TargetName="PART_NoState" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  in_service=false — 점선 {2,2}  -->
						<Trigger Property="IsOutOfService" Value="True">
							<Setter TargetName="PART_Outline" Property="StrokeDashArray" Value="2 2" />
							<Setter TargetName="PART_Title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
						</Trigger>

						<!--
							고른 블록은 <b>더 또렷해야</b> 한다 — 앞의 IsOutOfService 트리거가 제목을 흐린 글자색으로
							내려놓기 때문에, 고른 비가동 블록이 이웃보다 어두웠다(라이트 5.45:1 vs 16.53:1 실측).
							이 트리거가 뒤에 있어 색을 되돌린다. 비가동은 여전히 점선 {2,2}(형태)로 말한다.
						-->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_SelectionBar" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_Title" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Setter TargetName="PART_Title" Property="FontWeight" Value="SemiBold" />
						</Trigger>

						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_Outline" Property="Fill" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>

						<!--  포커스는 색이 아니라 바깥 윤곽(형태)  -->
						<Trigger Property="IsKeyboardFocusWithin" Value="True">
							<Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource FocusRingBrush}" />
							<Setter TargetName="PART_Outline" Property="StrokeThickness" Value="1.5" />
						</Trigger>

						<!--  오류는 포커스보다 뒤에 둔다 — 둘이 겹치면 나중 트리거가 이긴다(오류가 이겨야 한다)  -->
						<Trigger Property="HasError" Value="True">
							<Setter TargetName="PART_Error" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter TargetName="PART_Outline" Property="StrokeThickness" Value="1.5" />
						</Trigger>

						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_Title" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Setter TargetName="PART_Outline" Property="Stroke" Value="{DynamicResource DividerBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
