<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.WiringPromptView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		확인 · 저장 미리보기(WS L450, L772) — T4 · S 400.
		파괴적이지 않은 쪽(취소)이 첫 포커스다. ESC · Enter 는 틀이 정한다. 옛 AutomationId 유지.
	-->
	<dlg:ConsoleDialogFrame
		Backdrop="{DynamicResource BgBrush}"
		DialogKey="Devices.Wiring.Prompt"
		PrimaryAutomationId="Devices.Wiring.Prompt.Confirm"
		PrimaryInvoked="OnConfirm"
		PrimaryText="{Binding ConfirmText}"
		SecondaryAutomationId="Devices.Wiring.Prompt.Cancel"
		SecondaryInvoked="OnCancel"
		SecondaryText="{Binding CancelText}"
		Size="Small"
		Title="{Binding Title}">
		<dlg:ConsoleDialogText
			AutomationProperties.AutomationId="Devices.Wiring.Prompt.Message"
			VerticalAlignment="Top"
			FontSize="13"
			Foreground="{DynamicResource TextSecondaryBrush}"
			Text="{Binding Message}"
			TextWrapping="Wrap" />
	</dlg:ConsoleDialogFrame>
</UserControl>
