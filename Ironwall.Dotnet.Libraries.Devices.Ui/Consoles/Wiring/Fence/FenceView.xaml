<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Fence.FenceView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fence="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Fence"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	Background="{DynamicResource SurfaceBrush}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		펜스 형상 뷰(wiring-fence-view F-3) — 목업 docs/design/wiring-fence-view-mockup.html 의 .tool · .cv · .stat.
		이 컨트롤은 앱 스타일(Console.*)을 StaticResource 로 부르지 않는다 — 시험 창 · 미리보기에서도 그대로 뜬다.
		색은 전부 DynamicResource 토큰. x:Name 은 쓰지 않는다 — 계측은 AutomationId(Devices.Wiring.Fence.*).
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="F.BoolToVisibility" />

		<!--  도구줄 단추 — Tag=True 이면 눌린 모양(주색 채움). 색이 아니라 채움 · 테두리 두께로 가른다.  -->
		<Style x:Key="F.Tool" TargetType="Button">
			<Setter Property="Height" Value="28" />
			<Setter Property="MinWidth" Value="28" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
				</Trigger>
				<Trigger Property="Tag">
					<Trigger.Value>
						<sys:Boolean>True</sys:Boolean>
					</Trigger.Value>
					<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
					<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
					<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Opacity" Value="0.45" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<DockPanel LastChildFill="True">
		<!--  ── 도구줄(FR-06 · FR-10 · FR-19) ──  -->
		<Border
			Padding="10,0"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource RowLineBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top"
			MinHeight="44">
			<DockPanel LastChildFill="False" VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Flat"
						Click="OnFlat"
						Content="평면 보기"
						Style="{StaticResource F.Tool}"
						Tag="{Binding IsFlat}"
						ToolTip="깊이 없이 옆에서 본 모습" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Tilt"
						Click="OnTilt"
						Content="입체 보기"
						IsEnabled="{Binding CanChooseTilt}"
						Style="{StaticResource F.Tool}"
						Tag="{Binding IsTilt}"
						ToolTip="35° 기울여 봅니다 — 원격 데스크톱 연결 중에는 켤 수 없습니다" />
					<Border
						Height="24"
						Margin="2,0,8,0"
						Padding="9,0"
						Background="{DynamicResource TintInfoBrush}"
						CornerRadius="12"
						Visibility="{Binding HasFlatNote, Converter={StaticResource F.BoolToVisibility}}">
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.Wiring.Fence.FlatNote"
							FontSize="11.5"
							Text="{Binding FlatNoteText}" />
					</Border>
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Range"
						Click="OnRange"
						Content="탐지 범위"
						IsEnabled="{Binding HasRangeSensors}"
						Style="{StaticResource F.Tool}"
						Tag="{Binding ShowRange}"
						ToolTip="탐지 반경(복합 20m · 지진동 15m)을 지면에 옅게 겹칩니다 — 빈틈은 마름모" />
					<Rectangle Width="1" Height="20" Margin="2,0,8,0" Fill="{DynamicResource RowLineBrush}" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Fit"
						Click="OnFit"
						Content="전체 보기"
						Style="{StaticResource F.Tool}" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ZoomOut"
						AutomationProperties.Name="축소"
						Click="OnZoomOut"
						Content="−"
						Padding="0"
						Style="{StaticResource F.Tool}" />
					<TextBlock
						MinWidth="44"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ZoomText"
						FontFamily="Consolas"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="100%"
						TextAlignment="Center" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ZoomIn"
						AutomationProperties.Name="확대"
						Click="OnZoomIn"
						Content="+"
						Padding="0"
						Style="{StaticResource F.Tool}" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!--  ── 아래 띠: 종류별 수(FR-01 · FR-18) ──  -->
		<Border
			Height="28"
			Padding="12,0"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource RowLineBrush}"
			BorderThickness="0,1,0,0"
			DockPanel.Dock="Bottom">
			<TextBlock
				VerticalAlignment="Center"
				AutomationProperties.AutomationId="Devices.Wiring.Fence.Counts"
				FontSize="12"
				Foreground="{DynamicResource TextSecondaryBrush}"
				Text="{Binding FenceCountsText}" />
		</Border>

		<!--  ── 캔버스 ──  -->
		<Grid>
			<fence:FenceCanvas ViewModel="{Binding}" />
			<Border
				Margin="10"
				Padding="10,6"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Background="{DynamicResource SurfaceTranslucentBrush}"
				BorderBrush="{DynamicResource RowLineBrush}"
				BorderThickness="1"
				CornerRadius="7"
				IsHitTestVisible="False">
				<TextBlock
					FontSize="11.5"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="센서를 끌면 순서가 바뀝니다 · 함체를 끌면 리턴케이블 · VBUS 표지만 따라갑니다 · 빈 곳 끌기 = 이동 · 휠 = 확대 · 끄는 중 Esc = 취소 · Alt+←/→ 한 칸 · Delete 빼기"
					TextWrapping="Wrap"
					MaxWidth="620" />
			</Border>
		</Grid>
	</DockPanel>
</UserControl>
