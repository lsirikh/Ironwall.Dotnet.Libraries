<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Fence.FenceView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:fence="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Fence"
	xmlns:concept="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Concept"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	Background="{DynamicResource SurfaceBrush}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		펜스 형상 뷰(wiring-fence-view F-3) — 목업 docs/design/wiring-fence-view-mockup.html 의 .tool · .cv · .stat.
		이 컨트롤은 앱 스타일(Console.*)을 StaticResource 로 부르지 않는다 — 시험 창 · 미리보기에서도 그대로 뜬다.
		색은 전부 DynamicResource 토큰. x:Name 은 쓰지 않는다 — 계측은 AutomationId(Devices.Wiring.Fence.*).
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="F.BoolToVisibility" />

		<!--  도구줄 단추 — Tag=True 이면 눌린 모양(주색 채움). 색이 아니라 채움 · 테두리 두께로 가른다.  -->
		<Style x:Key="F.Tool" TargetType="Button">
			<Setter Property="Height" Value="28" />
			<Setter Property="MinWidth" Value="28" />
			<Setter Property="Padding" Value="10,0" />
			<Setter Property="Margin" Value="0,0,6,0" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="6">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
				</Trigger>
				<Trigger Property="Tag">
					<Trigger.Value>
						<sys:Boolean>True</sys:Boolean>
					</Trigger.Value>
					<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
					<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
					<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Opacity" Value="0.45" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<DockPanel LastChildFill="True">
		<!--  ── 도구줄(FR-06 · FR-10 · FR-19) ──  -->
		<Border
			Padding="10,0"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource RowLineBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top"
			MinHeight="38">
			<DockPanel LastChildFill="True" VerticalAlignment="Center">
				<StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
					<!--  SB B 도구줄 — [입체] [평면] · [전체 보기]. 모양 5종은 둘 다에서 보인다(2.5D 투영 · FR-02)  -->
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Tilt"
						Click="OnTilt"
						Content="입체"
						IsEnabled="{Binding CanChooseTilt}"
						Style="{StaticResource F.Tool}"
						Tag="{Binding IsTilt}"
						ToolTip="35° 기울여 봅니다(기본 · 원격 데스크톱에서도)" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Flat"
						Click="OnFlat"
						Content="평면"
						Style="{StaticResource F.Tool}"
						Tag="{Binding IsFlat}"
						ToolTip="깊이 없이 옆에서 본 모습" />
					<Border
						Height="24"
						Margin="2,0,8,0"
						Padding="9,0"
						Background="{DynamicResource TintInfoBrush}"
						CornerRadius="12"
						Visibility="{Binding HasFlatNote, Converter={StaticResource F.BoolToVisibility}}">
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.Wiring.Fence.FlatNote"
							FontSize="11.5"
							Text="{Binding FlatNoteText}" />
					</Border>
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Range"
						Click="OnRange"
						Content="탐지 범위"
						IsEnabled="{Binding HasRangeSensors}"
						Style="{StaticResource F.Tool}"
						Tag="{Binding ShowRange}"
						ToolTip="탐지 반경(복합 20m · 지진동 15m)을 지면에 옅게 겹칩니다 — 빈틈은 마름모" />
					<!--  케이블 보기(FR-12) — 리턴케이블 · 함체 · A·B 번호는 기본으로 빼고 개념도가 맡는다. 켜면 펜스 위에 겹친다  -->
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Cables"
						Click="OnCables"
						Content="케이블 보기"
						Style="{StaticResource F.Tool}"
						Tag="{Binding ShowCables}"
						ToolTip="리턴케이블 · 함체 · A·B 번호를 펜스 위에 겹쳐 봅니다(연결 구조는 아래 개념도)" />
					<!--
						펜스센서 현장 간격(v0.4 §1-C · 기준 3m · 2~4m · 0.5m 단위) — 제어기마다 다르다. 그림만 다시 놓이고 바뀐 줄이 아니다
						(서버 저장 위치는 O-10 · 지금은 이 창 안에서만).
					-->
					<ComboBox
						MinWidth="96"
						Margin="2,0,8,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Spacing"
						AutomationProperties.Name="펜스센서 간격"
						ItemStringFormat="펜스센서 간격 {0:0.#}m"
						Visibility="{Binding HasFenceSensors, Converter={StaticResource F.BoolToVisibility}}"
						ItemsSource="{Binding FenceSpacingChoices}"
						SelectedItem="{Binding FenceSpacingMetres}"
						ToolTip="현장 펜스센서 간격(기준 3m · 2~4m) — 바꾸면 그림만 다시 놓입니다(저장 대상 아님)" />
					<!--  거리 표시(2026-10-01) — 망 · 담 길이와 센서 사이 m 를 펜스 뷰 · 개념도에(기본 끔 · 사람마다 기억)  -->
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ShowDistances"
						Click="OnDistances"
						Content="거리 표시"
						Style="{StaticResource F.Tool}"
						Tag="{Binding ShowDistances}"
						ToolTip="망 · 담 길이와 같은 줄 센서 사이 거리(m)를 펜스 뷰와 개념도에 표시합니다" />
					<Rectangle Width="1" Height="20" Margin="2,0,8,0" Fill="{DynamicResource RowLineBrush}" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Fit"
						Click="OnFit"
						Content="전체 보기"
						Style="{StaticResource F.Tool}" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ZoomOut"
						AutomationProperties.Name="축소"
						Click="OnZoomOut"
						Content="−"
						Padding="0"
						Style="{StaticResource F.Tool}" />
					<TextBlock
						MinWidth="44"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ZoomText"
						FontFamily="Consolas"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="100%"
						TextAlignment="Center" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Fence.ZoomIn"
						AutomationProperties.Name="확대"
						Click="OnZoomIn"
						Content="+"
						Padding="0"
						Style="{StaticResource F.Tool}" />
					<!--
						도움말 — 공용 "?"(help-callout H-1 시범). 문구는 DevicesHelp(키 Devices.Wiring.Fence)에 한 곳.
						옛 [?] 의 id 를 그대로 잇는다(헤디드 SC-FEN-013): 단추 Devices.Wiring.Fence.Help · 몸 Devices.Wiring.Fence.HelpText — 별칭은 계약 시험의 허용 목록에 있다.
					-->
					<c:HelpTip
						Margin="8,0,0,0"
						AutomationProperties.AutomationId="Devices.Wiring.Fence.Help"
						BodyAutomationId="Devices.Wiring.Fence.HelpText"
						HelpKey="Devices.Wiring.Fence"
						Scope="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" />
				</StackPanel>
				<!--  한 줄 조작 안내 — 도구줄 오른쪽(옛 바닥 띠는 결선 창 상태줄로 합쳤다 · 창 정리 2026-10-01). 전체는 [?]  -->
				<TextBlock
					Margin="12,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Wiring.Fence.Hint"
					FontSize="11.5"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="왼쪽 끌기 = 센서 선택 · 오른쪽 클릭 = 메뉴 · 휠 = 확대 · 전체 조작은 [?]"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>

		<!--
			── 3D 보기 · 나눔 막대 · 개념도(창 정리 2026-10-01) ── 남는 높이를 둘이 나눠 갖는다(기본 58 : 42 · 끌어 바꾸면 사람마다 기억).
			나눔 막대는 키보드(↑/↓)로도 옮긴다. 개념도는 높아지면 줄 간격이 자란다(칩 · 글자 크기는 그대로).
		-->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="58*" MinHeight="160" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="42*" MinHeight="150" />
			</Grid.RowDefinitions>

			<!--  ── 캔버스 ──  -->
			<Grid>
				<fence:FenceCanvas ViewModel="{Binding}" />
			</Grid>

			<GridSplitter
				Grid.Row="1"
				Height="6"
				HorizontalAlignment="Stretch"
				AutomationProperties.AutomationId="Devices.Wiring.Fence.Split"
				AutomationProperties.Name="3D 보기 · 개념도 나눔(↑/↓ 로 옮김)"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource RowLineBrush}"
				BorderThickness="0,1"
				Cursor="SizeNS"
				DragCompleted="OnSplitDragCompleted"
				Focusable="True"
				KeyboardIncrement="20"
				KeyUp="OnSplitKeyUp"
				ResizeBehavior="PreviousAndNext"
				ResizeDirection="Rows"
				ShowsPreview="False"
				ToolTip="끌어서 3D 보기와 개념도의 높이를 나눕니다" />

			<!--
				── 개념도(v0.3 FR-20 · 참고 그림 4장) ── 두 줄 펜스 도식: 제어기 C 에서 Ch1(실선) → 아래 줄 → 먼 끝 꺾임 → 위 줄(또는 리턴선) → Ch2(점선).
				칸 폭에 맞춰 그린다(가로 이동 없음). 신호등(FR-14) · IP 표지(FR-15) · VBus(FR-21). 펜스 · 표 보기와 같은 선택을 본다(FR-13).
			-->
			<DockPanel Grid.Row="2" LastChildFill="True">
				<DockPanel Margin="10,4,10,0" DockPanel.Dock="Top" LastChildFill="True">
					<WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
						<TextBlock
							Margin="0,0,12,0"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.Wiring.Fence.Concept.Title"
							FontSize="12"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding ConceptTitle}" />
						<TextBlock
							Margin="0,0,12,0"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.Wiring.Fence.Concept.IpNote"
							FontSize="11.5"
							Foreground="{DynamicResource StatusInfoBrush}"
							Text="스마트복합센서2 = 센서마다 IP (제어기 뒤 내부망)"
							Visibility="{Binding HasIpSensors, Converter={StaticResource F.BoolToVisibility}}" />
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.Wiring.Fence.Concept.ControllerSignal"
							FontSize="11.5"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding ControllerSignalText, StringFormat=제어기 통신: {0}}" />
					</WrapPanel>
				</DockPanel>
				<concept:FenceConceptView ViewModel="{Binding}" />
			</DockPanel>
		</Grid>
	</DockPanel>
</UserControl>
