<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.PasteReportView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Background="{DynamicResource SurfaceBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}"
	PreviewKeyDown="OnPreviewKeyDown">
	<!--  엑셀에서 붙여넣기 보고(WS L368, L499) — 무엇을 만들고 무엇을 왜 버리는지 먼저 보인다.  -->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
	</UserControl.Resources>
	<DockPanel Margin="16,14" LastChildFill="True">
		<TextBlock
			DockPanel.Dock="Top"
			FontSize="15"
			FontWeight="Bold"
			Text="엑셀에서 붙여넣기" />
		<TextBlock
			Margin="0,6,0,0"
			AutomationProperties.AutomationId="Devices.Wiring.Paste.Summary"
			DockPanel.Dock="Top"
			FontSize="13"
			Text="{Binding Summary}"
			TextWrapping="Wrap" />
		<TextBlock
			Margin="0,4,0,0"
			DockPanel.Dock="Top"
			FontSize="12"
			Foreground="{DynamicResource TextMutedBrush}"
			Text="{Binding ColumnText}" />

		<StackPanel
			Margin="0,12,0,0"
			HorizontalAlignment="Right"
			DockPanel.Dock="Bottom"
			Orientation="Horizontal">
			<Button
				Margin="0,0,6,0"
				AutomationProperties.AutomationId="Devices.Wiring.Paste.Cancel"
				Click="OnCancel"
				Content="취소"
				Style="{StaticResource MaterialDesignOutlinedButton}" />
			<Button
				MinWidth="110"
				AutomationProperties.AutomationId="Devices.Wiring.Paste.Accept"
				Click="OnAccept"
				Content="{Binding ApplyText}"
				IsEnabled="{Binding CanApply}" />
		</StackPanel>

		<Grid Margin="0,10,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Border
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<ListBox
					AutomationProperties.AutomationId="Devices.Wiring.Paste.Accepted"
					Background="Transparent"
					BorderThickness="0"
					ItemsSource="{Binding Accepted}">
						<ListBox.ItemContainerStyle>
							<Style TargetType="ListBoxItem">
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<DockPanel Margin="2" LastChildFill="True">
								<TextBlock
									Width="42"
									DockPanel.Dock="Left"
									FontFamily="Consolas"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding LineNumber}" />
								<TextBlock
									Width="64"
									DockPanel.Dock="Left"
									FontFamily="Consolas"
									FontSize="12"
									Text="{Binding Facts.Number}" />
								<TextBlock
									Width="120"
									DockPanel.Dock="Right"
									FontSize="11.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding Facts.Zone}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									Width="90"
									DockPanel.Dock="Right"
									FontSize="11.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding Facts.TypeText}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									FontSize="12.5"
									Text="{Binding Facts.Name}"
									TextTrimming="CharacterEllipsis" />
							</DockPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

			<TextBlock
				Grid.Row="1"
				Margin="0,4,0,0"
				FontSize="11.5"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding MoreAcceptedText}" />

			<StackPanel Grid.Row="2" Visibility="{Binding HasRejected, Converter={StaticResource BoolToVisibility}}">
				<TextBlock
					Margin="0,10,0,4"
					FontSize="12"
					FontWeight="Bold"
					Foreground="{DynamicResource StatusCriticalBrush}"
					Text="건너뛸 줄" />
				<ItemsControl
					AutomationProperties.AutomationId="Devices.Wiring.Paste.Rejected"
					Focusable="False"
					ItemsSource="{Binding Rejected}"
					MaxHeight="120">
					<ItemsControl.Template>
						<ControlTemplate TargetType="ItemsControl">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<ItemsPresenter />
							</ScrollViewer>
						</ControlTemplate>
					</ItemsControl.Template>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock
								Margin="0,1,0,0"
								FontSize="12"
								Foreground="{DynamicResource StatusCriticalBrush}"
								TextWrapping="Wrap">
								<Run Text="{Binding LineNumber, Mode=OneWay, StringFormat={}{0}줄}" />
								<Run Text=" — " />
								<Run Text="{Binding Error, Mode=OneWay}" />
							</TextBlock>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<TextBlock
					FontSize="11.5"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding MoreRejectedText}" />
			</StackPanel>
		</Grid>
	</DockPanel>
</UserControl>
