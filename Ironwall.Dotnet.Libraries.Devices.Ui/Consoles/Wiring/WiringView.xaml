											<TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" FontFamily="Consolas" Text="{Binding SelectedIdText}" />
											<TextBlock Grid.Row="2" Style="{StaticResource W.Hint}" Text="종류" />
											<TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Text="{Binding SelectedTypeText}" TextWrapping="Wrap" />
											<TextBlock Grid.Row="3" Style="{StaticResource W.Hint}" Text="{Binding SelectedAddressLabel}" />
											<StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
												<TextBlock AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.Address" FontFamily="Consolas" Text="{Binding SelectedAddressText}" />
												<TextBlock
													Foreground="{DynamicResource StatusWarningBrush}"
													Style="{StaticResource W.Hint}"
													Text="{Binding SelectedChannelMismatchText}"
													Visibility="{Binding HasSelectedChannelMismatch, Converter={StaticResource BoolToVisibility}}" />
											</StackPanel>
											<TextBlock Grid.Row="4" Style="{StaticResource W.Hint}" Text="체인 위치" />
											<TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" Text="{Binding SelectedPositionText}" TextWrapping="Wrap" />
											<TextBlock Grid.Row="5" Style="{StaticResource W.Hint}" Text="Ch1 · Ch2 번호" Visibility="{Binding HasSelectedPort, Converter={StaticResource BoolToVisibility}}" />
											<TextBlock
												Grid.Row="5"
												Grid.Column="1"
												Margin="0,0,0,4"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.Port"
												Text="{Binding SelectedPortText}"
												TextWrapping="Wrap"
												Visibility="{Binding HasSelectedPort, Converter={StaticResource BoolToVisibility}}" />
											<TextBlock Grid.Row="6" Style="{StaticResource W.Hint}" Text="앞 센서와" Visibility="{Binding HasSelectedDistance, Converter={StaticResource BoolToVisibility}}" />
											<TextBlock
												Grid.Row="6"
												Grid.Column="1"
												Text="{Binding SelectedDistanceText}"
												TextWrapping="Wrap"
												Visibility="{Binding HasSelectedDistance, Converter={StaticResource BoolToVisibility}}" />
										</Grid>

										<!--  줄(fence-wiring-editor FR-18 · §1-0b) — 아래 줄 · 위 줄. 고른 센서 모두(되돌리기 한 걸음) · 개념도 Alt+↑/↓ · 켜진 쪽은 아래 굵은 막대(형태)  -->
										<StackPanel Margin="0,8,0,0" Visibility="{Binding HasMountRow, Converter={StaticResource BoolToVisibility}}">
											<TextBlock Style="{StaticResource W.Hint}" Text="줄" />
											<UniformGrid Margin="0,4,0,0" Columns="2">
												<StackPanel Margin="0,0,3,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Lane.Lower" Click="OnLaneLower" Content="아래 줄" Style="{StaticResource Console.Button}" ToolTip="아래 줄 (Alt+↓)" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsLaneLower, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Margin="3,0,0,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Lane.Upper" Click="OnLaneUpper" Content="위 줄" Style="{StaticResource Console.Button}" ToolTip="위 줄 (Alt+↑)" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsLaneUpper, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
											</UniformGrid>
										</StackPanel>

										<!--
											설치 위치(fence-wiring-editor FR-07 · SB B) — 펜스 3종: 기둥 위 · 기둥 중간 · 망 가운데 / 담 2종: 담 위 · 담 앞면.
											고른 센서 모두에 바로 적용(되돌리기 한 걸음). 켜진 쪽은 아래 굵은 막대(형태).
										-->
										<StackPanel Margin="0,8,0,0" Visibility="{Binding HasMountRow, Converter={StaticResource BoolToVisibility}}">
											<DockPanel LastChildFill="True">
												<!--  높이 한 단계 ▲ ▼(끌기 · Alt+↑/↓ 의 단추 대신) — 망 아래 · 망 가운데 · 기둥 위 · 윤형 코일 / 담 앞면 · 담 위  -->
												<StackPanel Margin="6,0,0,0" DockPanel.Dock="Right" Orientation="Horizontal">
													<Button
														Width="26"
														MinWidth="0"
														Padding="0"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.Raise"
														AutomationProperties.Name="한 단계 위로"
														Click="OnMountRaise"
														Content="▲"
														Style="{StaticResource Console.Button}"
														ToolTip="한 단계 위로 (Alt+↑ · 미세 Shift+Alt+↑)" />
													<Button
														Width="26"
														MinWidth="0"
														Margin="3,0,0,0"
														Padding="0"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.Lower"
														AutomationProperties.Name="한 단계 아래로"
														Click="OnMountLower"
														Content="▼"
														Style="{StaticResource Console.Button}"
														ToolTip="한 단계 아래로 (Alt+↓ · 미세 Shift+Alt+↓)" />
												</StackPanel>
												<TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.Place" Style="{StaticResource W.Hint}" Text="{Binding MountPlaceText}" />
												<TextBlock VerticalAlignment="Center" Style="{StaticResource W.Hint}" Text="설치 위치" />
											</DockPanel>
											<UniformGrid Margin="0,4,0,0" Columns="3" Visibility="{Binding IsMountOnFence, Converter={StaticResource BoolToVisibility}}">
												<StackPanel Margin="0,0,3,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PostTop" Click="OnMountSpot" Content="기둥 위" Style="{StaticResource Console.Button}" Tag="PostTop" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotPostTop, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Margin="0,0,3,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PostMiddle" Click="OnMountSpot" Content="기둥 중간" Style="{StaticResource Console.Button}" Tag="PostMiddle" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotPostMiddle, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel>
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PanelCenter" Click="OnMountSpot" Content="망 가운데" Style="{StaticResource Console.Button}" Tag="PanelCenter" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotPanelCenter, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Margin="0,4,3,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PanelBottom" Click="OnMountSpot" Content="망 아래" Style="{StaticResource Console.Button}" Tag="PanelBottom" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotPanelBottom, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<!--  윤형 코일(위 줄) — 윤형 망에 선 센서만. 고르면 위 줄로 가고 사슬 · 번호가 따라간다  -->
												<StackPanel Margin="0,4,3,0" Visibility="{Binding IsMountOnRazor, Converter={StaticResource BoolToVisibility}}">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.RazorCoil" Click="OnMountSpot" Content="윤형 코일" Style="{StaticResource Console.Button}" Tag="RazorCoil" ToolTip="코일 위에 단다 — 위 줄(펜스센서는 윤형과 같이)" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotRazorCoil, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
											</UniformGrid>
											<UniformGrid Margin="0,4,0,0" Columns="2" Visibility="{Binding IsMountOnWall, Converter={StaticResource BoolToVisibility}}">
												<StackPanel Margin="0,0,3,0">
													<Button MinWidth="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.WallTop" Click="OnMountSpot" Content="담 위" Style="{StaticResource Console.Button}" Tag="WallTop" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotWallTop, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel>
													<Button MinWidth="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.WallFace" Click="OnMountSpot" Content="담 앞면" Style="{StaticResource Console.Button}" Tag="WallFace" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsSpotWallFace, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
											</UniformGrid>
											<!--  9점 격자(2026-10-01) — 지금 망(기둥 센서는 오른쪽 망)의 9점 중 하나로. 끌기 · Ctrl+←/→ · Alt+↑/↓ 의 단추 대신 · 켜진 점은 아래 막대  -->
											<DockPanel Margin="0,6,0,0" LastChildFill="False">
												<TextBlock Margin="0,0,10,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource W.Hint}" Text="망 안 9점" />
												<Grid AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid" DockPanel.Dock="Left">
												<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
												<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
												<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Left.Top" AutomationProperties.Name="왼쪽 위" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Left.2" ToolTip="망 왼쪽 · 위" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridLeftTop, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Center.Top" AutomationProperties.Name="가운데 위" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Center.2" ToolTip="망 가운데 · 위" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridCenterTop, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Right.Top" AutomationProperties.Name="오른쪽 위" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Right.2" ToolTip="망 오른쪽 · 위" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridRightTop, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Left.Middle" AutomationProperties.Name="왼쪽 가운데" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Left.1" ToolTip="망 왼쪽 · 가운데" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridLeftMiddle, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Center.Middle" AutomationProperties.Name="가운데 가운데" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Center.1" ToolTip="망 가운데 · 가운데" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridCenterMiddle, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Right.Middle" AutomationProperties.Name="오른쪽 가운데" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Right.1" ToolTip="망 오른쪽 · 가운데" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridRightMiddle, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Left.Bottom" AutomationProperties.Name="왼쪽 아래" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Left.0" ToolTip="망 왼쪽 · 아래" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridLeftBottom, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Center.Bottom" AutomationProperties.Name="가운데 아래" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Center.0" ToolTip="망 가운데 · 아래" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridCenterBottom, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,3,3">
													<Button MinWidth="0" Width="30" Height="24" Padding="0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Grid.Right.Bottom" AutomationProperties.Name="오른쪽 아래" Click="OnGridPoint" Content="●" FontSize="9" Style="{StaticResource Console.Button}" Tag="Right.0" ToolTip="망 오른쪽 · 아래" />
													<Rectangle Height="3" Margin="4,1,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsGridRightBottom, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												</Grid>
											</DockPanel>
																						<!--  망 이동(FR-05 의 단추 · 키보드 대신) — ◀ ▶ 한 칸(빈 망도 한 칸) · 번호를 적고 Enter · Ctrl+← →(Alt+Shift+← → 도)  -->
											<TextBlock Margin="0,8,0,0" Style="{StaticResource W.Hint}" Text="{Binding MountPanelLabel}" />
											<StackPanel Margin="0,4,0,0" Orientation="Horizontal">
												<Button
													Width="32"
													MinWidth="0"
													Padding="0"
													AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PanelPrev"
													AutomationProperties.Name="앞 망으로"
													Click="OnMountPanelPrev"
													Content="◀"
													Style="{StaticResource Console.Button}"
													ToolTip="앞(Ch1 쪽) 망 · 기둥으로 한 칸 (Ctrl+←)" />
												<TextBox
													Width="56"
													Margin="4,0"
													AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PanelNumber"
													AutomationProperties.Name="망 번호"
													KeyDown="OnMountPanelKey"
													LostKeyboardFocus="OnMountPanelLostFocus"
													Style="{StaticResource W.TextBox}"
													Text="{Binding MountPanelText, UpdateSourceTrigger=PropertyChanged}"
													TextAlignment="Center" />
												<Button
													Width="32"
													MinWidth="0"
													Padding="0"
													AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.PanelNext"
													AutomationProperties.Name="뒤 망으로"
													Click="OnMountPanelNext"
													Content="▶"
													Style="{StaticResource Console.Button}"
													ToolTip="뒤(Ch2 쪽) 망 · 기둥으로 한 칸 (Ctrl+→)" />
											</StackPanel>
										</StackPanel>

										<!--
											설치 면 · 보는 방향(FR-20 · 센서 방향 2026-10-01) — 기둥 센서(스마트 복합 · 복합)만. 켜진 쪽은 아래 굵은 막대(색 하나로 가르지 않는다).
											설치 면 [외부] [내부](키 F) · 보는 방향 [⟲ 90°] [⟳ 90°](키 Shift+R · R) + 네 방향 고르개(정면 · 정방향 · 펜스 쪽 · 역방향).
											펜스센서 · 지진동은 방향이 없어 단추를 끄고 까닭을 적는다. 고른 센서 모두 · 되돌리기 한 걸음.
										-->
										<StackPanel Margin="0,8,0,0" Visibility="{Binding HasFacingRow, Converter={StaticResource BoolToVisibility}}">
											<TextBlock Style="{StaticResource W.Hint}" Text="설치 면" />
											<UniformGrid Margin="0,4,0,0" Columns="2">
												<StackPanel Margin="0,0,3,0">
													<Button
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Facing.Front"
														Click="OnFacingFront"
														Content="외부"
														IsEnabled="{Binding CanChooseFacing}"
														Style="{StaticResource Console.Button}"
														ToolTip="외부 면 (F)" />
													<Rectangle
														Height="3"
														Margin="4,2,4,0"
														Fill="{DynamicResource PrimaryBrush}"
														Visibility="{Binding IsSelectedFront, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Margin="3,0,0,0">
													<Button
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Facing.Back"
														Click="OnFacingBack"
														Content="내부"
														IsEnabled="{Binding CanChooseFacing}"
														Style="{StaticResource Console.Button}"
														ToolTip="내부 면 (F)" />
													<Rectangle
														Height="3"
														Margin="4,2,4,0"
														Fill="{DynamicResource PrimaryBrush}"
														Visibility="{Binding IsSelectedBack, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
											</UniformGrid>

											<!--  보는 방향 — 왼쪽 ⟲ · ⟳ 단추, 오른쪽 네 방향 고르개(위 = 정면 · 오른쪽 = 정방향 · 아래 = 펜스 쪽 · 왼쪽 = 역방향 · 위에서 본 모습)  -->
											<TextBlock Margin="0,8,0,0" Style="{StaticResource W.Hint}" Text="보는 방향" />
											<DockPanel Margin="0,4,0,0" LastChildFill="False">
												<StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
													<Button
														MinWidth="0"
														Padding="8,0"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.Ccw"
														AutomationProperties.Name="반시계로 90° 돌리기"
														Click="OnYawCcw"
														Content="⟲ 90°"
														IsEnabled="{Binding CanChooseFacing}"
														Style="{StaticResource Console.Button}"
														ToolTip="반시계로 90° 돌리기 (Shift+R)" />
													<Button
														MinWidth="0"
														Margin="0,4,0,0"
														Padding="8,0"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.Cw"
														AutomationProperties.Name="시계로 90° 돌리기"
														Click="OnYawCw"
														Content="⟳ 90°"
														IsEnabled="{Binding CanChooseFacing}"
														Style="{StaticResource Console.Button}"
														ToolTip="시계로 90° 돌리기 (R)" />
												</StackPanel>
												<Grid Margin="10,0,0,0" DockPanel.Dock="Left">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto" />
														<RowDefinition Height="Auto" />
														<RowDefinition Height="Auto" />
													</Grid.RowDefinitions>
													<StackPanel Grid.Row="0" Grid.Column="1">
														<Button MinWidth="0" Padding="6,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.0" AutomationProperties.Name="정면 0°" Click="OnYawPick" Content="정면" IsEnabled="{Binding CanChooseFacing}" Style="{StaticResource Console.Button}" Tag="0" ToolTip="펜스 반대쪽 정면(0°)" />
														<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsYawAway, Converter={StaticResource BoolToVisibility}}" />
													</StackPanel>
													<StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,0,0">
														<Button MinWidth="0" Padding="6,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.90" AutomationProperties.Name="정방향 90°" Click="OnYawPick" Content="정방향" IsEnabled="{Binding CanChooseFacing}" Style="{StaticResource Console.Button}" Tag="90" ToolTip="펜스를 따라 망 번호가 커지는 쪽(그림 오른쪽 · 90°)" />
														<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsYawAlong, Converter={StaticResource BoolToVisibility}}" />
													</StackPanel>
													<StackPanel Grid.Row="2" Grid.Column="1">
														<Button MinWidth="0" Padding="6,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.180" AutomationProperties.Name="펜스 쪽 180°" Click="OnYawPick" Content="펜스 쪽" IsEnabled="{Binding CanChooseFacing}" Style="{StaticResource Console.Button}" Tag="180" ToolTip="펜스를 향해(180° · 드묾)" />
														<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsYawToward, Converter={StaticResource BoolToVisibility}}" />
													</StackPanel>
													<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
														<Button MinWidth="0" Padding="6,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.270" AutomationProperties.Name="역방향 270°" Click="OnYawPick" Content="역방향" IsEnabled="{Binding CanChooseFacing}" Style="{StaticResource Console.Button}" Tag="270" ToolTip="펜스를 따라 망 1 쪽(그림 왼쪽 · 270°)" />
														<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsYawAgainst, Converter={StaticResource BoolToVisibility}}" />
													</StackPanel>
													<TextBlock
														Grid.Row="1"
														Grid.Column="1"
														HorizontalAlignment="Center"
														VerticalAlignment="Center"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Yaw.Text"
														FontSize="11"
														Foreground="{DynamicResource TextSecondaryBrush}"
														Text="{Binding SelectedYawText}" />
												</Grid>
											</DockPanel>
											<TextBlock
												Margin="0,3,0,0"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Facing.Note"
												Style="{StaticResource W.Hint}"
												Text="{Binding FacingNote}"
												TextWrapping="Wrap" />
										</StackPanel>

										<!--  높이 조정(FR-07) — 자리 높이에서 ± m. Enter · 칸을 떠나면 적용(되돌리기 한 걸음)  -->
										<StackPanel Margin="0,8,0,0" Visibility="{Binding HasMountRow, Converter={StaticResource BoolToVisibility}}">
											<TextBlock Style="{StaticResource W.Hint}" Text="높이 조정 (m · −3~+3)" />
											<TextBox
												Width="120"
												Margin="0,4,0,0"
												HorizontalAlignment="Left"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Mount.Offset"
												AutomationProperties.Name="높이 조정"
												KeyDown="OnMountOffsetKey"
												LostKeyboardFocus="OnMountOffsetLostFocus"
												Style="{StaticResource W.TextBox}"
												Text="{Binding MountOffsetText, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>

										<!--  여러 센서(Ctrl 클릭 · FR-07) — 함께 끌거나 한꺼번에 빼기  -->
										<StackPanel Margin="0,8,0,0" Visibility="{Binding HasMultiSelection, Converter={StaticResource BoolToVisibility}}">
											<Button
												HorizontalAlignment="Stretch"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.UnplaceMany"
												Click="OnFenceUnplace"
												Content="고른 센서 모두 빼기"
												Style="{StaticResource Console.Button}" />
										</StackPanel>

										<!--  센서 — 결선 동작  -->
										<UniformGrid Margin="0,8,0,0" Columns="3" Visibility="{Binding IsSelectedPlaced, Converter={StaticResource BoolToVisibility}}">
											<Button
												Margin="0,0,4,0"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.Back"
												Click="OnFenceBack"
												Content="앞으로"
												IsEnabled="{Binding CanStepSelectedBack}"
												Style="{StaticResource Console.Button}"
												ToolTip="위치 하나 앞으로(Alt+←)" />
											<Button
												Margin="2,0"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.Forward"
												Click="OnFenceForward"
												Content="뒤로"
												IsEnabled="{Binding CanStepSelectedForward}"
												Style="{StaticResource Console.Button}"
												ToolTip="위치 하나 뒤로(Alt+→)" />
											<Button
												Margin="4,0,0,0"
												AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.Unplace"
												Click="OnFenceUnplace"
												Content="빼기"
												Style="{StaticResource Console.Button}"
												ToolTip="결선에서 빼기(Delete)" />
										</UniformGrid>
										<Button
											Margin="0,8,0,0"
											HorizontalAlignment="Stretch"
											AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.Append"
											Click="OnFenceAppend"
											Content="체인 끝에 붙이기"
											Style="{StaticResource Console.Button.Primary}"
											Visibility="{Binding IsSelectedUnplaced, Converter={StaticResource BoolToVisibility}}" />

										<!--  함체(링) — 위치는 표시만(O-5)  -->
										<StackPanel Margin="0,8,0,0" Visibility="{Binding IsControllerSelected, Converter={StaticResource BoolToVisibility}}">
											<TextBlock Style="{StaticResource W.Hint}" Text="{Binding SelectedTypeText}" />
											<!--  통신 신호등(FR-14) — 창이 열린 동안 5초마다 ping  -->
											<DockPanel Margin="0,6,0,0" LastChildFill="True">
												<signals:SignalLamp
													Width="54"
													Height="22"
													Margin="0,0,8,0"
													AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.ControllerSignal"
													DockPanel.Dock="Left"
													Level="{Binding ControllerSignal}"
													Subject="제어기 통신" />
												<TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding ControllerSignalText}" TextWrapping="Wrap" />
											</DockPanel>

											<!--  제어기 위치(FR-19) — 펜스 왼쪽 끝 · 오른쪽 끝. 사슬 · 번호 방향이 따라 바뀐다(되돌리기 한 걸음) · 개념도에서 C 를 반대쪽으로 끌어도 된다  -->
											<TextBlock Style="{StaticResource W.SectionHead}" Text="제어기 위치" />
											<UniformGrid Margin="0,4,0,0" Columns="2">
												<StackPanel Margin="0,0,3,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.ControllerEnd.Left" Click="OnControllerLeft" Content="왼쪽 끝" Style="{StaticResource Console.Button}" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsControllerLeft, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
												<StackPanel Margin="3,0,0,0">
													<Button MinWidth="0" Padding="4,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.ControllerEnd.Right" Click="OnControllerRight" Content="오른쪽 끝" Style="{StaticResource Console.Button}" />
													<Rectangle Height="3" Margin="4,2,4,0" Fill="{DynamicResource PrimaryBrush}" Visibility="{Binding IsControllerRight, Converter={StaticResource BoolToVisibility}}" />
												</StackPanel>
											</UniformGrid>

											<!--
												번호 대역(fence-wiring-editor FR-10 · §1-A) — 프리셋은 참고용(민간 시설은 다를 수 있다) · 직접 설정.
												고르면 위치 순서대로 번호를 다시 매긴다(저장 전까지 대기 · 되돌리기 한 걸음). 대역 초과 · 255 초과 · 중복은 저장을 막는다.
											-->
											<StackPanel Orientation="Horizontal">
												<TextBlock Style="{StaticResource W.SectionHead}" Text="번호 대역" />
												<!--  번호 대역 "?"(help-callout H-2) — 매기는 규칙 · 프리셋 뜻(옛 회색 줄)  -->
												<c:HelpTip
													Margin="6,6,0,0"
													VerticalAlignment="Center"
													HelpKey="Devices.Wiring.Bands"
													Scope="{Binding RelativeSource={RelativeSource AncestorType=StackPanel, AncestorLevel=2}}" />
											</StackPanel>
											<TextBlock AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Text" FontSize="12" Text="{Binding BandText}" TextWrapping="Wrap" />
											<WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
												<Button Margin="0,0,4,4" MinWidth="0" Padding="8,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Tier2" Click="OnBandPreset" Content="2차" Style="{StaticResource Console.Button}" Tag="tier2" ToolTip="중요시설 2차 — 펜스센서 1~ · 복합센서 180~" />
												<Button Margin="0,0,4,4" MinWidth="0" Padding="8,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Tier3" Click="OnBandPreset" Content="3차" Style="{StaticResource Console.Button}" Tag="tier3" ToolTip="중요시설 3차 — 스마트센서 1~ · 복합센서 180~" />
												<Button Margin="0,0,4,4" MinWidth="0" Padding="8,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Tier4" Click="OnBandPreset" Content="4차" Style="{StaticResource Console.Button}" Tag="tier4" ToolTip="중요시설 4차 — 스마트센서 1~99 · 펜스센서 101~199" />
												<Button Margin="0,0,4,4" MinWidth="0" Padding="8,0" AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Clear" Click="OnBandClear" Content="끄기" IsEnabled="{Binding HasBands}" Style="{StaticResource Console.Button.Ghost}" ToolTip="자동 번호를 끈다 — 번호는 지금 값 그대로" />
											</WrapPanel>
											<ItemsControl Margin="0,4,0,0" Focusable="False" ItemsSource="{Binding BandRows}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid Margin="0,0,0,4">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="84" />
																<ColumnDefinition Width="64" />
																<ColumnDefinition Width="Auto" />
																<ColumnDefinition Width="64" />
															</Grid.ColumnDefinitions>
															<TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding CategoryText}" />
															<TextBox Grid.Column="1" AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Devices.Wiring.Fence.Band.Start.{0}}" AutomationProperties.Name="대역 시작" Style="{StaticResource W.TextBox}" Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
															<TextBlock Grid.Column="2" Margin="4,0" VerticalAlignment="Center" Text="~" />
															<TextBox Grid.Column="3" AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Devices.Wiring.Fence.Band.End.{0}}" AutomationProperties.Name="대역 끝" Style="{StaticResource W.TextBox}" Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" />
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
											<TextBlock Foreground="{DynamicResource StatusCriticalBrush}" FontSize="12" Text="{Binding BandError}" TextWrapping="Wrap" Visibility="{Binding HasBandError, Converter={StaticResource BoolToVisibility}}" />
											<Button Margin="0,4,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.ApplyCustom" Click="OnBandCustom" Content="직접 설정 적용" Style="{StaticResource Console.Button}" />
											<StackPanel Visibility="{Binding ShowCables, Converter={StaticResource BoolToVisibility}}">
												<TextBlock Margin="0,4,0,0" Text="{Binding EnclosureGapText, StringFormat=함체 위치: {0}}" />
												<UniformGrid Margin="0,6,0,0" Columns="2">
													<Button
														Margin="0,0,4,0"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.EnclosureBack"
														Click="OnEnclosureBack"
														Content="◀ 한 칸"
														Style="{StaticResource Console.Button}" />
													<Button
														Margin="4,0,0,0"
														AutomationProperties.AutomationId="Devices.Wiring.Fence.Pane.EnclosureForward"
														Click="OnEnclosureForward"
														Content="한 칸 ▶"
														Style="{StaticResource Console.Button}" />
												</UniformGrid>
											</StackPanel>
										</StackPanel>
									</StackPanel>
								</Border>

								<!--  배너 — 색이 아니라 왼쪽 굵은 바 + 글자  -->
								<Border
									Padding="10,8"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{Binding BannerLevel, Converter={StaticResource IssueBrush}}"
									BorderThickness="3,0,0,0"
									CornerRadius="0,6,6,0">
									<StackPanel>
										<TextBlock
											AutomationProperties.AutomationId="Devices.Wiring.Banner"
											FontSize="12.5"
											FontWeight="SemiBold"
											Text="{Binding BannerTitle}"
											TextWrapping="Wrap" />
										<ItemsControl
											Margin="0,4,0,0"
											Focusable="False"
											ItemsSource="{Binding Issues}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<DockPanel Margin="0,2,0,0" LastChildFill="True">
														<TextBlock
															Margin="0,0,5,0"
															VerticalAlignment="Top"
															DockPanel.Dock="Left"
															FontSize="12"
															Foreground="{Binding Level, Converter={StaticResource IssueBrush}}"
															Text="{Binding Level, Converter={StaticResource IssueGlyph}}" />
														<TextBlock
															FontSize="12"
															Text="{Binding Message}"
															TextWrapping="Wrap" />
													</DockPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>

								<TextBlock Style="{StaticResource W.SectionHead}" Text="글로 확인" />
								<Border
									Padding="9,7"
									Background="{DynamicResource SurfaceSunkenBrush}"
									CornerRadius="6">
									<TextBlock
										AutomationProperties.AutomationId="Devices.Wiring.LoopText"
										FontFamily="Consolas"
										FontSize="12"
										Text="{Binding LoopText}"
										TextWrapping="Wrap" />
								</Border>

								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource W.SectionHead}" Text="고장 구간과의 관계" />
									<!--  "?"(help-callout H-2) — 옛 두 문장 설명(Devices.Wiring.FaultRelation)을 여기로. 아래 예시(FaultText)는 이 결선의 값이라 화면에 남는다  -->
									<c:HelpTip
										Margin="6,6,0,0"
										VerticalAlignment="Center"
										HelpKey="Devices.Wiring.Check.Fault" />
								</StackPanel>
								<Border
									Padding="9,7"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource StatusInfoBrush}"
									BorderThickness="3,0,0,0"
									CornerRadius="0,6,6,0">
									<TextBlock
										AutomationProperties.AutomationId="Devices.Wiring.FaultText"
										FontSize="12"
										Text="{Binding FaultText}"
										TextWrapping="Wrap" />
								</Border>

								<TextBlock Style="{StaticResource W.SectionHead}" Text="변경 미리보기" />
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.ChangePreview"
									FontSize="12"
									Text="{Binding ChangePreview}"
									TextWrapping="Wrap" />

								<!--  U-18 D-9 9.1 — 저장 위치 · 요청 횟수 설명을 빼고 "몇 대를 저장하는지" 만 말한다. 바뀐 것이 없으면 접는다.  -->
								<StackPanel Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
									<TextBlock Style="{StaticResource W.SectionHead}" Text="저장 방식" />
									<TextBlock Style="{StaticResource W.Hint}" Text="{Binding SaveNoteText}" />
								</StackPanel>

								<StackPanel Margin="0,10,0,0" Visibility="{Binding HasSaveResults, Converter={StaticResource BoolToVisibility}}">
									<TextBlock Style="{StaticResource W.SectionHead}" Text="저장하지 못한 줄" />
									<ItemsControl
										AutomationProperties.AutomationId="Devices.Wiring.SaveFailures"
										Focusable="False"
										ItemsSource="{Binding SaveResults}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock
													Margin="0,2,0,0"
													FontSize="12"
													Foreground="{DynamicResource StatusCriticalBrush}"
													TextWrapping="Wrap">
													<Run Text="{Binding Display, Mode=OneWay}" />
													<Run Text=" — " />
													<Run Text="{Binding Message, Mode=OneWay}" />
												</TextBlock>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</StackPanel>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Grid>
		</Grid>
	</DockPanel>
</UserControl>
