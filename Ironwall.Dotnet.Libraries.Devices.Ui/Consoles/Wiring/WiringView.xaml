<UserControl
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.WiringView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:wiring="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring"
	xmlns:fence="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Fence"
	xmlns:signals="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.Signals"
	c:ConsoleWindowChrome.DressWindow="True"
	Background="{DynamicResource SurfaceBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		장비 셋업 · 결선맵 (device-wiring-setup N-04). 정본 목업: docs/design/device-setup-wiring-storyboard.html
		  · 단계 띠 L334-337 · 센서 표 L338-357 · 일괄 입력 칸 L595-646 · 결선맵 L391-429 · 확인 칸 L414-428
		드래그는 콘솔 커널만 쓴다: 핸들(Thumb)에서만 시작 · 캡처 드래그 · 놓을 수 있음/없음은 형태로 · Esc 제자리 복귀.
		키보드 폴백: 팔레트 Enter = 첫 빈 칸 · 칸에서 Alt+← → = 한 칸 이동 · Delete = 빼기.
		x:Name 은 쓰지 않는다 — 계측은 AutomationId(Devices.Wiring.*).
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<wiring:IssueLevelBrushConverter x:Key="IssueBrush" />
		<wiring:IssueLevelGlyphConverter x:Key="IssueGlyph" />
		<wiring:SensorTypeDisplayConverter x:Key="SensorTypeKorean" />
		<wiring:PackIconKindNameConverter x:Key="IconKind" />

		<!--  종류 콤보 드롭다운 항목 — 겉보기만 "한국어 (코드)". Text 바인딩은 그대로 원문 코드를 나른다.  -->
		<DataTemplate x:Key="W.SensorTypeItem">
			<TextBlock Text="{Binding Converter={StaticResource SensorTypeKorean}}" />
		</DataTemplate>

		<Style x:Key="W.Title" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		<Style x:Key="W.Hint" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<!--  알림 한 줄의 글자 — 한 줄(넘치면 … · 툴팁에 전부)  -->
		<Style x:Key="W.NoticeText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="TextWrapping" Value="NoWrap" />
		</Style>
		<!--  [알림 n] 칩 — 둥근 알약. 켜지면(목록이 열리면) 주 색 테두리 2(색만이 아니라 굵기로도)  -->
		<Style x:Key="W.NoticeChip" TargetType="ToggleButton">
			<Setter Property="Height" Value="24" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border
							Padding="{TemplateBinding Padding}"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
				</Trigger>
				<Trigger Property="IsChecked" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
					<Setter Property="BorderThickness" Value="2" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Cursor" Value="Arrow" />
					<Setter Property="Background" Value="Transparent" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<!--  속성 칸 가장자리 접기 막대 — 칸 높이 전체의 얇은 띠(글자 ‹ ›)  -->
		<Style x:Key="W.EdgeToggle" TargetType="Button">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
			<Setter Property="BorderThickness" Value="1,0,0,0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
					<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
				</Trigger>
				<Trigger Property="IsKeyboardFocused" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
					<Setter Property="BorderThickness" Value="2" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="W.SectionHead" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
			<Setter Property="Margin" Value="0,12,0,6" />
		</Style>
		<Style x:Key="W.TextBox" TargetType="TextBox">
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		<!--  표 칸 — 한 번 누르면 바로 입력(WS L360). 편집 템플릿으로 갈아끼우지 않는다.  -->
		<Style x:Key="W.CellBox" TargetType="TextBox">
			<Setter Property="Height" Value="26" />
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
					<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
				</Trigger>
				<Trigger Property="IsKeyboardFocused" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
					<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<!--  케이블 선 — 칸(56) 의 절반 높이에 걸치게 위에서 36 내린다  -->
		<Style x:Key="W.Cable" TargetType="Rectangle">
			<Setter Property="Margin" Value="4,36,68,0" />
		</Style>
		<!--  U-14 — 커널 버튼 규격(32 · 글자 13) 그대로 쓴다. 이 창이 정하는 것은 자리 간격(8 — 집 규칙)뿐이다.  -->
		<Style x:Key="W.Chip" TargetType="Button" BasedOn="{StaticResource Console.Button}">
			<Setter Property="Margin" Value="0,0,8,8" />
		</Style>

		<!--
			표 보기 체인 목록(표 보기 정리 · 2026-09-30) — 링 체인을 한 줄씩 위에서 아래로(Sensor A 쪽 끝이 1).
			가상화를 끈다(화면 밖 줄은 드롭 자리가 될 수 없다 · 제어기 한 대분이라 전량 로딩이 전제).
		-->
		<Style x:Key="W.RowList" TargetType="ListBox">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
			<Setter Property="ScrollViewer.CanContentScroll" Value="False" />
			<Setter Property="ItemsPanel">
				<Setter.Value>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Vertical" />
					</ItemsPanelTemplate>
				</Setter.Value>
			</Setter>
			<Setter Property="ItemContainerStyle">
				<Setter.Value>
					<Style TargetType="ListBoxItem">
						<Setter Property="FocusVisualStyle" Value="{x:Null}" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						<!--  컨테이너는 상속을 끊는다(BasedOn 이 없어 다크에서 검정 글자) — 한 번 못 박는다  -->
						<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
						<!--  키보드로 옮기면 선택 표시와 UIA SelectionItemPattern 이 같이 따라와야 한다(C8)  -->
						<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
						<!--  계측은 peer 가 있는 컨테이너에 붙인다(C9) — 헤디드 시험이 쓰는 Devices.Wiring.Slot.{선}-{자리} 그대로  -->
						<Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationKey, StringFormat=Devices.Wiring.Slot.{0}}" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListBoxItem">
									<Grid Background="Transparent">
										<ContentPresenter />
										<!--  고른 줄 = 왼쪽 3px 세로 바(선택의 기존 어휘) · 드롭 표시(윤곽)와 축이 직교한다  -->
										<Rectangle
											x:Name="Bar"
											Width="3"
											Margin="0,0,0,1"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Height="37"
											Fill="{DynamicResource PrimaryBrush}"
											IsHitTestVisible="False"
											Visibility="Collapsed" />
									</Grid>
									<ControlTemplate.Triggers>
										<Trigger Property="IsSelected" Value="True">
											<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  표 보기 열 머리 · 줄의 글자  -->
		<Style x:Key="W.ColHead" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style x:Key="W.Cell" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style x:Key="W.CellMono" TargetType="TextBlock" BasedOn="{StaticResource W.Cell}">
			<Setter Property="FontFamily" Value="Consolas" />
		</Style>
		<!--  상태 표지 — 색 하나로 말하지 않는다(테두리 + 글자)  -->
		<Style x:Key="W.Tag" TargetType="Border">
			<Setter Property="Margin" Value="0,0,4,0" />
			<Setter Property="Padding" Value="4,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		</Style>

		<!--
			체인 한 줄 — 높이 38 고정 · 열 폭 고정(머리 줄과 같은 값). 함체(제어기) 자리 앞 줄에는 구분 띠("A 쪽 ← 함체 → B 쪽").
			열: 손잡이 24 · 위치 44 · A/B 88 · 이름 * · 장비번호 72 · 종류 112 · 방향 44 · 주소 100(IP · 노드 주소) · 간격 52 · 상태 112 · 빼기 30
		-->
		<DataTemplate x:Key="W.RowTemplate">
			<StackPanel>
				<Border
					Height="26"
					Margin="0,4,0,4"
					Background="{DynamicResource SurfaceSunkenBrush}"
					BorderBrush="{DynamicResource PrimaryBrush}"
					BorderThickness="0,1,0,1"
					Visibility="{Binding EnclosureBefore, Converter={StaticResource BoolToVisibility}}">
					<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
						<md:PackIcon
							Width="15"
							Height="15"
							Margin="0,0,6,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource PrimaryBrush}"
							Kind="ServerNetwork" />
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Devices.Wiring.Table.EnclosureSplit"
							FontSize="11.5"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding EnclosureLabel}" />
					</StackPanel>
				</Border>
				<drag:DropZoneChrome
					drag:DropZone.Data="{Binding}"
					drag:DropZone.Key="wiring-slot"
					CornerRadius="4">
					<Grid Height="38" ToolTip="{Binding Tooltip}">
						<!--  끝 줄 — 여기 놓으면 끝에 붙는다(체인에는 가운데 빈 줄이 없다)  -->
						<Rectangle
							Margin="0,3"
							RadiusX="4"
							RadiusY="4"
							Fill="{DynamicResource SurfaceBrush}"
							Stroke="{DynamicResource TextMutedBrush}"
							StrokeDashArray="2 3"
							StrokeThickness="1"
							Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontSize="11.5"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding SlotLabel}"
							Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

						<!--  찬 줄  -->
						<Border
							BorderBrush="{DynamicResource RowLineBrush}"
							BorderThickness="0,0,0,1"
							Visibility="{Binding IsFilled, Converter={StaticResource BoolToVisibility}}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="24" />
									<ColumnDefinition Width="44" />
									<ColumnDefinition Width="88" />
									<ColumnDefinition Width="*" MinWidth="120" />
									<ColumnDefinition Width="72" />
									<ColumnDefinition Width="112" />
									<ColumnDefinition Width="44" />
									<ColumnDefinition Width="100" />
									<ColumnDefinition Width="52" />
									<ColumnDefinition Width="112" />
									<ColumnDefinition Width="30" />
								</Grid.ColumnDefinitions>
								<drag:DragHandle
									Grid.Column="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Devices.Wiring.SlotHandle.{0}}" />
								<!--  위치 — 원 배지(순번)  -->
								<Border
									Grid.Column="1"
									MinWidth="26"
									Height="20"
									Padding="5,0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Background="{DynamicResource PrimaryBrush}"
									CornerRadius="10">
									<TextBlock
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="11.5"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryBrush}"
										Text="{Binding OrderText}" />
								</Border>
								<TextBlock Grid.Column="2" Style="{StaticResource W.CellMono}" Text="{Binding PortText}" />
								<TextBlock
									Grid.Column="3"
									Margin="0,0,8,0"
									FontWeight="SemiBold"
									Style="{StaticResource W.Cell}"
									Text="{Binding Title}"
									ToolTip="{Binding Title}" />
								<TextBlock Grid.Column="4" Style="{StaticResource W.CellMono}" Text="{Binding NumberText}" />
								<StackPanel Grid.Column="5" VerticalAlignment="Center" Orientation="Horizontal">
									<md:PackIcon
										Width="15"
										Height="15"
										Margin="0,0,5,0"
										VerticalAlignment="Center"
										Foreground="{DynamicResource TextSecondaryBrush}"
										Kind="{Binding TypeIcon, Converter={StaticResource IconKind}}" />
									<TextBlock Style="{StaticResource W.Cell}" Text="{Binding TypeText}" />
								</StackPanel>
								<TextBlock Grid.Column="6" Style="{StaticResource W.Cell}" Text="{Binding FacingText}" />
								<StackPanel Grid.Column="7" VerticalAlignment="Center" Orientation="Horizontal">
									<TextBlock Style="{StaticResource W.CellMono}" Text="{Binding AddressCellText}" ToolTip="{Binding AddressCellText}" />
									<!--  주소 ≠ 순번 — 고치지 않고 알리기만 한다  -->
									<TextBlock
										Margin="4,0,0,0"
										VerticalAlignment="Center"
										FontSize="12"
										Foreground="{DynamicResource StatusWarningBrush}"
										Text="≠"
										ToolTip="주소 ≠ 순번"
										Visibility="{Binding HasChannelMismatch, Converter={StaticResource BoolToVisibility}}" />
								</StackPanel>
								<TextBlock Grid.Column="8" Style="{StaticResource W.CellMono}" Text="{Binding GapText}" />
								<WrapPanel Grid.Column="9" VerticalAlignment="Center" Orientation="Horizontal">
									<Border
										Style="{StaticResource W.Tag}"
										ToolTip="번호순 제안"
										Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVisibility}}">
										<TextBlock FontSize="10.5" Text="제안" />
									</Border>
									<Border
										BorderBrush="{DynamicResource StatusWarningBrush}"
										Style="{StaticResource W.Tag}"
										ToolTip="저장하지 않은 줄"
										Visibility="{Binding IsDraft, Converter={StaticResource BoolToVisibility}}">
										<TextBlock FontSize="10.5" Text="● 미저장" />
									</Border>
									<Border
										Style="{StaticResource W.Tag}"
										ToolTip="같은 장비번호"
										Visibility="{Binding IsDuplicateNumber, Converter={StaticResource BoolToVisibility}}">
										<TextBlock FontSize="10.5" Text="번호 같음" />
									</Border>
								</WrapPanel>
								<Button
									Grid.Column="10"
									Width="22"
									Height="22"
									Padding="0"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Devices.Wiring.SlotRemove.{0}}"
									Click="OnRemoveSlot"
									Content="✕"
									FontSize="10"
									Style="{StaticResource Console.Button.Icon}"
									ToolTip="결선에서 빼기(Delete)" />
							</Grid>
						</Border>
					</Grid>
				</drag:DropZoneChrome>
			</StackPanel>
		</DataTemplate>
	</UserControl.Resources>

	<DockPanel LastChildFill="True">
		<!--
			── 머리 한 줄(창 정리 2026-10-01 · 사용자: "위쪽 쓸데없는 것 정리") ── 대상 제어기 · 단계 띠 · [펜스 보기|표 보기] · 바뀐 줄 수 · 단추.
			옛 세 줄(머리 40 · "바뀐 줄이 없습니다" 줄 · 단계 띠 34)을 한 줄(44)로 — 저장이 막힌 까닭은 아래 상태줄 오른쪽에 둔다.
			단추는 한 칸(8)씩 · 보조 → 주(主) 차례로, [저장하기]가 맨 오른쪽이다.
		-->
		<Border
			Height="44"
			Padding="16,0,8,0"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1"
			DockPanel.Dock="Top">
			<DockPanel LastChildFill="True">
				<StackPanel
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					Orientation="Horizontal">
					<Button
						Margin="0,0,8,0"
						AutomationProperties.AutomationId="Devices.Wiring.AutoLayout"
						Click="OnAutoLayout"
						Content="번호 순으로 자동 배치"
						Style="{StaticResource Console.Button}"
						ToolTip="번호 순으로 다시 줄 세우기"
						Visibility="{Binding IsWiringStep, Converter={StaticResource BoolToVisibility}}" />
					<Button
						Margin="0,0,8,0"
						AutomationProperties.AutomationId="Devices.Wiring.Undo"
						Click="OnUndo"
						Content="되돌리기"
						IsEnabled="{Binding CanUndo}"
						Style="{StaticResource Console.Button}" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Save"
						Click="OnSave"
						Content="저장하기"
						IsEnabled="{Binding CanSave}"
						Style="{StaticResource Console.Button.Primary}"
						ToolTip="{Binding SaveBlockedReason}" />
					<!--  창 "?"(help-callout H-2) — 단계 · 보기 · 자동 배치 · 되돌리기 · 저장. 상태줄 결과 문장 뒤의 "Ctrl+Z 로 되돌립니다" 꼬리도 여기로 모았다  -->
					<c:HelpTip
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						HelpKey="Devices.Wiring"
						Scope="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" />
				</StackPanel>
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<!--  창 제목("장비 셋업 · 결선맵")은 커널 창 머리가 그린다 — 여기는 대상 제어기만(헤디드 시험이 Devices.Wiring.Subject 로 창을 찾는다)  -->
					<TextBlock
						MaxWidth="260"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Subject"
						FontSize="14"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding Subject}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding Subject}" />
					<Rectangle
						Width="1"
						Height="18"
						Margin="14,0,12,0"
						VerticalAlignment="Center"
						Fill="{DynamicResource DividerBrush}" />
					<!--  단계 띠(WS L334-337) — 지금 단계는 ▸ + 굵게, 끝난 단계는 ✓. 색 하나로 말하지 않는다. [센서] · [결선] 은 누르면 그 단계로 간다  -->
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Step.Controller"
						FontSize="12.5"
						Foreground="{DynamicResource StatusNormalBrush}"
						Text="{Binding StepControllerGlyph, StringFormat={}{0} 제어기}" />
					<TextBlock
						Margin="6,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource DividerBrush}"
						Text="›" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Step.Sensors"
						Click="OnGoSensors"
						Style="{StaticResource Console.Button.Ghost}">
						<Grid>
							<!--  U-14 — 굵은 폭 예약(커널 Console.Tab 과 같은 고스트) — 지금 단계가 바뀌어 굵어져도 띠가 흔들리지 않는다.  -->
							<TextBlock
								FontSize="12.5"
								FontWeight="Bold"
								IsHitTestVisible="False"
								Opacity="0"
								Text="{Binding StepSensorsGlyph, StringFormat={}{0} 센서}" />
							<TextBlock FontSize="12.5" Text="{Binding StepSensorsGlyph, StringFormat={}{0} 센서}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsSensorStep}" Value="True">
												<Setter Property="FontWeight" Value="Bold" />
												<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsSensorStepDone}" Value="True">
												<Setter Property="Foreground" Value="{DynamicResource StatusNormalBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Button>
					<TextBlock
						Margin="6,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource DividerBrush}"
						Text="›" />
					<Button
						AutomationProperties.AutomationId="Devices.Wiring.Step.Wiring"
						Click="OnGoWiring"
						Style="{StaticResource Console.Button.Ghost}">
						<Grid>
							<TextBlock
								FontSize="12.5"
								FontWeight="Bold"
								IsHitTestVisible="False"
								Opacity="0"
								Text="{Binding StepWiringGlyph, StringFormat={}{0} 결선}" />
							<TextBlock FontSize="12.5" Text="{Binding StepWiringGlyph, StringFormat={}{0} 결선}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsWiringStep}" Value="True">
												<Setter Property="FontWeight" Value="Bold" />
												<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
											</DataTrigger>
											<DataTrigger Binding="{Binding IsWiringStepDone}" Value="True">
												<Setter Property="Foreground" Value="{DynamicResource StatusNormalBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Button>
					<TextBlock
						Margin="6,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource DividerBrush}"
						Text="›" />
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Step.Confirm"
						FontSize="12.5"
						Text="{Binding StepConfirmGlyph, StringFormat={}{0} 확인}">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsConfirmActive}" Value="True">
										<Setter Property="FontWeight" Value="Bold" />
										<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<!--
						보기 전환 — [펜스 보기](기본) · [표 보기]. 결선 단계에서만. 둘 다 같은 보드를 본다(wiring-fence-view F-3).
						고른 쪽은 아래 막대(형태)로 보인다.
					-->
					<StackPanel
						Margin="18,0,0,0"
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Visibility="{Binding IsWiringStep, Converter={StaticResource BoolToVisibility}}">
						<StackPanel Margin="0,0,4,0">
							<Button
								AutomationProperties.AutomationId="Devices.Wiring.View.Fence"
								Click="OnShowFence"
								Content="펜스 보기"
								Style="{StaticResource Console.Button}" />
							<Rectangle
								Height="2"
								Margin="4,1,4,0"
								Fill="{DynamicResource PrimaryBrush}"
								Visibility="{Binding IsFenceView, Converter={StaticResource BoolToVisibility}}" />
						</StackPanel>
						<StackPanel>
							<Button
								AutomationProperties.AutomationId="Devices.Wiring.View.Table"
								Click="OnShowTable"
								Content="표 보기"
								Style="{StaticResource Console.Button}" />
							<Rectangle
								Height="2"
								Margin="4,1,4,0"
								Fill="{DynamicResource PrimaryBrush}"
								Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibility}}" />
						</StackPanel>
					</StackPanel>
					<TextBlock
						Margin="16,0,0,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.Progress"
						FontSize="12"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding ProgressText}"
						Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
					<TextBlock
						Margin="16,0,0,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Devices.Wiring.DraftCount"
						FontSize="12"
						Foreground="{DynamicResource StatusWarningBrush}"
						Text="{Binding DraftText}" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!--
			── 상태줄 ── 센서 수 · (펜스 보기) 종류별 수 · 마지막 동작 · 저장이 막힌 까닭(오른쪽 · 바꾼 것이 있으면 경고색).
			옛 "바뀐 줄이 없습니다" 줄 · 펜스 보기 바닥 띠를 여기로 합쳤다(창 정리 2026-10-01).
		-->
		<Border
			Height="30"
			Padding="16,0"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0"
			DockPanel.Dock="Bottom">
			<DockPanel LastChildFill="True">
				<TextBlock
					MaxWidth="420"
					Margin="16,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Wiring.SaveBlockedReason"
					DockPanel.Dock="Right"
					FontSize="12"
					Text="{Binding SaveBlockedReason}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding SaveBlockedReason}">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding HasChanges}" Value="True">
									<Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
									<Setter Property="FontWeight" Value="SemiBold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
				<TextBlock
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Wiring.Counts"
					FontSize="12"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding ListStatusText}" />
				<TextBlock
					MaxWidth="460"
					Margin="16,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Wiring.Fence.Counts"
					FontSize="12"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding FenceCountsText}"
					TextTrimming="CharacterEllipsis"
					ToolTip="{Binding FenceCountsText}"
					Visibility="{Binding IsFenceCountsShown, Converter={StaticResource BoolToVisibility}}" />
				<TextBlock
					Margin="16,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Wiring.Status"
					FontSize="12"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding StatusText}"
					TextTrimming="CharacterEllipsis" />
			</DockPanel>
		</Border>

		<Grid>
			<!--  ══════════ 파트 1 — 센서 표 (WS L338-357) ══════════  -->
			<Grid Visibility="{Binding IsSensorStep, Converter={StaticResource BoolToVisibility}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="360" />
				</Grid.ColumnDefinitions>

				<DockPanel LastChildFill="True">
					<Border
						Padding="10,7"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,0,0,1"
						DockPanel.Dock="Top">
						<!--
							U-14 — 버튼이 먼저 자리를 잡고 안내 글이 남는 폭을 쓴다. 옛 판은 안내 글을 오른쪽에 먼저 도킹해
							1000 폭에서 [엑셀에서 붙여넣기] 가 "엑셀에서 붙" 에서 글자 중간이 잘렸다(wiring-light-02b-narrow-1000).
						-->
						<DockPanel LastChildFill="True">
							<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
								<Button
									Margin="0,0,8,0"
									AutomationProperties.AutomationId="Devices.Wiring.MakeSensors"
									Click="OnMakeSensors"
									Content="＋ 센서 여러 개 만들기"
									Style="{StaticResource Console.Button.Primary}" />
								<Button
									Margin="0,0,8,0"
									AutomationProperties.AutomationId="Devices.Wiring.AddRow"
									Click="OnAddRow"
									Content="＋ 한 줄"
									Style="{StaticResource Console.Button}" />
								<Button
									AutomationProperties.AutomationId="Devices.Wiring.Paste"
									Click="OnPaste"
									Content="엑셀에서 붙여넣기"
									Style="{StaticResource Console.Button}" />
							</StackPanel>
							<!--  센서 표 "?"(help-callout H-2) — 옛 회색 안내 줄 · 주소 열 툴팁을 여기로  -->
							<c:HelpTip
								Margin="12,0,0,0"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								HelpKey="Devices.Wiring.Sensors"
								Scope="{Binding RelativeSource={RelativeSource AncestorType=DockPanel, AncestorLevel=2}}" />
						</DockPanel>
					</Border>

					<Grid>
						<TextBlock
							Margin="16,58,16,16"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							Style="{StaticResource W.Hint}"
							Text="이 제어기에 센서가 없습니다 — [＋ 센서 여러 개 만들기] 로 시작하세요."
							Visibility="{Binding IsNoSensors, Converter={StaticResource BoolToVisibility}}" />
						<DataGrid
							AutomationProperties.AutomationId="Devices.Wiring.Grid"
							ItemsSource="{Binding Rows}"
							SelectionChanged="OnGridSelectionChanged"
							Style="{StaticResource Console.DataGrid}">
							<DataGrid.RowStyle>
								<Style BasedOn="{StaticResource Console.DataGrid.Row}" TargetType="DataGridRow">
									<Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, StringFormat=Devices.Wiring.Row.{0}}" />
								</Style>
							</DataGrid.RowStyle>
							<DataGrid.Columns>
								<!--  Draft 표시 — 색이 아니라 글자로(＋ 새 줄 · ✎ 고친 줄)  -->
								<DataGridTemplateColumn Width="34" MinWidth="34" CellStyle="{StaticResource Console.DataGrid.Cell}">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontSize="14"
												FontWeight="Bold"
												Foreground="{DynamicResource StatusWarningBrush}"
												Text="{Binding StateGlyph}"
												ToolTip="{Binding StateTip}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn Width="90" MinWidth="90" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="번호">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBox
												AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Wiring.Cell.Number.{0}}"
												Style="{StaticResource W.CellBox}"
												Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn Width="*" MinWidth="140" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="이름">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBox
												AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Wiring.Cell.Name.{0}}"
												Style="{StaticResource W.CellBox}"
												Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn Width="130" MinWidth="130" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="종류">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<ComboBox
												AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Wiring.Cell.Type.{0}}"
												FontSize="12.5"
												IsEditable="True"
												ItemTemplate="{StaticResource W.SensorTypeItem}"
												ItemsSource="{Binding DataContext.SensorTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
												Text="{Binding TypeDisplayText, UpdateSourceTrigger=LostFocus}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn Width="140" MinWidth="140" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="구역">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBox
												AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Wiring.Cell.Zone.{0}}"
												Style="{StaticResource W.CellBox}"
												Text="{Binding Zone, UpdateSourceTrigger=LostFocus}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn Width="96" MinWidth="96" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="주소">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding ChannelText}"
												ToolTip="버스 주소" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTemplateColumn Width="90" MinWidth="90" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="결선">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{Binding PlacementText}" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
					</Grid>
				</DockPanel>

				<!--  ── 오른쪽 — 한꺼번에 채우기 (WS L595-646) ──  -->
				<Border
					Grid.Column="1"
					Background="{DynamicResource SurfaceAltBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="1,0,0,0">
					<DockPanel LastChildFill="True">
						<StackPanel
							Margin="13,11"
							DockPanel.Dock="Top">
							<TextBlock
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding SelectionKind}" />
							<TextBlock
								AutomationProperties.AutomationId="Devices.Wiring.SelectionTitle"
								FontSize="16"
								FontWeight="SemiBold"
								Text="{Binding SelectionTitle}"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>

						<Border
							Padding="13,9"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="0,1,0,0"
							DockPanel.Dock="Bottom">
							<DockPanel LastChildFill="True">
								<Button
									AutomationProperties.AutomationId="Devices.Wiring.ApplyEdit"
									Click="OnApplyEdit"
									Content="{Binding ApplyEditText}"
									DockPanel.Dock="Right"
									IsEnabled="{Binding CanApplyEdit}"
									Style="{StaticResource Console.Button.Primary}" />
								<Button
									Margin="0,0,6,0"
									AutomationProperties.AutomationId="Devices.Wiring.CancelEdit"
									Click="OnCancelEdit"
									Content="취소"
									DockPanel.Dock="Right"
									Style="{StaticResource Console.Button.Ghost}" />
							</DockPanel>
						</Border>

						<ScrollViewer
							HorizontalScrollBarVisibility="Disabled"
							Style="{StaticResource Console.ScrollViewer}"
							VerticalScrollBarVisibility="Auto">
							<Grid Margin="13,0,13,12">
							<TextBlock
								Margin="0,12,0,0"
								VerticalAlignment="Top"
								AutomationProperties.AutomationId="Devices.Wiring.NoSelectionHint"
								Style="{StaticResource W.Hint}"
								Text="고른 줄이 없습니다"
								Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />
							<StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Style="{StaticResource W.SectionHead}" Text="값" />
									<c:HelpTip
										Margin="6,6,0,0"
										VerticalAlignment="Center"
										HelpKey="Devices.Wiring.Sensors.Edit"
										Scope="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
								</StackPanel>
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="76" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<TextBlock VerticalAlignment="Center" Style="{StaticResource W.Hint}" Text="번호" />
									<Grid
										Grid.Column="1"
										Margin="0,4">
										<TextBox
											AutomationProperties.AutomationId="Devices.Wiring.Edit.Number"
											Style="{StaticResource W.TextBox}"
											Text="{Binding EditNumber, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock
											Margin="8,0"
											VerticalAlignment="Center"
											FontSize="12.5"
											FontStyle="Italic"
											Foreground="{DynamicResource TextMutedBrush}"
											IsHitTestVisible="False"
											Text="{Binding NumberHint}">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding EditNumber}" Value="">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
									<TextBlock Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource W.Hint}" Text="이름" />
									<Grid
										Grid.Row="1"
										Grid.Column="1"
										Margin="0,4">
										<TextBox
											AutomationProperties.AutomationId="Devices.Wiring.Edit.Name"
											Style="{StaticResource W.TextBox}"
											Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock
											Margin="8,0"
											VerticalAlignment="Center"
											FontSize="12.5"
											FontStyle="Italic"
											Foreground="{DynamicResource TextMutedBrush}"
											IsHitTestVisible="False"
											Text="{Binding NameHint}">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding EditName}" Value="">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
									<TextBlock Grid.Row="2" VerticalAlignment="Center" Style="{StaticResource W.Hint}" Text="종류" />
									<ComboBox
										Grid.Row="2"
										Grid.Column="1"
										Margin="0,4"
										AutomationProperties.AutomationId="Devices.Wiring.Edit.Type"
										IsEditable="True"
										ItemTemplate="{StaticResource W.SensorTypeItem}"
										ItemsSource="{Binding SensorTypes}"
										md:HintAssist.Hint="{Binding TypeHint}"
										Text="{Binding EditTypeDisplay, UpdateSourceTrigger=PropertyChanged}" />
									<TextBlock Grid.Row="3" VerticalAlignment="Center" Style="{StaticResource W.Hint}" Text="구역" />
									<Grid
										Grid.Row="3"
										Grid.Column="1"
										Margin="0,4">
										<TextBox
											AutomationProperties.AutomationId="Devices.Wiring.Edit.Zone"
											Style="{StaticResource W.TextBox}"
											Text="{Binding EditZone, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock
											Margin="8,0"
											VerticalAlignment="Center"
											FontSize="12.5"
											FontStyle="Italic"
											Foreground="{DynamicResource TextMutedBrush}"
											IsHitTestVisible="False"
											Text="{Binding ZoneHint}">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding EditZone}" Value="">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
								</Grid>

								<WrapPanel Margin="0,8,0,0" Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisibility}}">
									<Button
										AutomationProperties.AutomationId="Devices.Wiring.FillSequential"
										Click="OnFillSequential"
										Content="연속 번호 채우기"
										Style="{StaticResource W.Chip}" />
									<Button
										AutomationProperties.AutomationId="Devices.Wiring.UnifyFirst"
										Click="OnUnifyFirst"
										Content="첫 줄 값으로 통일"
										Style="{StaticResource W.Chip}" />
									<Button
										AutomationProperties.AutomationId="Devices.Wiring.NameRule"
										Click="OnNameRule"
										Content="이름 규칙 만들기"
										Style="{StaticResource W.Chip}" />
								</WrapPanel>

								<!--  그룹 3상태(WS L614-618) — 체크를 바꾼 그룹만 더하고 뺀다. 덮어쓰지 않는다.  -->
								<StackPanel Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
									<StackPanel Orientation="Horizontal">
										<TextBlock Style="{StaticResource W.SectionHead}" Text="그룹" />
										<c:HelpTip
											Margin="6,6,0,0"
											VerticalAlignment="Center"
											HelpKey="Devices.Wiring.Sensors.Groups"
											Scope="{Binding RelativeSource={RelativeSource AncestorType=StackPanel, AncestorLevel=2}}" />
									</StackPanel>
									<ItemsControl AutomationProperties.AutomationId="Devices.Wiring.Groups" ItemsSource="{Binding GroupChecks}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Button
													Margin="0,1"
													Padding="4,2"
													HorizontalContentAlignment="Stretch"
													AutomationProperties.AutomationId="{Binding Id, StringFormat=Devices.Wiring.Group.{0}}"
													Click="OnToggleGroup"
													Style="{StaticResource Console.Button.Ghost}">
													<DockPanel LastChildFill="True">
														<CheckBox
															Margin="0,0,8,0"
															VerticalAlignment="Center"
															DockPanel.Dock="Left"
															Focusable="False"
															IsChecked="{Binding IsChecked, Mode=OneWay}"
															IsHitTestVisible="False"
															IsThreeState="True"
															Style="{StaticResource Console.CheckBox}" />
														<TextBlock
															Margin="8,0,0,0"
															VerticalAlignment="Center"
															DockPanel.Dock="Right"
															FontSize="11"
															Foreground="{DynamicResource TextMutedBrush}"
															Text="{Binding MixedText}" />
														<TextBlock
															VerticalAlignment="Center"
															FontSize="12.5"
															Foreground="{DynamicResource TextPrimaryBrush}"
															Text="{Binding Name}"
															TextTrimming="CharacterEllipsis">
															<TextBlock.Style>
																<Style TargetType="TextBlock">
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsTouched}" Value="True">
																			<Setter Property="FontWeight" Value="Bold" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</TextBlock.Style>
														</TextBlock>
													</DockPanel>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<Border
									Margin="0,8,0,0"
									Padding="9,7"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource PrimaryBrush}"
									BorderThickness="3,0,0,0"
									CornerRadius="0,5,5,0"
									Visibility="{Binding HasEdit, Converter={StaticResource BoolToVisibility}}">
									<StackPanel>
										<TextBlock
											AutomationProperties.AutomationId="Devices.Wiring.EditPreview"
											FontSize="12"
											Text="{Binding EditPreview}"
											TextWrapping="Wrap" />
										<TextBlock
											Margin="0,5,0,0"
											FontSize="11.5"
											Foreground="{DynamicResource StatusWarningBrush}"
											Text="{Binding EditAdvice}"
											TextWrapping="Wrap"
											Visibility="{Binding HasEditAdvice, Converter={StaticResource BoolToVisibility}}" />
										<TextBlock
											Margin="0,5,0,0"
											FontSize="11.5"
											Foreground="{DynamicResource StatusCriticalBrush}"
											Text="{Binding EditError}"
											TextWrapping="Wrap"
											Visibility="{Binding HasEditError, Converter={StaticResource BoolToVisibility}}" />
									</StackPanel>
								</Border>

							</StackPanel>
							</Grid>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</Grid>

			<!--  ══════════ 파트 2 — 결선맵 (WS L391-429) ══════════  -->
			<Grid Visibility="{Binding IsWiringStep, Converter={StaticResource BoolToVisibility}}">
				<!--  왼쪽 그림 · 접기 막대 · 오른쪽 속성 칸(기본 320 · 접으면 그림이 폭을 갖는다 — 창 정리 2026-10-01)  -->
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<DockPanel LastChildFill="True">
					<!--
						알림 한 줄(창 정리 2026-10-01 · 옛 알림 칸 여러 줄을 쌓지 않는다) — [알림 n] 칩 + 가장 앞 알림 + 그 할 일 단추.
						차례: 할 일(번호순 제안 · 번호 대역) → 경고(제안 함께 적용 · 옛 배치) → 안내(결선 모양 · 펜스 구성). 칩을 누르면 전부 펼친다.
						알림마다 예전 자동화 id(Devices.Wiring.SuggestionNotice · Fence.Band.Missing …)를 그대로 쓴다 — 그 알림이 맨 앞일 때 이 줄에 보인다.
					-->
					<Border
						Margin="12,8,12,0"
						Padding="6,4,6,4"
						Background="{DynamicResource SurfaceSunkenBrush}"
						BorderBrush="{DynamicResource StatusInfoBrush}"
						BorderThickness="3,0,0,0"
						CornerRadius="0,6,6,0"
						DockPanel.Dock="Top"
						Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
						<DockPanel LastChildFill="True">
							<!--  [알림 n] — 누르면 알림 전부(팝업). 하나뿐이면 글자만  -->
							<Grid Margin="0,0,8,0" VerticalAlignment="Center" DockPanel.Dock="Left">
								<ToggleButton
									MinWidth="0"
									Padding="8,0"
									AutomationProperties.AutomationId="Devices.Wiring.Notices.Toggle"
									AutomationProperties.Name="알림 모두 보기"
									Content="{Binding NoticeChipText}"
									IsChecked="{Binding IsNoticeListOpen, Mode=TwoWay}"
									IsEnabled="{Binding HasMoreNotices}"
									Style="{StaticResource W.NoticeChip}"
									ToolTip="알림을 모두 펼칩니다" />
								<Popup
									AllowsTransparency="True"
									IsOpen="{Binding IsNoticeListOpen, Mode=TwoWay}"
									Placement="Bottom"
									StaysOpen="False">
									<Border
										MaxWidth="720"
										Padding="10,8"
										Background="{DynamicResource SurfaceBrush}"
										BorderBrush="{DynamicResource RowLineBrush}"
										BorderThickness="1"
										CornerRadius="7">
										<ItemsControl AutomationProperties.AutomationId="Devices.Wiring.Notices.List" ItemsSource="{Binding Notices}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<DockPanel Margin="0,3" LastChildFill="True">
														<Button
															Margin="10,0,0,0"
															AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Devices.Wiring.Notices.Action.{0}}"
															Click="OnNoticeAction"
															Content="{Binding ActionText}"
															DockPanel.Dock="Right"
															Style="{StaticResource Console.Button}"
															Tag="{Binding Kind}"
															Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
														<Rectangle
															Width="3"
															Margin="0,0,8,0"
															DockPanel.Dock="Left">
															<Rectangle.Style>
																<Style TargetType="Rectangle">
																	<Setter Property="Fill" Value="{DynamicResource StatusInfoBrush}" />
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsWarning}" Value="True">
																			<Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</Rectangle.Style>
														</Rectangle>
														<TextBlock
															VerticalAlignment="Center"
															AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat=Devices.Wiring.Notices.Item.{0}}"
															FontSize="12"
															Foreground="{DynamicResource TextPrimaryBrush}"
															Text="{Binding Text}"
															TextWrapping="Wrap" />
													</DockPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Border>
								</Popup>
							</Grid>
							<!--  가장 앞 알림의 할 일 단추(이 줄 오른쪽)  -->
							<Button
								Margin="8,0,0,0"
								Padding="10,0"
								MinWidth="0"
								AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Choose"
								Click="OnChooseBands"
								Content="대역 고르기"
								DockPanel.Dock="Right"
								Style="{StaticResource Console.Button}"
								ToolTip="번호 대역 고르기"
								Visibility="{Binding IsBandsPrimary, Converter={StaticResource BoolToVisibility}}" />
							<Button
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								AutomationProperties.AutomationId="Devices.Wiring.AcceptSuggestion"
								Click="OnAcceptSuggestion"
								Content="이대로 적용"
								DockPanel.Dock="Right"
								Style="{StaticResource Console.Button}"
								Visibility="{Binding IsSuggestionPrimary, Converter={StaticResource BoolToVisibility}}" />
							<!--  가장 앞 알림 글자 — 한 줄(넘치면 … · 마우스를 올리면 전부)  -->
							<Grid VerticalAlignment="Center">
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.SuggestionNotice"
									Style="{StaticResource W.NoticeText}"
									Text="{Binding SuggestionText}"
									ToolTip="{Binding SuggestionText}"
									Visibility="{Binding IsSuggestionPrimary, Converter={StaticResource BoolToVisibility}}" />
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.Fence.Band.Missing"
									Style="{StaticResource W.NoticeText}"
									Text="{Binding NoBandsNoticeText}"
									ToolTip="{Binding NoBandsNoticeText}"
									Visibility="{Binding IsBandsPrimary, Converter={StaticResource BoolToVisibility}}" />
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.AppliedNotice"
									Style="{StaticResource W.NoticeText}"
									Text="{Binding AppliedNoticeText}"
									ToolTip="{Binding AppliedNoticeText}"
									Visibility="{Binding IsAppliedPrimary, Converter={StaticResource BoolToVisibility}}" />
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.LegacyNotice"
									Style="{StaticResource W.NoticeText}"
									Text="{Binding LegacyNoticeText}"
									ToolTip="{Binding LegacyNoticeText}"
									Visibility="{Binding IsLegacyPrimary, Converter={StaticResource BoolToVisibility}}" />
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.TopologyNotice"
									Style="{StaticResource W.NoticeText}"
									Text="{Binding TopologyNoticeText}"
									ToolTip="{Binding TopologyNoticeText}"
									Visibility="{Binding IsTopologyPrimary, Converter={StaticResource BoolToVisibility}}" />
								<TextBlock
									AutomationProperties.AutomationId="Devices.Wiring.FenceNotice"
									Style="{StaticResource W.NoticeText}"
									Text="{Binding FenceNoticeText}"
									ToolTip="{Binding FenceNoticeText}"
									Visibility="{Binding IsFencePrimary, Converter={StaticResource BoolToVisibility}}" />
							</Grid>
						</DockPanel>
					</Border>

					<!--
						미배치 · 빼는 곳 한 띠(창 정리 2026-10-01) — 왼쪽 "미배치 n"(센서가 있으면 칩 목록이 펼쳐진다) · 오른쪽 빼는 곳(늘 있다 — 끄는 동안만 열면
						드롭존 등록에서 빠진다 · 끄는 동안 글자가 "여기 놓으면 …"으로 바뀐다). Delete · [고른 칸 빼기]도 그대로.
					-->
					<Border
						Margin="12,6,12,8"
						Padding="8,4"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="1"
						CornerRadius="6"
						DockPanel.Dock="Bottom">
						<DockPanel LastChildFill="True">
							<!--  빼는 곳 — 늘 보인다(끄는 동안만 열면 드롭존 등록에서 빠진다)  -->
							<drag:DropZoneChrome
								Margin="10,0,0,0"
								VerticalAlignment="Top"
								CornerRadius="6"
								DockPanel.Dock="Right"
								drag:DropZone.Key="wiring-bin">
								<Border
									Padding="8,2"
									Background="{DynamicResource SurfaceBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="6"
									ToolTip="빼는 곳">
									<StackPanel Orientation="Horizontal">
										<md:PackIcon
											Width="16"
											Height="16"
											Margin="0,0,6,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource TextMutedBrush}"
											Kind="TrayArrowDown" />
										<TextBlock
											Margin="0,0,8,0"
											VerticalAlignment="Center"
											AutomationProperties.AutomationId="Devices.Wiring.Bin.Hint"
											Style="{StaticResource W.Hint}"
											Text="{Binding BinHintText}" />
										<Button
											AutomationProperties.AutomationId="Devices.Wiring.Bin.UnplaceSelected"
											Click="OnUnplaceSelected"
											Content="고른 칸 빼기"
											Style="{StaticResource Console.Button.Ghost}" />
									</StackPanel>
								</Border>
							</drag:DropZoneChrome>
							<!--  팔레트 — 미배치 센서 (WS L408-412) · 펜스 · 표 두 보기가 함께 쓴다  -->
							<DockPanel LastChildFill="True">
								<!--  미배치 · 빼는 곳 "?"(help-callout H-2) — 옛 빼는 곳 긴 툴팁 · 미배치 칩 키보드(저절로)  -->
								<c:HelpTip
									Margin="0,0,6,0"
									VerticalAlignment="Center"
									DockPanel.Dock="Left"
									HelpKey="Devices.Wiring.Unplaced"
									Scope="{Binding RelativeSource={RelativeSource AncestorType=Border}}" />
								<TextBlock
									Margin="2,0,10,0"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="Devices.Wiring.Palette.Title"
									DockPanel.Dock="Left"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding UnplacedStripText}" />
								<ListBox
									MaxHeight="64"
									AutomationProperties.AutomationId="Devices.Wiring.Palette"
									ItemsSource="{Binding Palette}"
									PreviewKeyDown="OnPalettePreviewKeyDown"
									SelectionMode="Extended"
									Style="{StaticResource Console.ReorderList}"
									Visibility="{Binding IsUnplacedStripExpanded, Converter={StaticResource BoolToVisibility}}">
									<b:Interaction.Behaviors>
										<drag:CaptureDragBehavior
											DisplayMemberPath="Display"
											Handler="{Binding}"
											KeyboardFallback="{}{Enter} = 결선 끝에 붙이기" />
									</b:Interaction.Behaviors>
									<ListBox.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal" />
										</ItemsPanelTemplate>
									</ListBox.ItemsPanel>
									<ListBox.ItemTemplate>
										<DataTemplate>
											<Border
												Margin="0,0,6,4"
												Padding="3,1,9,1"
												Background="{DynamicResource SurfaceBrush}"
												BorderBrush="{DynamicResource BorderBrush}"
												BorderThickness="1"
												CornerRadius="14">
												<StackPanel Orientation="Horizontal">
													<drag:DragHandle AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Wiring.PaletteHandle.{0}}" VerticalAlignment="Center" />
													<TextBlock
														Margin="4,0,6,0"
														VerticalAlignment="Center"
														FontSize="11.5"
														FontWeight="Bold"
														Foreground="{DynamicResource PrimaryBrush}"
														Text="{Binding NumberText}" />
													<TextBlock
														VerticalAlignment="Center"
														AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Wiring.PaletteItem.{0}}"
														FontSize="12.5"
														Text="{Binding Display}" />
												</StackPanel>
											</Border>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</DockPanel>
						</DockPanel>
					</Border>

					<Grid>
						<Border
							Margin="12,0,12,0"
							BorderBrush="{DynamicResource RowLineBrush}"
							BorderThickness="1"
							CornerRadius="6"
							Visibility="{Binding IsFenceView, Converter={StaticResource BoolToVisibility}}">
							<fence:FenceView AutomationProperties.AutomationId="Devices.Wiring.FenceView" />
						</Border>
						<ScrollViewer
							AutomationProperties.AutomationId="Devices.Wiring.TableView"
							HorizontalScrollBarVisibility="Disabled"
							Style="{StaticResource Console.ScrollViewer}"
							VerticalScrollBarVisibility="Auto"
							Visibility="{Binding IsTableView, Converter={StaticResource BoolToVisibility}}">
							<!--
								표 보기(표 보기 정리 · 2026-09-30) — 링처럼 읽히게: 위에 제어기 머리(이름 · 주소 · 종류 · 포트 A/B · 리턴케이블 · 체인 길이/기준),
								아래에 체인 표(열 고정 · 줄 높이 38 · 함체 자리에 "A 쪽 ← 함체 → B 쪽" 띠). 가로 스크롤 없음(1280 기준).
							-->
							<StackPanel Margin="12,0,12,12">
								<!--  제어기 머리  -->
								<Border
									Padding="12,10"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource PrimaryBrush}"
									BorderThickness="2"
									CornerRadius="8">
									<DockPanel LastChildFill="True">
										<!--  포트 A · B + 리턴케이블 — 링의 양 끝  -->
										<StackPanel Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
											<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
												<Border
													Padding="7,2"
													Background="{DynamicResource SurfaceAltBrush}"
													BorderBrush="{DynamicResource BorderBrush}"
													BorderThickness="1"
													CornerRadius="4">
													<TextBlock FontFamily="Consolas" FontSize="11.5" Text="Ch1(A)" />
												</Border>
												<TextBlock
													Margin="6,0"
													VerticalAlignment="Center"
													FontSize="11.5"
													Foreground="{DynamicResource TextSecondaryBrush}"
													Text="◀ 리턴케이블 · 체인 · 리턴케이블 ▶" />
												<Border
													Padding="7,2"
													Background="{DynamicResource SurfaceAltBrush}"
													BorderBrush="{DynamicResource BorderBrush}"
													BorderThickness="1"
													CornerRadius="4">
													<TextBlock FontFamily="Consolas" FontSize="11.5" Text="Ch2(B)" />
												</Border>
											</StackPanel>
										</StackPanel>
										<StackPanel VerticalAlignment="Center">
											<StackPanel Orientation="Horizontal">
												<md:PackIcon
													Width="18"
													Height="18"
													Margin="0,0,8,0"
													VerticalAlignment="Center"
													Foreground="{DynamicResource PrimaryBrush}"
													Kind="ServerNetwork" />
												<TextBlock
													VerticalAlignment="Center"
													AutomationProperties.AutomationId="Devices.Wiring.Table.ControllerName"
													FontSize="15"
													FontWeight="Bold"
													Text="{Binding Controller.Name}"
													TextTrimming="CharacterEllipsis" />
												<TextBlock
													Margin="10,0,0,0"
													VerticalAlignment="Center"
													FontFamily="Consolas"
													FontSize="12.5"
													Foreground="{DynamicResource TextSecondaryBrush}"
													Text="{Binding Controller.Address}" />
											</StackPanel>
											<TextBlock
												Margin="26,4,0,0"
												FontSize="12"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{Binding ControllerKindText}"
												TextTrimming="CharacterEllipsis" />
											<TextBlock
												Margin="26,2,0,0"
												AutomationProperties.AutomationId="Devices.Wiring.Table.ChainSummary"
												FontSize="12"
												FontWeight="SemiBold"
												Text="{Binding ChainSummaryText}"
												TextTrimming="CharacterEllipsis" />
										</StackPanel>
									</DockPanel>
								</Border>

								<!--  체인 표 — 머리 줄(열 폭은 줄 템플릿과 같다)  -->
								<DockPanel Margin="0,12,0,4" LastChildFill="True">
									<!--  표 보기 "?"(help-callout H-2) — 링 읽는 법 · 열 뜻 · 상태 표지 · 끌기(옛 회색 줄 · 열 머리 툴팁 · Line1Hint 를 여기로)  -->
									<c:HelpTip
										Margin="8,0,0,0"
										VerticalAlignment="Center"
										DockPanel.Dock="Right"
										HelpKey="Devices.Wiring.Table"
										Scope="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}}" />
									<TextBlock Style="{StaticResource W.Title}" Text="{Binding Line1Title}" />
								</DockPanel>
								<fb:FrameBorder
									Background="{DynamicResource SurfaceAltBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="1"
									CornerRadius="8">
									<StackPanel>
										<Border
											Height="30"
											Background="{DynamicResource SurfaceBrush}"
											BorderBrush="{DynamicResource DividerBrush}"
											BorderThickness="0,0,0,1"
											CornerRadius="8,8,0,0">
											<Grid Margin="8,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="24" />
													<ColumnDefinition Width="44" />
													<ColumnDefinition Width="88" />
													<ColumnDefinition Width="*" MinWidth="120" />
													<ColumnDefinition Width="72" />
													<ColumnDefinition Width="112" />
													<ColumnDefinition Width="44" />
													<ColumnDefinition Width="100" />
													<ColumnDefinition Width="52" />
