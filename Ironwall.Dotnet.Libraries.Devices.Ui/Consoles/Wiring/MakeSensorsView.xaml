<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Wiring.MakeSensorsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--  센서 여러 개 만들기(WS L157, L446, L649-653) — 규칙을 한 번 정하고 미리보기를 본 뒤 만든다.  -->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<Style x:Key="M.Label" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		</Style>
		<Style x:Key="M.Box" TargetType="TextBox">
			<Setter Property="Height" Value="32" />
			<Setter Property="Margin" Value="0,4" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
	</UserControl.Resources>

	<!--  T4 · M 560. ESC · Enter · 첫 포커스는 틀이 정한다. 옛 AutomationId 유지.  -->
	<dlg:ConsoleDialogFrame
		Backdrop="{DynamicResource BgBrush}"
		BodyScroll="Disabled"
		DialogKey="Devices.Wiring.Make"
		IsPrimaryEnabled="{Binding CanMake}"
		Kind="규칙은 한 번만 정하면 전부에 들어갑니다 — 만든 줄은 저장 전까지 Draft"
		PrimaryAutomationId="Devices.Wiring.Make.Accept"
		PrimaryInvoked="OnAccept"
		PrimaryText="만들기"
		SecondaryAutomationId="Devices.Wiring.Make.Cancel"
		SecondaryInvoked="OnCancel"
		SecondaryText="취소"
		Size="Medium"
		Title="센서 여러 개 만들기">
	<DockPanel MinHeight="320" LastChildFill="True">

		<Border
			Margin="0,10,0,0"
			Padding="9,7"
			Background="{DynamicResource SurfaceSunkenBrush}"
			BorderBrush="{DynamicResource PrimaryBrush}"
			BorderThickness="3,0,0,0"
			CornerRadius="0,5,5,0"
			DockPanel.Dock="Bottom">
			<TextBlock
				AutomationProperties.AutomationId="Devices.Wiring.Make.Summary"
				FontSize="12.5"
				Text="{Binding Summary}"
				TextWrapping="Wrap" />
		</Border>

		<StackPanel Margin="0,12,0,0" DockPanel.Dock="Top">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="86" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock Style="{StaticResource M.Label}" Text="몇 개" />
				<TextBox
					Grid.Column="1"
					AutomationProperties.AutomationId="Devices.Wiring.Make.Count"
					Style="{StaticResource M.Box}"
					Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock Grid.Row="1" Style="{StaticResource M.Label}" Text="시작 번호" />
				<TextBox
					Grid.Row="1"
					Grid.Column="1"
					AutomationProperties.AutomationId="Devices.Wiring.Make.Start"
					Style="{StaticResource M.Box}"
					Text="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock Grid.Row="2" Style="{StaticResource M.Label}" Text="번호 간격" />
				<TextBox
					Grid.Row="2"
					Grid.Column="1"
					AutomationProperties.AutomationId="Devices.Wiring.Make.Step"
					Style="{StaticResource M.Box}"
					Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock Grid.Row="3" Style="{StaticResource M.Label}" Text="이름 규칙" />
				<TextBox
					Grid.Row="3"
					Grid.Column="1"
					AutomationProperties.AutomationId="Devices.Wiring.Make.NameRule"
					Style="{StaticResource M.Box}"
					Text="{Binding NameRule, UpdateSourceTrigger=PropertyChanged}"
					ToolTip="{}{번호} 자리에 그 줄의 번호가 들어갑니다" />

				<TextBlock Grid.Row="4" Style="{StaticResource M.Label}" Text="종류" />
				<ComboBox
					Grid.Row="4"
					Grid.Column="1"
					Margin="0,4"
					AutomationProperties.AutomationId="Devices.Wiring.Make.Type"
					IsEditable="True"
					ItemsSource="{Binding Types}"
					Text="{Binding TypeText, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock Grid.Row="5" Style="{StaticResource M.Label}" Text="구역" />
				<TextBox
					Grid.Row="5"
					Grid.Column="1"
					AutomationProperties.AutomationId="Devices.Wiring.Make.Zone"
					Style="{StaticResource M.Box}"
					Text="{Binding Zone, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>

			<CheckBox
				Margin="0,8,0,0"
				AutomationProperties.AutomationId="Devices.Wiring.Make.SkipConflicts"
				Content="이미 있는 번호는 건너뛰기"
				FontSize="12.5"
				IsChecked="{Binding SkipConflicts}"
				Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}" />

			<TextBlock
				Margin="0,10,0,4"
				FontSize="12"
				FontWeight="Bold"
				Foreground="{DynamicResource PrimaryBrush}"
				Text="미리보기" />
		</StackPanel>

		<Border
			MaxHeight="230"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<ListBox
				AutomationProperties.AutomationId="Devices.Wiring.Make.Preview"
				Background="Transparent"
				BorderThickness="0"
				ItemsSource="{Binding Preview}">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListBox.ItemContainerStyle>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<DockPanel Margin="2" LastChildFill="True">
							<!--  충돌은 색만이 아니라 ✕ 표지와 흐린·줄 그은 글자로도 말한다(W6)  -->
							<TextBlock
								Width="16"
								DockPanel.Dock="Left"
								FontSize="12"
								Foreground="{DynamicResource StatusCriticalBrush}"
								Text="✕"
								Visibility="{Binding IsConflict, Converter={StaticResource BoolToVisibility}}" />
							<TextBlock
								Width="64"
								DockPanel.Dock="Left"
								FontFamily="Consolas"
								FontSize="12"
								Text="{Binding Number}" />
							<TextBlock
								Margin="8,0,0,0"
								DockPanel.Dock="Right"
								FontSize="11.5"
								Foreground="{DynamicResource StatusCriticalBrush}"
								Text="{Binding Error}" />
							<TextBlock
								FontSize="12.5"
								Text="{Binding Name}"
								TextTrimming="CharacterEllipsis">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsConflict}" Value="True">
												<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
												<Setter Property="TextDecorations" Value="Strikethrough" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</DockPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>
	</DockPanel>
	</dlg:ConsoleDialogFrame>
</UserControl>
