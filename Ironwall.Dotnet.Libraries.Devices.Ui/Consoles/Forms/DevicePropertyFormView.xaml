<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Forms.DevicePropertyFormView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:forms="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Forms"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:pw="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils">
	<!--
		명세에서 만들어지는 상세 폼(device-console-redesign FR-08). DataContext = DevicePropertyFormViewModel.
		절 → ConsoleSection, 칸 → ConsoleField, 편집기는 칸의 EffectiveEditor 로 고른다.
		색이 아니라 형태로 구분한다: 잠금 = 자물쇠 + 까닭, 오류 = 아래 한 줄, 손댄 칸 = ConsoleField 의 표지.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

		<Style x:Key="Form.TextBox" TargetType="TextBox">
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>

		<!--  비어 있을 때만 보이는 안내("— 여러 값 —"). 이름 없이 스타일 트리거로만 켠다.  -->
		<Style x:Key="Form.Hint" TargetType="TextBlock">
			<Setter Property="Margin" Value="8,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Visibility" Value="Collapsed" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Text}" Value="">
					<Setter Property="Visibility" Value="Visible" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!--  글자 · 정수 · 실수 — 같은 상자, 검증은 뷰모델(명세의 범위 · 길이)이 한다  -->
		<DataTemplate x:Key="Editor.Text">
			<Grid>
				<TextBox
					AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Field.{0}}"
					Style="{StaticResource Form.TextBox}"
					Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Style="{StaticResource Form.Hint}" Text="{Binding Placeholder}" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="Editor.Number">
			<Grid>
				<TextBox
					AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Field.{0}}"
					FontFamily="Consolas"
					Style="{StaticResource Form.TextBox}"
					Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock Style="{StaticResource Form.Hint}" Text="{Binding Placeholder}" />
			</Grid>
		</DataTemplate>

		<DataTemplate x:Key="Editor.Boolean">
			<CheckBox
				VerticalAlignment="Center"
				AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Field.{0}}"
				Foreground="{DynamicResource TextPrimaryBrush}"
				IsChecked="{Binding BoolValue}"
				IsThreeState="{Binding IsMixed}" />
		</DataTemplate>

		<DataTemplate x:Key="Editor.Choice">
			<ComboBox
				Height="30"
				md:HintAssist.Hint="{Binding Placeholder}"
				AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Field.{0}}"
				DisplayMemberPath="Display"
				FontSize="13"
				Foreground="{DynamicResource TextPrimaryBrush}"
				ItemsSource="{Binding Options}"
				SelectedItem="{Binding SelectedOption}" />
		</DataTemplate>

		<DataTemplate x:Key="Editor.Password">
			<PasswordBox
				Height="30"
				Padding="6,0"
				VerticalContentAlignment="Center"
				pw:PasswordBoxAssistant.BindPassword="True"
				pw:PasswordBoxAssistant.BoundPassword="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Field.{0}}"
				Background="{DynamicResource SurfaceSunkenBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				Foreground="{DynamicResource TextPrimaryBrush}" />
		</DataTemplate>

		<!--  읽기 전용 · 잠금 — 값만. 자물쇠와 까닭은 ConsoleField 가 그린다(두 번 그리지 않는다)  -->
		<DataTemplate x:Key="Editor.ReadOnly">
			<TextBlock
				VerticalAlignment="Center"
				AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Field.{0}}"
				FontSize="13"
				Foreground="{DynamicResource TextSecondaryBrush}"
				Text="{Binding DisplayText}"
				TextWrapping="Wrap" />
		</DataTemplate>

		<forms:PropertyEditorTemplateSelector
			x:Key="EditorSelector"
			Boolean="{StaticResource Editor.Boolean}"
			Choice="{StaticResource Editor.Choice}"
			Number="{StaticResource Editor.Number}"
			Password="{StaticResource Editor.Password}"
			ReadOnly="{StaticResource Editor.ReadOnly}"
			Text="{StaticResource Editor.Text}" />
	</UserControl.Resources>

	<ItemsControl
		Focusable="False"
		ItemsSource="{Binding Sections}">
		<ItemsControl.ItemTemplate>
			<DataTemplate>
				<c:ConsoleSection AxisName="{Binding AxisName}" Header="{Binding Title}">
					<Grid>
						<!--  축을 서버가 보내지 않았다 — 값이 없는 것과 다르다  -->
						<c:NotReceivedBox SectionName="{Binding AxisName}" Visibility="{Binding IsNotReceived, Converter={StaticResource BoolToVisibility}}" />
						<ItemsControl Focusable="False" ItemsSource="{Binding Fields}">
							<ItemsControl.Style>
								<Style TargetType="ItemsControl">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsNotReceived}" Value="True">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ItemsControl.Style>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<!--
										까닭 한 줄은 값 열(~190px)이 아니라 상세 칸 전폭을 쓴다 — 값 열 안에 두면
										"…65535 이하여야 합니|다." 로 둘째 줄이 생기고 그 줄이 스크롤 영역 아래로
										잘려 마지막 글자가 사라진다(D-11 실측).
									-->
									<StackPanel>
										<c:ConsoleField
											ApiName="{Binding ApiPath}"
											Header="{Binding HeaderText}"
											IsLocked="{Binding IsLocked}"
											IsTouched="{Binding IsTouched}"
											Note="{Binding LockReason}">
											<ContentControl
												Content="{Binding}"
												ContentTemplateSelector="{StaticResource EditorSelector}"
												Focusable="False" />
										</c:ConsoleField>
										<TextBlock
											Margin="0,1,0,3"
											AutomationProperties.AutomationId="{Binding Key, StringFormat=Devices.Detail.Error.{0}}"
											FontSize="11.5"
											Foreground="{DynamicResource StatusCriticalBrush}"
											IsVisibleChanged="OnErrorVisibleChanged"
											Text="{Binding Error, StringFormat=⚠ {0}}"
											TextWrapping="Wrap"
											Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Grid>
				</c:ConsoleSection>
			</DataTemplate>
		</ItemsControl.ItemTemplate>
	</ItemsControl>
</UserControl>
