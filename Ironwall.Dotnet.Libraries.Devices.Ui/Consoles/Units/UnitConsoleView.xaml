<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Units.UnitConsoleView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:units="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Units"
	Background="{DynamicResource SurfaceBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		부대 콘솔(N-11). 정본 목업:
		docs/design/event-mapping-unit-console-storyboard.html 화면 G~K ·
		docs/design/event-mapping-unit-console-wireframe.html §2-2(컨트롤 트리) · §3(DnD 계약) · §7(AutomationId) ·
		docs/design/all-windows-drag-wireframe.html L411-413(호출 횟수 판정).
		치수: 헤더 40 · 레일 184 · 툴바 40 · 트리 노드 30 · 들여쓰기 16/단계 · 입력 32 · 상세 340 · 상태 띠 30.
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationProperties.AutomationId 만.
		색이 아니라 형태로 구분한다: 선택 = 좌측 3px 세로 바 / 드롭 = 파선 윤곽 · 사선 해치 / Draft = 앰버 파선.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<units:EchelonTextConverter x:Key="EchelonText" />
		<units:NotBoolToVisibilityConverter x:Key="NotBoolToVisibility" />

		<!--  제대 배지 — 글자 + 테두리(형태). 색만으로 뜻을 전하지 않는다.  -->
		<Style x:Key="Unit.EchelonBadge" TargetType="Border">
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="Height" Value="18" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style x:Key="Unit.Chip" TargetType="Border">
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="CornerRadius" Value="11" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style x:Key="Unit.SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
			<Setter Property="Margin" Value="0,14,0,5" />
		</Style>

		<Style x:Key="Unit.Label" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="Margin" Value="0,0,0,3" />
		</Style>

		<Style x:Key="Unit.TextBox" TargetType="TextBox">
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
	</UserControl.Resources>

	<c:ConsoleShell
		AutomationProperties.AutomationId="Units.Console.Panel"
		ConsoleKey="Units"
		IsDetailRequested="{Binding IsDetailRequested}"
		Subtitle="{Binding MyUnitCode}"
		Title="부대 편제">

		<!--  레일 — 보기 3종(스토리보드 화면 G L306-310). 인접 관계도는 이 노드 범위 밖이라 자리만 둔다.  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.Units.Rail"
				ConsoleKey="Units"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Footer>
					<TextBlock
						AutomationProperties.AutomationId="Console.Units.Rail.Footer"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding RailFooterText}"
						TextWrapping="Wrap" />
				</c:ConsoleRail.Footer>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<!--  툴바 — 제대 칩 · 검색 · [＋ 부대 등록] · [되돌리기]  -->
		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="{Binding AddBlockedReason}"
				AddText="부대 등록"
				CanAdd="{Binding CanAdd}"
				CanDelete="{Binding CanDeleteUnit}"
				CanRefresh="{Binding CanReload}"
				ConsoleKey="Units"
				DeleteClick="OnDelete"
				DeleteDisabledReason="{Binding DeleteBlockedReason}"
				RefreshClick="OnReload"
				SearchPlaceholder="이름 · 코드"
				SearchText="{Binding SearchText, Mode=TwoWay}">
				<c:ConsoleToolbar.Filters>
					<ItemsControl
						AutomationProperties.AutomationId="Units.Toolbar.EchelonChips"
						Focusable="False"
						ItemsSource="{Binding EchelonFilters}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Button
									Margin="0,0,5,0"
									Padding="0"
									AutomationProperties.AutomationId="{Binding Key, StringFormat=Units.Toolbar.Echelon.{0}}"
									Background="Transparent"
									BorderThickness="0"
									Click="OnEchelonChip"
									Cursor="Hand">
									<Button.Template>
										<ControlTemplate TargetType="Button">
											<Border
												Padding="9,2"
												Background="{DynamicResource SurfaceAltBrush}"
												BorderBrush="{DynamicResource BorderBrush}"
												BorderThickness="1"
												CornerRadius="11">
												<TextBlock
													FontSize="12"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding Label}" />
												<Border.Style>
													<Style TargetType="Border">
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsSelected}" Value="True">
																<!--  고른 칩은 굵은 테두리 + 채움(형태)  -->
																<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
																<Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
																<Setter Property="BorderThickness" Value="2" />
																<Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
											</Border>
										</ControlTemplate>
									</Button.Template>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</c:ConsoleToolbar.Filters>

				<c:ConsoleToolbar.Extra>
					<Button
						AutomationProperties.AutomationId="Units.Console.MoveUndo"
						Click="OnUndoMove"
						Content="이동 되돌리기"
						IsEnabled="{Binding CanUndoMove}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="마지막 이동 1회를 반대로 되돌립니다."
						Visibility="{Binding CanUndoMove, Converter={StaticResource BoolToVisibility}}" />
				</c:ConsoleToolbar.Extra>
			</c:ConsoleToolbar>
		</c:ConsoleShell.Toolbar>

		<!--  가운데 — 편제 트리 / 미배치 장비 / (인접 관계도 자리)  -->
		<c:ConsoleShell.List>
			<Grid ClipToBounds="True">

				<!--  ① 편제 트리  -->
				<DockPanel LastChildFill="True" Visibility="{Binding IsTreeView, Converter={StaticResource BoolToVisibility}}">
					<!--  "루트로" 드롭존 — 트리 최상단. 끌지 않을 때도 자리를 지켜 레이아웃이 튀지 않는다.  -->
					<drag:DropZoneChrome
						Margin="6,6,6,4"
						AutomationProperties.AutomationId="Units.Tree.RootDrop"
						drag:DropZone.Handler="{Binding Drop}"
						drag:DropZone.Key="unit-root"
						CornerRadius="5"
						DockPanel.Dock="Top">
						<Button
							Height="28"
							Padding="0"
							AutomationProperties.AutomationId="Units.Tree.RootDropButton"
							Background="Transparent"
							BorderThickness="0"
							Click="OnMoveToRoot"
							Cursor="Hand"
							IsEnabled="{Binding CanMoveSelected}"
							ToolTip="고른 부대를 최상위로 올립니다 — 부대를 여기에 끌어다 놓아도 됩니다.">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="Transparent">
										<TextBlock
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="11.5"
											Foreground="{DynamicResource TextMutedBrush}"
											Text="여기에 놓으면 최상위(루트)로 — 또는 부대를 고르고 누르십시오" />
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</drag:DropZoneChrome>

					<!--  빈 편제 안내 — 목록이 비었을 때만  -->
					<TextBlock
						Margin="16,10"
						AutomationProperties.AutomationId="Units.Tree.Empty"
						DockPanel.Dock="Top"
						FontSize="12"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="편제가 비어 있습니다 — 툴바의 [＋ 부대 등록] 으로 첫 부대를 만드십시오."
						TextWrapping="Wrap">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Rows.Count}" Value="0">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<!--
						트리는 평면 ListBox 다 — 커널 CaptureDragBehavior 가 ItemsControl 의 뿌리 생성기로 항목을 되찾으므로
						중첩 TreeViewItem 은 끌리지 않는다. 들여쓰기(16/단계)로 계층을 표현한다.
					-->
					<ListBox
						AutomationProperties.AutomationId="Units.Tree"
						ItemsSource="{Binding Rows}"
						PreviewKeyDown="OnTreeKeyDown"
						SelectionChanged="OnTreeSelectionChanged"
						SelectionMode="Single"
						Style="{StaticResource Console.ReorderList}">
						<b:Interaction.Behaviors>
							<drag:CaptureDragBehavior
								DisplayMemberPath="Name"
								Handler="{Binding Drop}"
								IsDragEnabled="{Binding CanEditUnits}"
								KeyboardFallback="Alt+↑ 상위로 · Alt+↓ 바로 위 형제 밑으로 · 상세 칸의 '상위 부대' 콤보 + [옮기기]" />
						</b:Interaction.Behaviors>
						<ListBox.ItemContainerStyle>
							<Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
								<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Units.Tree.Node.{0}}" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListBox.ItemContainerStyle>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<!--  행 하나가 곧 드롭존이다 — 상위 바꾸기(부대) · 배치(장비) 둘 다 여기로 온다.  -->
								<drag:DropZoneChrome
									Margin="{Binding Indent}"
									drag:DropZone.Data="{Binding}"
									drag:DropZone.Handler="{Binding DataContext.Drop, RelativeSource={RelativeSource AncestorType=UserControl}}"
									drag:DropZone.Key="unit-parent"
									CornerRadius="4">
									<Grid Height="30">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="16" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>

										<!--  펼침 — 자식이 있을 때만. 화면 표시만 바꾼다(서버 호출 없음).  -->
										<Button
											Grid.Column="0"
											Width="16"
											Height="16"
											Padding="0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Tree.Expander.{0}}"
											Background="Transparent"
											BorderThickness="0"
											Click="OnToggleExpand"
											Focusable="False"
											Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="Transparent">
														<md:PackIcon
															Width="14"
															Height="14"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Foreground="{DynamicResource TextSecondaryBrush}"
															Kind="ChevronDown">
															<md:PackIcon.Style>
																<Style TargetType="md:PackIcon">
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsExpanded}" Value="False">
																			<Setter Property="Kind" Value="ChevronRight" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</md:PackIcon.Style>
														</md:PackIcon>
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>

										<!--  집기 핸들 — Thumb 파생이라 UIA peer 가 실재한다. Button 계열은 캡처를 빼앗아 쓸 수 없다.  -->
										<drag:DragHandle
											Grid.Column="1"
											Width="14"
											Margin="2,0,4,0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Tree.Handle.{0}}"
											AutomationProperties.Name="부대 옮기기 손잡이"
											ToolTip="잡아 끌면 다른 부대 아래로 옮깁니다 · Esc 로 취소" />

										<Border
											Grid.Column="2"
											Margin="0,0,7,0"
											Style="{StaticResource Unit.EchelonBadge}">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="10.5"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{Binding EchelonText}" />
										</Border>

										<StackPanel
											Grid.Column="3"
											VerticalAlignment="Center"
											Orientation="Horizontal">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12.5"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Text="{Binding Name}"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding Tooltip}" />
											<!--  내 부대 — 형태(별표)로 표시한다(스토리보드 L407).  -->
											<md:PackIcon
												Width="13"
												Height="13"
												Margin="5,0,0,0"
												VerticalAlignment="Center"
												Foreground="{DynamicResource PrimaryBrush}"
												Kind="Star"
												ToolTip="이 앱이 붙어 있는 부대입니다"
												Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}" />
											<TextBlock
												Margin="6,0,0,0"
												VerticalAlignment="Center"
												FontSize="10.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding Code}" />
										</StackPanel>

										<StackPanel
											Grid.Column="4"
											VerticalAlignment="Center"
											Orientation="Horizontal">
											<Border
												Margin="0,0,4,0"
												Padding="6,0"
												Background="{DynamicResource TintWarningBrush}"
												CornerRadius="3"
												ToolTip="운용 중지된 부대입니다(is_enable=false)."
												Visibility="{Binding IsEnable, Converter={StaticResource NotBoolToVisibility}}">
												<TextBlock
													FontSize="10.5"
													Foreground="{DynamicResource StatusWarningBrush}"
													Text="중지" />
											</Border>
											<Border
												Padding="6,0"
												Style="{StaticResource Unit.EchelonBadge}"
												Visibility="{Binding HasDeviceCount, Converter={StaticResource BoolToVisibility}}">
												<TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
													<Run Text="장비" /><Run Text=" " /><Run Text="{Binding DeviceCount, Mode=OneWay}" />
												</TextBlock>
											</Border>
										</StackPanel>
									</Grid>
								</drag:DropZoneChrome>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>

				<!--  ② 미배치 장비 — 부대 노드로 끌어 배치한다(호출 N회 → Draft + [적용])  -->
				<DockPanel LastChildFill="True" Visibility="{Binding IsDeviceView, Converter={StaticResource BoolToVisibility}}">
					<Border
						Padding="10,7"
						Background="{DynamicResource TintInfoBrush}"
						BorderBrush="{DynamicResource StatusInfoBrush}"
						BorderThickness="4,0,0,0"
						DockPanel.Dock="Top">
						<TextBlock
							AutomationProperties.AutomationId="Units.Devices.Note"
							FontSize="11.5"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="서버에 '부대 없는 장비' 질의가 없어 전량을 읽어 여기서 가릅니다 — 소속이 비었거나 편제에 없는 부대를 가리키는 장비만 보입니다. 등록 때 부대를 생략하면 서버가 기본 부대로 자동 귀속시키므로 이 목록은 비어 있는 것이 정상입니다."
							TextWrapping="Wrap" />
					</Border>

					<!--  Draft 트레이 — 쌓인 배치와 [적용] · [되돌리기]  -->
					<Border
						Padding="10,6"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource AccentBrush}"
						BorderThickness="0,2,0,0"
						DockPanel.Dock="Bottom"
						Visibility="{Binding Tray.HasEntries, Converter={StaticResource BoolToVisibility}}">
						<DockPanel LastChildFill="True">
							<Button
								Margin="6,0,0,0"
								AutomationProperties.AutomationId="Units.Devices.Apply"
								Click="OnApplyAssigns"
								Content="적용"
								DockPanel.Dock="Right"
								IsEnabled="{Binding Tray.CanApply}"
								Style="{StaticResource MaterialDesignRaisedButton}" />
							<Button
								AutomationProperties.AutomationId="Units.Devices.Revert"
								Click="OnRevertAssigns"
								Content="되돌리기"
								DockPanel.Dock="Right"
								IsEnabled="{Binding Tray.CanRevert}"
								Style="{StaticResource MaterialDesignOutlinedButton}" />
							<StackPanel VerticalAlignment="Center">
								<TextBlock
									AutomationProperties.AutomationId="Units.Devices.TrayMessage"
									FontSize="12"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding Tray.Message}"
									TextTrimming="CharacterEllipsis" />
								<ProgressBar
									Height="4"
									Margin="0,4,0,0"
									AutomationProperties.AutomationId="Units.Devices.Progress"
									Maximum="{Binding Tray.ProgressTotal, Mode=OneWay}"
									Value="{Binding Tray.ProgressDone, Mode=OneWay}"
									Visibility="{Binding Tray.IsApplying, Converter={StaticResource BoolToVisibility}}" />
							</StackPanel>
						</DockPanel>
					</Border>

					<Grid>
						<TextBlock
							Margin="16,12"
							VerticalAlignment="Top"
							AutomationProperties.AutomationId="Units.Devices.Empty"
							FontSize="12"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="미배치 장비가 없습니다 — 모든 장비가 편제 안의 부대에 매여 있습니다."
							TextWrapping="Wrap">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding DeviceRows.Count}" Value="0">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>

						<ListBox
							AutomationProperties.AutomationId="Units.Devices.List"
							ItemsSource="{Binding DeviceRows}"
							SelectionChanged="OnDeviceSelectionChanged"
							SelectionMode="Extended"
							Style="{StaticResource Console.ReorderList}">
							<b:Interaction.Behaviors>
								<drag:CaptureDragBehavior
									DisplayMemberPath="Name"
									Handler="{Binding Drop}"
									IsDragEnabled="{Binding CanEditUnits}"
									KeyboardFallback="장비를 고르고 트리에서 부대를 고른 뒤 [이 부대에 배치]" />
							</b:Interaction.Behaviors>
							<ListBox.ItemContainerStyle>
								<Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
									<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Units.Devices.Item.{0}}" />
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<!--  Draft 행은 앰버 파선 {6,4} — 기존 {4,3}(그룹 선택)·{5,3}(드로잉)과 겹치지 않는다.  -->
									<Grid Height="38">
										<!--  미저장 Draft — 앰버 파선 {6,4}. {4,3}(그룹 선택)·{5,3}(드로잉)과 겹치지 않는 새 패턴이다.  -->
										<Rectangle
											RadiusX="4"
											RadiusY="4"
											Stroke="{DynamicResource AccentBrush}"
											StrokeDashArray="6,4"
											StrokeThickness="1"
											Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
										<Grid Margin="2,0,8,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<drag:DragHandle
												Grid.Column="0"
												Width="14"
												Margin="2,0,6,0"
												AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Devices.Handle.{0}}"
												AutomationProperties.Name="장비 배치 손잡이"
												ToolTip="잡아 끌어 편제 트리의 부대 위에 놓습니다 · Esc 로 취소" />
											<Border
												Grid.Column="1"
												Margin="0,0,7,0"
												Style="{StaticResource Unit.EchelonBadge}">
												<TextBlock
													VerticalAlignment="Center"
													FontSize="10.5"
													Foreground="{DynamicResource TextSecondaryBrush}"
													Text="{Binding CategoryText}" />
											</Border>
											<StackPanel
												Grid.Column="2"
												VerticalAlignment="Center"
												Orientation="Horizontal">
												<TextBlock
													FontSize="12.5"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding Name}"
													TextTrimming="CharacterEllipsis" />
												<TextBlock
													Margin="6,0,0,0"
													FontSize="10.5"
													Foreground="{DynamicResource TextMutedBrush}"
													Text="{Binding NumberText}" />
											</StackPanel>
											<TextBlock
												Grid.Column="3"
												VerticalAlignment="Center"
												FontSize="11"
												Foreground="{DynamicResource AccentBrush}"
												Text="{Binding PendingText}" />
										</Grid>
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>
				</DockPanel>

				<!--  ③ 인접 관계도 — 이 노드의 범위 밖(봉투: "관계도는 뒤"). 빈 화면 대신 사실을 적는다.  -->
				<Border
					Padding="18"
					VerticalAlignment="Top"
					Visibility="{Binding IsAdjacencyView, Converter={StaticResource BoolToVisibility}}">
					<StackPanel>
						<TextBlock
							AutomationProperties.AutomationId="Units.Adjacency.Placeholder"
							FontSize="13"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="인접 관계도는 다음 단계입니다" />
						<TextBlock
							Margin="0,6,0,0"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="인접 연결·해제는 지금도 됩니다 — 편제 트리에서 부대를 고르고 상세 칸의 '인접 부대' 에서 잇거나 끊으십시오. 그림으로 보는 관계도만 뒤로 미뤘습니다."
							TextWrapping="Wrap" />
					</StackPanel>
				</Border>
			</Grid>
		</c:ConsoleShell.List>

		<!--  상태 띠 — 건수 · 방금 한 일  -->
		<c:ConsoleShell.StatusBar>
			<Border
				Padding="12,5"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<DockPanel LastChildFill="True">
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Units.Console.Permission"
						DockPanel.Dock="Right"
						FontSize="12"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="읽기 전용 — units:edit 없음"
						Visibility="{Binding CanEditUnits, Converter={StaticResource NotBoolToVisibility}}" />
					<TextBlock
						Margin="12,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Units.Console.Status"
						DockPanel.Dock="Right"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding StatusText}"
						TextTrimming="CharacterEllipsis" />
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Units.Console.Count"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding ListStatusText}" />
				</DockPanel>
			</Border>
		</c:ConsoleShell.StatusBar>

		<!--  상세 340 — 코드(잠금) · 이름 · 제대 · 설명 · 운용 · 상위 부대 · 인접 · 삭제  -->
		<c:ConsoleShell.Detail>
			<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="{Binding Detail.ApplyText}"
				Banner="{Binding Detail.Banner}"
				CanApply="{Binding Detail.CanApply}"
				CanRevert="{Binding Detail.CanRevert}"
				ConsoleKey="Units"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding Detail.FooterText}"
				IsDirty="{Binding Detail.IsDirty}"
				IsReadOnly="{Binding Detail.IsReadOnly}"
				Kind="{Binding Detail.Kind}"
				RevertClick="OnRevert"
				RevertText="{Binding Detail.RevertText}"
				ShakeToken="{Binding Detail.ShakeToken}"
				ShowButtons="{Binding Detail.ShowButtons}"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding Detail.Title}">
				<Grid>
				<TextBlock
					Margin="16,16,14,0"
					VerticalAlignment="Top"
					AutomationProperties.AutomationId="Units.Detail.Empty"
					FontSize="12"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="왼쪽 편제에서 부대를 고르면 여기에 상세가 뜹니다. 새로 만들려면 툴바의 [부대 등록] 을 누르십시오."
					TextWrapping="Wrap"
					Visibility="{Binding IsDetailRequested, Converter={StaticResource NotBoolToVisibility}}" />
				<StackPanel
					Margin="16,12,14,16"
					DataContext="{Binding Form}"
					Visibility="{Binding DataContext.IsDetailRequested, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">

					<!--  삭제 차단(409) — 무엇이 매달려 있는지 개수로(스토리보드 화면 J)  -->
					<Border
						Margin="0,0,0,12"
						Padding="10,8"
						AutomationProperties.AutomationId="Units.Detail.DeleteBlocked"
						Background="{DynamicResource TintCriticalBrush}"
						BorderBrush="{DynamicResource StatusCriticalBrush}"
						BorderThickness="4,1,1,1"
						CornerRadius="4"
						Visibility="{Binding DataContext.IsDeleteBlocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
						<StackPanel>
							<TextBlock
								FontSize="12.5"
								FontWeight="Bold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="부대를 삭제할 수 없습니다" />
							<ItemsControl
								Margin="0,6,0,0"
								Focusable="False"
								ItemsSource="{Binding DataContext.DeleteBlock.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
											<Run Text="·" /><Run Text=" " /><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run FontWeight="Bold" Text="{Binding Count, Mode=OneWay}" />
										</TextBlock>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock
								Margin="0,6,0,0"
								FontSize="11.5"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="운용을 멈추려면 삭제 대신 운용 중지를 쓰십시오 — 이력과 소속은 보존됩니다."
								TextWrapping="Wrap" />
							<StackPanel
								Margin="0,8,0,0"
								HorizontalAlignment="Right"
								Orientation="Horizontal">
								<Button
									Margin="0,0,6,0"
									AutomationProperties.AutomationId="Units.Detail.DeleteBlockedClose"
									Click="OnDismissDeleteBlock"
									Content="닫기"
									Style="{StaticResource MaterialDesignFlatButton}" />
								<Button
									AutomationProperties.AutomationId="Units.Detail.DisableButton"
									Click="OnDisable"
									Content="운용 중지"
									Style="{StaticResource MaterialDesignOutlinedButton}" />
							</StackPanel>
						</StackPanel>
					</Border>

					<!--  폼 오류 한 줄 — 보내기 전에 막은 까닭  -->
					<Border
						Margin="0,0,0,12"
						Padding="8,6"
						AutomationProperties.AutomationId="Units.Detail.Error"
						Background="{DynamicResource TintCriticalBrush}"
						BorderBrush="{DynamicResource StatusCriticalBrush}"
						BorderThickness="3,0,0,0"
						Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
						<TextBlock
							FontSize="11.5"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding ErrorText}"
							TextWrapping="Wrap" />
					</Border>

					<!--  부대 코드 — 등록에서만 입력, 그 뒤로는 🔒  -->
					<TextBlock Style="{StaticResource Unit.Label}">
						<Run Text="부대 코드" /><Run Foreground="{DynamicResource StatusCriticalBrush}" Text=" · 변경 불가" />
					</TextBlock>
					<Grid>
						<TextBox
							AutomationProperties.AutomationId="Units.Detail.CodeField"
							Style="{StaticResource Unit.TextBox}"
							Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
							ToolTip="소문자·숫자·'_'·'-' 만. 이 값이 NATS subject 의 두 번째 토큰이 됩니다."
							Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}" />
						<Border
							Height="32"
							Padding="8,0"
							Background="{DynamicResource SurfaceSunkenBrush}"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="1"
							CornerRadius="3"
							Visibility="{Binding IsCodeLocked, Converter={StaticResource BoolToVisibility}}">
							<DockPanel LastChildFill="True">
								<md:PackIcon
									Width="14"
									Height="14"
									VerticalAlignment="Center"
									DockPanel.Dock="Right"
									Foreground="{DynamicResource TextMutedBrush}"
									Kind="Lock"
									ToolTip="부대 코드는 등록 뒤 바꿀 수 없습니다." />
								<TextBlock
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="Units.Detail.CodeText"
									FontFamily="{DynamicResource MonoFont}"
									FontSize="12.5"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding Code}" />
							</DockPanel>
						</Border>
					</Grid>
					<TextBlock
						Margin="0,4,0,0"
						FontSize="11"
						Foreground="{DynamicResource StatusWarningBrush}"
						Text="이 값은 나중에 바꿀 수 없습니다 — 바꾸면 그 부대 구독자가 메시지를 잃습니다."
						TextWrapping="Wrap"
						Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}" />

					<TextBlock
						Margin="0,12,0,3"
						Style="{StaticResource Unit.Label}"
						Text="부대 이름" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<!--  손댄 칸은 좌측 3px 앰버 줄로 — 색이 아니라 형태다.  -->
						<Rectangle
							Fill="{DynamicResource AccentBrush}"
							Visibility="{Binding IsNameTouched, Converter={StaticResource BoolToVisibility}}" />
						<TextBox
							Grid.Column="1"
							Margin="4,0,0,0"
							AutomationProperties.AutomationId="Units.Detail.NameBox"
							IsReadOnly="{Binding DataContext.Detail.IsFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource Unit.TextBox}"
							Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
					</Grid>

					<TextBlock
						Margin="0,10,0,3"
						Style="{StaticResource Unit.Label}"
						Text="제대" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Rectangle
							Fill="{DynamicResource AccentBrush}"
							Visibility="{Binding IsEchelonTouched, Converter={StaticResource BoolToVisibility}}" />
						<ComboBox
							Grid.Column="1"
							Height="32"
							Margin="4,0,0,0"
							AutomationProperties.AutomationId="Units.Detail.EchelonCombo"
							IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
							ItemsSource="{Binding Echelons}"
							SelectedItem="{Binding Echelon, Mode=TwoWay}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource EchelonText}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>
					<TextBlock
						Margin="0,4,0,0"
						AutomationProperties.AutomationId="Units.Detail.ChildEchelonWarning"
						FontSize="11"
						Foreground="{DynamicResource StatusWarningBrush}"
						Text="{Binding ChildEchelonWarning}"
						TextWrapping="Wrap"
						Visibility="{Binding HasChildEchelonWarning, Converter={StaticResource BoolToVisibility}}" />

					<TextBlock
						Margin="0,10,0,3"
						Style="{StaticResource Unit.Label}"
						Text="설명" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Rectangle
							Fill="{DynamicResource AccentBrush}"
							Visibility="{Binding IsDescriptionTouched, Converter={StaticResource BoolToVisibility}}" />
						<TextBox
							Grid.Column="1"
							MinHeight="56"
							Margin="4,0,0,0"
							AcceptsReturn="True"
							AutomationProperties.AutomationId="Units.Detail.DescriptionBox"
							IsReadOnly="{Binding DataContext.Detail.IsFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource Unit.TextBox}"
							Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="Wrap"
							VerticalContentAlignment="Top" />
					</Grid>
					<TextBlock
						HorizontalAlignment="Right"
						FontSize="10.5"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="{Binding DescriptionCounter}" />

					<DockPanel Margin="0,10,0,0" LastChildFill="False">
						<Rectangle
							Width="3"
							Height="16"
							Margin="0,0,5,0"
							DockPanel.Dock="Left"
							Fill="{DynamicResource AccentBrush}"
							Visibility="{Binding IsEnableTouched, Converter={StaticResource BoolToVisibility}}" />
						<TextBlock
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Style="{StaticResource Unit.Label}"
							Text="운용" />
						<ToggleButton
							AutomationProperties.AutomationId="Units.Detail.EnableSwitch"
							DockPanel.Dock="Right"
							IsChecked="{Binding IsEnable, Mode=TwoWay}"
							IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource MaterialDesignSwitchToggleButton}"
							ToolTip="퇴역은 삭제가 아니라 운용 중지(is_enable=false)입니다." />
					</DockPanel>

					<!--  상위 부대 — 드래그의 버튼 폴백. 수정 화면에서는 [옮기기] 가 곧바로 보낸다(적용 막대에 얹지 않는다).  -->
					<TextBlock Style="{StaticResource Unit.SectionTitle}" Text="상위 부대" />
					<ComboBox
						Height="32"
						AutomationProperties.AutomationId="Units.Detail.ParentCombo"
						DisplayMemberPath="Label"
						IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
						ItemsSource="{Binding ParentOptions}"
						SelectedValue="{Binding ParentId, Mode=TwoWay}"
						SelectedValuePath="Id" />
					<StackPanel
						Margin="0,6,0,0"
						HorizontalAlignment="Right"
						Orientation="Horizontal"
						Visibility="{Binding IsCreating, Converter={StaticResource NotBoolToVisibility}}">
						<Button
							Margin="0,0,6,0"
							AutomationProperties.AutomationId="Units.Detail.MoveToRootButton"
							Click="OnMoveToRoot"
							Content="최상위로"
							IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource MaterialDesignFlatButton}" />
						<Button
							AutomationProperties.AutomationId="Units.Detail.MoveButton"
							Click="OnMoveToSelectedParent"
							Content="옮기기"
							IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource MaterialDesignOutlinedButton}"
							ToolTip="고른 상위 부대로 옮깁니다 — 호출 1회, 되돌리기 있음." />
					</StackPanel>

					<!--  인접 부대 — 같은 제대만. 무방향이라 양쪽에 생긴다.  -->
					<TextBlock Style="{StaticResource Unit.SectionTitle}">
						<Run Text="인접 부대" /><Run FontWeight="Normal" Foreground="{DynamicResource TextMutedBrush}" Text=" — 같은 제대만" />
					</TextBlock>
					<ItemsControl
						AutomationProperties.AutomationId="Units.Detail.AdjacencyChips"
						Focusable="False"
						ItemsSource="{Binding AdjacencyChips}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									Margin="0,0,5,5"
									Style="{StaticResource Unit.Chip}">
									<StackPanel Orientation="Horizontal">
										<TextBlock
											VerticalAlignment="Center"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Detail.AdjacencyChip.{0}}"
											FontSize="11.5"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding Name}" />
										<Button
											Width="16"
											Height="16"
											Margin="6,0,0,0"
											Padding="0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Detail.AdjacencyRemove.{0}}"
											Click="OnRemoveAdjacency"
											Style="{StaticResource MaterialDesignFlatButton}"
											ToolTip="인접을 끊습니다 — 양쪽에서 함께 사라집니다.">
											<md:PackIcon
												Width="11"
												Height="11"
												Kind="Close" />
										</Button>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!--  인접 드롭존 — 트리에서 같은 제대 부대를 끌어다 놓으면 이어진다.  -->
					<drag:DropZoneChrome
						MinHeight="34"
						Margin="0,2,0,0"
						AutomationProperties.AutomationId="Units.Detail.AdjacencyDrop"
						drag:DropZone.Handler="{Binding DataContext.Drop, RelativeSource={RelativeSource AncestorType=UserControl}}"
						drag:DropZone.Key="unit-adjacency"
						CornerRadius="5">
						<TextBlock
							Margin="8,7"
							FontSize="11.5"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="여기에 부대를 끌어다 놓아 인접 연결"
							TextWrapping="Wrap" />
					</drag:DropZoneChrome>

					<DockPanel Margin="0,6,0,0" LastChildFill="True">
						<Button
							Margin="6,0,0,0"
							AutomationProperties.AutomationId="Units.Detail.AdjacencyAddButton"
							Click="OnAddAdjacency"
							Content="인접 추가"
							DockPanel.Dock="Right"
							IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<ComboBox
							Height="32"
							AutomationProperties.AutomationId="Units.Detail.AdjacencyCombo"
							DisplayMemberPath="Label"
							IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
							ItemsSource="{Binding AdjacencyCandidates}" />
					</DockPanel>
					<TextBlock
						Margin="0,4,0,0"
						FontSize="11"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="인접은 양방향으로 연결됩니다 — 상대 부대 상세에도 나타납니다. 보내기 직전에 서버 목록을 다시 읽어 다른 세션의 변경을 덮지 않습니다."
						TextWrapping="Wrap" />

					<TextBlock
						Margin="0,14,0,0"
						AutomationProperties.AutomationId="Units.Detail.Counts"
						FontSize="11.5"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding CountsText}" />

					<!--  파괴적 동작은 맨 아래, 서로 떨어뜨려 둔다.  -->
					<StackPanel
						Margin="0,18,0,0"
						HorizontalAlignment="Left"
						Orientation="Horizontal"
						Visibility="{Binding IsCreating, Converter={StaticResource NotBoolToVisibility}}">
						<Button
							Margin="0,0,10,0"
							AutomationProperties.AutomationId="Units.Detail.DeleteButton"
							Click="OnDelete"
							Content="삭제"
							Foreground="{DynamicResource StatusCriticalBrush}"
							IsEnabled="{Binding DataContext.CanDeleteUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource MaterialDesignOutlinedButton}" />
						<Button
							AutomationProperties.AutomationId="Units.Detail.DisableButton2"
							Click="OnDisable"
							Content="운용 중지"
							IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
							Style="{StaticResource MaterialDesignFlatButton}" />
					</StackPanel>
				</StackPanel>
				</Grid>
			</c:ConsoleDetailHost>
		</c:ConsoleShell.Detail>
	</c:ConsoleShell>
</UserControl>
