<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Units.UnitConsoleView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:consoles="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles"
	xmlns:dash="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Views.Dashboards"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:map="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Units.Map"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:units="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Units"
	Background="{DynamicResource SurfaceBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		부대 콘솔(N-11). 정본 목업:
		docs/design/event-mapping-unit-console-storyboard.html 화면 G~K ·
		docs/design/event-mapping-unit-console-wireframe.html §2-2 · §3 · §4-3 · §7 ·
		docs/design/all-windows-drag-wireframe.html L411-413(호출 횟수 판정).

		「미배치 장비」 칸은 없다 — 서버 회신 2026-09-28 Q-1 ⓐ(개념 폐지): 무소속 장비는 서버 설계상 존재할 수 없다
		  (unit_id 없이 만들면 기본 부대 unit001, PATCH/PUT 의 명시적 null 은 422). unit-relationship-map PRD v1.7.

		치수: 헤더 40 · 레일 184 · 툴바 40 · 트리 노드 30 · 들여쓰기 16/단계 · 입력 32 · 상세 340 · 상태 띠 30.
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationProperties.AutomationId 만.
		식별자 모양은 둘뿐이다: 커널이 만드는 Console.Units.* · 이 창이 만드는 Units.<구역>.*
		(루트만 목업이 정한 Units.Console.Panel 이다 — 와이어프레임 L427).
		색이 아니라 형태로 구분한다: 선택 = 좌측 3px 세로 바 / 드롭 = 파선 윤곽 · 사선 해치 / Draft = 앰버 파선 {6,4}.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<units:EchelonTextConverter x:Key="EchelonText" />
		<units:NotBoolToVisibilityConverter x:Key="NotBoolToVisibility" />
		<dash:PackIconKindConverter x:Key="IconKind" />

		<!--  제대 배지 — 글자 + 테두리(형태). 색만으로 뜻을 전하지 않는다.  -->
		<Style x:Key="Unit.EchelonBadge" TargetType="Border">
			<Setter Property="Padding" Value="6,0" />
			<Setter Property="Height" Value="18" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<!--
			U-14 — 옛 제대 칩(Unit.Chip.Plate)은 고르면 BorderThickness 1→2 로 칩 자체가 2px 커졌다(선택하면
			크기가 바뀌는 결함). 커널 Console.Tab(굵은 폭을 미리 재 두는 고스트 · 두께 고정 밑줄)으로 옮기고 삭제했다.
		-->
		<Style x:Key="Unit.Chip" TargetType="Border">
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="CornerRadius" Value="11" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>

		<Style x:Key="Unit.TextBox" TargetType="TextBox">
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>

		<Style x:Key="Unit.Combo" TargetType="ComboBox">
			<Setter Property="Height" Value="32" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="FontSize" Value="12.5" />
		</Style>

		<!--  UIA 에 실제로 나오는 글자 — TextBlock 은 peer 가 없어 계측점이 되지 못한다.  -->
		<Style x:Key="Unit.Readout" TargetType="Label">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
		</Style>

		<!--
			트리 행 — 커널 Console.ReorderList 의 선택 어휘(좌측 3px 세로 바)를 옮겨 왔다.
			컨테이너에 AutomationId 를 달아야 자동화가 "그 부대 행" 을 짚을 수 있는데,
			ItemContainerStyle 을 통째로 주면 커널 스타일의 컨테이너 템플릿이 사라져 선택 표시가 없어진다.
		-->
		<Style x:Key="Unit.TreeRow" TargetType="ListBoxItem">
			<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Units.Tree.Node.{0}}" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Grid>
							<Border
								x:Name="Bd"
								Background="Transparent"
								BorderBrush="{DynamicResource DividerBrush}"
								BorderThickness="0,0,0,1" />
							<Rectangle
								x:Name="Bar"
								Width="3"
								HorizontalAlignment="Left"
								Fill="{DynamicResource PrimaryBrush}"
								Visibility="Collapsed" />
							<Border
								x:Name="Focus"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								Visibility="Collapsed" />
							<ContentPresenter Margin="6,0" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
								<Setter TargetName="Bar" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Focus" Property="Visibility" Value="Visible" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<!--
		V-38 · V-39 — 부제는 다른 콘솔처럼 지금 레일 이름이다(종전엔 내 부대 코드 "unit001").
		Loaded 에서 창 제목 줄을 테마 색에 맞추고, 도킹 폭(1280)이 창 테두리에 먹혀 상세 칸이 서랍으로 숨지 않게 창 폭을 보정한다(코드 비하인드).
	-->
	<c:ConsoleShell
		AutomationProperties.AutomationId="Units.Console.Panel"
		ConsoleKey="Units"
		IsDetailRequested="{Binding IsDetailRequested}"
		Loaded="OnShellLoaded"
		Subtitle="{Binding RailSubtitle}"
		Title="부대 편제">

		<!--  레일 — 편제 트리 · 부대 관계도(unit-relationship-map FR-01). 관계도 칸에는 숫자 배지를 달지 않는다.  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.Units.Rail"
				ConsoleKey="Units"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Resources>
					<!--  레일 항목의 Icon 은 아이콘 이름을 쥔 토큰이다 — 뷰모델이 시각 요소를 쥐지 않게 여기서 그린다  -->
					<DataTemplate DataType="{x:Type consoles:ConsoleIconToken}">
						<md:PackIcon
							Width="18"
							Height="18"
							Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
					</DataTemplate>
				</c:ConsoleRail.Resources>
				<c:ConsoleRail.Footer>
					<!--  V-39 — 내 부대를 이름으로 못 찾으면 정렬 안내(한 줄보다 길다)를 낸다 — 184 폭에서 잘리지 않게 줄을 바꾼다.  -->
					<Label
						AutomationProperties.AutomationId="Console.Units.Rail.Footer"
						Content="{Binding RailFooterText}"
						Style="{StaticResource Unit.Readout}">
						<Label.ContentTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" TextWrapping="Wrap" />
							</DataTemplate>
						</Label.ContentTemplate>
					</Label>
				</c:ConsoleRail.Footer>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<!--
			툴바 — 검색 · [＋ 부대 등록] · [갱신] · [삭제] · [이동 되돌리기].
			제대 필터는 정본(화면 G)이 툴바에 두지만 여기서는 목록 바로 위 한 줄로 내렸다(선언된 편차 — 장비 · 이벤트
			콘솔의 필터 줄과 같은 자리). 커널 툴바는 높이 고정 · 줄바꿈 없는 한 줄이라, 서랍이 열린 900 폭에서는
			칩 여섯 개가 오른쪽 끝에서 글자 중간이 잘렸다(units-light-14-compact-900 실측).
		-->
		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="{Binding AddBlockedReason}"
				AddText="부대 등록"
				CanAdd="{Binding CanAdd}"
				CanDelete="{Binding CanDeleteUnit}"
				CanRefresh="{Binding CanReload}"
				ConsoleKey="Units"
				DeleteClick="OnDelete"
				IsEnabled="{Binding IsConsoleInteractive}"
				DeleteDisabledReason="{Binding DeleteBlockedReason}"
				RefreshClick="OnReload"
				SearchPlaceholder="이름 · 코드"
				SearchText="{Binding SearchText, Mode=TwoWay}">
				<c:ConsoleToolbar.Extra>
					<Button
						AutomationProperties.AutomationId="Units.Toolbar.MoveUndo"
						Click="OnUndoMove"
						Content="이동 되돌리기"
						IsEnabled="{Binding CanUndoMove}"
						Style="{StaticResource Console.Button}"
						ToolTip="마지막 이동 1회를 반대로 되돌립니다."
						Visibility="{Binding CanUndoMove, Converter={StaticResource BoolToVisibility}}" />
				</c:ConsoleToolbar.Extra>
			</c:ConsoleToolbar>
		</c:ConsoleShell.Toolbar>

		<!--  가운데 — 편제 트리(항상) + 부대 관계도(트리 위 덮개)  -->
		<c:ConsoleShell.List>
			<Grid ClipToBounds="True">
				<!--  ① 편제 트리 — 언제나 깔려 있다(관계도 칸은 그 위를 덮는다)  -->
				<DockPanel
					IsEnabled="{Binding IsConsoleInteractive}"
					LastChildFill="True">
					<!--
						제대 필터 줄 — 커널 Console.Tab(고를 때 폭이 변하지 않는다). WrapPanel 이라 목록이 더 좁아지면
						잘리지 않고 다음 줄로 내려간다. 식별자는 옛 자리(Units.Toolbar.*) 그대로 둔다 — 자동화 계약.
					-->
					<Border
						Padding="12,6"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,0,0,1"
						DockPanel.Dock="Top">
						<!--
							U-18 D-8 8.10 — 좁은 폭(트리가 ≈430)에서 칩이 두 줄로 접혀 트리를 밀어냈다.
							한 줄로 두고, 넘치면 가로로 밀어 본다(스크롤 막대는 넘칠 때만).
						-->
						<ScrollViewer
							Focusable="False"
							HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Disabled">
						<ItemsControl
							AutomationProperties.AutomationId="Units.Toolbar.EchelonChips"
							Focusable="False"
							ItemsSource="{Binding EchelonFilters}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										AutomationProperties.AutomationId="{Binding Key, StringFormat=Units.Toolbar.Echelon.{0}}"
										Click="OnEchelonChip"
										Content="{Binding Label}"
										GroupName="UnitsEchelon"
										IsChecked="{Binding IsSelected, Mode=OneWay}"
										Style="{StaticResource Console.Tab}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						</ScrollViewer>
					</Border>

					<!--  "루트로" 드롭존 — 트리 최상단. 끌지 않을 때도 자리를 지켜 레이아웃이 튀지 않는다.  -->
					<drag:DropZoneChrome
						Margin="6,6,6,4"
						drag:DropZone.Handler="{Binding Drop}"
						drag:DropZone.Key="unit-root"
						CornerRadius="5"
						DockPanel.Dock="Top">
						<!--  계측점은 Button 이다 — DropZoneChrome 은 ContentControl 이라 UIA 트리에 나오지 않는다.  -->
						<Button
							Height="28"
							Padding="0"
							AutomationProperties.AutomationId="Units.Tree.RootDrop"
							Background="Transparent"
							BorderThickness="0"
							Click="OnMoveToRoot"
							Cursor="Hand"
							IsEnabled="{Binding CanMoveSelected}"
							Style="{x:Null}"
							ToolTip="고른 부대를 최상위로 올립니다. 부대를 여기에 끌어다 놓아도 됩니다.">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="Transparent">
										<TextBlock
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="11.5"
											Foreground="{DynamicResource TextMutedBrush}"
											Text="부대를 여기에 끌어 놓거나, 고른 뒤 이 줄을 누르면 최상위로 옮깁니다" />
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</drag:DropZoneChrome>

					<Label
						Margin="16,10,16,0"
						AutomationProperties.AutomationId="Units.Tree.Empty"
						Content="편제가 비어 있습니다. 툴바의 [부대 등록]으로 첫 부대를 만드세요."
						DockPanel.Dock="Top"
						Foreground="{DynamicResource TextMutedBrush}"
						Style="{StaticResource Unit.Readout}"
						Visibility="{Binding IsTreeEmpty, Converter={StaticResource BoolToVisibility}}" />

					<!--
						트리는 평면 ListBox 다 — 커널 CaptureDragBehavior 가 ItemsControl 의 뿌리 생성기로 항목을 되찾으므로
						중첩 TreeViewItem 은 끌리지 않고, TreeView 는 Selector 가 아니라 데드존 미만의 클릭 폴백도 죽는다.
					-->
					<ListBox
						AutomationProperties.AutomationId="Units.Tree"
						ItemContainerStyle="{StaticResource Unit.TreeRow}"
						ItemsSource="{Binding Rows}"
						PreviewKeyDown="OnTreeKeyDown"
						SelectedItem="{Binding SelectedRow, Mode=OneWay}"
						SelectionChanged="OnTreeSelectionChanged"
						SelectionMode="Single"
						Style="{StaticResource Console.ReorderList}">
						<b:Interaction.Behaviors>
							<drag:CaptureDragBehavior
								DisplayMemberPath="Name"
								Handler="{Binding Drop}"
								IsDragEnabled="{Binding CanEditUnits}"
								KeyboardFallback="Alt+↑ 한 단계 위로 · Alt+↓ 바로 위 부대 아래로 · 상세 칸의 '상위 부대'에서 고르고 [옮기기]" />
						</b:Interaction.Behaviors>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<!--  행 하나가 곧 드롭존이다 — 상위 바꾸기(부대)가 여기로 온다.  -->
								<drag:DropZoneChrome
									Margin="{Binding Indent}"
									drag:DropZone.Data="{Binding}"
									drag:DropZone.Handler="{Binding DataContext.Drop, RelativeSource={RelativeSource AncestorType=UserControl}}"
									drag:DropZone.Key="unit-parent"
									CornerRadius="4">
									<Grid Height="30">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="16" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>

										<Button
											Grid.Column="0"
											Width="16"
											Height="16"
											Padding="0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Tree.Expander.{0}}"
											Background="Transparent"
											BorderThickness="0"
											Click="OnToggleExpand"
											Focusable="False"
											Style="{x:Null}"
											Visibility="{Binding ShowExpander, Converter={StaticResource BoolToVisibility}}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="Transparent">
														<md:PackIcon
															Width="14"
															Height="14"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															Foreground="{DynamicResource TextSecondaryBrush}"
															Kind="ChevronDown">
															<md:PackIcon.Style>
																<Style TargetType="md:PackIcon">
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding IsExpanded}" Value="False">
																			<Setter Property="Kind" Value="ChevronRight" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</md:PackIcon.Style>
														</md:PackIcon>
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>

										<!--  집기 핸들 — Thumb 파생이라 UIA peer 가 실재한다. Button 계열은 캡처를 빼앗아 쓸 수 없다.  -->
										<drag:DragHandle
											Grid.Column="1"
											Width="14"
											Margin="2,0,4,0"
											AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Tree.Handle.{0}}"
											AutomationProperties.Name="부대 옮기기 손잡이"
											ToolTip="끌어서 다른 부대 아래로 옮기세요 · Esc 로 취소" />

										<Border
											Grid.Column="2"
											Margin="0,0,7,0"
											Style="{StaticResource Unit.EchelonBadge}">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="10.5"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{Binding EchelonText}" />
										</Border>

										<StackPanel
											Grid.Column="3"
											VerticalAlignment="Center"
											Orientation="Horizontal">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12.5"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Text="{Binding Name}"
												TextTrimming="CharacterEllipsis"
												ToolTip="{Binding Tooltip}" />
											<md:PackIcon
												Width="13"
												Height="13"
												Margin="5,0,0,0"
												VerticalAlignment="Center"
												Foreground="{DynamicResource PrimaryBrush}"
												Kind="Star"
												ToolTip="이 앱이 붙어 있는 부대입니다"
												Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibility}}" />
											<TextBlock
												Margin="6,0,0,0"
												VerticalAlignment="Center"
												FontSize="10.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding Code}" />
										</StackPanel>

										<StackPanel
											Grid.Column="4"
											VerticalAlignment="Center"
											Orientation="Horizontal">
											<!--  운용 중지 — 글자는 본문색, 상태색은 점이 진다(색만으로 뜻을 전하지 않는다).  -->
											<Border
												Margin="0,0,4,0"
												Style="{StaticResource Console.Pill}"
												ToolTip="운용 중지된 부대입니다."
												Visibility="{Binding IsEnable, Converter={StaticResource NotBoolToVisibility}}">
												<StackPanel Orientation="Horizontal">
													<Ellipse
														Width="6"
														Height="6"
														Margin="0,0,5,0"
														VerticalAlignment="Center"
														Fill="{DynamicResource StatusWarningBrush}" />
													<TextBlock
														FontSize="10.5"
														Foreground="{DynamicResource TextPrimaryBrush}"
														Text="중지" />
												</StackPanel>
											</Border>
											<Border
												Padding="6,0"
												Style="{StaticResource Unit.EchelonBadge}"
												Visibility="{Binding HasDeviceCount, Converter={StaticResource BoolToVisibility}}">
												<TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
													<Run Text="장비" /><Run Text=" " /><Run Text="{Binding DeviceCount, Mode=OneWay}" />
												</TextBlock>
											</Border>
										</StackPanel>
									</Grid>
								</drag:DropZoneChrome>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</DockPanel>

				<!--
					② 부대 관계도(unit-relationship-map FR-01) — 트리와 같은 칸을 덮는다.
					위 = 둘째 툴바 줄(레이어 3 · 예하 포함 · 지도에서 보기 · 배치 초기화), 가운데 = 캔버스(줌 · 맞춤 HUD · 배치 상태 줄 ·
					확인 오버레이 · 되돌리기 막대 · M 모드 표시는 캔버스가 그린다), 아래 = 관계도 상태 문구(UIA 로 읽힌다).
					캔버스는 확인 대기 중에도 살아 있어야 한다([확정] · [취소]) — 콘솔 잠금(IsConsoleInteractive)은 트리 · 상세 · 툴바에만 건다.
					권한이 없거나 쓸 수 없으면 단추를 숨기지 않고 끄고 까닭을 툴팁으로 말한다.
				-->
				<DockPanel
					Background="{DynamicResource SurfaceBrush}"
					LastChildFill="True"
					Visibility="{Binding IsAdjacencyView, Converter={StaticResource BoolToVisibility}}">
					<Border
						Padding="12,6"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,0,0,1"
						DockPanel.Dock="Top">
						<ScrollViewer
							Focusable="False"
							HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Disabled">
							<StackPanel Orientation="Horizontal">
								<!--
									켜고 끄는 개별 설정은 커널 체크박스(Console.CheckBox — 서버 콘솔의 [예하 포함]과 같은 관용구).
									Console.Chip 은 "하나를 고르는" 필터 칩이라 선택 링(2px 오버레이 + 1px 테두리)이 두꺼워,
									넷 중 셋이 기본으로 켜진 이 줄이 두꺼운 이중 윤곽으로 보였다(실앱 다크 · 2026-09-28).
								-->
								<CheckBox
									Margin="0,0,14,0"
									AutomationProperties.AutomationId="Units.Map.Layer.Hierarchy"
									Content="계층선"
									IsChecked="{Binding Map.ShowHierarchyLayer, Mode=TwoWay}"
									FontSize="12"
									Style="{StaticResource Console.CheckBox}"
									ToolTip="상위 · 하위를 잇는 선을 보이거나 감춥니다(내 화면에만 적용)." />
								<CheckBox
									Margin="0,0,14,0"
									AutomationProperties.AutomationId="Units.Map.Layer.Adjacency"
									Content="인접선"
									IsChecked="{Binding Map.ShowAdjacencyLayer, Mode=TwoWay}"
									FontSize="12"
									Style="{StaticResource Console.CheckBox}"
									ToolTip="인접 부대를 잇는 선을 보이거나 감춥니다(내 화면에만 적용)." />
								<CheckBox
									Margin="0,0,14,0"
									AutomationProperties.AutomationId="Units.Map.Layer.Devices"
									Content="장비 배지"
									IsChecked="{Binding Map.ShowDeviceBadgesLayer, Mode=TwoWay}"
									FontSize="12"
									Style="{StaticResource Console.CheckBox}"
									ToolTip="부대마다 소속 장비 수 · 장애 수 배지를 보이거나 감춥니다(내 화면에만 적용)." />
								<Border
									Width="1"
									Margin="6,4,12,4"
									Background="{DynamicResource DividerBrush}" />
								<CheckBox
									Margin="0,0,14,0"
									AutomationProperties.AutomationId="Units.Map.IncludeSubordinates"
									Content="예하 포함"
									IsChecked="{Binding Map.LocateIncludeDescendants, Mode=TwoWay}"
									FontSize="12"
									Style="{StaticResource Console.CheckBox}"
									ToolTip="[지도에서 보기]가 고른 부대의 예하 부대 장비까지 함께 보입니다." />
								<Button
									Margin="0,0,8,0"
									AutomationProperties.AutomationId="Units.Map.LocateOnMap"
									Click="OnLocateOnMap"
									Content="지도에서 보기"
									IsEnabled="{Binding Map.CanLocateOnMap}"
									Style="{StaticResource Console.Button}"
									ToolTip="{Binding Map.LocateDisabledReason}"
									ToolTipService.ShowOnDisabled="True" />
								<Button
									AutomationProperties.AutomationId="Units.Map.ResetLayout"
									Click="OnResetLayout"
									Content="배치 초기화"
									IsEnabled="{Binding Map.CanResetLayout}"
									Style="{StaticResource Console.Button.Ghost}"
									ToolTip="{Binding Map.ResetLayoutDisabledReason}"
									ToolTipService.ShowOnDisabled="True" />
							</StackPanel>
						</ScrollViewer>
					</Border>
					<Border
						MinHeight="26"
						Padding="12,4"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource DividerBrush}"
						BorderThickness="0,1,0,0"
						DockPanel.Dock="Bottom">
						<c:ConsoleText
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Units.Map.Status"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding Map.StatusText}"
							TextTrimming="CharacterEllipsis"
							ToolTip="{Binding Map.StatusText}" />
					</Border>
					<map:UnitMapCanvas
						Bar="{Binding Map.Bar}"
						CanRetryLayout="{Binding Map.CanRetryLayout}"
						ConfirmPrompt="{Binding Map.ConfirmPrompt}"
						Interaction="{Binding Map}"
						LayoutStatusText="{Binding Map.LayoutStatusText}"
						MoveModeText="{Binding Map.MoveModeText}"
						Scene="{Binding Map.Scene}"
						SelectedUnitId="{Binding Map.SelectedUnitId, Mode=OneWay}" />
				</DockPanel>

			</Grid>
		</c:ConsoleShell.List>

		<!--  상태 띠 — 건수 · 방금 한 일 · 권한  -->
		<c:ConsoleShell.StatusBar>
			<Border
				Padding="12,5"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<!--
					U-14 — 옛 DockPanel 은 메시지(오른쪽 도킹 · MaxWidth 320)가 먼저 자리를 잡고 건수가 '남는 자리'
					였다. 서랍이 열린 900 폭에서 남는 자리가 76px 뿐이라 "부대 9 · 인접 쌍…" 이 잘렸고, 두 줄로 접힌
					메시지와 맞붙었다(units-light-14-compact-900 실측). 이제 건수는 Auto(짧아서 절대 잘리지 않는다),
					메시지가 '남는 자리'(*)를 받아 줄바꿈 → 그래도 넘치면 말줄임 + 툴팁.
				-->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Label
						AutomationProperties.AutomationId="Units.Status.Count"
						Content="{Binding ListStatusText}"
						Style="{StaticResource Unit.Readout}" />
					<!--
						막는 까닭을 말하려고 만든 자리다 — 좁은 폭에서 잘려 사라지면 안 된다(커널의
						"적용하거나 되돌린…" 실패와 같은 함정). 두 줄까지 굴리고 그래도 넘치면 말줄임 +
						툴팁으로 전체 문장을 남긴다. Label 은 그대로 둔다(peer 가 있어 자동화가 짚을 수 있다) —
						안의 TextBlock 만 트리밍을 맡는다.
					-->
					<Label
						Grid.Column="1"
						Margin="12,0"
						HorizontalAlignment="Right"
						AutomationProperties.AutomationId="Units.Status.Message"
						Content="{Binding StatusText}"
						Style="{StaticResource Unit.Readout}"
						ToolTip="{Binding StatusText}">
						<Label.ContentTemplate>
							<DataTemplate>
								<TextBlock
									MaxHeight="34"
									Text="{Binding}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="WrapWithOverflow" />
							</DataTemplate>
						</Label.ContentTemplate>
					</Label>
					<!--
						다른 곳에서 편제가 바뀌었는데(서버 SYNC_UNIT) 적용하지 않은 편집 · 끌기 때문에 다시 읽지 않았다.
						덮지 않고 알린다 — [다시 읽기]는 편제만 다시 읽고 상세의 미적용 편집은 그대로 둔다(결정 D-2026-09-27-215b6d · FR-48 ⑤).
					-->
					<StackPanel
						Grid.Column="2"
						Margin="0,0,12,0"
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Visibility="{Binding IsExternallyChanged, Converter={StaticResource BoolToVisibility}}">
						<Label
							AutomationProperties.AutomationId="Units.Status.ExternalChange"
							Content="{Binding ExternalChangeText}"
							Foreground="{DynamicResource StatusWarningBrush}"
							Style="{StaticResource Unit.Readout}" />
						<Button
							Margin="6,0,0,0"
							AutomationProperties.AutomationId="Units.Status.ExternalChangeReload"
							Click="OnReadExternalChange"
							Content="{Binding ExternalChangeActionText}"
							IsEnabled="{Binding CanReload}"
							Style="{StaticResource Console.Button.Mini}"
							ToolTip="서버의 지금 편제를 다시 읽어 트리 · 관계도를 새로 그립니다. 상세 칸에 적용하지 않은 변경은 그대로 둡니다." />
					</StackPanel>
					<Label
						Grid.Column="3"
						AutomationProperties.AutomationId="Units.Status.Permission"
						Content="읽기 전용 (편집 권한 없음)"
						Foreground="{DynamicResource TextMutedBrush}"
						Style="{StaticResource Unit.Readout}"
						Visibility="{Binding CanEditUnits, Converter={StaticResource NotBoolToVisibility}}" />
				</Grid>
			</Border>
		</c:ConsoleShell.StatusBar>

		<!--  상세 340 — 커널 ConsoleField 두 칸(라벨 102 · 입력)으로 왼쪽 모서리를 하나로 맞춘다  -->
		<c:ConsoleShell.Detail>
			<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="{Binding Detail.ApplyText}"
				Banner="{Binding Detail.Banner}"
				CanApply="{Binding Detail.CanApply}"
				CanRevert="{Binding Detail.CanRevert}"
				ConsoleKey="Units"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding Detail.FooterText}"
				IsDirty="{Binding Detail.IsDirty}"
				IsEnabled="{Binding IsConsoleInteractive}"
				IsReadOnly="{Binding Detail.IsReadOnly}"
				Kind="{Binding Detail.Kind}"
				RevertClick="OnRevert"
				RevertText="{Binding Detail.RevertText}"
				ShakeToken="{Binding Detail.ShakeToken}"
				ShowButtons="{Binding Detail.ShowButtons}"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding Detail.Title}">
				<Grid>
					<TextBlock
						Margin="16,16,14,0"
						VerticalAlignment="Top"
						FontSize="12"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="왼쪽 편제에서 부대를 고르면 여기에 상세가 표시됩니다. 새로 만들려면 툴바의 [부대 등록]을 누르세요."
						TextWrapping="Wrap"
						Visibility="{Binding IsDetailRequested, Converter={StaticResource NotBoolToVisibility}}" />

					<StackPanel
						Margin="16,4,14,16"
						DataContext="{Binding Form}"
						Visibility="{Binding DataContext.IsDetailRequested, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">

						<!--  삭제 차단(409) — 무엇이 매달려 있는지 개수로(스토리보드 화면 J)  -->
						<Border
							Margin="0,8,0,0"
							Padding="10,8"
							Background="{DynamicResource TintCriticalBrush}"
							BorderBrush="{DynamicResource StatusCriticalBrush}"
							BorderThickness="4,1,1,1"
							CornerRadius="4"
							Visibility="{Binding DataContext.IsDeleteBlocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
							<StackPanel>
								<Label
									AutomationProperties.AutomationId="Units.Detail.DeleteBlocked"
									Content="부대를 삭제할 수 없습니다"
									FontSize="12.5"
									FontWeight="Bold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Style="{StaticResource Unit.Readout}" />
								<ItemsControl
									Margin="0,6,0,0"
									Focusable="False"
									ItemsSource="{Binding DataContext.DeleteBlock.Items, RelativeSource={RelativeSource AncestorType=UserControl}}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
												<Run Text="·" /><Run Text=" " /><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run FontWeight="Bold" Text="{Binding Count, Mode=OneWay}" />
											</TextBlock>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock
									Margin="0,6,0,0"
									FontSize="11.5"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="운용을 멈추려면 삭제 대신 [운용 중지]를 쓰세요. 이력과 소속은 그대로 남습니다."
									TextWrapping="Wrap" />
								<StackPanel
									Margin="0,8,0,0"
									HorizontalAlignment="Right"
									Orientation="Horizontal">
									<Button
										Margin="0,0,8,0"
										AutomationProperties.AutomationId="Units.Detail.DeleteBlocked.Close"
										Click="OnDismissDeleteBlock"
										Content="닫기"
										Style="{StaticResource Console.Button.Ghost}" />
									<Button
										AutomationProperties.AutomationId="Units.Detail.DeleteBlocked.Disable"
										Click="OnDisable"
										Content="운용 중지"
										IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Console.Button}" />
								</StackPanel>
							</StackPanel>
						</Border>

						<!--  폼 오류 한 줄 — 보내기 전에 막은 까닭. 고친 칸 바로 위에 둔다.  -->
						<Border
							Margin="0,10,0,0"
							Padding="8,6"
							Background="{DynamicResource TintCriticalBrush}"
							BorderBrush="{DynamicResource StatusCriticalBrush}"
							BorderThickness="3,0,0,0"
							Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
							<Label
								AutomationProperties.AutomationId="Units.Detail.Error"
								Content="{Binding ErrorText}"
								FontSize="11.5"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Style="{StaticResource Unit.Readout}">
								<Label.ContentTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding}" TextWrapping="Wrap" />
									</DataTemplate>
								</Label.ContentTemplate>
							</Label>
						</Border>

						<c:ConsoleSection AxisName="units" Header="기본">
							<StackPanel>
								<!--  부대 코드 — 등록에서만 입력, 그 뒤로는 잠김(커널이 자물쇠 글리프를 그린다)  -->
								<c:ConsoleField
									ApiName="code"
									Header="부대 코드"
									IsLocked="{Binding IsCodeLocked}"
									Note="{Binding CodeNote}">
									<Grid>
										<TextBox
											AutomationProperties.AutomationId="Units.Detail.CodeField"
											Style="{StaticResource Unit.TextBox}"
											Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
											Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}" />
										<Border
											Height="32"
											Padding="8,0"
											Background="{DynamicResource SurfaceSunkenBrush}"
											BorderBrush="{DynamicResource DividerBrush}"
											BorderThickness="1"
											CornerRadius="3"
											Visibility="{Binding IsCodeLocked, Converter={StaticResource BoolToVisibility}}">
											<Label
												AutomationProperties.AutomationId="Units.Detail.CodeText"
												Content="{Binding Code}"
												FontFamily="{DynamicResource MonoFont}"
												FontSize="12.5"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Style="{StaticResource Unit.Readout}" />
										</Border>
									</Grid>
								</c:ConsoleField>

								<c:ConsoleField
									ApiName="name"
									Header="부대 이름"
									IsTouched="{Binding IsNameTouched}">
									<TextBox
										AutomationProperties.AutomationId="Units.Detail.NameBox"
										IsReadOnly="{Binding DataContext.Detail.IsFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Unit.TextBox}"
										Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
								</c:ConsoleField>

								<c:ConsoleField
									ApiName="echelon"
									Header="제대"
									IsTouched="{Binding IsEchelonTouched}"
									Note="{Binding ChildEchelonWarning}">
									<ComboBox
										AutomationProperties.AutomationId="Units.Detail.EchelonCombo"
										IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
										ItemsSource="{Binding Echelons}"
										SelectedItem="{Binding Echelon, Mode=TwoWay}"
										Style="{StaticResource Unit.Combo}">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Converter={StaticResource EchelonText}}" />
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</c:ConsoleField>

								<c:ConsoleField
									ApiName="description"
									Header="설명"
									IsTouched="{Binding IsDescriptionTouched}"
									Note="{Binding DescriptionCounter}">
									<TextBox
										MinHeight="56"
										AcceptsReturn="True"
										AutomationProperties.AutomationId="Units.Detail.DescriptionBox"
										IsReadOnly="{Binding DataContext.Detail.IsFormReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Unit.TextBox}"
										Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
										TextWrapping="Wrap"
										VerticalContentAlignment="Top" />
								</c:ConsoleField>

								<!--  운용 — 장비·계정·설정과 같은 어휘(체크 상자)로 낸다.  -->
								<c:ConsoleField
									ApiName="is_enable"
									Header="운용"
									IsTouched="{Binding IsEnableTouched}">
									<CheckBox
										AutomationProperties.AutomationId="Units.Detail.EnableSwitch"
										Content="운용 중"
										IsChecked="{Binding IsEnable, Mode=TwoWay}"
										IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Console.CheckBox}"
										ToolTip="퇴역은 삭제가 아니라 운용 중지입니다." />
								</c:ConsoleField>
							</StackPanel>
						</c:ConsoleSection>

						<!--  상위 부대 — 드래그의 버튼 폴백. 수정 화면에서는 [옮기기] 가 곧바로 보낸다.  -->
						<c:ConsoleSection AxisName="parent_id" Header="상위 부대">
							<StackPanel>
								<c:ConsoleField ApiName="parent_id" Header="상위">
									<ComboBox
										AutomationProperties.AutomationId="Units.Detail.ParentCombo"
										DisplayMemberPath="Label"
										IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
										ItemsSource="{Binding ParentOptions}"
										SelectedValue="{Binding ParentId, Mode=TwoWay}"
										SelectedValuePath="Id"
										Style="{StaticResource Unit.Combo}" />
								</c:ConsoleField>
								<StackPanel
									Margin="0,6,0,0"
									HorizontalAlignment="Right"
									Orientation="Horizontal"
									Visibility="{Binding IsCreating, Converter={StaticResource NotBoolToVisibility}}">
									<Button
										Margin="0,0,8,0"
										AutomationProperties.AutomationId="Units.Detail.MoveToRootButton"
										Click="OnMoveToRoot"
										Content="최상위로"
										IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Console.Button.Ghost}" />
									<Button
										AutomationProperties.AutomationId="Units.Detail.MoveButton"
										Click="OnMoveToSelectedParent"
										Content="옮기기"
										IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Console.Button}"
										ToolTip="고른 상위 부대 아래로 옮깁니다. 툴바의 [이동 되돌리기]로 되돌릴 수 있습니다." />
								</StackPanel>
							</StackPanel>
						</c:ConsoleSection>

						<!--  인접 부대 — 같은 제대만. 무방향이라 양쪽에 생긴다.  -->
						<c:ConsoleSection
							AxisName="adjacent_unit_ids"
							CountText="{Binding AdjacencyCountText}"
							Header="인접 부대">
							<StackPanel>
								<ItemsControl Focusable="False" ItemsSource="{Binding AdjacencyChips}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,5,5" Style="{StaticResource Unit.Chip}">
												<StackPanel Orientation="Horizontal">
													<TextBlock
														VerticalAlignment="Center"
														FontSize="11.5"
														Foreground="{DynamicResource TextPrimaryBrush}"
														Text="{Binding Name}" />
													<Button
														Width="16"
														Height="16"
														Margin="6,0,0,0"
														Padding="0"
														AutomationProperties.AutomationId="{Binding Id, StringFormat=Units.Detail.AdjacencyRemove.{0}}"
														Click="OnRemoveAdjacency"
														Style="{StaticResource Console.Button.Icon}"
														ToolTip="인접을 끊습니다 — 양쪽에서 함께 사라집니다.">
														<md:PackIcon
															Width="11"
															Height="11"
															Kind="Close" />
													</Button>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<!--  인접 드롭존 — 계측점은 Label(peer 실재)이다. Chrome 은 ContentControl 이라 트리에 없다.  -->
								<drag:DropZoneChrome
									MinHeight="34"
									Margin="0,2,0,0"
									drag:DropZone.Handler="{Binding DataContext.Drop, RelativeSource={RelativeSource AncestorType=UserControl}}"
									drag:DropZone.Key="unit-adjacency"
									CornerRadius="5">
									<Label
										Margin="8,7"
										AutomationProperties.AutomationId="Units.Detail.AdjacencyDrop"
										Content="여기에 부대를 끌어다 놓아 인접 연결"
										FontSize="11.5"
										Foreground="{DynamicResource TextMutedBrush}"
										Style="{StaticResource Unit.Readout}" />
								</drag:DropZoneChrome>

								<DockPanel Margin="0,6,0,0" LastChildFill="True">
									<Button
										Margin="8,0,0,0"
										AutomationProperties.AutomationId="Units.Detail.AdjacencyAddButton"
										Click="OnAddAdjacency"
										Content="인접 추가"
										DockPanel.Dock="Right"
										IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
										Style="{StaticResource Console.Button}" />
									<ComboBox
										AutomationProperties.AutomationId="Units.Detail.AdjacencyCombo"
										DisplayMemberPath="Label"
										IsEnabled="{Binding DataContext.CanEditUnits, RelativeSource={RelativeSource AncestorType=UserControl}}"
										ItemsSource="{Binding AdjacencyCandidates}"
										Style="{StaticResource Unit.Combo}" />
								</DockPanel>
								<TextBlock
									Margin="0,4,0,0"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="인접은 양방향으로 연결됩니다. 상대 부대의 상세에도 함께 표시됩니다."
									TextWrapping="Wrap" />
							</StackPanel>
						</c:ConsoleSection>

						<!--  관계도 · 지도 — 고른 부대의 장비를 지도에 보이고(FR-44), 이 부대만 자동 배치로 되돌린다(FR-09). 확인 없이 1회 · 되돌리기 가능.  -->
						<StackPanel
							Margin="0,14,0,0"
							HorizontalAlignment="Left"
							Orientation="Horizontal"
							Visibility="{Binding IsCreating, Converter={StaticResource NotBoolToVisibility}}">
							<Button
								Margin="0,0,8,0"
								AutomationProperties.AutomationId="Units.Detail.LocateOnMap"
								Click="OnLocateOnMap"
								Content="지도에서 보기"
								IsEnabled="{Binding DataContext.Map.CanLocateOnMap, RelativeSource={RelativeSource AncestorType=UserControl}}"
								Style="{StaticResource Console.Button}"
								ToolTip="{Binding DataContext.Map.LocateDisabledReason, RelativeSource={RelativeSource AncestorType=UserControl}}"
								ToolTipService.ShowOnDisabled="True" />
							<Button
								AutomationProperties.AutomationId="Units.Detail.ResetNodeLayout"
								Click="OnResetNodeLayout"
								Content="이 부대 배치 초기화"
								IsEnabled="{Binding DataContext.Map.CanResetSelectedNodeLayout, RelativeSource={RelativeSource AncestorType=UserControl}}"
								Style="{StaticResource Console.Button.Ghost}"
								ToolTip="{Binding DataContext.Map.ResetSelectedNodeLayoutDisabledReason, RelativeSource={RelativeSource AncestorType=UserControl}}"
								ToolTipService.ShowOnDisabled="True" />
						</StackPanel>

						<Label
							Margin="0,14,0,0"
							AutomationProperties.AutomationId="Units.Detail.Counts"
							Content="{Binding CountsText}"
							Style="{StaticResource Unit.Readout}" />

						<!--  파괴적 동작은 맨 아래, 서로 떨어뜨려 둔다.  -->
						<StackPanel
							Margin="0,18,0,24"
							HorizontalAlignment="Left"
							Orientation="Horizontal"
							Visibility="{Binding IsCreating, Converter={StaticResource NotBoolToVisibility}}">
							<Button
								Margin="0,0,10,0"
								AutomationProperties.AutomationId="Units.Detail.DeleteButton"
								Click="OnDelete"
								Content="삭제"
								IsEnabled="{Binding DataContext.CanDeleteUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
								Style="{StaticResource Console.Button.Danger}" />
							<Button
								AutomationProperties.AutomationId="Units.Detail.DisableButton"
								Click="OnDisable"
								Content="운용 중지"
								IsEnabled="{Binding DataContext.CanMoveSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
								Style="{StaticResource Console.Button.Ghost}" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</c:ConsoleDetailHost>
		</c:ConsoleShell.Detail>
	</c:ConsoleShell>
</UserControl>
