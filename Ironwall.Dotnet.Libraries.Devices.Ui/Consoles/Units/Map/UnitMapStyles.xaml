<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:map="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Units.Map">
	<!--
		부대 관계도 노드의 기본 스타일 (unit-relationship-map IMPL-19 · FR-20 · FR-22 · FR-23 · NFR-06~08).
		Themes/Generic.xaml 이 이 사전을 병합한다 — 호스트 앱은 아무것도 병합하지 않아도 된다.

		규칙: ① 색은 전부 DynamicResource 토큰(캐싱 · Frozen 금지 — NFR-07). 해치 브러시도 템플릿 안에 두어 토큰을 매번 재해석한다
		      ② 뜻은 색이 아니라 형태로(NFR-06): 선택 = L2 왼쪽 3px 세로 막대 + 1.5 윤곽 / L0 · L1 모서리 괄호 ·
		         중지 = 사선 해치 · 내 부대 = ★ · 오류 = ▲+수 · 옮김 = 핀
		      ③ 이미 배정된 점선 어휘(그룹 선택 4·3 · 드로잉 5·3) · 앰버 · SurfaceHover/Pressed 를 쓰지 않는다
		      ④ 애니메이션 없음(NFR-05 · RDP) · x:Name 없음(CM 바인딩 지시자 — 템플릿 안에도 두지 않는다)
		      ⑤ 템플릿은 단계가 바뀔 때만 갈아 끼운다(Level 트리거 — NFR-03). 도형 좌표는 노드의 Visuals(얼린 기하)가 준다
		      ⑥ 템플릿 안 글은 커널 ConsoleText — UIA 기본 보기에 나온다
	-->

	<BooleanToVisibilityConverter x:Key="UnitMapBoolToVisibility" />

	<!--  ── L0 개요: 작은 틀(크기가 제대를 말한다) · 글자 없음 · ★ ▲ 사선만  ──  -->
	<ControlTemplate x:Key="UnitMapNodeL0Template" TargetType="{x:Type map:UnitMapNode}">
		<Grid Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
			<Canvas IsHitTestVisible="False">
				<Path Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource SurfaceAltBrush}" />
				<Path
					Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource TintInfoBrush}"
					Stroke="{DynamicResource TextPrimaryBrush}"
					StrokeThickness="1.2" />
				<Path
					Data="{Binding Visuals.SlashGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource TextPrimaryBrush}"
					StrokeThickness="1.2"
					Visibility="{TemplateBinding IsSuspended, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.StarGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource PrimaryBrush}"
					Stroke="{DynamicResource SurfaceAltBrush}"
					StrokeThickness="0.8"
					Visibility="{TemplateBinding IsMine, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.ErrorGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource StatusCriticalBrush}"
					Visibility="{TemplateBinding HasErrors, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.BracketsGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource SelectionBrush}"
					StrokeThickness="2"
					Visibility="{TemplateBinding IsSelectedNode, Converter={StaticResource UnitMapBoolToVisibility}}" />
			</Canvas>
		</Grid>
	</ControlTemplate>

	<!--  ── L1 부대: 틀 30×20 + 제대 표지 + 틀 아래 짧은 이름(칸 × 배율 − 8 에서 말줄임)  ──  -->
	<ControlTemplate x:Key="UnitMapNodeL1Template" TargetType="{x:Type map:UnitMapNode}">
		<Grid Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
			<Canvas IsHitTestVisible="False">
				<Path Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource SurfaceAltBrush}" />
				<Path
					Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource TintInfoBrush}"
					Stroke="{DynamicResource TextPrimaryBrush}"
					StrokeThickness="1.5" />
				<!--  운용 중지 = 틀 사선 해치(토큰 재해석을 위해 템플릿 안에 둔다)  -->
				<Path Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding IsSuspended, Converter={StaticResource UnitMapBoolToVisibility}}">
					<Path.Fill>
						<!--  Viewbox 를 타일 크기로 못박는다 — 선 하나(폭 0)의 경계로 늘이면 틀 전체가 까맣게 칠해진다  -->
						<DrawingBrush
							Stretch="None"
							TileMode="Tile"
							Viewbox="0,0,7,7"
							ViewboxUnits="Absolute"
							Viewport="0,0,7,7"
							ViewportUnits="Absolute">
							<DrawingBrush.Transform>
								<RotateTransform Angle="45" />
							</DrawingBrush.Transform>
							<DrawingBrush.Drawing>
								<GeometryDrawing Geometry="M3.5,0 L3.5,7">
									<GeometryDrawing.Pen>
										<Pen Brush="{DynamicResource TextMutedBrush}" Thickness="1" />
									</GeometryDrawing.Pen>
								</GeometryDrawing>
							</DrawingBrush.Drawing>
						</DrawingBrush>
					</Path.Fill>
				</Path>
				<Path
					Data="{Binding Visuals.MarkStrokeGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource TextPrimaryBrush}"
					StrokeEndLineCap="Square"
					StrokeStartLineCap="Square"
					StrokeThickness="1.5" />
				<Path Data="{Binding Visuals.MarkDotGeometry, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource TextPrimaryBrush}" />
				<c:ConsoleText
					Canvas.Left="{Binding Visuals.UnknownMarkLeft, RelativeSource={RelativeSource TemplatedParent}}"
					Canvas.Top="{Binding Visuals.UnknownMarkTop, RelativeSource={RelativeSource TemplatedParent}}"
					FontSize="10"
					FontWeight="Bold"
					Foreground="{DynamicResource TextPrimaryBrush}"
					Text="?"
					Visibility="{Binding Visuals.IsUnknownEchelon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.StarGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource PrimaryBrush}"
					Stroke="{DynamicResource SurfaceAltBrush}"
					StrokeThickness="0.8"
					Visibility="{TemplateBinding IsMine, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.ErrorGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource StatusCriticalBrush}"
					Visibility="{TemplateBinding HasErrors, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.PinGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource TextSecondaryBrush}"
					StrokeThickness="1.4"
					Visibility="{TemplateBinding IsMoved, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.BracketsGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource SelectionBrush}"
					StrokeThickness="2"
					Visibility="{TemplateBinding IsSelectedNode, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<!--  짧은 이름 — 한 줄 말줄임(줄바꿈 없음). 폭은 캔버스가 L1 에서 배율이 바뀔 때만 준다  -->
				<c:ConsoleText
					Canvas.Left="{TemplateBinding LabelLeft}"
					Canvas.Top="{Binding Visuals.LabelTop, RelativeSource={RelativeSource TemplatedParent}}"
					Width="{TemplateBinding LabelWidth}"
					FontSize="11.5"
					Foreground="{DynamicResource TextPrimaryBrush}"
					Text="{TemplateBinding ShortName}"
					TextAlignment="Center"
					TextTrimming="CharacterEllipsis"
					TextWrapping="NoWrap">
					<c:ConsoleText.Style>
						<Style TargetType="{x:Type c:ConsoleText}">
							<Setter Property="FontWeight" Value="Medium" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsSelectedNode, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
									<Setter Property="FontWeight" Value="Bold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</c:ConsoleText.Style>
				</c:ConsoleText>
			</Canvas>
		</Grid>
	</ControlTemplate>

	<!--  ── L2 상세: 카드 132×56 — 틀 36×24 + 표지 · 전체 이름 · 코드 · 장비 N · ▲오류 N · 중지 · ★ · 핀  ──  -->
	<ControlTemplate x:Key="UnitMapNodeL2Template" TargetType="{x:Type map:UnitMapNode}">
		<Grid Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True">
			<Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="5">
				<Border.Style>
					<Style TargetType="{x:Type Border}">
						<Setter Property="BorderBrush" Value="{DynamicResource RowLineBrush}" />
						<Setter Property="BorderThickness" Value="1" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsSelectedNode, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
								<Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
								<Setter Property="BorderThickness" Value="1.5" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
			</Border>
			<!--  선택 = 왼쪽 3px 세로 막대(기존 어휘) — 색이 아니라 형태로 가른다  -->
			<Border
				Width="3"
				HorizontalAlignment="Left"
				Background="{DynamicResource SelectionBrush}"
				CornerRadius="1.5"
				IsHitTestVisible="False"
				Visibility="{TemplateBinding IsSelectedNode, Converter={StaticResource UnitMapBoolToVisibility}}" />
			<Canvas IsHitTestVisible="False">
				<Path Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource SurfaceAltBrush}" />
				<Path
					Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource TintInfoBrush}"
					Stroke="{DynamicResource TextPrimaryBrush}"
					StrokeThickness="1.5" />
				<Path Data="{Binding Visuals.FrameGeometry, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding IsSuspended, Converter={StaticResource UnitMapBoolToVisibility}}">
					<Path.Fill>
						<!--  Viewbox 를 타일 크기로 못박는다 — 선 하나(폭 0)의 경계로 늘이면 틀 전체가 까맣게 칠해진다  -->
						<DrawingBrush
							Stretch="None"
							TileMode="Tile"
							Viewbox="0,0,7,7"
							ViewboxUnits="Absolute"
							Viewport="0,0,7,7"
							ViewportUnits="Absolute">
							<DrawingBrush.Transform>
								<RotateTransform Angle="45" />
							</DrawingBrush.Transform>
							<DrawingBrush.Drawing>
								<GeometryDrawing Geometry="M3.5,0 L3.5,7">
									<GeometryDrawing.Pen>
										<Pen Brush="{DynamicResource TextMutedBrush}" Thickness="1" />
									</GeometryDrawing.Pen>
								</GeometryDrawing>
							</DrawingBrush.Drawing>
						</DrawingBrush>
					</Path.Fill>
				</Path>
				<Path
					Data="{Binding Visuals.MarkStrokeGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource TextPrimaryBrush}"
					StrokeEndLineCap="Square"
					StrokeStartLineCap="Square"
					StrokeThickness="1.5" />
				<Path Data="{Binding Visuals.MarkDotGeometry, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource TextPrimaryBrush}" />
				<c:ConsoleText
					Canvas.Left="{Binding Visuals.UnknownMarkLeft, RelativeSource={RelativeSource TemplatedParent}}"
					Canvas.Top="{Binding Visuals.UnknownMarkTop, RelativeSource={RelativeSource TemplatedParent}}"
					FontSize="10"
					FontWeight="Bold"
					Foreground="{DynamicResource TextPrimaryBrush}"
					Text="?"
					Visibility="{Binding Visuals.IsUnknownEchelon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.StarGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Fill="{DynamicResource PrimaryBrush}"
					Stroke="{DynamicResource SurfaceAltBrush}"
					StrokeThickness="0.8"
					Visibility="{TemplateBinding IsMine, Converter={StaticResource UnitMapBoolToVisibility}}" />
				<Path
					Data="{Binding Visuals.PinGeometry, RelativeSource={RelativeSource TemplatedParent}}"
					Stroke="{DynamicResource TextSecondaryBrush}"
					StrokeThickness="1.4"
					Visibility="{TemplateBinding IsMoved, Converter={StaticResource UnitMapBoolToVisibility}}" />
			</Canvas>
			<!--  글 칸 — 카드 왼쪽 54 에서(틀 오른쪽 + 8)  -->
			<StackPanel Margin="54,6,8,0" IsHitTestVisible="False">
				<c:ConsoleText
					FontSize="12.5"
					FontWeight="SemiBold"
					Foreground="{DynamicResource TextPrimaryBrush}"
					Text="{TemplateBinding UnitName}"
					TextTrimming="CharacterEllipsis"
					TextWrapping="NoWrap" />
				<c:ConsoleText
					FontFamily="{DynamicResource MonoFont}"
					FontSize="10.5"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{TemplateBinding Code}"
					TextTrimming="CharacterEllipsis"
					TextWrapping="NoWrap" />
				<StackPanel Margin="0,2,0,0" Orientation="Horizontal">
					<Border
						Height="14"
						Margin="0,0,5,0"
						Padding="5,0"
						Background="{DynamicResource SurfaceSunkenBrush}"
						BorderBrush="{DynamicResource RowLineBrush}"
						BorderThickness="1"
						CornerRadius="7"
						Visibility="{TemplateBinding ShowDeviceBadges, Converter={StaticResource UnitMapBoolToVisibility}}">
						<c:ConsoleText
							VerticalAlignment="Center"
							FontSize="10"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding DeviceCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='장비 {0}'}" />
					</Border>
					<StackPanel
						Margin="0,0,5,0"
						Orientation="Horizontal"
						Visibility="{TemplateBinding HasErrors, Converter={StaticResource UnitMapBoolToVisibility}}">
						<Path
							Margin="0,1,2,0"
							VerticalAlignment="Center"
							Data="{Binding Visuals.ErrorGeometry, RelativeSource={RelativeSource TemplatedParent}}"
							Fill="{DynamicResource StatusCriticalBrush}" />
						<c:ConsoleText
							VerticalAlignment="Center"
							FontSize="10.5"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding ErrorCount, RelativeSource={RelativeSource TemplatedParent}}" />
					</StackPanel>
					<Border
						Height="14"
						Padding="4,0"
						Background="{DynamicResource SurfaceSunkenBrush}"
						BorderBrush="{DynamicResource RowLineBrush}"
						BorderThickness="1"
						CornerRadius="2"
						Visibility="{TemplateBinding IsSuspended, Converter={StaticResource UnitMapBoolToVisibility}}">
						<c:ConsoleText
							VerticalAlignment="Center"
							FontSize="10"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="중지" />
					</Border>
				</StackPanel>
			</StackPanel>
		</Grid>
	</ControlTemplate>

	<Style TargetType="{x:Type map:UnitMapNode}">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="ToolTipService.InitialShowDelay" Value="400" />
		<Setter Property="Template" Value="{StaticResource UnitMapNodeL1Template}" />
		<Style.Triggers>
			<Trigger Property="Level" Value="L0">
				<Setter Property="Template" Value="{StaticResource UnitMapNodeL0Template}" />
			</Trigger>
			<Trigger Property="Level" Value="L2">
				<Setter Property="Template" Value="{StaticResource UnitMapNodeL2Template}" />
			</Trigger>
			<!--  제대 칩 강조에서 빠진 부대 — 50% 흐림(거르지 않는다 — R-19)  -->
			<Trigger Property="IsDimmed" Value="True">
				<Setter Property="Opacity" Value="0.5" />
			</Trigger>
		</Style.Triggers>
	</Style>
</ResourceDictionary>
