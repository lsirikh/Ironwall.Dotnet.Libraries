<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.CameraUrlsView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignHeight="300"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<Grid Height="300" Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="7*" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  HomepageUrl  -->
		<TextBlock
			Grid.Row="0"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="Homepage" />
		<TextBox
			Grid.Row="0"
			Grid.Column="1"
			IsReadOnly="True"
			md:HintAssist.Hint="http://..."
			Style="{StaticResource TextBoxInput}"
			Text="{Binding HomepageUrl, Mode=OneWay}" />

		<!--  OnvifDeviceService  -->
		<TextBlock
			Grid.Row="1"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="ONVIF Service" />
		<TextBox
			Grid.Row="1"
			Grid.Column="1"
			IsReadOnly="True"
			md:HintAssist.Hint="http://.../onvif/device_service"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding OnvifDeviceService, Mode=OneWay}" />

		<!--  RtspMain  -->
		<TextBlock
			Grid.Row="2"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="RTSP Main" />
		<TextBox
			Grid.Row="2"
			Grid.Column="1"
			IsReadOnly="True"
			md:HintAssist.Hint="rtsp://..."
			Style="{StaticResource TextBoxInput}"
			Text="{Binding RtspMain, Mode=OneWay}" />

		<!--  RtspSub  -->
		<TextBlock
			Grid.Row="3"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="RTSP Sub" />
		<TextBox
			Grid.Row="3"
			Grid.Column="1"
			IsReadOnly="True"
			md:HintAssist.Hint="rtsp://..."
			Style="{StaticResource TextBoxInput}"
			Text="{Binding RtspSub, Mode=OneWay}" />

		<!--  WebrtcMain  -->
		<TextBlock
			Grid.Row="4"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="WebRTC Main" />
		<TextBox
			Grid.Row="4"
			Grid.Column="1"
			IsReadOnly="True"
			md:HintAssist.Hint="http://..."
			Style="{StaticResource TextBoxInput}"
			Text="{Binding WebrtcMain, Mode=OneWay}" />

		<!--  SnapshotCh1  -->
		<TextBlock
			Grid.Row="5"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="Snapshot Ch1" />
		<TextBox
			Grid.Row="5"
			Grid.Column="1"
			IsReadOnly="True"
			md:HintAssist.Hint="http://..."
			Style="{StaticResource TextBoxInput}"
			Text="{Binding SnapshotCh1, Mode=OneWay}" />
	</Grid>
</UserControl>
