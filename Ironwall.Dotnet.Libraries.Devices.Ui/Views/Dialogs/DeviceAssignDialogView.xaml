<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.Dialogs.DeviceAssignDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	Foreground="{DynamicResource TextPrimaryBrush}">
	<!--
		장비 배정 창 — T4 · L 720.
		정본: window-layout-system-storyboard.html #h-dlg L1436(장비 추가(배정) 600×600 → L 720, 좌→우 이동형 두 목록이라 넓게) ·
		all-windows-drag-wireframe.html L392-396(좌 → 우 끌어 배정 · 우 → 좌 끌어 해제 · ▶ ◀ 버튼도 그대로 둔다 — 키보드·자동화 경로) ·
		같은 문서 L424(서버 호출은 저장 때 1회).
		창 안은 전부 Draft. ▶ ◀ 와 드롭은 같은 메서드를 부른다. x:Name 은 쓰지 않는다 — 계측은 AutomationId(Devices.Assign.*).
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<!--  가운데 이동 버튼 — 네모 한 칸. Button 이라 peer 가 실재한다(Border 로 만들면 자동화에서 사라진다).  -->
		<Style x:Key="Assign.MoveButton" TargetType="Button">
			<Setter Property="Width" Value="38" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Margin" Value="0,3" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border
								x:Name="Bd"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="4" />
							<Border
								x:Name="Ring"
								Margin="-3"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								CornerRadius="7"
								Visibility="Collapsed" />
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Ring" Property="Visibility" Value="Visible" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<!--  꺼져도 읽힌다 — 투명도 대신 글자만 muted  -->
								<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
								<Setter Property="Cursor" Value="Arrow" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  버튼 줄 왼쪽의 보조 — 오른쪽 짝과 높이를 맞춘다(같은 줄에서 높이가 다르면 눈에 띈다).  -->
		<Style
			x:Key="Assign.FooterButton"
			BasedOn="{StaticResource Assign.MoveButton}"
			TargetType="Button">
			<Setter Property="Width" Value="Auto" />
			<Setter Property="Height" Value="34" />
			<Setter Property="MinWidth" Value="88" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="14,0" />
		</Style>

		<Style x:Key="Assign.PaneTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="Margin" Value="2,0,0,6" />
		</Style>

		<Style x:Key="Assign.RowName" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  가라앉은 칸(SurfaceSunken) 위의 작은 글씨라 Muted 는 AA 에 못 미친다 — Secondary 로 올린다.  -->
		<Style x:Key="Assign.RowMeta" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--
			드롭존 겉모습 — 색이 아니라 형태다(라이트에서 주색 · 선택색 · 포커스색이 같은 색이다).
			놓을 수 있음 = 파선 {6,4} · 지금 그 위 = 굵은 윤곽 · 놓을 수 없음 = 굵은 점선 {1,3} + 가라앉은 바탕.
		-->
		<Style x:Key="Assign.Pane" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>

		<Style x:Key="Assign.DropChrome" TargetType="Rectangle">
			<Setter Property="RadiusX" Value="6" />
			<Setter Property="RadiusY" Value="6" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Visibility" Value="Collapsed" />
			<Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
			<Setter Property="StrokeThickness" Value="2" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Path=(drag:DropZone.State), RelativeSource={RelativeSource Self}}" Value="Available">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="StrokeDashArray" Value="6,4" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Path=(drag:DropZone.State), RelativeSource={RelativeSource Self}}" Value="Hover">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="StrokeThickness" Value="3" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Path=(drag:DropZone.State), RelativeSource={RelativeSource Self}}" Value="Blocked">
					<Setter Property="Visibility" Value="Visible" />
					<Setter Property="Stroke" Value="{DynamicResource StatusCriticalBrush}" />
					<Setter Property="StrokeThickness" Value="3" />
					<Setter Property="StrokeDashArray" Value="1,2" />
					<Setter Property="StrokeDashCap" Value="Round" />
					<Setter Property="Fill" Value="{DynamicResource TintCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<!--  한 행: 손잡이 · 번호 · 이름 · 종류  -->
		<DataTemplate x:Key="Assign.RowTemplate">
			<DockPanel Margin="0,3" LastChildFill="True">
				<drag:DragHandle
					AutomationProperties.AutomationId="{Binding Id, StringFormat=Devices.Assign.Handle.{0}}"
					DockPanel.Dock="Left"
					ToolTip="끌어서 옮기기" />
				<TextBlock
					Width="44"
					Margin="8,0,0,0"
					DockPanel.Dock="Left"
					Style="{StaticResource Assign.RowMeta}"
					Text="{Binding DeviceNumber, StringFormat=#{0}}" />
				<TextBlock
					MinWidth="96"
					Margin="8,0,0,0"
					DockPanel.Dock="Right"
					Style="{StaticResource Assign.RowMeta}"
					Text="{Binding TypeAxisLabel}" />
				<TextBlock Style="{StaticResource Assign.RowName}" Text="{Binding DeviceName}" />
			</DockPanel>
		</DataTemplate>
	</UserControl.Resources>

	<dlg:ConsoleDialogFrame
		Backdrop="{DynamicResource BgBrush}"
		BodyScroll="Disabled"
		DialogKey="Devices.Assign"
		IsBusy="{Binding IsBusy}"
		IsPrimaryEnabled="{Binding CanSave}"
		Kind="{Binding Kind}"
		Message="{Binding Message}"
		MessageSeverity="{Binding MessageSeverity}"
		PrimaryInvoked="OnSave"
		PrimaryText="저장"
		SecondaryInvoked="OnCancel"
		SecondaryText="취소"
		Size="Large"
		Title="장비 배정">

		<dlg:ConsoleDialogFrame.FooterExtra>
			<Button
				AutomationProperties.AutomationId="Devices.Assign.Revert"
				Click="OnRevert"
				Content="되돌리기"
				IsEnabled="{Binding CanRevert}"
				Style="{StaticResource Assign.FooterButton}"
				ToolTip="창을 연 상태로 되돌린다 (서버는 건드리지 않는다)" />
		</dlg:ConsoleDialogFrame.FooterExtra>

		<!--  창이 작아지면 카드가 눌린다 — 높이를 고정하지 않고 목록이 제 안에서 스크롤하게 둔다(C8).  -->
		<Grid MinHeight="320">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  ── 왼쪽: 후보 ──  -->
			<DockPanel Grid.Column="0" LastChildFill="True">
				<TextBlock
					DockPanel.Dock="Top"
					Style="{StaticResource Assign.PaneTitle}"
					Text="{Binding Available.Count, StringFormat=후보 ({0})}" />
				<Border
					drag:DropZone.Handler="{Binding}"
					drag:DropZone.Key="assign-available"
					Style="{StaticResource Assign.Pane}">
					<Grid>
						<TextBlock
							Margin="16"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							MaxWidth="240"
							Style="{StaticResource Assign.RowMeta}"
							Text="{Binding AvailableEmptyText}"
							TextAlignment="Center"
							TextWrapping="Wrap"
							Visibility="{Binding IsAvailableEmpty, Converter={StaticResource BoolToVisibility}}" />
						<Rectangle Margin="2" Style="{StaticResource Assign.DropChrome}" />
						<ListBox
							Margin="6"
							AutomationProperties.AutomationId="Devices.Assign.Available"
							IsEnabled="{Binding IsEditable}"
							ItemTemplate="{StaticResource Assign.RowTemplate}"
							ItemsSource="{Binding Available}"
							PreviewKeyDown="OnAvailableKeyDown"
							SelectionChanged="OnAvailableSelectionChanged"
							SelectionMode="Extended"
							Style="{StaticResource Console.ReorderList}">
							<b:Interaction.Behaviors>
								<drag:CaptureDragBehavior
									DisplayMemberPath="DeviceName"
									Handler="{Binding}"
									IsDragEnabled="{Binding IsEditable}"
									KeyboardFallback="▶ 버튼 · Enter" />
							</b:Interaction.Behaviors>
						</ListBox>
					</Grid>
				</Border>
			</DockPanel>

			<!--  ── 가운데: 버튼 폴백(키보드 · 자동화 경로) ──  -->
			<StackPanel
				Grid.Column="1"
				Margin="10,22,10,0"
				VerticalAlignment="Center">
				<Button
					AutomationProperties.AutomationId="Devices.Assign.MoveRight"
					Click="OnMoveRight"
					Content="▶"
					IsEnabled="{Binding CanAssignSelected}"
					Style="{StaticResource Assign.MoveButton}"
					ToolTip="고른 장비를 그룹에 넣는다 (왼쪽 목록에서 Enter)" />
				<Button
					AutomationProperties.AutomationId="Devices.Assign.MoveAllRight"
					Click="OnMoveAllRight"
					Content="▶▶"
					IsEnabled="{Binding CanAssignAll}"
					Style="{StaticResource Assign.MoveButton}"
					ToolTip="후보를 모두 넣는다" />
				<Border
					Height="1"
					Margin="4,8"
					Background="{DynamicResource DividerBrush}" />
				<Button
					AutomationProperties.AutomationId="Devices.Assign.MoveLeft"
					Click="OnMoveLeft"
					Content="◀"
					IsEnabled="{Binding CanUnassignSelected}"
					Style="{StaticResource Assign.MoveButton}"
					ToolTip="고른 장비를 그룹에서 뺀다 (오른쪽 목록에서 Delete)" />
				<Button
					AutomationProperties.AutomationId="Devices.Assign.MoveAllLeft"
					Click="OnMoveAllLeft"
					Content="◀◀"
					IsEnabled="{Binding CanUnassignAll}"
					Style="{StaticResource Assign.MoveButton}"
					ToolTip="배정을 모두 뺀다" />
			</StackPanel>

			<!--  ── 오른쪽: 이 그룹 ──  -->
			<DockPanel Grid.Column="2" LastChildFill="True">
				<TextBlock
					DockPanel.Dock="Top"
					Style="{StaticResource Assign.PaneTitle}"
					Text="{Binding Assigned.Count, StringFormat=이 그룹 ({0})}" />
				<Border
					drag:DropZone.Handler="{Binding}"
					drag:DropZone.Key="assign-assigned"
					Style="{StaticResource Assign.Pane}">
					<Grid>
						<TextBlock
							Margin="16"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							MaxWidth="240"
							Style="{StaticResource Assign.RowMeta}"
							Text="{Binding AssignedEmptyText}"
							TextAlignment="Center"
							TextWrapping="Wrap"
							Visibility="{Binding IsAssignedEmpty, Converter={StaticResource BoolToVisibility}}" />
						<Rectangle Margin="2" Style="{StaticResource Assign.DropChrome}" />
						<ListBox
							Margin="6"
							AutomationProperties.AutomationId="Devices.Assign.Assigned"
							IsEnabled="{Binding IsEditable}"
							ItemTemplate="{StaticResource Assign.RowTemplate}"
							ItemsSource="{Binding Assigned}"
							PreviewKeyDown="OnAssignedKeyDown"
							SelectionChanged="OnAssignedSelectionChanged"
							SelectionMode="Extended"
							Style="{StaticResource Console.ReorderList}">
							<b:Interaction.Behaviors>
								<drag:CaptureDragBehavior
									DisplayMemberPath="DeviceName"
									Handler="{Binding}"
									IsDragEnabled="{Binding IsEditable}"
									KeyboardFallback="◀ 버튼 · Delete" />
							</b:Interaction.Behaviors>
						</ListBox>
					</Grid>
				</Border>
			</DockPanel>
		</Grid>
	</dlg:ConsoleDialogFrame>
</UserControl>
