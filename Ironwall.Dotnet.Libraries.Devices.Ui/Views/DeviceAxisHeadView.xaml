<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.DeviceAxisHeadView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	AutomationProperties.AutomationId="Devices.Detail.AxisHead"
	Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
	mc:Ignorable="d">
	<!--
		상세 폼의 v7.0+ 축 절 (앞부분): 판별자 · ② 접속 · ③ 형상 · ④ 부품 · ⑤ 상태  — device-console-v8 FR-11.
		전부 읽기 전용이다. DataContext = DeviceAxisSectionsViewModel. 6.3 계약이면 통째로 Collapsed.
		미수신(이 응답에 안 실림)과 빈 값은 다른 모양으로 보인다: 미수신 = 파선 박스, 빈 값 = "—" / "형상 미입력".
	-->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.Devices.Ui;component/Views/DeviceAxisResources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>

	<StackPanel>
		<!--  판별자: 편집할 수 없다 — 경로가 정본이다  -->
		<StackPanel Margin="0,10,0,0" Orientation="Horizontal">
			<Border
				Padding="8,2"
				AutomationProperties.AutomationId="Devices.Detail.CategoryBadge"
				Background="{DynamicResource TintInfoBrush}"
				BorderBrush="{DynamicResource StatusInfoBrush}"
				BorderThickness="1"
				CornerRadius="10"
				ToolTip="category_device — 장비가 속한 경로가 정하며 바꿀 수 없습니다">
				<StackPanel Orientation="Horizontal">
					<md:PackIcon
						Width="12"
						Height="12"
						Margin="0,0,4,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource StatusInfoBrush}"
						Kind="LockOutline" />
					<TextBlock
						FontSize="11"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding CategoryText}" />
				</StackPanel>
			</Border>
			<TextBlock
				Margin="8,0,0,0"
				VerticalAlignment="Center"
				FontFamily="Consolas"
				FontSize="11"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding PathText}" />
		</StackPanel>

		<!--  여러 대 선택: 축은 장비마다 다르다  -->
		<TextBlock
			Margin="0,10,0,0"
			Style="{StaticResource AxisCellMuted}"
			Text="여러 장비가 선택되었습니다 — 접속·형상·상태·설정 정보는 한 대를 선택하면 표시됩니다."
			TextWrapping="Wrap"
			Visibility="{Binding IsMultiple, Converter={StaticResource BooleanToVisibilityConverter}}" />

		<StackPanel Visibility="{Binding IsSingle, Converter={StaticResource BooleanToVisibilityConverter}}">
			<!--  ② 접속 축  -->
			<StackPanel Orientation="Horizontal">
				<TextBlock Style="{StaticResource AxisTitle}" Text="접속 (connection)" />
				<TextBlock Style="{StaticResource AxisReadOnlyTag}" />
			</StackPanel>
			<ContentControl
				AutomationProperties.AutomationId="Devices.Detail.Section.Connection"
				DataContext="{Binding Connection}"
				Focusable="False"
				Template="{StaticResource AxisSectionBody}" />

			<!--  ③ 형상 축  -->
			<StackPanel Orientation="Horizontal">
				<TextBlock Style="{StaticResource AxisTitle}" Text="형상 (hardware_spec)" />
				<TextBlock Style="{StaticResource AxisReadOnlyTag}" />
			</StackPanel>
			<ContentControl
				AutomationProperties.AutomationId="Devices.Detail.Section.HardwareSpec"
				DataContext="{Binding HardwareSpec}"
				Focusable="False"
				Template="{StaticResource AxisSectionBody}" />

			<!--  ④ 부품  -->
			<StackPanel Orientation="Horizontal">
				<TextBlock Style="{StaticResource AxisTitle}" Text="부품 (components)" />
				<TextBlock Style="{StaticResource AxisReadOnlyTag}" />
			</StackPanel>
			<ContentControl
				AutomationProperties.AutomationId="Devices.Detail.Section.Components"
				DataContext="{Binding Components}"
				Focusable="False"
				Template="{StaticResource AxisSectionBody}" />
			<ItemsControl ItemsSource="{Binding ComponentRows}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150" />
								<ColumnDefinition Width="170" />
								<ColumnDefinition Width="60" />
								<ColumnDefinition Width="80" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" FontFamily="Consolas" Style="{StaticResource AxisCell}" Text="{Binding Key}" />
							<TextBlock Grid.Column="1" Style="{StaticResource AxisCell}" Text="{Binding Type}" />
							<TextBlock Grid.Column="2" Style="{StaticResource AxisCellMuted}" Text="{Binding Channel, StringFormat=ch {0}}" />
							<TextBlock Grid.Column="3" Style="{StaticResource AxisCellMuted}" Text="{Binding Position}" />
							<TextBlock Grid.Column="4" Style="{StaticResource AxisCellMuted}" Text="{Binding Label}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!--  ⑤ 상태(관측)  -->
			<StackPanel Orientation="Horizontal">
				<TextBlock Style="{StaticResource AxisTitle}" Text="상태 (device_status)" />
				<TextBlock Style="{StaticResource AxisReadOnlyTag}" />
			</StackPanel>
			<ContentControl
				AutomationProperties.AutomationId="Devices.Detail.Section.DeviceStatus"
				DataContext="{Binding DeviceStatus}"
				Focusable="False"
				Template="{StaticResource AxisSectionBody}" />
			<ItemsControl ItemsSource="{Binding StatusRows}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="150" />
								<ColumnDefinition Width="90" />
								<ColumnDefinition Width="90" />
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" FontFamily="Consolas" Style="{StaticResource AxisCell}" Text="{Binding Key}" />
							<TextBlock Grid.Column="1" Style="{StaticResource AxisCell}" Text="{Binding State}" />
							<TextBlock Grid.Column="2" Style="{StaticResource AxisCell}" Text="{Binding Health}" />
							<TextBlock Grid.Column="3" Style="{StaticResource AxisCellMuted}" Text="{Binding FaultReason}" />
							<TextBlock Grid.Column="4" FontFamily="Consolas" Style="{StaticResource AxisCellMuted}" Text="{Binding ObservedAt}" />
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</StackPanel>
</UserControl>
