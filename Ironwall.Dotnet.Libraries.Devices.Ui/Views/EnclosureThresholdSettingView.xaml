<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.EnclosureThresholdSettingView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignWidth="420"
	mc:Ignorable="d">
	<Grid Margin="16">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="7*" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  온도 상한  -->
		<TextBlock
			Grid.Row="0"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="온도 상한(°C)" />
		<TextBox
			Grid.Row="0"
			Grid.Column="1"
			md:HintAssist.Hint="예: 45"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding TempHigh, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

		<!--  온도 하한  -->
		<TextBlock
			Grid.Row="1"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="온도 하한(°C)" />
		<TextBox
			Grid.Row="1"
			Grid.Column="1"
			md:HintAssist.Hint="예: -10"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding TempLow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

		<!--  습도 상한  -->
		<TextBlock
			Grid.Row="2"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="습도 상한(%)" />
		<TextBox
			Grid.Row="2"
			Grid.Column="1"
			md:HintAssist.Hint="예: 80"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding HumidityHigh, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

		<!--  전류 상한  -->
		<TextBlock
			Grid.Row="3"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="전류 상한(A)" />
		<TextBox
			Grid.Row="3"
			Grid.Column="1"
			md:HintAssist.Hint="예: 10.0"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding CurrentHigh, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

		<!--  전압 하한  -->
		<TextBlock
			Grid.Row="4"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="전압 하한(V)" />
		<TextBox
			Grid.Row="4"
			Grid.Column="1"
			md:HintAssist.Hint="예: 200"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding VoltageLow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

		<!--  진동 상한  -->
		<TextBlock
			Grid.Row="5"
			Grid.Column="0"
			Style="{StaticResource TextBlockTitle}"
			Text="진동 상한" />
		<TextBox
			Grid.Row="5"
			Grid.Column="1"
			md:HintAssist.Hint="예: 10"
			Style="{StaticResource TextBoxInput}"
			Text="{Binding VibrationHigh, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
	</Grid>
</UserControl>
