<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.ControllerSelectionView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  구역 소제목 / 입력 여백 (속성패널 공통 재설계 v2.9.4)  -->
		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}" />
			<Setter Property="Margin" Value="0,8,0,4" />
		</Style>
	</UserControl.Resources>

	<GroupBox
		Margin="5"
		Style="{StaticResource MaterialDesignGroupBox}"
		UseLayoutRounding="True">
		<GroupBox.Header>
			<StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
				<md:PackIcon Kind="Settings" />
				<TextBlock
					Margin="5,0"
					VerticalAlignment="Center"
					Text="제어기 속성" />
			</StackPanel>
		</GroupBox.Header>

		<!--  Row0: 속성영역(스크롤) / Row1: 적용버튼(고정)  -->
		<Grid Margin="5,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<ScrollViewer
				Grid.Row="0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="0,0,8,0">

					<!--  ===== 구역① 장비 공통 =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="장비 공통" />
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="Device No" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Margin="0,0,12,0"
							md:HintAssist.Hint="1"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="2"
							Style="{StaticResource TextBlockTitle}"
							Text="Name" />
						<TextBox
							Grid.Row="0"
							Grid.Column="3"
							Margin="0,0,12,0"
							md:HintAssist.Hint="제어기_01"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="4"
							Style="{StaticResource TextBlockTitle}"
							Text="Type" />
						<TextBox
							Grid.Row="0"
							Grid.Column="5"
							IsReadOnly="True"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding DeviceType, Mode=OneWay}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="Ver." />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="0,0,12,0"
							md:HintAssist.Hint="v1.0"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="2"
							Style="{StaticResource TextBlockTitle}"
							Text="활성화" />
						<ComboBox
							Grid.Row="1"
							Grid.Column="3"
							Margin="0,0,12,0"
							SelectedItem="{Binding IsEnable, Mode=TwoWay}"
							Style="{StaticResource ComboBoxContent}">
							<sys:Boolean>True</sys:Boolean>
							<sys:Boolean>False</sys:Boolean>
						</ComboBox>

						<TextBlock
							Grid.Row="1"
							Grid.Column="4"
							Style="{StaticResource TextBlockTitle}"
							Text="Status" />
						<ComboBox
							Grid.Row="1"
							Grid.Column="5"
							ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type enums:EnumDeviceStatus}}}"
							SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource ComboBoxContent}">
							<ComboBox.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ComboBox.ItemsPanel>
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!--  ===== 구역② 장비별 속성 =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="장비별 속성" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="IP" />
						<TextBox
							Grid.Column="1"
							Margin="0,0,12,0"
							md:HintAssist.Hint="192.168.0.10"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Column="2"
							Style="{StaticResource TextBlockTitle}"
							Text="Port" />
						<TextBox
							Grid.Column="3"
							Margin="0,0,12,0"
							md:HintAssist.Hint="9000"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
							<i:Interaction.Behaviors>
								<behavior:NumericOnlyBehavior />
							</i:Interaction.Behaviors>
						</TextBox>
					</Grid>

					<!--  ===== 구역③ 위치 정보 (Location/Lat/Lng + Alt/Bearing) =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="위치 정보" />
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" MinWidth="60" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="Location" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Margin="0,0,12,0"
							md:HintAssist.Hint="설치 위치"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="2"
							Style="{StaticResource TextBlockTitle}"
							Text="Lat" />
						<TextBox
							Grid.Row="0"
							Grid.Column="3"
							Margin="0,0,12,0"
							md:HintAssist.Hint="위도"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Latitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="4"
							Style="{StaticResource TextBlockTitle}"
							Text="Lng" />
						<TextBox
							Grid.Row="0"
							Grid.Column="5"
							md:HintAssist.Hint="경도"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Longitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource TextBlockTitle}"
							Text="Alt" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="0,0,12,0"
							md:HintAssist.Hint="고도(m)"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Altitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="2"
							Style="{StaticResource TextBlockTitle}"
							Text="Bearing" />
						<TextBox
							Grid.Row="1"
							Grid.Column="3"
							Margin="0,0,12,0"
							md:HintAssist.Hint="0~360°"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Bearing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
					</Grid>

					<!--  ===== 구역④ 그룹 (기존 세로 스크롤 ListBox 유지) =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="그룹" />
					<ListBox
						MaxHeight="80"
						BorderThickness="0"
						ItemsSource="{Binding GroupItems}"
						ScrollViewer.VerticalScrollBarVisibility="Auto">
						<i:Interaction.Behaviors>
							<behavior:BubbleMouseWheelBehavior />
						</i:Interaction.Behaviors>
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<CheckBox
									Margin="4,2"
									Content="{Binding GroupName}"
									IsChecked="{Binding IsChecked, Mode=TwoWay}"
									IsThreeState="True" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</ScrollViewer>

			<!--  ===== 고정 footer: 적용 버튼 (스크롤 밖) =====  -->
			<Border
				Grid.Row="1"
				Margin="0,4,0,0"
				Padding="0,6,0,0"
				BorderBrush="{DynamicResource MaterialDesignDivider}"
				BorderThickness="0,1,0,0">
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						x:Name="ApplyButton"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="적용" />
							</StackPanel>
						</Button.Content>
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</GroupBox>
</UserControl>
