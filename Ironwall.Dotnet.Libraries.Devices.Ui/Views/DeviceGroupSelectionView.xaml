<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.DeviceGroupSelectionView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	mc:Ignorable="d">

	<GroupBox
		Margin="5"
		Style="{StaticResource MaterialDesignGroupBox}"
		UseLayoutRounding="True">
		<GroupBox.Header>
			<StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
				<md:PackIcon Kind="Group" />
				<TextBlock
					Margin="5,0"
					VerticalAlignment="Center"
					Text="장비그룹 속성" />
			</StackPanel>
		</GroupBox.Header>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!--  Row 0: Group Properties  -->
			<Grid Grid.Row="0" Margin="5,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" MinWidth="50" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" MinWidth="50" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" MinWidth="50" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" MinWidth="50" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="2*" MinWidth="50" />
				</Grid.ColumnDefinitions>

				<!--  Row 0: Name, Description  -->

				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Style="{StaticResource TextBlockTitle}"
					Text="Name" />
				<TextBox
					Grid.Row="0"
					Grid.Column="1"
					md:HintAssist.Hint="1구역"
					Style="{StaticResource TextBoxInput}"
					Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<TextBlock
					Grid.Row="0"
					Grid.Column="2"
					Style="{StaticResource TextBlockTitle}"
					Text="Desc" />
				<TextBox
					Grid.Row="0"
					Grid.Column="3"
					Grid.ColumnSpan="3"
					md:HintAssist.Hint="설명"
					Style="{StaticResource TextBoxInput}"
					Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<!--  Row 1: Apply Button  -->

				<Button
					x:Name="ApplyButton"
					Grid.Row="1"
					Grid.Column="8"
					Grid.ColumnSpan="2"
					BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
					Style="{StaticResource MaterialDesignFlatButton}">
					<Button.Content>
						<StackPanel Orientation="Horizontal">
							<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
							<TextBlock Style="{StaticResource ButtonTextBlock}" Text="적용" />
						</StackPanel>
					</Button.Content>
				</Button>
			</Grid>

			<!--  Row 1: Assigned Devices (단일 선택 시만 표시)  -->
			<Grid
				Grid.Row="1"
				Margin="5,8,5,0"
				Visibility="{Binding IsSingleSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  Section Header  -->
				<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
					<md:PackIcon Kind="DevicesOther" VerticalAlignment="Center" />
					<TextBlock
						Margin="4,0,0,0"
						VerticalAlignment="Center"
						FontWeight="SemiBold"
						Text="소속 장비" />
				</StackPanel>

				<!--  Device List  -->
				<DataGrid
					Grid.Row="1"
					AutoGenerateColumns="False"
					CanUserAddRows="False"
					CanUserDeleteRows="False"
					IsReadOnly="True"
					ItemsSource="{Binding AssignedDevices}"
					SelectionMode="Single"
					Style="{StaticResource MaterialDesignDataGrid}">
					<DataGrid.Columns>
						<DataGridTextColumn
							Binding="{Binding DeviceNumber}"
							Header="번호"
							IsReadOnly="True"
							Width="60" />
						<DataGridTextColumn
							Binding="{Binding DeviceName}"
							Header="장비명"
							IsReadOnly="True"
							Width="*" />
						<DataGridTextColumn
							Binding="{Binding DeviceType}"
							Header="유형"
							IsReadOnly="True"
							Width="110" />
						<DataGridTemplateColumn Header="제거" Width="70">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button
										HorizontalAlignment="Center"
										cal:Message.Attach="RemoveDeviceButton($dataContext)"
										Content="제거"
										Style="{StaticResource MaterialDesignOutlinedButton}"
										FontSize="11"
										Padding="4,2" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<!--  Add Button  -->
				<StackPanel
					Grid.Row="2"
					Margin="0,6,0,0"
					HorizontalAlignment="Right"
					Orientation="Horizontal">
					<Button
						cal:Message.Attach="AddDeviceButton"
						Style="{StaticResource MaterialDesignRaisedButton}">
						<StackPanel Orientation="Horizontal">
							<md:PackIcon Kind="Plus" VerticalAlignment="Center" />
							<TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="추가" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Grid>
	</GroupBox>
</UserControl>
