<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.Dashboards.DeviceDashboardView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Views.Dashboards"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<UserControl.Resources>

		<Style
			x:Key="NameText"
			BasedOn="{StaticResource MaterialDesignTextBlock}"
			TargetType="TextBlock">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Foreground" Value="#E1E1E1" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Margin" Value="10,4" />
		</Style>

		<Style x:Key="NameCard" TargetType="{x:Type md:Card}">
			<Setter Property="Background" Value="#FF8E00" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="8" />
		</Style>

	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="280" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--
			서버 판본 미확정 배너 (device-console-v8 FR-07).
			판본 확인에 실패하면 클라는 안전한 쪽(6.3)으로 동작한다 — 서버가 실제로는 7.0+ 이면 장비가 0건처럼 보이는데
			화면은 아무 말이 없었다. 그 사실을 드러내고 [다시 확인] 을 준다.
			평소(확정·프로브 없음)에는 Collapsed — Auto 행이라 높이 0, 옛 화면 배치와 픽셀 단위로 같다.
			색이 아니라 형태(좌측 세로 바 + 아이콘)로도 구분한다.
		-->
		<Border
			Grid.Row="0"
			Margin="5,5,5,0"
			Padding="0"
			AutomationProperties.AutomationId="Devices.Dashboard.ProbeBanner"
			Background="{DynamicResource TintWarningBrush}"
			BorderBrush="{DynamicResource StatusWarningBrush}"
			BorderThickness="4,1,1,1"
			CornerRadius="4"
			Visibility="{Binding ContractGate.IsProbeFallback, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
			<DockPanel Margin="10,6" LastChildFill="True">
				<Button
					Margin="10,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Dashboard.ProbeBanner.RefreshButton"
					Content="다시 확인"
					DockPanel.Dock="Right"
					IsEnabled="{Binding ContractGate.CanRefreshContract}"
					Style="{StaticResource MaterialDesignOutlinedButton}">
					<i:Interaction.Behaviors>
						<behavior:ButtonClickBehavior MethodName="OnClickRefreshContract" />
					</i:Interaction.Behaviors>
				</Button>
				<md:PackIcon
					Width="20"
					Height="20"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					Foreground="{DynamicResource StatusWarningBrush}"
					Kind="AlertOutline" />
				<TextBlock
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Devices.Dashboard.ProbeBanner.Text"
					Foreground="{DynamicResource TextPrimaryBrush}"
					TextWrapping="Wrap">
					<Run Text="서버 판본을 확인하지 못했습니다 — 옛 화면(" /><Run Text="{Binding ContractGate.ContractText, Mode=OneWay}" /><Run Text=")으로 표시 중입니다. 서버가 새 판본이면 장비 목록이 비어 보일 수 있습니다." />
				</TextBlock>
			</DockPanel>
		</Border>

