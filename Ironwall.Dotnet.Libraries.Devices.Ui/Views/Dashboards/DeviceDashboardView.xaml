		<TabControl
			Grid.Row="2"
			Height="390"
			Margin="-15,0,15,0"
			HorizontalAlignment="Stretch"
			cal:Message.Attach="[Event SelectionChanged] = [Action OnActiveTab($source, $eventArgs)]"
			md:NavigationRailAssist.ShowSelectionBackground="True"
			Background="{Binding Path=Background, RelativeSource={RelativeSource AncestorType=UserControl}}"
			Style="{StaticResource MaterialDesignNavigationRailTabControl}"
			TabStripPlacement="Left">
			<TabControl.Template>
				<ControlTemplate TargetType="TabControl">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<ScrollViewer
							Height="350"
							VerticalAlignment="Top"
							FlowDirection="LeftToRight"
							HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Auto">
							<TabPanel
								x:Name="HeaderPanel"
								Width="100"
								Margin="25,0,-5,0"
								VerticalAlignment="Stretch"
								Panel.ZIndex="0"
								IsItemsHost="true"
								KeyboardNavigation.TabIndex="1" />
						</ScrollViewer>
						<ContentPresenter
							x:Name="PART_SelectedContentHost"
							Grid.Column="1"
							ContentSource="SelectedContent"
							SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
					</Grid>
