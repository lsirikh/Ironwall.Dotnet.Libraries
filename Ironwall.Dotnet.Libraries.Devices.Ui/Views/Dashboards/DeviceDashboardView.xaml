<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.Dashboards.DeviceDashboardView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:bycomponent="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.ByComponent"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:forms="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles.Forms"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Views.Dashboards"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:consoles="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Consoles"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		장비 콘솔(device-console-redesign) — 레일 · 목록 · 상세 3단. 정본 목업:
		docs/design/window-layout-system-storyboard.html · gop-api-v8-console-wireframe.html · all-windows-drag-wireframe.html
		치수(헤더 40 · 레일 184/56 · 툴바 48 · 행 38 · 상태 띠 30 · 상세 340)와 폭별 도킹/서랍/접힘은 ConsoleShell 이 맡는다.
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationId 만.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibility" />
		<local:PackIconKindConverter x:Key="IconKind" />

		<Style x:Key="GroupChip" TargetType="Border">
			<Setter Property="Padding" Value="10,3" />
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>
	</UserControl.Resources>

	<!--
		U-17 — 콘솔 머리가 늘 이 뷰의 맨 위에 선다. 서버 판본 배너는 목록 칸 맨 위로 옮겼다 — 전에는 콘솔 위(뷰 맨 위)에 떠서,
		호스트가 콘솔 머리 오른쪽 끝에 겹쳐 두는 닫기 ✕(시안 카드 머리를 걷어 낸 자리)와 배너의 [다시 확인] 이 부딪혔다.
	-->
	<DockPanel ClipToBounds="True" LastChildFill="True">
		<c:ConsoleShell
			Title="장비"
			ConsoleKey="Devices"
			IsDetailRequested="{Binding Detail.IsDetailRequested}"
			Loaded="OnShellLoaded"
			Subtitle="{Binding Detail.TypeName}">

			<!--  레일 — 그룹 + 7 카테고리(+ 부품으로 찾기). 배지 = 합계, 장애가 있으면 ▲n · 합계  -->
			<c:ConsoleShell.Rail>
				<c:ConsoleRail
					AutomationProperties.AutomationId="Console.Devices.Rail"
					ConsoleKey="Devices"
					IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
					ItemsSource="{Binding RailEntries}"
					SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
					<c:ConsoleRail.Resources>
						<!--  레일 항목의 Icon 은 아이콘 이름을 쥔 토큰이다 — 싱글턴 뷰모델이 시각 요소를 쥐지 않게 여기서 그린다  -->
						<DataTemplate DataType="{x:Type consoles:ConsoleIconToken}">
							<md:PackIcon
								Width="18"
								Height="18"
								Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
						</DataTemplate>
					</c:ConsoleRail.Resources>
					<c:ConsoleRail.Footer>
						<TextBlock
							AutomationProperties.AutomationId="Console.Devices.Rail.Footer"
							FontSize="12.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding RailFooterText}"
							TextWrapping="Wrap" />
					</c:ConsoleRail.Footer>
				</c:ConsoleRail>
			</c:ConsoleShell.Rail>

			<!--  툴바 — [추가] · [삭제] · [갱신] · 검색 · [열 n/m]. 패널마다 있던 [저장] 은 없다(상세 칸의 [적용] 이 저장이다)  -->
			<c:ConsoleShell.Toolbar>
				<c:ConsoleToolbar
					AddClick="OnAdd"
					AddDisabledReason="{Binding AddBlockedReason}"
					CanAdd="{Binding CanAdd}"
					CanDelete="{Binding CanDelete}"
					CanRefresh="{Binding CanReload}"
					ColumnsClick="OnColumns"
					ConsoleKey="Devices"
					DeleteClick="OnDelete"
					DeleteDisabledReason="{Binding DeleteBlockedReason}"
					Loaded="OnToolbarLoaded"
					RefreshClick="OnReload"
					SearchPlaceholder="장비번호 · 이름 검색"
					SearchText="{Binding SearchText, Mode=TwoWay}"
					ShowSearch="{Binding IsListVisible}">
					<!--  조립기 · 프리셋 입구 — 부품 모델이 있는 서버(7.0+)에서만 보인다  -->
					<c:ConsoleToolbar.Extra>
						<StackPanel Orientation="Horizontal">
						<!--  장비 배정 창(N-05) — 그룹 레일에서 그룹 하나를 골랐을 때만 눌린다. 6.3 서버에서도 쓴다.  -->
						<Button
							Margin="0,0,8,0"
							AutomationProperties.AutomationId="Console.Devices.Toolbar.Assign"
							Click="OnOpenDeviceAssign"
							Content="장비 배정"
							IsEnabled="{Binding CanOpenAssign}"
							Style="{StaticResource Console.Button}"
							ToolTip="{Binding AssignBlockedReason}"
							ToolTipService.ShowOnDisabled="True"
							Visibility="{Binding IsGroupsRail, Converter={StaticResource BoolToVisibility}}" />
						<StackPanel Orientation="Horizontal" Visibility="{Binding CanAssemble, Converter={StaticResource BoolToVisibility}}">
							<Button
								Margin="0,0,8,0"
								AutomationProperties.AutomationId="Console.Devices.Toolbar.Assembly"
								Click="OnOpenAssembly"
								Content="조립기"
								Style="{StaticResource Console.Button}"
								ToolTip="부품을 조립해 장비를 만들거나 프리셋으로 저장합니다" />
							<Button
								Margin="0,0,8,0"
								AutomationProperties.AutomationId="Console.Devices.Toolbar.RegisterFromPreset"
								Click="OnRegisterFromPreset"
								Content="프리셋으로 등록"
								Style="{StaticResource Console.Button}"
								ToolTip="프리셋을 고르고 번호 · 이름 · 접속만 넣으면 부품까지 한 번에 등록합니다" />
							<Button
								Margin="0,0,8,0"
								AutomationProperties.AutomationId="Console.Devices.Toolbar.Presets"
								Click="OnManagePresets"
								Content="프리셋 관리"
								Style="{StaticResource Console.Button}"
								ToolTip="저장한 프리셋을 보고 이름을 바꾸거나 지웁니다" />
							<!--
								셋업 · 결선(N-04) — 제어기 목록에서만 보인다(다른 레일에서는 늘 꺼진 채 자리만 차지해 툴바 끝을 잘랐다).
								제어기 한 대를 골랐을 때만 눌리고, 아니면 툴팁이 까닭을 말한다. 폭이 모자라면 커널 툴바가 Extra 묶음을 [⋯] 로 옮긴다.
							-->
							<Button
								AutomationProperties.AutomationId="Console.Devices.Toolbar.Wiring"
								Click="OnOpenWiring"
								Content="셋업 · 결선"
								IsEnabled="{Binding CanOpenWiring}"
								Style="{StaticResource Console.Button}"
								ToolTip="{Binding WiringBlockedReason}"
								ToolTipService.ShowOnDisabled="True"
								Visibility="{Binding IsWiringVisible, Converter={StaticResource BoolToVisibility}}" />
						</StackPanel>
						</StackPanel>
					</c:ConsoleToolbar.Extra>
				</c:ConsoleToolbar>
			</c:ConsoleShell.Toolbar>

			<c:ConsoleShell.List>
				<Grid ClipToBounds="True">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--
						서버 판본을 끝내 확인하지 못해 6.3 으로 폴백했을 때만 뜬다.
						색이 아니라 형태(좌측 세로 바 + 아이콘)로도 구분한다.
					-->
					<Border
						Margin="8,8,8,4"
						AutomationProperties.AutomationId="Devices.Dashboard.ProbeBanner"
						Background="{DynamicResource TintWarningBrush}"
						BorderBrush="{DynamicResource StatusWarningBrush}"
						BorderThickness="4,1,1,1"
						CornerRadius="4"
						Visibility="{Binding ContractGate.IsProbeFallback, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
						<DockPanel Margin="10,6" LastChildFill="True">
							<Button
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								AutomationProperties.AutomationId="Devices.Dashboard.ProbeBanner.RefreshButton"
								Click="OnRefreshContract"
								Content="다시 확인"
								DockPanel.Dock="Right"
								IsEnabled="{Binding ContractGate.CanRefreshContract}"
								Style="{StaticResource Console.Button}" />
							<md:PackIcon
								Width="20"
								Height="20"
								Margin="0,0,8,0"
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								Foreground="{DynamicResource StatusWarningBrush}"
								Kind="AlertOutline" />
							<TextBlock
								VerticalAlignment="Center"
								AutomationProperties.AutomationId="Devices.Dashboard.ProbeBanner.Text"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="서버 버전을 확인하지 못해 기본 화면으로 표시합니다. 목록이 비어 보이면 [다시 확인]을 누르세요."
								TextWrapping="Wrap"
								ToolTip="{Binding ContractGate.ContractText, Mode=OneWay}" />
						</DockPanel>
					</Border>

					<DataGrid
						Grid.Row="1"
						AutomationProperties.AutomationId="Console.Devices.Grid"
						IsReadOnly="True"
						ItemsSource="{Binding Rows}"
						Loaded="OnGridLoaded"
						SelectionChanged="OnGridSelectionChanged"
						Style="{StaticResource Console.DataGrid}"
						Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}">
						<!--  행마다 Id — 자동화가 "방금 만든 행"을 짚을 수 있어야 삭제 안전 계약(자기가 만든 행만)을 지킬 수 있다  -->
						<DataGrid.RowStyle>
							<Style BasedOn="{StaticResource Console.DataGrid.Row}" TargetType="DataGridRow">
								<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Console.Devices.Row.{0}}" />
								<!--  화면 낭독기가 형식 이름 대신 장비 이름(그룹이면 그룹 이름)을 읽게 한다  -->
								<Setter Property="AutomationProperties.Name">
									<Setter.Value>
										<PriorityBinding>
											<Binding Path="DeviceName" />
											<Binding Path="Name" />
										</PriorityBinding>
									</Setter.Value>
								</Setter>
							</Style>
						</DataGrid.RowStyle>
						<b:Interaction.Behaviors>
							<!--  장비 N건 → 그룹 칩. 같은 일은 아래 칩을 눌러서도 된다(키보드 폴백)  -->
							<drag:CaptureDragBehavior
								DisplayMemberPath="DeviceName"
								Handler="{Binding GroupDrop}"
								IsDragEnabled="{Binding CanDragToGroup}"
								KeyboardFallback="행을 고른 뒤 아래 그룹 칩을 누르세요" />
						</b:Interaction.Behaviors>
					</DataGrid>

					<!--  빈 목록 — 무엇이 비었고 무엇을 하면 되는지(커널 ConsoleEmptyState). 첫 읽기 중에는 띄우지 않는다.  -->
					<c:ConsoleEmptyState
						Grid.Row="1"
						AutomationProperties.AutomationId="Console.Devices.Empty"
						Glyph="M4,6 H20 M4,12 H20 M4,18 H14"
						Hint="{Binding EmptyHint}"
						IsHitTestVisible="False"
						Title="{Binding EmptyTitle}"
						Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}" />

					<!--  부품으로 찾기 — 축 계약에서만 레일에 나온다  -->
					<ContentControl
						Grid.Row="1"
						Content="{Binding ByComponent}"
						Focusable="False"
						Visibility="{Binding IsByComponent, Converter={StaticResource BoolToVisibility}}">
						<ContentControl.ContentTemplate>
							<DataTemplate>
								<bycomponent:ByComponentView />
							</DataTemplate>
						</ContentControl.ContentTemplate>
					</ContentControl>
				</Grid>
			</c:ConsoleShell.List>

			<!--  상태 띠 — 건수 + 놓을 곳(그룹 칩) + 방금 한 일 한 줄  -->
			<c:ConsoleShell.StatusBar>
				<Border
					Padding="12,5"
					Background="{DynamicResource SurfaceAltBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,1,0,0">
					<StackPanel>
						<DockPanel LastChildFill="True">
							<Button
								Margin="8,0,0,0"
								Padding="8,1"
								AutomationProperties.AutomationId="Console.Devices.GroupDrop.Undo"
								Click="OnUndoGroupDrop"
								Content="되돌리기"
								DockPanel.Dock="Right"
								FontSize="12"
								Style="{StaticResource Console.Button.Ghost}"
								Visibility="{Binding CanUndoGroupDrop, Converter={StaticResource BoolToVisibility}}" />
							<TextBlock
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								AutomationProperties.AutomationId="Console.Devices.Status.Message"
								DockPanel.Dock="Right"
								FontSize="12"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{Binding StatusText}"
								TextTrimming="CharacterEllipsis"
								ToolTip="{Binding StatusText}" />
							<TextBlock
								VerticalAlignment="Center"
								AutomationProperties.AutomationId="Console.Devices.Status.Count"
								FontSize="12"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{Binding ListStatusText}" />
						</DockPanel>

						<!--  놓을 곳 — 끄는 동안 DropZoneChrome 이 형태로 가능 · 불가 · 호버를 보인다. 접어서 숨기지 않는다(끄는 중에 생기는 존은 못 잡는다)  -->
						<DockPanel
							Margin="0,5,0,0"
							LastChildFill="True"
							Visibility="{Binding CanDragToGroup, Converter={StaticResource BoolToVisibility}}">
							<TextBlock
								Width="44"
								Margin="0,4,0,0"
								VerticalAlignment="Top"
								DockPanel.Dock="Left"
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="그룹" />
							<Grid>
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="그룹이 없습니다 — 왼쪽 '그룹'에서 먼저 만드세요">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding HasGroupChips}" Value="False">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<!--  칩은 한 줄로 두고 넘치면 가로로 굴린다 — 그룹이 많아도 상태 띠가 두세 줄로 불어 목록을 밀어 올리지 않는다  -->
								<ScrollViewer
									Focusable="False"
									HorizontalScrollBarVisibility="Auto"
									VerticalScrollBarVisibility="Disabled">
								<ItemsControl
									Focusable="False"
									ItemsSource="{Binding GroupChips}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<drag:DropZoneChrome
												Margin="0,2,6,2"
												drag:DropZone.Data="{Binding}"
												drag:DropZone.Handler="{Binding DataContext.GroupDrop, RelativeSource={RelativeSource AncestorType=UserControl}}"
												drag:DropZone.Key="device-group"
												CornerRadius="12">
												<!--  칩은 버튼이기도 하다 — 고른 장비를 이 그룹에 넣는다(끌기의 키보드 폴백)  -->
												<Button
													Padding="0"
													AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Devices.GroupChip.{0}}"
													Background="Transparent"
													BorderThickness="0"
													Click="OnGroupChipClick"
													Cursor="Hand"
													Style="{x:Null}"
													AutomationProperties.Name="{Binding Name}"
													ToolTip="선택한 장비를 이 그룹에 넣습니다 (행 손잡이를 끌어 놓아도 됩니다)">
													<Button.Template>
														<ControlTemplate TargetType="Button">
															<Border Style="{StaticResource GroupChip}">
																<TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
																	<Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeviceCount, Mode=OneWay}" />
																</TextBlock>
															</Border>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</drag:DropZoneChrome>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								</ScrollViewer>
							</Grid>
						</DockPanel>
					</StackPanel>
				</Border>
			</c:ConsoleShell.StatusBar>

			<!--  상세 — 명세에서 만들어지는 폼 + 고정 적용 막대(여섯 상태)  -->
			<c:ConsoleShell.Detail>
				<c:ConsoleDetailHost
					ApplyClick="OnApply"
					ApplyText="{Binding Detail.ApplyText}"
					Banner="{Binding Detail.Banner}"
					CanApply="{Binding Detail.CanApply}"
					CanRevert="{Binding Detail.CanRevert}"
					ConsoleKey="Devices"
					DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
					FooterText="{Binding Detail.FooterText}"
					IsDirty="{Binding Detail.IsDirty}"
					IsReadOnly="{Binding Detail.IsReadOnly}"
					Kind="{Binding Detail.Kind}"
					RevertClick="OnRevert"
					RevertText="{Binding Detail.RevertText}"
					ShakeToken="{Binding Detail.ShakeToken}"
					ShowButtons="{Binding Detail.ShowButtons}"
					ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
					Title="{Binding Detail.Title}">
					<StackPanel>
						<!--  카메라 상세보기(6.3 서버) — 카메라 설정 · 링크 창. 7.0 이상은 같은 값을 아래 칸에서 바로 고친다  -->
						<Button
							Margin="0,6,0,0"
							HorizontalAlignment="Left"
							AutomationProperties.AutomationId="Console.Devices.Detail.CameraDetail"
							Click="OnOpenCameraDetail"
							Content="상세보기"
							IsEnabled="{Binding CanOpenCameraDetail}"
							Style="{StaticResource Console.Button}"
							ToolTip="카메라 설정과 링크를 확인하고 바꿉니다"
							Visibility="{Binding IsCameraDetailVisible, Converter={StaticResource BoolToVisibility}}" />
						<!--  부품은 폼에서 못 고친다(서버가 배열을 통째로 바꾼다) — 조립기로 보낸다  -->
						<Button
							Margin="0,6,0,0"
							HorizontalAlignment="Left"
							AutomationProperties.AutomationId="Console.Devices.Detail.EditComponents"
							Click="OnEditComponents"
							Content="부품 구성 바꾸기 (조립기)"
							Style="{StaticResource Console.Button}"
							Visibility="{Binding CanEditComponents, Converter={StaticResource BoolToVisibility}}" />
						<forms:DevicePropertyFormView DataContext="{Binding Form}" />
					</StackPanel>
				</c:ConsoleDetailHost>
			</c:ConsoleShell.Detail>
		</c:ConsoleShell>
	</DockPanel>
</UserControl>
