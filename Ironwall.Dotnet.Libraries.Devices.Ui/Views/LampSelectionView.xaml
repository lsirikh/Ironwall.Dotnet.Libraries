<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Devices.Ui.Views.LampSelectionView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Devices.Ui.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  구역 소제목 / 입력 여백 (속성패널 공통 재설계 v2.9.4)  -->
		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkBrush}" />
			<Setter Property="Margin" Value="0,8,0,4" />
		</Style>
		<!--  필드 라벨/입력 고정 크기 + 라벨-값 여백 (v2.9.5)  -->
		<Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockTitle}">
			<Setter Property="Width" Value="72" />
			<Setter Property="Margin" Value="0,0,10,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxInput}">
			<Setter Property="Width" Value="170" />
			<Setter Property="Margin" Value="0,0,20,0" />
			<Setter Property="HorizontalAlignment" Value="Left" />
		</Style>
		<Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxContent}">
			<Setter Property="Width" Value="170" />
			<Setter Property="Margin" Value="0,0,20,0" />
			<Setter Property="HorizontalAlignment" Value="Left" />
		</Style>
	</UserControl.Resources>

	<GroupBox
		Margin="5"
		Style="{StaticResource MaterialDesignGroupBox}"
		UseLayoutRounding="True">
		<GroupBox.Header>
			<StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
				<md:PackIcon Kind="Settings" />
				<TextBlock
					Margin="5,0"
					VerticalAlignment="Center"
					Text="경광등 속성" />
			</StackPanel>
		</GroupBox.Header>

		<!--  Row0: 속성영역(스크롤) / Row1: 적용버튼(고정)  -->
		<Grid Margin="5,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<ScrollViewer
				Grid.Row="0"
				HorizontalScrollBarVisibility="Disabled"
				VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="0,0,8,0">

					<!--  ===== 구역① 장비 공통 =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="장비 공통" />
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource FieldLabel}"
							Text="Device No" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							md:HintAssist.Hint="1"
							Style="{StaticResource FieldBox}"
							Text="{Binding DeviceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="2"
							Style="{StaticResource FieldLabel}"
							Text="Name" />
						<TextBox
							Grid.Row="0"
							Grid.Column="3"
							md:HintAssist.Hint="경광등_01"
							Style="{StaticResource FieldBox}"
							Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="4"
							Style="{StaticResource FieldLabel}"
							Text="Ver." />
						<TextBox
							Grid.Row="0"
							Grid.Column="5"
							md:HintAssist.Hint="v1.0"
							Style="{StaticResource FieldBox}"
							Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource FieldLabel}"
							Text="활성화" />
						<ComboBox
							Grid.Row="1"
							Grid.Column="1"
							SelectedItem="{Binding IsEnable, Mode=TwoWay}"
							Style="{StaticResource FieldCombo}">
							<sys:Boolean>True</sys:Boolean>
							<sys:Boolean>False</sys:Boolean>
						</ComboBox>

						<TextBlock
							Grid.Row="1"
							Grid.Column="2"
							Style="{StaticResource FieldLabel}"
							Text="Status" />
						<ComboBox
							Grid.Row="1"
							Grid.Column="3"
							ItemsSource="{Binding Source={utils:EnumBindingSource {x:Type enums:EnumDeviceStatus}}}"
							SelectedItem="{Binding Status, Mode=TwoWay}"
							Style="{StaticResource FieldCombo}">
							<ComboBox.ItemsPanel>
								<ItemsPanelTemplate>
									<VirtualizingStackPanel />
								</ItemsPanelTemplate>
							</ComboBox.ItemsPanel>
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!--  ===== 구역② 장비별 속성 =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="장비별 속성" />
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource FieldLabel}"
							Text="IP" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							md:HintAssist.Hint="192.168.0.10"
							Style="{StaticResource FieldBox}"
							Text="{Binding IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="2"
							Style="{StaticResource FieldLabel}"
							Text="Port" />
						<TextBox
							Grid.Row="0"
							Grid.Column="3"
							md:HintAssist.Hint="9000"
							Style="{StaticResource FieldBox}"
							Text="{Binding IpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
							<i:Interaction.Behaviors>
								<behavior:NumericOnlyBehavior />
							</i:Interaction.Behaviors>
						</TextBox>

						<TextBlock
							Grid.Row="0"
							Grid.Column="4"
							Style="{StaticResource FieldLabel}"
							Text="User" />
						<TextBox
							Grid.Row="0"
							Grid.Column="5"
							md:HintAssist.Hint="admin"
							Style="{StaticResource FieldBox}"
							Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource FieldLabel}"
							Text="PW" />
						<PasswordBox
							Grid.Row="1"
							Grid.Column="1"
							Width="170"
							Margin="0,0,20,0"
							HorizontalAlignment="Left"
							PasswordChar="*"
							Style="{StaticResource PasswordBoxInput}">
							<i:Interaction.Behaviors>
								<behavior:PasswordBehavior Password="{Binding UserPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</i:Interaction.Behaviors>
						</PasswordBox>

						<TextBlock
							Grid.Row="1"
							Grid.Column="2"
							Style="{StaticResource FieldLabel}"
							Text="Desc" />
						<TextBox
							Grid.Row="1"
							Grid.Column="3"
							md:HintAssist.Hint="설명"
							Style="{StaticResource FieldBox}"
							Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					</Grid>

					<!--  ===== 구역③ 위치 정보 (Location/Lat/Lng + Alt/Bearing) =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="위치 정보" />
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Style="{StaticResource FieldLabel}"
							Text="Location" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							md:HintAssist.Hint="설치 위치"
							Style="{StaticResource FieldBox}"
							Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="2"
							Style="{StaticResource FieldLabel}"
							Text="Lat" />
						<TextBox
							Grid.Row="0"
							Grid.Column="3"
							md:HintAssist.Hint="위도"
							Style="{StaticResource FieldBox}"
							Text="{Binding Latitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

						<TextBlock
							Grid.Row="0"
							Grid.Column="4"
							Style="{StaticResource FieldLabel}"
							Text="Lng" />
						<TextBox
							Grid.Row="0"
							Grid.Column="5"
							md:HintAssist.Hint="경도"
							Style="{StaticResource FieldBox}"
							Text="{Binding Longitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Style="{StaticResource FieldLabel}"
							Text="Alt" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							md:HintAssist.Hint="고도(m)"
							Style="{StaticResource FieldBox}"
							Text="{Binding Altitude, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

						<TextBlock
							Grid.Row="1"
							Grid.Column="2"
							Style="{StaticResource FieldLabel}"
							Text="Bearing" />
						<TextBox
							Grid.Row="1"
							Grid.Column="3"
							md:HintAssist.Hint="0~360°"
							Style="{StaticResource FieldBox}"
							Text="{Binding Bearing, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
					</Grid>

					<!--  ===== 구역④ 그룹 (기존 세로 스크롤 ListBox 유지) =====  -->
					<TextBlock Style="{StaticResource SectionTitle}" Text="그룹" />
					<ListBox
						MaxHeight="80"
						BorderThickness="0"
						ItemsSource="{Binding GroupItems}"
						ScrollViewer.VerticalScrollBarVisibility="Auto">
						<i:Interaction.Behaviors>
							<behavior:BubbleMouseWheelBehavior />
						</i:Interaction.Behaviors>
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<CheckBox
									Margin="4,2"
									Content="{Binding GroupName}"
									IsChecked="{Binding IsChecked, Mode=TwoWay}"
									IsThreeState="True" />
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</StackPanel>
			</ScrollViewer>

			<!--  ===== 고정 footer: 적용 버튼 (스크롤 밖) =====  -->
			<Border
				Grid.Row="1"
				Margin="0,4,0,0"
				Padding="0,6,0,0"
				BorderBrush="{DynamicResource MaterialDesignDivider}"
				BorderThickness="0,1,0,0">
				<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
					<Button
						x:Name="ApplyButton"
						BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
						Style="{StaticResource MaterialDesignFlatButton}">
						<Button.Content>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
								<TextBlock Style="{StaticResource ButtonTextBlock}" Text="적용" />
							</StackPanel>
						</Button.Content>
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</GroupBox>
</UserControl>
