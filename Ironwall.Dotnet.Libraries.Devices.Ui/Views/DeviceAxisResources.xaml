<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!--  Shared by DeviceAxisHeadView / DeviceAxisTailView (device-console-v8 FR-11)  -->
	<Style x:Key="AxisTitle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Margin" Value="0,14,0,6" />
	</Style>
	<Style x:Key="AxisReadOnlyTag" TargetType="TextBlock">
		<Setter Property="FontSize" Value="10" />
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="Margin" Value="8,14,0,6" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Text" Value="읽기 전용" />
	</Style>
	<Style x:Key="AxisCell" TargetType="TextBlock">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Margin" Value="0,2,12,2" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>
	<Style x:Key="AxisCellMuted" BasedOn="{StaticResource AxisCell}" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
	</Style>

	<!--  이름 — 값 줄 목록  -->
	<DataTemplate x:Key="AxisRowTemplate">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="150" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock Grid.Column="0" Style="{StaticResource AxisCellMuted}" Text="{Binding Label}" />
			<TextBlock Grid.Column="1" Style="{StaticResource AxisCell}" Text="{Binding Value}" TextWrapping="Wrap" />
		</Grid>
	</DataTemplate>

	<!--  절 본문: 값 있음 → 줄 목록 / 빈 값 → 안내 글자 / 미수신 → 파선 박스  -->
	<ControlTemplate x:Key="AxisSectionBody" TargetType="ContentControl">
		<Grid>
			<ItemsControl
				ItemTemplate="{StaticResource AxisRowTemplate}"
				ItemsSource="{Binding Rows}"
				Visibility="{Binding IsPresent, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<TextBlock
				Style="{StaticResource AxisCellMuted}"
				Text="{Binding Notice}"
				Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
			<Grid Visibility="{Binding IsNotReceived, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Rectangle
					RadiusX="4"
					RadiusY="4"
					Stroke="{DynamicResource DividerBrush}"
					StrokeDashArray="3 3"
					StrokeThickness="1" />
				<TextBlock
					Margin="10,8"
					Style="{StaticResource AxisCellMuted}"
					Text="{Binding Notice}" />
			</Grid>
		</Grid>
	</ControlTemplate>
</ResourceDictionary>
