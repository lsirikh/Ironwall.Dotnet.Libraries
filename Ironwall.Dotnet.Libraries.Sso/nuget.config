<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Sso.Client.Sdk 는 공개 피드에 없다 — 리포에 고정한 사내 배포본을 쓴다(third_party/sso/README.md). -->
    <add key="sso-vendored" value="..\third_party\sso" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="sso-vendored">
      <package pattern="Sso.Client.Sdk" />
    </packageSource>
  </packageSourceMapping>
</configuration>
