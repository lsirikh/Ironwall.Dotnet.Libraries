<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dialogs.DetectionHistoryDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:controls="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Controls"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:DesignHeight="640"
	d:DesignWidth="880"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">

	<!--
		탐지 신호 이력 다이얼로그 콘텐츠 (Detection_Signal_History FR-09).
		호스팅(md:DialogHost + md:Card 880×640)은 메인솔루션 래퍼(DetectionHistoryHostDialogView)가 담당 —
		기존 DetectionEventDialogView 패턴 미러. 색상은 전부 DynamicResource 토큰(NFR-01 다크/라이트).
	-->

	<UserControl.Resources>
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<converters:SignalBarWidthConverter x:Key="SignalBarWidthConverter" />
		<converters:SignalIsMaxConverter x:Key="SignalIsMaxConverter" />
		<converters:EnumToKoreanConverter x:Key="EnumToKoreanConverter" />

		<!--
			기간 세그먼트 버튼 · 필터 칩(전체 · 컴팩트) — 선택 시 primary 채움/외곽 + Bold.
			U-12/U-13 — 세 스타일 다 IsChecked 에서 FontWeight="Bold" 만 얹고 폭을 예약하지 않아
			고를 때마다 폭이 흔들렸다. 이 다이얼로그는 세그먼트(선 없는 pill) · 일반 칩(반경 20) ·
			컴팩트 칩(반경 16, 사용자 피드백으로 좁힌 밀도)이 서로 다른 시각 언어라 커널 Console.Chip
			(반경 11)로 통합하지 않고, 같은 예약 기법(숨은 Bold 고스트를 같은 칸에 겹친다)만 로컬에
			그대로 적용한다 — "칩이 하는 일"은 바꾸지 않고 "잰 폭"만 고정한다.
		-->
		<Style x:Key="PeriodSegButton" TargetType="RadioButton">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border
							x:Name="Bd"
							Padding="12,5"
							Background="Transparent">
							<Grid>
								<ContentPresenter
									x:Name="Ghost"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									IsHitTestVisible="False"
									Opacity="0"
									TextElement.FontWeight="Bold" />
								<ContentPresenter
									x:Name="Cp"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
								<Setter TargetName="Cp" Property="TextElement.FontWeight" Value="Bold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  필터 칩 토글 — on 시 primary 틴트 외곽  -->
		<Style x:Key="FilterChip" TargetType="ToggleButton">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="0,0,4,4" /><!-- WrapPanel 줄바꿈 대응(우/하 간격) — 툴바 잘림 수정 -->
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border
							x:Name="Bd"
							Padding="11,3"
							Background="Transparent"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="20">
							<Grid>
								<ContentPresenter
									x:Name="Ghost"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									IsHitTestVisible="False"
									Opacity="0"
									TextElement.FontWeight="Bold" />
								<ContentPresenter
									x:Name="Cp"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintAccentBrush}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
								<Setter TargetName="Cp" Property="TextElement.FontWeight" Value="Bold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  센서 칩 컴팩트 변형(그룹 모드 전용) — 센서가 많아도 한 줄에 더 많이, 그리드 높이 잠식 최소화(사용자 피드백)  -->
		<Style x:Key="FilterChipCompact" TargetType="ToggleButton">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="FontSize" Value="10.5" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="0,0,4,3" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border
							x:Name="Bd"
							Padding="7,1.5"
							Background="Transparent"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="16">
							<Grid>
								<ContentPresenter
									x:Name="Ghost"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									IsHitTestVisible="False"
									Opacity="0"
									TextElement.FontWeight="Bold" />
								<ContentPresenter
									x:Name="Cp"
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintAccentBrush}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
								<Setter TargetName="Cp" Property="TextElement.FontWeight" Value="Bold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Background="{DynamicResource SurfaceBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ① 시안 헤더 (ModernDialogHeader 표준) — 닫기=우상단 ✕ (디자인 패턴, 런타임 피드백)  -->
		<Border Grid.Row="0" Style="{StaticResource ModernDialogHeader}">
			<DockPanel LastChildFill="True">
				<Button
					x:Name="CloseDialog"
					Width="26"
					Height="26"
					VerticalAlignment="Center"
					Cursor="Hand"
					DockPanel.Dock="Right"
					Style="{x:Null}"
					ToolTip="닫기">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border
								x:Name="Bd"
								Background="Transparent"
								CornerRadius="13">
								<md:PackIcon
									Width="15"
									Height="15"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Kind="Close" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<md:PackIcon
						Width="20"
						Height="20"
						Margin="0,0,8,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource OnPrimaryFixedBrush}"
						Kind="ChartLine" />
					<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="{Binding HeaderText, FallbackValue=탐지 신호 이력}" />
				</StackPanel>
			</DockPanel>
		</Border>

		<!--  ② 툴바 — 2행 구조(잘림 수정): 1행=기간 세그먼트+새로고침 / 2행=필터 칩 WrapPanel(줄바꿈)+미조치만  -->
		<Border
			Grid.Row="1"
			Padding="10,7,10,3"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  1행: 기간 프리셋 + 새로고침  -->
				<DockPanel Grid.Row="0" LastChildFill="False">
					<Border
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="6"
						DockPanel.Dock="Left">
						<StackPanel Orientation="Horizontal">
							<RadioButton
								Content="1시간"
								GroupName="Period"
								Style="{StaticResource PeriodSegButton}">
								<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('1h')]</cal:Message.Attach>
							</RadioButton>
							<RadioButton
								Content="24시간"
								GroupName="Period"
								IsChecked="True"
								Style="{StaticResource PeriodSegButton}">
								<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('24h')]</cal:Message.Attach>
							</RadioButton>
							<RadioButton
								Content="7일"
								GroupName="Period"
								Style="{StaticResource PeriodSegButton}">
								<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('7d')]</cal:Message.Attach>
							</RadioButton>
							<RadioButton
								Content="30일"
								GroupName="Period"
								Style="{StaticResource PeriodSegButton}">
								<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('30d')]</cal:Message.Attach>
							</RadioButton>
							<RadioButton
								Content="기간지정"
								GroupName="Period"
								Style="{StaticResource PeriodSegButton}">
								<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('custom')]</cal:Message.Attach>
							</RadioButton>
						</StackPanel>
					</Border>

					<Button
						VerticalAlignment="Center"
						Command="{Binding RefreshCommand}"
						DockPanel.Dock="Right"
						Style="{StaticResource MaterialDesignToolButton}"
						ToolTip="새로고침">
						<md:PackIcon
							Width="20"
							Height="20"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Kind="Refresh" />
					</Button>
				</DockPanel>

				<!--  2행: Result 필터 칩(WrapPanel — 폭 초과 시 줄바꿈, 절단 없음) + 미조치만  -->
				<DockPanel
					Grid.Row="1"
					Margin="0,7,0,0"
					LastChildFill="True">
					<ToggleButton
						Margin="8,0,0,4"
						VerticalAlignment="Top"
						Content="미조치만"
						DockPanel.Dock="Right"
						IsChecked="{Binding OnlyUnactioned, Mode=TwoWay}"
						Style="{StaticResource FilterChip}" />
					<ItemsControl ItemsSource="{Binding Chips}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<ToggleButton
									Content="{Binding ShortName}"
									IsChecked="{Binding IsOn, Mode=TwoWay}"
									Style="{StaticResource FilterChip}"
									ToolTip="{Binding Name}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</DockPanel>

				<!--  3행(그룹 모드 한정): 센서 필터 칩 — 시리즈 색 견본 병기(pidsgroup-rightclick FR-12)  -->
				<DockPanel
					Grid.Row="2"
					Margin="0,3,0,0"
					LastChildFill="True"
					Visibility="{Binding IsGroupMode, Converter={StaticResource BoolToVis}}">
					<TextBlock
						Margin="0,0,8,0"
						Padding="0,3,0,0"
						VerticalAlignment="Top"
						DockPanel.Dock="Left"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="센서" />
					<!--  [전체] 마스터 토글 — 센서 다수일 때 일괄 on/off (전부 on일 때만 체크 표시)  -->
					<ToggleButton
						VerticalAlignment="Top"
						Content="전체"
						DockPanel.Dock="Left"
						IsChecked="{Binding AllSensorsOn, Mode=TwoWay}"
						Style="{StaticResource FilterChipCompact}"
						ToolTip="모든 센서 표시/숨김" />
					<!--  칩 영역 최대 2줄(≈52px) — 센서가 많아도 그리드 높이를 잠식하지 않도록 초과분은 스크롤(사용자 피드백)  -->
					<ScrollViewer
						MaxHeight="52"
						HorizontalScrollBarVisibility="Disabled"
						VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding SensorChips}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<ToggleButton
									IsChecked="{Binding IsOn, Mode=TwoWay}"
									Style="{StaticResource FilterChipCompact}"
									ToolTip="{Binding Name}">
									<StackPanel Orientation="Horizontal">
										<Rectangle
											Width="7"
											Height="7"
											Margin="0,0,4,0"
											VerticalAlignment="Center"
											RadiusX="2"
											RadiusY="2">
											<Rectangle.Style>
												<Style TargetType="Rectangle">
													<!--  시리즈 색=센서 인덱스 고정, 8색 검증 팔레트 순환(SeriesColorIndex=SeriesIndex%8) — 차트 라인 색과 1:1  -->
													<Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="0">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries1Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="1">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries2Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="2">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries3Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="3">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries4Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="4">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries5Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="5">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries6Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="6">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries7Brush}" />
														</DataTrigger>
														<DataTrigger Binding="{Binding SeriesColorIndex}" Value="7">
															<Setter Property="Fill" Value="{DynamicResource ChartSeries8Brush}" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Rectangle.Style>
										</Rectangle>
										<TextBlock Text="{Binding Name}" />
									</StackPanel>
								</ToggleButton>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Grid>
		</Border>

		<!--  ③ 기간지정 입력 행 (custom일 때만)  -->
		<Border
			Grid.Row="2"
			Padding="10,6"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1"
			Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}">
			<StackPanel Orientation="Horizontal">
				<TextBlock
					Margin="0,0,6,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="기간" />
				<!--  두 mah:DateTimePicker(영문 워터마크·미국식 포맷·Teal 무아이콘 블록·라이트 텍스트박스)를
				     팝업 범위 선택 컨트롤로 대체 — EventDashboardView.xaml의 c:DateTimeRangeField와 동일 패턴.  -->
				<c:DateTimeRangeField
					VerticalAlignment="Center"
					FromAutomationId="Events.DetectionHistory.CustomStart"
					RangeEnd="{Binding CustomEnd, Mode=TwoWay}"
					RangeStart="{Binding CustomStart, Mode=TwoWay}"
					ToAutomationId="Events.DetectionHistory.CustomEnd" />
				<Button
					Margin="10,0,0,0"
					Padding="14,4"
					VerticalAlignment="Center"
					Command="{Binding ApplyCustomCommand}"
					Content="적용"
					Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
			</StackPanel>
		</Border>

		<!--  ④ 통계 스트립  -->
		<Border
			Grid.Row="3"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1">
			<UniformGrid Columns="5">
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding TotalCount, FallbackValue=0}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="총 탐지" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding MaxSignalText, FallbackValue=—}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="최대 신호" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding AvgSignalText, FallbackValue=—}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="평균 신호" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="13"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						LineHeight="28"
						Text="{Binding TopResultText, FallbackValue=—}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding TopStatLabel, FallbackValue=최다 결과}" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource StatusCriticalBrush}"
						Text="{Binding UnactionedCount, FallbackValue=0}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="미조치" />
				</StackPanel>
			</UniformGrid>
		</Border>

		<!--  ⑤ 신호 차트 (FR-13) — 색상 전부 토큰 DP 주입  -->
		<Grid Grid.Row="4">
			<StackPanel Margin="10,8,10,0">
				<controls:SignalChartControl
					AxisBrush="{DynamicResource BorderBrush}"
					GridBrush="{DynamicResource DividerBrush}"
					ItemsSource="{Binding ChartPoints}"
					LabelBrush="{DynamicResource TextSecondaryBrush}"
					LineBrush="{DynamicResource PrimaryBrush}"
					OtherSeriesBrush="{DynamicResource TextMutedBrush}"
					PointBrush="{DynamicResource PrimaryBrush}"
					PointClickedCommand="{Binding PointClickedCommand}"
					RangeEnd="{Binding ChartRangeEnd}"
					RangeStart="{Binding ChartRangeStart}"
					SelectedPayload="{Binding SelectedItem, Mode=TwoWay}"
					Series1Brush="{DynamicResource ChartSeries1Brush}"
					Series2Brush="{DynamicResource ChartSeries2Brush}"
					Series3Brush="{DynamicResource ChartSeries3Brush}"
					Series4Brush="{DynamicResource ChartSeries4Brush}"
					Series5Brush="{DynamicResource ChartSeries5Brush}"
					Series6Brush="{DynamicResource ChartSeries6Brush}"
					Series7Brush="{DynamicResource ChartSeries7Brush}"
					Series8Brush="{DynamicResource ChartSeries8Brush}"
					UnactionedBrush="{DynamicResource StatusCriticalBrush}">
					<controls:SignalChartControl.Style>
						<Style TargetType="controls:SignalChartControl">
							<Setter Property="Height" Value="220" />
							<Style.Triggers>
								<!--  그룹 모드: 센서 칩 행이 추가되는 만큼 차트를 줄여 이벤트 그리드 높이 확보(사용자 피드백)  -->
								<DataTrigger Binding="{Binding IsGroupMode}" Value="True">
									<Setter Property="Height" Value="175" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</controls:SignalChartControl.Style>
				</controls:SignalChartControl>
				<DockPanel Margin="2,2,2,4" LastChildFill="False">
					<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
						<Ellipse
							Width="9"
							Height="9"
							VerticalAlignment="Center"
							Fill="{DynamicResource PrimaryBrush}" />
						<TextBlock
							Margin="5,0,14,0"
							FontSize="11"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="조치 완료" />
						<Ellipse
							Width="9"
							Height="9"
							VerticalAlignment="Center"
							Fill="{DynamicResource StatusCriticalBrush}" />
						<TextBlock
							Margin="5,0,0,0"
							FontSize="11"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="미조치" />
					</StackPanel>
					<TextBlock
						DockPanel.Dock="Right"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="휠=줌 · 드래그=이동 · 더블클릭=전체 · 포인트 클릭=행 이동" />
				</DockPanel>
			</StackPanel>

			<!--  로딩 오버레이  -->
			<Border
				Background="{DynamicResource SurfaceTranslucentBrush}"
				Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<ProgressBar
						Width="42"
						Height="42"
						IsIndeterminate="True"
						Style="{StaticResource MaterialDesignCircularProgressBar}" />
					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="탐지 이력 조회 중…" />
				</StackPanel>
			</Border>
		</Grid>

		<!--  ⑥ 이력 그리드 — 미조치 행 우클릭 조치보고 (FR-15)  -->
		<DataGrid
			x:Name="HistoryGrid"
			Grid.Row="5"
			Margin="10,0,10,4"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			CellStyle="{StaticResource ModernDataGridCell}"
			ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
			HeadersVisibility="Column"
			IsReadOnly="True"
			ItemsSource="{Binding FilteredItems}"
			MinRowHeight="34"
			RowHeight="{x:Static sys:Double.NaN}"
			SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
			SelectionMode="Single"
			Style="{StaticResource ModernDataGrid}">
			<DataGrid.RowStyle>
				<Style BasedOn="{StaticResource ModernDataGridRow}" TargetType="DataGridRow">
					<Setter Property="ContextMenu">
						<Setter.Value>
							<ContextMenu>
								<MenuItem
									Command="{Binding Data.ReportCommand, Source={StaticResource proxy}}"
									CommandParameter="{Binding}"
									Header="조치보고" />
							</ContextMenu>
						</Setter.Value>
					</Setter>
				</Style>
			</DataGrid.RowStyle>
			<DataGrid.Columns>
				<DataGridTextColumn
					Binding="{Binding TimeText}"
					FontFamily="Consolas"
					Header="시간" />
				<!--  센서 컬럼(그룹 모드 한정, pidsgroup-rightclick FR-13) — DataGridColumn은 시각트리 밖이라 proxy 경유  -->
				<DataGridTextColumn
					Binding="{Binding DeviceName}"
					Header="센서"
					Visibility="{Binding Data.SensorColumnVisibility, Source={StaticResource proxy}}" />
				<DataGridTextColumn Binding="{Binding Result, Converter={StaticResource EnumToKoreanConverter}}" Header="결과" />
				<DataGridTemplateColumn Header="신호" SortMemberPath="Signal">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<Border
									Width="64"
									Height="8"
									Margin="0,0,8,0"
									VerticalAlignment="Center"
									Background="{DynamicResource SurfaceSunkenBrush}"
									CornerRadius="4"
									Visibility="{Binding HasSignal, Converter={StaticResource BoolToVis}}">
									<Border
										x:Name="PART_SignalBar"
										HorizontalAlignment="Left"
										Background="{DynamicResource PrimaryBrush}"
										CornerRadius="4">
										<Border.Width>
											<MultiBinding Converter="{StaticResource SignalBarWidthConverter}" ConverterParameter="64">
												<Binding Path="Signal" />
												<Binding Path="Data.MaxSignal" Source="{StaticResource proxy}" />
											</MultiBinding>
										</Border.Width>
									</Border>
								</Border>
								<TextBlock
									MinWidth="44"
									VerticalAlignment="Center"
									FontFamily="Consolas"
									Text="{Binding SignalText, Mode=OneWay}"
									TextAlignment="Right" />
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Value="True">
									<DataTrigger.Binding>
										<MultiBinding Converter="{StaticResource SignalIsMaxConverter}">
											<Binding Path="Signal" />
											<Binding Path="Data.MaxSignal" Source="{StaticResource proxy}" />
										</MultiBinding>
									</DataTrigger.Binding>
									<Setter TargetName="PART_SignalBar" Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="조치" SortMemberPath="IsActioned">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock
								x:Name="PART_Action"
								VerticalAlignment="Center"
								FontWeight="Bold"
								Foreground="{DynamicResource StatusNormalBrush}"
								Text="{Binding ActionText}"
								TextAlignment="Center" />
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding IsActioned}" Value="False">
									<Setter TargetName="PART_Action" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!--  ⑦ 푸터 — 조회 범위/절단 경고/갱신 시각/재시도  -->
		<Border
			Grid.Row="6"
			Padding="10,5"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0">
			<DockPanel LastChildFill="False">
				<TextBlock
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding RangeText}" />
				<Button
					Margin="10,0,0,0"
					Padding="10,2"
					VerticalAlignment="Center"
					Command="{Binding RefreshCommand}"
					Content="재시도"
					DockPanel.Dock="Left"
					Style="{StaticResource MaterialDesignFlatDarkBgButton}"
					Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
				<TextBlock
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding LastUpdatedText}" />
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
