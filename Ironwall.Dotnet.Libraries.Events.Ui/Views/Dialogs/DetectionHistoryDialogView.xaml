<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dialogs.DetectionHistoryDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:controls="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Controls"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:DesignHeight="620"
	d:DesignWidth="880"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">

	<!--
		탐지 신호 이력 다이얼로그 콘텐츠 (Detection_Signal_History FR-09).
		호스팅(md:DialogHost + md:Card 880×620)은 메인솔루션 래퍼(DetectionHistoryHostDialogView)가 담당 —
		기존 DetectionEventDialogView 패턴 미러. 색상은 전부 DynamicResource 토큰(NFR-01 다크/라이트).
	-->

	<UserControl.Resources>
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<converters:SignalBarWidthConverter x:Key="SignalBarWidthConverter" />
		<converters:SignalIsMaxConverter x:Key="SignalIsMaxConverter" />

		<!--  기간 세그먼트 버튼 — 선택 시 primary 채움 (템플릿 스코프=DynamicResource 토큰만)  -->
		<Style x:Key="PeriodSegButton" TargetType="RadioButton">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border
							x:Name="Bd"
							Padding="12,5"
							Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
								<Setter Property="FontWeight" Value="Bold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--  필터 칩 토글 — on 시 primary 틴트 외곽  -->
		<Style x:Key="FilterChip" TargetType="ToggleButton">
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Margin" Value="4,0,0,0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border
							x:Name="Bd"
							Padding="11,3"
							Background="Transparent"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="20">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintAccentBrush}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="FontWeight" Value="Bold" />
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid Background="{DynamicResource SurfaceBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  ① 시안 헤더 (ModernDialogHeader 표준)  -->
		<Border Grid.Row="0" Style="{StaticResource ModernDialogHeader}">
			<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
				<md:PackIcon
					Width="20"
					Height="20"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource OnPrimaryFixedBrush}"
					Kind="ChartLine" />
				<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="{Binding HeaderText, FallbackValue=탐지 신호 이력}" />
			</StackPanel>
		</Border>

		<!--  ② 툴바 — 기간 세그먼트 · 필터 칩 · 미조치만 · 새로고침  -->
		<Border
			Grid.Row="1"
			Padding="10,7"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1">
			<DockPanel LastChildFill="False">
				<Border
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1"
					CornerRadius="6"
					DockPanel.Dock="Left">
					<StackPanel Orientation="Horizontal">
						<RadioButton
							Content="1시간"
							GroupName="Period"
							Style="{StaticResource PeriodSegButton}">
							<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('1h')]</cal:Message.Attach>
						</RadioButton>
						<RadioButton
							Content="24시간"
							GroupName="Period"
							IsChecked="True"
							Style="{StaticResource PeriodSegButton}">
							<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('24h')]</cal:Message.Attach>
						</RadioButton>
						<RadioButton
							Content="7일"
							GroupName="Period"
							Style="{StaticResource PeriodSegButton}">
							<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('7d')]</cal:Message.Attach>
						</RadioButton>
						<RadioButton
							Content="30일"
							GroupName="Period"
							Style="{StaticResource PeriodSegButton}">
							<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('30d')]</cal:Message.Attach>
						</RadioButton>
						<RadioButton
							Content="기간지정"
							GroupName="Period"
							Style="{StaticResource PeriodSegButton}">
							<cal:Message.Attach>[Event Checked] = [Action SelectPeriod('custom')]</cal:Message.Attach>
						</RadioButton>
					</StackPanel>
				</Border>

				<ItemsControl
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					ItemsSource="{Binding Chips}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ToggleButton
								Content="{Binding Name}"
								IsChecked="{Binding IsOn, Mode=TwoWay}"
								Style="{StaticResource FilterChip}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<ToggleButton
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					Content="미조치만"
					DockPanel.Dock="Left"
					IsChecked="{Binding OnlyUnactioned, Mode=TwoWay}"
					Style="{StaticResource FilterChip}" />

				<Button
					VerticalAlignment="Center"
					Command="{Binding RefreshCommand}"
					DockPanel.Dock="Right"
					Style="{StaticResource MaterialDesignToolButton}"
					ToolTip="새로고침">
					<md:PackIcon
						Width="20"
						Height="20"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Kind="Refresh" />
				</Button>
			</DockPanel>
		</Border>

		<!--  ③ 기간지정 입력 행 (custom일 때만)  -->
		<Border
			Grid.Row="2"
			Padding="10,6"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1"
			Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}">
			<StackPanel Orientation="Horizontal">
				<TextBlock
					Margin="0,0,6,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="From" />
				<mah:DateTimePicker
					Width="190"
					FontSize="12"
					SelectedDateTime="{Binding CustomStart, Mode=TwoWay}" />
				<TextBlock
					Margin="10,0,6,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="To" />
				<mah:DateTimePicker
					Width="190"
					FontSize="12"
					SelectedDateTime="{Binding CustomEnd, Mode=TwoWay}" />
				<Button
					Margin="10,0,0,0"
					Padding="14,4"
					VerticalAlignment="Center"
					Command="{Binding ApplyCustomCommand}"
					Content="적용"
					Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
			</StackPanel>
		</Border>

		<!--  ④ 통계 스트립  -->
		<Border
			Grid.Row="3"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,0,0,1">
			<UniformGrid Columns="5">
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding TotalCount, FallbackValue=0}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="총 탐지" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding MaxSignalText, FallbackValue=—}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="최대 신호" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						Text="{Binding AvgSignalText, FallbackValue=—}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="평균 신호" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="13"
						FontWeight="Bold"
						Foreground="{DynamicResource PrimaryBrush}"
						LineHeight="28"
						Text="{Binding TopResultText, FallbackValue=—}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="최다 결과" />
				</StackPanel>
				<StackPanel Margin="0,8" HorizontalAlignment="Center">
					<TextBlock
						HorizontalAlignment="Center"
						FontFamily="Consolas"
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource StatusCriticalBrush}"
						Text="{Binding UnactionedCount, FallbackValue=0}" />
					<TextBlock
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="미조치" />
				</StackPanel>
			</UniformGrid>
		</Border>

		<!--  ⑤ 신호 차트 (FR-13) — 색상 전부 토큰 DP 주입  -->
		<Grid Grid.Row="4">
			<StackPanel Margin="10,8,10,0">
				<controls:SignalChartControl
					Height="220"
					AxisBrush="{DynamicResource BorderBrush}"
					GridBrush="{DynamicResource DividerBrush}"
					ItemsSource="{Binding ChartPoints}"
					LabelBrush="{DynamicResource TextSecondaryBrush}"
					LineBrush="{DynamicResource PrimaryBrush}"
					PointBrush="{DynamicResource PrimaryBrush}"
					PointClickedCommand="{Binding PointClickedCommand}"
					SelectedPayload="{Binding SelectedItem, Mode=TwoWay}"
					UnactionedBrush="{DynamicResource StatusCriticalBrush}" />
				<DockPanel Margin="2,2,2,4" LastChildFill="False">
					<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
						<Ellipse
							Width="9"
							Height="9"
							VerticalAlignment="Center"
							Fill="{DynamicResource PrimaryBrush}" />
						<TextBlock
							Margin="5,0,14,0"
							FontSize="11"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="조치 완료" />
						<Ellipse
							Width="9"
							Height="9"
							VerticalAlignment="Center"
							Fill="{DynamicResource StatusCriticalBrush}" />
						<TextBlock
							Margin="5,0,0,0"
							FontSize="11"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="미조치" />
					</StackPanel>
					<TextBlock
						DockPanel.Dock="Right"
						FontSize="11"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="포인트 클릭 → 아래 그리드 해당 행 이동" />
				</DockPanel>
			</StackPanel>

			<!--  로딩 오버레이  -->
			<Border
				Background="{DynamicResource SurfaceTranslucentBrush}"
				Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<ProgressBar
						Width="42"
						Height="42"
						IsIndeterminate="True"
						Style="{StaticResource MaterialDesignCircularProgressBar}" />
					<TextBlock
						Margin="0,8,0,0"
						HorizontalAlignment="Center"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="탐지 이력 조회 중…" />
				</StackPanel>
			</Border>
		</Grid>

		<!--  ⑥ 이력 그리드 — 미조치 행 우클릭 조치보고 (FR-15)  -->
		<DataGrid
			x:Name="HistoryGrid"
			Grid.Row="5"
			Margin="10,0,10,4"
			AutoGenerateColumns="False"
			CanUserAddRows="False"
			CellStyle="{StaticResource ModernDataGridCell}"
			ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
			HeadersVisibility="Column"
			IsReadOnly="True"
			ItemsSource="{Binding FilteredItems}"
			SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
			SelectionMode="Single"
			Style="{StaticResource ModernDataGrid}">
			<DataGrid.RowStyle>
				<Style BasedOn="{StaticResource ModernDataGridRow}" TargetType="DataGridRow">
					<Setter Property="ContextMenu">
						<Setter.Value>
							<ContextMenu>
								<MenuItem
									Command="{Binding Data.ReportCommand, Source={StaticResource proxy}}"
									CommandParameter="{Binding}"
									Header="조치보고" />
							</ContextMenu>
						</Setter.Value>
					</Setter>
				</Style>
			</DataGrid.RowStyle>
			<DataGrid.Columns>
				<DataGridTextColumn
					Binding="{Binding TimeText}"
					FontFamily="Consolas"
					Header="시간" />
				<DataGridTextColumn Binding="{Binding Result}" Header="Result" />
				<DataGridTemplateColumn Header="신호" SortMemberPath="Signal">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<StackPanel
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<Border
									Width="64"
									Height="8"
									Margin="0,0,8,0"
									VerticalAlignment="Center"
									Background="{DynamicResource SurfaceSunkenBrush}"
									CornerRadius="4"
									Visibility="{Binding HasSignal, Converter={StaticResource BoolToVis}}">
									<Border
										x:Name="PART_SignalBar"
										HorizontalAlignment="Left"
										Background="{DynamicResource PrimaryBrush}"
										CornerRadius="4">
										<Border.Width>
											<MultiBinding Converter="{StaticResource SignalBarWidthConverter}" ConverterParameter="64">
												<Binding Path="Signal" />
												<Binding Path="Data.MaxSignal" Source="{StaticResource proxy}" />
											</MultiBinding>
										</Border.Width>
									</Border>
								</Border>
								<TextBlock
									MinWidth="44"
									VerticalAlignment="Center"
									FontFamily="Consolas"
									Text="{Binding SignalText, Mode=OneWay}"
									TextAlignment="Right" />
							</StackPanel>
							<DataTemplate.Triggers>
								<DataTrigger Value="True">
									<DataTrigger.Binding>
										<MultiBinding Converter="{StaticResource SignalIsMaxConverter}">
											<Binding Path="Signal" />
											<Binding Path="Data.MaxSignal" Source="{StaticResource proxy}" />
										</MultiBinding>
									</DataTrigger.Binding>
									<Setter TargetName="PART_SignalBar" Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
				<DataGridTemplateColumn Header="조치" SortMemberPath="IsActioned">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock
								x:Name="PART_Action"
								VerticalAlignment="Center"
								FontWeight="Bold"
								Foreground="{DynamicResource StatusNormalBrush}"
								Text="{Binding ActionText}"
								TextAlignment="Center" />
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding IsActioned}" Value="False">
									<Setter TargetName="PART_Action" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!--  ⑦ 푸터 — 조회 범위/절단 경고/갱신 시각/재시도  -->
		<Border
			Grid.Row="6"
			Padding="10,5"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0">
			<DockPanel LastChildFill="False">
				<TextBlock
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding RangeText}" />
				<Button
					Margin="10,0,0,0"
					Padding="10,2"
					VerticalAlignment="Center"
					Command="{Binding RefreshCommand}"
					Content="재시도"
					DockPanel.Dock="Left"
					Style="{StaticResource MaterialDesignFlatDarkBgButton}"
					Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
				<TextBlock
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding LastUpdatedText}" />
			</DockPanel>
		</Border>

		<!--  ⑧ 다이얼로그 버튼  -->
		<Border
			Grid.Row="7"
			Padding="10,8"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="0,1,0,0">
			<Button
				x:Name="CloseDialog"
				Padding="20,4"
				HorizontalAlignment="Right"
				Style="{StaticResource MaterialDesignFlatDarkBgButton}">
				<StackPanel Orientation="Horizontal">
					<md:PackIcon
						VerticalAlignment="Center"
						Kind="Close" />
					<TextBlock
						Margin="6,0,0,0"
						VerticalAlignment="Center"
						Text="닫기" />
				</StackPanel>
			</Button>
		</Border>
	</Grid>
</UserControl>
