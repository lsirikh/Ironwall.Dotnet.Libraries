<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dialogs.OperationReportDialogView"
	AutomationProperties.AutomationId="Events.OperationActionReport.Root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="600"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">

	<!--
		운영 조치보고 — 장애 조치보고 창(MalfunctionReportDialogView)과 같은 커널 틀 · 같은 문구 목록, 사진 없음(operation-event-card PRD v1.1 §3).
		위 절은 운영 카드의 값을 읽기 전용 줄로 보인다(조치보고에서 이벤트는 고치지 않는다).
		ClickOk · ClickCancel · RadioButtonEtc 는 Caliburn 지시자(CanClickOk 가드 · 버튼 줄) — 장애 창과 같은 이름이다.
	-->

	<UserControl.Resources>
		<Style x:Key="Report.Value" TargetType="c:ConsoleText">
			<Setter Property="Margin" Value="0,6,0,0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style x:Key="Report.MemoBox" TargetType="TextBox">
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		<Style x:Key="Report.MemoFrame" TargetType="Border">
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Style.Triggers>
				<Trigger Property="IsKeyboardFocusWithin" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="Padding" Value="7,5" />
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<dlg:ConsoleDialogFrame
		DialogKey="Events.OperationActionReport"
		IsBusy="{Binding IsSending, Mode=OneWay, FallbackValue=False}"
		PrimaryText=""
		SecondaryInvoked="OnSecondaryInvoked"
		SecondaryText=""
		Size="Large"
		Title="운영 조치보고">

		<dlg:ConsoleDialogFrame.Message>
			<Binding FallbackValue="문구를 고르고 [확인]을 누르세요. '기타'는 내용을 적어야 합니다." Mode="OneWay" Path="DialogNotice" />
		</dlg:ConsoleDialogFrame.Message>

		<dlg:ConsoleDialogFrame.FooterActions>
			<StackPanel Orientation="Horizontal">
				<Button
					x:Name="ClickCancel"
					Height="34"
					AutomationProperties.AutomationId="Events.OperationActionReport.Cancel"
					MinWidth="92"
					Margin="0,0,8,0"
					cal:Message.Attach="ClickCancel"
					Content="취소"
					Style="{DynamicResource Console.Button}" />
				<Button
					x:Name="ClickOk"
					Height="34"
					AutomationProperties.AutomationId="Events.OperationActionReport.Ok"
					MinWidth="92"
					cal:Message.Attach="ClickOk"
					Content="확인"
					Style="{DynamicResource Console.Button.Primary}" />
			</StackPanel>
		</dlg:ConsoleDialogFrame.FooterActions>

		<StackPanel>
			<!--  ① 운영 속성 — 읽기 전용 줄  -->
			<c:ConsoleSection Margin="0">
				<c:ConsoleSection.Header>
					<c:ConsoleText Text="운영 속성" />
				</c:ConsoleSection.Header>
				<Grid c:ConsoleField.LabelWidth="64">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="20" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<c:ConsoleField Grid.Row="0" Grid.Column="0" Header="장비">
						<c:ConsoleText
							AutomationProperties.AutomationId="Events.OperationActionReport.Field.Device"
							Style="{StaticResource Report.Value}"
							Text="{Binding Operation.ZoneDeviceText, Mode=OneWay, FallbackValue=—}" />
					</c:ConsoleField>
					<c:ConsoleField Grid.Row="0" Grid.Column="2" Header="발생">
						<c:ConsoleText
							AutomationProperties.AutomationId="Events.OperationActionReport.Field.Time"
							Style="{StaticResource Report.Value}"
							Text="{Binding Operation.DateTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss, FallbackValue=—}" />
					</c:ConsoleField>

					<c:ConsoleField Grid.Row="1" Grid.Column="0" Header="사유">
						<c:ConsoleText
							AutomationProperties.AutomationId="Events.OperationActionReport.Field.Reason"
							Style="{StaticResource Report.Value}"
							Text="{Binding Operation.ReasonText, Mode=OneWay, FallbackValue=—}" />
					</c:ConsoleField>
					<c:ConsoleField Grid.Row="1" Grid.Column="2" Header="심각도">
						<c:ConsoleText
							AutomationProperties.AutomationId="Events.OperationActionReport.Field.Severity"
							Style="{StaticResource Report.Value}"
							Text="{Binding Operation.SeverityText, Mode=OneWay, FallbackValue=—}" />
					</c:ConsoleField>

					<c:ConsoleField
						Grid.Row="2"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						Header="상세">
						<c:ConsoleText
							AutomationProperties.AutomationId="Events.OperationActionReport.Field.Detail"
							Style="{StaticResource Report.Value}"
							Text="{Binding Operation.DetailText, Mode=OneWay, FallbackValue=—}" />
					</c:ConsoleField>
				</Grid>
			</c:ConsoleSection>

			<!--  ② 조치보고 항목 — 왼쪽 문구 목록(서버 조치보고 문구 관리 목록) · 오른쪽 '기타' + 내용  -->
			<c:ConsoleSection Margin="0,18,0,0">
				<c:ConsoleSection.Header>
					<c:ConsoleText Text="조치보고 항목" />
				</c:ConsoleSection.Header>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="0.8*" />
						<ColumnDefinition Width="25" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<ItemsControl
						Grid.Column="0"
						Margin="0,2,0,0"
						VerticalAlignment="Top"
						ItemsSource="{Binding CollectionActionItem}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<RadioButton
									Margin="0,5"
									AutomationProperties.AutomationId="{Binding Id, StringFormat=Events.OperationActionReport.Phrase.{0}}"
									Content="{Binding Name, FallbackValue=—}"
									GroupName="CollectionActionItem"
									IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
									Style="{DynamicResource Console.RadioButton}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Rectangle
						Grid.Column="1"
						Width="1"
						HorizontalAlignment="Center"
						Fill="{DynamicResource DividerBrush}" />

					<StackPanel Grid.Column="2" Margin="0,2,0,0">
						<RadioButton
							x:Name="RadioButtonEtc"
							Margin="0,5"
							AutomationProperties.AutomationId="Events.OperationActionReport.Etc"
							Content="{Binding EtcViewModel.Name, FallbackValue=기타}"
							GroupName="CollectionActionItem"
							IsChecked="{Binding EtcViewModel.IsSelected, Mode=TwoWay}"
							Style="{DynamicResource Console.RadioButton}" />
						<Border Margin="0,6,0,0" Style="{StaticResource Report.MemoFrame}">
							<TextBox
								Height="130"
								VerticalContentAlignment="Top"
								AcceptsReturn="True"
								AutomationProperties.AutomationId="Events.OperationActionReport.Memo"
								AutomationProperties.Name="기타 내용"
								IsEnabled="{Binding ElementName=RadioButtonEtc, Path=IsChecked}"
								MaxLength="500"
								Style="{StaticResource Report.MemoBox}"
								Text="{Binding Memo, Mode=TwoWay}"
								TextWrapping="Wrap"
								VerticalScrollBarVisibility="Auto" />
						</Border>
					</StackPanel>
				</Grid>
			</c:ConsoleSection>
		</StackPanel>
	</dlg:ConsoleDialogFrame>
</UserControl>
