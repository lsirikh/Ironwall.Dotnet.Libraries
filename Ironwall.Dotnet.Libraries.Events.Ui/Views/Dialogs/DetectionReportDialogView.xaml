<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dialogs.DetectionReportDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dlg="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles.Dialogs;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="700"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
	mc:Ignorable="d">

	<!--
		탐지 조치보고 — B5(window-design-inventory #23): 커널 다이얼로그 틀 T4 · L 720. 틀은 이 뷰 하나만 그린다 —
		호스트 래퍼(DetectionEventDialogView)는 카드 없이 이 뷰만 담는다(틀이 두 겹이 되지 않게).
		옛 모양: 호스트 카드 900×660 + 시안 머리띠 '탐지 조치보고' + 속성창(탐지 속성 띠 · 꺼진 콤보 · 꺼진 [적용] · '미리보기 없음' 칸)
		  + 라디오 목록 + MDIX 외곽선 입력칸 + 큰 [확인] · [취소].
		x:Name 은 넷 다 그대로다(Caliburn 지시자 · UI 시험 앵커): SelectedItemEditor · RadioButtonEtc · ClickOk · ClickCancel.
		  · SelectedItemEditor: ContentTemplate 을 주면 Caliburn 은 뷰를 찾지 않고 Content 만 잇는다 — 옛 속성창(편집기 뷰)을 얹지 않고
		    같은 뷰모델의 값을 읽기 전용 줄(라벨 · 값)로 그린다. 값은 ConsoleText 라 UIA 가 읽는다.
		  · ClickOk · ClickCancel: 틀의 버튼 줄(FooterActions)에 두고 cal:Message.Attach 로 잇는다. 틀의 ✕ · ESC 는 코드 숨김이
		    [취소]의 Click 으로 넘긴다(닫는 길이 하나). IsDefault · IsCancel 은 뺐다 — Enter 한 번에 조치가 기록되지 않게,
		    ESC 가 두 번 닫지 않게(틀이 판정한다).
		  · 라디오 글은 Content 문자열 — 템플릿 안 TextBlock 은 UIA 제어 보기에서 빠지지만 라디오의 이름은 Content 에서 읽힌다.
		바깥 스타일은 DynamicResource 로 찾는다 — 앱 없이 오프스크린으로 띄우는 뷰 시험 · 미리보기에서도 뜨게(런타임 결과는 같다).
		색상은 전부 DynamicResource 토큰(라이트/다크).
	-->

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<converters:ReportValueTextConverter x:Key="ValueText" />

		<!--  읽기 전용 값 — 라벨(ConsoleField 머리, 윗여백 6)과 첫 줄이 맞게 같은 윗여백  -->
		<Style x:Key="Report.Value" TargetType="c:ConsoleText">
			<Setter Property="Margin" Value="0,6,0,0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!--
			'기타' 내용 칸 — 콘솔 폼 입력칸과 같은 토큰(조치보고 문구 콘솔 Form.TextBox). 바탕 · 테두리 · 안쪽 여백은 감싸는 틀(Report.MemoFrame)이 진다 —
			TextBox 의 Padding 은 MDIX 암시적 ScrollViewer 스타일이 삼켜 글이 테두리에 붙었다(미리보기 실측).
		-->
		<Style x:Key="Report.MemoBox" TargetType="TextBox">
			<Setter Property="Padding" Value="0" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>

		<!--  칸의 겉 — 포커스는 색만이 아니라 테두리 두께(형태)로도 말한다  -->
		<Style x:Key="Report.MemoFrame" TargetType="Border">
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Style.Triggers>
				<Trigger Property="IsKeyboardFocusWithin" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="Padding" Value="7,5" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<!--
			글자 수 — 옛 MDIX 칸이 아래에 그리던 "n / 500" 을 그대로 잇는다. 칸에 x:Name 을 새로 달 수 없어(Caliburn 지시자 규칙)
			칸을 이 틀로 감싸고 틀이 제 내용(TextBox)의 글 길이를 읽는다 — 뷰모델 Memo 는 변경 알림이 없어 거기서 셀 수 없다.
		-->
		<Style x:Key="Report.MemoCounter" TargetType="ContentControl">
			<Setter Property="Focusable" Value="False" />
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContentControl">
						<StackPanel>
							<Border Style="{StaticResource Report.MemoFrame}">
								<ContentPresenter />
							</Border>
							<c:ConsoleText
								Margin="0,4,0,0"
								HorizontalAlignment="Right"
								AutomationProperties.AutomationId="Events.DetectionActionReport.MemoCount"
								FontSize="11.5"
								Foreground="{DynamicResource TextSecondaryBrush}">
								<c:ConsoleText.Text>
									<MultiBinding StringFormat="{}{0} / {1}">
										<Binding
											FallbackValue="0"
											Path="Content.Text.Length"
											RelativeSource="{RelativeSource TemplatedParent}" />
										<Binding
											FallbackValue="500"
											Path="Content.MaxLength"
											RelativeSource="{RelativeSource TemplatedParent}" />
									</MultiBinding>
								</c:ConsoleText.Text>
							</c:ConsoleText>
						</StackPanel>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<dlg:ConsoleDialogFrame
		DialogKey="Events.DetectionActionReport"
		Message="문구를 고르고 [확인]을 누르세요. '기타'는 내용을 적어야 합니다."
		PrimaryText=""
		SecondaryInvoked="OnSecondaryInvoked"
		SecondaryText=""
		Size="Large"
		Title="탐지 조치보고">

		<!--  버튼 줄 오른쪽 — 보조 → 주 동작(T4). 둘 다 옛 x:Name 버튼 그대로  -->
		<dlg:ConsoleDialogFrame.FooterActions>
			<StackPanel Orientation="Horizontal">
				<Button
					x:Name="ClickCancel"
					Height="34"
					MinWidth="92"
					Margin="0,0,8,0"
					cal:Message.Attach="ClickCancel"
					Content="취소"
					Style="{DynamicResource Console.Button}" />
				<Button
					x:Name="ClickOk"
					Height="34"
					MinWidth="92"
					cal:Message.Attach="ClickOk"
					Content="확인"
					Style="{DynamicResource Console.Button.Primary}" />
			</StackPanel>
		</dlg:ConsoleDialogFrame.FooterActions>

		<StackPanel>
			<!--  ① 탐지 속성 — 읽기 전용 줄. 조치보고에서 속성은 고치지 않는다(옛 IsEditable=false 와 같다)  -->
			<c:ConsoleSection Margin="0">
				<c:ConsoleSection.Header>
					<c:ConsoleText Text="탐지 속성" />
				</c:ConsoleSection.Header>
				<ContentControl
					x:Name="SelectedItemEditor"
					c:ConsoleField.LabelWidth="64"
					Content="{Binding SelectedItemEditor}"
					Focusable="False"
					IsTabStop="False">
					<ContentControl.ContentTemplate>
						<DataTemplate>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<c:ConsoleField Grid.Row="0" Grid.Column="0" Header="유형">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Type"
										Style="{StaticResource Report.Value}"
										Text="{Binding MessageType, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>
								<c:ConsoleField Grid.Row="0" Grid.Column="2" Header="상태">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Status"
										Style="{StaticResource Report.Value}"
										Text="{Binding Status, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>

								<c:ConsoleField Grid.Row="1" Grid.Column="0" Header="결과">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Result"
										Style="{StaticResource Report.Value}"
										Text="{Binding Result, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>
								<c:ConsoleField Grid.Row="1" Grid.Column="2" Header="신호">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Signal"
										Style="{StaticResource Report.Value}"
										Text="{Binding SignalText, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>

								<c:ConsoleField Grid.Row="2" Grid.Column="0" Header="종류">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.DeviceType"
										Style="{StaticResource Report.Value}"
										Text="{Binding DeviceTypeText, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>
								<c:ConsoleField Grid.Row="2" Grid.Column="2" Header="장비">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Device"
										Style="{StaticResource Report.Value}"
										Text="{Binding DeviceNameText, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>

								<c:ConsoleField Grid.Row="3" Grid.Column="0" Header="번호">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.DeviceNumber"
										Style="{StaticResource Report.Value}"
										Text="{Binding DeviceNumberText, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>
								<c:ConsoleField Grid.Row="3" Grid.Column="2" Header="프레임">
									<c:ConsoleText AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Frame" Style="{StaticResource Report.Value}">
										<c:ConsoleText.Text>
											<MultiBinding Converter="{StaticResource ValueText}" ConverterParameter=" × ">
												<Binding Mode="OneWay" Path="FrameWidthEdit" />
												<Binding Mode="OneWay" Path="FrameHeightEdit" />
											</MultiBinding>
										</c:ConsoleText.Text>
									</c:ConsoleText>
								</c:ConsoleField>

								<c:ConsoleField
									Grid.Row="4"
									Grid.Column="0"
									Grid.ColumnSpan="3"
									Header="구역">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Zone"
										Style="{StaticResource Report.Value}"
										Text="{Binding DeviceZoneText, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>
								<c:ConsoleField
									Grid.Row="5"
									Grid.Column="0"
									Grid.ColumnSpan="3"
									Header="AI">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Ai"
										Style="{StaticResource Report.Value}"
										Text="{Binding AiSummaryText, Mode=OneWay, Converter={StaticResource ValueText}}" />
								</c:ConsoleField>
								<c:ConsoleField
									Grid.Row="6"
									Grid.Column="0"
									Grid.ColumnSpan="3"
									Header="객체">
									<c:ConsoleText
										AutomationProperties.AutomationId="Events.DetectionActionReport.Field.Objects"
										Style="{StaticResource Report.Value}"
										Text="{Binding ObjectsText, Mode=OneWay, Converter={StaticResource ValueText}}"
										ToolTip="{Binding ObjectsText, Mode=OneWay}" />
								</c:ConsoleField>

								<!--  썸네일 — 주소가 있을 때만 칸을 둔다(주소가 없는 PIDS 탐지에 빈 '미리보기 없음' 칸을 세우지 않는다).
								      받아 오기 전 · 실패(자체서명 인증서 등)면 그림이 비어 뒤의 안내가 보인다 — 옛 겹침 폴백과 같다  -->
								<Border
									Grid.Row="0"
									Grid.RowSpan="7"
									Grid.Column="3"
									Width="150"
									Height="150"
									Margin="20,4,0,0"
									VerticalAlignment="Top"
									Background="{DynamicResource SurfaceAltBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="6"
									Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
									<Grid>
										<c:ConsoleText
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="11.5"
											Foreground="{DynamicResource TextSecondaryBrush}"
											Text="미리보기 없음" />
										<Image
											AutomationProperties.AutomationId="Events.DetectionActionReport.Thumbnail"
											RenderOptions.BitmapScalingMode="HighQuality"
											Source="{Binding Thumbnail, Mode=OneWay}"
											Stretch="Uniform" />
									</Grid>
								</Border>
							</Grid>
						</DataTemplate>
					</ContentControl.ContentTemplate>
				</ContentControl>
			</c:ConsoleSection>

			<!--  ② 조치보고 항목 — 왼쪽 문구 목록(서버 조치보고 문구 관리 목록) · 오른쪽 '기타' + 내용  -->
			<c:ConsoleSection Margin="0,18,0,0">
				<c:ConsoleSection.Header>
					<c:ConsoleText Text="조치보고 항목" />
				</c:ConsoleSection.Header>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="0.8*" />
						<ColumnDefinition Width="25" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<ItemsControl
						Grid.Column="0"
						Margin="0,2,0,0"
						VerticalAlignment="Top"
						ItemsSource="{Binding CollectionActionItem}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<RadioButton
									Margin="0,5"
									Content="{Binding Name, FallbackValue=—}"
									GroupName="CollectionActionItem"
									IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
									Style="{DynamicResource Console.RadioButton}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Rectangle
						Grid.Column="1"
						Width="1"
						HorizontalAlignment="Center"
						Fill="{DynamicResource DividerBrush}" />

					<StackPanel Grid.Column="2" Margin="0,2,0,0">
						<RadioButton
							x:Name="RadioButtonEtc"
							Margin="0,5"
							Content="{Binding EtcViewModel.Name, FallbackValue=기타}"
							GroupName="CollectionActionItem"
							IsChecked="{Binding EtcViewModel.IsSelected, Mode=TwoWay}"
							Style="{DynamicResource Console.RadioButton}" />
						<ContentControl Margin="0,6,0,0" Style="{StaticResource Report.MemoCounter}">
							<TextBox
								Height="130"
								VerticalContentAlignment="Top"
								AcceptsReturn="True"
								AutomationProperties.AutomationId="Events.DetectionActionReport.Memo"
								AutomationProperties.Name="기타 내용"
								IsEnabled="{Binding ElementName=RadioButtonEtc, Path=IsChecked}"
								MaxLength="500"
								Style="{StaticResource Report.MemoBox}"
								Text="{Binding Memo, Mode=TwoWay}"
								TextWrapping="Wrap"
								VerticalScrollBarVisibility="Auto" />
						</ContentControl>
					</StackPanel>
				</Grid>
			</c:ConsoleSection>
		</StackPanel>
	</dlg:ConsoleDialogFrame>
</UserControl>
