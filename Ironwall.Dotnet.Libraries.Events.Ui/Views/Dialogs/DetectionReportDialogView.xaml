<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dialogs.DetectionReportDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Panels"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	mc:Ignorable="d">

	<!--  루트를 Grid로 — 헤더(Auto) / 콘텐츠(ScrollViewer, *) / 버튼(Auto). 호스트 높이 제약 시에도
	      버튼 행은 항상 확보되고 콘텐츠만 스크롤 → 버튼 짤림 방지(종전 StackPanel 루트의 하단 클립 해소).  -->
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  시안 헤더 바 (LayerPanel 패턴)  -->
		<Border
			Grid.Row="0"
			Margin="0,0,0,8"
			Style="{StaticResource ModernDialogHeader}">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<md:PackIcon
					Width="20"
					Height="20"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource OnPrimaryFixedBrush}"
					Kind="EmailSendOutline" />
				<TextBlock Style="{StaticResource ModernDialogHeaderText}" Text="탐지 이벤트" />
			</StackPanel>
		</Border>

		<!--  콘텐츠 — 스크롤 영역(버튼 제외). 너무 길면 스크롤, 버튼은 아래 행에 고정.  -->
		<ScrollViewer
			Grid.Row="1"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="10" Orientation="Vertical">

				<ContentControl x:Name="SelectedItemEditor" />

				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="12" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.Resources>
						<Style x:Key="TextBlockSection" TargetType="TextBlock">
							<Setter Property="FontFamily" Value="{StaticResource NotoSansCJKkRMedium}" />
							<Setter Property="FontSize" Value="16" />
							<Setter Property="Opacity" Value="0.75" />
						</Style>
					</Grid.Resources>
					<md:PackIcon
						Grid.Column="0"
						Kind="TableOfContents"
						Style="{StaticResource ContentIcon}" />
					<TextBlock
						Grid.Column="2"
						Style="{StaticResource TextBlockTitle}"
						Text="조치보고 항목" />
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width=".7*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>

					<StackPanel Margin="10,0" Orientation="Vertical">

						<ItemsControl ItemsSource="{Binding CollectionActionItem}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										VerticalAlignment="Center"
										GroupName="CollectionActionItem"
										IsChecked="{Binding Path=IsSelected, Mode=TwoWay}">

										<RadioButton.Content>
											<StackPanel Orientation="Horizontal">
												<TextBlock Style="{StaticResource TextBlockContent}" Text="{Binding Name, FallbackValue=테스트}" />
											</StackPanel>
										</RadioButton.Content>
									</RadioButton>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<Separator Grid.Column="1" Style="{StaticResource SeparatorVerticalStyle}" />

					<Grid
						Grid.Column="2"
						Margin="10,0"
						VerticalAlignment="Top">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="10" />
							<RowDefinition Height="1*" />
						</Grid.RowDefinitions>

						<RadioButton
							x:Name="RadioButtonEtc"
							GroupName="CollectionActionItem"
							IsChecked="{Binding EtcViewModel.IsSelected, Mode=TwoWay}">

							<RadioButton.Content>
								<TextBlock Style="{StaticResource TextBlockContent}" Text="{Binding EtcViewModel.Name, FallbackValue=Etcs}" />
							</RadioButton.Content>
						</RadioButton>

						<TextBox
							Grid.Row="2"
							Height="130"
							VerticalAlignment="Top"
							AcceptsReturn="True"
							FontSize="16"
							IsEnabled="{Binding ElementName=RadioButtonEtc, Path=IsChecked}"
							Style="{StaticResource MaterialDesignOutlinedTextBox}"
							Text="{Binding Memo, Mode=TwoWay}"
							TextWrapping="Wrap"
							VerticalScrollBarVisibility="Auto" />

					</Grid>
				</Grid>

				<Separator Background="{DynamicResource DividerBrush}" Style="{StaticResource MaterialDesignLightSeparator}" />
			</StackPanel>
		</ScrollViewer>

		<!--  버튼 — 항상 표시(Auto 행, 스크롤 밖). 하단 여백으로 창 가장자리 밀착 방지.  -->
		<Grid
			Grid.Row="2"
			Margin="10,10,10,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="5*" />
				<ColumnDefinition Width="5*" />
			</Grid.ColumnDefinitions>
			<Button
				x:Name="ClickOk"
				Grid.Column="0"
				Margin="10,0"
				BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
				Content="확인"
				IsDefault="True"
				Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
			<Button
				x:Name="ClickCancel"
				Grid.Column="1"
				Margin="10,0"
				BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
				Content="취소"
				IsCancel="True"
				Style="{StaticResource MaterialDesignFlatDarkBgButton}" />
		</Grid>
	</Grid>
</UserControl>
