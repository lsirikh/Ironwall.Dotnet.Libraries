<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Components.EventInfoView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Components"
	xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignHeight="450"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0" />
			<ColumnDefinition Width="2*" />
			<ColumnDefinition Width="1*" />
		</Grid.ColumnDefinitions>

		<!-- 센서 이벤트 차트 패널 — 또렷한 테두리 + 간격으로 분리 -->
		<md:Card
			Grid.Row="1"
			Grid.Column="1"
			Margin="5"
			md:ThemeAssist.Theme="Inherit"
			md:ElevationAssist.Elevation="Dp0"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1"
			UniformCornerRadius="6">
			<Grid Margin="0">
				<ProgressBar
					Width="50"
					Height="50"
					IsIndeterminate="True"
					Style="{DynamicResource MaterialDesignCircularProgressBar}"
					Visibility="{Binding IsChartLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
					Value="44" />
				<Grid Visibility="{Binding IsChartLoading, Converter={StaticResource BoolToInverseVisibleConverter}}">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="1*" />
					</Grid.ColumnDefinitions>
					<StackPanel
						Grid.Column="0"
						Margin="5,0,5,0"
						VerticalAlignment="Center"
						Orientation="Vertical">
						<CheckBox
							Margin="0,3"
							Content="탐지"
							FontSize="15"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							IsChecked="{Binding IsDetectionEnable}"
							Visibility="{Binding IsDetectionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<CheckBox
							Margin="0,3"
							Content="장애"
							FontSize="15"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							IsChecked="{Binding IsMalfunctionEnable}"
							Visibility="{Binding IsMalfunctionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<CheckBox
							Margin="0,3"
							Content="연결"
							FontSize="15"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							IsChecked="{Binding IsConnectionEnable}"
							Visibility="{Binding IsConnectionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
						<CheckBox
							Margin="0,3"
							Content="조치"
							FontSize="15"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							IsChecked="{Binding IsActionEnable}"
							Visibility="{Binding IsActionActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
					</StackPanel>
					<!--  툴팁 BG/텍스트 theme-aware — 미지정 시 라이브러리 기본 밝은 박스(다크 가독 붕괴, SIM-R009)  -->
					<lvc:CartesianChart
						Grid.Column="1"
						LegendBackgroundPaint="{Binding LedgendBackgroundPaint}"
						LegendPosition="Right"
						LegendTextPaint="{Binding LegendTextPaint}"
						LegendTextSize="12"
						Series="{Binding LSeries}"
						TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
						TooltipTextPaint="{Binding TooltipTextPaint}"
						TooltipTextSize="12"
						XAxes="{Binding XAxes}"
						YAxes="{Binding YAxes}"
						ZoomMode="X" />
				</Grid>
			</Grid>
		</md:Card>

		<!-- 카메라 이벤트 파이 패널 — 또렷한 테두리 + 간격으로 분리 -->
		<md:Card
			Grid.Row="1"
			Grid.Column="3"
			Margin="5"
			md:ThemeAssist.Theme="Inherit"
			md:ElevationAssist.Elevation="Dp0"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1"
			UniformCornerRadius="6">
			<Grid>
				<ProgressBar
					Width="50"
					Height="50"
					IsIndeterminate="True"
					Style="{DynamicResource MaterialDesignCircularProgressBar}"
					Visibility="{Binding IsChartLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
					Value="44" />
				<!--  파이도 툴팁 페인트 명시 — 현행은 전무라 테마 전환 미반영(SIM-X006)  -->
				<lvc:PieChart
					LegendBackgroundPaint="{Binding LedgendBackgroundPaint}"
					LegendPosition="Right"
					LegendTextPaint="{Binding LegendTextPaint}"
					LegendTextSize="12"
					Series="{Binding DSeries}"
					TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
					TooltipTextPaint="{Binding TooltipTextPaint}"
					TooltipTextSize="12"
					Visibility="{Binding IsChartLoading, Converter={StaticResource BoolToInverseVisibleConverter}}" />
			</Grid>
		</md:Card>

	</Grid>
</UserControl>
