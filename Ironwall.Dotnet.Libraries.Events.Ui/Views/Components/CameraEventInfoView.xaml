<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Components.CameraEventInfoView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignHeight="200"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<Grid Margin="10">
		<ProgressBar
			Width="50"
			Height="50"
			IsIndeterminate="True"
			Style="{DynamicResource MaterialDesignCircularProgressBar}"
			Visibility="{Binding IsChartLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
			Value="44" />
		<Grid Visibility="{Binding IsChartLoading, Converter={StaticResource BoolToInverseVisibleConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>

			<!-- KPI Card 1: 총 탐지 건수 -->
			<md:Card Grid.Column="0" Margin="5" Padding="20"
					 Background="#22FF6464"
					 UniformCornerRadius="8">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="{Binding TotalCount}"
							   FontSize="36" FontWeight="Bold"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource MaterialDesignBody}" />
					<TextBlock Text="총 탐지 건수"
							   FontSize="14" Opacity="0.7"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource MaterialDesignBody}" />
				</StackPanel>
			</md:Card>

			<!-- KPI Card 2: 일평균 -->
			<md:Card Grid.Column="1" Margin="5" Padding="20"
					 Background="#22FFB347"
					 UniformCornerRadius="8">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="{Binding DailyAverage, StringFormat={}{0:F1}}"
							   FontSize="36" FontWeight="Bold"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource MaterialDesignBody}" />
					<TextBlock Text="일평균 탐지"
							   FontSize="14" Opacity="0.7"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource MaterialDesignBody}" />
				</StackPanel>
			</md:Card>

			<!-- KPI Card 3: 활성 카메라 수 -->
			<md:Card Grid.Column="2" Margin="5" Padding="20"
					 Background="#224FC3F7"
					 UniformCornerRadius="8">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="{Binding ActiveCameraCount}"
							   FontSize="36" FontWeight="Bold"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource MaterialDesignBody}" />
					<TextBlock Text="활성 카메라"
							   FontSize="14" Opacity="0.7"
							   HorizontalAlignment="Center"
							   Foreground="{DynamicResource MaterialDesignBody}" />
				</StackPanel>
			</md:Card>
		</Grid>
	</Grid>
</UserControl>
