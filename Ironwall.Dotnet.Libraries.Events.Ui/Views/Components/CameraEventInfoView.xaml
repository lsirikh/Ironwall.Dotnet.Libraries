<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Components.CameraEventInfoView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:DesignHeight="200"
	d:DesignWidth="800"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">

	<!-- Tactical KPI 카드 공용 스타일: 어두운 표면 + 1px 상태색 헤어라인 + 샤프 코너 -->
	<UserControl.Resources>
		<Style x:Key="TacticalKpiCard" TargetType="{x:Type md:Card}">
			<Setter Property="Margin" Value="4" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="UniformCornerRadius" Value="4" />
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="md:ElevationAssist.Elevation" Value="Dp0" />
		</Style>
		<Style x:Key="TacticalKpiLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="Margin" Value="0,0,0,2" />
		</Style>
		<Style x:Key="TacticalKpiValue" TargetType="TextBlock">
			<Setter Property="FontSize" Value="34" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
		</Style>
	</UserControl.Resources>

	<Grid Margin="10">
		<ProgressBar
			Width="50"
			Height="50"
			IsIndeterminate="True"
			Style="{DynamicResource MaterialDesignCircularProgressBar}"
			Visibility="{Binding IsChartLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
			Value="44" />
		<Grid Visibility="{Binding IsChartLoading, Converter={StaticResource BoolToInverseVisibleConverter}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>

			<!-- KPI Card 1: 총 탐지 건수 (위험=빨강 액센트) -->
			<md:Card Grid.Column="0" Style="{StaticResource TacticalKpiCard}"
					 BorderBrush="{DynamicResource StatusCriticalBrush}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="4" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Background="{DynamicResource StatusCriticalBrush}" />
					<StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
						<TextBlock Style="{StaticResource TacticalKpiLabel}" Text="총 탐지 건수" />
						<TextBlock Style="{StaticResource TacticalKpiValue}"
								   Foreground="{DynamicResource StatusCriticalBrush}"
								   Text="{Binding TotalCount}" />
					</StackPanel>
				</Grid>
			</md:Card>

			<!-- KPI Card 2: 일평균 (경고=앰버 액센트) -->
			<md:Card Grid.Column="1" Style="{StaticResource TacticalKpiCard}"
					 BorderBrush="{DynamicResource StatusWarningBrush}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="4" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Background="{DynamicResource StatusWarningBrush}" />
					<StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
						<TextBlock Style="{StaticResource TacticalKpiLabel}" Text="일평균 탐지" />
						<TextBlock Style="{StaticResource TacticalKpiValue}"
								   Foreground="{DynamicResource StatusWarningBrush}"
								   Text="{Binding DailyAverage, StringFormat={}{0:F1}}" />
					</StackPanel>
				</Grid>
			</md:Card>

			<!-- KPI Card 3: 활성 카메라 수 (정보=시안 액센트) -->
			<md:Card Grid.Column="2" Style="{StaticResource TacticalKpiCard}"
					 BorderBrush="{DynamicResource StatusInfoBrush}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="4" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Background="{DynamicResource StatusInfoBrush}" />
					<StackPanel Grid.Column="1" Margin="14,10" VerticalAlignment="Center">
						<TextBlock Style="{StaticResource TacticalKpiLabel}" Text="활성 카메라" />
						<TextBlock Style="{StaticResource TacticalKpiValue}"
								   Foreground="{DynamicResource StatusInfoBrush}"
								   Text="{Binding ActiveCameraCount}" />
					</StackPanel>
				</Grid>
			</md:Card>
		</Grid>
	</Grid>
</UserControl>
