<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles.SuppressionListView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dash="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Dashboards"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:theme="clr-namespace:Ironwall.Dotnet.Libraries.Theme.Themes;assembly=Ironwall.Dotnet.Libraries.Theme"
	AutomationProperties.AutomationId="Console.Suppression.Panel"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		억제 스케줄 T1 목록 — 정본 window-layout-system-storyboard.html
		L1048(폼이 위 → T1 + 서랍) · L1122 E-D7 · L2295-2300(예시 행) · L2313(상태 칩) · L2427-2428(열).

		정본 열: 상태 · 작업명 · 대상 · 범위 · 시작(KST) · 종료(KST).
		+ 반복 · 회차 · 취소 · 삭제 체크는 기존 억제창에 이미 있던 칸이라 그대로 가져온다.

		자동화 식별자는 전부 Console.Suppression.* 다 — 옛 Events.SuppressionSchedule.* 를 그대로 쓰면
		폐기 예정인 억제창(EventSuppressionSchedulePanelView)과 같은 이름이 두 화면에 동시에 살아
		UIA 탐색이 어느 쪽을 잡을지 비결정적이 된다. 옛↔새 대응표는 호스트 후속 문서에 있다.

		행 정렬 · 열 재정렬 없음 — 화면 순서와 저장 순서가 갈리면 뜻과 단언이 같이 무너진다.
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationId 만.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<dash:EventIconKindConverter x:Key="IconKind" />

		<Style x:Key="SuppressionRow" BasedOn="{StaticResource Console.DataGrid.Row}" TargetType="DataGridRow">
			<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Console.Suppression.Row.{0}}" />
		</Style>
	</UserControl.Resources>

	<Grid>
		<DataGrid
			AutomationProperties.AutomationId="Console.Suppression.Grid"
		CanUserAddRows="False"
		CanUserReorderColumns="False"
		CanUserResizeRows="False"
		CanUserSortColumns="False"
		IsReadOnly="True"
		ItemsSource="{Binding RowsView}"
		RowStyle="{StaticResource SuppressionRow}"
		SelectedItem="{Binding Selected, Mode=TwoWay}"
		SelectionMode="Single"
		Style="{StaticResource Console.DataGrid}">
		<DataGrid.Columns>

			<!--  삭제 선택 — 취소/종료(terminal) 행에만 뜬다. 셀 여백 12 가 좁은 열을 지우므로 Flush 를 쓴다.  -->
			<DataGridTemplateColumn
				Width="32"
				MinWidth="32"
				CellStyle="{StaticResource Console.DataGrid.Cell.Flush}"
				IsReadOnly="True">
				<!--
					커널 머리 템플릿의 여백(Border Padding 12,8 — 템플릿에 박혀 있어 Padding 세터가 닿지 않는다)이
					32 폭 열에서 전체선택 상자를 잘랐다("[" 만 보임). 셀처럼 머리도 여백을 걷는다 — 색 · 밑줄은 커널 그대로.
				-->
				<DataGridTemplateColumn.HeaderStyle>
					<Style BasedOn="{StaticResource Console.DataGrid.ColumnHeader}" TargetType="DataGridColumnHeader">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="DataGridColumnHeader">
									<Border
										Padding="0,8"
										Background="{TemplateBinding Background}"
										BorderBrush="{DynamicResource DividerBrush}"
										BorderThickness="0,0,0,1">
										<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</DataGridTemplateColumn.HeaderStyle>
				<DataGridTemplateColumn.HeaderTemplate>
					<DataTemplate>
						<CheckBox
							HorizontalAlignment="Center"
							AutomationProperties.AutomationId="Console.Suppression.SelectAll"
							IsChecked="{Binding DataContext.SelectAllDeletable, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
							ToolTip="취소 · 종료된 행만 한꺼번에 고릅니다"
							Visibility="{Binding DataContext.HasDeletableRows, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
					</DataTemplate>
				</DataGridTemplateColumn.HeaderTemplate>
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
						<CheckBox
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowSelect.{0}}"
							IsChecked="{Binding IsSelected, Mode=TwoWay}"
							ToolTip="삭제 대상으로 고릅니다(취소 · 종료 행만)"
							Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}" />
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<!--  상태 — 색이 아니라 '형태 + 글자'. 라이트에서 Primary · Selection 이 대비 1.00:1 로 같다.  -->
			<DataGridTemplateColumn
				Width="78"
				MinWidth="78"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="상태">
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
						<StackPanel Orientation="Horizontal" ToolTip="{Binding OccurrenceText}">
							<md:PackIcon
								Width="13"
								Height="13"
								Margin="0,0,5,0"
								VerticalAlignment="Center"
								AutomationProperties.Name="{Binding ShapeLabel}"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Kind="{Binding ShapeIconName, Converter={StaticResource IconKind}}" />
							<TextBlock
								VerticalAlignment="Center"
								AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowStatus.{0}}"
								FontSize="12"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding ShapeLabel}" />
						</StackPanel>
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<!--
				U-17 — 열 폭. 고정 합(32+78+170+104+76+92+98+98+72 = 820)이 도킹된 목록 칸(1312 콘솔에서 788)보다 넓어
				오른쪽이 가로 스크롤 밖으로 밀렸고, 대상 104 · 범위 76 은 실데이터("전체(both)" · "전체 · 감지+감시")를 잘랐다(실창 캡처).
				글자를 싣는 네 칸(작업명 · 대상 · 범위 · 반복)을 비율 별로 바꿔 남는 폭을 나눠 갖게 하고, 바닥은 한 줄이 읽히는 폭으로 둔다.
				바닥 합 = 32+78+150+100+72+88+98+98+60 = 776 — 788 안에 든다.
				완성도 패스(E-7 #1 · #8) — 대상 · 범위가 둘 다 "전체 · 감지+감시"(약 110)를 싣게 되어 바닥을 110/112 로 올리고,
				그만큼 작업명 바닥(비율 2* 라 남는 폭은 가장 많이 받는다)과 동작 칸을 줄여 합을 792 로 유지한다:
				그래도 "전체 · 감지+감시" 는 잘렸다(글자 약 104 + 칸 여백 24) — 대상 · 범위 바닥을 128 로 올리고 작업명 · 반복을 92, 동작을 50 으로:
				32+78+92+128+128+92+98+98+50 = 796 — 1340 표면의 목록 보이는 폭 816(세로 스크롤바 제외)에 든다.
				★ 네 칸의 별 비율을 바닥 비율(0.92 : 1.28 : 1.28 : 0.92)과 같게 둔다 — 비율이 바닥과 어긋나면 WPF 가 한 칸을 바닥으로
				끌어올리면서 합이 넘쳐 1340 에서도 6px 가로 스크롤이 섰다(잘림 감사 after 1차). 같은 비율이면 어느 칸도 바닥에 먼저 걸리지 않는다.
				실창 검토 #22 — 그래도 작업명은 모든 행이 잘렸고("[시드] 다…") 반복은 두 줄 다 잘렸다. 까닭은 대상 · 범위가 같은
				"전체 · 감지+감시" 를 두 번 싣느라 128 씩 차지한 것이다. 범위 칸은 억제 범위 하나만 싣고(ScopeListText — 감지/감시는
				대상 칸 TargetListText 로), 좁힌 폭(80)과 시작 · 종료(98→90, "09-20 09:00" 64 + 여백 24)에서 번 폭을 반복(136)에 준다.
				글자가 정해진 칸은 고정 폭, 별은 작업명 하나 — 창을 넓히면 남는 폭은 전부 작업명이 받는다.
				바닥 합 = 32+78+120+128+80+136+90+90+50 = 804 — 806(816 − 세로 스크롤바) 안에 든다.
			-->
			<DataGridTextColumn
				Width="*"
				MinWidth="120"
				Binding="{Binding Name}"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="작업명">
				<DataGridTextColumn.ElementStyle>
					<Style TargetType="TextBlock">
						<Setter Property="ToolTip" Value="{Binding Name}" />
						<Setter Property="TextTrimming" Value="CharacterEllipsis" />
					</Style>
				</DataGridTextColumn.ElementStyle>
			</DataGridTextColumn>

			<DataGridTextColumn
				Width="128"
				MinWidth="128"
				Binding="{Binding TargetListText}"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="대상">
				<DataGridTextColumn.ElementStyle>
					<Style TargetType="TextBlock">
						<Setter Property="ToolTip" Value="{Binding TargetListText}" />
						<Setter Property="TextTrimming" Value="CharacterEllipsis" />
					</Style>
				</DataGridTextColumn.ElementStyle>
			</DataGridTextColumn>

			<DataGridTextColumn
				Width="80"
				MinWidth="80"
				Binding="{Binding ScopeListText}"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="범위">
				<DataGridTextColumn.ElementStyle>
					<Style TargetType="TextBlock">
						<Setter Property="ToolTip" Value="{Binding ScopeToolTip}" />
						<Setter Property="TextTrimming" Value="CharacterEllipsis" />
					</Style>
				</DataGridTextColumn.ElementStyle>
			</DataGridTextColumn>

			<!--  U-18 — 88 이면 "다음 09-20 22:00"(79 + 안쪽 24)이 1px 모자라 늘 줄임표가 찍혔다(잘림 감사) → 104.
			     실창 검토 #22 — "월~금 08:00~18:00"(약 108 + 24)도 잘렸다 → 136.  -->
			<DataGridTemplateColumn
				Width="136"
				MinWidth="136"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="반복">
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
						<StackPanel VerticalAlignment="Center">
							<TextBlock
								AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowRepeat.{0}}"
								FontSize="11.5"
								Foreground="{DynamicResource TextSecondaryBrush}"
								LineHeight="14"
								LineStackingStrategy="BlockLineHeight"
								Text="{Binding RepeatText}"
								ToolTip="{Binding RepeatText}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock
								AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowOccurrence.{0}}"
								FontSize="10.5"
								Foreground="{DynamicResource TextMutedBrush}"
								LineHeight="13"
								LineStackingStrategy="BlockLineHeight"
								Text="{Binding OccurrenceText}"
								TextTrimming="CharacterEllipsis"
								Visibility="{Binding HasOccurrence, Converter={StaticResource BoolToVis}}"
								theme:TrimmedToolTip.IsEnabled="True" />
						</StackPanel>
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTemplateColumn
				Width="90"
				MinWidth="90"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="시작(KST)">
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
						<TextBlock
							VerticalAlignment="Center"
							FontSize="12"
							Foreground="{DynamicResource TextPrimaryBrush}"
							AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowStart.{0}}"
							Text="{Binding WindowStartShort}"
							ToolTip="{Binding WindowStartText}" />
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTemplateColumn
				Width="90"
				MinWidth="90"
				CellStyle="{StaticResource Console.DataGrid.Cell}"
				Header="종료(KST)">
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowEnd.{0}}"
							FontSize="12"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding WindowEndShort}"
							ToolTip="{Binding WindowEndText}" />
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<!--  회차 — 열을 따로 두기에는 폭이 모자라 반복 칸 아래에 같이 낸다(자동화 식별자는 그대로 살아 있다)  -->

			<!--  취소 예약 — 누르면 확인 팝업이 먼저 뜬다(즉시 삭제하지 않는다). 빈 머리글은 무슨 칸인지 몰랐다(E-7 #10).  -->
			<DataGridTemplateColumn
				Width="50"
				MinWidth="50"
				CellStyle="{StaticResource Console.DataGrid.Cell.Flush}"
				Header="동작">
				<DataGridTemplateColumn.CellTemplate>
					<DataTemplate>
						<Button
							Margin="0,0,6,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.RowCancel.{0}}"
							AutomationProperties.Name="취소 예약"
							Click="OnCancelRow"
							Content="취소"
							IsEnabled="{Binding IsCancellable}"
							Style="{StaticResource Console.Button.Mini}"
							ToolTip="이 스케줄을 취소합니다 (기록은 남습니다)"
							Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVis}}" />
					</DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>
		</DataGrid.Columns>
		</DataGrid>

		<!--  빈 목록 — 왜 비었는지 말한다(정본 SB L2455 의 어휘)  -->
		<TextBlock
			Margin="24,120,24,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			AutomationProperties.AutomationId="Console.Suppression.List.Empty"
			FontSize="12.5"
			Foreground="{DynamicResource TextMutedBrush}"
			IsHitTestVisible="False"
			Text="{Binding EmptyText}"
			TextWrapping="Wrap"
			Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
	</Grid>
</UserControl>
