<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles.EventOverviewView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		이벤트 개요(T3) — 정본 window-layout-system-storyboard.html L1041 · L2503-2612.
		① 유형별 비중 ② 장비별 이벤트 ③ 시간대별 추이(좌우로 끌어 기간 선택, LiveChartsCore CartesianChart —
		레거시 DataChartPanelView.xaml 과 같은 관용구) ④ 탐지 출처.
		컨버터는 반드시 뷰 로컬로 등록한다 — Events.Ui/Resources/Resources.xaml 은 앱에 병합되지 않는다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<conv:TokenBrushConverter x:Key="TokenBrush" />
		<conv:HatchBrushConverter x:Key="HatchBrush" />
		<conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
		<conv:RatioToWidthConverter x:Key="RatioToWidth" />
		<conv:LeftThicknessConverter x:Key="LeftThickness" />

		<Style x:Key="OverviewCard" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="14,12" />
			<Setter Property="Margin" Value="0,0,10,10" />
		</Style>

		<Style x:Key="CardTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>

		<Style x:Key="CardNote" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,8,0,0" />
		</Style>

		<!--
			계열 견본 · 막대 칸 — 색이 아니라 형태로 가른다(꽉 찬 면 / 빗금 / 속이 빈 윤곽, 감사 E-3 #5).
			★ TokenBrushAssist.FillToken 은 SetResourceReference 로 Fill 을 <b>로컬 값</b>으로 건다 — 트리거의
			Fill 세터보다 우선이라, 트리거가 FillToken 을 먼저 비워야(null → ClearValue) 빗금 · 윤곽이 실제로 보인다.
			예전엔 이걸 안 비워 카메라 빗금이 한 번도 그려지지 않았다.
			DataContext = EventSliceViewModel 또는 EventBarSegment(둘 다 BrushKey · IsHatched · IsOutline).
		-->
		<Style x:Key="SeriesSwatch" TargetType="Rectangle">
			<Setter Property="conv:TokenBrushAssist.FillToken" Value="{Binding BrushKey}" />
			<Setter Property="RadiusX" Value="2" />
			<Setter Property="RadiusY" Value="2" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsHatched}" Value="True">
					<Setter Property="conv:TokenBrushAssist.FillToken" Value="{x:Null}" />
					<Setter Property="Fill" Value="{Binding BrushKey, Converter={StaticResource HatchBrush}}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsOutline}" Value="True">
					<Setter Property="conv:TokenBrushAssist.FillToken" Value="{x:Null}" />
					<Setter Property="Fill" Value="Transparent" />
					<Setter Property="conv:TokenBrushAssist.StrokeToken" Value="{Binding BrushKey}" />
					<Setter Property="StrokeThickness" Value="2" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Grid>
		<!--  불러오는 중 — 앱의 IsChartLoading 자리(정본 L2508)  -->
		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
			<ProgressBar
				Width="42"
				Height="42"
				IsIndeterminate="True"
				Style="{DynamicResource MaterialDesignCircularProgressBar}"
				Value="40" />
			<TextBlock
				Margin="0,10,0,0"
				Foreground="{DynamicResource TextSecondaryBrush}"
				Text="통계를 불러오는 중" />
		</StackPanel>

		<!--
			D-37 과 같은 결함군 — 유형별 비중 카드의 마지막 줄("…탐지 192 건 · 60%")이 하단 상태
			막대 윗선에 붙어 잘렸다. 안쪽 StackPanel 의 바닥 Margin(12) 은 스크롤 되는 내용물 <b>안</b>이라
			다 굴렸을 때도 여분을 안 남긴다 — 커널 정본(Generic.xaml Console.DetailPane 템플릿, 4785d422)
			과 같은 처방으로 나머지 12 를 <b>이 ScrollViewer 자신의 Margin</b> 에 얹는다. 이 뷰는 그 커널
			템플릿을 안 쓰는 평범한 ScrollViewer 라 D-37 이 자동으로 못 미쳤다 — 여기서 같은 값을 반복한다.
		-->
		<!--  아래에 더 있으면 끝을 흐린다 — 다음 카드 제목이 칸 아랫변에서 글자 한가운데가 잘려 결함처럼 보였다(실창 검토 #20)  -->
		<ScrollViewer
			Margin="0,0,0,12"
			HorizontalScrollBarVisibility="Disabled"
			ScrollChanged="OnOverviewScrollChanged"
			Style="{StaticResource Console.ScrollViewer}"
			VerticalScrollBarVisibility="Auto"
			Visibility="{Binding IsLoading, Converter={StaticResource NotBoolToVis}}">
			<StackPanel Margin="12,10,2,12">

				<!--  머리 — 총계 · 활성 장비  -->
				<Grid Margin="0,0,10,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<StackPanel AutomationProperties.AutomationId="Console.Events.Overview.Total">
						<TextBlock
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}">
							<Run Text="총 이벤트 · " /><Run Text="{Binding RangeText, Mode=OneWay}" />
						</TextBlock>
						<StackPanel Orientation="Horizontal">
							<TextBlock
								FontSize="34"
								FontWeight="Bold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding TotalText, Mode=OneWay}" />
							<TextBlock
								Margin="6,0,0,6"
								VerticalAlignment="Bottom"
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="건" />
						</StackPanel>
					</StackPanel>

					<StackPanel
						Grid.Column="1"
						HorizontalAlignment="Right"
						Orientation="Horizontal">
						<StackPanel Margin="18,0,0,0">
							<TextBlock
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="활성 센서" />
							<TextBlock
								FontSize="19"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding ActiveSensors, Mode=OneWay}" />
						</StackPanel>
						<StackPanel Margin="18,0,0,0">
							<TextBlock
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="활성 카메라" />
							<TextBlock
								FontSize="19"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding ActiveCameras, Mode=OneWay}" />
						</StackPanel>
						<StackPanel Margin="18,0,0,0">
							<TextBlock
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="활성 제어기" />
							<TextBlock
								FontSize="19"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding ActiveControllers, Mode=OneWay}" />
						</StackPanel>
					</StackPanel>
				</Grid>

				<TextBlock
					Margin="0,-6,10,10"
					FontSize="11.5"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding TotalNote, Mode=OneWay}"
					TextWrapping="Wrap" />

				<!--  ③ 시간대별 추이 — 좌우로 끌면 기간이 바뀐다(정본 all-windows-drag-wireframe.html L427)  -->
				<Border Style="{StaticResource OverviewCard}">
					<StackPanel>
						<DockPanel LastChildFill="False">
							<TextBlock
								DockPanel.Dock="Left"
								Style="{StaticResource CardTitle}"
								Text="시간대별 추이" />
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding IntervalText, Mode=OneWay}" />
							<TextBlock
								VerticalAlignment="Center"
								DockPanel.Dock="Right"
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="끌어서 기간 선택 (Esc 취소)" />
						</DockPanel>

						<!--
							플롯 호스트 — Border 는 peer 가 없어 자동화가 못 본다. 밖을 peer 있는 Label 로 감싼다(R13).
							★ Label 의 기본 HorizontalContentAlignment/VerticalContentAlignment 는 Stretch 가 아니라
							Left/Top 이다(Control 대부분과 달리 Label 만의 기본 스타일) — 안의 Border 가 Width 를
							스스로 정하지 않고 부모 폭에 맞춰 늘어나야(Stretch) 하는데, Label 이 그 늘어남을 주지 않고
							"제 desired size(=속이 비어 있으니 거의 0)" 만큼만 자리를 내준다. 그 결과 TrendHost.ActualWidth
							가 사실상 0에 머물러 예전 손그림 도형이 매번 width<=0 으로 빈 채 그려졌다 — 2026-09-23 실증 결함.
							창을 나중에 늘려도 Label 이 여전히 Stretch 를 안 주므로 자가 회복되지 않는다.
						-->
						<Label
							AutomationProperties.AutomationId="Console.Events.Overview.Trend"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Stretch"
							Padding="0">
						<Border
							x:Uid="TrendHost"
							Height="220"
							Background="Transparent"
							Cursor="SizeWE"
							Loaded="OnTrendLoaded"
							LostMouseCapture="OnTrendLostCapture"
							MouseMove="OnTrendMouseMove"
							PreviewMouseLeftButtonDown="OnTrendPressed"
							PreviewMouseLeftButtonUp="OnTrendReleased"
							ToolTip="가로로 끌어 기간을 고릅니다">
							<Grid>
								<!--
									차트 본체 — TrendHost(위) 가 여전히 드래그 캡처를 쥔다(코드비하인드 불변).
									ZoomMode="None" 이 핵심이다: 라이브러리 내장 팬/줌이 켜져 있으면 마우스다운 때
									차트가 제 캡처를 걸어 TrendHost 의 캡처를 빼앗아 드래그가 죽는다 — None 이면
									그 경로가 아예 실행되지 않는다(휠 줌도 꺼져 콘솔 스크롤과도 안 부딪힌다).
									DrawMargin 은 <b>지정하지 않는다</b>(Auto) — 고정 여백을 추측해 박던 예전 두 판
									모두 한글 글리프 높이·DPI·폰트 스케일을 몰라 라벨이 잘리거나 겹쳤다(세 번째
									실기 캡처까지). 대신 라이브러리가 스스로 잰 여백(OnChartLoaded 의
									CoreChart.DrawMarginLocation/DrawMarginSize)을 코드비하인드가 읽어 뷰모델의
									PlotLeft/PlotWidth 로 되먹인다 — 드래그가 차트를 따라가지, 차트가 추측을
									따라가지 않는다. 끄는 동안은 TrendHost 캡처가 마우스를 독점해 차트가
									MouseMove 를 못 받는다 — 호버 툴팁은 드래그 중엔 안 보인다(기존 띠+라벨이
									그 순간의 피드백을 대신한다).
								-->
								<lvc:CartesianChart
									behavior_inner:ChartThemeRefreshBehavior.IsEnabled="True"
									Loaded="OnChartLoaded"
									LegendPosition="Hidden"
									Series="{Binding Series}"
									TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
									TooltipPosition="Top"
									TooltipTextPaint="{Binding TooltipTextPaint}"
									TooltipTextSize="12"
									XAxes="{Binding XAxes}"
									YAxes="{Binding YAxes}"
									ZoomMode="None" />

								<!--  끄는 동안의 띠 — 색이 아니라 형태(파선 윤곽 + 옅은 면)로 보인다  -->
								<Border
									HorizontalAlignment="Left"
									Background="{DynamicResource TintInfoBrush}"
									BorderBrush="{DynamicResource PrimaryBrush}"
									BorderThickness="1"
									IsHitTestVisible="False"
									Opacity="0.65"
									Visibility="{Binding IsBandVisible, Converter={StaticResource BoolToVis}}"
									Width="{Binding BandWidth, Mode=OneWay}">
									<Border.Margin>
										<Binding Converter="{StaticResource LeftThickness}" Mode="OneWay" Path="BandLeft" />
									</Border.Margin>
								</Border>

								<!--  끄는 동안의 기간 글자  -->
								<Border
									Margin="0,6,8,0"
									Padding="8,3"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Background="{DynamicResource SurfaceBrush}"
									BorderBrush="{DynamicResource PrimaryBrush}"
									BorderThickness="1"
									CornerRadius="4"
									IsHitTestVisible="False"
									Visibility="{Binding IsBandVisible, Converter={StaticResource BoolToVis}}">
									<!--  TextBlock 은 UIA 트리에 안 나온다 — 읽기 전용 TextBox 로 낸다(R13)  -->
									<TextBox
										AutomationProperties.AutomationId="Console.Events.Overview.RangeLabel"
										Background="Transparent"
										BorderThickness="0"
										FontFamily="Consolas"
										FontSize="12"
										Foreground="{DynamicResource TextPrimaryBrush}"
										IsReadOnly="True"
										IsTabStop="False"
										Text="{Binding BandLabel, Mode=OneWay}" />
								</Border>
							</Grid>
						</Border>
						</Label>

						<!--  계열 칩 — 켜고 끈다. 카메라는 빗금(색이 아니라 형태)  -->
						<ItemsControl
							Margin="0,8,0,0"
							AutomationProperties.AutomationId="Console.Events.Overview.SeriesChips"
							ItemsSource="{Binding Slices}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<ToggleButton
										Margin="0,2,6,2"
										Padding="0"
										AutomationProperties.AutomationId="{Binding Spec.Key, StringFormat=Console.Events.Overview.Series.{0}}"
										IsChecked="{Binding IsOn, Mode=TwoWay}"
										Style="{x:Null}"
										ToolTip="{Binding Name}">
										<ToggleButton.Template>
											<ControlTemplate TargetType="ToggleButton">
												<Border
													Padding="9,3"
													Background="{DynamicResource SurfaceBrush}"
													BorderBrush="{DynamicResource BorderBrush}"
													BorderThickness="1"
													CornerRadius="11">
													<StackPanel Orientation="Horizontal">
														<Rectangle
															Width="16"
															Height="10"
															Margin="0,0,6,0"
															VerticalAlignment="Center"
															Style="{StaticResource SeriesSwatch}" />
														<TextBlock
															VerticalAlignment="Center"
															FontSize="12"
															Foreground="{DynamicResource TextPrimaryBrush}"
															Text="{Binding Name}" />
														<TextBlock
															Margin="6,0,0,0"
															VerticalAlignment="Center"
															FontFamily="Consolas"
															FontSize="12"
															Foreground="{DynamicResource TextSecondaryBrush}"
															Text="{Binding Count}" />
													</StackPanel>
													<Border.Style>
														<Style TargetType="Border">
															<Style.Triggers>
																<DataTrigger Binding="{Binding IsOn}" Value="False">
																	<Setter Property="Opacity" Value="0.45" />
																	<Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
												</Border>
											</ControlTemplate>
										</ToggleButton.Template>
									</ToggleButton>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!--  ① 유형별 비중  -->
					<Border Style="{StaticResource OverviewCard}">
						<StackPanel AutomationProperties.AutomationId="Console.Events.Overview.Mix">
							<TextBlock Style="{StaticResource CardTitle}" Text="유형별 비중" />
							<Border
								Height="18"
								Background="{DynamicResource SurfaceSunkenBrush}"
								CornerRadius="9">
								<ItemsControl ItemsSource="{Binding Slices}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border>
												<Border.Width>
													<MultiBinding Converter="{StaticResource RatioToWidth}">
														<Binding Path="Ratio" />
														<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
													</MultiBinding>
												</Border.Width>
												<Border.Style>
													<Style TargetType="Border">
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsOn}" Value="False">
																<Setter Property="Opacity" Value="0.25" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<Rectangle RadiusX="0" RadiusY="0" Style="{StaticResource SeriesSwatch}" />
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>

							<ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Slices}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<DockPanel Margin="0,3" LastChildFill="False">
											<Rectangle
												Width="16"
												Height="10"
												Margin="0,0,7,0"
												VerticalAlignment="Center"
												DockPanel.Dock="Left"
												Style="{StaticResource SeriesSwatch}" />
											<TextBlock
												VerticalAlignment="Center"
												DockPanel.Dock="Left"
												FontSize="12.5"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Text="{Binding Name}" />
											<TextBlock
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												FontSize="12"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding PercentText}" />
											<TextBlock
												Margin="0,0,12,0"
												VerticalAlignment="Center"
												DockPanel.Dock="Right"
												FontFamily="Consolas"
												FontSize="12.5"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{Binding Count}" />
										</DockPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Border
								Margin="0,8,0,0"
								Padding="9,5"
								Background="{DynamicResource SurfaceBrush}"
								CornerRadius="5">
								<TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
									<Run Text="침입 탐지(센서 + 카메라) " /><Run FontWeight="SemiBold" Text="{Binding DetectionTotal, Mode=OneWay}" /><Run Text=" 건 · " /><Run Text="{Binding DetectionPercentText, Mode=OneWay}" />
								</TextBlock>
							</Border>
						</StackPanel>
					</Border>

					<!--  ④ 탐지 출처 — 센서 vs 카메라(지금 '카메라 이벤트' 탭 KPI 자리)  -->
					<Border Grid.Column="1" Style="{StaticResource OverviewCard}">
						<StackPanel AutomationProperties.AutomationId="Console.Events.Overview.Source">
							<TextBlock Style="{StaticResource CardTitle}" Text="탐지 출처" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock
									Grid.Row="0"
									Grid.Column="1"
									Margin="0,0,0,6"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="센서" />
								<TextBlock
									Grid.Row="0"
									Grid.Column="2"
									Margin="0,0,0,6"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="카메라" />

								<TextBlock
									Grid.Row="1"
									Grid.Column="0"
									Margin="0,0,14,4"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="총 건수" />
								<TextBlock
									Grid.Row="1"
									Grid.Column="1"
									FontFamily="Consolas"
									FontSize="16"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding SensorDetection, Mode=OneWay}" />
								<TextBlock
									Grid.Row="1"
									Grid.Column="2"
									FontFamily="Consolas"
									FontSize="16"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding CameraDetection, Mode=OneWay}" />

								<TextBlock
									Grid.Row="2"
									Grid.Column="0"
									Margin="0,0,14,0"
									FontSize="12"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="일평균" />
								<TextBlock
									Grid.Row="2"
									Grid.Column="1"
									FontFamily="Consolas"
									FontSize="13"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding SensorDailyAverage, StringFormat={}{0:0.0}, Mode=OneWay}" />
								<TextBlock
									Grid.Row="2"
									Grid.Column="2"
									FontFamily="Consolas"
									FontSize="13"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding CameraDailyAverage, StringFormat={}{0:0.0}, Mode=OneWay}" />
							</Grid>

							<StackPanel Margin="0,10,0,0" Orientation="Horizontal">
								<TextBlock
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding SensorShareText, Mode=OneWay}" />
								<TextBlock
									Margin="12,0,0,0"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding CameraShareText, Mode=OneWay}" />
							</StackPanel>

							<TextBlock
								Style="{StaticResource CardNote}"
								Text="카메라 탐지도 탐지 합계에 포함됩니다." />
						</StackPanel>
					</Border>
				</Grid>

				<!--  ② 장비별 이벤트  -->
				<Border Style="{StaticResource OverviewCard}">
					<StackPanel AutomationProperties.AutomationId="Console.Events.Overview.ByDevice">
						<DockPanel LastChildFill="False">
							<TextBlock
								DockPanel.Dock="Left"
								Style="{StaticResource CardTitle}"
								Text="장비별 이벤트" />
							<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
								<RadioButton
									Margin="0,0,6,0"
									AutomationProperties.AutomationId="Console.Events.Overview.Group.Controller"
									Content="제어기"
									IsChecked="{Binding IsControllerGroup, Mode=OneWay}"
									Style="{StaticResource Console.Tab}"
									Click="OnControllerGroup" />
								<RadioButton
									Margin="0,0,6,0"
									AutomationProperties.AutomationId="Console.Events.Overview.Group.Camera"
									Content="카메라"
									IsChecked="{Binding IsCameraGroup, Mode=OneWay}"
									Style="{StaticResource Console.Tab}"
									Click="OnCameraGroup" />
								<!-- 함체 · 통문: 운영 이벤트(문 개폐 · 환경 경보)가 실리는 유일한 장비별 자리(서버 by_device.enclosures/gates) -->
								<RadioButton
									AutomationProperties.AutomationId="Console.Events.Overview.Group.Facility"
									Content="함체·통문"
									IsChecked="{Binding IsFacilityGroup, Mode=OneWay}"
									Style="{StaticResource Console.Tab}"
									Click="OnFacilityGroup" />
							</StackPanel>
						</DockPanel>

						<TextBlock
							FontSize="12"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="이 기간에 집계된 장비가 없습니다."
							Visibility="{Binding HasBars, Converter={StaticResource NotBoolToVis}}" />

						<ItemsControl ItemsSource="{Binding Bars}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Button
										Margin="0,2"
										Padding="0"
										Background="Transparent"
										BorderThickness="0"
										Click="OnBarClick"
										Cursor="Hand"
										HorizontalContentAlignment="Stretch"
										Template="{StaticResource Console.Button.TransparentRow}"
										ToolTip="이 장비의 내역으로 이동합니다">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="150" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="46" />
											</Grid.ColumnDefinitions>
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12.5"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Text="{Binding Name}"
												TextTrimming="CharacterEllipsis" />
											<Border
												Grid.Column="1"
												Height="14"
												VerticalAlignment="Center"
												Background="{DynamicResource SurfaceSunkenBrush}"
												CornerRadius="7">
												<ItemsControl ItemsSource="{Binding Segments}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Orientation="Horizontal" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border>
																<Border.Width>
																	<MultiBinding Converter="{StaticResource RatioToWidth}">
																		<Binding Path="Ratio" />
																		<Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
																	</MultiBinding>
																</Border.Width>
																<Rectangle RadiusX="0" RadiusY="0" Style="{StaticResource SeriesSwatch}" />
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</Border>
											<TextBlock
												Grid.Column="2"
												VerticalAlignment="Center"
												FontFamily="Consolas"
												FontSize="12.5"
												Foreground="{DynamicResource TextSecondaryBrush}"
												Text="{Binding Total}"
												TextAlignment="Right" />
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<TextBlock Style="{StaticResource CardNote}" Text="{Binding DeviceGroupNote, Mode=OneWay}" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
