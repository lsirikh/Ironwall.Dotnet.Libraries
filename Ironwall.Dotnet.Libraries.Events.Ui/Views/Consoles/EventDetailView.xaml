<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles.EventDetailView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		이벤트 상세 — 정본 window-layout-system-storyboard.html L1084-1095(편집 경계) · L2703-2757(렌더).
		읽기가 기본이고 상자로 그린 칸(판정)만 고칠 수 있다. 색이 아니라 '상자 유무'로 가른다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />

		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
	</UserControl.Resources>

	<Grid Margin="14,10,12,10">
		<!--  선택 없음  -->
		<TextBlock
			VerticalAlignment="Top"
			AutomationProperties.AutomationId="Console.Events.Detail.Empty"
			FontSize="12.5"
			Foreground="{DynamicResource TextMutedBrush}"
			Text="{Binding EmptyHint, Mode=OneWay}"
			TextWrapping="Wrap"
			Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

		<!--  여러 개 — 판정 칸 대신 고른 목록을 보이고 트레이로 보낸다  -->
		<StackPanel Visibility="{Binding IsMultiple, Converter={StaticResource BoolToVis}}">
			<TextBlock
				Margin="0,0,0,6"
				Style="{StaticResource SectionTitle}"
				Text="고른 이벤트" />
			<ItemsControl
				AutomationProperties.AutomationId="Console.Events.Detail.SelectedList"
				ItemsSource="{Binding SelectedSummary}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Margin="0,2"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding}"
							TextTrimming="CharacterEllipsis" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>

		<!--  한 개  -->
		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<ScrollViewer.Style>
				<Style BasedOn="{StaticResource Console.ScrollViewer}" TargetType="ScrollViewer">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsEmpty}" Value="False" />
								<Condition Binding="{Binding IsMultiple}" Value="False" />
							</MultiDataTrigger.Conditions>
							<Setter Property="Visibility" Value="Visible" />
						</MultiDataTrigger>
					</Style.Triggers>
				</Style>
			</ScrollViewer.Style>

			<StackPanel>
				<!--  스냅샷 — 빈 상태 안내가 약속한 것(R5). 없으면 기본 그림 + '없음'  -->
				<Border
					Height="150"
					Margin="0,0,0,12"
					AutomationProperties.AutomationId="Console.Events.Detail.Snapshot"
					Background="{DynamicResource SurfaceSunkenBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="1"
					CornerRadius="5"
					Visibility="{Binding ShowSnapshotBox, Converter={StaticResource BoolToVis}}">
					<Grid>
						<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Visibility="{Binding HasSnapshot, Converter={StaticResource NotBoolToVis}}">
							<md:PackIcon
								Width="26"
								Height="26"
								HorizontalAlignment="Center"
								Kind="ImageOffOutline"
								Opacity="0.4" />
							<TextBlock
								Margin="0,4,0,0"
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="스냅샷 없음" />
						</StackPanel>
						<Image
							Margin="4"
							RenderOptions.BitmapScalingMode="HighQuality"
							Source="{Binding Snapshot, Mode=OneWay}"
							Stretch="Uniform"
							Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}" />
					</Grid>
				</Border>

				<ItemsControl ItemsSource="{Binding Sections}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="0,0,0,14">
								<DockPanel Margin="0,0,0,6" LastChildFill="False">
									<TextBlock
										DockPanel.Dock="Left"
										Style="{StaticResource SectionTitle}"
										Text="{Binding Title}" />
									<Border
										Margin="8,0,0,0"
										Padding="6,1"
										VerticalAlignment="Center"
										Background="{DynamicResource SurfaceSunkenBrush}"
										CornerRadius="3"
										DockPanel.Dock="Left"
										Visibility="{Binding HasLockNote, Converter={StaticResource BoolToVis}}">
										<TextBlock
											FontSize="10.5"
											Foreground="{DynamicResource TextMutedBrush}"
											Text="{Binding LockNote}" />
									</Border>
								</DockPanel>

								<ItemsControl ItemsSource="{Binding Fields}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,3">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="86" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock
													VerticalAlignment="Center"
													FontSize="12"
													Foreground="{DynamicResource TextMutedBrush}"
													Text="{Binding Label}" />

												<!--  발생 기록 — 맨 글자(상자 없음)  -->
												<TextBlock
													Grid.Column="1"
													VerticalAlignment="Center"
													FontSize="12.5"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding Text}"
													TextTrimming="CharacterEllipsis"
													ToolTip="{Binding LockReason}"
													ToolTipService.ShowOnDisabled="True"
													Visibility="{Binding IsPlain, Converter={StaticResource BoolToVis}}" />

												<!--  판정 — 고를 수 있는 칸(콤보)  -->
												<ComboBox
													Grid.Column="1"
													AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Events.Detail.Field.{0}}"
													FontSize="12.5"
													IsEditable="False"
													ItemsSource="{Binding Options}"
													SelectedItem="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />

												<!--  판정 — 글자로 고치는 칸  -->
												<TextBox
													Grid.Column="1"
													AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Events.Detail.Text.{0}}"
													FontSize="12.5"
													Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													TextWrapping="Wrap"
													Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<TextBlock
									Margin="0,6,0,0"
									FontSize="11.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding Note}"
									TextWrapping="Wrap"
									Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  조치 내역 — 열 때 한 번 부른다(정본 E-D4). 불러오는 중 · 실패 · 0건을 가른다  -->
				<StackPanel Margin="0,0,0,14" DataContext="{Binding Actions}">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Visible" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding State}" Value="NotRequested">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>

					<TextBlock
						Margin="0,0,0,6"
						AutomationProperties.AutomationId="Console.Events.Detail.ActionsTitle"
						Style="{StaticResource SectionTitle}"
						Text="{Binding Title}" />

					<ProgressBar
						Width="20"
						Height="20"
						HorizontalAlignment="Left"
						IsIndeterminate="True"
						Style="{DynamicResource MaterialDesignCircularProgressBar}"
						Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
						Value="40" />

					<c:NotReceivedBox
						ReloadHint="{Binding FailureReason}"
						SectionName="조치 내역"
						Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />

					<TextBlock
						FontSize="12"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="아직 조치보고가 없습니다"
						Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

					<ItemsControl AutomationProperties.AutomationId="Console.Events.Detail.Actions" ItemsSource="{Binding Lines}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="18" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										FontFamily="Consolas"
										FontSize="11.5"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Index}" />
									<StackPanel Grid.Column="1">
										<StackPanel Orientation="Horizontal">
											<TextBlock
												FontFamily="Consolas"
												FontSize="11.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding When}" />
											<TextBlock
												Margin="8,0,0,0"
												FontSize="11.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding User}" />
										</StackPanel>
										<TextBlock
											FontSize="12.5"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding Content}"
											TextWrapping="Wrap" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock
						Margin="0,6,0,0"
						FontSize="11.5"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="조치는 고치지 않고 한 건씩 더 쌓습니다 — 중복 조치보고는 허용입니다."
						TextWrapping="Wrap"
						Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}}" />
				</StackPanel>

				<!--  범례 — 색이 아니라 상자 유무로 가른다  -->
				<Border
					Padding="9,6"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="1"
					CornerRadius="5"
					Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
					<StackPanel>
						<TextBlock
							FontSize="11.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="상자로 그린 칸 = 고칠 수 있는 판정" />
						<TextBlock
							FontSize="11.5"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="맨 글자 = 발생 기록 · 측정값 — 고치지 않습니다" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
