<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles.EventDetailView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		이벤트 상세 — 정본 window-layout-system-storyboard.html L1084-1095(편집 경계) · L2703-2757(렌더).
		읽기가 기본이고 상자로 그린 칸(판정)만 고칠 수 있다. 색이 아니라 '상자 유무'로 가른다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />

		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
	</UserControl.Resources>

	<Grid Margin="14,10,12,10">
		<!--  선택 없음  -->
		<TextBlock
			VerticalAlignment="Top"
			AutomationProperties.AutomationId="Console.Events.Detail.Empty"
			FontSize="12.5"
			Foreground="{DynamicResource TextMutedBrush}"
			Text="{Binding EmptyHint, Mode=OneWay}"
			TextWrapping="Wrap"
			Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

		<!--  여러 개 — 판정 칸 대신 고른 목록을 보이고 트레이로 보낸다  -->
		<StackPanel Visibility="{Binding IsMultiple, Converter={StaticResource BoolToVis}}">
			<TextBlock
				Margin="0,0,0,6"
				Style="{StaticResource SectionTitle}"
				Text="고른 이벤트" />
			<ItemsControl
				AutomationProperties.AutomationId="Console.Events.Detail.SelectedList"
				ItemsSource="{Binding SelectedSummary}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Margin="0,2"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding}"
							TextTrimming="CharacterEllipsis" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<!--  [N건 트레이에 담기] — 툴바 · 드래그와 같은 담기 함수(정본 SB L2729)  -->
			<Button
				Margin="0,10,0,0"
				HorizontalAlignment="Left"
				AutomationProperties.AutomationId="Console.Events.Detail.Action.Queue"
				Click="OnQueueToTray"
				Content="{Binding ReportButtonText}"
				Style="{StaticResource Console.Button.Primary}"
				Visibility="{Binding ShowQueueAction, Converter={StaticResource BoolToVis}}" />
		</StackPanel>

		<!--  한 개  -->
		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<ScrollViewer.Style>
				<Style BasedOn="{StaticResource Console.ScrollViewer}" TargetType="ScrollViewer">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding IsEmpty}" Value="False" />
								<Condition Binding="{Binding IsMultiple}" Value="False" />
							</MultiDataTrigger.Conditions>
							<Setter Property="Visibility" Value="Visible" />
						</MultiDataTrigger>
					</Style.Triggers>
				</Style>
			</ScrollViewer.Style>

			<StackPanel>
				<!--
					동작 줄 — 정본 SB L2703-2731 · PRD FR-54. 동작이 있는 단추만 보인다(없는 기능은 두지 않는다 —
					[지도에서 보기] 는 지도 쪽에 장비로 옮기는 메시지가 없어 빠졌다). 상세 폭(300~480)에서 넘치면 줄을 바꾼다.
				-->
				<WrapPanel
					Margin="0,0,0,10"
					Orientation="Horizontal"
					Visibility="{Binding HasActionRow, Converter={StaticResource BoolToVis}}">
					<Button
						Margin="0,0,6,6"
						AutomationProperties.AutomationId="Console.Events.Detail.Action.Report"
						Click="OnReport"
						Content="{Binding ReportButtonText}"
						Style="{StaticResource Console.Button.Primary}"
						ToolTip="조치보고 창을 엽니다"
						Visibility="{Binding ShowReportAction, Converter={StaticResource BoolToVis}}" />
					<!--
						실창 검토 #21 — 조치가 생기면 [조치보고 추가][조치 내역 N건][탐지 신호 이력] 세 개(약 327)가 상세 기본 폭
						340 의 내용 폭(약 271)을 넘어 두 줄로 꺾였다. [조치 내역]은 아래 절로 내려가는 바로가기라 아이콘 + 건수로
						줄이고(뜻은 툴팁 · 자동화 이름이 말한다), [탐지 신호 이력]은 "신호 이력" 으로 줄인다 — 합 약 266, 한 줄.
						Content 는 object 라 Binding.StringFormat 이 먹지 않는다(숫자만 찍혔다) — 글자는 TextBlock 이 만든다.
					-->
					<Button
						Margin="0,0,6,6"
						AutomationProperties.AutomationId="Console.Events.Detail.Action.Actions"
						AutomationProperties.Name="{Binding Actions.Count, StringFormat=조치 내역 {0}건}"
						Click="OnJumpToActions"
						Style="{StaticResource Console.Button}"
						ToolTip="{Binding Actions.Count, StringFormat=조치 내역 {0}건 — 아래로 내려갑니다}"
						Visibility="{Binding Actions.HasLines, Converter={StaticResource BoolToVis}}">
						<StackPanel Orientation="Horizontal">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,4,0"
								VerticalAlignment="Center"
								Kind="History" />
							<TextBlock VerticalAlignment="Center" Text="{Binding Actions.Count, StringFormat={}{0}건}" />
						</StackPanel>
					</Button>
					<Button
						Margin="0,0,6,6"
						AutomationProperties.AutomationId="Console.Events.Detail.Action.History"
						AutomationProperties.Name="탐지 신호 이력"
						Click="OnDetectionHistory"
						Content="신호 이력"
						Style="{StaticResource Console.Button}"
						ToolTip="이 센서의 탐지 신호 이력 창을 엽니다"
						Visibility="{Binding ShowHistoryAction, Converter={StaticResource BoolToVis}}" />
					<Button
						Margin="0,0,6,6"
						AutomationProperties.AutomationId="Console.Events.Detail.Action.Origin"
						Click="OnOpenOrigin"
						Content="원본 열기"
						Style="{StaticResource Console.Button}"
						ToolTip="이 조치의 원본 이벤트를 그 목록에서 엽니다"
						Visibility="{Binding ShowOpenOriginAction, Converter={StaticResource BoolToVis}}" />
				</WrapPanel>

				<!--  스냅샷 — 빈 상태 안내가 약속한 것(R5). 없으면 기본 그림 + '없음'  -->
				<Border
					Height="150"
					Margin="0,0,0,12"
					AutomationProperties.AutomationId="Console.Events.Detail.Snapshot"
					Background="{DynamicResource SurfaceSunkenBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="1"
					CornerRadius="5"
					Visibility="{Binding ShowSnapshotBox, Converter={StaticResource BoolToVis}}">
					<Grid>
						<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Visibility="{Binding HasSnapshot, Converter={StaticResource NotBoolToVis}}">
							<md:PackIcon
								Width="26"
								Height="26"
								HorizontalAlignment="Center"
								Kind="ImageOffOutline"
								Opacity="0.4" />
							<TextBlock
								Margin="0,4,0,0"
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="스냅샷 없음" />
						</StackPanel>
						<Image
							Margin="4"
							RenderOptions.BitmapScalingMode="HighQuality"
							Source="{Binding Snapshot, Mode=OneWay}"
							Stretch="Uniform"
							Visibility="{Binding HasSnapshot, Converter={StaticResource BoolToVis}}" />
					</Grid>
				</Border>

				<ItemsControl ItemsSource="{Binding Sections}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Margin="0,0,0,14">
								<DockPanel Margin="0,0,0,6" LastChildFill="False">
									<TextBlock
										DockPanel.Dock="Left"
										Style="{StaticResource SectionTitle}"
										Text="{Binding Title}" />
									<Border
										Margin="8,0,0,0"
										Padding="6,1"
										VerticalAlignment="Center"
										Background="{DynamicResource SurfaceSunkenBrush}"
										CornerRadius="3"
										DockPanel.Dock="Left"
										Visibility="{Binding HasLockNote, Converter={StaticResource BoolToVis}}">
										<TextBlock
											FontSize="10.5"
											Foreground="{DynamicResource TextMutedBrush}"
											Text="{Binding LockNote}" />
									</Border>
								</DockPanel>

								<ItemsControl ItemsSource="{Binding Fields}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,3">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="86" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock
													VerticalAlignment="Center"
													FontSize="12"
													Foreground="{DynamicResource TextMutedBrush}"
													Text="{Binding Label}" />

												<!--  발생 기록 — 맨 글자(상자 없음)  -->
												<TextBlock
													Grid.Column="1"
													VerticalAlignment="Center"
													FontSize="12.5"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding Text}"
													TextTrimming="CharacterEllipsis"
													ToolTip="{Binding LockReason}"
													ToolTipService.ShowOnDisabled="True"
													Visibility="{Binding IsPlain, Converter={StaticResource BoolToVis}}" />

												<!--  판정 — 고를 수 있는 칸(콤보)  -->
												<ComboBox
													Grid.Column="1"
													AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Events.Detail.Field.{0}}"
													FontSize="12.5"
													IsEditable="False"
													ItemsSource="{Binding Options}"
													SelectedItem="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
														Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />

												<!--  판정 — 글자로 고치는 칸  -->
												<TextBox
													Grid.Column="1"
													AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Events.Detail.Text.{0}}"
													FontSize="12.5"
													Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													TextWrapping="Wrap"
													Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<TextBlock
									Margin="0,6,0,0"
									FontSize="11.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding Note}"
									TextWrapping="Wrap"
									Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  조치 내역 — 열 때 한 번 부른다(정본 E-D4). 불러오는 중 · 실패 · 0건을 가른다  -->
				<StackPanel Margin="0,0,0,14" DataContext="{Binding Actions}">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Setter Property="Visibility" Value="Visible" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding State}" Value="NotRequested">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>

					<TextBlock
						Margin="0,0,0,6"
						AutomationProperties.AutomationId="Console.Events.Detail.ActionsTitle"
						Style="{StaticResource SectionTitle}"
						Text="{Binding Title}" />

					<ProgressBar
						Width="20"
						Height="20"
						HorizontalAlignment="Left"
						IsIndeterminate="True"
						Style="{DynamicResource MaterialDesignCircularProgressBar}"
						Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
						Value="40" />

					<c:NotReceivedBox
						ReloadHint="{Binding FailureReason}"
						SectionName="조치 내역"
						Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
					<Button
						Margin="0,6,0,0"
						HorizontalAlignment="Left"
						AutomationProperties.AutomationId="Console.Events.Detail.ActionsReload"
						Click="OnReloadActions"
						Content="다시 불러오기"
						Style="{StaticResource Console.Button}"
						Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />

					<TextBlock
						FontSize="12"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="아직 조치보고가 없습니다"
						Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

					<ItemsControl AutomationProperties.AutomationId="Console.Events.Detail.Actions" ItemsSource="{Binding Lines}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="18" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										FontFamily="Consolas"
										FontSize="11.5"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding Index}" />
									<StackPanel Grid.Column="1">
										<StackPanel Orientation="Horizontal">
											<TextBlock
												FontFamily="Consolas"
												FontSize="11.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding When}" />
											<TextBlock
												Margin="8,0,0,0"
												FontSize="11.5"
												Foreground="{DynamicResource TextMutedBrush}"
												Text="{Binding User}" />
										</StackPanel>
										<TextBlock
											FontSize="12.5"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding Content}"
											TextWrapping="Wrap" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock
						Margin="0,6,0,0"
						FontSize="11.5"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="판단이 바뀌면 조치보고를 한 건 더 추가하세요."
						TextWrapping="Wrap"
						Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}}" />
				</StackPanel>

				<!--  범례 — 색이 아니라 상자 유무로 가른다  -->
				<Border
					Padding="9,6"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="1"
					CornerRadius="5"
					Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
					<!--  정본 LEGEND(SB L2686) — 두 견본을 형태(상자 유무)로 보인다  -->
					<WrapPanel Orientation="Horizontal">
						<Border
							Width="14"
							Height="10"
							Margin="0,0,5,0"
							VerticalAlignment="Center"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="2" />
						<TextBlock
							Margin="0,0,12,0"
							VerticalAlignment="Center"
							FontSize="11.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="고칠 수 있는 판정" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="11.5"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="그 밖은 발생 기록(수정 불가)" />
					</WrapPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
