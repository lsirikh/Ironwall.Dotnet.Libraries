<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles.SuppressionDrawerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sup="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Consoles.Suppression"
	xmlns:theme="clr-namespace:Ironwall.Dotnet.Libraries.Theme.Themes;assembly=Ironwall.Dotnet.Libraries.Theme"
	FontFamily="{DynamicResource MaterialDesignFont}"
	AutomationProperties.AutomationId="Console.Suppression.Drawer"
	Focusable="True"
	PreviewKeyDown="OnPreviewKeyDown">
	<!--
		억제 편집 서랍 — 정본 window-layout-system-storyboard.html
		L738-742(.slide CSS: 오른쪽 · width min(780px,94%) · 머리 44 / 본문 / 바닥 3단) ·
		L743-753(.form2 두 칸 · .bx 32px 박스 입력 · .days 요일칩 · .trayb 칩 트레이) ·
		L2869-2884(마크업: 작업명 · 대상유형·범위 · 반복 · 유효기간 · 요일 · 일일시각 · 요약 · 대상 트레이 · 취소/저장) ·
		L1028("두 칸 폼은 오른쪽 칸에 들어가지 않아 같은 창 안의 780px 서랍") · L1122 결정 E-D7.
		드래그 정본: all-windows-drag-wireframe.html L304-306 · L420(저장에 포함 1회).

		스크림은 콘솔 '몸통' 만 덮는다 — 머리띠(40)는 호스트가 비워 둔다.
		깨끗하면 ESC 로 닫히고, 미적용 변경이 있으면 닫지 않고 바닥이 흔들린다.
		x:Name 은 쓰지 않는다 — 계측 · 요소 찾기는 AutomationId 로만 한다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
		<local:DrawerWidthConverter x:Key="DrawerWidth" />

		<!--  요일 칩 — 켜지면 채워진다(SB L748-750)  -->
		<Style x:Key="DayChip" TargetType="ToggleButton">
			<Setter Property="Width" Value="32" />
			<Setter Property="Height" Value="28" />
			<Setter Property="Margin" Value="0,0,4,0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border
							x:Name="Chip"
							Background="{DynamicResource SurfaceBrush}"
							BorderBrush="{DynamicResource DividerBrush}"
							BorderThickness="1"
							CornerRadius="5">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Chip" Property="Background" Value="{DynamicResource PrimaryBrush}" />
								<Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
								<Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
								<Setter Property="FontWeight" Value="SemiBold" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--
			U-14 — 옛 LocalPrimaryButton/LocalGhostButton(MD Raised/Flat 위의 꺼짐 임시 보정)은 커널
			Console.Button.Primary/.Ghost 로 옮기고 지웠다 — 그 주석이 약속한 대로(중복 정의 금지).
		-->

		<!--  칸 제목 (SB .bx 의 라벨)  -->
		<Style x:Key="BoxLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Margin" Value="0,0,0,3" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		</Style>
	</UserControl.Resources>

	<!--  '열림' 은 UserControl 의 Visibility 로 낸다 — 그래야 UIA 트리에 서랍이 '있다/없다' 로 보인다.
	      (Border 는 peer 가 없어 앵커가 되지 못하고, 늘 보이는 UserControl 은 '열림' 을 뜻하지 못한다.)  -->
	<!--
		'열림' 은 이 UserControl 의 Visibility 로 낸다 — 그래야 UIA 트리에 서랍이 '있다/없다' 로 보인다.
		⚠ Root 요소의 속성에서는 <c>StaticResource</c> 가 자기 Resources 를 아직 못 본다(파싱 순서) —
		   그래서 컨버터가 아니라 Style 의 DataTrigger 로 쓴다. 기본값 Collapsed 라 주입이 없어도 화면을 덮지 않는다.
	-->
	<UserControl.Style>
		<Style TargetType="UserControl">
			<Setter Property="Visibility" Value="Collapsed" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsOpen}" Value="True">
					<Setter Property="Visibility" Value="Visible" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Style>

	<Grid>

		<!--  스크림 — 누르면 닫기를 '시도' 한다(미적용 변경이 있으면 막힌다)  -->
		<Border
			AutomationProperties.AutomationId="Console.Suppression.Drawer.Scrim"
			Background="{DynamicResource ScrimModalBrush}"
			MouseLeftButtonDown="OnScrimClick" />

		<!--  서랍 본체 — 오른쪽에 붙는다. 폭 min(780, 창폭 − 24)  -->
		<Border
			HorizontalAlignment="Right"
			TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
			KeyboardNavigation.ControlTabNavigation="Cycle"
			KeyboardNavigation.DirectionalNavigation="Contained"
			KeyboardNavigation.TabNavigation="Cycle"
			Background="{DynamicResource SurfaceAltBrush}"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="2,0,0,0"
			Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource DrawerWidth}}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="44" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  ── 머리 (SB L2869) ─────────────────────────────────────  -->
				<Border
					Padding="16,0,8,0"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,0,0,1">
					<!--  2열(*/Auto) — 긴 작업명이 들어와도 ✕ 가 줄 밖으로 밀리지 않는다  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
							<TextBlock
								AutomationProperties.AutomationId="Console.Suppression.Drawer.Title"
								FontSize="15"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding HeaderText}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock
								Margin="10,0,0,0"
								VerticalAlignment="Center"
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="저장 전까지는 적용되지 않습니다"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<Button
							Grid.Column="1"
							AutomationProperties.AutomationId="Console.Suppression.Drawer.Close"
							Click="OnClose"
							Style="{StaticResource Console.Button.Icon}"
							ToolTip="닫기 (Esc)">
							<md:PackIcon Kind="Close" />
						</Button>
					</Grid>
				</Border>

				<!--  ── 본문: 확정 두 칸 폼 (SB L743 .form2) ────────────────  -->
				<ScrollViewer
					Grid.Row="1"
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
					<!--  MDIX 암시 ScrollViewer 스타일이 Padding 을 삼킨다 — 안쪽 패널에 여백을 준다  -->
					<Grid Margin="16">
						<!--  두 칸 다 비례로 줄인다 — 오른쪽을 340 에 고정하면 좁은 폭에서 왼쪽 폼(요일 칩 일곱)이 잘린다  -->
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.05*" MinWidth="0" />
							<ColumnDefinition Width="18" />
							<ColumnDefinition Width="*" MinWidth="0" />
						</Grid.ColumnDefinitions>

						<!--  왼쪽 칸 — 일정  -->
						<StackPanel>

							<TextBlock Style="{StaticResource BoxLabel}" Text="작업명 *" />
							<TextBox
								Height="32"
								AutomationProperties.AutomationId="Console.Suppression.Form.Name"
								CaretBrush="{DynamicResource TextPrimaryBrush}"
								FontSize="13"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								VerticalContentAlignment="Center" />

							<TextBlock
								Margin="0,14,0,3"
								Style="{StaticResource BoxLabel}"
								Text="대상 유형 * · 억제 범위 *" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="8" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<ComboBox
									Height="32"
									AutomationProperties.AutomationId="Console.Suppression.Form.TargetType"
									FontSize="13"
									Foreground="{DynamicResource TextPrimaryBrush}"
									SelectedValue="{Binding TargetType, Mode=TwoWay}"
									SelectedValuePath="Tag">
									<ComboBoxItem
										AutomationProperties.AutomationId="Console.Suppression.Form.TargetType.Device"
										Content="장비"
										Tag="device" />
									<ComboBoxItem
										AutomationProperties.AutomationId="Console.Suppression.Form.TargetType.Group"
										Content="그룹"
										Tag="group" />
									<ComboBoxItem
										AutomationProperties.AutomationId="Console.Suppression.Form.TargetType.All"
										Content="전체 대상"
										Tag="all" />
								</ComboBox>
								<ComboBox
									Grid.Column="2"
									Height="32"
									AutomationProperties.AutomationId="Console.Suppression.Form.EventScope"
									FontSize="13"
									Foreground="{DynamicResource TextPrimaryBrush}"
									SelectedValue="{Binding EventScope, Mode=TwoWay}"
									SelectedValuePath="Tag">
									<ComboBoxItem Content="전체" Tag="all" />
									<ComboBoxItem Content="탐지" Tag="detection" />
									<ComboBoxItem Content="장애" Tag="malfunction" />
									<ComboBoxItem Content="연결" Tag="connection" />
									<!--  서버 EnumSuppressionEventScope 는 5값이다(app/utils/enums.py:295-302) — 하나라도 빠지면
									      그 스케줄을 열 때 콤보가 매칭에 실패해 범위가 조용히 '전체' 로 넓어진다  -->
									<ComboBoxItem Content="운영" Tag="operation" />
								</ComboBox>
							</Grid>

							<!--  감지/감시 — 그룹 · 전체에서만 뜻이 있다(서버 target_side)  -->
							<StackPanel Visibility="{Binding ShowTargetSide, Converter={StaticResource BoolToVis}}">
								<TextBlock
									Margin="0,14,0,3"
									Style="{StaticResource BoxLabel}"
									Text="감지 / 감시" />
								<ComboBox
									Height="32"
									AutomationProperties.AutomationId="Console.Suppression.Form.TargetSide"
									FontSize="13"
									Foreground="{DynamicResource TextPrimaryBrush}"
									SelectedValue="{Binding TargetSide, Mode=TwoWay}"
									SelectedValuePath="Tag">
									<ComboBoxItem Content="감지 + 감시" Tag="both" />
									<ComboBoxItem Content="감지" Tag="detection" />
									<ComboBoxItem Content="감시" Tag="surveillance" />
								</ComboBox>
							</StackPanel>

							<TextBlock
								Margin="0,14,0,3"
								Style="{StaticResource BoxLabel}"
								Text="반복" />
							<StackPanel Orientation="Horizontal">
								<RadioButton
									Margin="0,0,12,0"
									AutomationProperties.AutomationId="Console.Suppression.Form.Recurrence.OneShot"
									Content="단발"
									FontSize="13"
									GroupName="SuppressionRecurrence"
									IsChecked="{Binding IsOneShot, Mode=TwoWay}"
									IsEnabled="{Binding CanEditRecurrence}"
									Style="{StaticResource Console.RadioButton}" />
								<RadioButton
									AutomationProperties.AutomationId="Console.Suppression.Form.Recurrence.Weekly"
									Content="주간 반복"
									FontSize="13"
									GroupName="SuppressionRecurrence"
									IsChecked="{Binding IsWeekly, Mode=TwoWay}"
									IsEnabled="{Binding CanEditRecurrence}"
									Style="{StaticResource Console.RadioButton}" />
							</StackPanel>
							<TextBlock
								Margin="0,4,0,0"
								AutomationProperties.AutomationId="Console.Suppression.Form.Recurrence.Lock"
								FontSize="11.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding RecurrenceLockText}"
								TextWrapping="Wrap" />

							<TextBlock
								Margin="0,14,0,3"
								Style="{StaticResource BoxLabel}"
								Text="유효기간 (KST) *" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<!--
									LostFocus 는 일부러 둔다(E-8 #7 검토) — VM setter 가 읽히는 순간 "yyyy-MM-dd HH:mm" 으로 고쳐 쓴다.
									PropertyChanged(+Delay) 로 바꾸면 "2026-09-2" 를 치다 멈춘 순간 2026-09-02 00:00 으로 바뀌어
									입력 중인 글자를 빼앗는다. 요약 줄은 칸을 떠날 때(Tab · 다른 칸 클릭) 따라온다.
								-->
								<TextBox
									Height="32"
									md:HintAssist.Hint="YYYY-MM-DD HH:MM"
									AutomationProperties.AutomationId="Console.Suppression.Form.WindowStart"
									CaretBrush="{DynamicResource TextPrimaryBrush}"
									FontFamily="{DynamicResource MonoFont}"
									FontSize="12.5"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding WindowStartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
									VerticalContentAlignment="Center" />
								<TextBlock
									Grid.Column="1"
									Margin="8,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="~" />
								<Grid Grid.Column="2">
									<TextBox
										Height="32"
										md:HintAssist.Hint="YYYY-MM-DD HH:MM"
										AutomationProperties.AutomationId="Console.Suppression.Form.WindowEnd"
										CaretBrush="{DynamicResource TextPrimaryBrush}"
										FontFamily="{DynamicResource MonoFont}"
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding WindowEndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
										VerticalContentAlignment="Center"
										Visibility="{Binding IsUnlimited, Converter={StaticResource NotBoolToVis}}" />
									<!--
										U-14 — 옆 입력칸과 같은 높이(32 — 옛 MinHeight 36 은 한 줄에서 4px 튀었다). 좁은 서랍(900)에서는
										칸이 글자보다 좁아 "없음" 이 글자 중간에서 잘렸다 — 말줄임 + 툴팁으로 전체 문장을 남긴다.
									-->
									<Border
										Height="32"
										Background="{DynamicResource SurfaceSunkenBrush}"
										CornerRadius="5"
										ToolTip="무제한 — 종료일 없음"
										Visibility="{Binding IsUnlimited, Converter={StaticResource BoolToVis}}">
										<TextBlock
											Margin="9,0"
											VerticalAlignment="Center"
											AutomationProperties.AutomationId="Console.Suppression.Form.UnlimitedPlaceholder"
											FontSize="12.5"
											Foreground="{DynamicResource TextMutedBrush}"
											Text="무제한 — 종료일 없음"
											TextTrimming="CharacterEllipsis" />
									</Border>
								</Grid>
							</Grid>
							<CheckBox
								Margin="0,6,0,0"
								AutomationProperties.AutomationId="Console.Suppression.Form.Unlimited"
								Content="기간 제한 없음 (주간 반복 전용)"
								FontSize="12"
								IsChecked="{Binding IsUnlimited, Mode=TwoWay}"
								IsEnabled="{Binding CanUnlimited}" />

							<!--  주간 반복 칸 — 단발이면 접는다  -->
							<StackPanel Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVis}}">
								<TextBlock
									Margin="0,14,0,3"
									Style="{StaticResource BoxLabel}"
									Text="요일 *" />
								<!--  StackPanel 은 자동화 peer 가 없어 앵커가 되지 못한다 — ItemsControl 로 담는다  -->
								<ItemsControl AutomationProperties.AutomationId="Console.Suppression.Form.Days">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Mon"
										Content="월"
										IsChecked="{Binding IsMonChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Tue"
										Content="화"
										IsChecked="{Binding IsTueChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Wed"
										Content="수"
										IsChecked="{Binding IsWedChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Thu"
										Content="목"
										IsChecked="{Binding IsThuChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Fri"
										Content="금"
										IsChecked="{Binding IsFriChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Sat"
										Content="토"
										IsChecked="{Binding IsSatChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
									<ToggleButton
										AutomationProperties.AutomationId="Console.Suppression.Form.Day.Sun"
										Content="일"
										IsChecked="{Binding IsSunChecked, Mode=TwoWay}"
										IsEnabled="{Binding CanEditRecurrence}"
										Style="{StaticResource DayChip}" />
								</ItemsControl>

								<TextBlock
									Margin="0,14,0,3"
									Style="{StaticResource BoxLabel}"
									Text="일일 시각 *" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBox
										Height="32"
										md:HintAssist.Hint="HH:MM"
										AutomationProperties.AutomationId="Console.Suppression.Form.DailyStart"
										CaretBrush="{DynamicResource TextPrimaryBrush}"
										FontFamily="{DynamicResource MonoFont}"
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										IsEnabled="{Binding CanEditRecurrence}"
										Text="{Binding DailyStartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
										VerticalContentAlignment="Center" />
									<TextBlock
										Grid.Column="1"
										Margin="8,0"
										VerticalAlignment="Center"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="–" />
									<TextBox
										Grid.Column="2"
										Height="32"
										md:HintAssist.Hint="HH:MM"
										AutomationProperties.AutomationId="Console.Suppression.Form.DailyEnd"
										CaretBrush="{DynamicResource TextPrimaryBrush}"
										FontFamily="{DynamicResource MonoFont}"
										FontSize="12.5"
										Foreground="{DynamicResource TextPrimaryBrush}"
										IsEnabled="{Binding CanEditRecurrence}"
										Text="{Binding DailyEndText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
										VerticalContentAlignment="Center" />
								</Grid>
							</StackPanel>

							<!--  요약 — 전송될 내용을 그대로(SB L2877)  -->
							<Border
								Margin="0,14,0,0"
								Padding="10,7"
								Background="{DynamicResource SurfaceSunkenBrush}"
								CornerRadius="5">
								<TextBlock
									AutomationProperties.AutomationId="Console.Suppression.Form.Recap"
									FontFamily="{DynamicResource MonoFont}"
									FontSize="12"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding RecapText}"
									TextWrapping="Wrap" />
							</Border>

							<!--  읽을 수 없는 시각 글자 — 지우지 않고 그대로 두고 저장만 막는다  -->
							<DockPanel
								Margin="0,10,0,0"
								LastChildFill="True"
								Visibility="{Binding HasUnreadableTime, Converter={StaticResource BoolToVis}}">
								<md:PackIcon
									Width="15"
									Height="15"
									Margin="0,1,5,0"
									DockPanel.Dock="Left"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Kind="ClockAlertOutline" />
								<TextBlock
									AutomationProperties.AutomationId="Console.Suppression.Form.UnreadableTime"
									FontSize="12"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding UnreadableTimeText}"
									TextWrapping="Wrap" />
							</DockPanel>

							<!--  화면이 모르는 억제 범위 — 값을 지어내지 않고 그대로 보이고 저장을 막는다  -->
							<DockPanel
								Margin="0,10,0,0"
								LastChildFill="True"
								Visibility="{Binding IsScopeUnknown, Converter={StaticResource BoolToVis}}">
								<md:PackIcon
									Width="15"
									Height="15"
									Margin="0,1,5,0"
									DockPanel.Dock="Left"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Kind="HelpCircleOutline" />
								<TextBlock
									AutomationProperties.AutomationId="Console.Suppression.Form.UnknownScope"
									FontSize="12"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding UnknownScopeText}"
									TextWrapping="Wrap" />
							</DockPanel>

							<!--  오류 · 경고 — 형태로 가른다(느낌표 삼각 / 동그라미 i)  -->
							<DockPanel
								Margin="0,10,0,0"
								LastChildFill="True"
								Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
								<md:PackIcon
									Width="15"
									Height="15"
									Margin="0,1,5,0"
									DockPanel.Dock="Left"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Kind="AlertOutline" />
								<TextBlock
									AutomationProperties.AutomationId="Console.Suppression.Form.Error"
									FontSize="12"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding ErrorText}"
									TextWrapping="Wrap" />
							</DockPanel>
							<DockPanel
								Margin="0,8,0,0"
								LastChildFill="True"
								Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
								<md:PackIcon
									Width="15"
									Height="15"
									Margin="0,1,5,0"
									DockPanel.Dock="Left"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Kind="InformationOutline" />
								<TextBlock
									AutomationProperties.AutomationId="Console.Suppression.Form.Warning"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding WarningText}"
									TextWrapping="Wrap" />
							</DockPanel>
						</StackPanel>

						<!--  오른쪽 칸 — 대상 칩 트레이 + 픽커(끌어 오는 곳)  -->
						<StackPanel Grid.Column="2" MaxWidth="340">
							<StackPanel Visibility="{Binding AcceptsTargets, Converter={StaticResource BoolToVis}}">
							<DockPanel LastChildFill="False">
								<TextBlock
									VerticalAlignment="Center"
									DockPanel.Dock="Left"
									Style="{StaticResource BoxLabel}"
									Text="대상 *" />
								<TextBlock
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="Console.Suppression.Tray.Count"
									DockPanel.Dock="Left"
									FontFamily="{DynamicResource MonoFont}"
									FontSize="11.5"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding TrayCountText}" />
								<Button
									AutomationProperties.AutomationId="Console.Suppression.Tray.Clear"
									Click="OnClearChips"
									Content="모두 빼기"
									DockPanel.Dock="Right"
									Style="{StaticResource Console.Button.Mini}" />
							</DockPanel>

							<!--  드롭존 — 끄는 동안 형태로 가능 · 불가를 보인다(색이 아니라 윤곽)  -->
							<drag:DropZoneChrome
								Height="176"
								drag:DropZone.Handler="{Binding Drop}"
								drag:DropZone.Key="{x:Static sup:SuppressionTargetDrop.ZoneKey}"
								AutomationProperties.AutomationId="Console.Suppression.Tray.DropZone"
								CornerRadius="6"
								IsEnabled="{Binding AcceptsTargets}">
								<Grid>
									<!--  쉴 때도 '놓는 자리' 가 보여야 한다(정본 .trayb 는 파선 테두리다).
									      파선 {4,3}·{5,3} 은 그룹 선택 박스 · 러버밴드에 이미 배정돼 있어 {2,2} 를 쓴다.  -->
									<Rectangle
										RadiusX="6"
										RadiusY="6"
										Fill="{DynamicResource SurfaceSunkenBrush}"
										IsHitTestVisible="False"
										Stroke="{DynamicResource DividerBrush}"
										StrokeDashArray="2,2"
										StrokeThickness="1" />
									<ListBox
										Padding="8"
										AutomationProperties.AutomationId="Console.Suppression.Tray"
										Background="Transparent"
										BorderThickness="0"
										ItemsSource="{Binding Tray}"
										PreviewKeyDown="OnTrayKeyDown"
										ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										SelectionMode="Single">
										<ListBox.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel />
											</ItemsPanelTemplate>
										</ListBox.ItemsPanel>
										<ListBox.ItemContainerStyle>
											<Style TargetType="ListBoxItem">
												<Setter Property="Margin" Value="0,0,6,6" />
												<Setter Property="Padding" Value="0" />
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="ListBoxItem">
															<ContentPresenter />
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</ListBox.ItemContainerStyle>
										<ListBox.ItemTemplate>
											<DataTemplate>
												<Border
													Padding="9,3,4,3"
													AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.Chip.{0}}"
													Background="{DynamicResource TintInfoBrush}"
													CornerRadius="11"
													ToolTip="{Binding Detail}">
													<StackPanel Orientation="Horizontal">
														<TextBlock
															VerticalAlignment="Center"
															FontSize="12"
															Foreground="{DynamicResource TextPrimaryBrush}"
															Text="{Binding Label}" />
														<Button
															Width="18"
															Height="18"
															Margin="5,0,0,0"
															Padding="0"
															AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.ChipRemove.{0}}"
															Click="OnRemoveChip"
															Style="{StaticResource Console.Button.Icon}"
															ToolTip="이 대상을 뺍니다 (Delete)">
															<md:PackIcon
																Width="11"
																Height="11"
																Kind="Close" />
														</Button>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>

									<TextBlock
										Margin="12"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										AutomationProperties.AutomationId="Console.Suppression.Tray.EmptyHint"
										FontSize="12"
										Foreground="{DynamicResource TextMutedBrush}"
										IsHitTestVisible="False"
										Text="아래 목록에서 손잡이를 끌어 놓거나, 고른 뒤 [추가 ▶]를 누르세요"
										TextWrapping="Wrap"
										Visibility="{Binding IsTrayEmpty, Converter={StaticResource BoolToVis}}" />
								</Grid>
							</drag:DropZoneChrome>
							</StackPanel>

							<!--  '전체 대상' 이면 개별 대상을 담지 않는다  -->
							<TextBlock
								Margin="0,8,0,0"
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								AutomationProperties.AutomationId="Console.Suppression.Tray.AllTargetNotice"
								Text="전체 대상 스케줄에는 개별 장비나 그룹을 담지 않습니다."
								TextWrapping="Wrap"
								Visibility="{Binding AcceptsTargets, Converter={StaticResource NotBoolToVis}}" />

							<!--  픽커 — 끌어 오는 곳(드래그의 출발지이자 키보드 폴백의 출발지)  -->
							<StackPanel Visibility="{Binding AcceptsTargets, Converter={StaticResource BoolToVis}}">
								<DockPanel Margin="0,14,0,4" LastChildFill="True">
									<TextBlock
										VerticalAlignment="Center"
										DockPanel.Dock="Left"
										Style="{StaticResource BoxLabel}"
										Text="담을 수 있는 대상" />
									<TextBlock
										Margin="8,0,0,0"
										VerticalAlignment="Center"
										DockPanel.Dock="Left"
										FontFamily="{DynamicResource MonoFont}"
										FontSize="11.5"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="{Binding PickerCountText}" />
									<!--
										U-17 — [추가 ▶] 는 목록 머리 오른쪽(검색 옆)에 둔다. 전에는 고정 높이(190) 목록 <b>아래</b>에 있어,
										후보가 한두 건이면 빈 목록 밑 허공에 떠 무엇에 딸린 버튼인지 안 보였다(실창 캡처).
										같은 줄의 검색 · 건수와 한 몸이 되고, 목록이 몇 건이든 자리가 같다.
									-->
									<Button
										Margin="8,0,0,0"
										AutomationProperties.AutomationId="Console.Suppression.Picker.Add"
										Click="OnAddSelected"
										Content="추가 ▶"
										DockPanel.Dock="Right"
										Style="{StaticResource Console.Button}"
										ToolTip="고른 대상을 위 대상 칸에 담습니다 (Enter)" />
									<TextBox
										Height="28"
										Margin="8,0,0,0"
										md:HintAssist.Hint="이름 검색"
										AutomationProperties.AutomationId="Console.Suppression.Picker.Search"
										CaretBrush="{DynamicResource TextPrimaryBrush}"
										FontSize="12"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding PickerSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										VerticalContentAlignment="Center" />
								</DockPanel>

								<!--  목록의 영역이 보이게 가라앉은 판 + 선 — 후보가 적어도 "여기가 목록" 이 읽힌다  -->
								<ListBox
									Height="190"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="1"
									AutomationProperties.AutomationId="Console.Suppression.Picker"
									ItemsSource="{Binding PickerItems}"
									PreviewKeyDown="OnPickerKeyDown"
									SelectionMode="Extended">
									<b:Interaction.Behaviors>
										<!--  손잡이에서만 끌기가 시작된다 — 여러 건을 고르면 함께 실린다  -->
										<drag:CaptureDragBehavior
											DisplayMemberPath="Label"
											Handler="{Binding Drop}"
											IsDragEnabled="{Binding AcceptsTargets}"
											KeyboardFallback="여러 건을 고른 뒤 [추가 ▶] 또는 Enter" />
									</b:Interaction.Behaviors>
									<ListBox.ItemTemplate>
										<DataTemplate>
											<DockPanel LastChildFill="True">
												<drag:DragHandle
													Margin="0,0,6,0"
													AutomationProperties.AutomationId="{Binding Id, StringFormat=Console.Suppression.PickerHandle.{0}}"
													DockPanel.Dock="Left"
													ToolTip="끌어서 위 대상 칸에 담기" />
												<TextBlock
													VerticalAlignment="Center"
													DockPanel.Dock="Left"
													FontSize="12.5"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding Label}" />
												<TextBlock
													Margin="8,0,0,0"
													VerticalAlignment="Center"
													FontSize="11.5"
													Foreground="{DynamicResource TextMutedBrush}"
													Text="{Binding Detail}"
													TextTrimming="CharacterEllipsis" />
											</DockPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</StackPanel>
						</StackPanel>
					</Grid>
				</ScrollViewer>

				<!--  ── 바닥 (SB L2884) ─────────────────────────────────────  -->
				<Border
					Grid.Row="2"
					Padding="16,10"
					AutomationProperties.AutomationId="Console.Suppression.Drawer.Footer"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,1,0,0"
					RenderTransformOrigin="0.5,0.5">
					<Border.RenderTransform>
						<TranslateTransform />
					</Border.RenderTransform>
					<!--  2열(*/Auto) — 긴 알림 한 줄이 버튼을 줄 밖으로 밀지 않는다.
					      버튼 간격은 8 하나로 통일하고 ghost → outlined → primary 순서로 둔다.  -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Suppression.Drawer.Status"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding StatusLine}"
							TextTrimming="CharacterEllipsis"
							theme:TrimmedToolTip.IsEnabled="True" />
						<StackPanel
							Grid.Column="1"
							Margin="12,0,0,0"
							Orientation="Horizontal">
							<Button
								Margin="0,0,8,0"
								AutomationProperties.AutomationId="Console.Suppression.Drawer.Revert"
								Click="OnRevert"
								Content="되돌리기"
								IsEnabled="{Binding CanRevert}"
								Style="{StaticResource Console.Button.Ghost}"
								ToolTip="처음 상태로 되돌립니다" />
							<Button
								Margin="0,0,8,0"
								AutomationProperties.AutomationId="Console.Suppression.Drawer.Cancel"
								Click="OnClose"
								Content="취소"
								Style="{StaticResource Console.Button}" />
							<Button
								AutomationProperties.AutomationId="Console.Suppression.Drawer.Save"
								Click="OnSave"
								Content="저장"
								IsEnabled="{Binding CanSave}"
								Style="{StaticResource Console.Button.Primary}"
								ToolTip="저장합니다" />
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>
