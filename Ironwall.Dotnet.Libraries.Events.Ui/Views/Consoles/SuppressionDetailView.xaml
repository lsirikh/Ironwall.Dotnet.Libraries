<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles.SuppressionDetailView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:dash="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Dashboards"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		억제 스케줄 상세 — 정본 window-layout-system-storyboard.html L2734-2740
		(종류 · 이름 · 상태 · 반복 요약 · '억제' 절(범위 · 대상 · 시작 · 종료) · 대상 칩 · 진행중 주의 문구 ·
		 바닥 [수정] [취소 예약]).
		L2694 의 '선택 없음' 안내 문구도 함께 옮긴다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<dash:EventIconKindConverter x:Key="IconKind" />

		<Style x:Key="KeyText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		</Style>
		<Style x:Key="ValueText" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
	</UserControl.Resources>

	<Grid>
		<!--  선택 없음 (SB L2694)  -->
		<TextBlock
			Margin="16"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			AutomationProperties.AutomationId="Console.Suppression.Detail.Empty"
			FontSize="12.5"
			Foreground="{DynamicResource TextMutedBrush}"
			Text="스케줄을 고르면 반복 요약과 대상이 열립니다."
			TextAlignment="Center"
			TextWrapping="Wrap">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Setter Property="Visibility" Value="Collapsed" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding HasSelection}" Value="False">
							<Setter Property="Visibility" Value="Visible" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>

		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto"
			Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
			<!--  MDIX 암시 ScrollViewer 스타일이 Padding 을 삼킨다 — 안쪽 패널에 여백을 준다  -->
			<StackPanel Margin="14,12,14,14">

				<!--  상태 — 형태 + 글자  -->
				<StackPanel Orientation="Horizontal">
					<md:PackIcon
						Width="14"
						Height="14"
						Margin="0,0,6,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Kind="{Binding Selected.ShapeIconName, Converter={StaticResource IconKind}}" />
					<TextBlock
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Console.Suppression.Detail.Status"
						FontSize="13"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding Selected.ShapeLabel}" />
				</StackPanel>

				<Border
					Margin="0,10,0,0"
					Padding="10,7"
					Background="{DynamicResource SurfaceSunkenBrush}"
					CornerRadius="5">
					<TextBlock
						AutomationProperties.AutomationId="Console.Suppression.Detail.Recap"
						FontFamily="{DynamicResource MonoFont}"
						FontSize="12"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding Selected.RepeatText}"
						TextWrapping="Wrap" />
				</Border>

				<!--  억제 (SB L2736)  -->
				<c:ConsoleSection
					Margin="0,14,0,0"
					AxisName="event_suppression_schedules"
					Header="억제">
					<Grid Margin="0,6,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="72" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							Margin="0,0,0,5"
							Style="{StaticResource KeyText}"
							Text="범위" />
						<TextBlock
							Grid.Column="1"
							Margin="0,0,0,5"
							AutomationProperties.AutomationId="Console.Suppression.Detail.Scope"
							Style="{StaticResource ValueText}"
							Text="{Binding Selected.ScopeDetailText}" />

						<TextBlock
							Grid.Row="1"
							Margin="0,0,0,5"
							Style="{StaticResource KeyText}"
							Text="대상" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="1"
							Margin="0,0,0,5"
							AutomationProperties.AutomationId="Console.Suppression.Detail.Target"
							Style="{StaticResource ValueText}"
							Text="{Binding Selected.TargetSummary}" />

						<TextBlock
							Grid.Row="2"
							Margin="0,0,0,5"
							Style="{StaticResource KeyText}"
							Text="시작" />
						<TextBlock
							Grid.Row="2"
							Grid.Column="1"
							Margin="0,0,0,5"
							AutomationProperties.AutomationId="Console.Suppression.Detail.Start"
							FontFamily="{DynamicResource MonoFont}"
							Style="{StaticResource ValueText}"
							Text="{Binding Selected.WindowStartText}" />

						<TextBlock
							Grid.Row="3"
							Style="{StaticResource KeyText}"
							Text="종료" />
						<TextBlock
							Grid.Row="3"
							Grid.Column="1"
							AutomationProperties.AutomationId="Console.Suppression.Detail.End"
							FontFamily="{DynamicResource MonoFont}"
							Style="{StaticResource ValueText}"
							Text="{Binding Selected.WindowEndText}" />
					</Grid>
				</c:ConsoleSection>

				<!--  대상 칩 (SB L2737) — 읽기 전용  -->
				<c:ConsoleSection
					Margin="0,14,0,0"
					AxisName="target_device_ids / target_group_ids"
					Header="대상">
					<ItemsControl
						Margin="0,6,0,0"
						AutomationProperties.AutomationId="Console.Suppression.Detail.Chips"
						ItemsSource="{Binding DetailTargets}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border
									Margin="0,0,5,5"
									Padding="9,3"
									Background="{DynamicResource TintInfoBrush}"
									CornerRadius="11">
									<TextBlock
										FontSize="12"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding Label}" />
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</c:ConsoleSection>

				<!--  '진행중' 은 '지금 억제 중' 이 아니다 (SB L2738)  -->
				<Border
					Margin="0,12,0,0"
					Padding="10,7"
					Background="{DynamicResource TintWarningBrush}"
					CornerRadius="5"
					Visibility="{Binding HasDetailNote, Converter={StaticResource BoolToVis}}">
					<TextBlock
						AutomationProperties.AutomationId="Console.Suppression.Detail.Note"
						FontSize="12"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding DetailNote}"
						TextWrapping="Wrap" />
				</Border>

				<!--
					동작(SB L2739)은 커널 ConsoleDetailHost 의 <b>적용 막대</b>에 있다 —
					[수정] = Apply · [취소 예약] = Revert. 다른 콘솔과 같은 자리이고,
					상세 본문에 전폭 버튼 더미를 쌓지 않는다.
				-->
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
