<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.ActionSelectionView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	mc:Ignorable="d">

	<!--  View-model proxy (전역 DataContext 바인딩용)  -->
	<UserControl.Resources>
		<utils:BindingProxy x:Key="proxy" Data="{Binding}" />
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</UserControl.Resources>

	<GroupBox
		Margin="5"
		Style="{StaticResource MaterialDesignGroupBox}"
		UseLayoutRounding="True">
		<GroupBox.Header>
			<StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal">
				<md:PackIcon Kind="Settings" />
				<TextBlock
					Margin="5,0"
					VerticalAlignment="Center"
					Text="조치보고 속성" />
			</StackPanel>
		</GroupBox.Header>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
				<!--  Apply Button  -->
			</Grid.RowDefinitions>

			<!--  ── 좌(원본 필수정보 + 편집 필드) + 우(썸네일). 높이는 ScrollViewer MaxHeight로 상한, 넘치면 스크롤 ──  -->
			<Grid Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="12" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<ScrollViewer
					Grid.Column="0"
					MaxHeight="140"
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="64" />
							<ColumnDefinition Width="*" MinWidth="80" />
						</Grid.ColumnDefinitions>
						<Grid.Resources>
							<Style BasedOn="{StaticResource TextBlockTitle}" TargetType="TextBlock">
								<Setter Property="VerticalAlignment" Value="Center" />
								<Setter Property="Margin" Value="0,3" />
							</Style>
							<!--  원본 필수정보 = 읽기 전용 값(편집 불가). 테두리 없는 TextBox로 복사는 허용, 편집 차단  -->
							<Style x:Key="ReadOnlyValue" TargetType="TextBox">
								<Setter Property="FontFamily" Value="{StaticResource NotoSansCJKkRMedium}" />
								<Setter Property="FontSize" Value="14" />
								<Setter Property="Opacity" Value="0.8" />
								<Setter Property="IsReadOnly" Value="True" />
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="BorderThickness" Value="0" />
								<Setter Property="Padding" Value="2,0" />
								<Setter Property="Margin" Value="0,2" />
								<Setter Property="VerticalAlignment" Value="Center" />
								<Setter Property="Cursor" Value="Arrow" />
								<Setter Property="IsTabStop" Value="False" />
							</Style>
						</Grid.Resources>

						<!--  ── 원본(Origin) 이벤트 필수정보 — 읽기 전용 ──  -->
						<TextBlock Grid.Row="0" Grid.Column="0" Text="원본" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginKindText, Mode=OneWay}" />

						<TextBlock Grid.Row="1" Grid.Column="0" Text="구역" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginZoneText, Mode=OneWay}" />

						<TextBlock Grid.Row="2" Grid.Column="0" Text="장비" />
						<TextBox
							Grid.Row="2"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginDeviceText, Mode=OneWay}" />

						<TextBlock Grid.Row="3" Grid.Column="0" Text="번호" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginNumberText, Mode=OneWay}" />

						<TextBlock Grid.Row="4" Grid.Column="0" Text="발생" />
						<TextBox
							Grid.Row="4"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginDateTimeText, Mode=OneWay}" />

						<!--  탐지 origin 전용: 결과·신호 (장애면 접힘)  -->
						<TextBlock
							Grid.Row="5"
							Grid.Column="0"
							Text="결과"
							Visibility="{Binding IsDetectionOrigin, Converter={StaticResource BoolToVis}}" />
						<TextBox
							Grid.Row="5"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginResultText, Mode=OneWay}"
							Visibility="{Binding IsDetectionOrigin, Converter={StaticResource BoolToVis}}" />

						<TextBlock
							Grid.Row="6"
							Grid.Column="0"
							Text="신호"
							Visibility="{Binding IsDetectionOrigin, Converter={StaticResource BoolToVis}}" />
						<TextBox
							Grid.Row="6"
							Grid.Column="1"
							FontFamily="Consolas"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginSignalText, Mode=OneWay}"
							Visibility="{Binding IsDetectionOrigin, Converter={StaticResource BoolToVis}}" />

						<!--  장애 origin 전용: 사유 (탐지면 접힘)  -->
						<TextBlock
							Grid.Row="7"
							Grid.Column="0"
							Text="사유"
							Visibility="{Binding IsMalfunctionOrigin, Converter={StaticResource BoolToVis}}" />
						<TextBox
							Grid.Row="7"
							Grid.Column="1"
							Style="{StaticResource ReadOnlyValue}"
							Text="{Binding OriginReasonText, Mode=OneWay}"
							Visibility="{Binding IsMalfunctionOrigin, Converter={StaticResource BoolToVis}}" />

						<Border
							Grid.Row="8"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							Height="1"
							Margin="0,6"
							Background="{DynamicResource DividerBrush}" />

						<!--  ── 조치 편집 필드 ──
						      Type·원본지정 콤보 제거: 기존 리포트는 IsDraft 가드(BaseEventViewModel.MessageType / ActionEventViewModel.OriginEvent)로
						      변경 차단 + PUT(ToActionEventReplaceDto)이 type_event/content/user만 보내고 from_event 제외 → 편집 무의미.
						      Type는 항상 Action, 신규 Draft 원본지정은 그리드 OriginEvent 셀(IsEnabled=IsDraft)이 담당. ──  -->
						<TextBlock Grid.Row="9" Grid.Column="0" Text="사용자" />
						<TextBox
							Grid.Row="9"
							Grid.Column="1"
							Margin="0,2"
							md:HintAssist.Hint="admin"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<TextBlock Grid.Row="10" Grid.Column="0" Text="내용" />
						<TextBox
							Grid.Row="10"
							Grid.Column="1"
							Margin="0,2"
							md:HintAssist.Hint="Action report contents"
							Style="{StaticResource TextBoxInput}"
							Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="Wrap" />
					</Grid>
				</ScrollViewer>

				<!--  우: 썸네일 — 탐지 origin=이미지 / 장애·부재·로드실패=Default("미리보기 없음")  -->
				<Border
					Grid.Column="2"
					Width="140"
					Height="140"
					VerticalAlignment="Top"
					Background="{DynamicResource MaterialDesignChipBackground}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="1"
					CornerRadius="4">
					<Grid>
						<!--  default (뒤): 썸네일 없음/장애/로드 실패 시 노출  -->
						<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Orientation="Vertical">
							<md:PackIcon
								Width="32"
								Height="32"
								HorizontalAlignment="Center"
								Opacity="0.5"
								Kind="ImageOffOutline" />
							<TextBlock
								Margin="0,4,0,0"
								HorizontalAlignment="Center"
								FontSize="11"
								Opacity="0.55"
								Text="미리보기 없음" />
						</StackPanel>

						<!--  썸네일 이미지(앞): 탐지 origin 후보 있을 때만. 로드 전/실패면 빈 렌더 → 뒤 default 노출  -->
						<Image
							RenderOptions.BitmapScalingMode="HighQuality"
							Source="{Binding OriginThumbnail, Mode=OneWay}"
							Stretch="Uniform"
							Visibility="{Binding HasOriginThumbnail, Converter={StaticResource BoolToVis}}" />
					</Grid>
				</Border>
			</Grid>

			<!--  ───────────────────────────  APPLY BUTTON  ───────────────────────────  -->
			<Button
				x:Name="ApplyButton"
				Grid.Row="1"
				Margin="0,10,0,0"
				HorizontalAlignment="Right"
				BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
				Style="{StaticResource MaterialDesignFlatButton}">
				<Button.Content>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon Kind="Check" Style="{StaticResource ButtonIcon}" />
						<TextBlock Style="{StaticResource ButtonTextBlock}" Text="적용" />
					</StackPanel>
				</Button.Content>
			</Button>
		</Grid>
	</GroupBox>

</UserControl>
