<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Events.MalfunctionEventCardView"
	AutomationProperties.AutomationId="{Binding AutomationKey, Mode=OneWay}"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Panels"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  신호/썸네일 가시성 게이트  -->
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<!--  enum→한글 표시 전용(라이브러리 Resources.xaml는 앱에 미머지 → 뷰 로컬 등록)  -->
		<converters:EnumToKoreanConverter x:Key="EnumToKoreanConverter" />
	</UserControl.Resources>

	<md:Flipper
		md:ElevationAssist.Elevation="Dp0"
		Background="{DynamicResource SurfaceTranslucentBrush}"
		Style="{StaticResource MaterialDesignCardFlipper}">
		<md:Flipper.FrontContent>
			<Border
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="2"
				CornerRadius="5">
				<!--  220×200 고정. 탐지 카드와 동일 골격 — 사진 슬롯(56×56)은 장애엔 사진이 없어 기본 이미지 상시 표시.  -->
				<Grid Width="220" Height="200">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<!--  본문: ①구역·장비(전체폭) + ②사진(고정 슬롯)+장애 정보  -->
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<md:ColorZone
						Grid.Row="0"
						Padding="5"
						Mode="SecondaryLight">
						<StackPanel Orientation="Horizontal">
							<Button
								HorizontalAlignment="Left"
								Command="{x:Static md:Flipper.FlipCommand}"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Opacity="1"
								Style="{StaticResource Console.Button.Icon.OnPrimary}">
								<md:PackIcon
									Width="25"
									Height="25"
									VerticalAlignment="Center"
									HorizontalContentAlignment="Center"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Kind="Error"
									Opacity="1" />
							</Button>
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								FontSize="16"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Opacity="1"
								Text="장애 이벤트" />
						</StackPanel>
					</md:ColorZone>

					<!--  ── 본문 ──  -->
					<Grid Grid.Row="1" Margin="10,6,10,4">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  ① 구역·장비 — 전체폭 단일 라인(말줄임)  -->
						<TextBlock
							Grid.Row="0"
							FontFamily="{StaticResource NotoSansCJKkRMedium}"
							FontSize="19"
							Opacity="1"
							Text="{Binding ZoneDeviceText, FallbackValue=—}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="NoWrap" />

						<!--  ② 좌: 56×56 고정 슬롯(장애=기본 이미지 상시) / 우: 장애 정보  -->
						<Grid Grid.Row="1" Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="56" />
								<ColumnDefinition Width="10" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  탐지와 동일한 고정 슬롯 — 장애는 사진이 없어 기본 이미지만 표시(구조 일관, 행 높이 불변).  -->
							<Border
								Grid.Column="0"
								Width="56"
								Height="56"
								VerticalAlignment="Top"
								Background="{DynamicResource SurfaceSunkenBrush}"
								BorderBrush="{DynamicResource DividerBrush}"
								BorderThickness="1"
								ClipToBounds="True"
								CornerRadius="4">
								<md:PackIcon
									Width="24"
									Height="24"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Opacity="0.5"
									Kind="ImageOffOutline" />
							</Border>

							<!--  장애 유형(한글) + 안내  -->
							<StackPanel Grid.Column="2" VerticalAlignment="Center">
								<TextBlock
									FontFamily="{StaticResource NotoSansCJKkRMedium}"
									FontSize="16"
									Opacity="1"
									Text="{Binding MessageType, Converter={StaticResource EnumToKoreanConverter}, FallbackValue=장애, Mode=OneWay}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
								<TextBlock
									Margin="0,3,0,0"
									FontSize="11"
									Opacity="0.6"
									Text="사진 미제공" />
							</StackPanel>
						</Grid>
					</Grid>

					<Separator
						Grid.Row="2"
						Margin="0"
						Style="{StaticResource MaterialDesignLightSeparator}" />

					<!--  ── 푸터 ──  -->
					<StackPanel Grid.Row="3" Margin="10,4,10,6">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Button
								Grid.Column="0"
								VerticalAlignment="Center"
								VerticalContentAlignment="Center"
								md:RippleAssist.IsCentered="True"
								AutomationProperties.AutomationId="{Binding ReportAutomationKey, Mode=OneWay}"
								Style="{StaticResource Console.Button.Icon}"
								ToolTip="{DynamicResource EventRemove_Title}">
								<cal:Message.Attach>
									[Event Click] = [Action OnButtonAction($source, $eventArgs)];
								</cal:Message.Attach>
								<md:PackIcon Kind="CommentOutline" />
							</Button>
							<TextBlock
								Grid.Column="1"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="12"
								Opacity="1"
								Text="{Binding DateTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss, FallbackValue=—}" />
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
		</md:Flipper.FrontContent>

		<md:Flipper.BackContent>
			<Border
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="2"
				CornerRadius="5">
				<!--  뒷면(상세)도 앞면과 동일 크기(220×200) — 플립 시 폭 점프 제거  -->
				<Grid Width="220" Height="200">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="3*" />
					</Grid.RowDefinitions>
					<md:ColorZone
						Grid.Row="0"
						Padding="5"
						CornerRadius="5,5,0,0"
						Mode="SecondaryLight">
						<StackPanel Orientation="Horizontal">
							<Button
								HorizontalAlignment="Left"
								Command="{x:Static md:Flipper.FlipCommand}"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Opacity="1"
								Style="{StaticResource Console.Button.Icon.OnPrimary}">
								<md:PackIcon
									Width="25"
									Height="25"
									HorizontalAlignment="Right"
									Kind="ArrowLeft" />
							</Button>
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								FontSize="16"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Opacity="1"
								Text="상세" />
						</StackPanel>
					</md:ColorZone>
					<Grid
						Grid.Row="1"
						Margin="5"
						VerticalAlignment="Top">
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="7*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="제어기" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Margin="10,10,0,0"
							md:HintAssist.Hint="제어기 번호"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding ControllerDisplay, Mode=OneWay}" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="센서" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="10,10,0,0"
							md:HintAssist.Hint="센서 번호"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding SensorDisplay, Mode=OneWay}" />
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="장애원인" />
						<TextBox
							Grid.Row="2"
							Grid.Column="1"
							Margin="10,10,0,0"
							md:HintAssist.Hint="장애원인"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding Reason, Converter={StaticResource EnumToKoreanConverter}, Mode=OneWay}" />
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="이벤트 시간"
							TextWrapping="Wrap" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Margin="10,10,0,0"
							md:HintAssist.Hint="이벤트 시간"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding DateTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" />
					</Grid>
				</Grid>
			</Border>
		</md:Flipper.BackContent>
	</md:Flipper>
</UserControl>
