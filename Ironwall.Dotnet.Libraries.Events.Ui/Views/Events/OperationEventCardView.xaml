<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Events.OperationEventCardView"
	AutomationProperties.AutomationId="{Binding AutomationKey, Mode=OneWay}"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	d:Background="WhiteSmoke"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</UserControl.Resources>

	<!--  운영 카드 — 탐지 · 장애 카드와 같은 틀(폭 150~224 · 높이 200). 조치 대상이 아니라 조치보고 단추 대신 [닫기], 뒤집기 없음(operation-event-card PRD §2 · §3).  -->
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" MinWidth="150" MaxWidth="224" />
		</Grid.ColumnDefinitions>
		<Border
			Background="{DynamicResource SurfaceTranslucentBrush}"
			BorderBrush="{DynamicResource DividerBrush}"
			BorderThickness="2"
			CornerRadius="5">
			<Grid Height="200">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--  머리 — 운영 표지(아이콘 + 글). 색만으로 가르지 않는다.  -->
				<md:ColorZone
					Grid.Row="0"
					Padding="5"
					Mode="SecondaryLight">
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="25"
							Height="25"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource OnPrimaryFixedBrush}">
							<md:PackIcon.Style>
								<Style TargetType="md:PackIcon">
									<Setter Property="Kind" Value="InformationOutline" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsDoor, Mode=OneWay}" Value="True">
											<Setter Property="Kind" Value="DoorOpen" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</md:PackIcon.Style>
						</md:PackIcon>
						<TextBlock
							Margin="8,0,0,0"
							VerticalAlignment="Center"
							FontSize="16"
							Foreground="{DynamicResource OnPrimaryFixedBrush}"
							Text="운영 이벤트" />
					</StackPanel>
				</md:ColorZone>

				<!--  본문: ① 구역 · 장비 ② 사유 ③ 심각도(경고 이상) ④ 상세  -->
				<StackPanel Grid.Row="1" Margin="10,6,10,4">
					<TextBlock
						FontFamily="{StaticResource NotoSansCJKkRMedium}"
						FontSize="19"
						Text="{Binding ZoneDeviceText, Mode=OneWay, FallbackValue=—}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<TextBlock
						Margin="0,6,0,0"
						FontFamily="{StaticResource NotoSansCJKkRMedium}"
						FontSize="16"
						Text="{Binding ReasonText, Mode=OneWay, FallbackValue=—}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
					<StackPanel
						Margin="0,3,0,0"
						Orientation="Horizontal"
						Visibility="{Binding IsWarning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
						<md:PackIcon
							Width="16"
							Height="16"
							VerticalAlignment="Center"
							Foreground="{DynamicResource StatusCriticalBrush}"
							Kind="AlertOutline" />
						<TextBlock
							Margin="4,0,0,0"
							VerticalAlignment="Center"
							FontSize="13"
							Text="{Binding SeverityText, Mode=OneWay}" />
					</StackPanel>
					<TextBlock
						Margin="0,3,0,0"
						FontSize="11"
						Opacity="0.6"
						Text="{Binding DetailText, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="NoWrap" />
				</StackPanel>

				<Separator
					Grid.Row="2"
					Margin="0"
					Style="{StaticResource MaterialDesignLightSeparator}" />

				<!--  바닥 — [닫기] + 시각  -->
				<Grid Grid.Row="3" Margin="10,4,10,6">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Button
						Grid.Column="0"
						VerticalAlignment="Center"
						md:RippleAssist.IsCentered="True"
						AutomationProperties.AutomationId="{Binding CloseAutomationKey, Mode=OneWay}"
						Style="{StaticResource Console.Button.Icon}"
						ToolTip="닫기">
						<cal:Message.Attach>
							[Event Click] = [Action OnButtonCloseCard($source, $eventArgs)]
						</cal:Message.Attach>
						<md:PackIcon Kind="Close" />
					</Button>
					<TextBlock
						Grid.Column="1"
						HorizontalAlignment="Right"
						VerticalAlignment="Center"
						FontSize="12"
						Text="{Binding DateTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss, FallbackValue=—}" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
