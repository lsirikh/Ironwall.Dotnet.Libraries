<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Events.DetectionEventCardView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Panels"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!--  신호 줄 가시성 (FR-06) — HasSignal 게이트  -->
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<!--  enum→한글 표시 전용(라이브러리 Resources.xaml는 앱에 미머지 → 뷰 로컬 등록)  -->
		<converters:EnumToKoreanConverter x:Key="EnumToKoreanConverter" />
	</UserControl.Resources>

	<md:Flipper
		md:ElevationAssist.Elevation="Dp0"
		Background="Transparent"
		Style="{StaticResource MaterialDesignCardFlipper}">
		<md:Flipper.FrontContent>
			<Border
				Background="{DynamicResource SurfaceBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="2"
				CornerRadius="5">
				<!--  220×200 고정. 썸네일은 본문 ②행의 "고정 슬롯(56×56)" — 지연 로드(SYNC_DETECTION) 시
				      슬롯 크기 불변, 이미지 소스만 교체 → 레이아웃 붕괴 없음.  -->
				<Grid Width="220" Height="200">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<!--  본문: ①구역·장비(전체폭) + ②사진(고정 슬롯)+결과·신호  -->
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<md:ColorZone
						Grid.Row="0"
						Padding="5"
						Mode="PrimaryMid">
						<StackPanel Orientation="Horizontal">
							<Button
								HorizontalAlignment="Left"
								Command="{x:Static md:Flipper.FlipCommand}"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Opacity="1"
								Style="{StaticResource MaterialDesignToolForegroundButton}">
								<md:PackIcon
									Width="25"
									Height="25"
									VerticalAlignment="Center"
									HorizontalContentAlignment="Center"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Kind="MotionSensor"
									Opacity="1" />
							</Button>
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								FontSize="16"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Opacity="1"
								Text="탐지 이벤트" />
						</StackPanel>
					</md:ColorZone>

					<!--  ── 본문 ──  -->
					<Grid Grid.Row="1" Margin="10,6,10,4">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  ① 구역·장비 — 전체폭 단일 라인(말줄임). 이전 다중 TextBlock 분할 → 잘림 해결  -->
						<TextBlock
							Grid.Row="0"
							FontFamily="{StaticResource NotoSansCJKkRMedium}"
							FontSize="19"
							Opacity="1"
							Text="{Binding ZoneDeviceText, FallbackValue=구역 - 센서 01}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="NoWrap" />

						<!--  ② 좌: 56×56 고정 썸네일 슬롯 / 우: 결과·신호  -->
						<Grid Grid.Row="1" Margin="0,6,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="56" />
								<ColumnDefinition Width="10" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  고정 슬롯 — 뒤: 기본 이미지(항상) / 앞: 썸네일(있으면).
							      부모 Border(56×56)가 항상 렌더되어 행 높이 불변 → 지연 로드에도 리플로우 0.  -->
							<Border
								Grid.Column="0"
								Width="56"
								Height="56"
								VerticalAlignment="Top"
								Background="{DynamicResource SurfaceSunkenBrush}"
								BorderBrush="{DynamicResource DividerBrush}"
								BorderThickness="1"
								ClipToBounds="True"
								CornerRadius="4">
								<Grid>
									<md:PackIcon
										Width="24"
										Height="24"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Opacity="0.5"
										Kind="ImageOffOutline" />
									<Image
										RenderOptions.BitmapScalingMode="HighQuality"
										Source="{Binding ThumbnailUri, Mode=OneWay}"
										Stretch="UniformToFill"
										Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
								</Grid>
							</Border>

							<!--  결과(한글) + 신호  -->
							<StackPanel Grid.Column="2" VerticalAlignment="Center">
								<TextBlock
									FontFamily="{StaticResource NotoSansCJKkRMedium}"
									FontSize="16"
									Opacity="1"
									Text="{Binding Result, Converter={StaticResource EnumToKoreanConverter}, FallbackValue=결과, Mode=OneWay, StringFormat='({0})'}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
								<StackPanel
									Margin="0,4,0,0"
									Orientation="Horizontal"
									Visibility="{Binding HasSignal, Converter={StaticResource BoolToVis}}">
									<Border
										Width="70"
										Height="8"
										Margin="0,0,8,0"
										VerticalAlignment="Center"
										Background="{DynamicResource SurfaceSunkenBrush}"
										CornerRadius="4">
										<Border
											Width="{Binding SignalBarWidth, Mode=OneWay}"
											HorizontalAlignment="Left"
											Background="{DynamicResource StatusCriticalBrush}"
											CornerRadius="4" />
									</Border>
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="Consolas"
										FontSize="15"
										FontWeight="Bold"
										Foreground="{DynamicResource StatusCriticalBrush}"
										Opacity="1"
										Text="{Binding SignalText, Mode=OneWay}" />
								</StackPanel>
							</StackPanel>
						</Grid>
					</Grid>

					<Separator
						Grid.Row="2"
						Margin="0"
						Style="{StaticResource MaterialDesignLightSeparator}" />

					<!--  ── 푸터 ──  -->
					<StackPanel Grid.Row="3" Margin="10,4,10,6">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Button
								Grid.Column="0"
								Padding="4 0"
								VerticalAlignment="Center"
								VerticalContentAlignment="Center"
								md:RippleAssist.IsCentered="True"
								Style="{StaticResource MaterialDesignFlatButton}"
								ToolTip="{DynamicResource EventRemove_Title}">
								<cal:Message.Attach>
									[Event Click] = [Action OnButtonAction($source, $eventArgs)];
								</cal:Message.Attach>
								<md:PackIcon Kind="CommentOutline" />
							</Button>
							<TextBlock
								Grid.Column="1"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								FontSize="12"
								Opacity="1"
								Text="{Binding DateTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss, FallbackValue=2020-11-20 12:30:10}" />
						</Grid>
					</StackPanel>
				</Grid>
			</Border>
		</md:Flipper.FrontContent>

		<md:Flipper.BackContent>
			<Border
				Background="{DynamicResource SurfaceBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="2"
				CornerRadius="5">
				<!--  뒷면(상세)도 앞면과 동일 크기(220×200) — 플립 시 폭 점프 제거  -->
				<Grid Width="220" Height="200">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="3*" />
					</Grid.RowDefinitions>
					<md:ColorZone
						Grid.Row="0"
						Padding="5"
						CornerRadius="5,5,0,0"
						Mode="PrimaryMid">
						<StackPanel Orientation="Horizontal">
							<Button
								HorizontalAlignment="Left"
								Command="{x:Static md:Flipper.FlipCommand}"
								Opacity="1"
								Style="{StaticResource MaterialDesignToolForegroundButton}">
								<md:PackIcon
									Width="25"
									Height="25"
									HorizontalAlignment="Right"
									Kind="ArrowLeft" />
							</Button>
							<TextBlock
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								FontSize="16"
								Opacity="1"
								Text="상세" />
						</StackPanel>
					</md:ColorZone>
					<Grid
						Grid.Row="1"
						Margin="5"
						VerticalAlignment="Top">
						<!--  신호 행 추가로 5행 (FR-06) — 고정 200px 수용 위해 행 간격 축소(10→4)  -->
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*" />
							<ColumnDefinition Width="7*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Row="0"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="제어기" />
						<TextBox
							Grid.Row="0"
							Grid.Column="1"
							Margin="10,4,0,0"
							md:HintAssist.Hint="제어기 번호"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding ControllerDeviceNumber, Mode=OneWay}" />
						<TextBlock
							Grid.Row="1"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="센서" />
						<TextBox
							Grid.Row="1"
							Grid.Column="1"
							Margin="10,4,0,0"
							md:HintAssist.Hint="센서 번호"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding Device.DeviceNumber, Mode=OneWay}" />
						<TextBlock
							Grid.Row="2"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="결과" />
						<TextBox
							Grid.Row="2"
							Grid.Column="1"
							Margin="10,4,0,0"
							md:HintAssist.Hint="이벤트종류"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding Result, Converter={StaticResource EnumToKoreanConverter}, Mode=OneWay}" />
						<TextBlock
							Grid.Row="3"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="신호" />
						<TextBox
							Grid.Row="3"
							Grid.Column="1"
							Margin="10,4,0,0"
							md:HintAssist.Hint="신호 크기"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding SignalText, Mode=OneWay}" />
						<TextBlock
							Grid.Row="4"
							Grid.Column="0"
							Margin="5,0,0,0"
							VerticalAlignment="Center"
							Text="시간"
							TextWrapping="Wrap" />
						<TextBox
							Grid.Row="4"
							Grid.Column="1"
							Margin="10,4,0,0"
							md:HintAssist.Hint="이벤트 시간"
							md:HintAssist.IsFloating="True"
							IsReadOnly="True"
							Opacity="1"
							Text="{Binding DateTime, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" />
					</Grid>
				</Grid>
			</Border>
		</md:Flipper.BackContent>
	</md:Flipper>
</UserControl>
