<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dashboards.EventDashboardView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:consoles="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Consoles"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Dashboards"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:views="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		이벤트 콘솔(events-console) — 레일 · 목록 · 상세 3단. 정본 목업:
		docs/design/window-layout-system-storyboard.html L988-1030(콘솔) · L1040-1047(창 매핑) · L2302-2612 · L2688-2757
		docs/design/all-windows-drag-wireframe.html L283 · L423 · L427(드래그 판정)

		치수(헤더 40 · 레일 184/56 · 툴바 48 · 행 38 · 상태 띠 30 · 상세 340)와 폭별 도킹/서랍/접힘은 ConsoleShell 이 맡는다.
		목록을 가두는 고정 높이는 하나도 두지 않는다 — 옛 화면의 Height=280 이 이 창의 결함이었다.
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationId 만.
		컨버터는 뷰 로컬 등록 — Events.Ui/Resources/Resources.xaml 은 앱에 병합되지 않는다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<conv:EnumToKoreanConverter x:Key="Korean" />
		<conv:DeviceZoneConverter x:Key="Zone" />
		<conv:FaultSectionConverter x:Key="FaultSection" />
		<conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
		<utils:BindingProxy x:Key="Proxy" Data="{Binding}" />
		<local:EventIconKindConverter x:Key="IconKind" />

		<!--  행 우클릭 '조치보고' — 기존 패널의 ReportCommand 를 그대로 쓴다(새 경로를 만들지 않는다)  -->
		<ContextMenu x:Key="DetectionRowMenu">
			<MenuItem
				AutomationProperties.AutomationId="Console.Events.Row.Report"
				Command="{Binding Data.DetectionPanelViewModel.ReportCommand, Source={StaticResource Proxy}}"
				CommandParameter="{Binding}"
				Header="조치보고" />
		</ContextMenu>
		<ContextMenu x:Key="MalfunctionRowMenu">
			<MenuItem
				AutomationProperties.AutomationId="Console.Events.Row.Report"
				Command="{Binding Data.MalfunctionPanelViewModel.ReportCommand, Source={StaticResource Proxy}}"
				CommandParameter="{Binding}"
				Header="조치보고" />
		</ContextMenu>

		<!--  손잡이 열 — 행 본체가 아니라 이 손잡이에서만 끌기가 시작된다(범위 선택 · 셀 편집과의 3중 충돌 회피)  -->
		<DataTemplate x:Key="HandleCell">
			<!--  커널의 기본 템플릿(6점 그립)을 그대로 쓴다 — 모양을 창마다 다시 그리지 않는다.  -->
			<drag:DragHandle
				AutomationProperties.AutomationId="Console.Events.Row.Handle"
				ToolTip="끌어서 조치 트레이에 담기" />
		</DataTemplate>

		<Style x:Key="EventRow" BasedOn="{StaticResource Console.DataGrid.Row}" TargetType="DataGridRow">
			<Setter Property="AutomationProperties.AutomationId" Value="{Binding Model.Id, StringFormat=Console.Events.Row.{0}}" />
		</Style>
	</UserControl.Resources>

	<c:ConsoleShell
		ConsoleKey="Events"
		IsDetailRequested="{Binding Detail.IsDetailRequested}"
		Subtitle="{Binding Subtitle}"
		Title="이벤트">

		<!--  레일 — 개요 + 내역 4종. 배지 = 합계, 미조치가 있으면 ▲n · 합계  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.Events.Rail"
				ConsoleKey="Events"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Resources>
					<!--  아이콘 토큰 — 싱글턴 뷰모델이 시각 요소를 쥐지 않게 여기서 그린다  -->
					<DataTemplate DataType="{x:Type consoles:EventConsoleIcon}">
						<md:PackIcon
							Width="18"
							Height="18"
							Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
					</DataTemplate>
				</c:ConsoleRail.Resources>
				<c:ConsoleRail.Footer>
					<StackPanel AutomationProperties.AutomationId="Console.Events.Rail.Footer">
						<TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}">
							<Run Text="미조치 " /><Run Text="{Binding OpenCountText, Mode=OneWay}" />
						</TextBlock>
						<TextBlock FontSize="12.5" Foreground="{DynamicResource StatusCriticalBrush}">
							<Run Text="장애 진행 " /><Run Text="{Binding FaultCountText, Mode=OneWay}" />
						</TextBlock>
					</StackPanel>
				</c:ConsoleRail.Footer>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<!--  툴바 — 기간 칩 · 검색 · [N건 조치보고](드래그의 키보드 폴백) · [갱신]  -->
		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="{Binding AddBlockedReason}"
				AddText="추가"
				CanAdd="{Binding CanAdd}"
				CanDelete="{Binding CanDelete}"
				CanRefresh="{Binding CanReload}"
				ConsoleKey="Events"
				DeleteClick="OnDelete"
				DeleteDisabledReason="{Binding DeleteBlockedReason}"
				RefreshClick="OnReload"
				SearchPlaceholder="장비 · 구역 검색"
				SearchText="{Binding SearchText, Mode=TwoWay}"
				ShowSearch="{Binding IsListVisible}">
				<c:ConsoleToolbar.Filters>
					<StackPanel Orientation="Horizontal">
						<ItemsControl AutomationProperties.AutomationId="Console.Events.Toolbar.Period" ItemsSource="{Binding PeriodOptions}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										Margin="0,0,4,0"
										AutomationProperties.AutomationId="{Binding Name, StringFormat=Console.Events.Period.{0}}"
										Click="OnPeriodClick"
										Content="{Binding Name}"
										FontSize="12"
										GroupName="EventsPeriod"
										IsChecked="{Binding IsSelected, Mode=OneWay}"
										Style="{StaticResource MaterialDesignTabRadioButton}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!--  직접 지정 — 드래그의 폴백이자 정확한 입력 수단  -->
						<StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}">
							<mah:DateTimePicker
								Width="170"
								Margin="6,0,0,0"
								AutomationProperties.AutomationId="Console.Events.Period.From"
								FontSize="12"
								SelectedDateTime="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							<TextBlock
								Margin="6,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="~" />
							<mah:DateTimePicker
								Width="170"
								AutomationProperties.AutomationId="Console.Events.Period.To"
								DisplayDateStart="{Binding EndDateDisplay, Mode=TwoWay}"
								FontSize="12"
								SelectedDateTime="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</StackPanel>
					</StackPanel>
				</c:ConsoleToolbar.Filters>

				<c:ConsoleToolbar.Extra>
					<StackPanel Orientation="Horizontal">

					<!--  조회 중단 — 옆 창의 [취소] 가 하던 일(R14). 바쁜 동안만 뜬다  -->
					<Button
						Margin="0,0,6,0"
						AutomationProperties.AutomationId="Console.Events.Toolbar.CancelQuery"
						Click="OnCancelQuery"
						Content="중단"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="진행 중인 조회를 멈춥니다"
						Visibility="{Binding IsQueryRunning, Converter={StaticResource BoolToVis}}" />
					<!--  N-13 mapping workbench — 창으로 연다(3-Pane 은 1280 폭이 필요해 이 콘솔 안에 들어가지 않는다).  -->
					<Button
						Margin="0,0,8,0"
						AutomationProperties.AutomationId="Console.Events.Toolbar.Mapping"
						Click="OnOpenMappingWorkbench"
						Content="이벤트 맵핑"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="이벤트가 났을 때 움직일 카메라 · 스피커 · 경광등을 정합니다"
						Visibility="{Binding CanOpenMappingWorkbench, Converter={StaticResource BoolToVis}}" />
					<Button
						AutomationProperties.AutomationId="Console.Events.Toolbar.Report"
						Click="OnQueueSelection"
						Content="{Binding QueueButtonText}"
						IsEnabled="{Binding CanQueueSelection}"
						Style="{StaticResource MaterialDesignRaisedButton}"
						ToolTip="고른 이벤트를 조치 트레이에 담습니다 — 행 손잡이를 끌어 놓아도 같습니다"
						Visibility="{Binding CanDragToTray, Converter={StaticResource BoolToVis}}" />
					</StackPanel>
				</c:ConsoleToolbar.Extra>
			</c:ConsoleToolbar>
		</c:ConsoleShell.Toolbar>

		<c:ConsoleShell.List>
			<DockPanel ClipToBounds="True" LastChildFill="True">
				<!--
					필터 칩 — 정본은 이것을 툴바에 두지만(L1013), 커널 툴바는 줄바꿈이 없는 한 줄이고
					캐넌이 ⋯ 안에 두는 [추가] · [삭제] 까지 고정으로 지고 있어 1360 폭에서 칩이 잘렸다.
					목록 바로 위 한 줄로 내린다 — 자리만 다르고 구성과 동작은 정본 그대로다(선언된 편차).
				-->
				<Border
					Padding="12,6"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,0,0,1"
					DockPanel.Dock="Top"
					Visibility="{Binding HasFilterChips, Converter={StaticResource BoolToVis}}">
						<!--  필터 칩 — 정본 L2310-2313. 다른 콘솔처럼 형태(테두리 + 배경)로 누른 것을 보인다  -->
						<ItemsControl
							Margin="0"
							AutomationProperties.AutomationId="Console.Events.Toolbar.Filters"
							ItemsSource="{Binding FilterChips}"
							Visibility="{Binding HasFilterChips, Converter={StaticResource BoolToVis}}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										Margin="0,0,4,0"
										AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Events.Filter.{0}}"
										Click="OnFilterChipClick"
										Content="{Binding Label}"
										FontSize="12"
										GroupName="EventsFilter"
										IsChecked="{Binding IsSelected, Mode=OneWay}"
										Style="{StaticResource MaterialDesignTabRadioButton}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
				</Border>

			<Grid ClipToBounds="True">
				<!--  개요(T3)  -->
				<views:EventOverviewView
					DataContext="{Binding Overview}"
					Visibility="{Binding DataContext.IsOverview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

				<!--  탐지 내역 — 고정 높이 없음 · 무한 스크롤 유지 · 정렬/열 재정렬 없음  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Detection"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsDetectionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding DetectionPanelViewModel.LoadMoreCommand}" Threshold="50" />
						<!--  선택한 행 N건 → 조치 트레이. 같은 일을 툴바 버튼으로도 한다(드래그 전용 아님)  -->
						<drag:CaptureDragBehavior
							DisplayMemberPath="Device.DeviceName"
							Handler="{Binding TrayDrop}"
							IsDragEnabled="{Binding CanDragToTray}"
							KeyboardFallback="행을 고른 뒤 툴바의 [조치보고] 를 누른다" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<!--  핸들 열은 안쪽 여백이 없어야 한다 — 기본 셀 템플릿의 Padding 12 가 26폭 열을 지워 버린다.  -->
						<DataGridTemplateColumn
							Width="28"
							CellStyle="{StaticResource Console.DataGrid.Cell.Flush}"
							CellTemplate="{StaticResource HandleCell}"
							IsReadOnly="True" />
						<DataGridTemplateColumn Width="92" Header="조치">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border
										Padding="7,1"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										CornerRadius="9">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource TintWarningBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsActionReported}" Value="True">
														<Setter Property="Background" Value="{DynamicResource TintSuccessBrush}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="미조치" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsActionReported}" Value="True">
															<Setter Property="Text" Value="조치 있음" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="150"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							Header="발생시각" />
						<DataGridTemplateColumn Width="76" Header="스냅샷">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid Width="46" Height="30">
										<md:PackIcon
											Width="16"
											Height="16"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Kind="ImageOffOutline"
											Opacity="0.4" />
										<Image
											RenderOptions.BitmapScalingMode="HighQuality"
											Source="{Binding Thumbnail, Mode=OneWay}"
											Stretch="Uniform"
											Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="100"
							Binding="{Binding MessageType, Converter={StaticResource Korean}}"
							Header="유형" />
						<DataGridTextColumn
							Width="*"
							Binding="{Binding Device.DeviceName}"
							Header="장비" />
						<DataGridTextColumn
							Width="120"
							Binding="{Binding Device, Converter={StaticResource Zone}}"
							Header="구역" />
						<DataGridTextColumn
							Width="130"
							Binding="{Binding Result, Converter={StaticResource Korean}}"
							Header="결과" />
						<DataGridTextColumn
							Width="80"
							Binding="{Binding SignalText}"
							Header="신호" />
					</DataGrid.Columns>
					<DataGrid.RowStyle>
						<Style BasedOn="{StaticResource EventRow}" TargetType="DataGridRow">
							<Setter Property="ContextMenu" Value="{StaticResource DetectionRowMenu}" />
						</Style>
					</DataGrid.RowStyle>
				</DataGrid>

				<!--  장애 내역  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Malfunction"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsMalfunctionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding MalfunctionPanelViewModel.LoadMoreCommand}" Threshold="50" />
						<drag:CaptureDragBehavior
							DisplayMemberPath="Device.DeviceName"
							Handler="{Binding TrayDrop}"
							IsDragEnabled="{Binding CanDragToTray}"
							KeyboardFallback="행을 고른 뒤 툴바의 [조치보고] 를 누른다" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<!--  핸들 열은 안쪽 여백이 없어야 한다 — 기본 셀 템플릿의 Padding 12 가 26폭 열을 지워 버린다.  -->
						<DataGridTemplateColumn
							Width="28"
							CellStyle="{StaticResource Console.DataGrid.Cell.Flush}"
							CellTemplate="{StaticResource HandleCell}"
							IsReadOnly="True" />
						<DataGridTemplateColumn Width="92" Header="조치">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border
										Padding="7,1"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										CornerRadius="9">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource TintWarningBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsActionReported}" Value="True">
														<Setter Property="Background" Value="{DynamicResource TintSuccessBrush}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="미조치" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsActionReported}" Value="True">
															<Setter Property="Text" Value="조치 있음" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="150"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							Header="발생시각" />
						<DataGridTextColumn
							Width="*"
							Binding="{Binding Device.DeviceName}"
							Header="장비" />
						<DataGridTextColumn
							Width="120"
							Binding="{Binding DeviceTypeName}"
							Header="종류" />
						<DataGridTextColumn
							Width="140"
							Binding="{Binding Reason, Converter={StaticResource Korean}}"
							Header="사유" />
						<!--  고장 구간 = 제어기 루프 위의 지점(정수)이지 시각이 아니다  -->
						<DataGridTemplateColumn Width="150" Header="고장 구간">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="Consolas"
										FontSize="12"
										Text="{Binding Converter={StaticResource FaultSection}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
					<DataGrid.RowStyle>
						<Style BasedOn="{StaticResource EventRow}" TargetType="DataGridRow">
							<Setter Property="ContextMenu" Value="{StaticResource MalfunctionRowMenu}" />
						</Style>
					</DataGrid.RowStyle>
				</DataGrid>

				<!--  연결 내역 — 조치 열도 조치보고도 두지 않는다(action_reported 필드가 없다)  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Connection"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					RowStyle="{StaticResource EventRow}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsConnectionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding ConnectionPanelViewModel.LoadMoreCommand}" Threshold="50" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<DataGridTextColumn
							Width="150"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							Header="발생시각" />
						<DataGridTextColumn
							Width="*"
							Binding="{Binding Device.DeviceName}"
							Header="장비" />
						<DataGridTextColumn
							Width="140"
							Binding="{Binding DeviceTypeName}"
							Header="종류" />
						<DataGridTextColumn
							Width="120"
							Binding="{Binding MessageType, Converter={StaticResource Korean}}"
							Header="상태" />
					</DataGrid.Columns>
				</DataGrid>

				<!--  조치 내역  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Action"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					RowStyle="{StaticResource EventRow}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsActionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding ActionPanelViewModel.LoadMoreCommand}" Threshold="50" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<DataGridTextColumn
							Width="150"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							Header="발생시각" />
						<DataGridTextColumn
							Width="90"
							Binding="{Binding OriginEvent.Id}"
							Header="원본" />
						<DataGridTemplateColumn Width="76" Header="스냅샷">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid Width="46" Height="30">
										<md:PackIcon
											Width="16"
											Height="16"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Kind="ImageOffOutline"
											Opacity="0.4" />
										<Image
											RenderOptions.BitmapScalingMode="HighQuality"
											Source="{Binding OriginThumbnail, Mode=OneWay}"
											Stretch="Uniform"
											Visibility="{Binding HasOriginThumbnail, Converter={StaticResource BoolToVis}}" />
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="160"
							Binding="{Binding OriginEvent.Device.DeviceName}"
							Header="장비" />
						<DataGridTextColumn
							Width="120"
							Binding="{Binding User}"
							Header="사용자" />
						<DataGridTextColumn
							Width="*"
							Binding="{Binding Content}"
							Header="내용" />
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
			</DockPanel>
		</c:ConsoleShell.List>

		<!--  상태 띠 — 건수 + 조치 트레이(끄는 중에 생기는 드롭존은 잡을 수 없어 접지 않는다)  -->
		<c:ConsoleShell.StatusBar>
			<Border
				Padding="12,5"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<StackPanel>
					<DockPanel LastChildFill="True">
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Events.Status.Message"
							DockPanel.Dock="Right"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding StatusText}"
							TextTrimming="CharacterEllipsis" />
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Events.Status.Count"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding ListStatusText}" />
					</DockPanel>

					<views:ActionTrayView
						Margin="0,6,0,0"
						Visibility="{Binding IsTrayVisible, Converter={StaticResource BoolToVis}}" />
				</StackPanel>
			</Border>
		</c:ConsoleShell.StatusBar>

		<!--  상세 — 여섯 상태 + 고정 적용 막대  -->
		<c:ConsoleShell.Detail>
			<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="{Binding Detail.ApplyText}"
				Banner="{Binding DetailView.BannerText}"
				CanApply="{Binding Detail.CanApply}"
				CanRevert="{Binding Detail.CanRevert}"
				ConsoleKey="Events"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding Detail.FooterText}"
				IsDirty="{Binding Detail.IsDirty}"
				IsReadOnly="{Binding Detail.IsReadOnly}"
				Kind="{Binding Detail.Kind}"
				RevertClick="OnRevert"
				RevertText="{Binding Detail.RevertText}"
				ShakeToken="{Binding Detail.ShakeToken}"
				ShowButtons="{Binding Detail.ShowButtons}"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding Detail.Title}">
				<views:EventDetailView DataContext="{Binding DetailView}" />
			</c:ConsoleDetailHost>
		</c:ConsoleShell.Detail>
	</c:ConsoleShell>
</UserControl>
