<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Dashboards.EventDashboardView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:consoles="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Consoles"
	xmlns:conv="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Converters"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Dashboards"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:views="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Consoles"
	FontFamily="{DynamicResource MaterialDesignFont}">
	<!--
		이벤트 콘솔(events-console) — 레일 · 목록 · 상세 3단. 정본 목업:
		docs/design/window-layout-system-storyboard.html L988-1030(콘솔) · L1040-1047(창 매핑) · L2302-2612 · L2688-2757
		docs/design/all-windows-drag-wireframe.html L283 · L423 · L427(드래그 판정)

		치수(헤더 40 · 레일 184/56 · 툴바 48 · 행 38 · 상태 띠 30 · 상세 340)와 폭별 도킹/서랍/접힘은 ConsoleShell 이 맡는다.
		목록을 가두는 고정 높이는 하나도 두지 않는다 — 옛 화면의 Height=280 이 이 창의 결함이었다.
		x:Name 은 쓰지 않는다(Caliburn 바인딩 지시자) — 계측은 AutomationId 만.
		컨버터는 뷰 로컬 등록 — Events.Ui/Resources/Resources.xaml 은 앱에 병합되지 않는다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<conv:EnumToKoreanConverter x:Key="Korean" />
		<conv:DeviceZoneConverter x:Key="Zone" />
		<conv:FaultSectionConverter x:Key="FaultSection" />
		<conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
		<utils:BindingProxy x:Key="Proxy" Data="{Binding}" />
		<local:EventIconKindConverter x:Key="IconKind" />

		<!--  행 우클릭 '조치보고' — 기존 패널의 ReportCommand 를 그대로 쓴다(새 경로를 만들지 않는다)  -->
		<ContextMenu x:Key="DetectionRowMenu">
			<MenuItem
				AutomationProperties.AutomationId="Console.Events.Row.Report"
				Command="{Binding Data.DetectionPanelViewModel.ReportCommand, Source={StaticResource Proxy}}"
				CommandParameter="{Binding}"
				Header="조치보고" />
		</ContextMenu>
		<ContextMenu x:Key="MalfunctionRowMenu">
			<MenuItem
				AutomationProperties.AutomationId="Console.Events.Row.Report"
				Command="{Binding Data.MalfunctionPanelViewModel.ReportCommand, Source={StaticResource Proxy}}"
				CommandParameter="{Binding}"
				Header="조치보고" />
		</ContextMenu>

		<!--  손잡이 열 — 행 본체가 아니라 이 손잡이에서만 끌기가 시작된다(범위 선택 · 셀 편집과의 3중 충돌 회피)  -->
		<DataTemplate x:Key="HandleCell">
			<!--  커널의 기본 템플릿(6점 그립)을 그대로 쓴다 — 모양을 창마다 다시 그리지 않는다.  -->
			<drag:DragHandle
				AutomationProperties.AutomationId="Console.Events.Row.Handle"
				ToolTip="끌어서 조치 트레이에 담기" />
		</DataTemplate>

		<Style x:Key="EventRow" BasedOn="{StaticResource Console.DataGrid.Row}" TargetType="DataGridRow">
			<Setter Property="AutomationProperties.AutomationId" Value="{Binding Model.Id, StringFormat=Console.Events.Row.{0}}" />
		</Style>

		<!--
			기간 칩(오늘 · 24시간 · 7일 · 직접) — 고른 것을 형태(2px 테두리)와 틴트 바탕, 글자 굵기로 보인다.
			MDIX 의 MaterialDesignTabRadioButton 은 고른 것을 앰버(#FFAB00) 글자로만 칠해
			라이트 바탕(#F2F5F9) 대비 1.73:1 이었다 — 어느 것이 켜졌는지 눈으로 가를 수 없었다.
			두꺼워진 테두리만큼 안쪽 여백을 줄여 고를 때 줄이 흔들리지 않게 한다.
		-->
		<Style x:Key="ConsoleChip" TargetType="RadioButton">
			<Setter Property="Margin" Value="0,0,5,0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid>
							<Border
								x:Name="Chip"
								Padding="10,3"
								Background="{DynamicResource SurfaceAltBrush}"
								BorderBrush="{DynamicResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="11">
								<TextBlock
									x:Name="Label"
									VerticalAlignment="Center"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{TemplateBinding Content}" />
							</Border>
							<!--  포커스는 색이 아니라 바깥 윤곽(형태)  -->
							<Border
								x:Name="Focus"
								Margin="-3"
								BorderBrush="{DynamicResource FocusRingBrush}"
								BorderThickness="2"
								CornerRadius="13"
								Visibility="Collapsed" />
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
								<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Chip" Property="Padding" Value="9,2" />
								<Setter TargetName="Chip" Property="Background" Value="{DynamicResource TintInfoBrush}" />
								<Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
								<Setter TargetName="Chip" Property="BorderThickness" Value="2" />
								<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
								<Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Focus" Property="Visibility" Value="Visible" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--
			목록 위 거르기 줄(탭 꼴) — 고른 것은 본문색 + SemiBold + 2px PrimaryBrush 밑줄.
			형태(밑줄)와 읽히는 색을 함께 쓴다. 앰버는 라이트에서 흰 바탕과 1.73:1 이라 쓰지 않는다.
		-->
		<Style x:Key="ConsoleTab" TargetType="RadioButton">
			<Setter Property="Margin" Value="0,0,4,0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border
							x:Name="Bd"
							Padding="14,5"
							Background="Transparent"
							BorderBrush="Transparent"
							BorderThickness="0,0,0,2">
							<TextBlock
								x:Name="Label"
								VerticalAlignment="Center"
								FontSize="12"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{TemplateBinding Content}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
								<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
								<Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
								<Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!--
			조치 배지 — 커널 Console.Pill.{변형} 그대로. 폭을 고정하지 않는다:
			92 폭 열 안의 고정 배지가 "조치 있음" 의 마지막 글자를 제 테두리로 잘라 먹고 있었다.
			★ 글자에 Foreground 를 다시 쓰지 않는다 — 지역 값이 커널의 상속 TextElement.Foreground 를
			  이겨 버려 대비 보정이 그 자리에서만 무효가 된다. 뜻은 점과 테두리(형태)가 나른다.
		-->
		<Style
			x:Key="ActionPill"
			BasedOn="{StaticResource Console.Pill.Warning}"
			TargetType="Border">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsActionReported}" Value="True">
					<Setter Property="BorderBrush" Value="{DynamicResource StatusNormalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style
			x:Key="ActionPillDot"
			BasedOn="{StaticResource Console.Pill.Dot}"
			TargetType="Ellipse">
			<Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsActionReported}" Value="True">
					<Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="ActionPillText" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Text" Value="미조치" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsActionReported}" Value="True">
					<Setter Property="Text" Value="조치 있음" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Grid>
		<c:ConsoleShell
			ConsoleKey="Events"
		IsDetailRequested="{Binding Detail.IsDetailRequested}"
		Subtitle="{Binding Subtitle}"
		Title="이벤트">

		<!--  레일 — 개요 + 내역 4종. 배지 = 합계, 미조치가 있으면 ▲n · 합계  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.Events.Rail"
				ConsoleKey="Events"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Resources>
					<!--  아이콘 토큰 — 싱글턴 뷰모델이 시각 요소를 쥐지 않게 여기서 그린다  -->
					<DataTemplate DataType="{x:Type consoles:EventConsoleIcon}">
						<md:PackIcon
							Width="18"
							Height="18"
							Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
					</DataTemplate>
				</c:ConsoleRail.Resources>
				<c:ConsoleRail.Footer>
					<StackPanel AutomationProperties.AutomationId="Console.Events.Rail.Footer">
						<TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}">
							<Run Text="미조치 " /><Run Text="{Binding OpenCountText, Mode=OneWay}" />
						</TextBlock>
						<TextBlock FontSize="12.5" Foreground="{DynamicResource StatusCriticalBrush}">
							<Run Text="장애 진행 " /><Run Text="{Binding FaultCountText, Mode=OneWay}" />
						</TextBlock>
					</StackPanel>
				</c:ConsoleRail.Footer>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<!--
			툴바 — 기간 칩 · 검색 · [N건 조치보고](드래그의 키보드 폴백) · [갱신]
			검색칸 안내 글은 짧게 둔다: 커널 검색칸은 남는 폭만 받는 자리(MinWidth 120)라
			"장비 · 구역 검색" 은 제 테두리에 마지막 글자가 잘려 나갔다.
		-->
		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="{Binding AddBlockedReason}"
				AddText="{Binding AddButtonText}"
				CanAdd="{Binding CanAdd}"
				CanDelete="{Binding CanDelete}"
				CanRefresh="{Binding CanReload}"
				ConsoleKey="Events"
				DeleteClick="OnDelete"
				DeleteDisabledReason="{Binding DeleteBlockedReason}"
				RefreshClick="OnReload"
				SearchPlaceholder="장비 · 구역"
				SearchText="{Binding SearchText, Mode=TwoWay}"
				ShowSearch="{Binding ShowSearch}">
				<c:ConsoleToolbar.Filters>
					<StackPanel Orientation="Horizontal">
						<!--  억제 스케줄 상태 칩 (정본 SB L2313) — 기간 칩 대신 뜬다  -->
						<ItemsControl
							AutomationProperties.AutomationId="Console.Suppression.Toolbar.Filter"
							ItemsSource="{Binding Suppression.Filters}"
							Visibility="{Binding IsSuppressionRail, Converter={StaticResource BoolToVis}}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										Margin="0,0,4,0"
										AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Suppression.Filter.{0}}"
										Click="OnSuppressionFilterClick"
										Content="{Binding Label}"
										FontSize="12"
										GroupName="SuppressionFilter"
										IsChecked="{Binding IsSelected, Mode=OneWay}"
										Style="{StaticResource MaterialDesignTabRadioButton}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<ItemsControl
							AutomationProperties.AutomationId="Console.Events.Toolbar.Period"
							ItemsSource="{Binding PeriodOptions}"
							Visibility="{Binding ShowPeriodChips, Converter={StaticResource BoolToVis}}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										AutomationProperties.AutomationId="{Binding Name, StringFormat=Console.Events.Period.{0}}"
										Click="OnPeriodClick"
										Content="{Binding Name}"
										GroupName="EventsPeriod"
										IsChecked="{Binding IsSelected, Mode=OneWay}"
										Style="{StaticResource ConsoleChip}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!--  직접 지정 — 팝업 달력(연속 범위) + 시작/종료 시각. 드래그의 폴백이자 정확한 입력 수단이며,
						     트리거는 계속 포커스 가능해 자동화가 좌표 클릭에 묶이지 않는다(요구사항 3).  -->
						<c:DateTimeRangeField
							Margin="6,0,0,0"
							VerticalAlignment="Center"
							FromAutomationId="Console.Events.Period.From"
							RangeEnd="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							RangeStart="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							ToAutomationId="Console.Events.Period.To"
							Visibility="{Binding ShowCustomPeriod, Converter={StaticResource BoolToVis}}" />
					</StackPanel>
				</c:ConsoleToolbar.Filters>

				<c:ConsoleToolbar.Extra>
					<StackPanel Orientation="Horizontal">

					<!--  조회 중단 — 옆 창의 [취소] 가 하던 일(R14). 바쁜 동안만 뜬다  -->
					<Button
						Margin="0,0,8,0"
						AutomationProperties.AutomationId="Console.Events.Toolbar.CancelQuery"
						Click="OnCancelQuery"
						Content="중단"
						Style="{StaticResource Console.Button}"
						ToolTip="진행 중인 조회를 멈춥니다"
						Visibility="{Binding IsQueryRunning, Converter={StaticResource BoolToVis}}" />
					<!--  N-13 mapping workbench — 창으로 연다(3-Pane 은 1280 폭이 필요해 이 콘솔 안에 들어가지 않는다).  -->
					<Button
						Margin="0,0,8,0"
						AutomationProperties.AutomationId="Console.Events.Toolbar.Mapping"
						Click="OnOpenMappingWorkbench"
						Content="이벤트 맵핑"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="이벤트가 났을 때 움직일 카메라 · 스피커 · 경광등을 정합니다"
						Visibility="{Binding CanOpenMappingWorkbench, Converter={StaticResource BoolToVis}}" />
					<!--  억제 목록 전용 — 취소 · 종료 행을 한꺼번에 지운다(확인 팝업이 먼저 뜬다)  -->
					<Button
						Margin="0,0,6,0"
						AutomationProperties.AutomationId="Console.Suppression.Toolbar.Cleanup"
						Click="OnSuppressionCleanup"
						Content="{Binding Suppression.CleanupText}"
						FontSize="11.5"
						IsEnabled="{Binding Suppression.CanCleanupAll}"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="목록의 취소 · 종료 항목을 모두 지웁니다 — 되돌릴 수 없습니다"
						Visibility="{Binding IsSuppressionRail, Converter={StaticResource BoolToVis}}" />
					<Button
						AutomationProperties.AutomationId="Console.Events.Toolbar.Report"
						Click="OnQueueSelection"
						Content="{Binding QueueButtonText}"
						IsEnabled="{Binding CanQueueSelection}"
						Style="{StaticResource Console.Button.Primary}"
						ToolTip="고른 이벤트를 조치 트레이에 담습니다 — 행 손잡이를 끌어 놓아도 같습니다"
						Visibility="{Binding CanDragToTray, Converter={StaticResource BoolToVis}}" />
					</StackPanel>
				</c:ConsoleToolbar.Extra>
			</c:ConsoleToolbar>
		</c:ConsoleShell.Toolbar>

		<c:ConsoleShell.List>
			<DockPanel ClipToBounds="True" LastChildFill="True">
				<!--
					필터 칩 — 정본은 이것을 툴바에 두지만(L1013), 커널 툴바는 줄바꿈이 없는 한 줄이고
					캐넌이 ⋯ 안에 두는 [추가] · [삭제] 까지 고정으로 지고 있어 1360 폭에서 칩이 잘렸다.
					목록 바로 위 한 줄로 내린다 — 자리만 다르고 구성과 동작은 정본 그대로다(선언된 편차).
				-->
				<Border
					Padding="12,6"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,0,0,1"
					DockPanel.Dock="Top"
					Visibility="{Binding HasFilterChips, Converter={StaticResource BoolToVis}}">
						<!--  필터 칩 — 정본 L2310-2313. 다른 콘솔처럼 형태(테두리 + 배경)로 누른 것을 보인다  -->
						<ItemsControl
							Margin="0"
							AutomationProperties.AutomationId="Console.Events.Toolbar.Filters"
							ItemsSource="{Binding FilterChips}"
							Visibility="{Binding HasFilterChips, Converter={StaticResource BoolToVis}}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<RadioButton
										AutomationProperties.AutomationId="{Binding Key, StringFormat=Console.Events.Filter.{0}}"
										Click="OnFilterChipClick"
										Content="{Binding Label}"
										GroupName="EventsFilter"
										IsChecked="{Binding IsSelected, Mode=OneWay}"
										Style="{StaticResource ConsoleTab}" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
				</Border>

			<Grid ClipToBounds="True">
				<!--  개요(T3)  -->
				<views:EventOverviewView
					DataContext="{Binding Overview}"
					Visibility="{Binding DataContext.IsOverview, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />

				<!--  탐지 내역 — 고정 높이 없음 · 무한 스크롤 유지 · 정렬/열 재정렬 없음  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Detection"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsDetectionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding DetectionPanelViewModel.LoadMoreCommand}" Threshold="50" />
						<!--  선택한 행 N건 → 조치 트레이. 같은 일을 툴바 버튼으로도 한다(드래그 전용 아님)  -->
						<drag:CaptureDragBehavior
							DisplayMemberPath="Device.DeviceName"
							Handler="{Binding TrayDrop}"
							IsDragEnabled="{Binding CanDragToTray}"
							KeyboardFallback="행을 고른 뒤 툴바의 [조치보고] 를 누른다" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<!--  핸들 열은 안쪽 여백이 없어야 한다 — 기본 셀 템플릿의 Padding 12 가 26폭 열을 지워 버린다.  -->
						<DataGridTemplateColumn
							Width="28"
							MinWidth="28"
							CellStyle="{StaticResource Console.DataGrid.Cell.Flush}"
							CellTemplate="{StaticResource HandleCell}"
							IsReadOnly="True" />
						<DataGridTemplateColumn
							Width="120"
							MinWidth="120"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="조치">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource ActionPill}">
										<StackPanel Orientation="Horizontal">
											<Ellipse Style="{StaticResource ActionPillDot}" />
											<TextBlock Style="{StaticResource ActionPillText}" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="160"
							MinWidth="160"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="발생시각" />
						<DataGridTemplateColumn Width="76" MinWidth="76" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="스냅샷">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid Width="46" Height="30">
										<md:PackIcon
											Width="16"
											Height="16"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Kind="ImageOffOutline"
											Opacity="0.4" />
										<Image
											RenderOptions.BitmapScalingMode="HighQuality"
											Source="{Binding Thumbnail, Mode=OneWay}"
											Stretch="Uniform"
											Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="100"
							MinWidth="100"
							Binding="{Binding MessageType, Converter={StaticResource Korean}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="유형" />
						<DataGridTextColumn
							Width="*"
							MinWidth="140"
							Binding="{Binding Device.DeviceName}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="장비" />
						<DataGridTextColumn
							Width="120"
							MinWidth="120"
							Binding="{Binding Device, Converter={StaticResource Zone}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="구역" />
						<DataGridTextColumn
							Width="130"
							MinWidth="130"
							Binding="{Binding Result, Converter={StaticResource Korean}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="결과" />
						<DataGridTextColumn
							Width="80"
							MinWidth="80"
							Binding="{Binding SignalText}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="신호" />
					</DataGrid.Columns>
					<DataGrid.RowStyle>
						<Style BasedOn="{StaticResource EventRow}" TargetType="DataGridRow">
							<Setter Property="ContextMenu" Value="{StaticResource DetectionRowMenu}" />
						</Style>
					</DataGrid.RowStyle>
				</DataGrid>

				<!--  장애 내역  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Malfunction"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsMalfunctionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding MalfunctionPanelViewModel.LoadMoreCommand}" Threshold="50" />
						<drag:CaptureDragBehavior
							DisplayMemberPath="Device.DeviceName"
							Handler="{Binding TrayDrop}"
							IsDragEnabled="{Binding CanDragToTray}"
							KeyboardFallback="행을 고른 뒤 툴바의 [조치보고] 를 누른다" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<!--  핸들 열은 안쪽 여백이 없어야 한다 — 기본 셀 템플릿의 Padding 12 가 26폭 열을 지워 버린다.  -->
						<DataGridTemplateColumn
							Width="28"
							MinWidth="28"
							CellStyle="{StaticResource Console.DataGrid.Cell.Flush}"
							CellTemplate="{StaticResource HandleCell}"
							IsReadOnly="True" />
						<DataGridTemplateColumn
							Width="120"
							MinWidth="120"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="조치">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border Style="{StaticResource ActionPill}">
										<StackPanel Orientation="Horizontal">
											<Ellipse Style="{StaticResource ActionPillDot}" />
											<TextBlock Style="{StaticResource ActionPillText}" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="160"
							MinWidth="160"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="발생시각" />
						<DataGridTextColumn
							Width="*"
							MinWidth="140"
							Binding="{Binding Device.DeviceName}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="장비" />
						<DataGridTextColumn
							Width="100"
							MinWidth="100"
							Binding="{Binding DeviceTypeName}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="종류" />
						<DataGridTextColumn
							Width="124"
							MinWidth="124"
							Binding="{Binding Reason, Converter={StaticResource Korean}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="사유" />
						<!--  고장 구간 = 제어기 루프 위의 지점(정수)이지 시각이 아니다  -->
						<DataGridTemplateColumn Width="124" MinWidth="124" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="고장 구간">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock
										VerticalAlignment="Center"
										FontFamily="Consolas"
										FontSize="12"
										Text="{Binding Converter={StaticResource FaultSection}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
					<DataGrid.RowStyle>
						<Style BasedOn="{StaticResource EventRow}" TargetType="DataGridRow">
							<Setter Property="ContextMenu" Value="{StaticResource MalfunctionRowMenu}" />
						</Style>
					</DataGrid.RowStyle>
				</DataGrid>

				<!--  연결 내역 — 조치 열도 조치보고도 두지 않는다(action_reported 필드가 없다)  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Connection"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					RowStyle="{StaticResource EventRow}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsConnectionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding ConnectionPanelViewModel.LoadMoreCommand}" Threshold="50" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<DataGridTextColumn
							Width="160"
							MinWidth="160"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="발생시각" />
						<DataGridTextColumn
							Width="*"
							MinWidth="140"
							Binding="{Binding Device.DeviceName}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="장비" />
						<DataGridTextColumn
							Width="140"
							MinWidth="140"
							Binding="{Binding DeviceTypeName}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="종류" />
						<DataGridTextColumn
							Width="120"
							MinWidth="120"
							Binding="{Binding MessageType, Converter={StaticResource Korean}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="상태" />
					</DataGrid.Columns>
				</DataGrid>

				<!--  조치 내역  -->
				<DataGrid
					AutomationProperties.AutomationId="Console.Events.Grid.Action"
					CanUserReorderColumns="False"
					CanUserSortColumns="False"
					IsReadOnly="True"
					ItemsSource="{Binding Rows}"
					RowStyle="{StaticResource EventRow}"
					SelectionChanged="OnGridSelectionChanged"
					SelectionMode="Extended"
					Style="{StaticResource Console.DataGrid}"
					Visibility="{Binding IsActionRail, Converter={StaticResource BoolToVis}}">
					<b:Interaction.Behaviors>
						<inner:DataGridScrollEndBehavior Command="{Binding ActionPanelViewModel.LoadMoreCommand}" Threshold="50" />
					</b:Interaction.Behaviors>
					<DataGrid.Columns>
						<DataGridTextColumn
							Width="160"
							MinWidth="160"
							Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="발생시각" />
						<DataGridTextColumn
							Width="80"
							MinWidth="80"
							Binding="{Binding OriginEvent.Id}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="원본" />
						<DataGridTemplateColumn Width="76" MinWidth="76" CellStyle="{StaticResource Console.DataGrid.Cell}" Header="스냅샷">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid Width="46" Height="30">
										<md:PackIcon
											Width="16"
											Height="16"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Kind="ImageOffOutline"
											Opacity="0.4" />
										<Image
											RenderOptions.BitmapScalingMode="HighQuality"
											Source="{Binding OriginThumbnail, Mode=OneWay}"
											Stretch="Uniform"
											Visibility="{Binding HasOriginThumbnail, Converter={StaticResource BoolToVis}}" />
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn
							Width="130"
							MinWidth="130"
							Binding="{Binding OriginEvent.Device.DeviceName}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="장비" />
						<DataGridTextColumn
							Width="150"
							MinWidth="150"
							Binding="{Binding User}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="사용자" />
						<DataGridTextColumn
							Width="*"
							MinWidth="140"
							Binding="{Binding Content}"
							CellStyle="{StaticResource Console.DataGrid.Cell}"
							Header="내용" />
					</DataGrid.Columns>
				</DataGrid>

				<!--
					빈 목록 — 본문을 정말 비워 두지 않는다. 아무것도 없는 칸은 "한 건도 없다" 와
					"못 불러왔다" 를 구별해 주지 못하고, 바닥의 30px 상태 줄 하나로는 모자랐다.
				-->
				<c:ConsoleEmptyState
					AutomationProperties.AutomationId="Console.Events.List.EmptyState"
					Hint="{Binding EmptyStateHint}"
					Title="{Binding EmptyStateTitle}"
					Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" />
				<!--  억제 스케줄 T1 목록 (N-08) — 정렬 · 열 재정렬 없음  -->
				<views:SuppressionListView
					DataContext="{Binding Suppression}"
					Visibility="{Binding DataContext.IsSuppressionRail, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
			</Grid>
			</DockPanel>
		</c:ConsoleShell.List>

		<!--  상태 띠 — 건수 + 조치 트레이(끄는 중에 생기는 드롭존은 잡을 수 없어 접지 않는다)  -->
		<c:ConsoleShell.StatusBar>
			<Border
				Padding="12,5"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,1,0,0">
				<StackPanel>
					<DockPanel LastChildFill="True">
						<TextBlock
							Margin="12,0,0,0"
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Events.Status.Message"
							DockPanel.Dock="Right"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding StatusText}"
							TextTrimming="CharacterEllipsis" />
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="Console.Events.Status.Count"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding ListStatusText}" />
					</DockPanel>

					<views:ActionTrayView
						Margin="0,6,0,0"
						Visibility="{Binding IsTrayVisible, Converter={StaticResource BoolToVis}}" />
				</StackPanel>
			</Border>
		</c:ConsoleShell.StatusBar>

		<!--  상세 — 여섯 상태 + 고정 적용 막대  -->
		<c:ConsoleShell.Detail>
			<Grid>
				<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="{Binding Detail.ApplyText}"
				Banner="{Binding DetailView.BannerText}"
				CanApply="{Binding Detail.CanApply}"
				CanRevert="{Binding Detail.CanRevert}"
				ConsoleKey="Events"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding Detail.FooterText}"
				IsDirty="{Binding Detail.IsDirty}"
				IsReadOnly="{Binding Detail.IsReadOnly}"
				Kind="{Binding Detail.Kind}"
				RevertClick="OnRevert"
				RevertText="{Binding Detail.RevertText}"
				ShakeToken="{Binding Detail.ShakeToken}"
				ShowButtons="{Binding Detail.ShowButtons}"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding Detail.Title}"
				Visibility="{Binding IsSuppressionRail, Converter={StaticResource NotBoolToVis}}">
					<views:EventDetailView DataContext="{Binding DetailView}" />
				</c:ConsoleDetailHost>

				<!--  억제 스케줄 상세 (정본 SB L2734-2740) — 동작은 상세 안에 있다([수정] [취소 예약])  -->
				<c:ConsoleDetailHost
					ApplyClick="OnSuppressionEdit"
					ApplyText="수정"
					CanApply="{Binding Suppression.CanEditSelected}"
					CanRevert="{Binding Suppression.CanCancelSelected}"
					ConsoleKey="Suppression"
					DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
					FooterText="{Binding Suppression.StatusText}"
					Kind="{Binding Suppression.DetailKind}"
					RevertClick="OnSuppressionCancelBooking"
					RevertText="취소 예약"
					ShowButtons="{Binding Suppression.HasSelection}"
					ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
					Title="{Binding Suppression.DetailTitle}"
					Visibility="{Binding IsSuppressionRail, Converter={StaticResource BoolToVis}}">
					<views:SuppressionDetailView DataContext="{Binding Suppression}" />
				</c:ConsoleDetailHost>
			</Grid>
		</c:ConsoleShell.Detail>
		</c:ConsoleShell>

		<!--  억제 편집 서랍 — 같은 창 안 780 오버레이(정본 SB L1028 · L1122 E-D7).
				 윈도 머리띠(40)는 덮지 않는다 — 스크림은 몸통만 가린다.  -->
		<views:SuppressionDrawerView
			Margin="0,40,0,0"
			Panel.ZIndex="20"
			DataContext="{Binding Suppression.Drawer}" />
	</Grid>
</UserControl>
