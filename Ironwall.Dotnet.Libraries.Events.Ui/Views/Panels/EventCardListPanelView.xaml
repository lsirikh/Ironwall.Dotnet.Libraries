<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Views.Panels.EventCardListPanelView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:behavior_inner="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Views.Panels"
	xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:utilPass="clr-namespace:Ironwall.Dotnet.Libraries.Utils.PasswordControl;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<!--  전체 조치보고 버튼 ↔ ProgressCircle 전환용 컨버터 (PRD_Batch_Action_Report)
	      IsVisible=true → 버튼 표시 / IsVisible=false → ProgressCircle 표시
	      BoolToInverseVisibleConverter는 Events.Ui/Resources/Resources.xaml에 정의됨  -->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibleConverter" />
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<GridSplitter
			Grid.Row="0"
			Height="1"
			Foreground="{DynamicResource TextSecondaryBrush}" />
		<Grid Grid.Row="1" VerticalAlignment="Center">
			<Border
				Margin="0,0,0,0"
				HorizontalAlignment="Stretch"
				Background="{DynamicResource SurfaceAltBrush}"
				CornerRadius="2.5"
				Opacity="0.95"
				Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}">

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<StackPanel
						Grid.Column="0"
						Width="5"
						Background="{DynamicResource PrimaryBrush}"
						Opacity="0.8" />
					<Viewbox
						Grid.Column="1"
						VerticalAlignment="Center"
						Stretch="UniformToFill">
						<Grid>
							<Button
								x:Name="ButtonActionAll"
								md:RippleAssist.IsCentered="True"
								Foreground="{DynamicResource PrimaryBrush}"
								IsEnabled="{Binding ViewModelProvider.Count, Converter={StaticResource CountToBooleanConverter}}"
								Style="{StaticResource MaterialDesignIconForegroundButton}"
								ToolTip="전체 조치보고"
								Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibleConverter}}">
								<cal:Message.Attach>
									[Event Click] = [Action OnClickButtonActionAll($source, $eventArgs]
								</cal:Message.Attach>
								<md:PackIcon
									Width="23"
									Height="23"
									Kind="TrashCanOutline" />
							</Button>
							<ProgressBar
								Width="23"
								Height="23"
								IsIndeterminate="True"
								Style="{DynamicResource MaterialDesignCircularProgressBar}"
								Visibility="{Binding IsVisible, Converter={StaticResource BoolToInverseVisibleConverter}}" />
						</Grid>
					</Viewbox>

					<StackPanel
						Grid.Column="2"
						Margin="0,12,12,12"
						HorizontalAlignment="Right"
						Orientation="Horizontal">

						<!--  탐지·장애 신호등 (map-topbar-trafficlight FR-A1/A2 — T1 가로 3램프, 지도 pill 계기의 후신)
						      순서 고정 빨(장애)-노(탐지)-초(정상) · 동시 점등 허용 · 미초기화 시 전체 소등+"—"
						      장애 램프는 점등 중 상시 펄스(감시 공백 최우선 시인성, 스토리보드 S3)  -->
						<Border
							AutomationProperties.AutomationId="Events.Status.TrafficLight"
							Margin="0,0,8,0"
							Padding="8,3"
							VerticalAlignment="Center"
							Background="{DynamicResource SurfaceSunkenBrush}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="13"
							ToolTip="{Binding TrafficTooltip}"
							Visibility="{Binding IsTrafficLightVisible, Converter={StaticResource BoolToVisibleConverter}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<StackPanel.Resources>
									<!--  램프 공통: 소등=테두리만, 점등=DataTrigger가 채움+글로 부여  -->
									<Style x:Key="LampBase" TargetType="Ellipse">
										<Setter Property="Width" Value="11" />
										<Setter Property="Height" Value="11" />
										<Setter Property="VerticalAlignment" Value="Center" />
										<Setter Property="Fill" Value="{DynamicResource SurfaceAltBrush}" />
										<Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
										<Setter Property="StrokeThickness" Value="1" />
									</Style>
									<Style x:Key="LampCount" TargetType="TextBlock">
										<Setter Property="Margin" Value="4,0,0,0" />
										<Setter Property="VerticalAlignment" Value="Center" />
										<Setter Property="FontFamily" Value="Consolas" />
										<Setter Property="FontSize" Value="12" />
										<Setter Property="FontWeight" Value="Bold" />
									</Style>
								</StackPanel.Resources>

								<!--  🔴 장애 그룹 — 클릭=장애 카드만 필터(재클릭 해제, FR-A4) · 점등 시 상시 펄스  -->
								<Border
									AutomationProperties.AutomationId="Events.Status.TrafficLight.FaultGroup"
									Padding="2,1"
									Background="Transparent"
									BorderThickness="1"
									CornerRadius="9"
									Cursor="Hand">
									<cal:Message.Attach>
										[Event MouseLeftButtonUp] = [Action ToggleTrafficFaultFilter()]
									</cal:Message.Attach>
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="BorderBrush" Value="Transparent" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficFilterFault}" Value="True">
													<Setter Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<StackPanel Orientation="Horizontal">
								<Ellipse AutomationProperties.AutomationId="Events.Status.TrafficLight.FaultLamp">
									<Ellipse.Style>
										<Style BasedOn="{StaticResource LampBase}" TargetType="Ellipse">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficFaultOn}" Value="True">
													<Setter Property="Fill" Value="{DynamicResource StatusCriticalBrush}" />
													<Setter Property="Stroke" Value="{DynamicResource StatusCriticalBrush}" />
													<Setter Property="Effect">
														<Setter.Value>
															<DropShadowEffect
																BlurRadius="8"
																Color="#FF5A52"
																Opacity="0.9"
																ShadowDepth="0" />
														</Setter.Value>
													</Setter>
													<DataTrigger.EnterActions>
														<BeginStoryboard x:Name="FaultPulse">
															<Storyboard RepeatBehavior="Forever" AutoReverse="True">
																<DoubleAnimation
																	Storyboard.TargetProperty="Opacity"
																	From="1.0"
																	To="0.45"
																	Duration="0:0:0.8" />
															</Storyboard>
														</BeginStoryboard>
													</DataTrigger.EnterActions>
													<DataTrigger.ExitActions>
														<StopStoryboard BeginStoryboardName="FaultPulse" />
													</DataTrigger.ExitActions>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Ellipse.Style>
								</Ellipse>
								<TextBlock AutomationProperties.AutomationId="Events.Status.TrafficLight.FaultCount">
									<TextBlock.Style>
										<Style BasedOn="{StaticResource LampCount}" TargetType="TextBlock">
											<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
											<Setter Property="Text" Value="{Binding TrafficFaultCount}" />
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficFaultOn}" Value="True">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
									</StackPanel>
								</Border>

								<!--  🟡 탐지 그룹 — 클릭=탐지 카드만 필터(재클릭 해제, FR-A4)  -->
								<Border
									Margin="5,0,0,0"
									AutomationProperties.AutomationId="Events.Status.TrafficLight.DetectionGroup"
									Padding="2,1"
									Background="Transparent"
									BorderThickness="1"
									CornerRadius="9"
									Cursor="Hand">
									<cal:Message.Attach>
										[Event MouseLeftButtonUp] = [Action ToggleTrafficDetectionFilter()]
									</cal:Message.Attach>
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="BorderBrush" Value="Transparent" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficFilterDetection}" Value="True">
													<Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<StackPanel Orientation="Horizontal">
								<Ellipse AutomationProperties.AutomationId="Events.Status.TrafficLight.DetectionLamp">
									<Ellipse.Style>
										<Style BasedOn="{StaticResource LampBase}" TargetType="Ellipse">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficDetectionOn}" Value="True">
													<Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
													<Setter Property="Stroke" Value="{DynamicResource StatusWarningBrush}" />
													<Setter Property="Effect">
														<Setter.Value>
															<DropShadowEffect
																BlurRadius="8"
																Color="#FFB02E"
																Opacity="0.85"
																ShadowDepth="0" />
														</Setter.Value>
													</Setter>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Ellipse.Style>
								</Ellipse>
								<TextBlock AutomationProperties.AutomationId="Events.Status.TrafficLight.DetectionCount">
									<TextBlock.Style>
										<Style BasedOn="{StaticResource LampCount}" TargetType="TextBlock">
											<Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
											<Setter Property="Text" Value="{Binding TrafficDetectionCount}" />
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficDetectionOn}" Value="True">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
									</StackPanel>
								</Border>

								<!--  🟢 정상 (green = ready && 둘 다 0 — VM 불변식) · 클릭 없음  -->
								<Ellipse Margin="5,0,0,0" AutomationProperties.AutomationId="Events.Status.TrafficLight.NormalLamp">
									<Ellipse.Style>
										<Style BasedOn="{StaticResource LampBase}" TargetType="Ellipse">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficGreenOn}" Value="True">
													<Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
													<Setter Property="Stroke" Value="{DynamicResource StatusNormalBrush}" />
													<Setter Property="Effect">
														<Setter.Value>
															<DropShadowEffect
																BlurRadius="6"
																Color="#46D17A"
																Opacity="0.8"
																ShadowDepth="0" />
														</Setter.Value>
													</Setter>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Ellipse.Style>
								</Ellipse>

								<!--  미초기화 표기 "—" (데이터 없음 ≠ 정상, S8)  -->
								<TextBlock
									Margin="6,0,0,0"
									VerticalAlignment="Center"
									FontFamily="Consolas"
									FontSize="12"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="—">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsTrafficCountsReady}" Value="False">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</StackPanel>
						</Border>

						<!--  총 카드 수(컴팩트, 잘림 해소 1안): 패널 폭 250px 고정에서 '이벤트 수' 라벨(15px+마진 32)이
						      신호등을 밀어내 잘림 — 총수는 셸 벨 배지·신호등 건수와 3중 중복이라 "총 N"으로 축약.
						      MinWidth=32 로 4자리("1000") 폭 선점 — 자릿수 변동에도 신호등 위치 불변.  -->
						<TextBlock
							VerticalAlignment="Center"
							FontFamily="{StaticResource NotoSansCJKkRMedium}"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Opacity="0.80"
							Text="총" />
						<TextBlock
							MinWidth="32"
							Margin="4,0,0,0"
							VerticalAlignment="Center"
							FontFamily="{StaticResource NotoSansCJKkRMedium}"
							FontSize="13"
							Foreground="{DynamicResource AccentBrush}"
							Opacity="0.85"
							TextAlignment="Left"
							Text="{Binding ViewModelProvider.Count, FallbackValue=1000}" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<Grid Grid.Row="3">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid Grid.Row="1">
				<ListBox
					x:Name="ListBoxEvents"
					cal:Message.Attach="[Event MouseDoubleClick] = [Action OnClickEventCard($source, $eventArgs)]"
					ItemsSource="{Binding ViewModelProvider}"
					ScrollViewer.CanContentScroll="True"
					SelectedItem="{Binding SelectedEventCardViewModel}"
					VirtualizingPanel.IsVirtualizing="True"
					VirtualizingPanel.VirtualizationMode="Recycling"
					VirtualizingPanel.ScrollUnit="Pixel">

					<ListBox.ItemContainerStyle>
						<Style BasedOn="{StaticResource MaterialDesignListBoxItem}" TargetType="ListBoxItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							<Setter Property="VerticalContentAlignment" Value="Stretch" />
							<Setter Property="Opacity" Value="0.95" />
						</Style>
					</ListBox.ItemContainerStyle>

					<!-- StackPanel 제거 — StackPanel은 VirtualizingPanel 미상속 → IsVirtualizing=True 무시됨
					     ItemsPanel 오버라이드 삭제 시 ListBox 기본 VirtualizingStackPanel이 복원됨
					     ScrollUnit=Pixel: Flipper 카드 높이 전환 시 항목 단위 스냅 방지 -->
					<ListBox.ItemTemplate>
						<DataTemplate>
							<ContentControl cal:View.Model="{Binding}" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
