<UserControl
	x:Class="Ironwall.Dotnet.Libraries.Events.Ui.Consoles.Mapping.MappingWorkbenchView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:c="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Events.Ui.Consoles.Mapping"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	Background="{DynamicResource BgBrush}"
	FontFamily="{DynamicResource MaterialDesignFont}"
	SnapsToDevicePixels="True"
	TextOptions.TextFormattingMode="Display"
	TextOptions.TextRenderingMode="ClearType"
	UseLayoutRounding="True">
	<!--
		이벤트 맵핑 워크벤치 — 정본 event-mapping-unit-console-wireframe.html §2-1(컨트롤 트리) ·
		event-mapping-unit-console-storyboard.html 화면 A~F.
		레일 184 / 매핑 목록 300 / 액션 보드 * / 장비 팔레트 340 — 오른쪽 칸이 상세가 아니라 팔레트인 유일한 창.
		드롭은 서버를 부르지 않는다. 투입·해제·정렬은 Draft 이고 [적용] 한 번이 전부다.
	-->
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<local:MappingStateTextConverter x:Key="StateText" />
		<local:MappingIconKindConverter x:Key="IconKind" />
		<local:MappingDimConverter x:Key="DimWhenTrue" />
		<local:MappingDimConverter x:Key="DimWhenFalse" DimOn="False" />
		<local:MappingCategoryTextConverter x:Key="CategoryText" />

		<!--  팔레트 카드 — 이미 들어간 장비는 흐리게 + "등록됨"  -->
		<DataTemplate x:Key="PaletteCard" DataType="{x:Type local:MappingPaletteItemViewModel}">
			<DockPanel
				Height="38"
				LastChildFill="True"
				Opacity="{Binding IsRegistered, Converter={StaticResource DimWhenTrue}}">
				<drag:DragHandle
					Width="12"
					AutomationProperties.AutomationId="{Binding Id, StringFormat=Integrations.Palette.Handle.{0}}"
					DockPanel.Dock="Left"
					ToolTip="끌어서 액션 보드에 넣기" />
				<TextBlock
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					FontSize="10.5"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding StatusText}" />
				<StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
					<TextBlock
						FontSize="12"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding Name}"
						TextTrimming="CharacterEllipsis"
						ToolTip="{Binding Name}" />
					<TextBlock
						FontSize="10.5"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="{Binding Subtitle}"
						TextTrimming="CharacterEllipsis" />
				</StackPanel>
			</DockPanel>
		</DataTemplate>

		<!--  보드 행 — 핸들 12 · 이름 * · 설정 칩 N · 상태  -->
		<DataTemplate x:Key="BoardRow" DataType="{x:Type local:MappingRowViewModel}">
			<Border
				MinHeight="38"
				Padding="4,3"
				Background="Transparent"
				CornerRadius="5">
				<Border.Style>
					<!--  Draft 는 앰버 파선 {6,4} — 기존 {4,3}(그룹 선택)·{5,3}(러버밴드)와 겹치지 않는다  -->
					<Style TargetType="Border">
						<Setter Property="BorderBrush" Value="Transparent" />
						<Setter Property="BorderThickness" Value="1" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsDraft}" Value="True">
								<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<DockPanel LastChildFill="True">
					<drag:DragHandle
						Width="12"
						AutomationProperties.AutomationId="{Binding Key, StringFormat=Integrations.Board.Handle.{0}}"
						DockPanel.Dock="Left"
						ToolTip="끌어서 순서 바꾸기 · Alt+↑↓" />

					<!--  상태 배지 — 색이 아니라 글자와 형태로 구분한다  -->
					<Border
						Margin="6,0,0,0"
						Padding="7,1"
						VerticalAlignment="Center"
						Background="{DynamicResource SurfaceSunkenBrush}"
						CornerRadius="4"
						DockPanel.Dock="Right"
						Visibility="{Binding IsDraft, Converter={StaticResource BoolToVis}}">
						<TextBlock
							FontSize="10.5"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding Row.State, Converter={StaticResource StateText}}" />
					</Border>
					<md:PackIcon
						Width="16"
						Height="16"
						Margin="6,0,0,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Right"
						Foreground="{DynamicResource StatusWarningBrush}"
						Kind="AlertCircleOutline"
						ToolTip="{Binding FailureText}"
						Visibility="{Binding HasFailure, Converter={StaticResource BoolToVis}}" />
					<md:PackIcon
						Width="16"
						Height="16"
						Margin="6,0,0,0"
						VerticalAlignment="Center"
						DockPanel.Dock="Right"
						Foreground="{DynamicResource StatusCriticalBrush}"
						Kind="LinkOff"
						ToolTip="장비가 끊긴 행입니다 — 다시 지정하거나 해제하십시오."
						Visibility="{Binding IsOrphan, Converter={StaticResource BoolToVis}}" />

					<StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
						<TextBlock
							FontSize="12"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding DeviceName}"
							TextTrimming="CharacterEllipsis"
							ToolTip="{Binding DeviceName}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsRemoved}" Value="True">
											<Setter Property="TextDecorations" Value="Strikethrough" />
											<Setter Property="Opacity" Value="0.55" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Chips}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border
										MinWidth="56"
										Margin="0,0,3,0"
										Padding="7,1"
										Background="{DynamicResource SurfaceSunkenBrush}"
										CornerRadius="4">
										<TextBlock
											FontSize="10.5"
											Foreground="{DynamicResource TextSecondaryBrush}"
											Text="{Binding}"
											TextTrimming="CharacterEllipsis" />
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</DockPanel>
			</Border>
		</DataTemplate>
	</UserControl.Resources>

	<c:ConsoleShell
		ConsoleKey="Mapping"
		IsDetailRequested="True"
		Subtitle="{Binding MappingTitle}"
		Title="이벤트 맵핑">

		<!--  ── 레일 : 종류 축 3개 ──  -->
		<c:ConsoleShell.Rail>
			<c:ConsoleRail
				AutomationProperties.AutomationId="Console.Mapping.Rail"
				ConsoleKey="Mapping"
				IsCompact="{Binding IsRailCompact, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				IsEnabled="{Binding IsInputEnabled}"
				ItemsSource="{Binding RailEntries}"
				SelectedItem="{Binding SelectedRail, Mode=TwoWay}">
				<c:ConsoleRail.Resources>
					<DataTemplate DataType="{x:Type local:MappingConsoleIcon}">
						<md:PackIcon
							Width="18"
							Height="18"
							Kind="{Binding Kind, Converter={StaticResource IconKind}}" />
					</DataTemplate>
				</c:ConsoleRail.Resources>
			</c:ConsoleRail>
		</c:ConsoleShell.Rail>

		<!--  ── 툴바 ──  -->
		<c:ConsoleShell.Toolbar>
			<c:ConsoleToolbar
				AddClick="OnAdd"
				AddDisabledReason="이벤트 맵핑을 편집할 권한이 없습니다."
				AddText="맵핑 등록"
				CanAdd="{Binding CanEdit}"
				CanDelete="False"
				CanRefresh="{Binding IsInputEnabled}"
				ConsoleKey="Mapping"
				RefreshClick="OnReload"
				SearchPlaceholder="맵핑 이름 검색"
				SearchText="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
				ShowSearch="True" />
		</c:ConsoleShell.Toolbar>

		<!--  ── 본문 : 매핑 목록 300 + 액션 보드 * ──  -->
		<c:ConsoleShell.List>
			<Grid IsEnabled="{Binding IsInputEnabled}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="300" />
					<ColumnDefinition Width="*" MinWidth="420" />
				</Grid.ColumnDefinitions>

				<!--  ① 매핑 목록  -->
				<Border
					Grid.Column="0"
					BorderBrush="{DynamicResource DividerBrush}"
					BorderThickness="0,0,1,0">
					<ListBox
						Padding="8"
						AutomationProperties.AutomationId="Integrations.Mapping.List"
						ItemsSource="{Binding Mappings}"
						SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
						Style="{StaticResource Console.ReorderList}">
						<ListBox.ItemTemplate>
							<DataTemplate DataType="{x:Type local:MappingListItemViewModel}">
								<DockPanel
									Height="38"
									LastChildFill="True"
									Opacity="{Binding IsActive, Converter={StaticResource DimWhenFalse}}">
									<Border
										Margin="8,0,0,0"
										Padding="7,1"
										VerticalAlignment="Center"
										Background="{DynamicResource SurfaceSunkenBrush}"
										CornerRadius="4"
										DockPanel.Dock="Right">
										<TextBlock
											FontSize="10.5"
											Foreground="{DynamicResource TextSecondaryBrush}"
											Text="{Binding CountText}"
											ToolTip="카메라 · 스피커 · 경광등" />
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock
											FontSize="12"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding Name}"
											TextTrimming="CharacterEllipsis"
											ToolTip="{Binding Name}" />
										<TextBlock
											FontSize="10.5"
											Foreground="{DynamicResource TextSecondaryBrush}"
											Text="{Binding CategoryText}"
											TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</DockPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Border>

				<!--  ② 액션 보드  -->
				<Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!--  맵핑 속성 — 본체는 호출 1회라 Draft 없이 바로 저장한다(봉투 규약)  -->
					<c:ConsoleSection
						Grid.Row="0"
						Margin="12,12,12,0"
						AxisName="event-mappings"
						Header="맵핑">
						<StackPanel IsEnabled="{Binding CanEdit}">
							<c:ConsoleField ApiName="name_event" Header="이름">
								<TextBox
									Height="32"
									AutomationProperties.AutomationId="Integrations.Mapping.NameBox"
									MaxLength="100"
									Style="{StaticResource MaterialDesignOutlinedTextBox}"
									Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="device_group_id" Header="장비그룹">
								<ComboBox
									Height="32"
									AutomationProperties.AutomationId="Integrations.Mapping.GroupCombo"
									DisplayMemberPath="Name"
									ItemsSource="{Binding Groups}"
									SelectedValue="{Binding EditGroupId}"
									SelectedValuePath="Id"
									Style="{StaticResource MaterialDesignOutlinedComboBox}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="category_event_mapping" Header="카테고리">
								<ComboBox
									Height="32"
									AutomationProperties.AutomationId="Integrations.Mapping.CategoryCombo"
									ItemsSource="{Binding Categories}"
									SelectedItem="{Binding EditCategory}"
									Style="{StaticResource MaterialDesignOutlinedComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding Converter={StaticResource CategoryText}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</c:ConsoleField>
							<c:ConsoleField ApiName="description" Header="설명">
								<TextBox
									Height="32"
									AutomationProperties.AutomationId="Integrations.Mapping.DescriptionBox"
									MaxLength="500"
									Style="{StaticResource MaterialDesignOutlinedTextBox}"
									Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
							</c:ConsoleField>
							<c:ConsoleField ApiName="status" Header="운용">
								<DockPanel LastChildFill="False">
									<ToggleButton
										VerticalAlignment="Center"
										AutomationProperties.AutomationId="Integrations.Mapping.StatusToggle"
										DockPanel.Dock="Left"
										IsChecked="{Binding EditStatus}"
										Style="{StaticResource MaterialDesignSwitchToggleButton}" />
									<Button
										Height="30"
										MinWidth="84"
										Margin="8,0,0,0"
										AutomationProperties.AutomationId="Integrations.Mapping.SaveButton"
										Click="OnSaveMapping"
										Content="{Binding SaveMappingText}"
										DockPanel.Dock="Right"
										IsEnabled="{Binding CanSaveMapping}"
										Style="{StaticResource MaterialDesignRaisedButton}"
										ToolTip="맵핑 본체는 호출 한 번이라 바로 저장됩니다" />
									<Button
										Height="30"
										MinWidth="84"
										Margin="8,0,0,0"
										AutomationProperties.AutomationId="Integrations.Mapping.CancelCreateButton"
										Click="OnCancelCreate"
										Content="취소"
										DockPanel.Dock="Right"
										Style="{StaticResource MaterialDesignOutlinedButton}"
										Visibility="{Binding IsCreatingMapping, Converter={StaticResource BoolToVis}}" />
								</DockPanel>
							</c:ConsoleField>
							<TextBlock
								Margin="0,4,0,0"
								AutomationProperties.AutomationId="Integrations.Mapping.FormError"
								FontSize="11"
								Foreground="{DynamicResource StatusCriticalBrush}"
								Text="{Binding MappingFormError}"
								TextWrapping="Wrap"
								Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}" />
						</StackPanel>
					</c:ConsoleSection>

					<!--  보드 머리 : 탭 + 순서 버튼 + 해제  -->
					<Grid
						Grid.Row="1"
						Height="40"
						Margin="12,8,12,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							VerticalAlignment="Center"
							FontSize="13"
							FontWeight="SemiBold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding KindLabel, StringFormat={}{0} 배선}"
							TextTrimming="CharacterEllipsis" />
						<StackPanel
							Grid.Column="1"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<Button
								Height="30"
								MinWidth="64"
								Margin="0,0,6,0"
								AutomationProperties.AutomationId="Integrations.Board.MoveUp"
								Click="OnMoveUp"
								Content="▲ 위로"
								IsEnabled="{Binding CanMoveUp}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="Alt+↑ 와 같은 동작" />
							<Button
								Height="30"
								MinWidth="64"
								Margin="0,0,6,0"
								AutomationProperties.AutomationId="Integrations.Board.MoveDown"
								Click="OnMoveDown"
								Content="▼ 아래로"
								IsEnabled="{Binding CanMoveDown}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="Alt+↓ 와 같은 동작" />
							<Button
								Height="30"
								MinWidth="64"
								AutomationProperties.AutomationId="Integrations.Board.ReleaseButton"
								Click="OnRelease"
								Content="◀ 해제"
								IsEnabled="{Binding CanReleaseSelected}"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								ToolTip="Delete 키와 같은 동작 — 해제는 [적용] 전까지 되돌릴 수 있습니다" />
						</StackPanel>
					</Grid>

					<!--  경고 줄 — 서버가 검사하지 않는 것들  -->
					<Border
						Grid.Row="2"
						Margin="12,8,12,0"
						Padding="10,6"
						Background="{DynamicResource TintWarningBrush}"
						BorderBrush="{DynamicResource StatusWarningBrush}"
						BorderThickness="1"
						CornerRadius="5"
						Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
						<DockPanel LastChildFill="True">
							<md:PackIcon
								Width="16"
								Height="16"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								DockPanel.Dock="Left"
								Foreground="{DynamicResource StatusWarningBrush}"
								Kind="AlertOutline" />
							<TextBlock
								VerticalAlignment="Center"
								FontSize="11.5"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding WarningText}"
								TextWrapping="Wrap" />
						</DockPanel>
					</Border>

					<!--  보드 행 — 드롭 타깃 + 드래그 소스  -->
					<drag:DropZoneChrome
						Grid.Row="3"
						Margin="12,8,12,12"
						drag:DropZone.Handler="{Binding}"
						drag:DropZone.IsReorder="True"
						drag:DropZone.Key="{Binding BoardZoneKey}"
						AutomationProperties.AutomationId="Integrations.Board.Zone"
						CornerRadius="6">
						<Grid>
							<ListBox
								Padding="6"
								AutomationProperties.AutomationId="Integrations.Board.List"
								ItemTemplate="{StaticResource BoardRow}"
								ItemsSource="{Binding BoardRows}"
								PreviewKeyDown="OnBoardPreviewKeyDown"
								SelectionChanged="OnBoardSelectionChanged"
								SelectionMode="Extended"
								Style="{StaticResource Console.ReorderList}">
								<b:Interaction.Behaviors>
									<drag:CaptureDragBehavior
										DisplayMemberPath="Display"
										Handler="{Binding}"
										IsDragEnabled="{Binding IsDragEnabled}"
										KeyboardFallback="Alt+↑↓ 로 순서 · Delete 로 해제 · [◀ 해제] 버튼" />
									<drag:ReorderKeyboardBehavior Handler="{Binding}" />
								</b:Interaction.Behaviors>
							</ListBox>
							<TextBlock
								Margin="18"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="12"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="오른쪽 팔레트에서 장비를 끌어다 놓거나 [＋ 추가] 를 누르십시오."
								TextWrapping="Wrap">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding BoardRows.Count}" Value="0">
												<Setter Property="Visibility" Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</drag:DropZoneChrome>
				</Grid>
			</Grid>
		</c:ConsoleShell.List>

		<!--  ── ③ 장비 팔레트 (오른쪽 칸) ──  -->
		<c:ConsoleShell.Detail>
			<c:ConsoleDetailHost
				ApplyClick="OnApply"
				ApplyText="적용"
				Banner="{Binding Detail.Banner}"
				CanApply="{Binding CanApply}"
				CanRevert="{Binding CanRevert}"
				ConsoleKey="Mapping"
				DetailWidth="{Binding DetailWidth, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}, Mode=TwoWay}"
				FooterText="{Binding DraftText}"
				IsDirty="{Binding IsDirty}"
				IsReadOnly="{Binding IsReadOnly}"
				Kind="장비 팔레트"
				RevertClick="OnRevert"
				RevertText="되돌리기"
				ShowButtons="True"
				ShowWidthTools="{Binding IsDetailDocked, RelativeSource={RelativeSource AncestorType=c:ConsoleShell}}"
				Title="{Binding KindLabel}">
				<Grid IsEnabled="{Binding IsInputEnabled}">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<TextBox
						Grid.Row="0"
						Height="32"
						Margin="0,0,0,8"
						md:HintAssist.Hint="장비 검색"
						AutomationProperties.AutomationId="Integrations.Palette.Search"
						Style="{StaticResource MaterialDesignOutlinedTextBox}"
						Text="{Binding PaletteSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" />

					<Button
						Grid.Row="1"
						Height="30"
						Margin="0,0,0,8"
						HorizontalAlignment="Stretch"
						AutomationProperties.AutomationId="Integrations.Palette.AddButton"
						Click="OnAddSelected"
						Content="＋ 추가 ▶"
						IsEnabled="{Binding CanAddSelected}"
						Style="{StaticResource MaterialDesignRaisedButton}"
						ToolTip="Enter 키와 같은 동작 — 고른 장비를 액션 보드에 넣습니다" />

					<!--  팔레트 = 해제 드롭존(보드 행을 여기로 끌면 해제)  -->
					<drag:DropZoneChrome
						Grid.Row="2"
						drag:DropZone.Handler="{Binding}"
						drag:DropZone.Key="{Binding PaletteZoneKey}"
						AutomationProperties.AutomationId="Integrations.Palette.Zone"
						CornerRadius="6">
						<ListBox
							Padding="6"
							AutomationProperties.AutomationId="Integrations.Palette.List"
							ItemTemplate="{StaticResource PaletteCard}"
							ItemsSource="{Binding PaletteItems}"
							PreviewKeyDown="OnPalettePreviewKeyDown"
							SelectionChanged="OnPaletteSelectionChanged"
							SelectionMode="Extended"
							Style="{StaticResource Console.ReorderList}">
							<b:Interaction.Behaviors>
								<drag:CaptureDragBehavior
									DisplayMemberPath="Display"
									Handler="{Binding}"
									IsDragEnabled="{Binding IsDragEnabled}"
									KeyboardFallback="Enter 또는 [＋ 추가 ▶] 버튼" />
							</b:Interaction.Behaviors>
							<ListBox.ItemContainerStyle>
								<Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
									<Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Integrations.Palette.Item.{0}}" />
								</Style>
							</ListBox.ItemContainerStyle>
						</ListBox>
					</drag:DropZoneChrome>
				</Grid>
			</c:ConsoleDetailHost>
		</c:ConsoleShell.Detail>

		<!--  ── 상태줄 ──  -->
		<c:ConsoleShell.StatusBar>
			<Grid Margin="12,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding SelectionText}" />
				<TextBlock
					Grid.Column="1"
					Margin="12,0,0,0"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding DraftText}" />
				<TextBox
					Grid.Column="2"
					Margin="12,0"
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="Integrations.Mapping.Status"
					Background="Transparent"
					BorderThickness="0"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					IsReadOnly="True"
					Text="{Binding StatusText, Mode=OneWay}"
					TextWrapping="NoWrap" />
				<TextBlock
					Grid.Column="3"
					VerticalAlignment="Center"
					FontSize="11"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="{Binding PermissionText}" />
			</Grid>
		</c:ConsoleShell.StatusBar>
	</c:ConsoleShell>
</UserControl>
