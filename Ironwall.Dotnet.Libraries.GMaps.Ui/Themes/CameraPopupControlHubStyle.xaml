<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  카메라 RTSP 팝업 제어 허브 (CameraPopup_ControlHub) — Tactical 카드.
          색은 앱 표준 테마 토큰을 {DynamicResource}로 참조 → Light/Dark 토글에 반응(App 레벨 Tokens.Light↔Dark 스왑).
          템플릿 스코프이므로 앱-MD/MahApps StaticResource 참조 금지(크래시). 토큰은 전부 SolidColorBrush이므로
          기존 그라디언트는 단색 토큰으로 평탄화(pill=SurfaceTranslucent, 헤더/뱃지=Primary+OnPrimaryFixed, 썸네일=SurfaceSunken).
          시안 표면 위 전경은 반드시 OnPrimaryFixedBrush(Light=흰/Dark=암 반전)로 양테마 대비 보장. 그림자(Black)·구조값은 테마 불변.  -->

    <BooleanToVisibilityConverter x:Key="HubBoolToVis" />

    <!--  행 액션 아이콘 버튼(투명 → 호버 위험 강조)  -->
    <Style x:Key="HubRowIconButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TintCriticalBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  행 전체(포커스 이동) 버튼 — 좌측 정보 영역. 선택 시 시안 좌측 바.  -->
    <Style x:Key="HubRowFocusButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="9,7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <!--  DataContext=팝업 vm — 선택 강조(SelectedCameraPopup이 IsSelected 설정)  -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TintAccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  상태 태그 칩  -->
    <Style x:Key="HubTag" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <!--  '모두 닫기' 위험 버튼 — keyed 스타일(행 버튼과 동일 방식). Style 없으면 앱의 암시적 MD/MahApps Button
          스타일을 상속해 폭/정렬이 깨짐 → BasedOn 없이 자체완결로 암시적 스타일 완전 우회.  -->
    <Style x:Key="HubDangerButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fb" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource DangerBorderBrush}" Background="{DynamicResource DangerSurfaceBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <md:PackIcon Width="18" Height="18" VerticalAlignment="Center"
                                         Foreground="{DynamicResource StatusCriticalBrush}" Kind="CloseCircleOutline" />
                            <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource StatusCriticalBrush}" Text="모두 닫기" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fb" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ctrl:CameraPopupControlHub}">
        <!--  0개면 허브 완전 숨김(표시 게이팅)  -->
        <Style.Triggers>
            <Trigger Property="OpenCount" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:CameraPopupControlHub}">
                    <Grid>
                        <!--  ===== 접힌 pill (드래그 핸들 = 본체 전체) =====  -->
                        <Border x:Name="PART_Pill" Cursor="SizeAll" SnapsToDevicePixels="True"
                                Background="{DynamicResource SurfaceTranslucentBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="11" />
                                    <Setter Property="Padding" Value="5,5,8,5" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <!--  그립  -->
                                <md:PackIcon Width="15" Height="19" VerticalAlignment="Center" Margin="0,0,3,0"
                                             Foreground="{DynamicResource TextMutedBrush}" Kind="DragVertical" />
                                <!--  카메라 아이콘 + 뱃지  -->
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource TintAccentBrush}" CornerRadius="8" />
                                    <md:PackIcon Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryBrush}" Kind="Cctv" />
                                    <Border MinWidth="18" Height="18" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-6,-7,0" CornerRadius="9" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource SurfaceBrush}" Background="{DynamicResource PrimaryBrush}">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource OnPrimaryFixedBrush}"
                                                   Text="{Binding BadgeText, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Border>
                                </Grid>
                                <!--  chevron (열림=위/닫힘=아래)  -->
                                <md:PackIcon x:Name="Chev" Width="15" Height="15" VerticalAlignment="Center" Margin="6,0,0,0"
                                             Foreground="{DynamicResource TextSecondaryBrush}" Kind="ChevronDown" />
                            </StackPanel>
                        </Border>

                        <!--  ===== 플라이아웃 (WPF Popup: airspace 위 렌더 + 바깥클릭 닫힘) =====  -->
                        <Popup x:Name="PART_Flyout" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               Placement="Top" VerticalOffset="-8" HorizontalOffset="0"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{Binding IsFlyoutOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <!--  DataContext=허브 컨트롤(PlacementTarget) → 내부 바인딩 단순화  -->
                            <Border Width="290" MaxHeight="360" CornerRadius="14" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}"
                                    DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=Popup}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.6" Color="Black" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  헤더 (시안 표면=PrimaryBrush + 전경=OnPrimaryFixedBrush)  -->
                                    <Border Grid.Row="0" CornerRadius="13,13,0,0" Padding="12,10" Background="{DynamicResource PrimaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Width="17" Height="17" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource OnPrimaryFixedBrush}" Kind="Cctv" />
                                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnPrimaryFixedBrush}" Text="카메라 영상" />
                                            <Border Margin="9,0,0,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="9"
                                                    Background="{DynamicResource OnPrimaryFixedBrush}">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                                           Text="{Binding OpenCount}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!--  카메라 리스트 (좌우 10=헤더/푸터와 정렬)  -->
                                    <ScrollViewer Grid.Row="1" Margin="0,0,0,0" Padding="10,6" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding PopupsSource}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--  DataContext=팝업 vm (CameraStreamPopupViewModel)  -->
                                                    <Grid Margin="5,0,5,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  좌측: 행 클릭=이동/포커스  -->
                                                        <Button Grid.Column="0" Style="{StaticResource HubRowFocusButton}"
                                                                CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <!--  썸네일(상태점)  -->
                                                                <Border Grid.Column="0" Width="44" Height="30" CornerRadius="6" BorderThickness="1"
                                                                        BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSunkenBrush}"
                                                                        ClipToBounds="True">
                                                                    <Grid>
                                                                        <md:PackIcon Width="15" Height="15" HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Kind="Play" />
                                                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3">
                                                                            <Ellipse.Style>
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsResolvingSource}" Value="True">
                                                                                            <Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                    </Grid>
                                                                </Border>
                                                                <!--  이름 + 태그  -->
                                                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <Border Style="{StaticResource HubTag}" BorderBrush="{DynamicResource StatusWarningBrush}"
                                                                                Visibility="{Binding IsResolvingSource, Converter={StaticResource HubBoolToVis}}">
                                                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource StatusWarningBrush}" Text="조회중" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource HubTag}" BorderBrush="{DynamicResource StatusNormalBrush}"
                                                                                Visibility="{Binding IsPtzCapable, Converter={StaticResource HubBoolToVis}}">
                                                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource StatusNormalBrush}" Text="PTZ" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource HubTag}" BorderBrush="{DynamicResource PrimaryBrush}"
                                                                                Visibility="{Binding IsLarge, Converter={StaticResource HubBoolToVis}}">
                                                                            <TextBlock FontSize="9.5" Foreground="{DynamicResource PrimaryBrush}" Text="크게" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!--  우측: 개별 닫기  -->
                                                        <Button Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource HubRowIconButton}"
                                                                ToolTip="이 카메라 영상 닫기" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <md:PackIcon Width="16" Height="16" Kind="Close" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!--  푸터: 모두 닫기  -->
                                    <Border Grid.Row="2" Padding="12,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}"
                                            Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="0,0,13,13">
                                        <Button Command="{Binding CloseAllCommand}" Style="{StaticResource HubDangerButton}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  플라이아웃 열림 → chevron 위로 + pill 포커스 링  -->
                        <Trigger Property="IsFlyoutOpen" Value="True">
                            <Setter TargetName="Chev" Property="Kind" Value="ChevronUp" />
                            <Setter TargetName="PART_Pill" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
