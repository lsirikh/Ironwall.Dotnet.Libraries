<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<!--  「이미지 자르기」 판(2026-10-19) — 「건물 높이」 판(BuildingHeightPanelStyle) 크롬 답습:
	      FrameBorder(Surface · Border · 반지름 10 · 그림자) + PrimaryBrush 머리 띠 38(끌기) + [아이콘][제목][? 받침][✕].
	      단추 = 표준 PanelPrimaryButtonStyle / PanelSecondaryButtonStyle, 닫기 = PanelCloseButtonStyle, "?" = PanelHeaderHelpDisc.
	      색은 전부 DynamicResource 토큰(Tactical Command 라이트/다크). DataContext = ImageCropViewModel.  -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<BooleanToVisibilityConverter x:Key="ImageCropBoolToVisibility" />

	<!--  작은 보조 단추(맞추기 · 되돌리기 · 다시 하기)  -->
	<Style
		x:Key="ImageCropToolButton"
		BasedOn="{StaticResource PanelSecondaryButtonStyle}"
		TargetType="Button">
		<Setter Property="MinWidth" Value="36" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="FontSize" Value="11" />
	</Style>

	<Style TargetType="{x:Type ctrl:ImageCropPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:ImageCropPanelControl}">
					<fb:FrameBorder
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!--  머리 띠(끌기)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="VectorPolygon" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{Binding Title}" />
									<!--  판 "?"(help-callout H-4) — 쓰는 법 · 단축키 · 3D 에서 자른 모양만 쓰임  -->
									<Border Grid.Column="1" Style="{StaticResource PanelHeaderHelpDisc}">
										<fb:HelpTip HelpKey="Map.ImageCrop.Panel" Scope="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</Border>
									<Button
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.ImageCrop.Close"
										AutomationProperties.Name="닫기(취소)"
										Command="{TemplateBinding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}"
										ToolTip="닫기 = 취소" />
								</Grid>
							</Border>

							<!--  도구 줄 — 맞추기 · 되돌리기 · 다시 하기 · 꼭짓점 수(상태)  -->
							<DockPanel Grid.Row="1" Margin="12,8,12,8">
								<Button
									AutomationProperties.AutomationId="Map.ImageCrop.Fit"
									AutomationProperties.Name="화면에 맞추기"
									Command="{Binding FitCommand}"
									Style="{StaticResource ImageCropToolButton}"
									ToolTip="그림 전체가 보이게">
									<StackPanel Orientation="Horizontal">
										<md:PackIcon
											Width="14"
											Height="14"
											VerticalAlignment="Center"
											Kind="FitToScreenOutline" />
										<TextBlock Margin="5,0,0,0" Text="화면에 맞추기" />
									</StackPanel>
								</Button>
								<Button
									AutomationProperties.AutomationId="Map.ImageCrop.Undo"
									AutomationProperties.Name="되돌리기"
									Command="{Binding UndoCommand}"
									Style="{StaticResource ImageCropToolButton}"
									ToolTip="되돌리기 (Ctrl+Z)">
									<md:PackIcon
										Width="14"
										Height="14"
										Kind="Undo" />
								</Button>
								<Button
									AutomationProperties.AutomationId="Map.ImageCrop.Redo"
									AutomationProperties.Name="다시 하기"
									Command="{Binding RedoCommand}"
									Style="{StaticResource ImageCropToolButton}"
									ToolTip="다시 하기 (Ctrl+Y)">
									<md:PackIcon
										Width="14"
										Height="14"
										Kind="Redo" />
								</Button>
								<TextBlock
									HorizontalAlignment="Right"
									VerticalAlignment="Center"
									AutomationProperties.AutomationId="Map.ImageCrop.PointCount"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextSecondaryBrush}"
									Text="{Binding PointCountText}" />
							</DockPanel>

							<!--  그림 캔버스  -->
							<Border
								Grid.Row="2"
								Margin="12,0,12,0"
								BorderBrush="{DynamicResource BorderBrush}"
								BorderThickness="1"
								CornerRadius="4">
								<ctrl:ImageCropCanvas AutomationProperties.AutomationId="Map.ImageCrop.Canvas" AutomationProperties.Name="자를 그림" />
							</Border>

							<!--  이유 한 줄 · 닫기 확인  -->
							<StackPanel Grid.Row="3" Margin="12,6,12,0">
								<TextBlock
									AutomationProperties.AutomationId="Map.ImageCrop.Error"
									FontSize="11"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding Error}"
									TextWrapping="Wrap"
									Visibility="{Binding HasError, Converter={StaticResource ImageCropBoolToVisibility}}" />
								<Border
									Margin="0,4,0,0"
									Padding="10,6"
									AutomationProperties.AutomationId="Map.ImageCrop.CloseConfirm"
									Background="{DynamicResource TintWarningBrush}"
									CornerRadius="4"
									Visibility="{Binding IsCloseConfirmVisible, Converter={StaticResource ImageCropBoolToVisibility}}">
									<DockPanel>
										<Button
											Margin="6,0,0,0"
											AutomationProperties.AutomationId="Map.ImageCrop.KeepEditing"
											Command="{Binding KeepEditingCommand}"
											Content="계속 자르기"
											DockPanel.Dock="Right"
											Style="{StaticResource PanelSecondaryButtonStyle}" />
										<Button
											Margin="6,0,0,0"
											AutomationProperties.AutomationId="Map.ImageCrop.ConfirmClose"
											Command="{Binding ConfirmCloseCommand}"
											Content="닫기"
											DockPanel.Dock="Right"
											Style="{StaticResource PanelSecondaryButtonStyle}" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="12"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="자르기를 그만두고 닫을까요? (Esc 한 번 더 = 닫기)" />
									</DockPanel>
								</Border>
							</StackPanel>

							<!--  적용 · 그대로 · 취소  -->
							<Grid Grid.Row="4" Margin="12,10,12,12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Button
									Grid.Column="1"
									MinWidth="120"
									Margin="0,0,7,0"
									AutomationProperties.AutomationId="Map.ImageCrop.Apply"
									Command="{Binding ApplyCommand}"
									Content="✓ 자르기 적용"
									Style="{StaticResource PanelPrimaryButtonStyle}"
									ToolTip="다각형 바깥을 투명하게 잘라 PNG 로" />
								<Button
									Grid.Column="2"
									MinWidth="120"
									Margin="0,0,7,0"
									AutomationProperties.AutomationId="Map.ImageCrop.Skip"
									Command="{Binding SkipCommand}"
									Content="자르지 않고 그대로"
									Style="{StaticResource PanelSecondaryButtonStyle}"
									Visibility="{Binding AllowSkip, Converter={StaticResource ImageCropBoolToVisibility}}" />
								<Button
									Grid.Column="3"
									MinWidth="80"
									AutomationProperties.AutomationId="Map.ImageCrop.Cancel"
									Command="{Binding CancelCommand}"
									Content="취소"
									Style="{StaticResource PanelSecondaryButtonStyle}" />
							</Grid>
						</Grid>
					</fb:FrameBorder>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
