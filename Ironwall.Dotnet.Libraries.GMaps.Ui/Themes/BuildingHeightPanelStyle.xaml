<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<!--  「건물 높이」 판(2026-10-19) — 묶음 회전 판(GroupRotationPanelStyle) · 사이트 고정 창(MapAnchorPanelStyle) 크롬 답습:
	      FrameBorder(Surface · Border · 반지름 10 · 그림자) + PrimaryBrush 머리 띠 38(끌기) + [아이콘][제목][? 받침][✕].
	      단추 = 표준 PanelPrimaryButtonStyle / PanelSecondaryButtonStyle, 닫기 = PanelCloseButtonStyle, "?" = PanelHeaderHelpDisc.
	      색은 전부 DynamicResource 토큰(Tactical Command 라이트/다크 — 테마 전환 즉시 반영).  -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  섹션 라벨 — GroupRotationSectionLabel 과 같은 값(그 키는 다른 사전 안이라 같은 값으로 둔다)  -->
	<Style x:Key="BuildingHeightSectionLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="Margin" Value="0,0,0,4" />
	</Style>

	<!--  숫자 입력칸 — GroupRotationInputBox 와 같은 값  -->
	<Style x:Key="BuildingHeightInputBox" TargetType="TextBox">
		<Setter Property="Margin" Value="2" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="MinHeight" Value="26" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<!--  ±1층 단추 — 표준 보조 단추를 작게  -->
	<Style
		x:Key="BuildingHeightStepButton"
		BasedOn="{StaticResource PanelSecondaryButtonStyle}"
		TargetType="Button">
		<Setter Property="MinWidth" Value="48" />
		<Setter Property="Margin" Value="2" />
		<Setter Property="FontSize" Value="11" />
	</Style>

	<!--  높이 손잡이(Thumb) — 세로 홈 안의 잡는 자리. 끄는 동안 강조(테두리 두께 · 홈 색 — 색만이 아니라 두께로도)  -->
	<Style x:Key="BuildingHeightHandleThumb" TargetType="Thumb">
		<Setter Property="Cursor" Value="SizeNS" />
		<Setter Property="Focusable" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Thumb">
					<Border
						Background="{DynamicResource SurfaceSunkenBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="6">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<md:PackIcon
								Grid.Row="0"
								Width="14"
								Height="14"
								Margin="0,6,0,0"
								HorizontalAlignment="Center"
								Foreground="{DynamicResource TextMutedBrush}"
								Kind="ChevronUp" />
							<Border
								Grid.Row="1"
								Width="26"
								Height="34"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Background="{DynamicResource SurfaceBrush}"
								BorderBrush="{DynamicResource PrimaryBrush}"
								CornerRadius="4">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="BorderThickness" Value="1" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsDragging, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
												<Setter Property="BorderThickness" Value="2.5" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<md:PackIcon
									Width="16"
									Height="16"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Foreground="{DynamicResource PrimaryBrush}"
									Kind="ArrowExpandVertical" />
							</Border>
							<md:PackIcon
								Grid.Row="2"
								Width="14"
								Height="14"
								Margin="0,0,0,6"
								HorizontalAlignment="Center"
								Foreground="{DynamicResource TextMutedBrush}"
								Kind="ChevronDown" />
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ctrl:BuildingHeightPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:BuildingHeightPanelControl}">
					<fb:FrameBorder
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!--  머리 띠(끌기)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="OfficeBuildingOutline" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="건물 높이" />
									<!--  판 "?"(help-callout H-4) — 쓰는 법 · 층고 · 저장 위치 · 다시 만들기 · 보안 구역  -->
									<Border Grid.Column="1" Style="{StaticResource PanelHeaderHelpDisc}">
										<fb:HelpTip HelpKey="Map.BuildingHeight.Panel" Scope="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</Border>
									<Button
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.BuildingHeight.Close"
										AutomationProperties.Name="닫기(취소)"
										Command="{TemplateBinding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}"
										ToolTip="닫기 = 취소(원래 높이로)" />
								</Grid>
							</Border>

							<!--  바디 (DataContext = MapViewModel)  -->
							<StackPanel Grid.Row="1" Margin="14,12,14,14">
								<TextBlock
									AutomationProperties.AutomationId="Map.BuildingHeight.Current"
									FontSize="13"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding BuildingHeightCurrentText}"
									TextWrapping="Wrap" />
								<StackPanel Margin="0,4,0,10" Orientation="Horizontal">
									<TextBlock
										FontSize="11"
										Foreground="{DynamicResource TextMutedBrush}"
										Text="높이 출처 · " />
									<TextBlock
										AutomationProperties.AutomationId="Map.BuildingHeight.Source"
										FontSize="11"
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding BuildingHeightSourceText}" />
								</StackPanel>
								<!--  권한 없음 — 보기만(이유 한 줄)  -->
								<TextBlock
									Margin="0,0,0,10"
									AutomationProperties.AutomationId="Map.BuildingHeight.ReadOnly"
									FontSize="11"
									Foreground="{DynamicResource StatusWarningBrush}"
									Text="{Binding BuildingHeightReadOnlyText}"
									TextWrapping="Wrap"
									Visibility="{Binding IsBuildingHeightReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="10" />
										<ColumnDefinition Width="48" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="층고 (m, 한 층 높이)" />
										<TextBox
											Margin="2,2,2,8"
											AutomationProperties.AutomationId="Map.BuildingHeight.FloorHeight"
											AutomationProperties.Name="층고"
											Style="{StaticResource BuildingHeightInputBox}"
											Text="{Binding BuildingHeightFloorHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="층수" />
										<Grid Margin="0,0,0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<Button
												Grid.Column="0"
												AutomationProperties.AutomationId="Map.BuildingHeight.MinusFloor"
												Command="{Binding StepBuildingFloorCommand}"
												CommandParameter="-1"
												Content="−1층"
												IsEnabled="{Binding IsBuildingHeightEditable}"
												Style="{StaticResource BuildingHeightStepButton}"
												ToolTip="한 층 낮게 (↓)" />
											<TextBox
												Grid.Column="1"
												AutomationProperties.AutomationId="Map.BuildingHeight.Floors"
												AutomationProperties.Name="층수"
												IsEnabled="{Binding IsBuildingHeightEditable}"
												Style="{StaticResource BuildingHeightInputBox}"
												Text="{Binding BuildingHeightFloorsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
											<Button
												Grid.Column="2"
												AutomationProperties.AutomationId="Map.BuildingHeight.PlusFloor"
												Command="{Binding StepBuildingFloorCommand}"
												CommandParameter="1"
												Content="+1층"
												IsEnabled="{Binding IsBuildingHeightEditable}"
												Style="{StaticResource BuildingHeightStepButton}"
												ToolTip="한 층 높게 (↑)" />
										</Grid>

										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="높이 (m)" />
										<TextBox
											AutomationProperties.AutomationId="Map.BuildingHeight.Height"
											AutomationProperties.Name="높이"
											IsEnabled="{Binding IsBuildingHeightEditable}"
											Style="{StaticResource BuildingHeightInputBox}"
											Text="{Binding BuildingHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
									</StackPanel>

									<!--  높이 손잡이(드래그 우선) — 위로 끌면 높게(10 px = 1 m), 키보드 폴백 ↑/↓ · Shift  -->
									<Thumb
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.BuildingHeight.Handle"
										AutomationProperties.Name="높이 손잡이"
										IsEnabled="{Binding IsBuildingHeightEditable}"
										Style="{StaticResource BuildingHeightHandleThumb}"
										ToolTip="위아래로 끌어 높이 바꾸기 (Esc = 끌기 전으로)" />
								</Grid>

								<!--  외관(2026-10-21) — 외벽 무늬 · 외벽 색 · 지붕 색(자동 = 엔진이 고름) → [외관 적용], [이 건물 숨기기](확인 한 번).
								      옛 엔진이면 칸을 끄고 이유 한 줄. 쓰는 법은 판 "?"  -->
								<Border
									Height="1"
									Margin="0,10,0,8"
									Background="{DynamicResource DividerBrush}" />
								<TextBlock
									Margin="0,0,0,6"
									AutomationProperties.AutomationId="Map.BuildingHeight.LookUnsupported"
									FontSize="11"
									Foreground="{DynamicResource StatusWarningBrush}"
									Text="{Binding BuildingLookUnsupportedText}"
									TextWrapping="Wrap"
									Visibility="{Binding IsBuildingLookUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
								<Grid IsEnabled="{Binding IsBuildingLookAvailable}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="외벽 무늬" />
										<ComboBox
											AutomationProperties.AutomationId="Map.BuildingHeight.Facade"
											AutomationProperties.Name="외벽 무늬"
											DisplayMemberPath="Value"
											IsEnabled="{Binding IsBuildingHeightEditable}"
											ItemsSource="{Binding BuildingFacades}"
											SelectedValue="{Binding BuildingFacade, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="외벽 색" />
										<ComboBox
											AutomationProperties.AutomationId="Map.BuildingHeight.WallColor"
											AutomationProperties.Name="외벽 색"
											DisplayMemberPath="Value"
											IsEnabled="{Binding IsBuildingHeightEditable}"
											ItemsSource="{Binding BuildingColors}"
											SelectedValue="{Binding BuildingWallColor, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Grid.Column="4">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="지붕 색" />
										<ComboBox
											AutomationProperties.AutomationId="Map.BuildingHeight.RoofColor"
											AutomationProperties.Name="지붕 색"
											DisplayMemberPath="Value"
											IsEnabled="{Binding IsBuildingHeightEditable}"
											ItemsSource="{Binding BuildingColors}"
											SelectedValue="{Binding BuildingRoofColor, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
								</Grid>
								<Grid Margin="0,8,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="7" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.BuildingHeight.ApplyLook"
										Command="{Binding ApplyBuildingLookCommand}"
										Content="외관 적용"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="외벽 무늬 · 색 저장 — 3D 에 바로 보이고 다시 만들어도 유지됩니다" />
									<Button
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.BuildingHeight.Hide"
										Command="{Binding HideBuildingCommand}"
										Content="{Binding BuildingHideButtonText}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="이상하게 만들어진 건물을 3D 에서 뺍니다(확인 뒤 · 되돌리기 가능)" />
								</Grid>
								<!--  다시 만들어야 보이는 것(되살린 건물 · 외벽 무늬) 안내 한 줄  -->
								<TextBlock
									Margin="2,6,2,0"
									AutomationProperties.AutomationId="Map.BuildingHeight.LookNotice"
									FontSize="11"
									Foreground="{DynamicResource StatusWarningBrush}"
									Text="{Binding BuildingLookNotice}"
									TextWrapping="Wrap"
									Visibility="{Binding HasBuildingLookNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<TextBlock
									Margin="2,6,2,0"
									AutomationProperties.AutomationId="Map.BuildingHeight.Error"
									FontSize="11"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding BuildingHeightError}"
									TextWrapping="Wrap"
									Visibility="{Binding HasBuildingHeightError, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<!--  적용할 내용 한 줄(늘 보임 — 적용 단추가 곧 확인)  -->
								<Border
									Height="1"
									Margin="0,12,0,10"
									Background="{DynamicResource DividerBrush}" />
								<TextBlock
									Margin="0,0,0,12"
									AutomationProperties.AutomationId="Map.BuildingHeight.Summary"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding BuildingHeightSummary}"
									TextWrapping="Wrap" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="7" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="7" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Button
										Grid.Row="0"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.BuildingHeight.Apply"
										Command="{Binding ApplyBuildingHeightCommand}"
										Content="✓ 적용"
										Style="{StaticResource PanelPrimaryButtonStyle}"
										ToolTip="저장 — 다시 만들어도 유지됩니다" />
									<Button
										Grid.Row="0"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.BuildingHeight.Cancel"
										Command="{Binding CancelBuildingHeightCommand}"
										Content="취소"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="원래 높이로 (Esc)" />
									<Button
										Grid.Row="2"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.BuildingHeight.Reset"
										Command="{Binding ResetBuildingHeightCommand}"
										Content="자동으로 되돌리기"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="직접 넣은 값을 지우고 자동으로 잰 높이로" />
									<Button
										Grid.Row="2"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.BuildingHeight.Undo"
										Command="{Binding UndoBuildingHeightCommand}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="방금 저장한 것을 거꾸로 (Ctrl+Z)">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="14"
												Height="14"
												VerticalAlignment="Center"
												Kind="Undo" />
											<TextBlock Margin="5,0,0,0" Text="되돌리기" />
										</StackPanel>
									</Button>
								</Grid>

								<!--  「숨긴 건물 N개」(2026-10-21) — 숨긴 건물은 3D 에서 누를 수 없어 여기서 되살린다  -->
								<Border
									Height="1"
									Margin="0,12,0,8"
									Background="{DynamicResource DividerBrush}" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock
										VerticalAlignment="Center"
										AutomationProperties.AutomationId="Map.BuildingHeight.HiddenCount"
										Style="{StaticResource BuildingHeightSectionLabel}"
										Text="{Binding BuildingHiddenCountText}" />
									<Button
										Grid.Column="1"
										AutomationProperties.AutomationId="Map.BuildingHeight.RestoreAll"
										Command="{Binding RestoreAllHiddenBuildingsCommand}"
										Content="모두 되살리기"
										Style="{StaticResource BuildingHeightStepButton}"
										ToolTip="이 영역의 숨김 · 바꾼 외관을 모두 자동으로 되돌립니다(확인 뒤)" />
								</Grid>
								<ItemsControl
									MaxHeight="120"
									AutomationProperties.AutomationId="Map.BuildingHeight.HiddenList"
									ItemsSource="{Binding BuildingHiddenItems}"
									Visibility="{Binding HasBuildingHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
									<ItemsControl.Template>
										<ControlTemplate TargetType="ItemsControl">
											<ScrollViewer VerticalScrollBarVisibility="Auto">
												<ItemsPresenter />
											</ScrollViewer>
										</ControlTemplate>
									</ItemsControl.Template>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,2">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>
												<TextBlock
													VerticalAlignment="Center"
													FontSize="11"
													Foreground="{DynamicResource TextPrimaryBrush}"
													Text="{Binding Text}"
													TextTrimming="CharacterEllipsis" />
												<Button
													Grid.Column="1"
													AutomationProperties.Name="되살리기"
													Command="{Binding DataContext.RestoreHiddenBuildingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}"
													Content="되살리기"
													Style="{StaticResource BuildingHeightStepButton}" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Grid>
					</fb:FrameBorder>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
