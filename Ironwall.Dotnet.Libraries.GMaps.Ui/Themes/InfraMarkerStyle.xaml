<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:enum="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Infrastructure/Building Marker Style  -->
	<Style x:Key="BaseInfraMarkerStyle" TargetType="{x:Type control:GMapMarkerInfraControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type control:GMapMarkerInfraControl}">
					<!--  메인 컨테이너: 건물 + 라벨  -->
					<Grid Name="PART_MainContainer" HorizontalAlignment="Center">

						<!--  건물 아이콘 부분 (크기 조절됨)  -->
						<Viewbox
							Name="PART_ViewboxContainer"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							Stretch="Fill"
							ToolTip="{TemplateBinding MarkerTitle}">

							<Grid
								Name="PART_BuildingContainer"
								Width="40"
								Height="50">

								<!--  === Factory Building (심플 버전) ===  -->
								<Grid Name="PART_FactoryBuilding" Visibility="Collapsed">

									<!--  굴뚝 1 (왼쪽)  -->
									<Rectangle
										Width="8"
										Height="20"
										Margin="1,7,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Fill="{TemplateBinding MarkerFill}"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

									<!--  굴뚝 2 (왼쪽)  -->
									<Rectangle
										Width="8"
										Height="18"
										Margin="7,9,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Top"
										Fill="{TemplateBinding MarkerFill}"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

									<!--  공장 본체 (단순 사각형)  -->
									<Rectangle
										Width="38"
										Height="25"
										Margin="0,0,0,0"
										HorizontalAlignment="Center"
										VerticalAlignment="Bottom"
										Fill="{TemplateBinding MarkerFill}"
										RadiusX="2"
										RadiusY="2"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}">
										<Rectangle.Effect>
											<DropShadowEffect
												BlurRadius="4"
												Opacity="0.3"
												ShadowDepth="2" />
										</Rectangle.Effect>
									</Rectangle>

									<!--  창문 (3x2 격자)  -->
									<Grid
										Width="30"
										Height="15"
										Margin="0,0,0,3"
										HorizontalAlignment="Center"
										VerticalAlignment="Bottom">
										<Grid.RowDefinitions>
											<RowDefinition Height="*" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<!--  상단 창문들  -->
										<Rectangle
											Grid.Row="0"
											Grid.Column="0"
											Margin="2"
											Fill="#FFE082" />
										<Rectangle
											Grid.Row="0"
											Grid.Column="1"
											Margin="2"
											Fill="#FFE082" />
										<Rectangle
											Grid.Row="0"
											Grid.Column="2"
											Margin="2"
											Fill="#FFE082" />

										<!--  하단 창문들  -->
										<Rectangle
											Grid.Row="1"
											Grid.Column="0"
											Margin="2"
											Fill="#81D4FA" />
										<Rectangle
											Grid.Row="1"
											Grid.Column="1"
											Margin="2"
											Fill="#FFE082" />
										<Rectangle
											Grid.Row="1"
											Grid.Column="2"
											Margin="2"
											Fill="#81D4FA" />
									</Grid>

									<!--  출입구  -->
									<Rectangle
										Width="8"
										Height="8"
										Margin="0,0,0,0"
										HorizontalAlignment="Center"
										VerticalAlignment="Bottom"
										Fill="#424242"
										Stroke="Black"
										StrokeThickness="1" />
								</Grid>

								<!--  === Office Building ===  -->
								<Grid Name="PART_OfficeBuilding" Visibility="Collapsed">
									<!--  빌딩 본체  -->
									<Rectangle
										Width="30"
										Height="45"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Fill="{TemplateBinding MarkerFill}"
										RadiusX="1"
										RadiusY="1"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}">
										<Rectangle.Effect>
											<DropShadowEffect
												BlurRadius="5"
												Opacity="0.3"
												ShadowDepth="3" />
										</Rectangle.Effect>
									</Rectangle>

									<!--  창문 격자  -->
									<UniformGrid
										Width="24"
										Height="38"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Columns="3"
										Rows="6">
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="Yellow"
											Opacity="0.6" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="Yellow"
											Opacity="0.6" />
										<Rectangle
											Margin="1"
											Fill="Yellow"
											Opacity="0.6" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="Yellow"
											Opacity="0.6" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
										<Rectangle
											Margin="1"
											Fill="LightCyan"
											Opacity="0.7" />
									</UniformGrid>

									<!--  입구  -->
									<Rectangle
										Width="8"
										Height="8"
										Margin="0,0,0,2"
										HorizontalAlignment="Center"
										VerticalAlignment="Bottom"
										Fill="DarkGray"
										Stroke="Black"
										StrokeThickness="1" />

									<!--  옥상  -->
									<Rectangle
										Width="15"
										Height="3"
										Margin="0,2,0,0"
										HorizontalAlignment="Center"
										VerticalAlignment="Top"
										Fill="Gray" />
								</Grid>

								<!--  === General Building (기본) ===  -->
								<Grid Name="PART_GeneralBuilding" Visibility="Collapsed">
									<!--  건물 본체  -->
									<Rectangle
										Width="35"
										Height="35"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Fill="{TemplateBinding MarkerFill}"
										RadiusX="2"
										RadiusY="2"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}">
										<Rectangle.Effect>
											<DropShadowEffect
												BlurRadius="5"
												Opacity="0.3"
												ShadowDepth="3" />
										</Rectangle.Effect>
									</Rectangle>

									<!--  지붕  -->
									<Polygon
										HorizontalAlignment="Center"
										VerticalAlignment="Top"
										Fill="Brown"
										Points="0,12 17.5,0 35,12"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="1" />

									<!--  창문  -->
									<Grid
										Width="25"
										Height="20"
										Margin="0,0,0,3"
										HorizontalAlignment="Center"
										VerticalAlignment="Bottom">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<Rectangle
											Grid.Column="0"
											Margin="2"
											Fill="LightYellow"
											Opacity="0.8"
											Stroke="DarkGray"
											StrokeThickness="1" />
										<Rectangle
											Grid.Column="1"
											Margin="2"
											Fill="LightYellow"
											Opacity="0.8"
											Stroke="DarkGray"
											StrokeThickness="1" />
									</Grid>

									<!--  문  -->
									<Rectangle
										Width="8"
										Height="10"
										Margin="0,0,0,0"
										HorizontalAlignment="Center"
										VerticalAlignment="Bottom"
										Fill="SaddleBrown"
										Stroke="Black"
										StrokeThickness="1" />
								</Grid>

								<!--  층수 표시 (건물 내부)  -->
								<TextBlock
									Name="PART_FloorText"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="10"
									FontWeight="Bold"
									Foreground="White"
									Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=GetFloorDisplayText}"
									TextAlignment="Center"
									Visibility="Collapsed">
									<TextBlock.Effect>
										<DropShadowEffect
											BlurRadius="2"
											Opacity="0.8"
											ShadowDepth="1"
											Color="Black" />
									</TextBlock.Effect>
								</TextBlock>
							</Grid>
						</Viewbox>

						<!--  타이틀/정보 라벨  -->
						<Border
							Name="PART_LabelContainer"
							MinWidth="40"
							MaxWidth="150"
							Margin="0,0,0,-30"
							Padding="3,2"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							Background="White"
							BorderBrush="Gray"
							BorderThickness="1"
							CornerRadius="4"
							Visibility="Collapsed">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="3"
									Opacity="0.3"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
							<StackPanel>
								<TextBlock
									Name="PART_LabelTitle"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />

							</StackPanel>
						</Border>

						<!--  Mouse Over Highlight  -->
						<Ellipse
							Name="PART_HoverHighlight"
							Width="10"
							Height="10"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="White"
							Opacity="0" />
					</Grid>

					<ControlTemplate.Triggers>
						<!--  건물 타입별 표시  -->
						<Trigger Property="BuildingType" Value="Factory">
							<Setter TargetName="PART_FactoryBuilding" Property="Visibility" Value="Visible" />
						</Trigger>
						<!--<Trigger Property="BuildingType" Value="Office">
							<Setter TargetName="PART_OfficeBuilding" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="BuildingType" Value="General">
							<Setter TargetName="PART_GeneralBuilding" Property="Visibility" Value="Visible" />
						</Trigger>-->

						<!--  층수 표시  -->
						<Trigger Property="ShowFloorCount" Value="True">
							<Setter TargetName="PART_FloorText" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  라벨 표시 조건  -->
						<Trigger Property="ShowTitle" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  Mouse Over Effects  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_HoverHighlight" Property="Opacity" Value="0.15" />
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  ShowShape=False일 때  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_ViewboxContainer" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
						</Trigger>

						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_ViewboxContainer" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="Width" Value="40" />
		<Setter Property="Height" Value="50" />
		<Setter Property="MinWidth" Value="20" />
		<Setter Property="MinHeight" Value="25" />
		<Setter Property="MaxWidth" Value="100" />
		<Setter Property="MaxHeight" Value="125" />
		<Setter Property="TitleSize" Value="10" />
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BaseInfraMarkerStyle}" TargetType="{x:Type control:GMapMarkerInfraControl}" />

</ResourceDictionary>