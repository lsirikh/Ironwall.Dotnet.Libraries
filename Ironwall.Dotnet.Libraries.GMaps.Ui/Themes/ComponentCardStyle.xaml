<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/ComponentTableStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--
		지도 조립 카드(L3, component-display-unify FR-05) — 스토리보드 §A "지도: 조립 카드".
		머리 = 심볼 이름 · 종류 / 마지막 변화, 표 = 부품 · 상태 · 건강 · 사유(고장 먼저), 발 = [장비 콘솔에서 열기 ›] [결선에서 보기 ›].
		카드는 어도너 층에 떠 있어 지도 팬(좌드래그)을 가로채지 않는다 — 카드 위 클릭만 카드가 받는다. 끌어 옮기지 않는다(맵 위 새 드래그 금지).
		색은 전부 DynamicResource 토큰. DataContext = ComponentCardViewModel.
	-->

	<Style x:Key="Gm.ComponentCard.Link" TargetType="Button">
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Margin" Value="0,0,14,0" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Padding="0,2" Background="Transparent">
						<TextBlock Text="{TemplateBinding Content}" TextDecorations="{x:Null}" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Opacity" Value="0.8" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="Gm.ComponentCard.Close" TargetType="Button">
		<Setter Property="Width" Value="22" />
		<Setter Property="Height" Value="22" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="ToolTip" Value="닫기 (Esc)" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="Transparent" CornerRadius="11">
						<md:PackIcon
							Width="14"
							Height="14"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="{TemplateBinding Foreground}"
							Kind="Close" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ctrl:ComponentCardControl}">
		<Setter Property="Width" Value="320" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="AutomationProperties.AutomationId" Value="GMaps.ComponentCard" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:ComponentCardControl}">
					<Border
						Padding="12,10,12,10"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="6">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" Opacity="0.16" ShadowDepth="2" Color="Black" />
						</Border.Effect>
						<StackPanel>
							<!--  머리  -->
							<DockPanel LastChildFill="True">
								<Button
									AutomationProperties.AutomationId="GMaps.ComponentCard.Close"
									Command="{Binding CloseCommand}"
									DockPanel.Dock="Right"
									Style="{StaticResource Gm.ComponentCard.Close}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding Title}"
									TextTrimming="CharacterEllipsis"
									ToolTip="{Binding Title}" />
							</DockPanel>
							<TextBlock
								Margin="0,2,0,0"
								FontSize="10.5"
								Foreground="{DynamicResource TextMutedBrush}"
								Text="{Binding SubTitle}"
								TextTrimming="CharacterEllipsis" />

							<!--  표 — 고장 먼저  -->
							<StackPanel Margin="0,10,0,0" DataContext="{Binding Table}">
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Style.Triggers>
											<DataTrigger Binding="{Binding DataContext.HasTable, RelativeSource={RelativeSource AncestorType=ctrl:ComponentCardControl}}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>
								<StackPanel Margin="0,0,0,6" Orientation="Horizontal">
									<Ellipse Style="{StaticResource Gm.Component.SummaryDot}" />
									<TextBlock
										FontSize="11.5"
										FontWeight="SemiBold"
										Foreground="{DynamicResource TextPrimaryBrush}"
										Text="{Binding SummaryText}" />
								</StackPanel>
								<Grid Margin="0,0,0,3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="84" />
										<ColumnDefinition Width="58" />
										<ColumnDefinition Width="70" />
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Style="{StaticResource Gm.Component.Head}" Text="부품" />
									<TextBlock Grid.Column="1" Style="{StaticResource Gm.Component.Head}" Text="상태" />
									<TextBlock Grid.Column="2" Style="{StaticResource Gm.Component.Head}" Text="건강" />
									<TextBlock Grid.Column="3" Style="{StaticResource Gm.Component.Head}" Text="사유" />
								</Grid>
								<Border Height="1" Background="{DynamicResource DividerBrush}" />
								<ScrollViewer MaxHeight="210" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
									<ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Grid Margin="0,3" Background="Transparent" ToolTip="{Binding DetailToolTip}">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="84" />
														<ColumnDefinition Width="58" />
														<ColumnDefinition Width="70" />
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0" Style="{StaticResource Gm.Component.Cell}" Text="{Binding Name}" />
													<TextBlock Grid.Column="1" Style="{StaticResource Gm.Component.StateCell}" Text="{Binding StateText}" />
													<StackPanel Grid.Column="2" Orientation="Horizontal">
														<Ellipse Style="{StaticResource Gm.Component.Dot}" />
														<TextBlock Style="{StaticResource Gm.Component.Cell}" Text="{Binding HealthText}" />
													</StackPanel>
													<TextBlock Grid.Column="3" Style="{StaticResource Gm.Component.Cell}" Text="{Binding FaultText}" ToolTip="{Binding FaultText}" />
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>

							<!--  부품 정보 없음(FR-08) — 표 대신 한 줄  -->
							<TextBlock
								Margin="0,10,0,0"
								FontSize="11.5"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{Binding NoInfoText}">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Style.Triggers>
											<DataTrigger Binding="{Binding HasTable}" Value="True">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>

							<!--  발 — 항법(호스트가 입구를 등록했을 때만)  -->
							<StackPanel Margin="0,10,0,0" Orientation="Horizontal">
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Style.Triggers>
											<DataTrigger Binding="{Binding HasActions}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>
								<Button
									AutomationProperties.AutomationId="GMaps.ComponentCard.OpenConsole"
									Command="{Binding OpenConsoleCommand}"
									Content="장비 콘솔에서 열기 ›">
									<Button.Style>
										<Style BasedOn="{StaticResource Gm.ComponentCard.Link}" TargetType="Button">
											<Style.Triggers>
												<DataTrigger Binding="{Binding CanOpenConsole}" Value="False">
													<Setter Property="Visibility" Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
								</Button>
								<Button
									AutomationProperties.AutomationId="GMaps.ComponentCard.OpenWiring"
									Command="{Binding OpenWiringCommand}"
									Content="결선에서 보기 ›">
									<Button.Style>
										<Style BasedOn="{StaticResource Gm.ComponentCard.Link}" TargetType="Button">
											<Style.Triggers>
												<DataTrigger Binding="{Binding CanOpenWiring}" Value="False">
													<Setter Property="Visibility" Value="Collapsed" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
								</Button>
							</StackPanel>
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
