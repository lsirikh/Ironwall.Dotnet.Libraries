<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  강풍모드(WINDY) 인디케이터 GMapWindyIndicatorControl (GMap_Map_Instruments)
          - 알약 배지: 아이콘(모드별 PackIcon) + 모드명/서브텍스트. 고정색 아님 — 전부 DynamicResource 토큰.
          - 모드별(DataTrigger Mode=wind0~3): 테두리/아이콘색 = Border/Info/Warning/Critical, wind3=회전+펄스.
          - DisplayStyle=IconOnly면 텍스트 숨김+원형. 템플릿 스코프이므로 앱 StaticResource 참조 금지.  -->

    <Style TargetType="{x:Type ctrl:GMapWindyIndicatorControl}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:GMapWindyIndicatorControl}">
                    <Border x:Name="PART_Root"
                            Padding="9,7,12,7"
                            CornerRadius="22"
                            Background="{DynamicResource SurfaceTranslucentBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.28" ShadowDepth="2" Color="Black" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon x:Name="Icon"
                                         Width="28" Height="28"
                                         VerticalAlignment="Center"
                                         Kind="WeatherWindy"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         RenderTransformOrigin="0.5,0.5">
                                <md:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="IconRotate" Angle="0" />
                                </md:PackIcon.RenderTransform>
                            </md:PackIcon>
                            <StackPanel x:Name="TextGroup" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ModeText"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{TemplateBinding ModeName}" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{TemplateBinding ModeDesc}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  아이콘만: 텍스트 숨김 + 원형  -->
                        <Trigger Property="DisplayStyle" Value="IconOnly">
                            <Setter TargetName="TextGroup" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Root" Property="Padding" Value="7" />
                            <Setter TargetName="PART_Root" Property="CornerRadius" Value="24" />
                        </Trigger>

                        <!--  wind1 약풍 = Info  -->
                        <Trigger Property="Mode" Value="wind1">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                            <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource StatusInfoBrush}" />
                            <Setter TargetName="Icon" Property="Kind" Value="WeatherWindy" />
                        </Trigger>
                        <!--  wind2 강풍 = Warning  -->
                        <Trigger Property="Mode" Value="wind2">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                            <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
                            <Setter TargetName="Icon" Property="Kind" Value="WeatherWindyVariant" />
                        </Trigger>
                        <!--  wind3 태풍 = Critical + 회전 애니메이션  -->
                        <Trigger Property="Mode" Value="wind3">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                            <Setter TargetName="ModeText" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
                            <Setter TargetName="Icon" Property="Kind" Value="WeatherHurricane" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinSb">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:3.5"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinSb" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
