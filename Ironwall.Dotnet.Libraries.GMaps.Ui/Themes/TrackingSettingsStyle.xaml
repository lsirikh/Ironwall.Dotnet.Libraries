<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:util="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<util:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />

	<Style x:Key="SetGroupHeader" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0,0,0,7" />
	</Style>
	<Style x:Key="SetLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FontSize" Value="12.5" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="SetHint" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="SetVal" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="MinWidth" Value="42" />
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style x:Key="SetNum" TargetType="TextBox">
		<Setter Property="Width" Value="60" />
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="Padding" Value="3,2" />
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style TargetType="{x:Type ctrl:TrackingSettingsControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:TrackingSettingsControl}">
					<Border
						Width="360"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="3" Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!-- 헤더 (드래그) -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16" Height="16"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="Cog" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										FontSize="13" FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="추적 설정" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Command="{Binding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!-- 바디 (DataContext = TrackingSetupViewModel) -->
							<StackPanel Grid.Row="1">
								<!-- 표시 -->
								<StackPanel Margin="12,10,12,8">
									<TextBlock Style="{StaticResource SetGroupHeader}" Text="표시" />
									<Grid Margin="0,3">
										<TextBlock Style="{StaticResource SetLabel}" Text="추적 표시" />
										<CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IsTrackingEnabled, Mode=TwoWay}" />
									</Grid>
									<Grid Margin="0,3">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="120" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock Style="{StaticResource SetLabel}" Text="최소 줌" />
											<TextBlock Style="{StaticResource SetHint}" Text="이하 숨김 (0=항상)" />
										</StackPanel>
										<Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="20" AutoToolTipPlacement="None" Value="{Binding MinVisibleZoom, Mode=TwoWay}" />
										<TextBlock Grid.Column="2" Style="{StaticResource SetVal}" Text="{Binding MinVisibleZoom, StringFormat={}{0:0}}" />
									</Grid>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- 트레일 -->
								<StackPanel Margin="12,8">
									<TextBlock Style="{StaticResource SetGroupHeader}" Text="트레일" />
									<Grid Margin="0,3">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="120" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock Style="{StaticResource SetLabel}" Text="최대 점수" />
											<TextBlock Style="{StaticResource SetHint}" Text="10~100" />
										</StackPanel>
										<Slider Grid.Column="1" VerticalAlignment="Center" Minimum="10" Maximum="100" AutoToolTipPlacement="None" Value="{Binding TrailMaxPoints, Mode=TwoWay}" />
										<TextBlock Grid.Column="2" Style="{StaticResource SetVal}" Text="{Binding TrailMaxPoints, StringFormat={}{0} pt}" />
									</Grid>
									<Grid Margin="0,3">
										<StackPanel>
											<TextBlock Style="{StaticResource SetLabel}" Text="끊김 분절" />
											<TextBlock Style="{StaticResource SetHint}" Text="gap 초 초과 시 트레일 분리" />
										</StackPanel>
										<TextBox Style="{StaticResource SetNum}" Text="{Binding GapThresholdSec, Mode=TwoWay}" />
									</Grid>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- 수명 -->
								<StackPanel Margin="12,8">
									<TextBlock Style="{StaticResource SetGroupHeader}" Text="수명 (TTL)" />
									<Grid Margin="0,3">
										<StackPanel>
											<TextBlock Style="{StaticResource SetLabel}" Text="기본 TTL" />
											<TextBlock Style="{StaticResource SetHint}" Text="ttl_sec 없을 때 폴백(초)" />
										</StackPanel>
										<TextBox Style="{StaticResource SetNum}" Text="{Binding DefaultTtlSec, Mode=TwoWay}" />
									</Grid>
									<Grid Margin="0,3">
										<StackPanel>
											<TextBlock Style="{StaticResource SetLabel}" Text="Lost 유예" />
											<TextBlock Style="{StaticResource SetHint}" Text="lost 후 제거 유예(초)" />
										</StackPanel>
										<TextBox Style="{StaticResource SetNum}" Text="{Binding LostTtlSec, Mode=TwoWay}" />
									</Grid>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- 속도·재생 -->
								<StackPanel Margin="12,8">
									<TextBlock Style="{StaticResource SetGroupHeader}" Text="속도 · 재생" />
									<Grid Margin="0,3">
										<StackPanel>
											<TextBlock Style="{StaticResource SetLabel}" Text="최대 속도" />
											<TextBlock Style="{StaticResource SetHint}" Text="m/s 이상치 방어" />
										</StackPanel>
										<TextBox Style="{StaticResource SetNum}" Text="{Binding MaxSpeedMs, Mode=TwoWay}" />
									</Grid>
									<Grid Margin="0,3">
										<StackPanel>
											<TextBlock Style="{StaticResource SetLabel}" Text="최대 재생시간" />
											<TextBlock Style="{StaticResource SetHint}" Text="Playback 1회 조회 상한(시간)" />
										</StackPanel>
										<TextBox Style="{StaticResource SetNum}" Text="{Binding MaxPlaybackHours, Mode=TwoWay}" />
									</Grid>
								</StackPanel>
								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- 데이터 소스(재생) -->
								<StackPanel Margin="12,8">
									<TextBlock Style="{StaticResource SetGroupHeader}" Text="데이터 소스 (재생)" />
									<Grid Margin="0,3">
										<StackPanel>
											<TextBlock Style="{StaticResource SetLabel}" Text="조회 소스" />
											<TextBlock Style="{StaticResource SetHint}" Text="로컬 DB / 서버 API" />
										</StackPanel>
										<ComboBox Width="110" HorizontalAlignment="Right" VerticalAlignment="Center"
										          ItemsSource="{Binding DataSourceOptions}"
										          SelectedItem="{Binding DataSource, Mode=TwoWay}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Converter={StaticResource EnumDisplayNameConverter}}" />
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</Grid>
								</StackPanel>

							</StackPanel>

							<!-- footer -->
							<Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="0,0,9,9">
								<Grid Margin="12,8">
									<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource SetHint}" Text="{Binding Status}" />
									<StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
										<Button Margin="0,0,8,0" Style="{StaticResource PanelSecondaryButtonStyle}" Command="{Binding ResetCommand}" Content="기본값" />
										<Button Style="{StaticResource PanelPrimaryButtonStyle}" Command="{Binding SaveCommand}" Content="저장" />
									</StackPanel>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
