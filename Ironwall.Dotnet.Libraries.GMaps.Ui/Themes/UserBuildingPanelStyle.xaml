<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<!--  「건물 그리기」 판(2026-10-19) — 「건물 높이」 판(BuildingHeightPanelStyle) 크롬 · 입력칸 · 손잡이 답습:
	      FrameBorder(Surface · Border · 반지름 10 · 그림자) + PrimaryBrush 머리 띠 38(끌기) + [아이콘][제목][? 받침][✕].
	      색은 전부 DynamicResource 토큰(Tactical Command 라이트/다크).  -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/BuildingHeightPanelStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  형상 도구 단추 — 표준 보조 단추를 작게. 고른 도구는 색만이 아니라 아래 굵은 막대(형태)로 표시  -->
	<Style
		x:Key="UserBuildingToolButton"
		BasedOn="{StaticResource PanelSecondaryButtonStyle}"
		TargetType="Button">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Margin" Value="2" />
		<Setter Property="Padding" Value="2,4" />
		<Setter Property="FontSize" Value="11" />
	</Style>

	<!--  고른 도구 아래 막대(높이 3)  -->
	<Style x:Key="UserBuildingToolBar" TargetType="Border">
		<Setter Property="Height" Value="3" />
		<Setter Property="Margin" Value="6,3,6,0" />
		<Setter Property="CornerRadius" Value="1.5" />
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
	</Style>

	<!--  3D 위 편집 칸(2026-10-21, edit3d-contract) — 「건물 만들기」 · 「꾸미기」 판이 3D 위에서 열렸을 때만(IsEdit3DMode).
	      단추는 edit.key 로 뷰어 키보드와 똑같이 동작한다(엔진 dac1e69): 화면 기준 ↑↓←→(0.5 m · Shift = 5 m) · ↺↻(소품 15° · Shift = 1°) ·
	      꼭짓점 이전/다음/지우기는 미리보기만, [✓ 확정](Enter)에서 저장 · 편집 기록. [2D 에서 윤곽 고치기].
	      DataContext = MapViewModel(판에서 물려받음). 두 판이 같이 쓴다(동시에 열리지 않는다).  -->
	<ControlTemplate x:Key="Edit3DSectionTemplate" TargetType="ContentControl">
		<StackPanel AutomationProperties.AutomationId="Map.Edit3D.Section" Visibility="{Binding IsEdit3DMode, Converter={StaticResource BooleanToVisibilityConverter}}">
			<Border
				Height="1"
				Margin="0,10,0,8"
				Background="{DynamicResource DividerBrush}" />
			<StackPanel Visibility="{Binding IsEdit3DTargetActive, Converter={StaticResource BooleanToVisibilityConverter}}">
				<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="옮기기 (화면 기준 0.5 m · Shift = 5 m)" />
				<UniformGrid Margin="0,0,0,6" Columns="4">
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.MoveUp"
						AutomationProperties.Name="앞으로 옮기기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="ArrowUp"
						Content="↑"
						Style="{StaticResource BuildingHeightStepButton}"
						ToolTip="화면 안쪽(보는 쪽)으로 0.5 m (Shift = 5 m)" />
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.MoveDown"
						AutomationProperties.Name="뒤로 옮기기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="ArrowDown"
						Content="↓"
						Style="{StaticResource BuildingHeightStepButton}"
						ToolTip="화면 바깥쪽으로 0.5 m (Shift = 5 m)" />
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.MoveLeft"
						AutomationProperties.Name="왼쪽으로 옮기기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="ArrowLeft"
						Content="←"
						Style="{StaticResource BuildingHeightStepButton}"
						ToolTip="화면 왼쪽으로 0.5 m (Shift = 5 m)" />
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.MoveRight"
						AutomationProperties.Name="오른쪽으로 옮기기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="ArrowRight"
						Content="→"
						Style="{StaticResource BuildingHeightStepButton}"
						ToolTip="화면 오른쪽으로 0.5 m (Shift = 5 m)" />
				</UniformGrid>
				<UniformGrid
					Margin="0,0,0,6"
					Columns="2"
					Visibility="{Binding IsEdit3DRotateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.RotateLeft"
						AutomationProperties.Name="왼쪽으로 돌리기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="["
						Content="↺"
						Style="{StaticResource BuildingHeightStepButton}"
						ToolTip="왼쪽으로 15° (Shift = 1°)" />
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.RotateRight"
						AutomationProperties.Name="오른쪽으로 돌리기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="]"
						Content="↻"
						Style="{StaticResource BuildingHeightStepButton}"
						ToolTip="오른쪽으로 15° (Shift = 1°)" />
				</UniformGrid>
				<UniformGrid
					Margin="0,0,0,6"
					Columns="3"
					Visibility="{Binding IsEdit3DVertexVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.VertexPrev"
						AutomationProperties.Name="이전 꼭짓점"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="Shift+Tab"
						Content="◀ 이전"
						Style="{StaticResource PanelSecondaryButtonStyle}"
						ToolTip="이전 꼭짓점 고르기 (3D 에서 Shift+Tab)" />
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.VertexNext"
						AutomationProperties.Name="다음 꼭짓점"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="Tab"
						Content="다음 ▶"
						Style="{StaticResource PanelSecondaryButtonStyle}"
						ToolTip="다음 꼭짓점 고르기 (3D 에서 Tab)" />
					<Button
						Margin="2"
						AutomationProperties.AutomationId="Map.Edit3D.VertexDelete"
						AutomationProperties.Name="고른 꼭짓점 지우기"
						Command="{Binding Edit3DKeyCommand}"
						CommandParameter="Delete"
						Content="지우기"
						Style="{StaticResource PanelSecondaryButtonStyle}"
						ToolTip="고른 꼭짓점 지우기 (3D 에서 Delete — 확정해야 저장)" />
				</UniformGrid>
				<Button
					Margin="0,0,0,6"
					AutomationProperties.AutomationId="Map.Edit3D.Confirm"
					Command="{Binding Edit3DKeyCommand}"
					CommandParameter="Enter"
					Content="✓ 확정"
					Style="{StaticResource PanelPrimaryButtonStyle}"
					ToolTip="옮기기 · 돌리기 · 꼭짓점 고친 것을 저장 (3D 에서 Enter · 되돌리기 가능)" />
			</StackPanel>
			<Button
				AutomationProperties.AutomationId="Map.Edit3D.To2D"
				Command="{Binding EditIn2DCommand}"
				Content="2D 에서 윤곽 고치기"
				Style="{StaticResource PanelSecondaryButtonStyle}"
				ToolTip="2D 지도로 바꿔 윤곽을 고칩니다(3D 를 나갑니다)" />
		</StackPanel>
	</ControlTemplate>

	<Style TargetType="{x:Type ctrl:UserBuildingPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:UserBuildingPanelControl}">
					<fb:FrameBorder
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!--  머리 띠(끌기)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="OfficeBuildingOutline" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{Binding UserBuildingTitle}" />
									<!--  판 "?"(help-callout H-4) — 그리는 법 · 고치기 · 들어올리기 · 꾸미기 · 저장  -->
									<Border Grid.Column="1" Style="{StaticResource PanelHeaderHelpDisc}">
										<fb:HelpTip HelpKey="Map.UserBuilding.Panel" Scope="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</Border>
									<Button
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.UserBuilding.Close"
										AutomationProperties.Name="닫기(그리기 끝내기)"
										Command="{TemplateBinding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}"
										ToolTip="그리기 끝내기 (저장하지 않은 윤곽은 버립니다)" />
								</Grid>
							</Border>

							<!--  바디 (DataContext = MapViewModel)  -->
							<StackPanel Grid.Row="1" Margin="14,12,14,14">
								<!--  형상 도구 줄 — 사각형(R) · 삼각형(T) · 원(C) · 타원(E) · 다각형(P). 쓰는 법은 단추 풍선과 판 "?"  -->
								<UniformGrid Margin="0,0,0,8" Columns="5">
									<Button
										AutomationProperties.AutomationId="Map.UserBuilding.Tool.Rect"
										AutomationProperties.Name="사각형"
										Command="{Binding SelectUserBuildingToolCommand}"
										CommandParameter="Rect"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="사각형 (R) — 대각선으로 끌기 · Shift = 정사각형">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="VectorRectangle" />
											<TextBlock HorizontalAlignment="Center" Text="사각형" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsUserBuildingToolRect, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.UserBuilding.Tool.Triangle"
										AutomationProperties.Name="삼각형"
										Command="{Binding SelectUserBuildingToolCommand}"
										CommandParameter="Triangle"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="삼각형 (T) — 상자처럼 끌기 · Shift = 정삼각형">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="TriangleOutline" />
											<TextBlock HorizontalAlignment="Center" Text="삼각형" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsUserBuildingToolTriangle, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.UserBuilding.Tool.Circle"
										AutomationProperties.Name="원"
										Command="{Binding SelectUserBuildingToolCommand}"
										CommandParameter="Circle"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="원 (C) — 가운데에서 끌어 반지름">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="VectorCircle" />
											<TextBlock HorizontalAlignment="Center" Text="원" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsUserBuildingToolCircle, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.UserBuilding.Tool.Ellipse"
										AutomationProperties.Name="타원"
										Command="{Binding SelectUserBuildingToolCommand}"
										CommandParameter="Ellipse"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="타원 (E) — 가운데에서 끌기 · 세 번 클릭(가운데 · 긴 축 · 짧은 축)">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="VectorEllipse" />
											<TextBlock HorizontalAlignment="Center" Text="타원" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsUserBuildingToolEllipse, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.UserBuilding.Tool.Polygon"
										AutomationProperties.Name="다각형"
										Command="{Binding SelectUserBuildingToolCommand}"
										CommandParameter="Polygon"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="다각형 (P) — 클릭으로 변을 잇고 처음 점을 누르면 닫힘 · Shift = 직각 맞춤">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="VectorPolygon" />
											<TextBlock HorizontalAlignment="Center" Text="다각형" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsUserBuildingToolPolygon, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
								</UniformGrid>
								<!--  여러 개 고름(Ctrl+클릭) — 「도형 N개 선택」 + [합치기](2개 이상) · [선택 풀기]. 쓰는 법은 판 "?"  -->
								<Border
									Margin="0,0,0,8"
									Padding="8,6"
									Background="{DynamicResource SurfaceAltBrush}"
									BorderBrush="{DynamicResource PrimaryBrush}"
									BorderThickness="1"
									CornerRadius="6"
									Visibility="{Binding HasUserBuildingSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
									<StackPanel>
										<TextBlock
											AutomationProperties.AutomationId="Map.UserBuilding.SelectionCount"
											FontSize="12"
											FontWeight="SemiBold"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding UserBuildingSelectionText}"
											TextWrapping="Wrap" />
										<Grid Margin="0,6,0,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="7" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Button
												Grid.Column="0"
												AutomationProperties.AutomationId="Map.UserBuilding.Merge"
												AutomationProperties.Name="합치기"
												Command="{Binding MergeUserBuildingsCommand}"
												Style="{StaticResource PanelPrimaryButtonStyle}"
												ToolTip="고른 건물을 하나로 합칩니다(되돌리기 가능)"
												Visibility="{Binding IsUserBuildingMergeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
												<StackPanel Orientation="Horizontal">
													<md:PackIcon
														Width="14"
														Height="14"
														VerticalAlignment="Center"
														Kind="VectorUnion" />
													<TextBlock Margin="5,0,0,0" Text="합치기" />
												</StackPanel>
											</Button>
											<Button
												Grid.Column="2"
												AutomationProperties.AutomationId="Map.UserBuilding.ClearSelection"
												AutomationProperties.Name="선택 풀기"
												Command="{Binding ClearUserBuildingSelectionCommand}"
												Content="선택 풀기"
												Style="{StaticResource PanelSecondaryButtonStyle}"
												ToolTip="고른 것을 모두 풉니다 (Esc)" />
										</Grid>
									</StackPanel>
								</Border>
								<TextBlock
									AutomationProperties.AutomationId="Map.UserBuilding.PointCount"
									FontSize="13"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding UserBuildingPointCountText}"
									TextWrapping="Wrap" />
								<TextBlock
									Margin="0,4,0,10"
									AutomationProperties.AutomationId="Map.UserBuilding.Area"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding UserBuildingAreaText}"
									TextWrapping="Wrap" />

								<Border
									Height="1"
									Margin="0,0,0,10"
									Background="{DynamicResource DividerBrush}" />
								<!--  건물 설정  -->
								<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="이름 (선택)" />
								<TextBox
									Margin="2,2,2,8"
									HorizontalContentAlignment="Left"
									AutomationProperties.AutomationId="Map.UserBuilding.Name"
									AutomationProperties.Name="건물 이름"
									MaxLength="60"
									Style="{StaticResource BuildingHeightInputBox}"
									Text="{Binding UserBuildingName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="10" />
										<ColumnDefinition Width="48" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="층고 (m, 한 층 높이)" />
										<TextBox
											Margin="2,2,2,8"
											AutomationProperties.AutomationId="Map.UserBuilding.FloorHeight"
											AutomationProperties.Name="층고"
											Style="{StaticResource BuildingHeightInputBox}"
											Text="{Binding UserBuildingFloorHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="층수" />
										<Grid Margin="0,0,0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<Button
												Grid.Column="0"
												AutomationProperties.AutomationId="Map.UserBuilding.MinusFloor"
												Command="{Binding StepUserBuildingFloorCommand}"
												CommandParameter="-1"
												Content="−1층"
												Style="{StaticResource BuildingHeightStepButton}"
												ToolTip="한 층 낮게 (↓)" />
											<TextBox
												Grid.Column="1"
												AutomationProperties.AutomationId="Map.UserBuilding.Floors"
												AutomationProperties.Name="층수"
												Style="{StaticResource BuildingHeightInputBox}"
												Text="{Binding UserBuildingFloorsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
											<Button
												Grid.Column="2"
												AutomationProperties.AutomationId="Map.UserBuilding.PlusFloor"
												Command="{Binding StepUserBuildingFloorCommand}"
												CommandParameter="1"
												Content="+1층"
												Style="{StaticResource BuildingHeightStepButton}"
												ToolTip="한 층 높게 (↑)" />
										</Grid>

										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="높이 (m)" />
										<TextBox
											AutomationProperties.AutomationId="Map.UserBuilding.Height"
											AutomationProperties.Name="높이"
											Style="{StaticResource BuildingHeightInputBox}"
											Text="{Binding UserBuildingHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
									</StackPanel>

									<!--  들어올리기 손잡이(드래그 우선) — 위로 끌면 높게(10 px = 1 m), 키보드 폴백 ↑/↓ · Shift  -->
									<Thumb
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.UserBuilding.Handle"
										AutomationProperties.Name="들어올리기 손잡이"
										Style="{StaticResource BuildingHeightHandleThumb}"
										ToolTip="위아래로 끌어 높이 바꾸기 (Esc = 끌기 전으로)" />
								</Grid>

								<Grid Margin="0,8,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="64" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="지붕 모양" />
										<ComboBox
											AutomationProperties.AutomationId="Map.UserBuilding.Roof"
											AutomationProperties.Name="지붕 모양"
											DisplayMemberPath="Value"
											ItemsSource="{Binding UserBuildingRoofs}"
											SelectedValue="{Binding UserBuildingRoof, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="외벽 성격" />
										<ComboBox
											AutomationProperties.AutomationId="Map.UserBuilding.Use"
											AutomationProperties.Name="외벽 성격"
											DisplayMemberPath="Value"
											ItemsSource="{Binding UserBuildingUses}"
											SelectedValue="{Binding UserBuildingUse, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Grid.Column="4">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="원 꼭짓점" />
										<TextBox
											AutomationProperties.AutomationId="Map.UserBuilding.CircleSides"
											AutomationProperties.Name="원 꼭짓점 수"
											Style="{StaticResource BuildingHeightInputBox}"
											Text="{Binding UserBuildingCircleSidesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
									</StackPanel>
								</Grid>
								<!--  외관(2026-10-21) — 외벽 무늬 · 외벽 색 · 지붕 색(자동 = 엔진이 고름). 3D 상자에도 바로 입혀진다  -->
								<Grid Margin="0,8,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="8" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="외벽 무늬" />
										<ComboBox
											AutomationProperties.AutomationId="Map.UserBuilding.Facade"
											AutomationProperties.Name="외벽 무늬"
											DisplayMemberPath="Value"
											ItemsSource="{Binding UserBuildingFacades}"
											SelectedValue="{Binding UserBuildingFacade, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="외벽 색" />
										<ComboBox
											AutomationProperties.AutomationId="Map.UserBuilding.WallColor"
											AutomationProperties.Name="외벽 색"
											DisplayMemberPath="Value"
											ItemsSource="{Binding UserBuildingColors}"
											SelectedValue="{Binding UserBuildingWallColor, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Grid.Column="4">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="지붕 색" />
										<ComboBox
											AutomationProperties.AutomationId="Map.UserBuilding.RoofColor"
											AutomationProperties.Name="지붕 색"
											DisplayMemberPath="Value"
											ItemsSource="{Binding UserBuildingColors}"
											SelectedValue="{Binding UserBuildingRoofColor, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
								</Grid>
								<!--  고른 지붕이 이 윤곽으로는 안 됨(ㄱ자에 박공 등) — 짧은 상태 글, 판정 규칙은 "?" 말풍선  -->
								<TextBlock
									Margin="2,6,2,0"
									AutomationProperties.AutomationId="Map.UserBuilding.RoofStatus"
									FontSize="11"
									Foreground="{DynamicResource StatusWarningBrush}"
									Text="{Binding UserBuildingRoofStatus}"
									TextWrapping="Wrap"
									Visibility="{Binding HasUserBuildingRoofStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<TextBlock
									Margin="2,6,2,0"
									AutomationProperties.AutomationId="Map.UserBuilding.Error"
									FontSize="11"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding UserBuildingError}"
									TextWrapping="Wrap"
									Visibility="{Binding HasUserBuildingError, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<Border
									Height="1"
									Margin="0,12,0,10"
									Background="{DynamicResource DividerBrush}" />
								<TextBlock
									Margin="0,0,0,12"
									AutomationProperties.AutomationId="Map.UserBuilding.Summary"
									FontSize="12"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding UserBuildingSummary}"
									TextWrapping="Wrap" />

								<ContentControl Margin="0,0,0,10" Template="{StaticResource Edit3DSectionTemplate}" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="7" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="7" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="7" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Button
										Grid.Row="0"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.UserBuilding.Apply"
										Command="{Binding ApplyUserBuildingCommand}"
										Content="✓ 적용"
										Style="{StaticResource PanelPrimaryButtonStyle}"
										ToolTip="저장 — 3D 에 상자로 바로 보이고, 다시 만들면 사진으로 꾸며집니다" />
									<Button
										Grid.Row="0"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.UserBuilding.Cancel"
										Command="{Binding CancelUserBuildingCommand}"
										Content="취소"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="그리던 윤곽 버리기 (Esc)" />
									<Button
										Grid.Row="2"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.UserBuilding.Delete"
										Command="{Binding DeleteUserBuildingCommand}"
										Content="지우기"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="저장된 이 건물을 지웁니다(되돌리기 가능)"
										Visibility="{Binding IsUserBuildingEditingSaved, Converter={StaticResource BooleanToVisibilityConverter}}" />
									<Button
										Grid.Row="2"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.UserBuilding.Undo"
										Command="{Binding UndoUserBuildingCommand}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="방금 한 것을 거꾸로 (Ctrl+Z)">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="14"
												Height="14"
												VerticalAlignment="Center"
												Kind="Undo" />
											<TextBlock Margin="5,0,0,0" Text="되돌리기" />
										</StackPanel>
									</Button>
									<Button
										Grid.Row="4"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.UserBuilding.Redo"
										Command="{Binding RedoUserBuildingCommand}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="되돌린 것을 다시 (Ctrl+Y)">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="14"
												Height="14"
												VerticalAlignment="Center"
												Kind="Redo" />
											<TextBlock Margin="5,0,0,0" Text="다시 하기" />
										</StackPanel>
									</Button>
								</Grid>
							</StackPanel>
						</Grid>
					</fb:FrameBorder>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
