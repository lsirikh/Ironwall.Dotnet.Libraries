<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:roi="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapRoi">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  MapRoiControl 메인 스타일  -->
	<Style TargetType="{x:Type roi:MapRoiControl}">
		<Setter Property="FontFamily" Value="Malgun Gothic" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type roi:MapRoiControl}">
					<Border
						x:Name="PART_MainBorder"
						Width="290"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">

						<Border.Effect>
							<DropShadowEffect
								BlurRadius="8"
								Opacity="0.12"
								ShadowDepth="2"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="42" />
								<!--  헤더  -->
								<RowDefinition Height="*" />
								<!--  콘텐츠  -->
							</Grid.RowDefinitions>

							<!--  헤더 영역 (드래그)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>

									<md:PackIcon
										Grid.Column="0"
										Width="18"
										Height="18"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="MapMarkerRadius" />

									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="14"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{TemplateBinding PanelTitle}" />

									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!--  콘텐츠 영역  -->
							<StackPanel Grid.Row="1" Margin="12">

								<!--  섹션 라벨  -->
								<TextBlock
									Margin="0,0,0,6"
									FontSize="10"
									FontWeight="Bold"
									Foreground="{DynamicResource PrimaryBrush}"
									Text="LOCATION LIST" />

								<!--  리스트  -->
								<Border
									Margin="0,0,0,10"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="6">
									<ListBox
										x:Name="PART_RoiListBox"
										Height="220"
										MaxHeight="220"
										Background="Transparent"
										BorderThickness="0"
										ItemsSource="{TemplateBinding RoiItems}"
										SelectedItem="{Binding SelectedRoi, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
										<ListBox.ItemContainerStyle>
											<Style TargetType="ListBoxItem">
												<Setter Property="Padding" Value="0" />
												<Setter Property="Margin" Value="0" />
												<Setter Property="HorizontalContentAlignment" Value="Stretch" />
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="ListBoxItem">
															<Border
																x:Name="Bd"
																Padding="10,6"
																Background="Transparent"
																CornerRadius="4">
																<ContentPresenter />
															</Border>
															<ControlTemplate.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
																</Trigger>
																<Trigger Property="IsSelected" Value="True">
																	<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
											</Style>
										</ListBox.ItemContainerStyle>
										<ListBox.ItemTemplate>
											<DataTemplate>
												<Grid>
													<TextBlock
														x:Name="TitleText"
														FontSize="12"
														Foreground="{DynamicResource TextPrimaryBrush}"
														Text="{Binding Title}" />
													<TextBox
														x:Name="TitleEdit"
														FontSize="12"
														Padding="0"
														BorderBrush="{DynamicResource PrimaryBrush}"
														BorderThickness="1"
														Text="{Binding Title, UpdateSourceTrigger=Explicit}"
														Visibility="Collapsed" />
												</Grid>
											</DataTemplate>
										</ListBox.ItemTemplate>
									</ListBox>
								</Border>

								<!--  버튼 영역  -->
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Margin="0,0,2,0"
										Command="{TemplateBinding MoveCommand}"
										Content="이동"
										Style="{StaticResource PanelPrimaryButtonStyle}" />
									<Button
										Grid.Column="1"
										Margin="2,0"
										Command="{TemplateBinding RegisterCommand}"
										Content="등록"
										Style="{StaticResource PanelSecondaryButtonStyle}" />
									<Button
										Grid.Column="2"
										Margin="2,0,0,0"
										Command="{TemplateBinding DeleteCommand}"
										Content="삭제"
										Style="{StaticResource PanelDangerButtonStyle}" />
								</Grid>
							</StackPanel>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
