<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:roi="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapRoi">

	<!--  버튼 스타일  -->
	<Style x:Key="RoiButton" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Margin" Value="2" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						Padding="8,4"
						Background="{TemplateBinding Background}"
						BorderBrush="#5A9BD8"
						BorderThickness="1"
						CornerRadius="3">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="#885A9BD8" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" Value="#DD4A8BC8" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  MapRoiControl 메인 스타일  -->
	<Style TargetType="{x:Type roi:MapRoiControl}">
		<Setter Property="Background" Value="#7DB0E8" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontFamily" Value="Malgun Gothic" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type roi:MapRoiControl}">
					<Border
						x:Name="PART_MainBorder"
						Width="280"
						Height="350"
						Background="{TemplateBinding Background}"
						BorderBrush="#5A9BD8"
						BorderThickness="2"
						CornerRadius="10">

						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.3"
								ShadowDepth="5"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="45" />
								<!--  헤더  -->
								<RowDefinition Height="*" />
								<!--  콘텐츠  -->
								<RowDefinition Height="50" />
								<!--  하단 버튼  -->
							</Grid.RowDefinitions>

							<!--  헤더 영역 (드래그)  -->
							<Border
								Grid.Row="0"
								Background="#5A9BD8"
								CornerRadius="8,8,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>

									<md:PackIcon
										Grid.Column="0"
										Width="20"
										Height="20"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="White"
										Kind="MapMarkerRadius" />

									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="14"
										FontWeight="Bold"
										Foreground="White"
										Text="{TemplateBinding PanelTitle}" />

									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Width="30"
										Height="30"
										Background="Transparent"
										BorderThickness="0"
										Cursor="Hand"
										Style="{StaticResource RoiButton}">
										<md:PackIcon
											Width="16"
											Height="16"
											Foreground="White"
											Kind="Close" />
									</Button>
								</Grid>
							</Border>

							<!--  콘텐츠 영역  -->
							<Grid Grid.Row="1" Margin="10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="70" />
								</Grid.ColumnDefinitions>

								<!--  리스트  -->
								<Border
									Grid.Column="0"
									Background="#5A9BD8"
									CornerRadius="5">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<Border
											Grid.Row="0"
											Margin="5,5,5,3"
											Padding="6,3"
											Background="#4A8BC8"
											CornerRadius="3">
											<TextBlock
												HorizontalAlignment="Center"
												FontSize="11"
												FontWeight="Bold"
												Foreground="White"
												Text="관심지역리스트" />
										</Border>

										<ListBox
											x:Name="PART_RoiListBox"
											Grid.Row="1"
											Margin="5,0,5,5"
											Background="Transparent"
											BorderThickness="0"
											Foreground="White"
											ItemsSource="{TemplateBinding RoiItems}"
											SelectedItem="{Binding SelectedRoi, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
											<ListBox.ItemTemplate>
												<DataTemplate>
													<Grid>
														<!--  표시 모드: TextBlock (더블클릭으로 편집 전환)  -->
														<TextBlock
															x:Name="TitleText"
															Padding="6,3"
															FontSize="11"
															Text="{Binding Title}" />
														<!--  편집 모드: TextBox (LostFocus/Enter로 확정)  -->
														<TextBox
															x:Name="TitleEdit"
															Padding="4,2"
															FontSize="11"
															Text="{Binding Title, UpdateSourceTrigger=Explicit}"
															Visibility="Collapsed" />
													</Grid>
												</DataTemplate>
											</ListBox.ItemTemplate>
										</ListBox>
									</Grid>
								</Border>

								<!--  버튼 영역  -->
								<StackPanel
									Grid.Column="1"
									Margin="5,0,0,0"
									VerticalAlignment="Top">
									<Button
										Command="{TemplateBinding MoveCommand}"
										Content="이동"
										Style="{StaticResource RoiButton}" />
									<Button
										Command="{TemplateBinding RegisterCommand}"
										Content="등록"
										Style="{StaticResource RoiButton}" />
									<Button
										Command="{TemplateBinding DeleteCommand}"
										Content="삭제"
										Style="{StaticResource RoiButton}" />
								</StackPanel>
							</Grid>

							<!--  하단 닫기 버튼  -->
							<Border Grid.Row="2" CornerRadius="0,0,8,8">
								<Button
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Command="{TemplateBinding CloseCommand}"
									Content="닫기"
									Style="{StaticResource RoiButton}" />
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
