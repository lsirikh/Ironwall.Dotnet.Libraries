<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Basic Geometric Marker Style  -->
	<Style x:Key="BaseGeometricMarkerStyle" TargetType="{x:Type control:GMapGeometricMarkerControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type control:GMapGeometricMarkerControl}">
					<!--  수직 배치: 아이콘 + 라벨  -->
					<Grid Name="PART_MainContainer" HorizontalAlignment="Center">

						<!--  아이콘 부분 (크기 조절됨)  -->
						<Viewbox
							Name="PART_ViewboxContainer"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							Stretch="Fill"
							ToolTip="{TemplateBinding MarkerTitle}">

							<Grid
								Name="PART_MarkerContainer"
								Width="30"
								Height="30"
								HorizontalAlignment="Center"
								VerticalAlignment="Center">

								<!--  Circle Shape  -->
								<Ellipse
									Name="PART_CircleShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Square Shape  -->
								<Rectangle
									Name="PART_SquareShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Triangle Shape  -->
								<Polygon
									Name="PART_TriangleShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Points="0.5,0 0,1 1,1"
									Stretch="Fill"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Diamond Shape  -->
								<Polygon
									Name="PART_DiamondShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Points="0.5,0 1,0.5 0.5,1 0,0.5"
									Stretch="Fill"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Pentagon Shape  -->
								<Polygon
									Name="PART_PentagonShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Points="0.5,0 0.975,0.375 0.794,0.975 0.206,0.975 0.025,0.375"
									Stretch="Fill"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Hexagon Shape  -->
								<Polygon
									Name="PART_HexagonShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Points="0.5,0 0.933,0.25 0.933,0.75 0.5,1 0.067,0.75 0.067,0.25"
									Stretch="Fill"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Star Shape  -->
								<Polygon
									Name="PART_StarShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Points="0.5,0 0.62,0.35 1,0.35 0.69,0.57 0.81,1 0.5,0.72 0.19,1 0.31,0.57 0,0.35 0.38,0.35"
									Stretch="Fill"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Arrow Shape  -->
								<Polygon
									Name="PART_ArrowShape"
									Fill="{TemplateBinding MarkerFill}"
									Opacity="{TemplateBinding MarkerOpacity}"
									Points="0.5,0 1,0.5 0.7,0.5 0.7,1 0.3,1 0.3,0.5 0,0.5"
									Stretch="Fill"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
									Visibility="Collapsed" />

								<!--  Center Point (Common UI Element)  -->
								<Ellipse
									Name="PART_CenterPoint"
									Width="6"
									Height="6"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Fill="White"
									Opacity="0.9" />

								<!--  Mouse Over Highlight (Common UI Element)  -->
								<Ellipse
									Name="PART_HoverHighlight"
									Width="10"
									Height="10"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Fill="White"
									Opacity="0" />
							</Grid>
						</Viewbox>

						<!--  Label Container - 아이콘 아래 자연스럽게 배치, 독립적 크기  -->
						<Border
							Name="PART_LabelContainer"
							MinWidth="40"
							MaxWidth="150"
							Margin="0,0,0,-25"
							Padding="2"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							Background="White"
							BorderBrush="Gray"
							BorderThickness="1"
							CornerRadius="4"
							Visibility="Collapsed">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="3"
									Opacity="0.3"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
							<TextBlock
								Name="PART_LabelText"
								FontSize="{TemplateBinding TitleSize}"
								FontWeight="SemiBold"
								Foreground="Black"
								Text="{TemplateBinding MarkerTitle}"
								TextAlignment="Center"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />
						</Border>
					</Grid>

					<ControlTemplate.Triggers>
						<!--  ShowShape=False일 때 아이콘만 숨김  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_ViewboxContainer" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
							<Setter TargetName="PART_LabelContainer" Property="Margin" Value="0,0,0,0" />
						</Trigger>

						<!--  Shape Type Display Control  -->
						<Trigger Property="ShapeType" Value="Circle">
							<Setter TargetName="PART_CircleShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Square">
							<Setter TargetName="PART_SquareShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Triangle">
							<Setter TargetName="PART_TriangleShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Diamond">
							<Setter TargetName="PART_DiamondShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Pentagon">
							<Setter TargetName="PART_PentagonShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Hexagon">
							<Setter TargetName="PART_HexagonShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Star">
							<Setter TargetName="PART_StarShape" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="ShapeType" Value="Arrow">
							<Setter TargetName="PART_ArrowShape" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  라벨 표시 조건  -->
						<Trigger Property="ShowTitle" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  IsSelected=True일 때 라벨 표시  -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  IsMouseOver=True일 때 라벨 표시 + 효과  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_HoverHighlight" Property="Opacity" Value="0.15" />
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />

							<!--  Mouse Over Effects for All Shapes  -->
							<Setter TargetName="PART_CircleShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_SquareShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_TriangleShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_DiamondShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_PentagonShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_HexagonShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_StarShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_ArrowShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
						</Trigger>

						<!--  ShowShape=False + 라벨만 표시일 때 스타일 조정  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="ShowShape" Value="False" />
								<Condition SourceName="PART_LabelContainer" Property="Visibility" Value="Visible" />
							</MultiTrigger.Conditions>
							<!--  라벨만 있을 때 다른 스타일 적용  -->
							<Setter TargetName="PART_LabelContainer" Property="Background" Value="LightBlue" />
							<Setter TargetName="PART_LabelContainer" Property="Padding" Value="6,3" />
						</MultiTrigger>

						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_CircleShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_SquareShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_TriangleShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_DiamondShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_PentagonShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_HexagonShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_StarShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_ArrowShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_LabelContainer" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="TitleSize" Value="9" />
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="Width" Value="30" />
		<Setter Property="Height" Value="30" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BaseGeometricMarkerStyle}" TargetType="{x:Type control:GMapGeometricMarkerControl}" />

</ResourceDictionary>