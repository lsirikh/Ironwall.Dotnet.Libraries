							<Setter TargetName="PART_Frame_Unknown_Sea" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
							<Setter TargetName="PART_Frame_Unknown_Subsurface" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="12"
										Opacity="0.7"
										ShadowDepth="6"
										Color="Black" />
								</Setter.Value>
							</Setter>
						</Trigger>

						<!--  ===============================================  -->
						<!--  === 기타 상태 (기존 유지) ===  -->
						<!--  ===============================================  -->

						<!--  === Disabled State ===  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_SymbolContainer" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_LabelContainer" Property="Opacity" Value="0.5" />
						</Trigger>

						<!--  === 미리보기 모드 ===  -->
						<Trigger Property="IsPreviewMode" Value="True">
							<Setter Property="IsHitTestVisible" Value="False" />
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Collapsed" />
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="TitleSize" Value="9" />
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="Width" Value="50" />
		<Setter Property="Height" Value="50" />
		<Setter Property="IsPreviewMode" Value="False" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BaseMilitaryMarkerStyle}" TargetType="{x:Type control:GMapMilitarySymbolMarkerControl}" />



</ResourceDictionary>