<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="BasePropertyStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!-- Image Overlay 마커 속성 편집 스타일 -->
	<Style BasedOn="{StaticResource BasePropertyStyle}" TargetType="{x:Type properties:GMapPropertyImageControl}">

		<Setter Property="HasSpecificProperties" Value="True" />
		<Setter Property="SpecificPropertiesTitle" Value="이미지 속성" />
		<Setter Property="MarkerSizeEnabled" Value="True" />

		<!-- Image 특화 UI -->
		<Setter Property="SpecificContent">
			<Setter.Value>
				<StackPanel>
					<!-- 파일 경로 -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="파일경로" />
						<TextBox
							Grid.Column="1"
							IsReadOnly="True"
							Text="{Binding ImageFilePath, Mode=OneWay}"
							ToolTip="{Binding ImageFilePath}"
							FontSize="10"
							Background="#2D2D30"
							Foreground="White"
							BorderBrush="#3F3F46"
							BorderThickness="1"
							Padding="4,2" />
					</Grid>

					<!-- 투명도 -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="35" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="투명도" />
						<Slider
							Grid.Column="1"
							Margin="5,0"
							VerticalAlignment="Center"
							Maximum="1.0"
							Minimum="0.0"
							TickFrequency="0.05"
							Value="{Binding ImageOpacity}" />
						<TextBlock
							Grid.Column="2"
							VerticalAlignment="Center"
							Foreground="White"
							Text="{Binding ImageOpacity, StringFormat='{}{0:P0}'}" />
					</Grid>

					<!-- 회전 각도 (기본 Bearing 사용) -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="35" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="회전" />
						<Slider
							Grid.Column="1"
							Margin="5,0"
							VerticalAlignment="Center"
							Maximum="360"
							Minimum="0"
							TickFrequency="5"
							Value="{Binding MarkerBearing}" />
						<TextBlock
							Grid.Column="2"
							VerticalAlignment="Center"
							Foreground="White"
							Text="{Binding MarkerBearing, StringFormat='{}{0:F0}°'}" />
					</Grid>

					<!-- 표시 여부 -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="표시" />
						<CheckBox
							Grid.Column="1"
							VerticalAlignment="Center"
							Content="이미지 표시"
							Foreground="White"
							IsChecked="{Binding ImageVisibility}" />
					</Grid>

					<!-- 가로세로비 유지 -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="비율유지" />
						<CheckBox
							Grid.Column="1"
							VerticalAlignment="Center"
							Content="가로세로비 유지"
							Foreground="White"
							IsChecked="{Binding MaintainAspectRatio}" />
					</Grid>

					<!-- 경계 좌표 정보 섹션 -->
					<Border
						Margin="0,10,0,0"
						Padding="8,4"
						Background="{StaticResource PrimaryBlueBrush}"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="White"
								Text="경계 좌표 정보" />

							<!-- 경도 범위 -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="50" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="경도" />
								<TextBlock
									Grid.Column="1"
									Foreground="White"
									FontSize="10">
									<Run Text="{Binding BoundLeft, StringFormat='{}{0:F4}°', Mode=OneWay}" />
									<Run Text=" ~ " />
									<Run Text="{Binding BoundRight, StringFormat='{}{0:F4}°', Mode=OneWay}" />
								</TextBlock>
							</Grid>

							<!-- 위도 범위 -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="50" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="위도" />
								<TextBlock
									Grid.Column="1"
									Foreground="White"
									FontSize="10">
									<Run Text="{Binding BoundBottom, StringFormat='{}{0:F4}°', Mode=OneWay}" />
									<Run Text=" ~ " />
									<Run Text="{Binding BoundTop, StringFormat='{}{0:F4}°', Mode=OneWay}" />
								</TextBlock>
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
