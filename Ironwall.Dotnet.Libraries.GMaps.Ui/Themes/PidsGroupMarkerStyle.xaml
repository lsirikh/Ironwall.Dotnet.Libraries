<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:enum="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  PidsGroup Marker Style (Line + PIDS Event 결합) — 3-레이어: Base + FaultOverlay + DetectionOverlay  -->
	<Style x:Key="BasePidsGroupMarkerStyle" TargetType="{x:Type control:GMapMarkerPidsGroupControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type control:GMapMarkerPidsGroupControl}">
					<Grid Name="PART_MainContainer">

						<!--  Line Canvas - 라인 그리기 영역  -->
						<Canvas
							Name="PART_LineCanvas"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							ClipToBounds="False">

							<!--  Layer 1: BasePolyline — 항상 표시 (기본 색상)  -->
							<Polyline
								Name="PART_MainPolyline"
								Fill="{TemplateBinding MarkerFill}"
								Opacity="{TemplateBinding LineOpacity}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
								Visibility="Visible" />

							<!--  Layer 2: FaultOverlay — Orange (Faulted / FaultedDetecting 시 표시)  -->
							<Polyline
								Name="PART_EventPolyline"
								Fill="{TemplateBinding MarkerFill}"
								Opacity="{TemplateBinding LineOpacity}"
								Stroke="#FF9800"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
								Visibility="Collapsed" />

							<!--  Layer 3: DetectionOverlay — Red blink (Detecting / FaultedDetecting 시 표시)  -->
							<Polyline
								Name="PART_DetectionPolyline"
								Fill="{TemplateBinding MarkerFill}"
								Opacity="{TemplateBinding LineOpacity}"
								Stroke="#F44336"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
								Visibility="Collapsed" />

						</Canvas>

						<!--  Event Status Indicator Badge  -->
						<Border
							Name="PART_EventStatusIndicator"
							Width="16"
							Height="16"
							Margin="0,-8,-8,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Background="#4CAF50"
							BorderBrush="White"
							BorderThickness="2"
							CornerRadius="8"
							Visibility="Collapsed">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="5"
									Opacity="0.7"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
						</Border>

						<!--  Title Label (옵션)  -->
						<Border
							Name="PART_TitleContainer"
							MinWidth="60"
							MaxWidth="200"
							Margin="0,0,0,-30"
							Padding="4,2"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							Background="White"
							BorderBrush="Gray"
							BorderThickness="1"
							CornerRadius="4"
							Visibility="Collapsed">
							<TextBlock
								Name="PART_TitleText"
								FontSize="{TemplateBinding TitleSize}"
								FontWeight="SemiBold"
								Foreground="Black"
								Text="{TemplateBinding MarkerTitle}"
								TextAlignment="Center"
								TextTrimming="CharacterEllipsis" />
						</Border>

						<!--  Selection Highlight  -->
						<Rectangle
							Name="PART_SelectionHighlight"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="Transparent"
							Opacity="0"
							Stroke="DodgerBlue"
							StrokeDashArray="3 3"
							StrokeThickness="2" />
					</Grid>

					<ControlTemplate.Triggers>
						<!--  Title 표시 트리거  -->
						<Trigger Property="ShowTitle" Value="True">
							<Setter TargetName="PART_TitleContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  선택 상태 트리거  -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_SelectionHighlight" Property="Opacity" Value="0.5" />
						</Trigger>

						<!--  Line Pattern Triggers  -->
						<Trigger Property="LinePattern" Value="{x:Static enum:EnumLinePattern.Dashed}">
							<Setter TargetName="PART_MainPolyline" Property="StrokeDashArray" Value="4 2" />
						</Trigger>
						<Trigger Property="LinePattern" Value="{x:Static enum:EnumLinePattern.Dotted}">
							<Setter TargetName="PART_MainPolyline" Property="StrokeDashArray" Value="1 2" />
						</Trigger>
						<Trigger Property="LinePattern" Value="{x:Static enum:EnumLinePattern.DashDot}">
							<Setter TargetName="PART_MainPolyline" Property="StrokeDashArray" Value="4 2 1 2" />
						</Trigger>

						<!--  OperationState 기반 Indicator 색상  -->
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.ACTIVATED}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#4CAF50" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.DEACTIVATED}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Black" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.NONE}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Gray" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.ERROR}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
						</Trigger>

						<!--  CompositeStatus Triggers (3-레이어 복합 상태)  -->
						<!--  DataTrigger → Trigger: CompositeStatus는 DP이므로 DataContext 바인딩 불가 → Trigger Property 사용  -->

						<!--  Normal: 오버레이 모두 숨김  -->
						<Trigger Property="CompositeStatus" Value="{x:Static enum:EnumCompositeEventStatus.Normal}">
							<Setter TargetName="PART_EventPolyline" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_DetectionPolyline" Property="Visibility" Value="Collapsed" />
						</Trigger>

						<!--  Detecting: DetectionOverlay(Red blink, 1000ms) 표시  -->
						<Trigger Property="CompositeStatus" Value="{x:Static enum:EnumCompositeEventStatus.Detecting}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#F44336" />
							<Setter TargetName="PART_EventPolyline" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_DetectionPolyline" Property="Visibility" Value="Visible" />
							<Trigger.EnterActions>
								<BeginStoryboard Name="BS_Detecting">
									<Storyboard RepeatBehavior="Forever">
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="PART_DetectionPolyline"
											Storyboard.TargetProperty="Opacity"
											Duration="0:0:1">
											<DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="BS_Detecting" />
							</Trigger.ExitActions>
						</Trigger>

						<!--  Faulted: FaultOverlay(Orange solid) 표시  -->
						<Trigger Property="CompositeStatus" Value="{x:Static enum:EnumCompositeEventStatus.Faulted}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
							<Setter TargetName="PART_EventPolyline" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_DetectionPolyline" Property="Visibility" Value="Collapsed" />
						</Trigger>

						<!--  FaultedDetecting: Red↔Orange 교차 깜빡임 (1000ms)  -->
						<Trigger Property="CompositeStatus" Value="{x:Static enum:EnumCompositeEventStatus.FaultedDetecting}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#F44336" />
							<Setter TargetName="PART_EventPolyline" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_DetectionPolyline" Property="Visibility" Value="Visible" />
							<Trigger.EnterActions>
								<BeginStoryboard Name="BS_FaultedDetecting">
									<Storyboard RepeatBehavior="Forever">
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="PART_DetectionPolyline"
											Storyboard.TargetProperty="Opacity"
											Duration="0:0:1">
											<DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
										</DoubleAnimationUsingKeyFrames>
										<DoubleAnimationUsingKeyFrames
											Storyboard.TargetName="PART_EventPolyline"
											Storyboard.TargetProperty="Opacity"
											Duration="0:0:1">
											<DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
											<DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="BS_FaultedDetecting" />
							</Trigger.ExitActions>
						</Trigger>

						<!--  Connection: 기존 유지  -->
						<Trigger Property="CompositeStatus" Value="{x:Static enum:EnumCompositeEventStatus.Connection}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#00BCD4" />
							<Setter TargetName="PART_EventPolyline" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_EventPolyline" Property="Stroke" Value="#00BCD4" />
							<Setter TargetName="PART_DetectionPolyline" Property="Visibility" Value="Collapsed" />
							<Trigger.EnterActions>
								<BeginStoryboard Name="BS_Conn">
									<Storyboard RepeatBehavior="Forever">
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_EventStatusIndicator"
											Storyboard.TargetProperty="Opacity"
											From="1"
											To="0.5"
											Duration="0:0:1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="BS_Conn" />
							</Trigger.ExitActions>
						</Trigger>

						<!--  Mouse Over Effect  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_MainPolyline" Property="StrokeThickness" Value="4" />
							<Setter TargetName="PART_EventStatusIndicator" Property="Width" Value="18" />
							<Setter TargetName="PART_EventStatusIndicator" Property="Height" Value="18" />
						</Trigger>

						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_MainContainer" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="Width" Value="Auto" />
		<Setter Property="Height" Value="Auto" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BasePidsGroupMarkerStyle}" TargetType="{x:Type control:GMapMarkerPidsGroupControl}" />

</ResourceDictionary>
