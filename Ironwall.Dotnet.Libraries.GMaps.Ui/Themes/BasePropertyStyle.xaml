<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<utils:ColorTypeToBrushConverter x:Key="ColorTypeToBrushConverter" />

	<Style x:Key="CompactTextBox" TargetType="TextBox">
		<Setter Property="Margin" Value="2" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="Background" Value="White" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style x:Key="CompactComboBox" TargetType="ComboBox">
		<Setter Property="Margin" Value="2" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style x:Key="PropertyLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="#555555" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>


	<!--  기본 속성 컨트롤 스타일  -->
	<Style x:Key="BasePropertyStyle" TargetType="{x:Type properties:GMapPropertyBaseControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type properties:GMapPropertyBaseControl}">
					<Border
						x:Name="PART_MainBorder"
						MinWidth="280"
						MaxWidth="300"
						Background="White"
						BorderBrush="{StaticResource BorderGrayBrush}"
						BorderThickness="1"
						CornerRadius="10">

						<!--  드롭 섀도우 효과  -->
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="8"
								Opacity="0.12"
								ShadowDepth="2"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="42" />
								<!--  헤더  -->
								<RowDefinition Height="*" />
								<!--  내용  -->
							</Grid.RowDefinitions>

							<!--  헤더 (드래그 영역)  -->
							<Border
								x:Name="PART_HeaderArea"
								Grid.Row="0"
								Background="{StaticResource PrimaryBlueBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>

									<!--  아이콘  -->
									<md:PackIcon
										Grid.Column="0"
										Width="18"
										Height="18"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="White"
										Kind="MapMarker" />

									<!--  제목  -->
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="14"
										FontWeight="Bold"
										Foreground="White"
										Text="마커 속성" />

									<!--  닫기 버튼  -->
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!--  스크롤 가능한 내용 영역  -->
							<ScrollViewer
								Grid.Row="1"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Auto">
								<!--  공통 속성 섹션  -->
								<StackPanel Margin="15">
									<!--  섹션 라벨  -->
									<TextBlock
										Margin="0,0,0,8"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{StaticResource PrimaryBlueBrush}"
										Text="BASIC" />

									<!--  제목  -->
									<Grid Margin="0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											VerticalAlignment="Center"
											Style="{StaticResource PropertyLabel}"
											Text="제목" />
										<TextBox
											Grid.Column="1"
											Style="{StaticResource CompactTextBox}"
											Text="{Binding MarkerTitle, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</Grid>

									<!--  제목크기  -->
									<Grid Margin="0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											VerticalAlignment="Center"
											Style="{StaticResource PropertyLabel}"
											Text="제목크기" />
										<TextBox
											Grid.Column="1"
											Style="{StaticResource CompactTextBox}"
											Text="{Binding TitleSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</Grid>

									<!--  크기  -->
									<Grid Margin="0,5" IsEnabled="{Binding MarkerSizeEnabled, RelativeSource={RelativeSource TemplatedParent}}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="50" />
											<ColumnDefinition Width="15" />
											<ColumnDefinition Width="50" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource PropertyLabel}"
											Text="크기" />
										<TextBox
											Grid.Column="1"
											Style="{StaticResource CompactTextBox}"
											Text="{Binding MarkerWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
										<md:PackIcon
											Grid.Column="2"
											Width="10"
											Height="10"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Foreground="#999999"
											Kind="WindowClose" />
										<TextBox
											Grid.Column="3"
											Style="{StaticResource CompactTextBox}"
											Text="{Binding MarkerHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									</Grid>

									<!--  회전  -->
									<Grid Margin="0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="80" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource PropertyLabel}"
											Text="회전" />
										<TextBox
											Grid.Column="1"
											Style="{StaticResource CompactTextBox}"
											Text="{Binding MarkerBearing, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
										<TextBlock
											Grid.Column="2"
											Margin="5,0,0,0"
											VerticalAlignment="Center"
											Foreground="#999999"
											Text="°" />
									</Grid>

									<!--  구분선  -->
									<Border
										Height="1"
										Margin="0,8"
										Background="{StaticResource BorderGrayBrush}" />

									<!--  색상 섹션 라벨  -->
									<TextBlock
										Margin="0,0,0,8"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{StaticResource PrimaryBlueBrush}"
										Text="COLOR" />

									<!--  색상  -->
									<Grid Margin="0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource PropertyLabel}"
											Text="채우기" />
										<ComboBox
											Grid.Column="1"
											ItemsSource="{Binding AvailableColors, RelativeSource={RelativeSource TemplatedParent}}"
											SelectedItem="{Binding MarkerFillColor, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource CompactComboBox}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal">
														<Rectangle
															Width="40"
															Height="12"
															Fill="{Binding Converter={StaticResource ColorTypeToBrushConverter}}"
															RadiusX="2"
															RadiusY="2"
															Stroke="{StaticResource BorderGrayBrush}"
															StrokeThickness="0.5" />
														<TextBlock
															Margin="10,0"
															FontSize="10"
															Text="{Binding}" />
													</StackPanel>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</Grid>

									<!--  선 색상  -->
									<Grid Margin="0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource PropertyLabel}"
											Text="테두리" />
										<ComboBox
											Grid.Column="1"
											ItemsSource="{Binding AvailableColors, RelativeSource={RelativeSource TemplatedParent}}"
											SelectedItem="{Binding MarkerStrokeColor, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource CompactComboBox}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<StackPanel Orientation="Horizontal">
														<Rectangle
															Width="40"
															Height="12"
															Fill="{Binding Converter={StaticResource ColorTypeToBrushConverter}}"
															RadiusX="2"
															RadiusY="2"
															Stroke="{StaticResource BorderGrayBrush}"
															StrokeThickness="0.5" />
														<TextBlock
															Margin="10,0"
															FontSize="10"
															Text="{Binding}" />
													</StackPanel>
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</Grid>

									<!--  선두께  -->
									<Grid Margin="0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="60" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Style="{StaticResource PropertyLabel}"
											Text="선두께" />
										<ComboBox
											Grid.Column="1"
											ItemsSource="{Binding AvailableSizes, RelativeSource={RelativeSource TemplatedParent}}"
											SelectedItem="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource CompactComboBox}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock HorizontalAlignment="Center" Text="{Binding}" />
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
									</Grid>

									<!--  구분선  -->
									<Border
										Height="1"
										Margin="0,8"
										Background="{StaticResource BorderGrayBrush}" />

									<!--  표시 옵션  -->
									<Grid Margin="0,5,0,5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<CheckBox
											Grid.Column="0"
											Content="모양"
											Foreground="#333333"
											IsChecked="{Binding ShowShape, RelativeSource={RelativeSource TemplatedParent}}" />

										<CheckBox
											Grid.Column="1"
											Content="제목"
											Foreground="#333333"
											IsChecked="{Binding ShowTitle, RelativeSource={RelativeSource TemplatedParent}}" />
									</Grid>

									<!--  특화 속성 영역 (ContentPresenter)  -->
									<Border
										x:Name="PART_SpecificPropertiesContainer"
										Margin="0,5,0,0"
										Visibility="{TemplateBinding HasSpecificProperties,
										                             Converter={StaticResource BooleanToVisibilityConverter}}">

										<!--  특화 속성 헤더  -->
										<StackPanel>
											<!--  구분선  -->
											<Border
												Height="1"
												Margin="0,0,0,8"
												Background="{StaticResource BorderGrayBrush}" />

											<TextBlock
												Margin="0,0,0,8"
												FontSize="13"
												FontWeight="Bold"
												Foreground="{StaticResource PrimaryBlueBrush}"
												Text="{TemplateBinding SpecificPropertiesTitle}" />

											<!--  특화 속성 내용  -->
											<ContentPresenter
												x:Name="PART_SpecificProperties"
												Content="{TemplateBinding SpecificContent}"
												DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
										</StackPanel>
									</Border>

								</StackPanel>
							</ScrollViewer>
						</Grid>
					</Border>

					<!--  드래그 불가능할 때 커서 변경  -->
					<ControlTemplate.Triggers>
						<Trigger Property="IsDraggable" Value="False">
							<Setter TargetName="PART_HeaderArea" Property="Cursor" Value="Arrow" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
