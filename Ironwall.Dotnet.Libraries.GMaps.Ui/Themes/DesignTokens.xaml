<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<!-- ═══════════════════ Converters ═══════════════════ -->
	<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

	<!-- ═══════════════════ Colors ═══════════════════ -->
	<Color x:Key="PrimaryBlue">#2C5F9E</Color>
	<Color x:Key="LightBlue">#EEF3FB</Color>
	<Color x:Key="SurfaceGray">Transparent</Color>
	<Color x:Key="PanelWhite">#FFFFFF</Color>
	<Color x:Key="BorderGray">#E8ECF1</Color>
	<Color x:Key="DangerRed">#C0392B</Color>

	<!-- ═══════════════════ Brushes ═══════════════════ -->
	<SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />
	<SolidColorBrush x:Key="LightBlueBrush" Color="{StaticResource LightBlue}" />
	<SolidColorBrush x:Key="SurfaceGrayBrush" Color="{StaticResource SurfaceGray}" />
	<SolidColorBrush x:Key="PanelWhiteBrush" Color="{StaticResource PanelWhite}" />
	<SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGray}" />
	<SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRed}" />

	<!-- 반투명 -->
	<SolidColorBrush
		x:Key="PrimaryBlueHoverBrush"
		Opacity="0.5"
		Color="{StaticResource PrimaryBlue}" />
	<SolidColorBrush
		x:Key="DangerRedLightBrush"
		Opacity="0.1"
		Color="{StaticResource DangerRed}" />

	<!-- ═══════════════════ 패널 헤더 닫기 버튼 ═══════════════════ -->
	<Style x:Key="PanelCloseButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="26" />
		<Setter Property="Height" Value="26" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Background="Transparent"
						CornerRadius="13">
						<md:PackIcon
							Width="14"
							Height="14"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="White"
							Kind="Close" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════ 패널 버튼 (Primary) ═══════════════════ -->
	<Style x:Key="PanelPrimaryButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Padding="10,7"
						Background="{TemplateBinding Background}"
						CornerRadius="5">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#245085" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════ 패널 버튼 (Secondary) ═══════════════════ -->
	<Style x:Key="PanelSecondaryButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{StaticResource LightBlueBrush}" />
		<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Padding="10,7"
						Background="{TemplateBinding Background}"
						BorderBrush="{StaticResource BorderGrayBrush}"
						BorderThickness="1"
						CornerRadius="5">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#DCE8F8" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════ 패널 버튼 (Danger) ═══════════════════ -->
	<Style x:Key="PanelDangerButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="#FFF5F5" />
		<Setter Property="Foreground" Value="{StaticResource DangerRedBrush}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Padding="10,7"
						Background="{TemplateBinding Background}"
						BorderBrush="#FFCDD2"
						BorderThickness="1"
						CornerRadius="5">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#FFEBEE" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════ 툴바 버튼 ═══════════════════ -->
	<Style x:Key="ToolbarButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="#555555" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Background="{TemplateBinding Background}"
						CornerRadius="6">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{StaticResource LightBlueBrush}" />
							<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
							<Setter Property="Foreground" Value="White" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════ 툴바 토글 버튼 (Active 상태) ═══════════════════ -->
	<Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="#555555" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border
						x:Name="Bd"
						Background="{TemplateBinding Background}"
						CornerRadius="6">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{StaticResource LightBlueBrush}" />
							<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
							<Setter Property="Foreground" Value="White" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════ 툴바 그룹 컨테이너 ═══════════════════ -->
	<Style x:Key="ToolbarGroupStyle" TargetType="Border">
		<Setter Property="Background" Value="{StaticResource SurfaceGrayBrush}" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="2" />
	</Style>

	<!-- ═══════════════════ 툴바 세퍼레이터 ═══════════════════ -->
	<Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
		<Setter Property="Width" Value="1" />
		<Setter Property="Height" Value="24" />
		<Setter Property="Background" Value="{StaticResource BorderGrayBrush}" />
		<Setter Property="Margin" Value="4,0" />
	</Style>

	<!-- ═══════════════════ 맵 위 플로팅 패널 공통 ═══════════════════ -->
	<Style x:Key="MapFloatingPanelStyle" TargetType="Border">
		<Setter Property="Background" Value="White" />
		<Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Padding" Value="8" />
		<Setter Property="Effect">
			<Setter.Value>
				<DropShadowEffect
					BlurRadius="8"
					Opacity="0.12"
					ShadowDepth="2"
					Color="Black" />
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
