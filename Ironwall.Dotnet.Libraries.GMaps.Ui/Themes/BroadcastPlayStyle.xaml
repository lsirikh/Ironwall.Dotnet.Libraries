<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<BooleanToVisibilityConverter x:Key="BroadcastBoolToVisibility" />

	<Style TargetType="{x:Type ctrl:BroadcastPlayControl}">
		<!--  지도 Canvas 의 소수 좌표(끌어 옮기기) — 1px 테두리 · 머리 띠 가장자리를 픽셀에 맞춘다(둥근 틀의 선 두께도 이 값을 따른다)  -->
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:BroadcastPlayControl}">
					<fb:FrameBorder
						Width="280"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="8"
								Opacity="0.12"
								ShadowDepth="2"
								Color="Black" />
						</Border.Effect>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="42" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  헤더  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="18"
										Height="18"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="VolumeHigh" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="음원 실행" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!--  바디  -->
							<StackPanel Grid.Row="1" Margin="16">
								<!--  음원 그룹 고르기(8.0.15 G25) — 목록을 받았을 때만 보인다. 고르면 아래 번호가 그 그룹으로 바뀐다  -->
								<Grid Margin="0,0,0,10" Visibility="{Binding HasFileGroupList, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BroadcastBoolToVisibility}}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="Medium"
										Foreground="{DynamicResource TextSecondaryBrush}"
										Text="음원 그룹" />
									<ComboBox
										x:Name="PART_FileGroupCombo"
										Grid.Column="1"
										Padding="6"
										AutomationProperties.Name="음원 그룹"
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										DisplayMemberPath="Display"
										FontSize="12"
										Foreground="{DynamicResource TextPrimaryBrush}"
										ItemsSource="{Binding FileGroups, RelativeSource={RelativeSource TemplatedParent}}"
										SelectedItem="{Binding SelectedFileGroup, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
								</Grid>
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="Medium"
										Foreground="{DynamicResource TextSecondaryBrush}"
										Text="그룹 번호" />
									<TextBox
										Grid.Column="1"
										Padding="6"
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										FontSize="12"
										Text="{Binding FileGroupId, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  목록 상태 한 줄(불러오는 중 · 볼 수 없음) — 비어 있으면 숨긴다  -->
								<TextBlock
									x:Name="PART_FileGroupStatus"
									Margin="90,0,0,10"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding FileGroupStatus, RelativeSource={RelativeSource TemplatedParent}}"
									TextWrapping="Wrap">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<Trigger Property="Text" Value="">
													<Setter Property="Visibility" Value="Collapsed" />
												</Trigger>
												<Trigger Property="Text" Value="{x:Null}">
													<Setter Property="Visibility" Value="Collapsed" />
												</Trigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<Grid Margin="0,0,0,10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="Medium"
										Foreground="{DynamicResource TextSecondaryBrush}"
										Text="반복 횟수" />
									<TextBox
										Grid.Column="1"
										Padding="6"
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										FontSize="12"
										Text="{Binding Repeat, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<!--  음량 0~100(0 허용 · 8.0.15 G36) — 끌어서 맞추고 숫자로도 넣는다  -->
								<Grid Margin="0,0,0,10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="90" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="44" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="Medium"
										Foreground="{DynamicResource TextSecondaryBrush}"
										Text="음량" />
									<Slider
										x:Name="PART_VolumeSlider"
										Grid.Column="1"
										Margin="0,0,6,0"
										VerticalAlignment="Center"
										AutomationProperties.Name="음량"
										IsSnapToTickEnabled="True"
										Maximum="100"
										Minimum="0"
										TickFrequency="1"
										Value="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
									<TextBox
										x:Name="PART_VolumeText"
										Grid.Column="2"
										Padding="4"
										AutomationProperties.Name="음량 값"
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource BorderBrush}"
										BorderThickness="1"
										FontSize="12"
										HorizontalContentAlignment="Center"
										Text="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
								</Grid>
								<Grid Margin="0 20 0 0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Margin="0,0,3,0"
										Command="{TemplateBinding SendCommand}"
										Content="전송"
										Style="{StaticResource PanelPrimaryButtonStyle}" />
									<Button
										Grid.Column="1"
										Margin="3,0,0,0"
										Command="{TemplateBinding CancelCommand}"
										Content="취소"
										Style="{StaticResource PanelSecondaryButtonStyle}" />
								</Grid>
							</StackPanel>
						</Grid>
					</fb:FrameBorder>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
