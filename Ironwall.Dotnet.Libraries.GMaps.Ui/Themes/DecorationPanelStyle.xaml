<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<!--  「꾸미기」 판(2026-10-21) — 「건물 만들기」 판(UserBuildingPanelStyle) 크롬 · 도구 단추 · 입력칸 답습:
	      FrameBorder(Surface · Border · 반지름 10 · 그림자) + PrimaryBrush 머리 띠 38(끌기) + [아이콘][제목][? 받침][✕].
	      색은 전부 DynamicResource 토큰(Tactical Command 라이트/다크). 쓰는 법은 판 "?"(화면엔 상태 · 행동만).  -->
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/UserBuildingPanelStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type ctrl:DecorationPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:DecorationPanelControl}">
					<fb:FrameBorder
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  머리 띠(끌기)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="PineTree" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{Binding DecorationTitle}"
										TextTrimming="CharacterEllipsis" />
									<!--  판 "?"(help-callout H-4) — 도구별 쓰는 법 · 값 · 옮기기 · 저장  -->
									<Border Grid.Column="1" Style="{StaticResource PanelHeaderHelpDisc}">
										<fb:HelpTip HelpKey="Map.Decoration.Panel" Scope="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</Border>
									<Button
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.Decoration.Close"
										AutomationProperties.Name="닫기(꾸미기 끝내기)"
										Command="{TemplateBinding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}"
										ToolTip="꾸미기 끝내기 (찍던 점은 버립니다)" />
								</Grid>
							</Border>

							<!--  바디 (DataContext = MapViewModel) — 판이 지도 아래로 넘치면 스크롤(높이는 HeightPanelControlBase 가 판 자리 아래 남은 높이로 줄인다, 2026-10-22)  -->
							<ScrollViewer
								Grid.Row="1"
								Padding="0,0,2,0"
								AutomationProperties.AutomationId="Map.Decoration.Scroll"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="14,12,14,14">
								<!--  옛 엔진 — 도구를 끄고 이유 한 줄  -->
								<TextBlock
									Margin="0,0,0,8"
									AutomationProperties.AutomationId="Map.Decoration.Unsupported"
									FontSize="11"
									Foreground="{DynamicResource StatusWarningBrush}"
									Text="{Binding DecorationUnsupportedText}"
									TextWrapping="Wrap"
									Visibility="{Binding IsDecorationUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<!--  도구 줄 — 고른 도구는 색만이 아니라 아래 굵은 막대(형태)로 표시. 같은 도구를 한 번 더 = 고르기로  -->
								<UniformGrid
									Margin="0,0,0,8"
									Columns="3"
									IsEnabled="{Binding IsDecorationToolsEnabled}">
									<Button
										AutomationProperties.AutomationId="Map.Decoration.Tool.TreePoint"
										AutomationProperties.Name="나무 한 그루"
										Command="{Binding SelectDecorationToolCommand}"
										CommandParameter="TreePoint"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="나무 한 그루 — 지도를 누르는 곳마다 심기">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="PineTree" />
											<TextBlock HorizontalAlignment="Center" Text="한 그루" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsDecorationToolTreePoint, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.Decoration.Tool.TreeLine"
										AutomationProperties.Name="나무 줄"
										Command="{Binding SelectDecorationToolCommand}"
										CommandParameter="TreeLine"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="나무 줄 — 선을 따라 간격마다 심기(Enter 로 마치기)">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="VectorLine" />
											<TextBlock HorizontalAlignment="Center" Text="나무 줄" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsDecorationToolTreeLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.Decoration.Tool.TreeArea"
										AutomationProperties.Name="나무 영역"
										Command="{Binding SelectDecorationToolCommand}"
										CommandParameter="TreeArea"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="나무 영역 — 영역을 그리면 밀도만큼 채우기(Enter 로 마치기)">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="Forest" />
											<TextBlock HorizontalAlignment="Center" Text="나무 영역" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsDecorationToolTreeArea, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.Decoration.Tool.Ground"
										AutomationProperties.Name="바닥"
										Command="{Binding SelectDecorationToolCommand}"
										CommandParameter="Ground"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="바닥 — 영역을 그려 잔디 · 아스팔트 · 물 등으로 덮기(Enter 로 마치기)">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="Texture" />
											<TextBlock HorizontalAlignment="Center" Text="바닥" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsDecorationToolGround, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.Decoration.Tool.Prop"
										AutomationProperties.Name="소품"
										Command="{Binding SelectDecorationToolCommand}"
										CommandParameter="Prop"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="소품 — 차 · 컨테이너 · 가로등 등을 누르는 곳에 놓기">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="Car" />
											<TextBlock HorizontalAlignment="Center" Text="소품" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsDecorationToolProp, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
									<Button
										AutomationProperties.AutomationId="Map.Decoration.Tool.Wall"
										AutomationProperties.Name="담장"
										Command="{Binding SelectDecorationToolCommand}"
										CommandParameter="Wall"
										Style="{StaticResource UserBuildingToolButton}"
										ToolTip="담장 — 선을 따라 담 · 철망 · 생울타리 세우기(Enter 로 마치기)">
										<StackPanel>
											<md:PackIcon HorizontalAlignment="Center" Kind="Fence" />
											<TextBlock HorizontalAlignment="Center" Text="담장" />
											<Border Style="{StaticResource UserBuildingToolBar}" Visibility="{Binding IsDecorationToolWall, Converter={StaticResource BooleanToVisibilityConverter}}" />
										</StackPanel>
									</Button>
								</UniformGrid>

								<TextBlock
									AutomationProperties.AutomationId="Map.Decoration.Status"
									FontSize="13"
									FontWeight="SemiBold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding DecorationStatusText}"
									TextWrapping="Wrap" />
								<TextBlock
									Margin="0,4,0,8"
									AutomationProperties.AutomationId="Map.Decoration.Count"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding DecorationCountText}"
									TextWrapping="Wrap" />
								<Button
									Margin="0,0,0,8"
									AutomationProperties.AutomationId="Map.Decoration.Finish"
									Command="{Binding FinishDecorationCommand}"
									Content="✓ 마치기"
									Style="{StaticResource PanelPrimaryButtonStyle}"
									ToolTip="찍은 점으로 저장 (Enter · 두 번 누르기)"
									Visibility="{Binding IsDecorationFinishVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<!--  값 칸 — 지금 도구(또는 고른 항목)의 종류만 보인다  -->
								<StackPanel Visibility="{Binding HasDecorationValues, Converter={StaticResource BooleanToVisibilityConverter}}">
									<Border
										Height="1"
										Margin="0,0,0,8"
										Background="{DynamicResource DividerBrush}" />
									<StackPanel Visibility="{Binding IsDecorationTreeValues, Converter={StaticResource BooleanToVisibilityConverter}}">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="나무 종류" />
										<ComboBox
											Margin="0,0,0,8"
											AutomationProperties.AutomationId="Map.Decoration.Species"
											AutomationProperties.Name="나무 종류"
											DisplayMemberPath="Value"
											ItemsSource="{Binding DecorationSpeciesList}"
											SelectedValue="{Binding DecorationSpecies, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Visibility="{Binding IsDecorationGroundValues, Converter={StaticResource BooleanToVisibilityConverter}}">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="바닥 종류" />
										<ComboBox
											Margin="0,0,0,8"
											AutomationProperties.AutomationId="Map.Decoration.Surface"
											AutomationProperties.Name="바닥 종류"
											DisplayMemberPath="Value"
											ItemsSource="{Binding DecorationSurfaces}"
											SelectedValue="{Binding DecorationSurface, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<StackPanel Visibility="{Binding IsDecorationPropValues, Converter={StaticResource BooleanToVisibilityConverter}}">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="소품 종류" />
										<ComboBox
											Margin="0,0,0,8"
											AutomationProperties.AutomationId="Map.Decoration.PropType"
											AutomationProperties.Name="소품 종류"
											DisplayMemberPath="Value"
											ItemsSource="{Binding DecorationPropTypes}"
											SelectedValue="{Binding DecorationPropType, Mode=TwoWay}"
											SelectedValuePath="Key" />
										<Grid Margin="0,0,0,8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="10" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<StackPanel Grid.Column="0">
												<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="방향 (°, 북 = 0)" />
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<Button
														Grid.Column="0"
														MinWidth="30"
														AutomationProperties.AutomationId="Map.Decoration.HeadingLeft"
														AutomationProperties.Name="왼쪽으로 15도"
														Command="{Binding StepDecorationHeadingCommand}"
														CommandParameter="-15"
														Content="↺"
														Style="{StaticResource BuildingHeightStepButton}"
														ToolTip="왼쪽으로 15° (↓ · Shift = 1°)" />
													<TextBox
														Grid.Column="1"
														AutomationProperties.AutomationId="Map.Decoration.Heading"
														AutomationProperties.Name="방향"
														Style="{StaticResource BuildingHeightInputBox}"
														Text="{Binding DecorationHeadingText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
													<Button
														Grid.Column="2"
														MinWidth="30"
														AutomationProperties.AutomationId="Map.Decoration.HeadingRight"
														AutomationProperties.Name="오른쪽으로 15도"
														Command="{Binding StepDecorationHeadingCommand}"
														CommandParameter="15"
														Content="↻"
														Style="{StaticResource BuildingHeightStepButton}"
														ToolTip="오른쪽으로 15° (↑ · Shift = 1°)" />
												</Grid>
											</StackPanel>
											<StackPanel Grid.Column="2">
												<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="크기 (배)" />
												<TextBox
													AutomationProperties.AutomationId="Map.Decoration.Scale"
													AutomationProperties.Name="크기"
													Style="{StaticResource BuildingHeightInputBox}"
													Text="{Binding DecorationScaleText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
											</StackPanel>
										</Grid>
									</StackPanel>
									<StackPanel Visibility="{Binding IsDecorationWallValues, Converter={StaticResource BooleanToVisibilityConverter}}">
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="담장 종류" />
										<ComboBox
											Margin="0,0,0,8"
											AutomationProperties.AutomationId="Map.Decoration.WallType"
											AutomationProperties.Name="담장 종류"
											DisplayMemberPath="Value"
											ItemsSource="{Binding DecorationWallTypes}"
											SelectedValue="{Binding DecorationWallType, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<Grid Margin="0,0,0,8">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="10" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0" Visibility="{Binding IsDecorationHeightVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
											<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="높이 (m)" />
											<TextBox
												AutomationProperties.AutomationId="Map.Decoration.Height"
												AutomationProperties.Name="높이"
												Style="{StaticResource BuildingHeightInputBox}"
												Text="{Binding DecorationHeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
										</StackPanel>
										<StackPanel Grid.Column="2" Visibility="{Binding IsDecorationSpacingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
											<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="간격 (m)" />
											<TextBox
												AutomationProperties.AutomationId="Map.Decoration.Spacing"
												AutomationProperties.Name="간격"
												Style="{StaticResource BuildingHeightInputBox}"
												Text="{Binding DecorationSpacingText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
										</StackPanel>
										<StackPanel Grid.Column="2" Visibility="{Binding IsDecorationDensityVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
											<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="밀도 (그루/100 m²)" />
											<TextBox
												AutomationProperties.AutomationId="Map.Decoration.Density"
												AutomationProperties.Name="밀도"
												Style="{StaticResource BuildingHeightInputBox}"
												Text="{Binding DecorationDensityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
										</StackPanel>
									</Grid>
									<StackPanel>
										<StackPanel.Style>
											<Style TargetType="StackPanel">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsDecorationGroundValues}" Value="True">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
													<DataTrigger Binding="{Binding IsDecorationWallValues}" Value="True">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</StackPanel.Style>
										<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="색" />
										<ComboBox
											Margin="0,0,0,8"
											AutomationProperties.AutomationId="Map.Decoration.Color"
											AutomationProperties.Name="색"
											DisplayMemberPath="Value"
											ItemsSource="{Binding DecorationColors}"
											SelectedValue="{Binding DecorationColor, Mode=TwoWay}"
											SelectedValuePath="Key" />
									</StackPanel>
									<TextBlock Style="{StaticResource BuildingHeightSectionLabel}" Text="이름 (선택)" />
									<TextBox
										Margin="2,2,2,4"
										HorizontalContentAlignment="Left"
										AutomationProperties.AutomationId="Map.Decoration.Name"
										AutomationProperties.Name="이름"
										MaxLength="60"
										Style="{StaticResource BuildingHeightInputBox}"
										Text="{Binding DecorationName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
								</StackPanel>

								<TextBlock
									Margin="2,6,2,0"
									AutomationProperties.AutomationId="Map.Decoration.Error"
									FontSize="11"
									Foreground="{DynamicResource StatusCriticalBrush}"
									Text="{Binding DecorationError}"
									TextWrapping="Wrap"
									Visibility="{Binding HasDecorationError, Converter={StaticResource BooleanToVisibilityConverter}}" />

								<ContentControl Template="{StaticResource Edit3DSectionTemplate}" />

								<Grid Margin="0,10,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="7" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="7" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="7" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Button
										Grid.Row="0"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.Decoration.Apply"
										Command="{Binding ApplyDecorationCommand}"
										Content="✓ 적용"
										Style="{StaticResource PanelPrimaryButtonStyle}"
										ToolTip="고른 항목의 값 · 이름 저장 — 3D 에 바로 보입니다" />
									<Button
										Grid.Row="0"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.Decoration.Replace"
										Command="{Binding ReplaceDecorationCommand}"
										Content="다시 놓기"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="고른 항목을 지도에 새로 찍은 자리로 옮기기" />
									<Button
										Grid.Row="2"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.Decoration.Delete"
										Command="{Binding DeleteDecorationCommand}"
										Content="지우기"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="고른 항목 지우기 (Delete · 되돌리기 가능)" />
									<Button
										Grid.Row="2"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.Decoration.ClearAll"
										Command="{Binding ClearDecorationsCommand}"
										Content="모두 지우기…"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="이 영역의 꾸미기 항목을 모두 지웁니다(확인 뒤)" />
									<Button
										Grid.Row="4"
										Grid.Column="0"
										AutomationProperties.AutomationId="Map.Decoration.Undo"
										Command="{Binding UndoDecorationCommand}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="방금 한 것을 거꾸로 (Ctrl+Z)">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="14"
												Height="14"
												VerticalAlignment="Center"
												Kind="Undo" />
											<TextBlock Margin="5,0,0,0" Text="되돌리기" />
										</StackPanel>
									</Button>
									<Button
										Grid.Row="4"
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.Decoration.Redo"
										Command="{Binding RedoDecorationCommand}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="되돌린 것을 다시 (Ctrl+Y)">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="14"
												Height="14"
												VerticalAlignment="Center"
												Kind="Redo" />
											<TextBlock Margin="5,0,0,0" Text="다시 하기" />
										</StackPanel>
									</Button>
								</Grid>

								<!--  목록 — 누르면 고르기(값 칸이 그 항목으로)  -->
								<Border
									Height="1"
									Margin="0,12,0,8"
									Background="{DynamicResource DividerBrush}" />
								<ListBox
									MaxHeight="150"
									AutomationProperties.AutomationId="Map.Decoration.List"
									AutomationProperties.Name="꾸미기 항목 목록"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									DisplayMemberPath="Text"
									Foreground="{DynamicResource TextPrimaryBrush}"
									ItemsSource="{Binding DecorationItems}"
									SelectedValue="{Binding DecorationSelectedUid, Mode=TwoWay}"
									SelectedValuePath="Uid">
									<!--  화면 읽기 · 자동화 이름 = 보이는 글(기본은 항목 record 의 ToString)  -->
									<ListBox.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
											<Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
										</Style>
									</ListBox.ItemContainerStyle>
								</ListBox>

								<!--  넣은 모델(2026-10-22 — Blender · Fusion 360 등에서 만든 GLB · OBJ · FBX). 자리 · 방향 · 크기는 3D 손잡이로, 이름 · 지우기는 여기서  -->
								<Border
									Height="1"
									Margin="0,12,0,8"
									Background="{DynamicResource DividerBrush}" />
								<Grid Margin="0,0,0,6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBlock
										VerticalAlignment="Center"
										AutomationProperties.AutomationId="Map.Model.Count"
										Style="{StaticResource BuildingHeightSectionLabel}"
										Text="{Binding ModelCountText}" />
									<Button
										Grid.Column="1"
										AutomationProperties.AutomationId="Map.Model.Add"
										AutomationProperties.Name="모델 넣기"
										Command="{Binding AddModelCommand}"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="GLB · OBJ · FBX 파일을 골라 이 영역에 넣기 (50 MB 까지)">
										<StackPanel Orientation="Horizontal">
											<md:PackIcon
												Width="14"
												Height="14"
												VerticalAlignment="Center"
												Kind="CubeOutline" />
											<TextBlock Margin="5,0,0,0" Text="모델 넣기…" />
										</StackPanel>
									</Button>
								</Grid>
								<TextBlock
									Margin="0,0,0,6"
									AutomationProperties.AutomationId="Map.Model.Status"
									FontSize="11"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="{Binding ModelStatusText}"
									TextWrapping="Wrap"
									Visibility="{Binding HasModelStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
								<ListBox
									MaxHeight="120"
									AutomationProperties.AutomationId="Map.Model.List"
									AutomationProperties.Name="넣은 모델 목록"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									DisplayMemberPath="Text"
									Foreground="{DynamicResource TextPrimaryBrush}"
									ItemsSource="{Binding ModelItems}"
									SelectedValue="{Binding ModelSelectedUid, Mode=TwoWay}"
									SelectedValuePath="Uid">
									<ListBox.ItemContainerStyle>
										<Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
											<Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
										</Style>
									</ListBox.ItemContainerStyle>
								</ListBox>
								<Grid Margin="0,6,0,0" Visibility="{Binding HasModelSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="7" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="7" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBox
										HorizontalContentAlignment="Left"
										AutomationProperties.AutomationId="Map.Model.Name"
										AutomationProperties.Name="모델 이름"
										MaxLength="60"
										Style="{StaticResource BuildingHeightInputBox}"
										Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
									<Button
										Grid.Column="2"
										AutomationProperties.AutomationId="Map.Model.Rename"
										Command="{Binding RenameModelCommand}"
										Content="이름 저장"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="고른 모델 이름 저장" />
									<Button
										Grid.Column="4"
										AutomationProperties.AutomationId="Map.Model.Delete"
										Command="{Binding DeleteModelCommand}"
										Content="지우기"
										Style="{StaticResource PanelSecondaryButtonStyle}"
										ToolTip="고른 모델 지우기 (되돌리기 가능)" />
								</Grid>
							</StackPanel>
							</ScrollViewer>
						</Grid>
					</fb:FrameBorder>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
