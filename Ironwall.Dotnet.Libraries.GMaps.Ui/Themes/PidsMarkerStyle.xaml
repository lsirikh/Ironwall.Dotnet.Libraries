							<!--  Controller Label (독립적 크기)  -->
							<Border
								Name="PART_ControllerLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_ControllerLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Multi Section ===  -->
						<Grid Name="PART_MultiSection" Visibility="Collapsed">
							<!--  Multi 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxMultiContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_MultiIconContainer"
									Width="40"
									Height="40">

									<!--  Multi Icon Content - 사각형 배경  -->
									<Border
										Background="{TemplateBinding MarkerFill}"
										BorderBrush="{TemplateBinding MarkerStroke}"
										BorderThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
										CornerRadius="4">
										<Border.Effect>
											<DropShadowEffect
												BlurRadius="8"
												Opacity="0.5"
												ShadowDepth="4"
												Color="Black" />
										</Border.Effect>

										<Grid>
											<!--  왼쪽 작은 검은 원  -->
											<Ellipse
												Width="10"
												Height="10"
												Margin="4,0,0,0"
												HorizontalAlignment="Left"
												VerticalAlignment="Center"
												Fill="Black"
												Stroke="{TemplateBinding MarkerStroke}"
												StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />

											<!--  오른쪽 큰 흰 원  -->
											<Ellipse
												Width="16"
												Height="16"
												Margin="0,0,4,0"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												Fill="White"
												Stroke="{TemplateBinding MarkerStroke}"
												StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>
									</Border>
								</Grid>
							</Viewbox>

