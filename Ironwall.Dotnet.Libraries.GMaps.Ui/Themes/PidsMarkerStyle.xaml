							<!--  SmartSensor Label (독립적 크기)  -->
							<Border
								Name="PART_SmartSensorLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_SmartSensorLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  Event Status Indicator (모든 타입 공통)  -->
						<Border
							Name="PART_EventStatusIndicator"
							Width="12"
							Height="12"
							Margin="0,-6,-6,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Background="#4CAF50"
							BorderBrush="White"
							BorderThickness="2"
							CornerRadius="6">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="4"
									Opacity="0.6"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
						</Border>

						<!--  Pulse Ripple Rings — Zero-size Canvas anchor at icon center  -->
						<!--  Width=0/Height=0 + HA/VA=Center: Canvas origin = outer Grid center = icon center  -->
						<!--  Canvas.Left/Top = -(EllipseSize/2) = -40: Ellipse center = Canvas origin = icon center  -->
						<!--  아이콘 크기(TemplateBinding Width/Height)와 무관하게 정확히 중앙 정렬됨  -->
						<Canvas
							Width="0"
							Height="0"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsHitTestVisible="False">
							<!--  Opacity + RenderTransform(ScaleTransform) 애니메이션은 WPF 컴포지션 레이어에서  -->
							<!--  BitmapCache 없이도 GPU 전담 처리됨. BitmapCache + ScaleTransform 조합은  -->
							<!--  스케일 변경 시 캐시 무효화 루프 발생 → Forever 반복과 결합 시 스턱 원인.  -->
							<Ellipse
								Name="PulseRing1"
								Canvas.Left="-40"
								Canvas.Top="-40"
								Width="80"
								Height="80"
								Fill="Transparent"
								Stroke="#CCFF0000"
								StrokeThickness="6"
								Opacity="0"
								RenderTransformOrigin="0.5,0.5">
								<Ellipse.RenderTransform>
									<ScaleTransform ScaleX="0.1" ScaleY="0.1" />
								</Ellipse.RenderTransform>
							</Ellipse>
							<Ellipse
								Name="PulseRing2"
								Canvas.Left="-40"
								Canvas.Top="-40"
								Width="80"
								Height="80"
								Fill="Transparent"
								Stroke="#CCFF0000"
								StrokeThickness="6"
								Opacity="0"
								RenderTransformOrigin="0.5,0.5">
								<Ellipse.RenderTransform>
									<ScaleTransform ScaleX="0.1" ScaleY="0.1" />
								</Ellipse.RenderTransform>
							</Ellipse>
							<Ellipse
								Name="PulseRing3"
								Canvas.Left="-40"
								Canvas.Top="-40"
								Width="80"
								Height="80"
								Fill="Transparent"
								Stroke="#CCFF0000"
								StrokeThickness="6"
								Opacity="0"
								RenderTransformOrigin="0.5,0.5">
								<Ellipse.RenderTransform>
									<ScaleTransform ScaleX="0.1" ScaleY="0.1" />
								</Ellipse.RenderTransform>
							</Ellipse>
						</Canvas>

						<!--  Mouse Over Highlight  -->
						<Ellipse
							Name="PART_HoverHighlight"
							Width="10"
							Height="10"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="White"
							Opacity="0" />
					</Grid>

					<ControlTemplate.Triggers>
						<!--  Device Type별 Section 표시  -->
						<Trigger Property="DeviceType" Value="Controller">
							<Setter TargetName="PART_ControllerSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="Multi">
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="Fence">
							<Setter TargetName="PART_FenceSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="IpCamera">
							<Setter TargetName="PART_CameraSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="IpSpeaker">
							<Setter TargetName="PART_SpeakerSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="SmartSensor">
							<Setter TargetName="PART_SmartSensorSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="SmartSensor2">
							<Setter TargetName="PART_SmartSensorSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="SmartCompound">
							<Setter TargetName="PART_SmartSensorSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="SmartMultisensor2">
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  Event Status Colors (Normal 기본값)  -->
						<Trigger Property="EventStatus" Value="Normal">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#4CAF50" />
						</Trigger>

						<!--  ACTIVATED → Viewbox Opacity 명시적 복원 (ERROR FillBehavior=Stop 이후 잔류값 방지)  -->
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.ACTIVATED}">
							<Setter TargetName="PART_ViewboxControllerContainer"  Property="Opacity" Value="1" />
							<Setter TargetName="PART_ViewboxSmartSensorContainer" Property="Opacity" Value="1" />
							<Setter TargetName="PART_ViewboxFenceContainer"        Property="Opacity" Value="1" />
							<Setter TargetName="PART_ViewboxMultiContainer"        Property="Opacity" Value="1" />
							<Setter TargetName="PART_ViewboxCameraContainer"       Property="Opacity" Value="1" />
							<Setter TargetName="PART_ViewboxSpeakerContainer"      Property="Opacity" Value="1" />
						</Trigger>

						<!--  OperationState 기반 Indicator 색상 (Normal 뒤, 이벤트 Trigger 앞 → 이벤트가 우선)  -->
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.DEACTIVATED}">
							<Setter TargetName="PART_EventStatusIndicator"      Property="Background" Value="Gray" />
							<Setter TargetName="PART_ControllerIconContainer"   Property="Opacity"    Value="0.3" />
							<Setter TargetName="PART_MultiIconContainer"         Property="Opacity"    Value="0.3" />
							<Setter TargetName="PART_FenceIconContainer"         Property="Opacity"    Value="0.3" />
							<Setter TargetName="PART_CameraIconContainer"        Property="Opacity"    Value="0.3" />
							<Setter TargetName="PART_SpeakerIconContainer"       Property="Opacity"    Value="0.3" />
							<Setter TargetName="PART_SmartSensorIconContainer"   Property="Opacity"    Value="0.3" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.NONE}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Gray" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.ERROR}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
							<Trigger.EnterActions>
								<BeginStoryboard Name="ErrorBlinkStoryboard_Begin">
									<Storyboard RepeatBehavior="Forever" FillBehavior="Stop">
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_ViewboxControllerContainer"
											Storyboard.TargetProperty="Opacity"
											From="1" To="0.3" Duration="0:0:0.3" />
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_ViewboxSmartSensorContainer"
											Storyboard.TargetProperty="Opacity"
											From="1" To="0.3" Duration="0:0:0.3" />
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_ViewboxFenceContainer"
											Storyboard.TargetProperty="Opacity"
											From="1" To="0.3" Duration="0:0:0.3" />
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_ViewboxMultiContainer"
											Storyboard.TargetProperty="Opacity"
											From="1" To="0.3" Duration="0:0:0.3" />
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_ViewboxCameraContainer"
											Storyboard.TargetProperty="Opacity"
											From="1" To="0.3" Duration="0:0:0.3" />
										<DoubleAnimation
											AutoReverse="True"
											Storyboard.TargetName="PART_ViewboxSpeakerContainer"
											Storyboard.TargetProperty="Opacity"
											From="1" To="0.3" Duration="0:0:0.3" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="ErrorBlinkStoryboard_Begin" />
							</Trigger.ExitActions>
						</Trigger>

						<!--  Fault: 표시등 색상만 변경, Viewbox 깜빡임 없음 (SSOT: 깜빡임은 MarkerState=ERROR만 담당)  -->
						<Trigger Property="EventStatus" Value="Fault">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
						</Trigger>
						<Trigger Property="EventStatus" Value="Connection">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#00BCD4" />
						</Trigger>

						<!--  스피커 방송 동작중 — 부드러운 Opacity 펄스 (Fault blink보다 느리고 부드럽게)  -->
						<Trigger Property="IsBroadcasting" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard Name="BroadcastingStoryboard_Begin">
									<Storyboard RepeatBehavior="Forever">
										<DoubleAnimation
											Storyboard.TargetName="PART_ViewboxSpeakerContainer"
											Storyboard.TargetProperty="Opacity"
											From="1.0"
											To="0.35"
											Duration="0:0:0.9"
											AutoReverse="True">
											<DoubleAnimation.EasingFunction>
												<SineEase EasingMode="EaseInOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="BroadcastingStoryboard_Begin" />
							</Trigger.ExitActions>
						</Trigger>

						<!--  라벨 표시 조건들 (각 타입별)  -->
