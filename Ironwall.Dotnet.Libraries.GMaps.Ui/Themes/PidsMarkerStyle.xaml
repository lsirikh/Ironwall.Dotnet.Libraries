								Name="PART_FOVCanvas"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								ClipToBounds="False"
								IsHitTestVisible="False">
								<Path
									Name="PART_FOVSector"
									Fill="{TemplateBinding FOVColor}"
									Opacity="{TemplateBinding FOVOpacity}"
									Visibility="{TemplateBinding ShowFOV,
									                             Converter={StaticResource BooleanToVisibilityConverter}}">
									<Path.Data>
										<PathGeometry>
											<PathFigure x:Name="PART_FOVFigure" StartPoint="0,0" IsClosed="True">
												<LineSegment x:Name="PART_FOVLine1" Point="0,0" />
												<ArcSegment
													x:Name="PART_FOVArc"
													IsLargeArc="False"
													Point="0,0"
													Size="0,0"
													SweepDirection="Clockwise" />
											</PathFigure>
										</PathGeometry>
									</Path.Data>
									<!--  Transform 추가  -->
									<Path.RenderTransform>
										<TranslateTransform x:Name="PART_FOVTransform" X="0" Y="0" />
									</Path.RenderTransform>
								</Path>

