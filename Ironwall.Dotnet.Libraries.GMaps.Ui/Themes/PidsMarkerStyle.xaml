							<!--  Fence Label (독립적 크기)  -->
							<Border
								Name="PART_FenceLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_FenceLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Camera Section ===  -->
						<Grid
							Name="PART_CameraSection"
							Panel.ZIndex="-2"
							Visibility="Collapsed">


							<!--  Camera 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxCameraContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_CameraIconContainer"
									Width="50"
									Height="30">
									<!--  카메라 본체 (브라켓 포함)  -->
									<Grid Name="PART_CameraBody">
										<!--  카메라 브라켓 (벽면 연결부)  -->
										<Rectangle
											Width="8"
											Height="25"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Fill="{TemplateBinding MarkerFill}"
											RadiusX="2"
											RadiusY="2"
											Stroke="{TemplateBinding MarkerStroke}"
											StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

										<!--  브라켓 조인트  -->
										<Ellipse
											Width="10"
											Height="10"
											Margin="8,0,0,0"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Fill="{TemplateBinding MarkerFill}"
											Stroke="{TemplateBinding MarkerStroke}"
											StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

										<!--  카메라 헤드 (메인 몸체)  -->
										<Border
											Width="35"
											Height="20"
											Margin="15,0,0,0"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Background="{TemplateBinding MarkerFill}"
											BorderBrush="{TemplateBinding MarkerStroke}"
											BorderThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
											CornerRadius="4">
											<!--<Border.Effect>
												<DropShadowEffect
													BlurRadius="8"
													Opacity="0.5"
													ShadowDepth="4"
													Color="Black" />
											</Border.Effect>-->

											<Grid>
												<!--  카메라 렌즈  -->
												<Ellipse
													Width="12"
													Height="12"
													Margin="0,0,3,0"
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													Fill="Black"
													Stroke="DarkGray"
													StrokeThickness="1" />

												<!--  렌즈 내부 반사  -->
												<Ellipse
													Width="8"
													Height="8"
													Margin="0,0,5,0"
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													Fill="DarkBlue"
													Opacity="0.7" />

												<!--  렌즈 하이라이트  -->
												<Ellipse
													Width="3"
													Height="3"
													Margin="0,0,7,-2"
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													Fill="White"
													Opacity="0.8" />

												<!--  상태 LED  -->
												<Ellipse
													Width="4"
													Height="4"
													Margin="5,3,0,0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													Fill="Lime" />

												<!--  브랜드 로고 영역  -->
												<Rectangle
													Width="8"
													Height="3"
													Margin="5,0,0,0"
													HorizontalAlignment="Left"
													VerticalAlignment="Center"
													Fill="White"
													Opacity="0.3" />
											</Grid>
										</Border>
									</Grid>
								</Grid>
							</Viewbox>

							<!--  FOV 부채꼴 영역 (ViewBox 밖, 독립적 크기)  -->
							<Canvas
								Name="PART_FOVCanvas"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								ClipToBounds="False"
								IsHitTestVisible="False">
								<Path
									Name="PART_FOVSector"
									Fill="{TemplateBinding FOVColor}"
									Opacity="{TemplateBinding FOVOpacity}"
									Visibility="{TemplateBinding ShowFOV,
									                             Converter={StaticResource BooleanToVisibilityConverter}}">
									<Path.Data>
										<PathGeometry>
											<PathFigure x:Name="PART_FOVFigure" StartPoint="0,0" IsClosed="True">
												<LineSegment x:Name="PART_FOVLine1" Point="0,0" />
												<ArcSegment
													x:Name="PART_FOVArc"
													IsLargeArc="False"
													Point="0,0"
													Size="0,0"
													SweepDirection="Clockwise" />
											</PathFigure>
										</PathGeometry>
									</Path.Data>
									<!--  Transform 추가  -->
									<Path.RenderTransform>
										<TranslateTransform x:Name="PART_FOVTransform" X="0" Y="0" />
									</Path.RenderTransform>
								</Path>

								<!--  중심점도 해당 위치에  -->
								<Ellipse
									Name="PART_FOVCenter"
									Canvas.Left="38"
									Canvas.Top="13"
									Width="4"
									Height="4"
									Fill="Black"
									Stroke="White"
									StrokeThickness="1" />
							</Canvas>

							<!--  Camera Label (독립적 크기)  -->
							<Border
								Name="PART_CameraLabelContainer"
								MinWidth="40"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_CameraLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Speaker Section ===  -->
						<Grid Name="PART_SpeakerSection" Visibility="Collapsed">
							<!--  Speaker 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxSpeakerContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Canvas
									Name="PART_SpeakerIconContainer"
									Width="256"
									Height="256">

									<!--  혼 스피커 SVG 기반 아이콘  -->

									<!--  메인 바디 (혼/배플)  -->
									<Path Fill="#BAD8F8" Data="M 176.22,19.64 C 157.66,43.73 127.31,71.71 86.91,87.03 L 39.66,99.95 C 19.29,105.96 6.97,125.76 8.07,145.31 C 9.43,170.68 30.83,188.73 51.24,188.46 C 61.43,188.33 70.13,185.42 76.99,183.74 L 98.31,178.62 C 132.36,170.76 169.14,171.66 206.76,183.15 L 220.22,185.98 L 223.85,186.25 L 231.97,183.74 L 241.89,172.08 L 248.19,147.13 L 247.92,124.98 L 243.76,100.02 L 235.41,72.4 L 222.42,44.78 L 206.23,20.46 L 195.68,13.41 L 187.49,12.12 L 181.82,13.71 Z" />

									<!--  스피커 콘 전면 (타원형)  -->
									<Path Data="M 247.99,136.11 C 247.99,169.19 237.41,186.91 224.39,186.91 C 203.41,186.91 183.11,157.07 170.97,116.18 C 166.02,99.08 166.02,87.48 166.02,63.49 C 166.02,38.11 173.62,12.31 189.06,12.31 C 212.45,12.31 238.72,53.78 246.68,102.74 C 247.88,111.45 247.99,124.68 247.99,136.11 Z">
										<Path.Fill>
											<LinearGradientBrush MappingMode="Absolute" StartPoint="166,99.6" EndPoint="248,99.6">
												<GradientStop Color="#76B0DF" Offset="0" />
												<GradientStop Color="#88BCE6" Offset="1" />
											</LinearGradientBrush>
										</Path.Fill>
									</Path>

									<!--  드라이버 섹션  -->
									<Path Data="M 203.74,81.61 L 167.08,84.65 C 169.32,101.14 172.81,117.91 180.86,136.85 L 212.83,123.15 L 216.73,118.39 L 220.43,108.81 L 218.97,97.86 L 211.72,85.13 Z">
										<Path.Fill>
											<LinearGradientBrush MappingMode="Absolute" StartPoint="193.8,81.6" EndPoint="193.8,136.8">
												<GradientStop Color="#113961" Offset="0" />
												<GradientStop Color="#1E4474" Offset="1" />
											</LinearGradientBrush>
										</Path.Fill>
									</Path>

									<!--  더스트 캡  -->
									<Path Data="M 219.99,107.11 C 219.99,117.47 215.41,123.43 209.72,123.43 C 201.42,123.43 194.94,110.06 194.94,97.78 C 194.94,87.42 198.81,81.61 204.5,81.61 C 212.81,81.61 219.99,94.83 219.99,107.11 Z">
										<Path.Fill>
											<LinearGradientBrush MappingMode="Absolute" StartPoint="194.9,102.5" EndPoint="220,102.5">
												<GradientStop Color="#395D82" Offset="0" />
												<GradientStop Color="#375A7F" Offset="1" />
											</LinearGradientBrush>
										</Path.Fill>
									</Path>

									<!--  뒷면 캐비닛  -->
									<Path Data="M 39.66,99.95 C 19.29,105.96 6.97,125.76 8.07,145.31 C 9.43,170.68 30.83,188.73 51.24,188.46 C 65.82,188.26 76.71,182.97 89.95,178.86 L 98.31,178.62 C 84.07,178.62 70.44,153.11 67.31,127.1 C 65.91,115.21 67.11,94.42 76.99,90.18 Z">
										<Path.Fill>
											<LinearGradientBrush MappingMode="Absolute" StartPoint="35.7,90.2" EndPoint="65,189.1">
												<GradientStop Color="#F75B4B" Offset="0" />
												<GradientStop Color="#F36151" Offset="1" />
											</LinearGradientBrush>
										</Path.Fill>
									</Path>

									<!--  핸들/커넥터  -->
									<Path Fill="#76B0DF" Data="M 104.78,221.69 L 87.61,182.12 C 84.44,174.74 76.57,171.48 69.86,174.91 L 69.52,175.08 C 62.81,178.51 60.04,187.47 63.72,195.12 L 75.68,218.81 L 80.02,236.35 C 84.49,244.16 93.66,246.28 100.37,241.4 C 107.08,236.52 107.95,229.07 104.78,221.69 Z" />

								</Canvas>
							</Viewbox>

							<!--  Speaker Label (독립적 크기)  -->
							<Border
								Name="PART_SpeakerLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_SpeakerLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === SmartSensor Section ===  -->
						<Grid Name="PART_SmartSensorSection" Visibility="Collapsed">
							<!--  SmartSensor 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxSmartSensorContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid Width="256" Height="256">
									<!--  배경 원형  -->
									<Ellipse
										Fill="#4CAF50"
										Stroke="#2E7D32"
										StrokeThickness="8" />
									<!--  SS 텍스트  -->
									<TextBlock
										FontSize="96"
										FontWeight="Bold"
										Foreground="White"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Text="SS" />
								</Grid>
							</Viewbox>

							<!--  SmartSensor Label (독립적 크기)  -->
							<Border
								Name="PART_SmartSensorLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_SmartSensorLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  Event Status Indicator (모든 타입 공통)  -->
						<Border
							Name="PART_EventStatusIndicator"
							Width="12"
							Height="12"
							Margin="0,-6,-6,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Background="#4CAF50"
							BorderBrush="White"
							BorderThickness="2"
							CornerRadius="6">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="4"
									Opacity="0.6"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
						</Border>

						<!--  Pulse Animation Element (Detecting 상태용)  -->
						<Ellipse
							Name="PulseEllipse"
							Width="10"
							Height="10"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="Red"
							Opacity="0"
							RenderTransformOrigin="0.5,0.5">
							<Ellipse.RenderTransform>
								<ScaleTransform x:Name="PulseScaleTransform" ScaleX="1" ScaleY="1" />
							</Ellipse.RenderTransform>
						</Ellipse>

						<!--  Mouse Over Highlight  -->
						<Ellipse
							Name="PART_HoverHighlight"
							Width="10"
							Height="10"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="White"
							Opacity="0" />
					</Grid>

					<ControlTemplate.Triggers>
						<!--  Device Type별 Section 표시  -->
						<Trigger Property="DeviceType" Value="Controller">
							<Setter TargetName="PART_ControllerSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="Multi">
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="Fence">
							<Setter TargetName="PART_FenceSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="IpCamera">
							<Setter TargetName="PART_CameraSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="IpSpeaker">
							<Setter TargetName="PART_SpeakerSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="SmartSensor">
							<Setter TargetName="PART_SmartSensorSection" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  Event Status Colors (Normal 기본값)  -->
						<Trigger Property="EventStatus" Value="Normal">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#4CAF50" />
						</Trigger>

						<!--  OperationState 기반 Indicator 색상 (Normal 뒤, 이벤트 Trigger 앞 → 이벤트가 우선)  -->
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.DEACTIVATED}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Black" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.NONE}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Gray" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.ERROR}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
						</Trigger>

						<!--  이벤트 발생 시 Indicator 색 덮어씀 (우선순위 최고)  -->
						<Trigger Property="EventStatus" Value="Detecting">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#F44336" />
						</Trigger>
						<Trigger Property="EventStatus" Value="Fault">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
						</Trigger>
						<Trigger Property="EventStatus" Value="Connection">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#00BCD4" />
						</Trigger>

						<!--  라벨 표시 조건들 (각 타입별)  -->
						<!--  Controller 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Controller" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_ControllerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Controller" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_ControllerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Controller" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_ControllerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Multi 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Multi" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Multi" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Multi" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Fence 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Fence" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_FenceLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Fence" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_FenceLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Fence" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_FenceLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Camera 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpCamera" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_CameraLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpCamera" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_CameraLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpCamera" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_CameraLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Speaker 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpSpeaker" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SpeakerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpSpeaker" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SpeakerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpSpeaker" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SpeakerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  SmartSensor 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartSensor" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartSensor" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartSensor" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Mouse Over Effects  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_HoverHighlight" Property="Opacity" Value="0.15" />
						</Trigger>

						<!--  ShowShape=False일 때 모든 아이콘 숨김  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_ControllerSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_FenceSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_CameraSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_SpeakerSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_SmartSensorSection" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
						</Trigger>


						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_ControllerSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_MultiSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_FenceSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_CameraSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_SpeakerSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_SmartSensorSection" Property="Opacity" Value="0.5" />
						</Trigger>

						<!--  Pulse Animation for Detecting State  -->
						<DataTrigger Binding="{Binding EventStatus}" Value="{x:Static enum:EnumEventStatus.Detecting}">
							<DataTrigger.EnterActions>
								<BeginStoryboard Name="PulseStoryboard_Begin">
									<Storyboard RepeatBehavior="Forever">
										<!--  Opacity Animation  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseEllipse"
											Storyboard.TargetProperty="Opacity"
											From="0.8"
											To="0"
											Duration="0:0:1" />
										<!--  Scale Animation  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseScaleTransform"
											Storyboard.TargetProperty="ScaleX"
											From="1"
											To="30"
											Duration="0:0:1" />
										<DoubleAnimation
											Storyboard.TargetName="PulseScaleTransform"
											Storyboard.TargetProperty="ScaleY"
											From="1"
											To="30"
											Duration="0:0:1" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<StopStoryboard BeginStoryboardName="PulseStoryboard_Begin" />
							</DataTrigger.ExitActions>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BasePidsMarkerStyle}" TargetType="{x:Type control:GMapMarkerPidsControl}" />

</ResourceDictionary>