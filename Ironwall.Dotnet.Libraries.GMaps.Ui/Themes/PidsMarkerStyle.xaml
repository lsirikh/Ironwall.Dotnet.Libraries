<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:enum="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  PIDS Device Marker Style  -->
	<Style x:Key="BasePidsMarkerStyle" TargetType="{x:Type control:GMapMarkerPidsControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type control:GMapMarkerPidsControl}">

					<!--  메인 컨테이너: 아이콘 + 라벨 수직 배치  -->
					<Grid Name="PART_MainContainer" HorizontalAlignment="Center">

						<!--  === Controller Section ===  -->
						<Grid Name="PART_ControllerSection" Visibility="Collapsed">
							<!--  Controller 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxControllerContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_ControllerIconContainer"
									Width="40"
									Height="40">
									<!--  Controller Icon Content  -->
									<Border
										Background="{TemplateBinding MarkerFill}"
										BorderBrush="{TemplateBinding MarkerStroke}"
										BorderThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
										CornerRadius="4">
										<Border.Effect>
											<DropShadowEffect
												BlurRadius="8"
												Opacity="0.5"
												ShadowDepth="4"
												Color="Black" />
										</Border.Effect>
										<TextBlock
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontSize="20"
											FontWeight="Bold"
											Foreground="White"
											Text="C" />
									</Border>
								</Grid>
							</Viewbox>

							<!--  Controller Label (독립적 크기)  -->
							<Border
								Name="PART_ControllerLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_ControllerLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Multi Section ===  -->
						<Grid Name="PART_MultiSection" Visibility="Collapsed">
							<!--  Multi 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxMultiContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_MultiIconContainer"
									Width="40"
									Height="40">

									<!--  Multi Icon Content - 사각형 배경  -->
									<Border
										Background="{TemplateBinding MarkerFill}"
										BorderBrush="{TemplateBinding MarkerStroke}"
										BorderThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
										CornerRadius="4">
										<Border.Effect>
											<DropShadowEffect
												BlurRadius="8"
												Opacity="0.5"
												ShadowDepth="4"
												Color="Black" />
										</Border.Effect>

										<Grid>
											<!--  왼쪽 작은 검은 원  -->
											<Ellipse
												Width="10"
												Height="10"
												Margin="4,0,0,0"
												HorizontalAlignment="Left"
												VerticalAlignment="Center"
												Fill="Black"
												Stroke="{TemplateBinding MarkerStroke}"
												StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />

											<!--  오른쪽 큰 흰 원  -->
											<Ellipse
												Width="16"
												Height="16"
												Margin="0,0,4,0"
												HorizontalAlignment="Right"
												VerticalAlignment="Center"
												Fill="White"
												Stroke="{TemplateBinding MarkerStroke}"
												StrokeThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>
									</Border>
								</Grid>
							</Viewbox>

							<!--  Multi Label (독립적 크기)  -->
							<Border
								Name="PART_MultiLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_MultiLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Fence/Sensor Section ===  -->
						<Grid Name="PART_FenceSection" Visibility="Collapsed">
							<!--  Fence/Sensor 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxFenceContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_FenceIconContainer"
									Width="40"
									Height="12">
									<!--  Fence Icon Content - 가로형 담장 디자인  -->
									<Border
										Background="{TemplateBinding MarkerFill}"
										BorderBrush="{TemplateBinding MarkerStroke}"
										BorderThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
										CornerRadius="2">
										<Border.Effect>
											<DropShadowEffect
												BlurRadius="8"
												Opacity="0.5"
												ShadowDepth="4"
												Color="Black" />
										</Border.Effect>

										<!--  벽돌 담장 패턴 (가로형)  -->
										<Grid Name="PART_FenceBrickGrid" Margin="1">
											<Grid.Resources>
												<SolidColorBrush x:Key="BrickBrush" Color="White" />
											</Grid.Resources>
											<Grid.RowDefinitions>
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>

											<!--  첫 번째 줄 벽돌  -->
											<StackPanel Grid.Row="0" Orientation="Horizontal">
												<Rectangle
													Width="10"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="12"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="8"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="6"
													Height="3"
													Fill="White" />
											</StackPanel>

											<!--  두 번째 줄 벽돌 (어긋난 패턴)  -->
											<StackPanel
												Grid.Row="1"
												Margin="0,0.5,0,0"
												Orientation="Horizontal">
												<Rectangle
													Width="6"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="11"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="9"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="9"
													Height="3"
													Fill="White" />
											</StackPanel>

											<!--  세 번째 줄 벽돌  -->
											<StackPanel
												Grid.Row="2"
												Margin="0,0.5,0,0"
												Orientation="Horizontal">
												<Rectangle
													Width="10"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="12"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="8"
													Height="3"
													Margin="0,0,0.5,0"
													Fill="White" />
												<Rectangle
													Width="6"
													Height="3"
													Fill="White" />
											</StackPanel>
										</Grid>
									</Border>
								</Grid>
							</Viewbox>

							<!--  Fence Label (독립적 크기)  -->
							<Border
								Name="PART_FenceLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_FenceLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Camera Section ===  -->
						<Grid
							Name="PART_CameraSection"
							Panel.ZIndex="-2"
							Visibility="Collapsed">


							<!--  Camera 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxCameraContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_CameraIconContainer"
									Width="50"
									Height="30">
									<!--  카메라 본체 (브라켓 포함)  -->
									<Grid Name="PART_CameraBody">
										<!--  카메라 브라켓 (벽면 연결부)  -->
										<Rectangle
											Width="8"
											Height="25"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Fill="{TemplateBinding MarkerFill}"
											RadiusX="2"
											RadiusY="2"
											Stroke="{TemplateBinding MarkerStroke}"
											StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

										<!--  브라켓 조인트  -->
										<Ellipse
											Width="10"
											Height="10"
											Margin="8,0,0,0"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Fill="{TemplateBinding MarkerFill}"
											Stroke="{TemplateBinding MarkerStroke}"
											StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

										<!--  카메라 헤드 (메인 몸체)  -->
										<Border
											Width="35"
											Height="20"
											Margin="15,0,0,0"
											HorizontalAlignment="Left"
											VerticalAlignment="Center"
											Background="{TemplateBinding MarkerFill}"
											BorderBrush="{TemplateBinding MarkerStroke}"
											BorderThickness="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}"
											CornerRadius="4">
											<!--<Border.Effect>
												<DropShadowEffect
													BlurRadius="8"
													Opacity="0.5"
													ShadowDepth="4"
													Color="Black" />
											</Border.Effect>-->

											<Grid>
												<!--  카메라 렌즈  -->
												<Ellipse
													Width="12"
													Height="12"
													Margin="0,0,3,0"
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													Fill="Black"
													Stroke="DarkGray"
													StrokeThickness="1" />

												<!--  렌즈 내부 반사  -->
												<Ellipse
													Width="8"
													Height="8"
													Margin="0,0,5,0"
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													Fill="DarkBlue"
													Opacity="0.7" />

												<!--  렌즈 하이라이트  -->
												<Ellipse
													Width="3"
													Height="3"
													Margin="0,0,7,-2"
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													Fill="White"
													Opacity="0.8" />

												<!--  상태 LED  -->
												<Ellipse
													Width="4"
													Height="4"
													Margin="5,3,0,0"
													HorizontalAlignment="Left"
													VerticalAlignment="Top"
													Fill="Lime" />

												<!--  브랜드 로고 영역  -->
												<Rectangle
													Width="8"
													Height="3"
													Margin="5,0,0,0"
													HorizontalAlignment="Left"
													VerticalAlignment="Center"
													Fill="White"
													Opacity="0.3" />
											</Grid>
										</Border>
									</Grid>
								</Grid>
							</Viewbox>

							<!--  FOV 부채꼴 영역 (ViewBox 밖, 독립적 크기)  -->
							<Canvas
								Name="PART_FOVCanvas"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								ClipToBounds="False"
								IsHitTestVisible="False">
								<Path
									Name="PART_FOVSector"
									Fill="{TemplateBinding FOVColor}"
									Opacity="{TemplateBinding FOVOpacity}"
									Visibility="{TemplateBinding ShowFOV,
									                             Converter={StaticResource BooleanToVisibilityConverter}}">
									<Path.Data>
										<PathGeometry>
											<PathFigure x:Name="PART_FOVFigure" StartPoint="0,0" IsClosed="True">
												<LineSegment x:Name="PART_FOVLine1" Point="0,0" />
												<ArcSegment
													x:Name="PART_FOVArc"
													IsLargeArc="False"
													Point="0,0"
													Size="0,0"
													SweepDirection="Clockwise" />
											</PathFigure>
										</PathGeometry>
									</Path.Data>
									<!--  Transform 추가  -->
									<Path.RenderTransform>
										<TranslateTransform x:Name="PART_FOVTransform" X="0" Y="0" />
									</Path.RenderTransform>
								</Path>

								<!--  중심점도 해당 위치에  -->
								<Ellipse
									Name="PART_FOVCenter"
									Canvas.Left="38"
									Canvas.Top="13"
									Width="4"
									Height="4"
									Fill="Black"
									Stroke="White"
									StrokeThickness="1" />
							</Canvas>

							<!--  Camera Label (독립적 크기)  -->
							<Border
								Name="PART_CameraLabelContainer"
								MinWidth="40"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_CameraLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  === Speaker Section ===  -->
						<Grid Name="PART_SpeakerSection" Visibility="Collapsed">
							<!--  Speaker 아이콘 (크기 조절됨)  -->
							<Viewbox
								Name="PART_ViewboxSpeakerContainer"
								Width="{TemplateBinding Width}"
								Height="{TemplateBinding Height}"
								Stretch="Fill"
								ToolTip="{TemplateBinding MarkerTitle}">

								<Grid
									Name="PART_SpeakerIconContainer"
									Width="40"
									Height="40">

									<!--  스피커 캐비닛 본체  -->
									<Rectangle
										Width="8"
										Height="22"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Fill="{TemplateBinding MarkerFill}"
										RadiusX="2"
										RadiusY="2"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

									<!--  스피커 드라이버 외부 서라운드  -->
									<Ellipse
										Width="26"
										Height="26"
										Margin="8,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Fill="{TemplateBinding MarkerFill}"
										Stroke="{TemplateBinding MarkerStroke}"
										StrokeThickness="{TemplateBinding MarkerStrokeThickness}">
										<Ellipse.Effect>
											<DropShadowEffect
												BlurRadius="6"
												Opacity="0.4"
												ShadowDepth="3"
												Color="Black" />
										</Ellipse.Effect>
									</Ellipse>

									<!--  드라이버 중간 서라운드  -->
									<Ellipse
										Width="18"
										Height="18"
										Margin="8,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Fill="DimGray"
										Opacity="0.85" />

									<!--  드라이버 콘  -->
									<Ellipse
										Width="10"
										Height="10"
										Margin="8,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Fill="#1A1A1A" />

									<!--  더스트 캡 (중심)  -->
									<Ellipse
										Width="4"
										Height="4"
										Margin="8,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Fill="White"
										Opacity="0.55" />

								</Grid>
							</Viewbox>

							<!--  Speaker Label (독립적 크기)  -->
							<Border
								Name="PART_SpeakerLabelContainer"
								MinWidth="20"
								MaxWidth="150"
								Margin="0,0,0,-25"
								Padding="2"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom"
								Background="White"
								BorderBrush="Gray"
								BorderThickness="1"
								CornerRadius="4"
								Visibility="Collapsed">
								<Border.Effect>
									<DropShadowEffect
										BlurRadius="3"
										Opacity="0.3"
										ShadowDepth="2"
										Color="Black" />
								</Border.Effect>
								<TextBlock
									Name="PART_SpeakerLabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />
							</Border>
						</Grid>

						<!--  Event Status Indicator (모든 타입 공통)  -->
						<Border
							Name="PART_EventStatusIndicator"
							Width="12"
							Height="12"
							Margin="0,-6,-6,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Background="#4CAF50"
							BorderBrush="White"
							BorderThickness="2"
							CornerRadius="6">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="4"
									Opacity="0.6"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
						</Border>

						<!--  Pulse Animation Element (Detecting 상태용)  -->
						<Ellipse
							Name="PulseEllipse"
							Width="10"
							Height="10"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="Red"
							Opacity="0"
							RenderTransformOrigin="0.5,0.5">
							<Ellipse.RenderTransform>
								<ScaleTransform x:Name="PulseScaleTransform" ScaleX="1" ScaleY="1" />
							</Ellipse.RenderTransform>
						</Ellipse>

						<!--  Mouse Over Highlight  -->
						<Ellipse
							Name="PART_HoverHighlight"
							Width="10"
							Height="10"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Fill="White"
							Opacity="0" />
					</Grid>

					<ControlTemplate.Triggers>
						<!--  Device Type별 Section 표시  -->
						<Trigger Property="DeviceType" Value="Controller">
							<Setter TargetName="PART_ControllerSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="Multi">
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="Fence">
							<Setter TargetName="PART_FenceSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="IpCamera">
							<Setter TargetName="PART_CameraSection" Property="Visibility" Value="Visible" />
						</Trigger>
						<Trigger Property="DeviceType" Value="IpSpeaker">
							<Setter TargetName="PART_SpeakerSection" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  Event Status Colors (Normal 기본값)  -->
						<Trigger Property="EventStatus" Value="Normal">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#4CAF50" />
						</Trigger>

						<!--  OperationState 기반 Indicator 색상 (Normal 뒤, 이벤트 Trigger 앞 → 이벤트가 우선)  -->
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.DEACTIVATED}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Black" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.NONE}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="Gray" />
						</Trigger>
						<Trigger Property="MarkerState" Value="{x:Static enum:EnumOperationState.ERROR}">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
						</Trigger>

						<!--  이벤트 발생 시 Indicator 색 덮어씀 (우선순위 최고)  -->
						<Trigger Property="EventStatus" Value="Detecting">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#F44336" />
						</Trigger>
						<Trigger Property="EventStatus" Value="Fault">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#FF9800" />
						</Trigger>
						<Trigger Property="EventStatus" Value="Connection">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#00BCD4" />
						</Trigger>

						<!--  라벨 표시 조건들 (각 타입별)  -->
						<!--  Controller 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Controller" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_ControllerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Controller" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_ControllerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Controller" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_ControllerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Multi 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Multi" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Multi" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Multi" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Fence 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Fence" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_FenceLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Fence" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_FenceLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="Fence" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_FenceLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Camera 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpCamera" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_CameraLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpCamera" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_CameraLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpCamera" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_CameraLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Speaker 라벨  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpSpeaker" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SpeakerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpSpeaker" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SpeakerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="IpSpeaker" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SpeakerLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Mouse Over Effects  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_HoverHighlight" Property="Opacity" Value="0.15" />
						</Trigger>

						<!--  ShowShape=False일 때 모든 아이콘 숨김  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_ControllerSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_FenceSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_CameraSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_SpeakerSection" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
						</Trigger>


						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_ControllerSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_MultiSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_FenceSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_CameraSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_SpeakerSection" Property="Opacity" Value="0.5" />
						</Trigger>

						<!--  Pulse Animation for Detecting State  -->
						<DataTrigger Binding="{Binding EventStatus}" Value="{x:Static enum:EnumEventStatus.Detecting}">
							<DataTrigger.EnterActions>
								<BeginStoryboard Name="PulseStoryboard_Begin">
									<Storyboard RepeatBehavior="Forever">
										<!--  Opacity Animation  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseEllipse"
											Storyboard.TargetProperty="Opacity"
											From="0.8"
											To="0"
											Duration="0:0:1" />
										<!--  Scale Animation  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseScaleTransform"
											Storyboard.TargetProperty="ScaleX"
											From="1"
											To="30"
											Duration="0:0:1" />
										<DoubleAnimation
											Storyboard.TargetName="PulseScaleTransform"
											Storyboard.TargetProperty="ScaleY"
											From="1"
											To="30"
											Duration="0:0:1" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<StopStoryboard BeginStoryboardName="PulseStoryboard_Begin" />
							</DataTrigger.ExitActions>
						</DataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BasePidsMarkerStyle}" TargetType="{x:Type control:GMapMarkerPidsControl}" />

</ResourceDictionary>