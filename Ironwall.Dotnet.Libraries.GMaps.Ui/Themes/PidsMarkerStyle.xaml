						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartSensor2" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartSensor2" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartSensor2" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartCompound" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartCompound" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartCompound" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_SmartSensorLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  SmartMultisensor2 라벨 (Multi 섹션 사용)  -->
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartMultisensor2" />
								<Condition Property="IsSelected" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartMultisensor2" />
								<Condition Property="ShowTitle" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="DeviceType" Value="SmartMultisensor2" />
								<Condition Property="IsMouseOver" Value="True" />
							</MultiTrigger.Conditions>
							<Setter TargetName="PART_MultiLabelContainer" Property="Visibility" Value="Visible" />
						</MultiTrigger>

						<!--  Mouse Over Effects  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_HoverHighlight" Property="Opacity" Value="0.15" />
						</Trigger>

						<!--  ShowShape=False일 때 모든 아이콘 숨김  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_ControllerSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_MultiSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_FenceSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_CameraSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_SpeakerSection" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_SmartSensorSection" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
						</Trigger>


						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_ControllerSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_MultiSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_FenceSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_CameraSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_SpeakerSection" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_SmartSensorSection" Property="Opacity" Value="0.5" />
						</Trigger>

						<!--  Detecting: Indicator 빨강 + Pulse Ripple Animation (3링 소나 패턴, 2s 주기)  -->
						<!--  단일 Trigger로 병합 — 중복 Trigger(같은 Property/Value)는 WPF가 두 번째를 무시함  -->
						<!--  ScaleTransform(Freezable)은 TargetName으로 찾기 불안정 → PropertyPath 방식으로 변경  -->
						<Trigger Property="EventStatus" Value="Detecting">
							<Setter TargetName="PART_EventStatusIndicator" Property="Background" Value="#F44336" />
							<Trigger.EnterActions>
								<BeginStoryboard Name="PulseStoryboard_Begin" HandoffBehavior="SnapshotAndReplace">
									<Storyboard RepeatBehavior="Forever">

										<!--  Ring 1: BeginTime=0s  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseRing1"
											Storyboard.TargetProperty="Opacity"
											From="0.9" To="0"
											Duration="0:0:1.2"
											BeginTime="0:0:0">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation
											Storyboard.TargetName="PulseRing1"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											From="0.1" To="1"
											Duration="0:0:1.2"
											BeginTime="0:0:0">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation
											Storyboard.TargetName="PulseRing1"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
											From="0.1" To="1"
											Duration="0:0:1.2"
											BeginTime="0:0:0">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<!--  Ring 2: BeginTime=0.4s  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseRing2"
											Storyboard.TargetProperty="Opacity"
											From="0.9" To="0"
											Duration="0:0:1.2"
											BeginTime="0:0:0.4">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation
											Storyboard.TargetName="PulseRing2"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											From="0.1" To="1"
											Duration="0:0:1.2"
											BeginTime="0:0:0.4">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation
											Storyboard.TargetName="PulseRing2"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
											From="0.1" To="1"
											Duration="0:0:1.2"
											BeginTime="0:0:0.4">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

										<!--  Ring 3: BeginTime=0.8s  -->
										<DoubleAnimation
											Storyboard.TargetName="PulseRing3"
											Storyboard.TargetProperty="Opacity"
											From="0.9" To="0"
											Duration="0:0:1.2"
											BeginTime="0:0:0.8">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation
											Storyboard.TargetName="PulseRing3"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
											From="0.1" To="1"
											Duration="0:0:1.2"
											BeginTime="0:0:0.8">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
										<DoubleAnimation
											Storyboard.TargetName="PulseRing3"
											Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
											From="0.1" To="1"
											Duration="0:0:1.2"
											BeginTime="0:0:0.8">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>

									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
							<Trigger.ExitActions>
								<StopStoryboard BeginStoryboardName="PulseStoryboard_Begin" />
							</Trigger.ExitActions>
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BasePidsMarkerStyle}" TargetType="{x:Type control:GMapMarkerPidsControl}" />

</ResourceDictionary>