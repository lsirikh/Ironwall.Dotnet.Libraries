<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type ctrl:MapScaleBarControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MapScaleBarControl}">
					<Border Style="{StaticResource MapFloatingPanelStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40" />
								<ColumnDefinition Width="100" />
							</Grid.ColumnDefinitions>
							<TextBlock
								Grid.Column="0"
								FontSize="11"
								FontWeight="Bold"
								Foreground="{StaticResource PrimaryBlueBrush}"
								Text="{TemplateBinding Scale}" />
							<Polyline
								Grid.Column="1"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Points="{TemplateBinding ScalePoints}"
								Stroke="{StaticResource PrimaryBlueBrush}"
								StrokeThickness="2" />
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
