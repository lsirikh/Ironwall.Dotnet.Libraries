<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="BasePropertyStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style BasedOn="{StaticResource BasePropertyStyle}" TargetType="{x:Type properties:GMapPropertyGeometricControl}">

		<Setter Property="HasSpecificProperties" Value="True" />
		<Setter Property="SpecificPropertiesTitle" Value="도형 속성" />

		<!--  Geometric 특화 UI  -->
		<Setter Property="SpecificContent">
			<Setter.Value>
				<StackPanel>
					<!--  도형 타입  -->
					<!--<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="모양" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding AvailableShapeTypes, RelativeSource={RelativeSource TemplatedParent}}"
							SelectedItem="{Binding ShapeType, RelativeSource={RelativeSource TemplatedParent}}"
							Style="{StaticResource CompactComboBox}" />
					</Grid>-->

					<!--  투명도  -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="60" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="30" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="투명도" />
						<Slider
							x:Name="OpacitySlider"
							Grid.Column="1"
							Maximum="1"
							Minimum="0"
							TickFrequency="0.1"
							Value ="{Binding MarkerOpacity, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type properties:GMapPropertyGeometricControl}}}"
							/>
						<TextBlock
							Grid.Column="2"
							Foreground="White"
							Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat='{}{0:P2}'}" />
					</Grid>
				</StackPanel>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>