<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type ctrl:TtsBroadcastControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:TtsBroadcastControl}">
					<Border
						Width="280"
						Background="White"
						BorderBrush="{StaticResource BorderGrayBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="8"
								Opacity="0.12"
								ShadowDepth="2"
								Color="Black" />
						</Border.Effect>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="42" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  헤더  -->
							<Border
								Grid.Row="0"
								Background="{StaticResource PrimaryBlueBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="18"
										Height="18"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="White"
										Kind="MessageText" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="White"
										Text="TTS 실행" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!--  바디  -->
							<StackPanel Grid.Row="1" Margin="16">
								<Grid Margin="0,0,0,10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="Medium"
										Foreground="#555555"
										Text="방송 메시지" />
									<TextBox
										Grid.Column="1"
										MaxLength="200"
										Padding="6"
										Background="#F9FAFB"
										BorderBrush="{StaticResource BorderGrayBrush}"
										BorderThickness="1"
										FontSize="12"
										Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
								</Grid>
								<Grid Margin="0 20 0 0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Margin="0,0,3,0"
										Command="{TemplateBinding SendCommand}"
										Content="전송"
										Style="{StaticResource PanelPrimaryButtonStyle}" />
									<Button
										Grid.Column="1"
										Margin="3,0,0,0"
										Command="{TemplateBinding CancelCommand}"
										Content="취소"
										Style="{StaticResource PanelSecondaryButtonStyle}" />
								</Grid>
							</StackPanel>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
