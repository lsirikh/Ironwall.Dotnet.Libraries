<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  줌 버튼 스타일  -->
	<Style x:Key="ZoomButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Background="Transparent"
						CornerRadius="6">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ctrl:MapZoomControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MapZoomControl}">
					<Border
						Width="250"
						Style="{StaticResource MapFloatingPanelStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="48" />
								<ColumnDefinition Width="32" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="32" />
							</Grid.ColumnDefinitions>

							<!--  줌 레벨 표시 — 0.5 래더 소수 표기("17"/"17.5"), 최상단 소프트 밴드는 "19.5+"/"19.5++"(주황)  -->
							<TextBlock
								x:Name="ZoomLabelText"
								AutomationProperties.AutomationId="GMaps.MapZoom.Label"
								Grid.Column="0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontFamily="Consolas"
								FontSize="14"
								FontWeight="Bold"
								Foreground="{DynamicResource PrimaryBrush}"
								Text="{Binding ZoomLabel, RelativeSource={RelativeSource TemplatedParent}}" />

							<!--  줌 아웃  -->
							<Button
								AutomationProperties.AutomationId="GMaps.MapZoom.ZoomOutButton"
								Grid.Column="1"
								Command="{TemplateBinding ZoomOutCommand}"
								Foreground="{DynamicResource PrimaryBrush}"
								Style="{StaticResource ZoomButtonStyle}">
								<md:PackIcon
									Width="18"
									Height="18"
									Kind="MagnifyMinus" />
							</Button>

							<!--  슬라이더: 실효줌 0.5 그리드 — Maximum=ExtendedMaxZoom(MaxZoom+0.5×TopSteps),
							      Value=SliderValue(=min(Zoom,Max)+0.5×dzl) 라우팅. 틱은 정수만 표시(과밀 방지),
							      스냅은 0.5 단위(zoom-float-halfstep FR-03).  -->
							<Slider
								AutomationProperties.AutomationId="GMaps.MapZoom.Slider"
								Grid.Column="2"
								Margin="4,0"
								VerticalAlignment="Center"
								IsSnapToTickEnabled="True"
								LargeChange="1"
								Maximum="{Binding ExtendedMaxZoom, RelativeSource={RelativeSource TemplatedParent}}"
								Minimum="{Binding MinZoom, RelativeSource={RelativeSource TemplatedParent}}"
								SmallChange="0.5"
								TickFrequency="0.5"
								TickPlacement="None"
								ToolTip="0.5 단위 줌 — 최상단 '+'/'++'는 소프트 확대(타일 없음) 구간"
								Value="{Binding SliderValue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

							<!--  줌 인  -->
							<Button
								AutomationProperties.AutomationId="GMaps.MapZoom.ZoomInButton"
								Grid.Column="3"
								Command="{TemplateBinding ZoomInCommand}"
								Foreground="{DynamicResource PrimaryBrush}"
								Style="{StaticResource ZoomButtonStyle}">
								<md:PackIcon
									Width="18"
									Height="18"
									Kind="MagnifyPlus" />
							</Button>
						</Grid>
					</Border>
						<ControlTemplate.Triggers>
							<!--  소프트 밴드(dzl≥2, "19.5+"/"19.5++")만 주황 — 하프스텝(x.5)은 정식 줌(FR-18, G-6=B)  -->
							<Trigger Property="IsSoftZoom" Value="True">
								<Setter TargetName="ZoomLabelText" Property="Foreground" Value="#E67E22" />
							</Trigger>
						</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
