<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  줌 버튼 스타일  -->
	<Style x:Key="ZoomButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Bd"
						Background="Transparent"
						CornerRadius="6">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{StaticResource LightBlueBrush}" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
							<Setter Property="Foreground" Value="White" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="{x:Type ctrl:MapZoomControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MapZoomControl}">
					<Border
						Width="250"
						Style="{StaticResource MapFloatingPanelStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40" />
								<ColumnDefinition Width="32" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="32" />
							</Grid.ColumnDefinitions>

							<!--  줌 레벨 표시  -->
							<TextBlock
								Grid.Column="0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontFamily="Consolas"
								FontSize="14"
								FontWeight="Bold"
								Foreground="{StaticResource PrimaryBlueBrush}"
								Text="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, StringFormat=F0}" />

							<!--  줌 아웃  -->
							<Button
								Grid.Column="1"
								Command="{TemplateBinding ZoomOutCommand}"
								Foreground="{StaticResource PrimaryBlueBrush}"
								Style="{StaticResource ZoomButtonStyle}">
								<md:PackIcon
									Width="18"
									Height="18"
									Kind="MagnifyMinus" />
							</Button>

							<!--  슬라이더 (정수 줌 레벨 스냅, 눈금=MaxZoom 추종)  -->
							<Slider
								Grid.Column="2"
								Margin="4,0"
								VerticalAlignment="Center"
								IsSnapToTickEnabled="True"
								Maximum="{Binding MaxZoom, RelativeSource={RelativeSource TemplatedParent}}"
								Minimum="{Binding MinZoom, RelativeSource={RelativeSource TemplatedParent}}"
								SmallChange="1"
								TickFrequency="1"
								TickPlacement="Both"
								Value="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

							<!--  줌 인  -->
							<Button
								Grid.Column="3"
								Command="{TemplateBinding ZoomInCommand}"
								Foreground="{StaticResource PrimaryBlueBrush}"
								Style="{StaticResource ZoomButtonStyle}">
								<md:PackIcon
									Width="18"
									Height="18"
									Kind="MagnifyPlus" />
							</Button>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
