<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:models="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Models"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type ctrl:MapRegistrationControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MapRegistrationControl}">
					<Border
						Width="320"
						Background="White"
						BorderBrush="{StaticResource BorderGrayBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="8"
								Opacity="0.12"
								ShadowDepth="2"
								Color="Black" />
						</Border.Effect>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="42" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!-- 헤더 -->
							<Border
								Grid.Row="0"
								Background="{StaticResource PrimaryBlueBrush}"
								CornerRadius="9,9,0,0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="18" Height="18"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="White"
										Kind="MapPlus" />
									<TextBlock
										Grid.Column="1"
										VerticalAlignment="Center"
										FontSize="13" FontWeight="SemiBold"
										Foreground="White"
										Text="오버레이 맵 등록" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!-- 바디 -->
							<Grid Grid.Row="1" Margin="16,12,16,16">

								<!-- ═══ Register Phase ═══ -->
								<StackPanel x:Name="RegisterContent" Visibility="Visible">
									<TextBlock Text="레이어명" FontSize="11" Foreground="#666" Margin="0,0,0,4" />
									<TextBox
										Text="{Binding LayerName, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										FontSize="12" Padding="6,4"
										md:HintAssist.Hint="레이어 이름 입력" />

									<TextBlock Text="파일 정보" FontSize="11" Foreground="#666" Margin="0,12,0,4" />
									<StackPanel Margin="4,0,0,0">
										<TextBlock FontSize="11">
											<Run Text="파일: " Foreground="#999" />
											<Run Text="{Binding FileName, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
										<TextBlock FontSize="11" Margin="0,2,0,0">
											<Run Text="크기: " Foreground="#999" />
											<Run Text="{Binding FileSize, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
										<TextBlock FontSize="11" Margin="0,2,0,0">
											<Run Text="해상도: " Foreground="#999" />
											<Run Text="{Binding ImageResolution, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
									</StackPanel>

									<TextBlock Text="줌 범위" FontSize="11" Foreground="#666" Margin="0,12,0,4" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock Text="최소" FontSize="10" Foreground="#999" Margin="0,0,0,2" />
											<TextBox
												Text="{Binding MinZoom, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												FontSize="12" Padding="6,4" TextAlignment="Center" />
										</StackPanel>
										<TextBlock Grid.Column="1" Text="~" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,6" />
										<StackPanel Grid.Column="2">
											<TextBlock Text="최대" FontSize="10" Foreground="#999" Margin="0,0,0,2" />
											<TextBox
												Text="{Binding MaxZoom, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												FontSize="12" Padding="6,4" TextAlignment="Center" />
										</StackPanel>
									</Grid>

									<Grid Margin="0,16,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="10" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Button
											x:Name="PART_CancelButton"
											Grid.Column="0"
											Content="취소"
											Style="{StaticResource PanelSecondaryButtonStyle}" />
										<Button
											x:Name="PART_RegisterButton"
											Grid.Column="2"
											Content="등록"
											Style="{StaticResource PanelPrimaryButtonStyle}" />
									</Grid>
								</StackPanel>

								<!-- ═══ Progress Phase ═══ -->
								<StackPanel x:Name="ProgressContent" Visibility="Collapsed">
									<TextBlock FontSize="12" FontWeight="Medium" Margin="0,0,0,8">
										<Run Text="{Binding LayerName, RelativeSource={RelativeSource TemplatedParent}}" />
									</TextBlock>

									<ProgressBar
										Height="18"
										Minimum="0" Maximum="100"
										Value="{Binding ProgressPercentage, RelativeSource={RelativeSource TemplatedParent}}"
										Foreground="{StaticResource PrimaryBlueBrush}" />
									<TextBlock
										HorizontalAlignment="Right"
										FontSize="11" Foreground="#666" Margin="0,2,0,8">
										<Run Text="{Binding ProgressPercentage, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:F0}%'}" />
									</TextBlock>

									<StackPanel Margin="4,0,0,0">
										<TextBlock FontSize="11">
											<Run Text="줌 레벨: " Foreground="#999" />
											<Run Text="{Binding CurrentZoom, RelativeSource={RelativeSource TemplatedParent}}" />
											<Run Text=" / " Foreground="#999" />
											<Run Text="{Binding MaxZoom, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
										<TextBlock FontSize="11" Margin="0,2,0,0">
											<Run Text="타일: " Foreground="#999" />
											<Run Text="{Binding ProcessedTiles, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}'}" />
											<Run Text=" / " Foreground="#999" />
											<Run Text="{Binding TotalTiles, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0}'}" />
										</TextBlock>
										<TextBlock FontSize="11" Margin="0,2,0,0">
											<Run Text="경과: " Foreground="#999" />
											<Run Text="{Binding ElapsedTime, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
									</StackPanel>

									<Button
										x:Name="PART_ProgressCancelButton"
										Margin="0,12,0,0"
										Content="취소"
										Style="{StaticResource PanelDangerButtonStyle}" />
								</StackPanel>

								<!-- ═══ Complete Phase ═══ -->
								<StackPanel x:Name="CompleteContent" Visibility="Collapsed"
											HorizontalAlignment="Center">
									<md:PackIcon
										Width="36" Height="36"
										HorizontalAlignment="Center"
										Foreground="#27AE60"
										Kind="CheckCircle" Margin="0,8,0,8" />
									<TextBlock
										Text="등록 완료"
										FontSize="14" FontWeight="SemiBold"
										HorizontalAlignment="Center" Margin="0,0,0,8" />
									<StackPanel Margin="4,0,0,0">
										<TextBlock FontSize="11">
											<Run Text="레이어명: " Foreground="#999" />
											<Run Text="{Binding LayerName, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
										<TextBlock FontSize="11" Margin="0,2,0,0">
											<Run Text="총 타일: " Foreground="#999" />
											<Run Text="{Binding TotalTiles, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
										<TextBlock FontSize="11" Margin="0,2,0,0">
											<Run Text="소요 시간: " Foreground="#999" />
											<Run Text="{Binding ElapsedTime, RelativeSource={RelativeSource TemplatedParent}}" />
										</TextBlock>
									</StackPanel>
									<Button
										x:Name="PART_CompleteCloseButton"
										Margin="0,12,0,0"
										Content="확인"
										Style="{StaticResource PanelPrimaryButtonStyle}" />
								</StackPanel>

								<!-- ═══ Error Phase ═══ -->
								<StackPanel x:Name="ErrorContent" Visibility="Collapsed"
											HorizontalAlignment="Center">
									<md:PackIcon
										Width="36" Height="36"
										HorizontalAlignment="Center"
										Foreground="{StaticResource DangerRedBrush}"
										Kind="AlertCircle" Margin="0,8,0,8" />
									<TextBlock
										Text="등록 실패"
										FontSize="14" FontWeight="SemiBold"
										Foreground="{StaticResource DangerRedBrush}"
										HorizontalAlignment="Center" Margin="0,0,0,8" />
									<TextBlock
										Text="{Binding ErrorMessage, RelativeSource={RelativeSource TemplatedParent}}"
										FontSize="11" Foreground="#666"
										TextWrapping="Wrap" Margin="0,0,0,12" />
									<Button
										x:Name="PART_ErrorCloseButton"
										Content="닫기"
										Style="{StaticResource PanelSecondaryButtonStyle}" />
								</StackPanel>
							</Grid>
						</Grid>
					</Border>

					<!-- Phase에 따른 Visibility 전환 -->
					<ControlTemplate.Triggers>
						<Trigger Property="Phase" Value="Register">
							<Setter TargetName="RegisterContent" Property="Visibility" Value="Visible" />
							<Setter TargetName="ProgressContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="CompleteContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ErrorContent" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Phase" Value="Progress">
							<Setter TargetName="RegisterContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ProgressContent" Property="Visibility" Value="Visible" />
							<Setter TargetName="CompleteContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ErrorContent" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Phase" Value="Complete">
							<Setter TargetName="RegisterContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ProgressContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="CompleteContent" Property="Visibility" Value="Visible" />
							<Setter TargetName="ErrorContent" Property="Visibility" Value="Collapsed" />
						</Trigger>
						<Trigger Property="Phase" Value="Error">
							<Setter TargetName="RegisterContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ProgressContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="CompleteContent" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="ErrorContent" Property="Visibility" Value="Visible" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
