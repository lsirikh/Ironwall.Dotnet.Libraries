<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:help="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="BasePropertyStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<utils:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter" />
	<utils:EnumToCollectionConverter x:Key="EnumToCollectionConverter" />
	<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

	<Style BasedOn="{StaticResource BasePropertyStyle}" TargetType="{x:Type properties:GMapPropertyPidsGroupControl}">

		<Setter Property="HasSpecificProperties" Value="True" />
		<Setter Property="SpecificPropertiesTitle" Value="PIDS 그룹 속성" />


		<!--  요약(기둥 N개 · 실간격 / 센서 N개 · 잔여)은 특화 절 첫 줄에  -->

		<!--  PidsGroup 특화 UI  -->
		<Setter Property="SpecificContent">
			<Setter.Value>
				<StackPanel>
					<!--  기본 정보 섹션 (Line 속성)  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,4"
						Background="{DynamicResource PrimaryBrush}"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Text="라인 정보" />

							<!--  포인트 개수 (읽기 전용)  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="포인트 수" />
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding PointCount, StringFormat='{}{0}개'}" />
							</Grid>

							<!--  총 거리 (읽기 전용)  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="총 거리" />
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding TotalDistance, StringFormat='{}{0:F2}m'}" />
							</Grid>
						</StackPanel>
					</Border>

					<!--  라인 스타일 섹션  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,4"
						Background="{DynamicResource PrimaryBrush}"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Text="라인 스타일" />

							<!--  라인 패턴  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="패턴" />
								<ComboBox
									Grid.Column="1"
									ItemsSource="{Binding Source={x:Type enums:EnumLinePattern}, Converter={StaticResource EnumToCollectionConverter}}"
									SelectedItem="{Binding LinePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource CompactComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</Grid>

							<!--  라인 투명도  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="투명도" />
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<Slider
										Width="100"
										Maximum="1"
										Minimum="0"
										TickFrequency="0.1"
										Value="{Binding LineOpacity, Mode=TwoWay}" />
									<TextBlock
										Margin="5,0,0,0"
                                        Foreground="{DynamicResource OnPrimaryFixedBrush}"
										VerticalAlignment="Center"
										Text="{Binding LineOpacity, StringFormat='{}{0:P0}'}" />
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>


					<!--  PIDS 그룹 설정  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,4"
						Background="{DynamicResource PrimaryBrush}"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Text="PIDS 그룹 설정" />

							<!--  연결된 디바이스 그룹  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="장비 그룹" />
								<ComboBox
									Grid.Column="1"
									ItemsSource="{Binding FilteredDeviceGroupList}"
									DisplayMemberPath="Name"
									SelectedValuePath="Id"
									SelectedValue="{Binding LinkedDeviceGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource CompactComboBox}" />
							</Grid>
						</StackPanel>
					</Border>



					<!--  3D 철망(마커 속성 맨 밑 — 사용자 지시 2026-09-08 "단계별 순서": 형태 · 3D 표시 · 간격(프리셋) · 높이 · 요약)  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,6"
						Background="{DynamicResource SurfaceAltBrush}"
						BorderBrush="{DynamicResource PrimaryBrush}"
						BorderThickness="1"
						CornerRadius="6"
						AutomationProperties.AutomationId="GMaps.Property.FenceSection">
						<Border.Style>
							<Style TargetType="Border">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Is3DFeatureEnabled}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
									<DataTrigger Binding="{Binding IsGroupEditing}" Value="True">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="44" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<!--  헤더: 제목 · 형태 콤보 · 3D 표시  -->
							<TextBlock
								Grid.Row="0"
								Grid.Column="0"
								VerticalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="{DynamicResource PrimaryBrush}"
								Text="3D 철망" />
							<ComboBox
								Grid.Row="0"
								Grid.Column="1"
								Margin="4,0,4,0"
								ItemsSource="{Binding Source={x:Type enums:EnumFenceMode}, Converter={StaticResource EnumToCollectionConverter}}"
								SelectedItem="{Binding FenceMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								Style="{StaticResource CompactComboBox}"
								AutomationProperties.AutomationId="GMaps.Property.FenceMode">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<!--  3D 철망 "?"(help-callout H-4) — 형태(기둥 간격 · 센서 장착)의 뜻 · 슬라이더 저장 시점  -->
							<StackPanel
								Grid.Row="0"
								Grid.Column="2"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<CheckBox
									VerticalAlignment="Center"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Content="3D"
									IsChecked="{Binding Render3D, Mode=TwoWay}"
									ToolTip="3D 철망 표시"
									AutomationProperties.AutomationId="GMaps.Property.Render3D" />
								<help:HelpTip Margin="4,0,0,0" HelpKey="Map.Property.Fence" />
							</StackPanel>

							<!--  간격 (D1 슬라이더 · 0.5 m 스냅 · 150 ms 지연 커밋)  -->
							<TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Margin="0,6,0,0"
								VerticalAlignment="Center"
								FontSize="11"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="간격" />
							<Slider
								Grid.Row="1"
								Grid.Column="1"
								Margin="4,6,4,0"
								VerticalAlignment="Center"
								Minimum="1"
								Maximum="10"
								TickFrequency="0.5"
								IsSnapToTickEnabled="True"
								Value="{Binding PostSpacingM, Mode=TwoWay}"
								ToolTip="기둥(또는 센서) 간격 1~10 m (0.5 m 단위)"
								AutomationProperties.AutomationId="GMaps.Property.PostSpacing" />
							<StackPanel
								Grid.Row="1"
								Grid.Column="2"
								Margin="0,6,0,0"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<TextBlock
									MinWidth="34"
									VerticalAlignment="Center"
									FontSize="11"
									FontWeight="Bold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding PostSpacingM, StringFormat='{}{0:0.0} m'}" />
								<TextBlock
									Margin="2,0,0,0"
									VerticalAlignment="Center"
									FontSize="9"
									Foreground="{DynamicResource TextMutedBrush}"
									Text="기본"
									Visibility="{Binding IsPostSpacingInherited, Converter={StaticResource BooleanToVisibilityConverter}}" />
							</StackPanel>

							<!--  프리셋 2/3/5 · 기본  -->
							<StackPanel
								Grid.Row="2"
								Grid.Column="1"
								Grid.ColumnSpan="2"
								Margin="4,3,0,0"
								Orientation="Horizontal">
								<Button Height="22" MinHeight="22" MinWidth="0" Content="2 m" Padding="6,0" Margin="0,0,4,0" FontSize="10" Command="{Binding SetPostSpacingPresetCommand}" CommandParameter="2" AutomationProperties.AutomationId="GMaps.Property.PostSpacingPreset2" />
								<Button Height="22" MinHeight="22" MinWidth="0" Content="3 m" Padding="6,0" Margin="0,0,4,0" FontSize="10" Command="{Binding SetPostSpacingPresetCommand}" CommandParameter="3" AutomationProperties.AutomationId="GMaps.Property.PostSpacingPreset3" />
								<Button Height="22" MinHeight="22" MinWidth="0" Content="5 m" Padding="6,0" Margin="0,0,4,0" FontSize="10" Command="{Binding SetPostSpacingPresetCommand}" CommandParameter="5" AutomationProperties.AutomationId="GMaps.Property.PostSpacingPreset5" />
								<Button Height="22" MinHeight="22" MinWidth="0" Content="기본" Padding="6,0" FontSize="10" Command="{Binding ResetPostSpacingCommand}" ToolTip="{Binding FencePostSpacingDefault, StringFormat='전역 설정으로 되돌리기 ({0:0.0} m)'}" AutomationProperties.AutomationId="GMaps.Property.PostSpacingReset" />
							</StackPanel>

							<!--  높이  -->
							<TextBlock
								Grid.Row="3"
								Grid.Column="0"
								Margin="0,6,0,0"
								VerticalAlignment="Center"
								FontSize="11"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="높이" />
							<Slider
								Grid.Row="3"
								Grid.Column="1"
								Margin="4,6,4,0"
								VerticalAlignment="Center"
								Minimum="1.5"
								Maximum="4"
								TickFrequency="0.1"
								IsSnapToTickEnabled="True"
								Value="{Binding FenceHeightM, Mode=TwoWay}"
								ToolTip="철망 높이 1.5~4 m"
								AutomationProperties.AutomationId="GMaps.Property.FenceHeight" />
							<StackPanel
								Grid.Row="3"
								Grid.Column="2"
								Margin="0,6,0,0"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<TextBlock
									MinWidth="34"
									VerticalAlignment="Center"
									FontSize="11"
									FontWeight="Bold"
									Foreground="{DynamicResource TextPrimaryBrush}"
									Text="{Binding FenceHeightM, StringFormat='{}{0:0.0} m'}" />
								<Button Height="22" MinHeight="22" MinWidth="0" Content="기본" Padding="6,0" Margin="4,0,0,0" FontSize="10" Command="{Binding ResetFenceHeightCommand}" AutomationProperties.AutomationId="GMaps.Property.FenceHeightReset" />
							</StackPanel>

							<!--  요약(기둥/센서 수 · 실간격 · 잔여)  -->
							<TextBlock
								Grid.Row="4"
								Grid.Column="0"
								Grid.ColumnSpan="3"
								Margin="0,6,0,0"
								FontSize="10"
								Foreground="{DynamicResource TextSecondaryBrush}"
								Text="{Binding FenceLayoutSummary}"
								TextWrapping="Wrap"
								AutomationProperties.AutomationId="GMaps.Property.FenceSummary" />
						</Grid>
					</Border>
				</StackPanel>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
