<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="BasePropertyStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<utils:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter" />
	<utils:EnumToCollectionConverter x:Key="EnumToCollectionConverter" />

	<Style BasedOn="{StaticResource BasePropertyStyle}" TargetType="{x:Type properties:GMapPropertyPidsGroupControl}">

		<Setter Property="HasSpecificProperties" Value="True" />
		<Setter Property="SpecificPropertiesTitle" Value="PIDS 그룹 속성" />

		<!--  PidsGroup 특화 UI  -->
		<Setter Property="SpecificContent">
			<Setter.Value>
				<StackPanel>

					<!--  기본 정보 섹션 (Line 속성)  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,4"
						Background="#4A8BC8"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="White"
								Text="라인 정보" />

							<!--  포인트 개수 (읽기 전용)  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="포인트 수" />
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding PointCount, StringFormat='{}{0}개'}" />
							</Grid>

							<!--  총 거리 (읽기 전용)  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="총 거리" />
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Text="{Binding TotalDistance, StringFormat='{}{0:F2}m'}" />
							</Grid>
						</StackPanel>
					</Border>

					<!--  라인 스타일 섹션  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,4"
						Background="#4A8BC8"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="White"
								Text="라인 스타일" />

							<!--  라인 패턴  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="패턴" />
								<ComboBox
									Grid.Column="1"
									ItemsSource="{Binding Source={x:Type enums:EnumLinePattern}, Converter={StaticResource EnumToCollectionConverter}}"
									SelectedItem="{Binding LinePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource CompactComboBox}">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</Grid>

							<!--  라인 투명도  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="투명도" />
								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<Slider
										Width="100"
										Maximum="1"
										Minimum="0"
										TickFrequency="0.1"
										Value="{Binding LineOpacity, Mode=TwoWay}" />
									<TextBlock
										Margin="5,0,0,0"
										VerticalAlignment="Center"
										Text="{Binding LineOpacity, StringFormat='{}{0:P0}'}" />
								</StackPanel>
							</Grid>
						</StackPanel>
					</Border>


					<!--  PIDS 그룹 설정  -->
					<Border
						Margin="0,0,0,10"
						Padding="8,4"
						Background="#4A8BC8"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="White"
								Text="PIDS 그룹 설정" />

							<!--  연결된 디바이스 그룹  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="장비 그룹" />
								<ComboBox
									Grid.Column="1"
									ItemsSource="{Binding FilteredDeviceGroupList}"
									DisplayMemberPath="Name"
									SelectedValuePath="Id"
									SelectedValue="{Binding LinkedDeviceGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									Style="{StaticResource CompactComboBox}" />
							</Grid>
						</StackPanel>
					</Border>

				</StackPanel>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
