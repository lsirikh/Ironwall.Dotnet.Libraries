<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:sym="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:system="clr-namespace:System;assembly=System.Runtime">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  PIDS 심볼 상세 보기 창 (symbol-detail-and-door-control FR-15/16/17/20)
	      표준 오버레이 크롬: 외곽 r10 + 1px 헤어라인 + 헤더 38(드래그) + 26px 원형 닫기.
	      색은 전부 DynamicResource 토큰(NFR-04) — 하드코딩 hex 금지.  -->

	<sym:HousingFallbackIconConverter x:Key="SdFallbackIcon" />
	<BooleanToVisibilityConverter x:Key="SdBoolToVisibility" />

	<!--  값 한 줄: 라벨(왼쪽 고정폭) + 값. Tone 이 있으면 값 색을 상태색으로 바꾼다.  -->
	<DataTemplate x:Key="SdFieldTemplate">
		<Grid Margin="0,0,0,6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="86" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				FontSize="11"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="{Binding Label}"
				TextTrimming="CharacterEllipsis" />
			<TextBlock
				x:Name="ValueText"
				Grid.Column="1"
				FontSize="11.5"
				Foreground="{DynamicResource TextPrimaryBrush}"
				Text="{Binding Value}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap"
				ToolTip="{Binding Value}" />
		</Grid>
		<DataTemplate.Triggers>
			<DataTrigger Binding="{Binding Tone}" Value="ok">
				<Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusNormalBrush}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Tone}" Value="warn">
				<Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
			</DataTrigger>
			<DataTrigger Binding="{Binding Tone}" Value="fault">
				<Setter TargetName="ValueText" Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
			</DataTrigger>
		</DataTemplate.Triggers>
	</DataTemplate>

	<!--  탭 버튼 — 선택된 탭만 밑줄 + Primary 글자색. 비활성 탭은 사유를 툴팁으로 항상 보여준다.  -->
	<Style x:Key="SdTabButton" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="10,7" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Root"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="Transparent"
						BorderThickness="0,0,0,2">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<DataTrigger Binding="{Binding IsSelected}" Value="True">
							<Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="FontWeight" Value="Bold" />
						</DataTrigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.45" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  액션 바 버튼 — 첫 버튼만 Primary. 비활성 사유는 반드시 툴팁으로(FR-28).  -->
	<Style x:Key="SdActionButton" TargetType="Button">
		<Setter Property="Height" Value="28" />
		<Setter Property="Margin" Value="0,0,6,6" />
		<Setter Property="Padding" Value="9,0" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="Root"
						Padding="{TemplateBinding Padding}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="1"
						CornerRadius="4">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<md:PackIcon
								Width="14" Height="14"
								Margin="0,0,5,0"
								VerticalAlignment="Center"
								Kind="{Binding Icon}" />
							<TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
						</StackPanel>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.42" />
							<Setter Property="Cursor" Value="No" />
						</Trigger>
						<DataTrigger Binding="{Binding IsPrimary}" Value="True">
							<Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
						</DataTrigger>
						<!--  마이크를 누르고 있는 동안은 "지금 송출 중"이 한눈에 보여야 한다(FR-22).
						      토글이 아니므로 이 표시는 손을 떼는 순간 사라진다.  -->
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding Action}" Value="MicPtt" />
								<Condition Binding="{Binding DataContext.IsMicHeld, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
							</MultiDataTrigger.Conditions>
							<Setter TargetName="Root" Property="Background" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource StatusCriticalBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
						</MultiDataTrigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  스테이지 하단 미니 버튼(⟲ 정면 · ⏸ 회전)  -->
	<Style x:Key="SdMiniButton" TargetType="Button" BasedOn="{StaticResource SdActionButton}">
		<Setter Property="Height" Value="24" />
		<Setter Property="Margin" Value="0,0,5,0" />
		<Setter Property="FontSize" Value="10.5" />
	</Style>

	<Style TargetType="{x:Type ctrl:SymbolDetailControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:SymbolDetailControl}">
					<Border
						Width="720"
						Height="430"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect BlurRadius="12" Opacity="0.18" ShadowDepth="3" Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  헤더 (드래그)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16" Height="16"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="Magnify" />
									<!--  ⚠ TextBlock 에 AutomationId 를 붙여도 이 창에서는 UIA 트리에 나오지 않는다(2026-09-08 트리 덤프 실측).
									      계측 앵커는 peer 가 확실한 Button/ItemsControl 만 쓴다 — 창 열림 판정은 CloseButton,
									      3D/2D 판별은 3D 전용인 ResetView/ToggleRotate 버튼 존재로 한다.  -->
									<TextBlock
										Grid.Column="1"
										VerticalAlignment="Center"
										FontSize="13" FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{Binding HeaderText, Mode=OneWay}"
										TextTrimming="CharacterEllipsis" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										AutomationProperties.AutomationId="GMaps.SymbolDetail.CloseButton"
										Command="{Binding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<Grid Grid.Row="1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="268" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<!--  ── 좌: 스테이지 ──  -->
								<Border
									Grid.Column="0"
									Padding="12"
									Background="{DynamicResource SurfaceSunkenBrush}"
									BorderBrush="{DynamicResource DividerBrush}"
									BorderThickness="0,0,1,0"
									CornerRadius="0,0,0,9">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="*" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>

										<Border
											Grid.Row="0"
											Background="{DynamicResource SurfaceAltBrush}"
											BorderBrush="{DynamicResource DividerBrush}"
											BorderThickness="1"
											CornerRadius="8">
											<Grid>
												<!--  3D: 오빗 카메라 자동/드래그 회전(FR-16/17)  -->
												<ctrl:SymbolPreview3DControl
													x:Name="PART_Preview"
													DoorOpen="{Binding DoorOpen, Mode=OneWay}"
													GuideBrush="{DynamicResource PrimaryBrush}"
													IsAutoRotating="{Binding IsAutoRotating, Mode=TwoWay}"
													ModelKey="{Binding ModelKey, Mode=OneWay}"
													Visibility="{Binding Is3D, Converter={StaticResource SdBoolToVisibility}}" />
												<!--  2D: 고정 아이콘 — 회전도 가이드도 없다(FR-16)  -->
												<md:PackIcon
													Width="86" Height="86"
													HorizontalAlignment="Center" VerticalAlignment="Center"
													Foreground="{DynamicResource TextSecondaryBrush}"
													Kind="{Binding DeviceType, Converter={StaticResource SdFallbackIcon}}"
													Visibility="{Binding Is2D, Converter={StaticResource SdBoolToVisibility}}" />
											</Grid>
										</Border>

										<TextBlock
											Grid.Row="1"
											Margin="0,10,0,0"
											HorizontalAlignment="Center"
											FontSize="13" FontWeight="Bold"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding SymbolName, Mode=OneWay}"
											TextTrimming="CharacterEllipsis" />
										<TextBlock
											Grid.Row="2"
											Margin="0,4,0,0"
											HorizontalAlignment="Center"
											FontSize="10.5"
											Foreground="{DynamicResource TextMutedBrush}"
											Text="{Binding KindText, Mode=OneWay}"
											TextAlignment="Center" />

										<StackPanel
											Grid.Row="3"
											Margin="0,10,0,0"
											HorizontalAlignment="Center"
											Orientation="Horizontal"
											Visibility="{Binding Is3D, Converter={StaticResource SdBoolToVisibility}}">
											<Button
												AutomationProperties.AutomationId="GMaps.SymbolDetail.ResetView"
												Command="{Binding ResetViewCommand}"
												Content="정면"
												Style="{StaticResource SdMiniButton}"
												ToolTip="심볼을 정면으로 되돌리고 자동 회전을 처음부터 시작합니다." />
											<Button
												AutomationProperties.AutomationId="GMaps.SymbolDetail.ToggleRotate"
												Command="{Binding ToggleAutoRotateCommand}"
												Content="{Binding AutoRotateToggleText, Mode=OneWay}"
												Style="{StaticResource SdMiniButton}" />
										</StackPanel>
									</Grid>
								</Border>

								<!--  ── 우: 탭 + 내용 + 액션 바 ──  -->
								<Grid Grid.Column="1">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<Border
										Grid.Row="0"
										BorderBrush="{DynamicResource DividerBrush}"
										BorderThickness="0,0,0,1">
										<ItemsControl
											AutomationProperties.AutomationId="GMaps.SymbolDetail.Tabs"
											ItemsSource="{Binding Tabs}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Horizontal" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button
														AutomationProperties.AutomationId="{Binding AutomationId}"
														Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
														CommandParameter="{Binding}"
														Content="{Binding Header}"
														IsEnabled="{Binding IsEnabled}"
														Style="{StaticResource SdTabButton}"
														ToolTip="{Binding DisabledReason}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Border>

									<Grid Grid.Row="1">
										<ScrollViewer
											Margin="12,10,12,6"
											HorizontalScrollBarVisibility="Disabled"
											VerticalScrollBarVisibility="Auto">
											<ItemsControl
												AutomationProperties.AutomationId="GMaps.SymbolDetail.Fields"
												ItemTemplate="{StaticResource SdFieldTemplate}"
												ItemsSource="{Binding SelectedTab.Fields}" />
										</ScrollViewer>

										<!--  장비 미연결 안내 — 값이 왜 비었는지 말해준다(FR-19)  -->
										<Border
											Margin="12"
											Padding="10,7"
											VerticalAlignment="Bottom"
											Background="{DynamicResource TintWarningBrush}"
											BorderBrush="{DynamicResource StatusWarningBrush}"
											BorderThickness="1"
											CornerRadius="5">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Visibility" Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding HasDevice}" Value="False">
															<Setter Property="Visibility" Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<TextBlock
												FontSize="11"
												Foreground="{DynamicResource TextPrimaryBrush}"
												Text="{Binding NoDeviceReason, Mode=OneWay}"
												TextWrapping="Wrap" />
										</Border>
									</Grid>

									<Border
										Grid.Row="2"
										Padding="12,10,12,4"
										Background="{DynamicResource SurfaceAltBrush}"
										BorderBrush="{DynamicResource DividerBrush}"
										BorderThickness="0,1,0,0"
										CornerRadius="0,0,9,0">
										<ItemsControl
											x:Name="PART_Actions"
											AutomationProperties.AutomationId="GMaps.SymbolDetail.Actions"
											ItemsSource="{Binding Actions}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel Orientation="Horizontal" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Button
														AutomationProperties.AutomationId="{Binding AutomationId}"
														Command="{Binding Command}"
														CommandParameter="{Binding}"
														IsEnabled="{Binding IsEnabled}"
														Style="{StaticResource SdActionButton}"
														ToolTip="{Binding DisabledReason}" />
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Border>
								</Grid>
							</Grid>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
