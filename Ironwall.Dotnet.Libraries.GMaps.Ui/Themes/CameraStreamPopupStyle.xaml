<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:camerapopup="clr-namespace:Ironwall.Dotnet.Libraries.CameraPopup.Wpf;assembly=Ironwall.Dotnet.Libraries.CameraPopup">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--
        영상 상자 안내판 단추([다시 시도] · [다시 시작], camera-popup-modes T-02 · FR-26/29). 늘 검은 영상 위에 뜨므로
        배지와 같은 어둠 반투명 판 위에 둔다 — 단추 자체는 토큰(주색 테두리 · 표면 글자)이고 눌림은 형태(두꺼운 테두리)로 말한다.
    -->
    <Style x:Key="VideoOverlayButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        PTZ 패드 · 세그먼트 · 탭 (B9 — window-design-inventory #55). 예전에는 다크 고정색(짙은 남색 바탕 · 옅은 하늘색 글자)이라
        라이트 테마에서도 이 칸만 검었다. 이제 전부 DynamicResource 토큰이고 템플릿을 직접 둔다 —
        스타일에 템플릿이 없으면 OS 기본 단추 모양(하늘색 호버 · 회색 눌림, 하드코딩)이 입혀져 다크에서 밝은 글자가 묻힌다.
        상태는 색만이 아니라 형태로도 말한다: 눌림 = 주색 테두리 · 고른 탭 = 아래 2px 주색 선 + 굵게 · 고른 세그먼트 = 주색 채움.
        (영상 위 배지의 검정 반투명 · 신호 점 색은 늘 검은 영상 위에 뜨는 것이라 의도대로 둔다.)
    -->
    <Style x:Key="PtzPadButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  탭 버튼 — 고른 탭은 쓰는 쪽 DataTrigger 가 아래 선 · 굵기 · 바탕을 바꾼다  -->
    <Style x:Key="PtzTabButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  옵션 탭 세그먼트 버튼(주야간/포커스 · 줌/포커스 ±) — 패드와 같은 모양, 활성은 쓰는 쪽 DataTrigger 가 주색으로 채운다  -->
    <Style x:Key="PtzSegButtonStyle" BasedOn="{StaticResource PtzPadButtonStyle}" TargetType="Button">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!--  헤더 버튼(크게보기/닫기) — PanelCloseButtonStyle 답습: 26×26 원형 + 호버 #33FFFFFF  -->
    <Style x:Key="PopupHeaderIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  프리셋 목록 행 '가기' — 컴팩트(최소 패딩)·라이트/다크 테마 토큰. Style 없으면 암시적 MD 버튼(둥근형·큰 패딩·MinWidth)
          을 상속해 행 높이가 커짐 → 자체완결 템플릿으로 행을 슬림하게.  -->
    <Style x:Key="PresetRowGoButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Padding="7,1" CornerRadius="3" Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  프리셋 목록 행 삭제(✕) — 컴팩트 정사각·위험(StatusCritical) 토큰.  -->
    <Style x:Key="PresetRowDeleteButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Width="20" Height="20" CornerRadius="3" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  맵 위 이동식 RTSP 스트리밍 팝업 — 관심지역/레이어 창 답습  -->
    <Style TargetType="{x:Type ctrl:CameraStreamPopupControl}">
        <!--  지도에서는 소수 좌표에 놓인다 — 1px 테두리 · 머리 띠 · 영상 가장자리가 두 줄로 번지지 않게 픽셀에 맞춘다(MapView 항목 스타일도 켠다)  -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:CameraStreamPopupControl}">
                    <Grid>
                    <!--  둥근 틀 하나가 모서리를 맡는다: 안의 머리 띠 · 영상 · 탭 패널은 네모(CornerRadius 0)로 두고 FrameBorder 가 테두리 선 밑까지 잘라
                          그 위에 테두리를 그린다. 안쪽 띠마다 반지름(9)을 따로 주면 틀의 자르기(테두리 두께에 따라 바뀜)와 어긋나
                          모서리마다 표면색 쐐기가 비친다(2026-10-01 "창 Edge 마감이 너무 별로" — 화면 밖 렌더 실측).  -->
                    <fb:FrameBorder
                        x:Name="PART_Root"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.12"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  헤더 (드래그) — 관심지역/레이어 패널과 동일 구조  -->
                            <Border
                                Grid.Row="0"
                                Background="{DynamicResource PrimaryBrush}"
                                Cursor="SizeAll">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <md:PackIcon
                                        Grid.Column="0"
                                        Width="18" Height="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{DynamicResource OnPrimaryFixedBrush}"
                                        Kind="Cctv" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="2,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryFixedBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{TemplateBinding PanelTitle}" />

                                    <!--  옵션(컨트롤 패널 PTZ/프리셋/옵션) 토글  -->
                                    <Button
                                        Grid.Column="2"
                                        Margin="0,0,2,0"
                                        Style="{StaticResource PopupHeaderIconButtonStyle}"
                                        Command="{Binding TogglePanelCommand}"
                                        ToolTip="옵션 / 컨트롤 패널 (PTZ·프리셋·옵션)">
                                        <md:PackIcon Width="15" Height="15" Foreground="{DynamicResource OnPrimaryFixedBrush}" Kind="Tune" />
                                    </Button>

                                    <!--  크게/작게 토글  -->
                                    <Button
                                        Grid.Column="3"
                                        Margin="0,0,2,0"
                                        Style="{StaticResource PopupHeaderIconButtonStyle}"
                                        Command="{Binding ToggleSizeCommand}"
                                        ToolTip="크게/작게">
                                        <md:PackIcon Width="14" Height="14" Foreground="{DynamicResource OnPrimaryFixedBrush}" Kind="Resize" />
                                    </Button>

                                    <!--  닫기  -->
                                    <Button
                                        x:Name="PART_CloseButton"
                                        Grid.Column="4"
                                        Style="{StaticResource PanelCloseButtonStyle}" />
                                </Grid>
                            </Border>

                            <!--  영상 영역 — 팝업 호스트가 공유 메모리로 넘긴 프레임(WriteableBitmap, airspace 없음). GIS 는 LibVLC 를 부르지 않는다(T-02).
                                  좌버튼 드래그-PTZ 입력 표면 + 벡터 오버레이  -->
                            <Border
                                x:Name="PART_VideoRegion"
                                Grid.Row="1"
                                Background="Black"
                                ClipToBounds="True">
                                <Grid>
                                    <!--  AspectFillTolerance: 호스트 프레임은 상자 크기로 와서(카메라 비율 띠는 프레임 안에 이미 있다) 짝수 자르기 · 다시 열기 허용 오차만큼만
                                          어긋난다 — 그 1~2 px 를 레터박스하면 영상 한쪽에 검은 세로 줄이 남는다. 3.5% 안이면 채운다.  -->
                                    <camerapopup:HostedVideoView
                                        x:Name="PART_Player"
                                        AspectFillTolerance="0.035"
                                        AutomationProperties.AutomationId="GMaps.CameraPopup.Video"
                                        FrameSource="{Binding FrameSource}"
                                        IsHitTestVisible="False" />
                                    <!--  드래그-PTZ 목표 표시(끈 길이 선 + 떼면 화면 중심으로 올 점의 과녁). 입력은 컨트롤이 처리하므로 히트테스트 제외  -->
                                    <Canvas x:Name="PART_PtzOverlay" Background="Transparent" IsHitTestVisible="False" />

                                    <!--  PTZ 상태 배지(상단 상태 띠 중앙 — RTSP 헤더 Row0 #FF3F3F46, "Playing"·"스트리밍 HUB"와 같은 높이) — 🟢가능 / 🟠준비중 / ⚪지원안함.
                                          좌=스트리밍 HUB·우=Playing이라 충돌 피해 중앙 배치. IsPtzLoading/IsPtzCapable로 3상태 상호배타. RTSP 컨트롤 위 오버레이라 입력 비간섭(히트테스트 제외)  -->
                                    <!--  🟠 준비중: ONVIF 연결(InitializeFull+GetNode, 첫 오픈 수 초·이후 워밍 즉시) 진행 중  -->
                                    <Border Margin="0,5,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False"
                                            Visibility="{Binding IsPtzLoading, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FFF39C12" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="PTZ 준비중…" />
                                        </StackPanel>
                                    </Border>
                                    <!--  🟢 가능: 준비 완료 + PTZ 지원 카메라  -->
                                    <Border Margin="0,5,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPtzLoading}" Value="False" />
                                                            <Condition Binding="{Binding IsPtzCapable}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF2ECC71" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="PTZ 가능" />
                                        </StackPanel>
                                    </Border>
                                    <!--  ⚪ 지원안함: 준비 완료했으나 비PTZ 카메라(또는 ONVIF 포트/계정 실패)  -->
                                    <Border Margin="0,5,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPtzLoading}" Value="False" />
                                                            <Condition Binding="{Binding IsPtzCapable}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF95A5A6" />
                                            <!--  막힌 이유: 지원안함 · 권한 없음 · 연결 실패(영상 드래그 · 휠 · PTZ 단추가 안 되는 까닭)  -->
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="GMaps.CameraPopup.PtzReason"
                                                       Text="{Binding PtzUnavailableReason, TargetNullValue='PTZ 지원안함', FallbackValue='PTZ 지원안함'}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Onvif조회 모드: 스트림 URL 조회 중 배지 — 상단 중앙, PTZ 배지(Margin 0,5 / 높이 ~22) "바로 아래 스택".
                                          ※하단 배치 금지: 오버레이가 플레이어 전체(상태띠+영상+하단 재생 컨트롤 바)를 덮어 하단 중앙=컨트롤 바 침범(스크린샷 144319). (CameraPopup_RtspSource_Priority FR-05)  -->
                                    <Border Margin="0,32,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False"
                                            Visibility="{Binding IsResolvingSource, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF4FC3F7" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="영상 주소 조회 중… (ONVIF)" />
                                        </StackPanel>
                                    </Border>

                                    <!--  재생 상태 표시(오른쪽 위 — 예전 플레이어 상태 띠의 "스트리밍" 자리). 입력 비간섭.  -->
                                    <Border Margin="0,5,6,0" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False"
                                            Visibility="{Binding IsVideoPlaying, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF2ECC71" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="GMaps.CameraPopup.VideoPlaying"
                                                       Text="{Binding VideoStatusText}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  영상 안내판(FR-26 · FR-29): 연결 중 / 연결 안 됨 · [다시 시도] / 지원 안 함 / 영상 기능을 사용할 수 없습니다 · [다시 시작].
                                          실패는 이 상자에만 — 다른 팝업 · GIS 는 그대로.  -->
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,10"
                                            Background="#CC000000" CornerRadius="6"
                                            Visibility="{Binding IsVideoMessageVisible, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                                                       AutomationProperties.AutomationId="GMaps.CameraPopup.VideoStatus"
                                                       Text="{Binding VideoStatusText}" />
                                            <Button Style="{StaticResource VideoOverlayButtonStyle}"
                                                    AutomationProperties.AutomationId="GMaps.CameraPopup.VideoRetry"
                                                    Command="{Binding RetryVideoCommand}" Content="다시 시도"
                                                    Visibility="{Binding CanRetryVideo, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource VideoOverlayButtonStyle}"
                                                    AutomationProperties.AutomationId="GMaps.CameraPopup.HostRestart"
                                                    Command="{Binding RestartHostCommand}" Content="다시 시작"
                                                    Visibility="{Binding CanRestartHost, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>

                            <!--  탭 패널 ([PTZ][프리셋][옵션]) — 우버튼 짧은클릭 토글. 영상 영역(*)이 줄고 패널이 아래에 펼쳐짐  -->
                            <Border
                                Grid.Row="2"
                                Height="220"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding IsPanelExpanded, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <!--  탭 바 (선택된 탭 강조)  -->
                                    <UniformGrid Margin="0,0,0,6" Columns="3" Rows="1">
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="0" Content="PTZ">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PtzTabButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="1" Content="프리셋">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PtzTabButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="2" Content="옵션">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PtzTabButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>

                                    <!--  PTZ 탭: 좌=8방향 패드(누르면 연속이동·떼면 정지), 우=속도+줌(IsPtzCapable)·포커스(IsImagingCapable 독립). 컨트롤이 버튼 Tag로 누름/뗌 처리. ※외곽 IsPtzCapable 제거 — 포커스가 PTZ게이트에 막히면 영상전용 고정카메라서 수동포커스 도달불가(code-reviewer MEDIUM/E 해소)  -->
                                    <Grid Margin="4,4,4,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  좌: 8방향 패드 (PTZ 전용)  -->
                                        <UniformGrid x:Name="PART_PtzPad" Grid.Column="0" Width="132" Height="132" VerticalAlignment="Center" Columns="3" Rows="3" IsEnabled="{Binding IsPtzCapable}">
                                            <Button Content="↖" Style="{StaticResource PtzPadButtonStyle}" Tag="-1,-1" />
                                            <Button Content="▲" Style="{StaticResource PtzPadButtonStyle}" Tag="0,-1" />
                                            <Button Content="↗" Style="{StaticResource PtzPadButtonStyle}" Tag="1,-1" />
                                            <Button Content="◀" Style="{StaticResource PtzPadButtonStyle}" Tag="-1,0" />
                                            <Button Content="■" Foreground="{DynamicResource StatusCriticalBrush}" Style="{StaticResource PtzPadButtonStyle}" Tag="stop" ToolTip="정지" />
                                            <Button Content="▶" Style="{StaticResource PtzPadButtonStyle}" Tag="1,0" />
                                            <Button Content="↙" Style="{StaticResource PtzPadButtonStyle}" Tag="-1,1" />
                                            <Button Content="▼" Style="{StaticResource PtzPadButtonStyle}" Tag="0,1" />
                                            <Button Content="↘" Style="{StaticResource PtzPadButtonStyle}" Tag="1,1" />
                                        </UniformGrid>

                                        <!--  우: 속도(PanTilt/Zoom) — 라벨+값 위, 슬라이더는 전체폭(좁은 슬라이더 0.1↔1.0 점프 방지). 0.1 단위 스냅  -->
                                        <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                          <!--  PTZ 전용(속도/줌) — IsPtzCapable 게이팅. 포커스는 아래에서 분리(imaging 전용)  -->
                                          <StackPanel IsEnabled="{Binding IsPtzCapable}">
                                            <!--  PanTilt 속도  -->
                                            <Grid Margin="0,0,0,1">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="팬 · 틸트 속도" />
                                                <TextBox HorizontalAlignment="Right" Width="42" Padding="2,0" VerticalContentAlignment="Center"
                                                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                                                         Text="{Binding PanTiltSpeed, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" ToolTip="팬/틸트 속도 (0.1~1.0)" />
                                            </Grid>
                                            <Slider Margin="0,0,0,8" Minimum="0.1" Maximum="1.0" SmallChange="0.1" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                    Value="{Binding PanTiltSpeed}" ToolTip="팬/틸트 속도 (0.1 단위)" />
                                            <!--  Zoom 속도  -->
                                            <Grid Margin="0,0,0,1">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="줌 속도" />
                                                <TextBox HorizontalAlignment="Right" Width="42" Padding="2,0" VerticalContentAlignment="Center"
                                                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                                                         Text="{Binding ZoomSpeed, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" ToolTip="줌 속도 (0.1~1.0)" />
                                            </Grid>
                                            <Slider Minimum="0.1" Maximum="1.0" SmallChange="0.1" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                    Value="{Binding ZoomSpeed}" ToolTip="줌 속도 (0.1 단위)" />

                                            <!--  줌 +/- (press-hold: 누르면 연속 줌·뗌 정지 — 컨트롤이 Tag로 처리. 휠과 동일 ContinuousMove 줌)  -->
                                            <Grid Margin="0,8,0,1">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="줌" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Width="36" Content="−" Style="{StaticResource PtzSegButtonStyle}" Tag="zoom:-1" ToolTip="줌 아웃(누르고 있는 동안)" />
                                                    <Button Width="36" Content="+" Style="{StaticResource PtzSegButtonStyle}" Tag="zoom:1" ToolTip="줌 인(누르고 있는 동안)" />
                                                </StackPanel>
                                            </Grid>
                                          </StackPanel>

                                            <!--  포커스 +/- (press-hold: 누르면 연속 near/far·뗌 정지) — imaging 전용(IsImagingCapable), PTZ 게이트 밖 → 영상전용 고정카메라도 활성  -->
                                            <Grid Margin="0,4,0,0" IsEnabled="{Binding IsImagingCapable}">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="포커스" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Width="36" Content="−" Style="{StaticResource PtzSegButtonStyle}" Tag="focus:-1" ToolTip="포커스 근경 near(누르고 있는 동안)" />
                                                    <Button Width="36" Content="+" Style="{StaticResource PtzSegButtonStyle}" Tag="focus:1" ToolTip="포커스 원경 far(누르고 있는 동안)" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!--  프리셋 탭 (ONVIF — 카메라 저장 프리셋, FR-C2) — 비PTZ 카메라는 전체 버튼 비활성.
                                          Home은 ONVIF 전용 슬롯(SetHome/GotoHome — per-preset 개념 아님, OQ-6).  -->
                                    <StackPanel IsEnabled="{Binding IsPtzCapable}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!--  프리셋 목록 — 있을 때만 표시(빈 목록/조회 중엔 아래 스피너·상태문구). 많으면 내부 스크롤로 전부 접근(과거 MaxHeight 클리핑 → 스크롤 전환).  -->
                                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <!--  없을 때: 리스트 영역 접어 높이 0(상태문구/스피너만 노출). 있을 때: Auto 높이(최대 150)+스크롤.  -->
                                                        <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ItemsControl ItemsSource="{Binding Presets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!--  행별 Home 아이콘/지정 버튼 제거(FR-C2/OQ-6) — ONVIF Home은 per-preset이 아닌 전용 슬롯  -->
                                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding PresetName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PresetName}" />
                                                            <Button Grid.Column="1" Margin="2,0" Style="{StaticResource PresetRowGoButtonStyle}" Content="가기" ToolTip="이 프리셋으로 이동" Command="{Binding DataContext.GotoPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                            <Button Grid.Column="2" Margin="2,0" Style="{StaticResource PresetRowDeleteButtonStyle}" Content="✕" ToolTip="카메라에서 프리셋 삭제" Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!--  프리셋 조회 중 스피너(FR-C3) — ONVIF 왕복 동안 '없음' 오해 방지. 완료 시 목록/상태문구로 전환.  -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingPresets}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <md:PackIcon Width="16" Height="16" VerticalAlignment="Center" Kind="Loading"
                                                         Foreground="{DynamicResource PrimaryBrush}" RenderTransformOrigin="0.5,0.5">
                                                <md:PackIcon.RenderTransform>
                                                    <RotateTransform />
                                                </md:PackIcon.RenderTransform>
                                                <md:PackIcon.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </md:PackIcon.Triggers>
                                            </md:PackIcon>
                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Text="프리셋 불러오는 중…" />
                                        </StackPanel>

                                        <!--  빈 목록 상태(FR-C3): 조회 중/미지원/없음/조회 실패를 구분 표기(조회 중엔 스피너만)  -->
                                        <TextBlock Margin="0,8" HorizontalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PresetStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <!--  조회 완료(로딩 아님) + 진짜 빈 목록일 때만 표시 — 조회 중 '없음' 깜빡임 방지  -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Presets.Count}" Value="0" />
                                                                <Condition Binding="{Binding IsLoadingPresets}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--  버튼 — 토큰 스타일+2행 배치로 폭 종속 클리핑 제거(FR-C2/OQ-6). 스타일 없으면 암시적 MD Button 상속으로
                                              라벨 잘림('현재위/Home/Home'). 1행 전폭 저장, 2행 Home 지정·이동(2열 균등).  -->
                                        <Button Margin="0,6,0,0" HorizontalAlignment="Stretch" Style="{StaticResource PanelPrimaryButtonStyle}"
                                                Content="현재위치 저장" ToolTip="현재 위치를 카메라 프리셋으로 저장" Command="{Binding SavePresetCommand}" />
                                        <UniformGrid Margin="0,4,0,0" Columns="2">
                                            <Button Margin="0,0,2,0" HorizontalAlignment="Stretch" Style="{StaticResource PanelSecondaryButtonStyle}"
                                                    Content="Home 지정" ToolTip="현재 위치를 카메라 Home으로 지정" Command="{Binding SetHomeCommand}" />
                                            <Button Margin="2,0,0,0" HorizontalAlignment="Stretch" Style="{StaticResource PanelSecondaryButtonStyle}"
                                                    Content="Home 이동" ToolTip="카메라 Home 위치로 이동(먼저 Home 지정 필요)" Command="{Binding GotoHomeCommand}" />
                                        </UniformGrid>

                                        <!--  인라인 이름 입력  -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsSavingPreset, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="프리셋 이름" />
                                            <TextBox Margin="0,2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" MaxLength="100" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Margin="0,4,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Margin="2,0" Padding="10,3" Content="취소" Style="{StaticResource PtzSegButtonStyle}" Command="{Binding CancelSavePresetCommand}" />
                                                <Button Margin="2,0" Padding="10,3" Content="확인" Style="{StaticResource PtzSegButtonStyle}" Command="{Binding ConfirmSavePresetCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  옵션 탭 (영상: 주야간/포커스)  -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!--  미지원 안내  -->
                                        <TextBlock Margin="0,10" HorizontalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" Text="이 카메라는 영상 옵션을 지원하지 않습니다">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImagingCapable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--  옵션 콘텐츠(지원 시)  -->
                                        <StackPanel Visibility="{Binding IsImagingCapable, Converter={StaticResource BoolToVis}}">
                                            <!--  주야간(IR Cut Filter)  -->
                                            <TextBlock Margin="0,2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="주야간 (IR Cut)" />
                                            <UniformGrid Margin="0,2,0,8" Columns="3" Rows="1">
                                                <Button Command="{Binding SetIrCutFilterCommand}" CommandParameter="ON" Content="주간">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IrCutFilterMode}" Value="ON">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetIrCutFilterCommand}" CommandParameter="OFF" Content="야간">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IrCutFilterMode}" Value="OFF">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetIrCutFilterCommand}" CommandParameter="AUTO" Content="자동">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IrCutFilterMode}" Value="AUTO">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </UniformGrid>

                                            <!--  포커스(AutoFocus)  -->
                                            <TextBlock Margin="0,2" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Text="포커스" />
                                            <UniformGrid Margin="0,2" Columns="2" Rows="1">
                                                <Button Command="{Binding SetAutoFocusCommand}" CommandParameter="true" Content="자동">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutoFocus}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetAutoFocusCommand}" CommandParameter="false" Content="수동">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutoFocus}" Value="False">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </fb:FrameBorder>
                    <!--  단일 선택 강조 — 굵은 주색 테두리 (FR-SEL-02). 틀 두께를 바꾸지 않고 위에 덧그린다:
                          두께를 1→3 으로 바꾸면 안의 영상 상자가 4 DIU 줄어 호스트 프레임(상자 크기로 연 것)과 비율이 어긋나
                          영상 양옆에 1px 검은 줄이 생기고, 선택할 때마다 내용이 2px 씩 움직였다.
                          반지름 9 = 두께 3 선의 바깥 가장자리가 틀(두께 1 · 반지름 10)의 바깥 가장자리와 같은 곡선.  -->
                    <Border
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="3"
                        CornerRadius="9"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
