<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:streaming="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Controls;assembly=Ironwall.Dotnet.Libraries.Streaming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  PTZ 방향 패드 버튼  -->
    <Style x:Key="PtzPadButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="#FF223043" />
        <Setter Property="Foreground" Value="#FFCFE0F0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  탭 버튼  -->
    <Style x:Key="PtzTabButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  헤더 버튼(크게보기/닫기) — PanelCloseButtonStyle 답습: 26×26 원형 + 호버 #33FFFFFF  -->
    <Style x:Key="PopupHeaderIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  맵 위 이동식 RTSP 스트리밍 팝업 — 관심지역/레이어 창 답습  -->
    <Style TargetType="{x:Type ctrl:CameraStreamPopupControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:CameraStreamPopupControl}">
                    <Border
                        x:Name="PART_Root"
                        Background="White"
                        BorderBrush="{StaticResource BorderGrayBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.12"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  헤더 (드래그) — 관심지역/레이어 패널과 동일 구조  -->
                            <Border
                                Grid.Row="0"
                                Background="{StaticResource PrimaryBlueBrush}"
                                CornerRadius="9,9,0,0"
                                Cursor="SizeAll">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <md:PackIcon
                                        Grid.Column="0"
                                        Width="18" Height="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="Cctv" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="2,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        FontSize="14" FontWeight="Bold" Foreground="White"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{TemplateBinding PanelTitle}" />

                                    <!--  크게/작게 토글  -->
                                    <Button
                                        Grid.Column="2"
                                        Margin="0,0,2,0"
                                        Style="{StaticResource PopupHeaderIconButtonStyle}"
                                        Command="{Binding ToggleSizeCommand}"
                                        ToolTip="크게/작게">
                                        <md:PackIcon Width="14" Height="14" Foreground="White" Kind="Resize" />
                                    </Button>

                                    <!--  닫기  -->
                                    <Button
                                        x:Name="PART_CloseButton"
                                        Grid.Column="3"
                                        Style="{StaticResource PanelCloseButtonStyle}" />
                                </Grid>
                            </Border>

                            <!--  영상 영역 (Hub WriteableBitmap — airspace hole 회피). 우버튼 드래그-PTZ 입력 표면 + 벡터 오버레이  -->
                            <Border
                                x:Name="PART_VideoRegion"
                                Grid.Row="1"
                                Background="Black"
                                CornerRadius="0,0,9,9"
                                ClipToBounds="True">
                                <Grid>
                                    <streaming:ImprovedRtspPlayer
                                        x:Name="PART_Player"
                                        AutoPlay="True"
                                        DataContext="{Binding StreamVm}"
                                        ConnectionInfo="{Binding DataContext.ConnectionInfo, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <!--  드래그-PTZ 벡터 오버레이(화살표+게이지). 입력은 컨트롤이 처리하므로 히트테스트 제외  -->
                                    <Canvas x:Name="PART_PtzOverlay" Background="Transparent" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!--  탭 패널 ([PTZ][프리셋][옵션]) — 우버튼 짧은클릭 토글. 영상 영역(*)이 줄고 패널이 아래에 펼쳐짐  -->
                            <Border
                                Grid.Row="2"
                                Background="#FF131922"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,9,9"
                                Visibility="{Binding IsPanelExpanded, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="8">
                                    <!--  탭 바  -->
                                    <UniformGrid Margin="0,0,0,6" Columns="3" Rows="1">
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="0" Content="PTZ" Foreground="#FFE6EDF3" Style="{StaticResource PtzTabButtonStyle}" />
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="1" Content="프리셋" Foreground="#FFE6EDF3" Style="{StaticResource PtzTabButtonStyle}" />
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="2" Content="옵션" Foreground="#FFE6EDF3" Style="{StaticResource PtzTabButtonStyle}" />
                                    </UniformGrid>

                                    <!--  PTZ 탭: 8방향 패드 + 정지  -->
                                    <UniformGrid Width="132" Height="132" HorizontalAlignment="Center" Columns="3" Rows="3">
                                        <UniformGrid.Style>
                                            <Style TargetType="UniformGrid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Style>
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="UL" Content="↖" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="U" Content="▲" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="UR" Content="↗" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="L" Content="◀" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding StopCommand}" Content="■" Foreground="#FFFFCDD2" Style="{StaticResource PtzPadButtonStyle}" ToolTip="정지" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="R" Content="▶" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="DL" Content="↙" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="D" Content="▼" Style="{StaticResource PtzPadButtonStyle}" />
                                        <Button Command="{Binding NudgeCommand}" CommandParameter="DR" Content="↘" Style="{StaticResource PtzPadButtonStyle}" />
                                    </UniformGrid>

                                    <!--  프리셋 탭 (Phase 4)  -->
                                    <TextBlock Margin="0,12" HorizontalAlignment="Center" Foreground="#FF8B98A8" FontSize="12" Text="프리셋 — 준비 중 (Phase 4)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!--  옵션 탭 (Phase 5)  -->
                                    <TextBlock Margin="0,12" HorizontalAlignment="Center" Foreground="#FF8B98A8" FontSize="12" Text="옵션(주야간/포커스) — 준비 중 (Phase 5)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  단일 선택 강조 — 굵은 Accent 테두리 (FR-SEL-02)  -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="3" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
