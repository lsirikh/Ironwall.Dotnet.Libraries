<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:streaming="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Controls;assembly=Ironwall.Dotnet.Libraries.Streaming">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  PTZ 방향 패드 버튼  -->
    <Style x:Key="PtzPadButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="#FF223043" />
        <Setter Property="Foreground" Value="#FFCFE0F0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  탭 버튼  -->
    <Style x:Key="PtzTabButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  옵션 탭 세그먼트 버튼(주야간/포커스) — 활성은 인라인 DataTrigger로 Accent  -->
    <Style x:Key="PtzSegButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="#FF223043" />
        <Setter Property="Foreground" Value="#FFCFE0F0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--  헤더 버튼(크게보기/닫기) — PanelCloseButtonStyle 답습: 26×26 원형 + 호버 #33FFFFFF  -->
    <Style x:Key="PopupHeaderIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  맵 위 이동식 RTSP 스트리밍 팝업 — 관심지역/레이어 창 답습  -->
    <Style TargetType="{x:Type ctrl:CameraStreamPopupControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:CameraStreamPopupControl}">
                    <Border
                        x:Name="PART_Root"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.12"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  헤더 (드래그) — 관심지역/레이어 패널과 동일 구조  -->
                            <Border
                                Grid.Row="0"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="9,9,0,0"
                                Cursor="SizeAll">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <md:PackIcon
                                        Grid.Column="0"
                                        Width="18" Height="18"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{DynamicResource OnPrimaryFixedBrush}"
                                        Kind="Cctv" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="2,0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        FontSize="14" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryFixedBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{TemplateBinding PanelTitle}" />

                                    <!--  옵션(컨트롤 패널 PTZ/프리셋/옵션) 토글  -->
                                    <Button
                                        Grid.Column="2"
                                        Margin="0,0,2,0"
                                        Style="{StaticResource PopupHeaderIconButtonStyle}"
                                        Command="{Binding TogglePanelCommand}"
                                        ToolTip="옵션 / 컨트롤 패널 (PTZ·프리셋·옵션)">
                                        <md:PackIcon Width="15" Height="15" Foreground="{DynamicResource OnPrimaryFixedBrush}" Kind="Tune" />
                                    </Button>

                                    <!--  크게/작게 토글  -->
                                    <Button
                                        Grid.Column="3"
                                        Margin="0,0,2,0"
                                        Style="{StaticResource PopupHeaderIconButtonStyle}"
                                        Command="{Binding ToggleSizeCommand}"
                                        ToolTip="크게/작게">
                                        <md:PackIcon Width="14" Height="14" Foreground="{DynamicResource OnPrimaryFixedBrush}" Kind="Resize" />
                                    </Button>

                                    <!--  닫기  -->
                                    <Button
                                        x:Name="PART_CloseButton"
                                        Grid.Column="4"
                                        Style="{StaticResource PanelCloseButtonStyle}" />
                                </Grid>
                            </Border>

                            <!--  영상 영역 (Hub WriteableBitmap — airspace hole 회피). 우버튼 드래그-PTZ 입력 표면 + 벡터 오버레이  -->
                            <Border
                                x:Name="PART_VideoRegion"
                                Grid.Row="1"
                                Background="Black"
                                CornerRadius="0,0,9,9"
                                ClipToBounds="True">
                                <Grid>
                                    <streaming:ImprovedRtspPlayer
                                        x:Name="PART_Player"
                                        AutoPlay="True"
                                        DataContext="{Binding StreamVm}"
                                        ConnectionInfo="{Binding DataContext.ConnectionInfo, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <!--  드래그-PTZ 벡터 오버레이(화살표+게이지). 입력은 컨트롤이 처리하므로 히트테스트 제외  -->
                                    <Canvas x:Name="PART_PtzOverlay" Background="Transparent" IsHitTestVisible="False" />

                                    <!--  PTZ 상태 배지(상단 상태 띠 중앙 — RTSP 헤더 Row0 #FF3F3F46, "Playing"·"스트리밍 HUB"와 같은 높이) — 🟢가능 / 🟠준비중 / ⚪지원안함.
                                          좌=스트리밍 HUB·우=Playing이라 충돌 피해 중앙 배치. IsPtzLoading/IsPtzCapable로 3상태 상호배타. RTSP 컨트롤 위 오버레이라 입력 비간섭(히트테스트 제외)  -->
                                    <!--  🟠 준비중: ONVIF 연결(InitializeFull+GetNode, 첫 오픈 수 초·이후 워밍 즉시) 진행 중  -->
                                    <Border Margin="0,5,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False"
                                            Visibility="{Binding IsPtzLoading, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FFF39C12" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="PTZ 준비중…" />
                                        </StackPanel>
                                    </Border>
                                    <!--  🟢 가능: 준비 완료 + PTZ 지원 카메라  -->
                                    <Border Margin="0,5,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPtzLoading}" Value="False" />
                                                            <Condition Binding="{Binding IsPtzCapable}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF2ECC71" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="PTZ 가능" />
                                        </StackPanel>
                                    </Border>
                                    <!--  ⚪ 지원안함: 준비 완료했으나 비PTZ 카메라(또는 ONVIF 포트/계정 실패)  -->
                                    <Border Margin="0,5,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsPtzLoading}" Value="False" />
                                                            <Condition Binding="{Binding IsPtzCapable}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF95A5A6" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="PTZ 지원안함" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Onvif조회 모드: 스트림 URL 조회 중 배지 — 상단 중앙, PTZ 배지(Margin 0,5 / 높이 ~22) "바로 아래 스택".
                                          ※하단 배치 금지: 오버레이가 플레이어 전체(상태띠+영상+하단 재생 컨트롤 바)를 덮어 하단 중앙=컨트롤 바 침범(스크린샷 144319). (CameraPopup_RtspSource_Priority FR-05)  -->
                                    <Border Margin="0,32,0,0" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="#AA000000" CornerRadius="3" IsHitTestVisible="False"
                                            Visibility="{Binding IsResolvingSource, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#FF4FC3F7" />
                                            <TextBlock FontSize="10" Foreground="White" VerticalAlignment="Center" Text="영상 주소 조회 중… (ONVIF)" />
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </Border>

                            <!--  탭 패널 ([PTZ][프리셋][옵션]) — 우버튼 짧은클릭 토글. 영상 영역(*)이 줄고 패널이 아래에 펼쳐짐  -->
                            <Border
                                Grid.Row="2"
                                Height="200"
                                Background="#FF131922"
                                BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,9,9"
                                Visibility="{Binding IsPanelExpanded, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <!--  탭 바 (선택된 탭 강조)  -->
                                    <UniformGrid Margin="0,0,0,6" Columns="3" Rows="1">
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="0" Content="PTZ">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PtzTabButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="#FF8290A0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Background" Value="#FF1B2735" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="1" Content="프리셋">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PtzTabButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="#FF8290A0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Background" Value="#FF1B2735" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding SelectTabCommand}" CommandParameter="2" Content="옵션">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource PtzTabButtonStyle}" TargetType="Button">
                                                    <Setter Property="Foreground" Value="#FF8290A0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Background" Value="#FF1B2735" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>

                                    <!--  PTZ 탭: 좌=8방향 패드(누르면 연속이동·떼면 정지), 우=속도+줌(IsPtzCapable)·포커스(IsImagingCapable 독립). 컨트롤이 버튼 Tag로 누름/뗌 처리. ※외곽 IsPtzCapable 제거 — 포커스가 PTZ게이트에 막히면 영상전용 고정카메라서 수동포커스 도달불가(code-reviewer MEDIUM/E 해소)  -->
                                    <Grid Margin="4,4,4,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  좌: 8방향 패드 (PTZ 전용)  -->
                                        <UniformGrid x:Name="PART_PtzPad" Grid.Column="0" Width="132" Height="132" VerticalAlignment="Center" Columns="3" Rows="3" IsEnabled="{Binding IsPtzCapable}">
                                            <Button Content="↖" Style="{StaticResource PtzPadButtonStyle}" Tag="-1,-1" />
                                            <Button Content="▲" Style="{StaticResource PtzPadButtonStyle}" Tag="0,-1" />
                                            <Button Content="↗" Style="{StaticResource PtzPadButtonStyle}" Tag="1,-1" />
                                            <Button Content="◀" Style="{StaticResource PtzPadButtonStyle}" Tag="-1,0" />
                                            <Button Content="■" Foreground="#FFFFCDD2" Style="{StaticResource PtzPadButtonStyle}" Tag="stop" ToolTip="정지" />
                                            <Button Content="▶" Style="{StaticResource PtzPadButtonStyle}" Tag="1,0" />
                                            <Button Content="↙" Style="{StaticResource PtzPadButtonStyle}" Tag="-1,1" />
                                            <Button Content="▼" Style="{StaticResource PtzPadButtonStyle}" Tag="0,1" />
                                            <Button Content="↘" Style="{StaticResource PtzPadButtonStyle}" Tag="1,1" />
                                        </UniformGrid>

                                        <!--  우: 속도(PanTilt/Zoom) — 라벨+값 위, 슬라이더는 전체폭(좁은 슬라이더 0.1↔1.0 점프 방지). 0.1 단위 스냅  -->
                                        <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                          <!--  PTZ 전용(속도/줌) — IsPtzCapable 게이팅. 포커스는 아래에서 분리(imaging 전용)  -->
                                          <StackPanel IsEnabled="{Binding IsPtzCapable}">
                                            <!--  PanTilt 속도  -->
                                            <Grid Margin="0,0,0,1">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF9FB0C0" Text="PanTilt" />
                                                <TextBox HorizontalAlignment="Right" Width="42" Padding="2,0" VerticalContentAlignment="Center"
                                                         Background="#FF0E151C" BorderBrush="#FF38485A" FontSize="11" Foreground="White" TextAlignment="Center"
                                                         Text="{Binding PanTiltSpeed, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" ToolTip="팬/틸트 속도 (0.1~1.0)" />
                                            </Grid>
                                            <Slider Margin="0,0,0,8" Minimum="0.1" Maximum="1.0" SmallChange="0.1" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                    Value="{Binding PanTiltSpeed}" ToolTip="팬/틸트 속도 (0.1 단위)" />
                                            <!--  Zoom 속도  -->
                                            <Grid Margin="0,0,0,1">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF9FB0C0" Text="Zoom" />
                                                <TextBox HorizontalAlignment="Right" Width="42" Padding="2,0" VerticalContentAlignment="Center"
                                                         Background="#FF0E151C" BorderBrush="#FF38485A" FontSize="11" Foreground="White" TextAlignment="Center"
                                                         Text="{Binding ZoomSpeed, StringFormat=0.0, UpdateSourceTrigger=LostFocus}" ToolTip="줌 속도 (0.1~1.0)" />
                                            </Grid>
                                            <Slider Minimum="0.1" Maximum="1.0" SmallChange="0.1" LargeChange="0.1"
                                                    TickFrequency="0.1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                    Value="{Binding ZoomSpeed}" ToolTip="줌 속도 (0.1 단위)" />

                                            <!--  줌 +/- (press-hold: 누르면 연속 줌·뗌 정지 — 컨트롤이 Tag로 처리. 휠과 동일 ContinuousMove 줌)  -->
                                            <Grid Margin="0,8,0,1">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF9FB0C0" Text="줌" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Width="36" Content="−" Style="{StaticResource PtzSegButtonStyle}" Tag="zoom:-1" ToolTip="줌 아웃(누르고 있는 동안)" />
                                                    <Button Width="36" Content="+" Style="{StaticResource PtzSegButtonStyle}" Tag="zoom:1" ToolTip="줌 인(누르고 있는 동안)" />
                                                </StackPanel>
                                            </Grid>
                                          </StackPanel>

                                            <!--  포커스 +/- (press-hold: 누르면 연속 near/far·뗌 정지) — imaging 전용(IsImagingCapable), PTZ 게이트 밖 → 영상전용 고정카메라도 활성  -->
                                            <Grid Margin="0,4,0,0" IsEnabled="{Binding IsImagingCapable}">
                                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11" Foreground="#FF9FB0C0" Text="포커스" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Width="36" Content="−" Style="{StaticResource PtzSegButtonStyle}" Tag="focus:-1" ToolTip="포커스 근경 near(누르고 있는 동안)" />
                                                    <Button Width="36" Content="+" Style="{StaticResource PtzSegButtonStyle}" Tag="focus:1" ToolTip="포커스 원경 far(누르고 있는 동안)" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!--  프리셋 탭 (ONVIF — 카메라 저장 프리셋, FR-C2) — 비PTZ 카메라는 전체 버튼 비활성.
                                          Home은 ONVIF 전용 슬롯(SetHome/GotoHome — per-preset 개념 아님, OQ-6).  -->
                                    <StackPanel IsEnabled="{Binding IsPtzCapable}">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!--  프리셋 목록  -->
                                        <ItemsControl MaxHeight="108" ItemsSource="{Binding Presets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  행별 Home 아이콘/지정 버튼 제거(FR-C2/OQ-6) — ONVIF Home은 per-preset이 아닌 전용 슬롯  -->
                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#FFE6EDF3" Text="{Binding PresetName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PresetName}" />
                                                        <Button Grid.Column="1" Margin="2,0" Padding="6,2" Content="가기" FontSize="11" ToolTip="이 프리셋으로 이동" Command="{Binding DataContext.GotoPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <Button Grid.Column="2" Margin="2,0" Padding="6,2" Content="✕" FontSize="11" Foreground="#FFEF5350" ToolTip="카메라에서 프리셋 삭제" Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--  빈 목록 상태(FR-C3): 조회 중/미지원/없음/조회 실패를 구분 표기  -->
                                        <TextBlock Margin="0,8" HorizontalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="#FF6B7785" Text="{Binding PresetStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Presets.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--  버튼 행 — Home 지정/이동 = ONVIF SetHomePosition/GotoHomePosition(FR-C2/OQ-6)  -->
                                        <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                            <Button Margin="2,0" Padding="8,3" Content="현재위치 저장" FontSize="11" ToolTip="현재 위치를 카메라 프리셋으로 저장" Command="{Binding SavePresetCommand}" />
                                            <Button Margin="2,0" Padding="8,3" Content="Home 지정" FontSize="11" ToolTip="현재 위치를 카메라 Home으로 지정" Command="{Binding SetHomeCommand}" />
                                            <Button Margin="2,0" Padding="8,3" Content="Home 이동" FontSize="11" ToolTip="카메라 Home 위치로 이동(먼저 Home 지정 필요)" Command="{Binding GotoHomeCommand}" />
                                        </StackPanel>

                                        <!--  인라인 이름 입력  -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsSavingPreset, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="11" Foreground="#FF9FB0C0" Text="프리셋 이름" />
                                            <TextBox Margin="0,2" Background="#FF0E151C" BorderBrush="#FF38485A" FontSize="12" Foreground="White" MaxLength="100" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Margin="0,4,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Margin="2,0" Padding="8,3" Content="취소" FontSize="11" Command="{Binding CancelSavePresetCommand}" />
                                                <Button Margin="2,0" Padding="8,3" Content="확인" FontSize="11" Command="{Binding ConfirmSavePresetCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  옵션 탭 (영상: 주야간/포커스)  -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActiveTab}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!--  미지원 안내  -->
                                        <TextBlock Margin="0,10" HorizontalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="#FF6B7785" Text="이 카메라는 영상 옵션을 지원하지 않습니다">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImagingCapable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--  옵션 콘텐츠(지원 시)  -->
                                        <StackPanel Visibility="{Binding IsImagingCapable, Converter={StaticResource BoolToVis}}">
                                            <!--  주야간(IR Cut Filter)  -->
                                            <TextBlock Margin="0,2" FontSize="11" Foreground="#FF9FB0C0" Text="주야간 (IR Cut)" />
                                            <UniformGrid Margin="0,2,0,8" Columns="3" Rows="1">
                                                <Button Command="{Binding SetIrCutFilterCommand}" CommandParameter="ON" Content="주간">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IrCutFilterMode}" Value="ON">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetIrCutFilterCommand}" CommandParameter="OFF" Content="야간">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IrCutFilterMode}" Value="OFF">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetIrCutFilterCommand}" CommandParameter="AUTO" Content="자동">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IrCutFilterMode}" Value="AUTO">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </UniformGrid>

                                            <!--  포커스(AutoFocus)  -->
                                            <TextBlock Margin="0,2" FontSize="11" Foreground="#FF9FB0C0" Text="포커스" />
                                            <UniformGrid Margin="0,2" Columns="2" Rows="1">
                                                <Button Command="{Binding SetAutoFocusCommand}" CommandParameter="true" Content="자동">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutoFocus}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding SetAutoFocusCommand}" CommandParameter="false" Content="수동">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource PtzSegButtonStyle}" TargetType="Button">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutoFocus}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  단일 선택 강조 — 굵은 Accent 테두리 (FR-SEL-02)  -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="PART_Root" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}" />
                            <Setter TargetName="PART_Root" Property="BorderThickness" Value="3" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
