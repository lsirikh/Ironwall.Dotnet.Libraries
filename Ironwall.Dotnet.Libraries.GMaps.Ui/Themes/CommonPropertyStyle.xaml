<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/BasePropertyStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  멀티셀렉트 혼합 타입 공통 속성창 — BasePropertyStyle(공통 속성만) 상속. 타입 특화 영역은 HasSpecificProperties=false로 숨김  -->
	<Style
		BasedOn="{StaticResource BasePropertyStyle}"
		TargetType="{x:Type properties:GMapPropertyCommonControl}" />
</ResourceDictionary>
