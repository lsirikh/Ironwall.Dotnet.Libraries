<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<Style TargetType="{x:Type ctrl:MapCoordinateControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MapCoordinateControl}">
					<Border Style="{StaticResource MapFloatingPanelStyle}">
						<StackPanel>
							<!--  WGS-84  -->
							<Grid Visibility="{Binding IsShowWGS84, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="55" />
									<ColumnDefinition Width="85" />
									<ColumnDefinition Width="10" />
									<ColumnDefinition Width="85" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									FontFamily="Consolas"
									FontSize="11"
									FontWeight="Bold"
									Foreground="{StaticResource PrimaryBlueBrush}"
									Text="WGS-84:" />
								<TextBlock
									Grid.Column="1"
									FontFamily="Consolas"
									FontSize="11"
									Foreground="#333333"
									Text="{Binding Latitude, RelativeSource={RelativeSource TemplatedParent}, StringFormat=F8}" />
								<TextBlock
									Grid.Column="2"
									FontFamily="Consolas"
									FontSize="11"
									Foreground="#999999"
									Text="," />
								<TextBlock
									Grid.Column="3"
									FontFamily="Consolas"
									FontSize="11"
									Foreground="#333333"
									Text="{Binding Longitude, RelativeSource={RelativeSource TemplatedParent}, StringFormat=F8}" />
							</Grid>

							<!--  MGRS  -->
							<Grid
								Margin="0,3,0,0"
								Visibility="{Binding IsShowMGRS, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="55" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									FontFamily="Consolas"
									FontSize="11"
									FontWeight="Bold"
									Foreground="{StaticResource PrimaryBlueBrush}"
									Text="MGRS:" />
								<TextBlock
									Grid.Column="1"
									FontFamily="Consolas"
									FontSize="11"
									Foreground="#333333"
									Text="{TemplateBinding MGRS}" />
							</Grid>

							<!--  UTM  -->
							<Grid
								Margin="0,3,0,0"
								Visibility="{Binding IsShowUTM, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="55" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
									Grid.Column="0"
									FontFamily="Consolas"
									FontSize="11"
									FontWeight="Bold"
									Foreground="{StaticResource PrimaryBlueBrush}"
									Text="UTM:" />
								<TextBlock
									Grid.Column="1"
									FontFamily="Consolas"
									FontSize="11"
									Foreground="#333333"
									Text="{TemplateBinding UTM}" />
							</Grid>
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
