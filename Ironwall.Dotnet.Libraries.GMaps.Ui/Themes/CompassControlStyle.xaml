<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls">

    <!--  방위각 심볼(나침반) GMapCompassControl (GMap_Compass_Control PRD v1.0 · 와이어프레임 v2.2)
          - 논리 120×120 다이얼을 Viewbox로 S64/M96/L128 스케일(DialPixels 파생 DP).
          - 고정: 베젤(SurfaceTranslucent+Border)+러버라인(Accent) / 회전: PART_Rose(코드가 −Bearing RotateTransform).
          - 눈금/기수문자는 코드 생성(PART_TickHost, SetResourceReference=DynamicResource 등가).
          - 색상 전부 {DynamicResource} 토큰(템플릿 스코프 규칙) — §3 토큰 매핑표 그대로.
          - 변형 B(미니멀 링)=트리거로 A요소 숨김/B요소 표시. 리드아웃 필=MapFloatingPanelStyle 계열.  -->

    <Style TargetType="{x:Type ctrl:GMapCompassControl}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:GMapCompassControl}">
                    <StackPanel Orientation="Vertical">
                        <Viewbox Width="{Binding DialPixels, RelativeSource={RelativeSource TemplatedParent}}"
                                 Height="{Binding DialPixels, RelativeSource={RelativeSource TemplatedParent}}">
                            <!--  Background={x:Null}: 원형 다이얼 밖 투명 사각 모서리(~26%)가 맵 입력을
                                  삼키지 않게 히트테스트 제외 — 히트면은 베젤 Ellipse Fill이 제공(리뷰 #5/#8).  -->
                            <Grid x:Name="PART_Dial" Width="120" Height="120" Background="{x:Null}">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.28" ShadowDepth="2" Color="Black" />
                                </Grid.Effect>

                                <!--  베젤(고정) — active 시 PrimaryBrush 스트로크  -->
                                <Ellipse x:Name="Bezel"
                                         Width="108" Height="108"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource SurfaceTranslucentBrush}"
                                         Stroke="{DynamicResource BorderBrush}"
                                         StrokeThickness="1.5" />

                                <!--  러버라인(고정 기준=AccentBrush 규칙, 화면 위쪽)  -->
                                <Path Data="M60,2 L55.5,11 L64.5,11 Z"
                                      Fill="{DynamicResource AccentBrush}" />

                                <!--  회전 로즈(코드가 RenderTransform= −Bearing)  -->
                                <Grid x:Name="PART_Rose" Width="120" Height="120">
                                    <!--  변형 A: 눈금+기수문자(코드 생성) + 카이트 바늘  -->
                                    <Canvas x:Name="PART_TickHost" Width="120" Height="120" />
                                    <Grid x:Name="RoseAGroup">
                                        <Path Data="M60,20 L65,60 L60,67 L55,60 Z"
                                              Fill="{DynamicResource PrimaryBrush}" />
                                        <Path Data="M60,100 L65,60 L60,67 L55,60 Z"
                                              Fill="{DynamicResource BorderBrush}" />
                                    </Grid>
                                    <!--  변형 B: 미니멀 링 — N 도트 + 단일 바늘  -->
                                    <Canvas x:Name="RingBGroup" Width="120" Height="120" Visibility="Collapsed">
                                        <Ellipse Canvas.Left="56" Canvas.Top="12" Width="8" Height="8"
                                                 Fill="{DynamicResource StatusCriticalBrush}" />
                                        <Line X1="60" Y1="22" X2="60" Y2="90"
                                              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.5" />
                                    </Canvas>
                                    <!--  중심 허브  -->
                                    <Ellipse Width="7" Height="7"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{DynamicResource SurfaceBrush}"
                                             Stroke="{DynamicResource PrimaryBrush}"
                                             StrokeThickness="1.2" />
                                </Grid>
                            </Grid>
                        </Viewbox>

                        <!--  리드아웃 필 — MapFloatingPanelStyle 계열(SurfaceTranslucent+Border, r8)  -->
                        <Border x:Name="ReadoutPill"
                                Width="{Binding DialPixels, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="0,4,0,0" Padding="0,1"
                                Background="{DynamicResource SurfaceTranslucentBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Text="{TemplateBinding ReadoutText}" />
                        </Border>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!--  변형 B(미니멀 링): A 요소 숨김  -->
                        <Trigger Property="Variant" Value="Ring">
                            <Setter TargetName="PART_TickHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RoseAGroup" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RingBGroup" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--  회전 활성(|θ|>0.1°): 베젤/필 Primary 강조  -->
                        <Trigger Property="IsBearingActive" Value="True">
                            <Setter TargetName="Bezel" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
                            <Setter TargetName="ReadoutPill" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                        </Trigger>
                        <!--  각도 표시 OFF  -->
                        <Trigger Property="IsReadoutVisible" Value="False">
                            <Setter TargetName="ReadoutPill" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
