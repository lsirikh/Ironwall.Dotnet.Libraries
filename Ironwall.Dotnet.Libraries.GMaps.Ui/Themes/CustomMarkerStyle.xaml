<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Map Pin Marker Style  -->
	<Style x:Key="BaseMarkerStyle" TargetType="{x:Type control:GMapMarkerCustomControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type control:GMapMarkerCustomControl}">
					<Grid Name="PART_MainContainer">

						<!--  마커 본체 (크기 연동)  -->
						<Viewbox
							Name="PART_ViewboxContainer"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							Stretch="Fill"
							ToolTip="{TemplateBinding MarkerTitle}">

							<Grid
								Name="PART_MarkerContainer"
								Width="32"
								Height="46"
								HorizontalAlignment="Center"
								VerticalAlignment="Bottom">

								<!--  Map Pin Shape (기준 크기: 32x32)  -->
								<Path
									Name="PART_PinShape"
									Data="M16,0 C24.8,0 32,7.2 32,16 C32,24 22,32 16,46 C10,32 0,24 0,16 C0,7.2 7.2,0 16,0 Z"
									Stretch="Fill"
									Fill="{TemplateBinding MarkerFill}"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="{TemplateBinding MarkerStrokeThickness}">
									<Path.Effect>
										<DropShadowEffect
											BlurRadius="8"
											Opacity="0.5"
											ShadowDepth="4"
											Color="Black" />
									</Path.Effect>
								</Path>

								<!--  Inner Circle (기준 크기: 20x20)  -->
								<Ellipse
									Name="PART_InnerCircle"
									Width="20"
									Height="20"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									VerticalAlignment="Top"
									Fill="White"
									Stroke="{TemplateBinding MarkerStroke}"
									StrokeThickness="1" />

								<!--  Hover Highlight (기준 크기: 20x20)  -->
								<Ellipse
									Name="PART_HoverHighlight"
									Width="20"
									Height="20"
									Margin="0,6,0,0"
									HorizontalAlignment="Center"
									VerticalAlignment="Top"
									Fill="White"
									Opacity="0" />
							</Grid>
						</Viewbox>

						<!--  Label Container - Viewbox 외부, 독립적 크기  -->
						<Border
							Name="PART_LabelContainer"
							MinWidth="40"
							MaxWidth="150"
							Margin="0,0,0,-25"
							Padding="2"
							HorizontalAlignment="Center"
							VerticalAlignment="Bottom"
							Background="White"
							BorderBrush="Gray"
							BorderThickness="1"
							CornerRadius="4"
							Visibility="Collapsed">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="3"
									Opacity="0.3"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
							<TextBlock
								Name="PART_LabelText"
								FontSize="{TemplateBinding TitleSize}"
								FontWeight="SemiBold"
								Foreground="Black"
								Text="{TemplateBinding MarkerTitle}"
								TextAlignment="Center"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap" />
						</Border>
					</Grid>

					<ControlTemplate.Triggers>
						<!--  ShowShape=False일 때만 숨김 (단일 트리거)  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_ViewboxContainer" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
							<Setter TargetName="PART_LabelContainer" Property="Margin" Value="0,0,0,0" />
						</Trigger>

						<!--  라벨 표시 조건들 (OR 로직)  -->

						<!--  IsSelected=True일 때 라벨 표시  -->
						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Collapsed" />
						</Trigger>

						<!--  ShowTitle=True일 때 라벨 표시  -->
						<Trigger Property="ShowTitle" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Collapsed" />
						</Trigger>

						<!--  IsMouseOver=True일 때 라벨 표시 + 기타 효과  -->
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_HoverHighlight" Property="Opacity" Value="0.2" />
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_PinShape" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="15"
										Opacity="0.8"
										ShadowDepth="7"
										Color="Black" />
								</Setter.Value>
							</Setter>
						</Trigger>

						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_PinShape" Property="Opacity" Value="0.5" />
							<Setter TargetName="PART_InnerCircle" Property="Opacity" Value="0.5" />
						</Trigger>

					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
		<!--  기본 마커 크기  -->
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="46" />
		<!--  라벨 관련 기본값  -->
		<Setter Property="TitleSize" Value="11" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BaseMarkerStyle}" TargetType="{x:Type control:GMapMarkerCustomControl}" />

</ResourceDictionary>