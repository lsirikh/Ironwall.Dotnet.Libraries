<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps" xmlns:house="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Symbols3D" xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:util="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <util:SymbolTypeToIconConverter x:Key="PaletteIcon"/>
    <Style x:Key="PaletteSecondaryButton" TargetType="Button" BasedOn="{StaticResource PanelSecondaryButtonStyle}">
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style x:Key="PaletteTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBorder" CornerRadius="5" Padding="10,8" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:SymbolPaletteView}">
        <Setter Property="Width" Value="384"/>
        <Setter Property="Height" Value="580"/>
        <Setter Property="MaxHeight" Value="660"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SymbolPaletteView}">
                    <Border x:Name="PART_Frame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="3" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="9,9,0,0"/>
                                <Thumb x:Name="PART_HeaderDrag" Cursor="SizeAll" Focusable="False" AutomationProperties.AutomationId="GMaps.SymbolPalette.Header" AutomationProperties.Name="아이콘 등록 창 이동">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Grid IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <md:PackIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="ViewGridPlus" Foreground="{DynamicResource OnPrimaryFixedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="아이콘 등록" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryFixedBrush}"/>
                                </Grid>
                                <Button x:Name="PART_CloseButton" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PanelCloseButtonStyle}" ToolTip="닫기" AutomationProperties.AutomationId="GMaps.SymbolPalette.Close"/>
                            </Grid>
                            <Border Grid.Row="1" Padding="10,7" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="심볼을 끌어 놓거나 선택 후 지도에서 위치를 지정하세요." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="10" Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBox x:Name="PART_SearchBox" Padding="9,7" Background="{DynamicResource SurfaceSunkenBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="심볼 검색" AutomationProperties.AutomationId="GMaps.SymbolPalette.Search" FontSize="11"/>
                                    <TextBlock Text="이름 또는 모델 검색" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton Content="PIDS" Tag="PIDS_EQUIPMENT" IsChecked="True" Style="{StaticResource PaletteTab}" AutomationProperties.AutomationId="GMaps.SymbolPalette.Category.PIDS_EQUIPMENT"/>
                                    <RadioButton Content="시설물" Tag="INFRASTRUCTURE" Style="{StaticResource PaletteTab}" AutomationProperties.AutomationId="GMaps.SymbolPalette.Category.INFRASTRUCTURE"/>
                                    <RadioButton Content="도형" Tag="GEOMETRICS" Style="{StaticResource PaletteTab}" AutomationProperties.AutomationId="GMaps.SymbolPalette.Category.GEOMETRICS"/>
                                    <RadioButton Content="기본" Tag="BASIC_SHAPES" Style="{StaticResource PaletteTab}" AutomationProperties.AutomationId="GMaps.SymbolPalette.Category.BASIC_SHAPES"/>
                                </StackPanel>
                                <TextBlock x:Name="PART_CountLabel" Grid.Row="2" Margin="0,0,0,8" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid Grid.Row="3">
                                    <ListBox x:Name="PART_Items" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" AutomationProperties.AutomationId="GMaps.SymbolPalette.Items">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Cell" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceAltBrush}" Padding="3">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="70" ToolTip="{Binding Title}">
                                                    <Grid Height="64">
                                                        <house:HousingVisual x:Name="Model" ModelKey="{Binding ModelKey}" Yaw="145" HeadYaw="0" BodyBrush="{DynamicResource TextSecondaryBrush}" RingBrush="{DynamicResource PrimaryBrush}" RingThickness="0.8"/>
                                                        <md:PackIcon x:Name="Glyph" Kind="{Binding Type, Converter={StaticResource PaletteIcon}}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="9" Margin="0,3,0,5" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ModelKey}" Value="{x:Null}">
                                                        <Setter TargetName="Model" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="PART_EmptyLabel" Text="검색 결과가 없습니다" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                    <TextBlock Text="클릭 또는 Enter: 지도에서 위치 지정 · ESC: 취소" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <CheckBox x:Name="PART_Enable3D" Content="지도에 3D 하우징 사용" Margin="0,12,0,5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="PART_FeatureStatus" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <WrapPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="군대부호" Padding="10,5" Margin="0,0,6,0" Style="{StaticResource PaletteSecondaryButton}" x:Name="PART_MilitaryButton" AutomationProperties.AutomationId="GMaps.SymbolPalette.MilitaryButton"/>
                                    <Button Content="구역" Padding="10,5" Style="{StaticResource PaletteSecondaryButton}" x:Name="PART_BoundaryButton" AutomationProperties.AutomationId="GMaps.SymbolPalette.BoundaryButton"/>
                                    <Button Content="선" Padding="10,5" Margin="6,0,0,0" Style="{StaticResource PaletteSecondaryButton}" x:Name="PART_LineButton" AutomationProperties.AutomationId="GMaps.SymbolPalette.LineButton"/>
                                    <Button Content="PIDS 그룹" Padding="10,5" Margin="6,0,0,0" Style="{StaticResource PaletteSecondaryButton}" x:Name="PART_PidsGroupButton" AutomationProperties.AutomationId="GMaps.SymbolPalette.PidsGroupButton"/>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
