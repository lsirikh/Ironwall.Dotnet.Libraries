<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  Line Marker Style  -->
	<Style x:Key="BaseLineMarkerStyle" TargetType="{x:Type control:GMapMarkerLineControl}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type control:GMapMarkerLineControl}">
					<Grid Name="PART_MainContainer">

						<!--  Line Canvas - 라인들을 그릴 캔버스  -->
						<Canvas
							Name="PART_LineCanvas"
							Width="{TemplateBinding Width}"
							Height="{TemplateBinding Height}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							ClipToBounds="False">

							<!--  Main Polyline - 확정된 라인  -->
							<Polyline
								Name="PART_MainPolyline"
								Opacity="{TemplateBinding LineOpacity}"
								Stroke="{TemplateBinding MarkerStroke}"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="{TemplateBinding MarkerStrokeThickness}" />

							<!--  Preview Polyline - 드로잉 중 미리보기 라인  -->
							<Polyline
								Name="PART_PreviewPolyline"
								Opacity="0.5"
								Stroke="Gray"
								StrokeDashArray="5,3"
								StrokeEndLineCap="Round"
								StrokeLineJoin="Round"
								StrokeStartLineCap="Round"
								StrokeThickness="{TemplateBinding MarkerStrokeThickness}"
								Visibility="Collapsed" />

							<!--  Start Point Marker - 시작점 표시  -->
							<Ellipse
								Name="PART_StartPointMarker"
								Width="8"
								Height="8"
								Fill="{TemplateBinding MarkerFill}"
								Stroke="{TemplateBinding MarkerStroke}"
								StrokeThickness="2"
								Visibility="Collapsed">
								<Ellipse.Effect>
									<DropShadowEffect
										BlurRadius="4"
										Opacity="0.6"
										ShadowDepth="2"
										Color="Black" />
								</Ellipse.Effect>
							</Ellipse>

							<!--  End Point Marker - 끝점 표시  -->
							<Polygon
								Name="PART_EndPointMarker"
								Fill="{TemplateBinding MarkerFill}"
								Points="0,4 8,4 6,0 8,4 6,8"
								Stroke="{TemplateBinding MarkerStroke}"
								StrokeThickness="2"
								Visibility="Collapsed">
								<Polygon.Effect>
									<DropShadowEffect
										BlurRadius="4"
										Opacity="0.6"
										ShadowDepth="2"
										Color="Black" />
								</Polygon.Effect>
							</Polygon>

							<!--  Line Points - 라인 구성 점들 (편집 모드에서 표시)  -->
							<ItemsControl Name="PART_LinePointsContainer" Visibility="Collapsed">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<Canvas />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Ellipse
											Width="6"
											Height="6"
											Fill="White"
											Stroke="Blue"
											StrokeThickness="2"
											ToolTip="라인 포인트">
											<Ellipse.Effect>
												<DropShadowEffect
													BlurRadius="3"
													Opacity="0.5"
													ShadowDepth="1"
													Color="Black" />
											</Ellipse.Effect>
										</Ellipse>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Canvas>

						<!--  Invisible Hit Test Area - 클릭 감지용 (라인은 클릭하기 어려우므로)  -->
						<Rectangle
							Name="PART_HitTestArea"
							Fill="Transparent"
							Opacity="0"
							Stroke="Transparent"
							StrokeThickness="10"
							ToolTip="{TemplateBinding MarkerTitle}" />

						<!--  Label Container - 라인 중앙 근처에 배치  -->
						<Border
							Name="PART_LabelContainer"
							MinWidth="40"
							MaxWidth="150"
							Margin="0,-30,0,0"
							Padding="4,2"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="White"
							BorderBrush="Gray"
							BorderThickness="1"
							CornerRadius="4"
							Visibility="Collapsed">
							<Border.Effect>
								<DropShadowEffect
									BlurRadius="3"
									Opacity="0.3"
									ShadowDepth="2"
									Color="Black" />
							</Border.Effect>
							<StackPanel HorizontalAlignment="Center" Orientation="Vertical">
								<!--  라인 이름  -->
								<TextBlock
									Name="PART_LabelText"
									FontSize="{TemplateBinding TitleSize}"
									FontWeight="SemiBold"
									Foreground="Black"
									Text="{TemplateBinding MarkerTitle}"
									TextAlignment="Center"
									TextTrimming="CharacterEllipsis"
									TextWrapping="NoWrap" />

								<!--  라인 정보 (길이, 점 개수 등)  -->
								<TextBlock
									Name="PART_InfoText"
									FontSize="8"
									Foreground="DarkGray"
									TextAlignment="Center"
									Visibility="Collapsed">
									<TextBlock.Text>
										<MultiBinding StringFormat="{}{0:F1}m ({1}점)">
											<Binding Path="TotalDistance" RelativeSource="{RelativeSource TemplatedParent}" />
											<Binding Path="LinePoints.Count" RelativeSource="{RelativeSource TemplatedParent}" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</StackPanel>
						</Border>

						<!--  Drawing Status Indicator - 드로잉 중일 때 표시  -->
						<Border
							Name="PART_DrawingIndicator"
							Width="20"
							Height="20"
							Margin="0,0,-10,-10"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Background="Orange"
							BorderBrush="White"
							BorderThickness="2"
							CornerRadius="10"
							Visibility="Collapsed">
							<md:PackIcon
								Width="12"
								Height="12"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Foreground="White"
								Kind="Pencil" />
						</Border>
					</Grid>

					<ControlTemplate.Triggers>
						<!--  ShowShape=False일 때 라인 숨김  -->
						<Trigger Property="ShowShape" Value="False">
							<Setter TargetName="PART_LineCanvas" Property="Visibility" Value="Collapsed" />
							<Setter TargetName="PART_HitTestArea" Property="Visibility" Value="Collapsed" />
							<Setter Property="IsHitTestVisible" Value="False" />
						</Trigger>

						<!--  IsDrawing=True일 때 드로잉 상태 표시  -->
						<Trigger Property="IsDrawing" Value="True">
							<Setter TargetName="PART_DrawingIndicator" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_MainPolyline" Property="Opacity" Value="0.7" />
						</Trigger>

						<!--  ShowArrowHead=True일 때 끝점 마커 표시  -->
						<Trigger Property="ShowArrowHead" Value="True">
							<Setter TargetName="PART_EndPointMarker" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  IsClosedPath=True일 때 시작점 마커도 표시  -->
						<Trigger Property="IsClosedPath" Value="True">
							<Setter TargetName="PART_StartPointMarker" Property="Visibility" Value="Visible" />
						</Trigger>

						<!--  라벨 표시 조건들  -->
						<Trigger Property="ShowTitle" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
						</Trigger>

						<Trigger Property="IsSelected" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_InfoText" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_LinePointsContainer" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_MainPolyline" Property="StrokeThickness" Value="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}}" />
						</Trigger>

						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="PART_LabelContainer" Property="Visibility" Value="Visible" />
							<Setter TargetName="PART_HitTestArea" Property="Opacity" Value="0.1" />
							<Setter TargetName="PART_HitTestArea" Property="Stroke" Value="{Binding MarkerStroke, RelativeSource={RelativeSource TemplatedParent}}" />
							<Setter TargetName="PART_MainPolyline" Property="Effect">
								<Setter.Value>
									<DropShadowEffect
										BlurRadius="8"
										Opacity="0.8"
										ShadowDepth="3"
										Color="Black" />
								</Setter.Value>
							</Setter>
						</Trigger>

						<!--  Line Pattern에 따른 스타일 변경  -->
						<Trigger Property="LinePattern" Value="Dashed">
							<Setter TargetName="PART_MainPolyline" Property="StrokeDashArray" Value="10,5" />
						</Trigger>

						<Trigger Property="LinePattern" Value="Dotted">
							<Setter TargetName="PART_MainPolyline" Property="StrokeDashArray" Value="2,3" />
						</Trigger>

						<Trigger Property="LinePattern" Value="DashDot">
							<Setter TargetName="PART_MainPolyline" Property="StrokeDashArray" Value="10,3,2,3" />
						</Trigger>

						<!--<Trigger Property="LinePattern" Value="DoubleLine">
							<Setter TargetName="PART_MainPolyline" Property="StrokeThickness" Value="{Binding MarkerStrokeThickness, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static control:ThicknessMultiplierConverter.Instance}, ConverterParameter=1.8}" />
						</Trigger>-->

						<!--  Disabled State  -->
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="PART_MainPolyline" Property="Opacity" Value="0.3" />
							<Setter TargetName="PART_PreviewPolyline" Property="Opacity" Value="0.2" />
							<Setter TargetName="PART_LabelContainer" Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Default Property Values  -->
		<Setter Property="IsHitTestVisible" Value="True" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="Width" Value="200" />
		<Setter Property="Height" Value="200" />
		<Setter Property="TitleSize" Value="10" />
		<Setter Property="MarkerStrokeThickness" Value="2" />
		<Setter Property="LineOpacity" Value="1.0" />
	</Style>

	<!--  Apply Default Style  -->
	<Style BasedOn="{StaticResource BaseLineMarkerStyle}" TargetType="{x:Type control:GMapMarkerLineControl}" />

</ResourceDictionary>