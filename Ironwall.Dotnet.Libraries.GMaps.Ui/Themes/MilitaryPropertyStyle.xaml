<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:properties="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="BasePropertyStyle.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<utils:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter" />
	<utils:EnumToCollectionConverter x:Key="EnumToCollectionConverter" />



	<Style BasedOn="{StaticResource BasePropertyStyle}" TargetType="{x:Type properties:GMapPropertyMilitaryControl}">

		<Setter Property="HasSpecificProperties" Value="True" />
		<Setter Property="SpecificPropertiesTitle" Value="군사 심볼 속성" />
		<!--  군사 심볼 특화 UI  -->
		<Setter Property="SpecificContent">
			<Setter.Value>
				<StackPanel>
					<!--  소속 구분  -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="소속 구분" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding Source={x:Type enums:EnumMilitaryAffiliation}, Converter={StaticResource EnumToCollectionConverter}}"
							SelectedItem="{Binding Affiliation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource CompactComboBox}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!--  전투 차원  -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="전투 차원" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding Source={x:Type enums:EnumMilitaryBattleDimension}, Converter={StaticResource EnumToCollectionConverter}}"
							SelectedItem="{Binding BattleDimension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource CompactComboBox}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!--  표준 정체성  -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="표준 정체성" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding Source={x:Type enums:EnumMilitaryStandardIdentity}, Converter={StaticResource EnumToCollectionConverter}}"
							SelectedItem="{Binding StandardIdentity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource CompactComboBox}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!--  부대 규모  -->
					<Grid Margin="0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="80" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Style="{StaticResource PropertyLabel}"
							Text="부대 규모" />
						<ComboBox
							Grid.Column="1"
							ItemsSource="{Binding Source={x:Type enums:EnumMilitaryUnitSize}, Converter={StaticResource EnumToCollectionConverter}}"
							SelectedItem="{Binding UnitSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
							Style="{StaticResource CompactComboBox}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<!--  부대 식별 정보 섹션  -->
					<Border
						Margin="0,10,0,0"
						Padding="8,4"
						Background="{DynamicResource PrimaryBrush}"
						CornerRadius="5">
						<StackPanel>
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="12"
								FontWeight="Bold"
								Foreground="{DynamicResource OnPrimaryFixedBrush}"
								Text="부대 식별 정보" />

							<!--  부대 지시자  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="부대 지시자" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource CompactTextBox}"
									Text="{Binding UnitDesignator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<!--  상급 부대명  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="상급 부대명" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource CompactTextBox}"
									Text="{Binding HigherFormation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<!--  콜사인  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="콜사인" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource CompactTextBox}"
									Text="{Binding CallSign, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<!--  국가 코드  -->
							<Grid Margin="0,5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="80" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock
                                    Foreground="{DynamicResource OnPrimaryFixedBrush}"
									Grid.Column="0"
									Style="{StaticResource PropertyLabel}"
									Text="국가 코드" />
								<TextBox
									Grid.Column="1"
									Style="{StaticResource CompactTextBox}"
									Text="{Binding CountryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>