<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!-- 섹션 라벨 -->
	<Style x:Key="PbSectionLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0,0,0,6" />
	</Style>

	<!-- 기간/배속 칩 (Secondary 답습 + 컴팩트) -->
	<Style x:Key="PbChip" TargetType="Button" BasedOn="{StaticResource PanelSecondaryButtonStyle}">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Margin" Value="0,0,5,0" />
		<Setter Property="FontSize" Value="11" />
	</Style>

	<!-- 입력칸(from/to) -->
	<Style x:Key="PbInput" TargetType="TextBox">
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Padding" Value="4,3" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style TargetType="{x:Type ctrl:PlaybackConsoleControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:PlaybackConsoleControl}">
					<Border
						Width="430"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="3" Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!-- 헤더 (드래그) -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16" Height="16"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="PlayCircleOutline" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										FontSize="13" FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="추적 재생 (Playback)" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Command="{Binding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!-- 바디 (DataContext = PlaybackViewModel) -->
							<StackPanel Grid.Row="1">
								<!-- ① 기간 -->
								<StackPanel Margin="12,10,12,8">
									<TextBlock Style="{StaticResource PbSectionLabel}" Text="① 기간" />
									<StackPanel Margin="0,0,0,6" Orientation="Horizontal">
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="5" Content="최근 5분" />
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="30" Content="30분" />
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="60" Content="1시간" />
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="today" Content="오늘" />
									</StackPanel>
									<StackPanel Orientation="Horizontal">
										<TextBox Width="120" Style="{StaticResource PbInput}" Text="{Binding FromTime, StringFormat='yyyy-MM-dd HH:mm'}" />
										<TextBlock Margin="6,4" Foreground="{DynamicResource TextMutedBrush}" Text="~" />
										<TextBox Width="120" Style="{StaticResource PbInput}" Text="{Binding ToTime, StringFormat='yyyy-MM-dd HH:mm'}" />
										<Button Margin="8,0,0,0" Style="{StaticResource PanelPrimaryButtonStyle}" Command="{Binding LoadCommand}" Content="불러오기" />
									</StackPanel>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- ② 이벤트 -->
								<StackPanel Margin="12,8">
									<TextBlock Style="{StaticResource PbSectionLabel}" Text="② 추적 이벤트 — ☑ 표시/숨김 · ⌖ 따라보기" />
									<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="160">
										<ListBox
											Background="Transparent"
											BorderThickness="0"
											ItemsSource="{Binding Events}"
											ScrollViewer.HorizontalScrollBarVisibility="Disabled">
											<ListBox.ItemTemplate>
												<DataTemplate>
													<Grid Margin="2">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>
														<CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
														<TextBlock Grid.Column="1" Margin="4,0" VerticalAlignment="Center" FontSize="14" Text="{Binding TypeGlyph}" />
														<StackPanel Grid.Column="2" VerticalAlignment="Center">
															<TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
																<Run Text="cam" /><Run Text="{Binding CameraId}" /><Run Text=" · " /><Run Text="{Binding Label}" />
															</TextBlock>
															<TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Span}" />
														</StackPanel>
														<Border Grid.Column="3" Margin="4,0" Padding="5,1" VerticalAlignment="Center" Background="{Binding ThreatBrush}" CornerRadius="3">
															<TextBlock FontSize="9" Foreground="White" Text="{Binding ThreatLevel}" />
														</Border>
														<Button
															Grid.Column="4"
															Width="24" Height="22"
															Background="Transparent" BorderThickness="0"
															Cursor="Hand"
															Foreground="{DynamicResource TextSecondaryBrush}"
															Content="⌖"
															Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType={x:Type ctrl:PlaybackConsoleControl}}}"
															CommandParameter="{Binding}" />
													</Grid>
												</DataTemplate>
											</ListBox.ItemTemplate>
										</ListBox>
									</Border>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- ③ 재생 -->
								<StackPanel Margin="12,8,12,12">
									<TextBlock Style="{StaticResource PbSectionLabel}" Text="③ 재생" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Button
											Grid.Column="0"
											Width="36" Height="36"
											FontSize="15" FontWeight="Bold"
											Style="{StaticResource PanelPrimaryButtonStyle}"
											Command="{Binding PlayPauseCommand}"
											Content="{Binding PlayPauseGlyph}" />
										<Slider Grid.Column="1" Margin="9,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
											AutoToolTipPlacement="None" IsSnapToTickEnabled="False" Value="{Binding Progress, Mode=TwoWay}" />
										<TextBlock
											Grid.Column="2"
											MinWidth="118"
											VerticalAlignment="Center"
											FontFamily="Consolas" FontSize="11"
											Foreground="{DynamicResource TextSecondaryBrush}"
											TextAlignment="Right"
											Text="{Binding TimeLabel}" />
									</Grid>
									<StackPanel Margin="0,8,0,0" Orientation="Horizontal">
										<TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="배속" />
										<Button Style="{StaticResource PbChip}" Command="{Binding SpeedCommand}" CommandParameter="0.5" Content="0.5×" />
										<Button Style="{StaticResource PbChip}" Command="{Binding SpeedCommand}" CommandParameter="1" Content="1×" />
										<Button Style="{StaticResource PbChip}" Command="{Binding SpeedCommand}" CommandParameter="2" Content="2×" />
										<Button Style="{StaticResource PbChip}" Command="{Binding SpeedCommand}" CommandParameter="4" Content="4×" />
										<TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Status}" />
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
