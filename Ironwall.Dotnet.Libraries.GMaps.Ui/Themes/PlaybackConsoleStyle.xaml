<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:util="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!-- 섹션 라벨 -->
	<Style x:Key="PbSectionLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="Margin" Value="0,0,0,6" />
	</Style>

	<!-- 기간/배속 칩 (Secondary 답습 + 컴팩트) -->
	<Style x:Key="PbChip" TargetType="Button" BasedOn="{StaticResource PanelSecondaryButtonStyle}">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Margin" Value="0,0,5,0" />
		<Setter Property="FontSize" Value="11" />
	</Style>

	<!-- 배속 칩: 현재 Speed와 버튼 Tag 일치 시 활성 하이라이트(선택 표시) -->
	<util:SpeedActiveConverter x:Key="SpeedActiveConverter" />
	<Style x:Key="PbSpeedChip" TargetType="Button" BasedOn="{StaticResource PbChip}">
		<Style.Triggers>
			<DataTrigger Value="True">
				<DataTrigger.Binding>
					<MultiBinding Converter="{StaticResource SpeedActiveConverter}">
						<Binding Path="Speed" />
						<Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
					</MultiBinding>
				</DataTrigger.Binding>
				<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- 재생 버튼: 재생 중(IsPlaying)일 때만 배속 활성 칩과 동일 하이라이트(PrimaryBrush), 정지 시 배경색 -->
	<Style x:Key="PbPlayToggle" TargetType="Button" BasedOn="{StaticResource PanelSecondaryButtonStyle}">
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsPlaying}" Value="True">
				<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- 입력칸(from/to) -->
	<Style x:Key="PbInput" TargetType="TextBox">
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Padding" Value="4,3" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<!-- 달력 네비게이션 버튼(◀ ▶) -->
	<Style x:Key="PbCalNav" TargetType="Button">
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="26" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- 달력 요일 헤더 -->
	<Style x:Key="PbCalWeekday" TargetType="TextBlock">
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,2,0,4" />
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
	</Style>

	<!-- 달력 날짜 셀 (자체완결 · DynamicResource 토큰만 · 2클릭 범위 하이라이트) -->
	<Style x:Key="PbDayCell" TargetType="Button">
		<Setter Property="Height" Value="30" />
		<Setter Property="Margin" Value="1" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
							Foreground="{TemplateBinding Foreground}" Text="{Binding Day}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<!-- 호버: 선택 edge보다 먼저 평가 → 선택 셀은 호버해도 Primary/밝은글씨 유지(다크-온-다크 방지) -->
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
			</Trigger>
			<!-- 다른 달 날짜는 흐리게 -->
			<DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
				<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
				<Setter Property="Opacity" Value="0.4" />
			</DataTrigger>
			<!-- 오늘 강조 -->
			<DataTrigger Binding="{Binding IsToday}" Value="True">
				<Setter Property="FontWeight" Value="Bold" />
			</DataTrigger>
			<!-- 범위 내부(시작·끝 사이) — 인접달이어도 Opacity 복원 -->
			<DataTrigger Binding="{Binding IsInRange}" Value="True">
				<Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
				<Setter Property="Opacity" Value="1" />
			</DataTrigger>
			<!-- 시작/끝 edge — 솔리드 Primary(인접달이어도 선명하게) -->
			<DataTrigger Binding="{Binding IsStart}" Value="True">
				<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
				<Setter Property="Opacity" Value="1" />
			</DataTrigger>
			<DataTrigger Binding="{Binding IsEnd}" Value="True">
				<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
				<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
				<Setter Property="Opacity" Value="1" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<!-- Playback 탐지 세션 DataGrid (자체완결 다크 · DynamicResource 토큰만) -->
	<Style x:Key="PbColHeader" TargetType="DataGridColumnHeader">
		<Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridColumnHeader">
					<Border Background="{TemplateBinding Background}" Padding="8,0"
						BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
						<ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"
							TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PbCell" TargetType="DataGridCell">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="DataGridCell">
					<Border Background="{TemplateBinding Background}" Padding="6,2" SnapsToDevicePixels="True">
						<ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextPrimaryBrush}" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="PbRow" TargetType="DataGridRow">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="PbDataGrid" TargetType="DataGrid">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="RowBackground" Value="Transparent" />
		<Setter Property="GridLinesVisibility" Value="Horizontal" />
		<Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="HeadersVisibility" Value="Column" />
		<Setter Property="AutoGenerateColumns" Value="False" />
		<Setter Property="CanUserAddRows" Value="False" />
		<Setter Property="CanUserDeleteRows" Value="False" />
		<Setter Property="CanUserReorderColumns" Value="False" />
		<Setter Property="CanUserResizeRows" Value="False" />
		<Setter Property="IsReadOnly" Value="True" />
		<Setter Property="SelectionMode" Value="Single" />
		<Setter Property="SelectionUnit" Value="FullRow" />
		<Setter Property="RowHeaderWidth" Value="0" />
		<Setter Property="ColumnHeaderHeight" Value="38" />
		<Setter Property="RowHeight" Value="30" />
		<Setter Property="ColumnHeaderStyle" Value="{StaticResource PbColHeader}" />
		<Setter Property="CellStyle" Value="{StaticResource PbCell}" />
		<Setter Property="RowStyle" Value="{StaticResource PbRow}" />
		<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
	</Style>

	<Style TargetType="{x:Type ctrl:PlaybackConsoleControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:PlaybackConsoleControl}">
					<Border
						Width="470"
						Height="550"
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="3" Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!-- 헤더 (드래그) -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16" Height="16"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="PlayCircleOutline" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center" VerticalAlignment="Center"
										FontSize="13" FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="추적 재생 (Playback)" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Command="{Binding CloseCommand}"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!-- 바디 (DataContext = PlaybackViewModel) -->
							<StackPanel Grid.Row="1">
								<!-- 기간 -->
								<StackPanel Margin="12,10,12,8">
									<TextBlock Style="{StaticResource PbSectionLabel}" Text="기간" />
									<StackPanel Margin="0,0,0,6" Orientation="Horizontal">
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="5" Content="최근 5분" />
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="30" Content="30분" />
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="60" Content="1시간" />
										<Button Style="{StaticResource PbChip}" Command="{Binding PresetCommand}" CommandParameter="today" Content="오늘" />
									</StackPanel>
									<StackPanel Orientation="Horizontal">
										<Button
											x:Name="PART_CalendarToggle"
											Margin="0,0,6,0"
											Style="{StaticResource PbChip}"
											Command="{Binding ToggleCalendarCommand}">
											<StackPanel Orientation="Horizontal">
												<md:PackIcon Width="14" Height="14" VerticalAlignment="Center" Kind="CalendarRange" />
												<TextBlock Margin="3,0,0,0" Text="달력" />
											</StackPanel>
										</Button>
										<TextBox Width="116" Style="{StaticResource PbInput}" Text="{Binding FromTime, StringFormat='yyyy-MM-dd HH:mm'}" />
										<TextBlock Margin="6,4" Foreground="{DynamicResource TextMutedBrush}" Text="~" />
										<TextBox Width="116" Style="{StaticResource PbInput}" Text="{Binding ToTime, StringFormat='yyyy-MM-dd HH:mm'}" />
										<Button Margin="8,0,0,0" Style="{StaticResource PanelPrimaryButtonStyle}" Command="{Binding LoadCommand}" Content="불러오기" />
									</StackPanel>

									<!-- 날짜 범위 캘린더 팝업 (첫 클릭=시작일, 둘째 클릭=종료일) -->
									<Popup
										AllowsTransparency="True"
										IsOpen="{Binding IsCalendarOpen, Mode=TwoWay}"
										Placement="Bottom"
										PlacementTarget="{Binding ElementName=PART_CalendarToggle}"
										PopupAnimation="Fade"
										StaysOpen="False">
										<Border
											Width="290"
											Margin="0,4,0,0"
											Padding="10"
											Background="{DynamicResource SurfaceBrush}"
											BorderBrush="{DynamicResource BorderBrush}"
											BorderThickness="1"
											CornerRadius="8">
											<Border.Effect>
												<DropShadowEffect BlurRadius="12" Opacity="0.22" ShadowDepth="3" Color="Black" />
											</Border.Effect>
											<StackPanel>
												<!-- 월 네비게이션 헤더 -->
												<Grid Margin="0,0,0,4">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<Button Grid.Column="0" Style="{StaticResource PbCalNav}" Command="{Binding Calendar.PrevMonthCommand}">
														<md:PackIcon Width="16" Height="16" Kind="ChevronLeft" />
													</Button>
													<TextBlock
														Grid.Column="1"
														HorizontalAlignment="Center" VerticalAlignment="Center"
														FontSize="13" FontWeight="Bold"
														Foreground="{DynamicResource TextPrimaryBrush}"
														Text="{Binding Calendar.MonthLabel}" />
													<Button Grid.Column="2" Style="{StaticResource PbCalNav}" Command="{Binding Calendar.NextMonthCommand}">
														<md:PackIcon Width="16" Height="16" Kind="ChevronRight" />
													</Button>
												</Grid>

												<!-- 요일 헤더 -->
												<UniformGrid Columns="7">
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="일" />
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="월" />
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="화" />
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="수" />
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="목" />
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="금" />
													<TextBlock Style="{StaticResource PbCalWeekday}" Text="토" />
												</UniformGrid>

												<!-- 날짜 그리드 (6주 × 7일) -->
												<ItemsControl ItemsSource="{Binding Calendar.Days}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<UniformGrid Columns="7" Rows="6" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Button
																Style="{StaticResource PbDayCell}"
																Command="{Binding DataContext.Calendar.PickDayCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
																CommandParameter="{Binding}" />
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>

												<!-- 안내 문구 -->
												<TextBlock
													Margin="2,8,0,0"
													FontSize="10.5"
													Foreground="{DynamicResource TextMutedBrush}"
													Text="{Binding Calendar.Hint}" />
											</StackPanel>
										</Border>
									</Popup>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- 탐지 세션 -->
								<StackPanel Margin="12,8">
																		<TextBlock Style="{StaticResource PbSectionLabel}" Text="탐지 세션" />
									<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="250">
										<DataGrid Style="{StaticResource PbDataGrid}" ItemsSource="{Binding Events}">
											<DataGrid.InputBindings>
												<MouseBinding MouseAction="LeftDoubleClick"
													Command="{Binding JumpToSessionCommand}"
													CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
											</DataGrid.InputBindings>
											<DataGrid.Columns>
												<DataGridTemplateColumn Header="표시" Width="54">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
												<DataGridTextColumn Header="탐지 ID" Binding="{Binding SessionId}" Width="*" MinWidth="70" />
												<DataGridTextColumn Header="타입" Binding="{Binding TypeDisplay}" Width="Auto" />
												<DataGridTemplateColumn Header="등급" Width="Auto" SortMemberPath="ThreatText">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<Border Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{Binding ThreatBrush}" CornerRadius="3">
																<TextBlock FontSize="10" Foreground="White" Text="{Binding ThreatText}" />
															</Border>
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
												<DataGridTextColumn Header="시작 ~ 끝" Binding="{Binding TimeRange}" Width="Auto" SortMemberPath="Start" />
												<DataGridTemplateColumn Width="30">
													<DataGridTemplateColumn.CellTemplate>
														<DataTemplate>
															<Button Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"
																Foreground="{DynamicResource TextSecondaryBrush}" Content="⌖" ToolTip="이 세션 위치로 따라보기"
																Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType={x:Type ctrl:PlaybackConsoleControl}}}"
																CommandParameter="{Binding}" />
														</DataTemplate>
													</DataGridTemplateColumn.CellTemplate>
												</DataGridTemplateColumn>
											</DataGrid.Columns>
										</DataGrid>
									</Border>
								</StackPanel>

								<Border Height="1" Background="{DynamicResource BorderBrush}" />

								<!-- 재생 -->
								<StackPanel Margin="12,8,12,12">
									<TextBlock Style="{StaticResource PbSectionLabel}" Text="재생" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Button
											Grid.Column="0"
											Width="36" Height="36"
											FontSize="15" FontWeight="Bold"
											Style="{StaticResource PbPlayToggle}"
											Command="{Binding PlayPauseCommand}"
											Content="{Binding PlayPauseGlyph}" />
										<Slider Grid.Column="1" Margin="9,0" VerticalAlignment="Center" Minimum="0" Maximum="100"
											AutoToolTipPlacement="None" IsSnapToTickEnabled="False" Value="{Binding Progress, Mode=TwoWay}" />
										<TextBlock
											Grid.Column="2"
											MinWidth="118"
											VerticalAlignment="Center"
											FontFamily="Consolas" FontSize="11"
											Foreground="{DynamicResource TextSecondaryBrush}"
											TextAlignment="Right"
											Text="{Binding TimeLabel}" />
									</Grid>
									<StackPanel Margin="0,8,0,0" Orientation="Horizontal">
										<TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="배속" />
										<Button Style="{StaticResource PbSpeedChip}" Tag="0.5" Command="{Binding SpeedCommand}" CommandParameter="0.5" Content="0.5×" />
										<Button Style="{StaticResource PbSpeedChip}" Tag="1" Command="{Binding SpeedCommand}" CommandParameter="1" Content="1×" />
										<Button Style="{StaticResource PbSpeedChip}" Tag="2" Command="{Binding SpeedCommand}" CommandParameter="2" Content="2×" />
										<Button Style="{StaticResource PbSpeedChip}" Tag="4" Command="{Binding SpeedCommand}" CommandParameter="4" Content="4×" />
										<TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Status}" />
									</StackPanel>
								</StackPanel>
							</StackPanel>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
