<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<!--  닫기(✕) 버튼 — 자체완결(앱 StaticResource 미참조)  -->
	<Style x:Key="MapAnchorCloseButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="bg"
						Width="24"
						Height="24"
						Background="Transparent"
						CornerRadius="4">
						<md:PackIcon
							Width="15"
							Height="15"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="{TemplateBinding Foreground}"
							Kind="Close" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="bg" Property="Background" Value="#33FFFFFF" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  섹션 라벨(보조 텍스트)  -->
	<Style x:Key="MapAnchorSectionLabel" TargetType="TextBlock">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="Margin" Value="0,0,0,4" />
	</Style>

	<!--  폼 버튼(채움, PrimaryBrush) — 자체완결(ControlTemplate 스코프서 앱 MD 스타일 미도달 대비)  -->
	<Style x:Key="MapAnchorButton" TargetType="Button">
		<Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Height" Value="32" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="bd"
						Padding="10,0"
						Background="{TemplateBinding Background}"
						CornerRadius="6"
						TextBlock.Foreground="{TemplateBinding Foreground}">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="bd" Property="Opacity" Value="0.88" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="bd" Property="Opacity" Value="0.72" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="bd" Property="Opacity" Value="0.4" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ═══════════════════════════════════════════════════ -->
	<!--  MapAnchorPanelControl 메인 스타일 (LayerPanel 크롬 답습)  -->
	<!-- ═══════════════════════════════════════════════════ -->
	<Style TargetType="{x:Type ctrl:MapAnchorPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:MapAnchorPanelControl}">
					<Border
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  헤더(드래그 가능)  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="CropFree" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{TemplateBinding PanelTitle}" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Command="{TemplateBinding CloseCommand}"
										Style="{StaticResource MapAnchorCloseButtonStyle}" />
								</Grid>
							</Border>

							<!--  바디: 앵커 폼 (DataContext = MapViewModel)  -->
							<ScrollViewer
								Grid.Row="1"
								Padding="0,0,2,0"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Auto">
								<StackPanel Margin="14,12,14,14">
									<CheckBox
										Margin="0,0,0,12"
										Content="사이트 고정 활성"
										Foreground="{DynamicResource TextPrimaryBrush}"
										IsChecked="{Binding AnchorEnabled}" />

									<Button
										Margin="0,0,0,14"
										HorizontalAlignment="Stretch"
										Command="{Binding SetAnchorFromViewCommand}"
										Content="현재 화면을 구역으로 지정"
										Style="{StaticResource MapAnchorButton}" />

									<TextBlock Style="{StaticResource MapAnchorSectionLabel}" Text="북서(NW) 위도 / 경도" />
									<Grid Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBox
											Grid.Column="0"
											Margin="0,0,4,0"
											Text="{Binding AnchorNwLat, StringFormat=F6}" />
										<TextBox
											Grid.Column="1"
											Margin="4,0,0,0"
											Text="{Binding AnchorNwLng, StringFormat=F6}" />
									</Grid>

									<TextBlock Style="{StaticResource MapAnchorSectionLabel}" Text="남동(SE) 위도 / 경도" />
									<Grid Margin="0,0,0,14">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBox
											Grid.Column="0"
											Margin="0,0,4,0"
											Text="{Binding AnchorSeLat, StringFormat=F6}" />
										<TextBox
											Grid.Column="1"
											Margin="4,0,0,0"
											Text="{Binding AnchorSeLng, StringFormat=F6}" />
									</Grid>

									<Grid Margin="0,0,0,14">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Margin="0,0,10,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="최소 줌" />
										<TextBox Grid.Column="1" Text="{Binding AnchorMinZoom}" />
									</Grid>

									<CheckBox
										Margin="0,0,0,16"
										Content="엄격 컨테인먼트 (화면밖 완전차단)"
										Foreground="{DynamicResource TextPrimaryBrush}"
										IsChecked="{Binding AnchorStrict}" />

									<Button
										MinWidth="110"
										HorizontalAlignment="Right"
										Command="{Binding SaveMapAnchorCommand}"
										Content="저장 · 적용"
										Style="{StaticResource MapAnchorButton}" />
								</StackPanel>
							</ScrollViewer>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
