<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:control="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:enums="clr-namespace:Ironwall.Dotnet.Libraries.Enums;assembly=Ironwall.Dotnet.Libraries.Enums"
	xmlns:gmapsymbols="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapSymbols"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:milreg="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapMilitary"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Resources/Resources.xaml" />
	</ResourceDictionary.MergedDictionaries>
	<!--  모든 컨버터 등록  -->
	<utils:AffiliationToColorConverter x:Key="AffiliationToColorConverter" />
	<utils:BattleDimensionToShapeConverter x:Key="BattleDimensionToShapeConverter" />
	<utils:UnitTypeToIconConverter x:Key="UnitTypeToIconConverter" />
	<utils:UnitSizeToSymbolConverter x:Key="UnitSizeToSymbolConverter" />
	<utils:StandardIdentityToStrokeConverter x:Key="StandardIdentityToStrokeConverter" />
	<utils:StandardIdentityToOpacityConverter x:Key="StandardIdentityToOpacityConverter" />
	<utils:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter" />
	<utils:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
	<utils:UnitTypeGroupFilterConverter x:Key="UnitTypeGroupFilterConverter" />

	<!--  BasePropertyStyle에서 가져온 공통 스타일들  -->
	<Style x:Key="CompactTextBox" TargetType="TextBox">
		<Setter Property="Margin" Value="2" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
		<Setter Property="Margin" Value="2" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="FontSize" Value="10" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style x:Key="PropertyLabel" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style x:Key="CommonButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}" CornerRadius="3">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="#882C5F9E" />
			</Trigger>
			<Trigger Property="IsPressed" Value="True">
				<Setter Property="Background" Value="#DD245085" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<!--  소속 구분 라디오 버튼 스타일  -->
	<Style x:Key="AffiliationRadioButtonStyle" TargetType="RadioButton">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="RadioButton">
					<Border
						x:Name="border"
						Padding="8,4"
						Background="#442C5F9E"
						BorderBrush="{DynamicResource PrimaryBrush}"
						BorderThickness="1"
						CornerRadius="3">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}" />
							<Setter Property="Foreground" Value="{DynamicResource OnPrimaryFixedBrush}" />
						</Trigger>
						<Trigger Property="IsChecked" Value="False">
							<Setter TargetName="border" Property="Background" Value="Transparent" />
							<Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#AA2C5F9E" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  메인 컨트롤 스타일  -->
	<Style TargetType="{x:Type milreg:GMapMilitarySymbolRegisterControl}">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="FontFamily" Value="Malgun Gothic" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type milreg:GMapMilitarySymbolRegisterControl}">
					<Border
						x:Name="PART_MainBorder"
						Width="600"
						Height="550"
						Background="{TemplateBinding Background}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="10">

						<!--  드롭 섀도우 효과  -->
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="8"
								Opacity="0.12"
								ShadowDepth="2"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="45" />
								<!--  헤더  -->
								<RowDefinition Height="180" />
								<!--  중심속성  -->
								<RowDefinition Height="*" />
								<!--  내용  -->
								<RowDefinition Height="50" />
								<!--  버튼  -->
							</Grid.RowDefinitions>

							<!--  헤더 영역  -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="35" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="35" />
									</Grid.ColumnDefinitions>

									<!--  아이콘  -->
									<md:PackIcon
										Grid.Column="0"
										Width="20"
										Height="20"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="Shield" />

									<!--  제목  -->
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="14"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="군대 부호 등록" />

									<!--  닫기 버튼  -->
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Command="{TemplateBinding CancelCommand}"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>


							<StackPanel Grid.Row="1" Margin="10">
								<!--  소속 선택  -->
								<Border
									Margin="0,0,0,10"
									Padding="10"
									Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
									CornerRadius="5">
									<StackPanel>
										<TextBlock
											Margin="0,0,0,8"
											FontSize="13"
											FontWeight="Bold"
											Style="{StaticResource PropertyLabel}"
											Text="소속" />
										<UniformGrid Columns="4">
											<RadioButton
												Margin="2"
												Content="알 수 없음"
												GroupName="Affiliation"
												IsChecked="{Binding Affiliation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryAffiliation.Unknown}}" />
											<RadioButton
												Margin="2"
												Content="우군"
												GroupName="Affiliation"
												IsChecked="{Binding Affiliation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryAffiliation.Friend}}" />
											<RadioButton
												Margin="2"
												Content="중립"
												GroupName="Affiliation"
												IsChecked="{Binding Affiliation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryAffiliation.Neutral}}" />
											<RadioButton
												Margin="2"
												Content="적군"
												GroupName="Affiliation"
												IsChecked="{Binding Affiliation, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryAffiliation.Hostile}}" />
										</UniformGrid>
									</StackPanel>
								</Border>

								<!--  공중성 선택  -->
								<Border
									Margin="0,0,0,10"
									Padding="10"
									Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
									CornerRadius="5">
									<StackPanel>
										<TextBlock
                                            
											Margin="0,0,0,8"
											FontSize="13"
											FontWeight="Bold"
											Style="{StaticResource PropertyLabel}"
											Text="공중성" />
										<UniformGrid Height="30" Columns="4">
											<RadioButton
												Margin="2"
												Content="공중"
												GroupName="BattleDimension"
												IsChecked="{Binding BattleDimension, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryBattleDimension.Air}}" />
											<RadioButton
												Margin="2"
												Content="지상"
												GroupName="BattleDimension"
												IsChecked="{Binding BattleDimension, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryBattleDimension.Land}}" />
											<RadioButton
												Margin="2"
												Content="해상"
												GroupName="BattleDimension"
												IsChecked="{Binding BattleDimension, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryBattleDimension.Sea}}" />
											<RadioButton
												Margin="2"
												Content="해저"
												GroupName="BattleDimension"
												IsChecked="{Binding BattleDimension, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EnumMilitaryBattleDimension.Subsurface}}" />
										</UniformGrid>
									</StackPanel>
								</Border>
							</StackPanel>


							<!--  메인 컨텐츠 영역  -->
							<Grid Grid.Row="2" Margin="10,-5,10,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="150" />
									<!--  좌측: 부대 심볼 리스트  -->
									<ColumnDefinition Width="*" />
									<!--  여백  -->
									<ColumnDefinition Width="150" />
									<!--  우측: 속성 입력  -->
								</Grid.ColumnDefinitions>

								<!--  좌측: 부대 심볼 리스트  -->
								<Border
									Grid.Column="0"
									Background="{DynamicResource SurfaceBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="5">
									<StackPanel>
										<!--  타이틀 헤더  -->
										<Border
											Padding="8,4"
											Background="{DynamicResource PrimaryBrush}"
											CornerRadius="4,4,0,0">
											<TextBlock
												HorizontalAlignment="Center"
												FontWeight="Bold"
												Foreground="{DynamicResource OnPrimaryFixedBrush}"
												Text="부대 심볼" />
										</Border>

										<!--  스크롤 가능한 리스트  -->
										<ScrollViewer
											Margin="5"
											Focusable="True"
											HorizontalScrollBarVisibility="Disabled"
											VerticalScrollBarVisibility="Auto">
											<ListBox
												Name="PART_UnitTypeList"
												Background="Transparent"
												BorderThickness="0"
												Focusable="True"
												Foreground="{DynamicResource TextPrimaryBrush}"
												ItemsSource="{TemplateBinding AvailableUnitTypes}"
												SelectedItem="{Binding UnitType, RelativeSource={RelativeSource TemplatedParent}}">
												<ListBox.ItemTemplate>
													<DataTemplate>
														<TextBlock
															Padding="8,4"
															FontSize="12"
															Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</ScrollViewer>
									</StackPanel>
								</Border>

								<!--  미리보기 용 공간  -->
								<Border
									Grid.Column="1"
									Margin="10,0"
									Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
									CornerRadius="5">
									<control:GMapMilitarySymbolMarkerControl
										x:Name="PART_MilitarySymbolPreview"
										Width="80"
										Height="80"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Affiliation="{Binding Affiliation, RelativeSource={RelativeSource TemplatedParent}}"
										BattleDimension="{Binding BattleDimension, RelativeSource={RelativeSource TemplatedParent}}"
										CallSign="{Binding CallSign, RelativeSource={RelativeSource TemplatedParent}}"
										HigherFormation="{Binding HigherFormation, RelativeSource={RelativeSource TemplatedParent}}"
										IsPreviewMode="True"
										UnitDesignator="{Binding UnitDesignator, RelativeSource={RelativeSource TemplatedParent}}"
										UnitSize="{Binding UnitSize, RelativeSource={RelativeSource TemplatedParent}}"
										UnitType="{Binding UnitType, RelativeSource={RelativeSource TemplatedParent}}" />
								</Border>

								<!--  우측: 속성 입력  -->
								<Border
									Grid.Column="2"
									Padding="0"
									Background="{DynamicResource SurfaceBrush}"
									BorderBrush="{DynamicResource BorderBrush}"
									BorderThickness="1"
									CornerRadius="5">
									<StackPanel>
										<!--  타이틀 헤더  -->
										<Border
											Padding="8,4"
											Background="{DynamicResource PrimaryBrush}"
											CornerRadius="4,4,0,0">
											<TextBlock
												HorizontalAlignment="Center"
												FontWeight="Bold"
												Foreground="{DynamicResource OnPrimaryFixedBrush}"
												Text="기본 정보" />
										</Border>

										<StackPanel Margin="10,5,10,10">

										<!--  규모 선택  -->
										<Grid Margin="0,5">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource PropertyLabel}"
												Text="규모" />
											<ComboBox
												Grid.Column="1"
												ItemsSource="{TemplateBinding AvailableUnitSizes}"
												SelectedItem="{Binding UnitSize, RelativeSource={RelativeSource TemplatedParent}}"
												Style="{StaticResource CompactComboBox}">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
										</Grid>

										<!--  부대 지시자  -->
										<Grid Margin="0,5">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource PropertyLabel}"
												Text="부대명" />
											<TextBox
												Grid.Column="1"
												Style="{StaticResource CompactTextBox}"
												Text="{Binding UnitDesignator, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>

										<!--  상급 부대명  -->
										<Grid Margin="0,5">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource PropertyLabel}"
												Text="상급부대" />
											<TextBox
												Grid.Column="1"
												Style="{StaticResource CompactTextBox}"
												Text="{Binding HigherFormation, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>

										<!--  콜 사인  -->
										<Grid Margin="0,5">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource PropertyLabel}"
												Text="콜사인" />
											<TextBox
												Grid.Column="1"
												Style="{StaticResource CompactTextBox}"
												Text="{Binding CallSign, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>

										<!--  국가 코드  -->
										<Grid Margin="0,5">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource PropertyLabel}"
												Text="국가" />
											<TextBox
												Grid.Column="1"
												Style="{StaticResource CompactTextBox}"
												Text="{Binding CountryCode, RelativeSource={RelativeSource TemplatedParent}}" />
										</Grid>

										<!--  계획 속성  -->
										<Grid Margin="0,5">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<TextBlock
												Grid.Column="0"
												Style="{StaticResource PropertyLabel}"
												Text="계획" />
											<ComboBox
												Grid.Column="1"
												ItemsSource="{TemplateBinding AvailableStandardIdentities}"
												SelectedItem="{Binding StandardIdentity, RelativeSource={RelativeSource TemplatedParent}}"
												Style="{StaticResource CompactComboBox}">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
										</Grid>
									</StackPanel>
									</StackPanel>
								</Border>
							</Grid>

							<!--  하단 버튼 영역  -->
							<Border
								Grid.Row="3"
								Padding="10,5"
								CornerRadius="0,0,8,8">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button
										Grid.Column="0"
										Height="30"
										Margin="0,0,4,0"
										Command="{TemplateBinding CancelCommand}"
										Content="취소"
										Style="{StaticResource PanelDangerButtonStyle}" />
									<Button
										Grid.Column="1"
										Height="30"
										Margin="4,0,0,0"
										Command="{TemplateBinding RegisterCommand}"
										Content="등록"
										Style="{StaticResource PanelPrimaryButtonStyle}" />
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>