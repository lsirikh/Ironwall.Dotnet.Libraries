<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:models="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Models"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<utils:OpacityToPercentConverter x:Key="OpacityToPercent" />
	<BooleanToVisibilityConverter x:Key="BoolToVis" />

	<!-- 체크박스 -->
	<Style x:Key="LayerCheckBox" TargetType="CheckBox">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,3,0" />
	</Style>

	<!-- 개수 배지 -->
	<DataTemplate x:Key="CountBadge">
		<Border
			MinWidth="20"
			Margin="6,0,0,0"
			Padding="5,1"
            VerticalAlignment="Center"
			Background="{StaticResource LightBlueBrush}"
			CornerRadius="8">
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="9"
				FontWeight="Bold"
				Foreground="{StaticResource PrimaryBlueBrush}"
				Text="{Binding}" />
		</Border>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Leaf 노드 (심볼: 체크 + 아이콘 + 이름)             -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="LeafNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<Grid Height="20" Margin="10,3,0,3" ToolTip="{Binding Name}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<CheckBox
				Grid.Column="0"
				IsChecked="{Binding IsChecked, Mode=TwoWay}"
				Style="{StaticResource LayerCheckBox}" />
			<md:PackIcon
				Grid.Column="1"
				Width="14"
				Height="14"
				Margin="0,0,5,0"
				VerticalAlignment="Center"
				Kind="{Binding IconKind}">
				<md:PackIcon.Style>
					<Style TargetType="md:PackIcon">
						<Setter Property="Foreground" Value="#444" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsChecked}" Value="False">
								<Setter Property="Foreground" Value="#CCC" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</md:PackIcon.Style>
			</md:PackIcon>
			<TextBlock
				Grid.Column="2"
				VerticalAlignment="Center"
				FontSize="12"
				TextTrimming="CharacterEllipsis"
				TextOptions.TextRenderingMode="ClearType"
				TextOptions.TextFormattingMode="Display">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Foreground" Value="#222" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsChecked}" Value="False">
								<Setter Property="Foreground" Value="#AAA" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
				<Run Text="{Binding Name, Mode=OneWay}" />
			</TextBlock>
		</Grid>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Leaf 노드 (오버레이: 체크 + 이름 + 슬라이더)       -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="OverlayLeafTemplate" DataType="{x:Type models:LayerTreeNode}">
		<Grid Height="26" Margin="0,1" ToolTip="{Binding Name}">
			<Grid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="삭제" Command="{Binding DeleteCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="Delete" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="위로" Command="{Binding MoveUpCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="ArrowUp" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="아래로" Command="{Binding MoveDownCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="ArrowDown" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</Grid.ContextMenu>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="60" />
				<ColumnDefinition Width="30" />
			</Grid.ColumnDefinitions>
			<CheckBox
				Grid.Column="0"
				IsChecked="{Binding IsChecked, Mode=TwoWay}"
				Style="{StaticResource LayerCheckBox}" />
			<TextBlock
				Grid.Column="1"
				VerticalAlignment="Center"
				FontSize="12"
				Foreground="#222"
				Text="{Binding Name}"
				TextOptions.TextRenderingMode="ClearType"
				TextOptions.TextFormattingMode="Display"
				TextTrimming="CharacterEllipsis" />
			<Slider
				Grid.Column="2"
				VerticalAlignment="Center"
				IsEnabled="{Binding IsChecked}"
				Maximum="100"
				Minimum="0"
				SmallChange="10"
				LargeChange="10"
				TickFrequency="10"
				IsSnapToTickEnabled="True"
				Value="{Binding Opacity, Mode=TwoWay, Converter={StaticResource OpacityToPercent}}" />
			<TextBlock
				Grid.Column="3"
				VerticalAlignment="Center"
				FontSize="9"
				Foreground="#888"
				Text="{Binding Opacity, StringFormat={}{0:P0}}" />
		</Grid>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Group 노드 (Expander 제거 → 직접 구현, 공간 최소화) -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="GroupNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<StackPanel Margin="0,2,0,0">
			<!-- 그룹 헤더 (클릭 시 접기/펼치기) -->
			<Grid Height="24" Margin="10,0,4,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<CheckBox
					Grid.Column="0"
					IsChecked="{Binding IsChecked, Mode=TwoWay}"
					IsThreeState="True"
					Style="{StaticResource LayerCheckBox}" />
				<md:PackIcon
					Grid.Column="1"
					Width="15"
					Height="15"
					Margin="0,0,4,0"
					VerticalAlignment="Center"
					Foreground="{StaticResource PrimaryBlueBrush}"
					Kind="{Binding IconKind}" />
				<TextBlock
					Grid.Column="2"
					VerticalAlignment="Center"
					FontSize="12"
					FontWeight="SemiBold"
					Foreground="#222"
					Text="{Binding Name}"
					TextOptions.TextRenderingMode="ClearType"
					TextOptions.TextFormattingMode="Display" />
				<ContentPresenter
					Grid.Column="4"
					Content="{Binding ItemCount}"
					ContentTemplate="{StaticResource CountBadge}" />
				<!-- 접기/펼치기 토글 -->
				<ToggleButton
					Grid.Column="5"
					Width="18"
					Height="18"
					Margin="4,0,0,0"
					IsChecked="{Binding IsExpanded, Mode=TwoWay}"
					Background="Transparent"
					BorderThickness="0"
					Cursor="Hand">
					<ToggleButton.Style>
						<Style TargetType="ToggleButton">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="Transparent">
											<md:PackIcon
												x:Name="Arrow"
												Width="14"
												Height="14"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Foreground="#888"
												Kind="ChevronDown"
												RenderTransformOrigin="0.5,0.5">
												<md:PackIcon.RenderTransform>
													<RotateTransform Angle="0" />
												</md:PackIcon.RenderTransform>
											</md:PackIcon>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsChecked" Value="False">
												<Setter TargetName="Arrow" Property="RenderTransform">
													<Setter.Value>
														<RotateTransform Angle="-90" />
													</Setter.Value>
												</Setter>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ToggleButton.Style>
				</ToggleButton>
			</Grid>
			<!-- 자식 Leaf 노드 (접기 가능) -->
			<ItemsControl Margin="20,0,0,0" ItemsSource="{Binding Children}">
				<ItemsControl.Style>
					<Style TargetType="ItemsControl">
						<Setter Property="Visibility" Value="Visible" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ItemsControl.Style>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type models:LayerTreeNode}">
						<ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafNodeTemplate}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Section 자식 자동 선택 (Group / Leaf / Overlay)     -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="SectionChildTemplate" DataType="{x:Type models:LayerTreeNode}">
		<ContentPresenter Content="{Binding}">
			<ContentPresenter.Style>
				<Style TargetType="ContentPresenter">
					<Setter Property="ContentTemplate" Value="{StaticResource LeafNodeTemplate}" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding NodeType}" Value="Group">
							<Setter Property="ContentTemplate" Value="{StaticResource GroupNodeTemplate}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding HasOpacitySlider}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource OverlayLeafTemplate}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ContentPresenter.Style>
		</ContentPresenter>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Section 노드 (블루 헤더 Expander + 자식 / 빈 메시지) -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="SectionNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<StackPanel Margin="0,4,0,0">
			<!-- 섹션 헤더 바 (클릭 시 접기/펼치기) -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Border
					Grid.Column="0"
					Padding="8,4"
					Background="{StaticResource PrimaryBlueBrush}"
					CornerRadius="4">
					<TextBlock
						VerticalAlignment="Center"
						FontSize="10.5"
						FontWeight="Bold"
						Foreground="White"
						Text="{Binding Name}"
						TextOptions.TextRenderingMode="ClearType"
						TextOptions.TextFormattingMode="Display" />
				</Border>
				<ToggleButton
					Grid.Column="1"
					Width="20"
					Height="20"
					Margin="2,0,0,0"
					IsChecked="{Binding IsExpanded, Mode=TwoWay}"
					Background="Transparent"
					BorderThickness="0"
					Cursor="Hand">
					<ToggleButton.Style>
						<Style TargetType="ToggleButton">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ToggleButton">
										<Border Background="Transparent">
											<md:PackIcon
												x:Name="Arrow"
												Width="14"
												Height="14"
												Foreground="#888"
												Kind="ChevronDown"
												RenderTransformOrigin="0.5,0.5">
												<md:PackIcon.RenderTransform>
													<RotateTransform Angle="0" />
												</md:PackIcon.RenderTransform>
											</md:PackIcon>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsChecked" Value="False">
												<Setter TargetName="Arrow" Property="RenderTransform">
													<Setter.Value>
														<RotateTransform Angle="-90" />
													</Setter.Value>
												</Setter>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ToggleButton.Style>
				</ToggleButton>
			</Grid>
			<!-- 자식 목록 (접기 가능) -->
			<StackPanel Margin="4,2,0,0">
				<StackPanel.Style>
					<Style TargetType="StackPanel">
						<Setter Property="Visibility" Value="Visible" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</StackPanel.Style>
				<ItemsControl
					ItemTemplate="{StaticResource SectionChildTemplate}"
					ItemsSource="{Binding Children}" />
				<!-- 빈 상태 메시지 -->
				<TextBlock
					Margin="4,2,0,2"
					FontSize="10"
					FontStyle="Italic"
					Foreground="#999"
					Text="등록된 항목이 없습니다">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Children.Count}" Value="0">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- 메인 스타일                                         -->
	<!-- ═══════════════════════════════════════════════════ -->
	<Style TargetType="{x:Type ctrl:LayerPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:LayerPanelControl}">
					<Border
						Width="250"
						Background="White"
						BorderBrush="{StaticResource BorderGrayBrush}"
						BorderThickness="1"
						ClipToBounds="True"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!-- 헤더 -->
							<Border
								Grid.Row="0"
								Background="{StaticResource PrimaryBlueBrush}"
								CornerRadius="9,9,0,0"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="White"
										Kind="Layers" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="White"
										Text="{TemplateBinding PanelTitle}" />
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!-- 바디: 트리 구조 -->
							<ScrollViewer
								x:Name="PART_TreeView"
								Grid.Row="1"
								Padding="0,0,2,0"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Auto">
								<ItemsControl
									Margin="8,2,8,8"
									ItemTemplate="{StaticResource SectionNodeTemplate}"
									ItemsSource="{Binding TreeNodes, RelativeSource={RelativeSource TemplatedParent}}" />
							</ScrollViewer>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
