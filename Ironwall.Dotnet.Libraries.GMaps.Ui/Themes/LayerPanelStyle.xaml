<ResourceDictionary
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:drag="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Behaviors.Drag;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:models="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Models"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils">

	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
	</ResourceDictionary.MergedDictionaries>

	<utils:OpacityToPercentConverter x:Key="OpacityToPercent" />
	<BooleanToVisibilityConverter x:Key="BoolToVis" />

	<!-- 체크박스 -->
	<Style x:Key="LayerCheckBox" TargetType="CheckBox">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="0,0,3,0" />
	</Style>

	<!-- 개수 배지 -->
	<DataTemplate x:Key="CountBadge">
		<Border
			MinWidth="20"
			Margin="6,0,0,0"
			Padding="5,1"
            VerticalAlignment="Center"
			Background="{DynamicResource SurfaceAltBrush}"
			CornerRadius="8">
			<!--  L5 — 9px 는 읽기 한계 아래였다 → 11  -->
			<TextBlock
				HorizontalAlignment="Center"
				FontSize="11"
				FontWeight="Bold"
				Foreground="{DynamicResource PrimaryBrush}"
				Text="{Binding}" />
		</Border>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Leaf 노드 (심볼: 체크 + 아이콘 + 이름)             -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="LeafNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<Grid Height="20" Margin="0,3,0,3" ToolTip="{Binding Name}">
			<!-- 개별 심볼 리프 컨텍스트(이동만 활성, NavigateCommand 게이팅). 카테고리 단위 레거시 Leaf에선 비활성(FR-04). -->
			<Grid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="지도 가운데로 이동" Command="{Binding NavigateCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="CrosshairsGps" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="이름 바꾸기" Command="{Binding RenameCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="RenameBox" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="{Binding LockToggleHeader}" Command="{Binding ToggleLockCommand}">
						<MenuItem.Icon>
							<md:PackIcon Width="16" Height="16">
								<md:PackIcon.Style>
									<Style TargetType="md:PackIcon">
										<Setter Property="Kind" Value="LockOpenVariantOutline" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsLocked}" Value="True">
												<Setter Property="Kind" Value="Lock" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</md:PackIcon.Style>
							</md:PackIcon>
						</MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</Grid.ContextMenu>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<CheckBox
				Grid.Column="0"
				IsChecked="{Binding IsChecked, Mode=TwoWay}"
				Style="{StaticResource LayerCheckBox}" />
			<!-- 잠금 토글 아이콘 (열림/잠김) — FR-03. 체크박스 뒤로 이동 (순서 교환). -->
			<Button
				Grid.Column="1"
				Width="18"
				Height="18"
				Margin="0,0,4,0"
				Padding="0"
				Command="{Binding ToggleLockCommand}"
				Background="Transparent"
				BorderThickness="0"
				Cursor="Hand">
				<Button.Style>
					<Style TargetType="Button">
						<!--  L6 — 도움말은 늘 "잠금/잠금해제" 였다: 지금 누르면 무엇이 되는지(잠금 · 잠금 해제), 꺼졌으면 그 까닭  -->
						<Setter Property="ToolTip" Value="{Binding LockToggleHeader}" />
						<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
						<Setter Property="AutomationProperties.Name" Value="{Binding LockToggleHeader}" />
						<Style.Triggers>
							<!-- 맵 편집 권한 없음(CanExecute=false) → 자물쇠 흐림 처리(비활성 가시화) -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.35" />
								<Setter Property="ToolTip" Value="편집 권한이 없습니다" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent">
							<md:PackIcon Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
								<md:PackIcon.Style>
									<Style TargetType="md:PackIcon">
										<Setter Property="Kind" Value="LockOpenVariantOutline" />
										<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsLocked}" Value="True">
												<Setter Property="Kind" Value="Lock" />
												<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</md:PackIcon.Style>
							</md:PackIcon>
						</Border>
					</ControlTemplate>
				</Button.Template>
			</Button>
			<!-- 이름 표시 / 인라인 편집(FR-04). 실제 심볼 리프는 제목 앞 아이콘 제외(요청). -->
			<Grid Grid.Column="2">
				<TextBlock
					VerticalAlignment="Center"
					FontSize="12"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis"
					TextOptions.TextRenderingMode="ClearType"
					TextOptions.TextFormattingMode="Display">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsEditing}" Value="True">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<DataTrigger Binding="{Binding IsChecked}" Value="False">
									<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
				<TextBox
					VerticalAlignment="Center"
					FontSize="12"
					Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					utils:TextBoxRenameHelper.IsRenaming="{Binding IsEditing}"
					utils:TextBoxRenameHelper.CommitCommand="{Binding CommitRenameCommand}"
					utils:TextBoxRenameHelper.CancelCommand="{Binding CancelRenameCommand}">
					<TextBox.Style>
						<Style TargetType="TextBox">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsEditing}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBox.Style>
				</TextBox>
			</Grid>
		</Grid>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Leaf 노드 (오버레이: 체크 + 이름 + 슬라이더)       -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="OverlayLeafTemplate" DataType="{x:Type models:LayerTreeNode}">
		<Grid Height="26" Margin="0,1" ToolTip="{Binding Name}">
			<Grid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="삭제" Command="{Binding DeleteCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="Delete" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="이름 바꾸기" Command="{Binding RenameCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="RenameBox" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="위로" Command="{Binding MoveUpCommand}" InputGestureText="Alt+↑">
						<MenuItem.Icon>
							<md:PackIcon Kind="ArrowUp" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem Header="아래로" Command="{Binding MoveDownCommand}" InputGestureText="Alt+↓">
						<MenuItem.Icon>
							<md:PackIcon Kind="ArrowDown" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="지도 가운데로 이동" Command="{Binding NavigateCommand}">
						<MenuItem.Icon>
							<md:PackIcon Kind="CrosshairsGps" Width="16" Height="16" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem Header="{Binding LockToggleHeader}" Command="{Binding ToggleLockCommand}">
						<MenuItem.Icon>
							<md:PackIcon Width="16" Height="16">
								<md:PackIcon.Style>
									<Style TargetType="md:PackIcon">
										<Setter Property="Kind" Value="LockOpenVariantOutline" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsLocked}" Value="True">
												<Setter Property="Kind" Value="Lock" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</md:PackIcon.Style>
							</md:PackIcon>
						</MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</Grid.ContextMenu>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="60" />
				<ColumnDefinition Width="30" />
			</Grid.ColumnDefinitions>
			<!--
				D-36 끌기 손잡이 — 행 본체가 아니라 이 손잡이에서만 끌기가 시작된다(행 클릭 = 선택 · 체크 · 슬라이더 그대로).
				왼쪽에 둔다: 오른쪽 6px 은 패널 폭 그립(PART_ResizeRight), 맨 위 36px 은 패널 이동 영역이다.
				커널 DragHandle(Thumb 파생 — UIA peer 실재, 6점 그립). 편집 권한이 없으면 꺼진다(우클릭 위로/아래로와 같은 관문).
			-->
			<drag:DragHandle
				Grid.Column="0"
				Width="14"
				Margin="0,0,2,0"
				AutomationProperties.AutomationId="{Binding Model.Id, StringFormat=GMaps.LayerPanel.DragHandle.{0}}"
				AutomationProperties.Name="레이어 순서 손잡이"
				IsEnabled="{Binding IsMapEditable}"
				ToolTip="순서 바꾸기 (Alt+↑ / Alt+↓)" />
			<CheckBox
				Grid.Column="1"
				IsChecked="{Binding IsChecked, Mode=TwoWay}"
				Style="{StaticResource LayerCheckBox}" />
			<!-- 잠금 토글 아이콘 (열림/잠김) — FR-03. 체크박스 뒤로 이동 (순서 교환). -->
			<Button
				Grid.Column="2"
				Width="18"
				Height="18"
				Margin="0,0,4,0"
				Padding="0"
				VerticalAlignment="Center"
				Command="{Binding ToggleLockCommand}"
				Background="Transparent"
				BorderThickness="0"
				Cursor="Hand">
				<Button.Style>
					<Style TargetType="Button">
						<!--  L6 — 도움말은 늘 "잠금/잠금해제" 였다: 지금 누르면 무엇이 되는지(잠금 · 잠금 해제), 꺼졌으면 그 까닭  -->
						<Setter Property="ToolTip" Value="{Binding LockToggleHeader}" />
						<Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
						<Setter Property="AutomationProperties.Name" Value="{Binding LockToggleHeader}" />
						<Style.Triggers>
							<!-- 맵 편집 권한 없음(CanExecute=false) → 자물쇠 흐림 처리(비활성 가시화) -->
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.35" />
								<Setter Property="ToolTip" Value="편집 권한이 없습니다" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent">
							<md:PackIcon Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
								<md:PackIcon.Style>
									<Style TargetType="md:PackIcon">
										<Setter Property="Kind" Value="LockOpenVariantOutline" />
										<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsLocked}" Value="True">
												<Setter Property="Kind" Value="Lock" />
												<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</md:PackIcon.Style>
							</md:PackIcon>
						</Border>
					</ControlTemplate>
				</Button.Template>
			</Button>
			<!-- 이름 표시 / 인라인 편집 -->
			<Grid Grid.Column="3">
				<TextBlock
					VerticalAlignment="Center"
					FontSize="12"
					Text="{Binding Name}"
					TextOptions.TextRenderingMode="ClearType"
					TextOptions.TextFormattingMode="Display"
					TextTrimming="CharacterEllipsis">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Visible" />
							<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsEditing}" Value="True">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
								<!--  L4 — 끈 오버레이는 이름도 흐리게(심볼 리프와 같은 규칙)  -->
								<DataTrigger Binding="{Binding IsChecked}" Value="False">
									<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
				<TextBox
					VerticalAlignment="Center"
					FontSize="12"
					Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					utils:TextBoxRenameHelper.IsRenaming="{Binding IsEditing}"
					utils:TextBoxRenameHelper.CommitCommand="{Binding CommitRenameCommand}"
					utils:TextBoxRenameHelper.CancelCommand="{Binding CancelRenameCommand}">
					<TextBox.Style>
						<Style TargetType="TextBox">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsEditing}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBox.Style>
				</TextBox>
			</Grid>
			<!--  좌우 여백: MD3 슬라이더 손잡이는 트랙 끝에서 반지름만큼 넘친다 — 이름 끝과 % 글자를 덮지 않게 비워 둔다.  -->
			<Slider
				Grid.Column="4"
				Margin="6,0,8,0"
				VerticalAlignment="Center"
				IsEnabled="{Binding IsChecked}"
				Maximum="100"
				Minimum="0"
				SmallChange="10"
				LargeChange="10"
				TickFrequency="10"
				IsSnapToTickEnabled="True"
				Value="{Binding Opacity, Mode=TwoWay, Converter={StaticResource OpacityToPercent}}" />
			<!--  L4 · L5 — 끈 오버레이는 투명도 대신 "끔"(슬라이더는 이미 꺼진다). 글자 9 → 11  -->
			<TextBlock
				Grid.Column="5"
				VerticalAlignment="Center"
				FontSize="11"
				Foreground="{DynamicResource TextMutedBrush}">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Text" Value="{Binding Opacity, StringFormat={}{0:P0}}" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsChecked}" Value="False">
								<Setter Property="Text" Value="끔" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Grid>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- 노드 헤더 행 (Group/Category 공용: 체크 + 아이콘 + 이름 + 배지 + 셰브런) -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="NodeRowTemplate" DataType="{x:Type models:LayerTreeNode}">
		<Grid Height="24" Margin="0,0,4,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<CheckBox
				Grid.Column="0"
				IsChecked="{Binding IsChecked, Mode=TwoWay}"
				IsThreeState="True"
				Style="{StaticResource LayerCheckBox}" />
			<md:PackIcon
				Grid.Column="1"
				Width="15"
				Height="15"
				Margin="0,0,4,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource PrimaryBrush}"
				Kind="{Binding IconKind}" />
			<TextBlock
				Grid.Column="2"
				VerticalAlignment="Center"
				FontSize="12"
				FontWeight="SemiBold"
				Foreground="{DynamicResource TextPrimaryBrush}"
				Text="{Binding Name}"
				TextTrimming="CharacterEllipsis"
				TextOptions.TextRenderingMode="ClearType"
				TextOptions.TextFormattingMode="Display" />
			<ContentPresenter
				Grid.Column="4"
				Content="{Binding ItemCount}"
				ContentTemplate="{StaticResource CountBadge}" />
			<!-- 접기/펼치기 토글 -->
			<ToggleButton
				Grid.Column="5"
				Width="18"
				Height="18"
				Margin="4,0,0,0"
				IsChecked="{Binding IsExpanded, Mode=TwoWay}"
				Background="Transparent"
				BorderThickness="0"
				Cursor="Hand">
				<ToggleButton.Style>
					<Style TargetType="ToggleButton">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="Transparent">
										<md:PackIcon
											x:Name="Arrow"
											Width="14"
											Height="14"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Foreground="{DynamicResource TextMutedBrush}"
											Kind="ChevronDown"
											RenderTransformOrigin="0.5,0.5">
											<md:PackIcon.RenderTransform>
												<RotateTransform Angle="0" />
											</md:PackIcon.RenderTransform>
										</md:PackIcon>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsChecked" Value="False">
											<Setter TargetName="Arrow" Property="RenderTransform">
												<Setter.Value>
													<RotateTransform Angle="-90" />
												</Setter.Value>
											</Setter>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ToggleButton.Style>
			</ToggleButton>
		</Grid>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Category 노드 (헤더 + 개별 심볼 Leaf 자식). 전부 StaticResource(전방참조 없음). -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="CategoryNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<StackPanel Margin="0,2,0,0">
			<ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeRowTemplate}" />
			<ItemsControl Margin="12,0,0,0" ItemsSource="{Binding Children}">
				<ItemsControl.Style>
					<Style TargetType="ItemsControl">
						<Setter Property="Visibility" Value="Visible" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ItemsControl.Style>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type models:LayerTreeNode}">
						<ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafNodeTemplate}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Group 노드 (헤더 + Category 자식). PIDS 장비 전용. -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="GroupNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<StackPanel Margin="0,2,0,0">
			<ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NodeRowTemplate}" />
			<ItemsControl Margin="12,0,0,0" ItemsSource="{Binding Children}">
				<ItemsControl.Style>
					<Style TargetType="ItemsControl">
						<Setter Property="Visibility" Value="Visible" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ItemsControl.Style>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type models:LayerTreeNode}">
						<ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CategoryNodeTemplate}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Section 자식 자동 선택 (Group / Category / Leaf / Overlay) -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="SectionChildTemplate" DataType="{x:Type models:LayerTreeNode}">
		<ContentPresenter Content="{Binding}">
			<ContentPresenter.Style>
				<Style TargetType="ContentPresenter">
					<Setter Property="ContentTemplate" Value="{StaticResource LeafNodeTemplate}" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding NodeType}" Value="Group">
							<Setter Property="ContentTemplate" Value="{StaticResource GroupNodeTemplate}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding NodeType}" Value="Category">
							<Setter Property="ContentTemplate" Value="{StaticResource CategoryNodeTemplate}" />
						</DataTrigger>
						<DataTrigger Binding="{Binding HasOpacitySlider}" Value="True">
							<Setter Property="ContentTemplate" Value="{StaticResource OverlayLeafTemplate}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ContentPresenter.Style>
		</ContentPresenter>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- D-36 오버레이 순서 목록 (끌기 · Alt+↑↓ · 우클릭 위로/아래로) -->
	<!-- ═══════════════════════════════════════════════════ -->
	<!--
		행 컨테이너 — 예전 모습(배경 · 줄 없음)을 그대로 두고, 선택 = 좌측 3px 세로 바 / 키보드 초점 = 가는 고리(형태로 구분).
		드롭 위치는 커널 삽입선(행 사이 가로선, AdornerLayer)이 그린다 — 컨테이너에 로컬 값을 쓰지 않는다.
		배경 틴트(SurfaceHover/Pressed)는 쓰지 않는다: 전이 대비가 1.15~1.30:1 이라 상태 구분이 안 된다.
		x:Name 을 두지 않는다 — 템플릿 요소는 TemplatedParent 바인딩으로만 켠다.
	-->
	<Style x:Key="LayerReorderItemStyle" TargetType="ListBoxItem">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0" />
		<Setter Property="FocusVisualStyle" Value="{x:Null}" />
		<Setter Property="AutomationProperties.AutomationId" Value="{Binding Model.Id, StringFormat=GMaps.LayerPanel.Row.{0}}" />
		<Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBoxItem">
					<Grid Background="Transparent">
						<Rectangle
							Width="3"
							Margin="0,3"
							HorizontalAlignment="Left"
							Fill="{DynamicResource PrimaryBrush}"
							IsHitTestVisible="False"
							RadiusX="1.5"
							RadiusY="1.5"
							Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
						<Border
							BorderBrush="{DynamicResource FocusRingBrush}"
							BorderThickness="1"
							CornerRadius="3"
							IsHitTestVisible="False"
							Visibility="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
						<ContentPresenter Margin="5,0,0,0" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--
		목록 자체 — 가상화 없음(화면 밖 행은 드롭 자리가 될 수 없다; 오버레이는 전량 로딩).
		템플릿에 ScrollViewer 를 두지 않는다: ListBox 기본 템플릿의 안쪽 ScrollViewer 는 굴릴 것이 없어도 휠을 삼켜
		패널(PART_TreeView) 스크롤이 이 목록 위에서 멈춘다. 대가: 커널 경계 오토스크롤은 목록 안의 ScrollViewer 만 찾으므로
		이 패널에서는 동작하지 않는다(키보드 폴백 · 휠로 대신한다).
	-->
	<Style x:Key="LayerReorderListStyle" TargetType="ListBox">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="SelectionMode" Value="Single" />
		<Setter Property="IsTextSearchEnabled" Value="False" />
		<Setter Property="ScrollViewer.CanContentScroll" Value="False" />
		<Setter Property="VirtualizingPanel.IsVirtualizing" Value="False" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource LayerReorderItemStyle}" />
		<Setter Property="ItemsPanel">
			<Setter.Value>
				<ItemsPanelTemplate>
					<StackPanel />
				</ItemsPanelTemplate>
			</Setter.Value>
		</Setter>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ListBox">
					<Border Background="{TemplateBinding Background}">
						<ItemsPresenter />
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- SYMBOLS 등 — 순서 바꾸기 없음(예전 그대로 ItemsControl) -->
	<DataTemplate x:Key="SectionChildrenPlainTemplate" DataType="{x:Type models:LayerTreeNode}">
		<ItemsControl ItemTemplate="{StaticResource SectionChildTemplate}" ItemsSource="{Binding Children}" />
	</DataTemplate>

	<!--
		OVERLAY MAP · OVERLAY IMAGE — 같은 섹션의 평평한 리프끼리만 순서를 바꾼다(판정: LayerReorderRules).
		끌기와 Alt+↑↓ 는 같은 담당(LayerPanelControl.ReorderHandler)을 부른다 — 회귀 단언은 키보드 경로로.
		목록 순서 = ZOrder 오름차순 = 지도에서 먼저(아래에) 그려지는 순서. 맨 위 행이 지도에서는 맨 아래다(의미 변경 없음).
	-->
	<DataTemplate x:Key="SectionChildrenReorderTemplate" DataType="{x:Type models:LayerTreeNode}">
		<ListBox
			drag:DropZone.Handler="{Binding ReorderHandler, RelativeSource={RelativeSource AncestorType={x:Type ctrl:LayerPanelControl}}}"
			drag:DropZone.IsReorder="True"
			drag:DropZone.Key="{x:Static models:LayerReorderRules.ZoneKey}"
			AutomationProperties.AutomationId="{Binding OverlayLayerType, StringFormat=GMaps.LayerPanel.List.{0}}"
			ItemTemplate="{StaticResource SectionChildTemplate}"
			ItemsSource="{Binding Children}"
			Style="{StaticResource LayerReorderListStyle}">
			<b:Interaction.Behaviors>
				<!--  손잡이에서만 끌기가 시작된다 · 데드존 8.0 미만은 클릭(행 선택) · Esc 취소  -->
				<drag:CaptureDragBehavior DisplayMemberPath="Name" KeyboardFallback="행을 고른 뒤 Alt+↑ · Alt+↓ / 우클릭 '위로' · '아래로'" />
				<!--  키보드 폴백 — 드래그와 같은 담당(DropZone.Handler)을 부른다  -->
				<drag:ReorderKeyboardBehavior />
			</b:Interaction.Behaviors>
		</ListBox>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- Section 노드 (블루 헤더 Expander + 자식 / 빈 메시지) -->
	<!-- ═══════════════════════════════════════════════════ -->
	<DataTemplate x:Key="SectionNodeTemplate" DataType="{x:Type models:LayerTreeNode}">
		<StackPanel Margin="0,4,0,0">
			<!--
				섹션 머리(L1 · L3 · L5) — 예전에는 파란 띠가 이름 칸(*)에만 있고 셰브런이 띠 밖 22px 흰 여백에 떨어져
				"머리 띠가 폭 일부만 덮는" 모양이었다. 이제 띠 하나가 행 전체를 덮는다:
				[전체 체크] [이름 (개수)] ………… [셰브런]. 체크를 뺀 나머지 전체가 접기/펼치기 단추다.
				전체 체크는 그룹 행과 같은 tri-state(IsChecked — 자식으로 내려가고 자식에서 올라온다). 자식이 없으면 숨긴다.
				색이 아니라 형태로: 채운 파랑 대신 SurfaceAlt 띠 + 왼쪽 Primary 세로 바.
			-->
			<Border
				MinHeight="28"
				Background="{DynamicResource SurfaceAltBrush}"
				BorderBrush="{DynamicResource DividerBrush}"
				BorderThickness="0,0,0,1"
				CornerRadius="4,4,0,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Rectangle
						Grid.Column="0"
						Width="3"
						Margin="0,4"
						Fill="{DynamicResource PrimaryBrush}"
						RadiusX="1.5"
						RadiusY="1.5" />
					<CheckBox
						Grid.Column="1"
						Margin="6,0,2,0"
						AutomationProperties.Name="{Binding Name, StringFormat={}{0} 전체 보이기}"
						IsChecked="{Binding IsChecked, Mode=TwoWay}"
						IsThreeState="True">
						<CheckBox.Style>
							<Style BasedOn="{StaticResource LayerCheckBox}" TargetType="CheckBox">
								<Style.Triggers>
									<!--  심볼 섹션은 전체 체크를 두지 않는다 — 수백 개 심볼 가시성을 한 번에 바꾸는 것은 카테고리 · 그룹 행이 맡는다  -->
									<DataTrigger Binding="{Binding IsReorderSection}" Value="False">
										<Setter Property="Visibility" Value="Collapsed" />
									</DataTrigger>
									<DataTrigger Binding="{Binding Children.Count}" Value="0">
										<Setter Property="Visibility" Value="Hidden" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</CheckBox.Style>
					</CheckBox>
					<ToggleButton
						Grid.Column="2"
						Padding="4,0,6,0"
						HorizontalContentAlignment="Stretch"
						AutomationProperties.Name="{Binding Name, StringFormat={}{0} 접기 · 펼치기}"
						Cursor="Hand"
						IsChecked="{Binding IsExpanded, Mode=TwoWay}">
						<ToggleButton.Style>
							<Style TargetType="ToggleButton">
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="ToggleButton">
											<Border Padding="{TemplateBinding Padding}" Background="Transparent">
												<DockPanel LastChildFill="True">
													<md:PackIcon
														x:Name="Arrow"
														Width="16"
														Height="16"
														VerticalAlignment="Center"
														DockPanel.Dock="Right"
														Foreground="{DynamicResource TextSecondaryBrush}"
														Kind="ChevronDown"
														RenderTransformOrigin="0.5,0.5">
														<md:PackIcon.RenderTransform>
															<RotateTransform Angle="0" />
														</md:PackIcon.RenderTransform>
													</md:PackIcon>
													<ContentPresenter VerticalAlignment="Center" />
												</DockPanel>
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsChecked" Value="False">
													<Setter TargetName="Arrow" Property="RenderTransform">
														<Setter.Value>
															<RotateTransform Angle="-90" />
														</Setter.Value>
													</Setter>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</ToggleButton.Style>
						<StackPanel Orientation="Horizontal">
							<TextBlock
								VerticalAlignment="Center"
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{DynamicResource TextPrimaryBrush}"
								Text="{Binding Name}"
								TextOptions.TextFormattingMode="Display"
								TextOptions.TextRenderingMode="ClearType"
								TextTrimming="CharacterEllipsis" />
							<ContentPresenter Content="{Binding Children.Count}" ContentTemplate="{StaticResource CountBadge}">
								<ContentPresenter.Style>
									<Style TargetType="ContentPresenter">
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsReorderSection}" Value="False">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</ContentPresenter.Style>
							</ContentPresenter>
						</StackPanel>
					</ToggleButton>
				</Grid>
			</Border>
			<!-- 자식 목록 (접기 가능) -->
			<StackPanel Margin="4,2,0,0">
				<StackPanel.Style>
					<Style TargetType="StackPanel">
						<Setter Property="Visibility" Value="Visible" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsExpanded}" Value="False">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</StackPanel.Style>
				<!-- 오버레이 섹션은 순서 목록(ListBox), 나머지는 예전 ItemsControl (D-36) -->
				<ContentPresenter Content="{Binding}">
					<ContentPresenter.Style>
						<Style TargetType="ContentPresenter">
							<Setter Property="ContentTemplate" Value="{StaticResource SectionChildrenPlainTemplate}" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsReorderSection}" Value="True">
									<Setter Property="ContentTemplate" Value="{StaticResource SectionChildrenReorderTemplate}" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ContentPresenter.Style>
				</ContentPresenter>
				<!-- 빈 상태 메시지 -->
				<!--  L5 — 10px 기울임은 읽기 한계 아래였다 → 11.5  -->
				<TextBlock
					Margin="4,2,0,2"
					FontSize="11.5"
					FontStyle="Italic"
					Foreground="{DynamicResource TextMutedBrush}"
					Text="등록된 항목이 없습니다">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding Children.Count}" Value="0">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>
		</StackPanel>
	</DataTemplate>

	<!-- ═══════════════════════════════════════════════════ -->
	<!-- 메인 스타일                                         -->
	<!-- ═══════════════════════════════════════════════════ -->
	<Style TargetType="{x:Type ctrl:LayerPanelControl}">
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="SnapsToDevicePixels" Value="True" />
		<Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ctrl:LayerPanelControl}">
					<!-- Width/Height는 컨트롤(LayerPanelControl)이 구동 — 고정 Width 제거(리사이즈 FR-05). -->
					<fb:FrameBorder
						Background="{DynamicResource SurfaceBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						ClipToBounds="True"
						CornerRadius="10">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Opacity="0.15"
								ShadowDepth="3"
								Color="Black" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="38" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!-- 헤더 -->
							<Border
								Grid.Row="0"
								Background="{DynamicResource PrimaryBrush}"
								Cursor="SizeAll">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="34" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="34" />
									</Grid.ColumnDefinitions>
									<md:PackIcon
										Grid.Column="0"
										Width="16"
										Height="16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Kind="Layers" />
									<TextBlock
										Grid.Column="1"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource OnPrimaryFixedBrush}"
										Text="{TemplateBinding PanelTitle}" />
									<!--  패널 "?"(help-callout H-4) — 체크 · 잠금 · 묶음 체크 · 순서 바꾸기(키보드로 묶음은 순서 목록의 KeyboardFallback 이 저절로 더한다)  -->
									<Border Grid.Column="1" Style="{StaticResource PanelHeaderHelpDisc}">
										<fb:HelpTip HelpKey="Map.LayerPanel.Layers" Scope="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</Border>
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Style="{StaticResource PanelCloseButtonStyle}" />
								</Grid>
							</Border>

							<!-- 바디: 트리 구조 -->
							<ScrollViewer
								x:Name="PART_TreeView"
								Grid.Row="1"
								Padding="0,0,2,0"
								HorizontalScrollBarVisibility="Disabled"
								VerticalScrollBarVisibility="Auto">
								<ItemsControl
									Margin="8,2,8,8"
									ItemTemplate="{StaticResource SectionNodeTemplate}"
									ItemsSource="{Binding TreeNodes, RelativeSource={RelativeSource TemplatedParent}}" />
							</ScrollViewer>

							<!-- ═══ 리사이즈 그립 (E/S/SE) — 본문 행(Row=1)에만 둬 헤더 이동영역(Row=0)과 분리(FR-05) ═══ -->
							<Thumb
								x:Name="PART_ResizeRight"
								Grid.Row="1"
								Width="6"
								Margin="0,0,0,14"
								HorizontalAlignment="Right"
								VerticalAlignment="Stretch"
								Cursor="SizeWE">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
								</Thumb.Template>
							</Thumb>
							<Thumb
								x:Name="PART_ResizeBottom"
								Grid.Row="1"
								Height="6"
								Margin="8,0,14,0"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Bottom"
								Cursor="SizeNS">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
								</Thumb.Template>
							</Thumb>
							<Thumb
								x:Name="PART_ResizeCorner"
								Grid.Row="1"
								Width="14"
								Height="14"
								HorizontalAlignment="Right"
								VerticalAlignment="Bottom"
								Cursor="SizeNWSE">
								<Thumb.Template>
									<ControlTemplate TargetType="Thumb">
										<Grid Background="Transparent">
											<Path
												Stroke="{DynamicResource BorderBrush}"
												StrokeThickness="1"
												SnapsToDevicePixels="True"
												Data="M13,3 L3,13 M13,7 L7,13 M13,11 L11,13" />
										</Grid>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Grid>
					</fb:FrameBorder>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
