<UserControl
	x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps.GridSnapSettingsControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

	<Border
		Background="{DynamicResource SurfaceBrush}"
		BorderBrush="{DynamicResource PrimaryHueMidBrush}"
		BorderThickness="1.5"
		CornerRadius="6"
		Padding="12,8"
		MinWidth="260">
		<Border.Effect>
			<DropShadowEffect
				BlurRadius="8"
				Direction="-90"
				Opacity="0.18"
				RenderingBias="Performance"
				ShadowDepth="4" />
		</Border.Effect>
		<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
			<Slider
				Width="160"
				Margin="0,0,10,0"
				Maximum="50"
				Minimum="4"
				IsSnapToTickEnabled="True"
				TickFrequency="1"
				VerticalAlignment="Center"
				Value="{Binding GridSizePx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			<TextBox
				Width="44"
				Margin="0,0,4,0"
				HorizontalContentAlignment="Center"
				VerticalAlignment="Center"
				BorderBrush="{DynamicResource PrimaryHueMidBrush}"
				BorderThickness="1"
				Text="{Binding GridSizePx, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}" />
			<TextBlock
				VerticalAlignment="Center"
				Foreground="{DynamicResource TextMutedBrush}"
				Text="px" />
		</StackPanel>
	</Border>
</UserControl>
