<UserControl
	x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps.MapEventFlyToSettingsBlock"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:fb="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils">
	<!--  이벤트 시 지도 이동 설정 블록(event-map-flyto PRD §4) — DataContext = MapEventFlyToSetupViewModel(DI 싱글톤). 호스트 설정 창 '지도' 레일에 끼운다  -->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<StackPanel Margin="0,4">
		<StackPanel Orientation="Horizontal">
			<TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="이벤트 시 지도 이동" />
			<fb:HelpTip
				Margin="6,0,0,0"
				VerticalAlignment="Center"
				HelpKey="Map.EventFlyTo.Settings"
				Scope="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" />
		</StackPanel>

		<CheckBox Margin="0,8,0,0" Content="탐지 때 이동" IsChecked="{Binding IsDetectionEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="GMaps.EventFlyTo.Detection" />
		<CheckBox Margin="0,4,0,0" Content="장애 때 이동" IsChecked="{Binding IsFaultEnabled, Mode=TwoWay}" AutomationProperties.AutomationId="GMaps.EventFlyTo.Fault" />

		<Grid Margin="0,8,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="90" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="70" />
			</Grid.ColumnDefinitions>
			<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="최대 줌" />
			<!--  정수 줌만 — 1 단위 스냅  -->
			<Slider
				Grid.Column="1"
				VerticalAlignment="Center"
				Minimum="{Binding ZoomMinimum}"
				Maximum="{Binding ZoomMaximum}"
				IsSnapToTickEnabled="True"
				TickFrequency="1"
				AutomationProperties.AutomationId="GMaps.EventFlyTo.MaxZoom"
				Value="{Binding MaxZoom, Mode=TwoWay}" />
			<TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding MaxZoom, StringFormat={}{0:0}}" />
		</Grid>

		<Grid Margin="0,6,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="90" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Text="이동 시간" />
			<!--  0~5000 ms, 100 ms 스냅 — 값은 VM 세터가 정수로 정규화(소수점 없음)  -->
			<Slider
				Grid.Column="1"
				VerticalAlignment="Center"
				Minimum="0"
				Maximum="{Binding MaxDurationMs}"
				IsSnapToTickEnabled="True"
				TickFrequency="100"
				SmallChange="100"
				LargeChange="500"
				AutomationProperties.AutomationId="GMaps.EventFlyTo.DurationSlider"
				Value="{Binding DurationMs, Mode=TwoWay}" />
			<TextBox
				Grid.Column="2"
				Width="56"
				Margin="8,0,4,0"
				VerticalAlignment="Center"
				TextAlignment="Right"
				AutomationProperties.AutomationId="GMaps.EventFlyTo.DurationText"
				Text="{Binding DurationMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" />
			<TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="ms" />
		</Grid>

		<Grid Margin="0,8,0,0">
			<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Status}" />
			<Button
				HorizontalAlignment="Right"
				AutomationProperties.AutomationId="GMaps.EventFlyTo.Save"
				Command="{Binding SaveCommand}"
				Content="저장"
				Style="{StaticResource PanelPrimaryButtonStyle}" />
		</Grid>
	</StackPanel>
</UserControl>
