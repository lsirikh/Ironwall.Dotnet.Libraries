<UserControl
	x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps.MapView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:gmap="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapCustoms"
	xmlns:gproperty="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:symbolUtils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	d:Background="WhiteSmoke"
	d:DesignHeight="450"
	d:DesignWidth="1200"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<symbolUtils:ColorTypeToBrushConverter x:Key="ColorTypeToBrushConverter" />
		<symbolUtils:MarkerCategoryToDisplayNameConverter x:Key="MarkerCategoryToDisplayNameConverter" />
		<symbolUtils:MarkerCategoryToIconConverter x:Key="MarkerCategoryToIconConverter" />
		<symbolUtils:SymbolTypeToDisplayNameConverter x:Key="SymbolTypeToDisplayNameConverter" />
		<symbolUtils:SymbolTypeToIconConverter x:Key="SymbolTypeToIconConverter" />
		<utils:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
		<Style
			x:Name="CustomIconButton"
			BasedOn="{StaticResource MaterialDesignIconButton}"
			TargetType="Button">
			<Setter Property="Padding" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect
						BlurRadius="5"
						Direction="-90"
						RenderingBias="Quality"
						ShadowDepth="5"
						Color="Black" />
				</Setter.Value>
			</Setter>
		</Style>
		<Style
			x:Name="CustomSlider"
			BasedOn="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
			TargetType="Slider">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect
						BlurRadius="10"
						Direction="-90"
						RenderingBias="Quality"
						ShadowDepth="5"
						Color="Black" />
				</Setter.Value>
			</Setter>
		</Style>
		<Style
			x:Key="CompactComboBox"
			BasedOn="{StaticResource MaterialDesignComboBox}"
			TargetType="ComboBox">
			<Setter Property="Margin" Value="2" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="FontSize" Value="10" />
			<Setter Property="MinHeight" Value="24" />
		</Style>

		<Style
			x:Key="CompactSlider"
			BasedOn="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
			TargetType="Slider">
			<Setter Property="Margin" Value="2" />
			<Setter Property="Height" Value="20" />
		</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid x:Name="MapView_OuterGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<!--<RowDefinition Height="50"/>-->
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Menu
			Grid.Row="0"
			Grid.ColumnSpan="2"
			Margin="50,0,0,0"
			Panel.ZIndex="10"
			Background="{DynamicResource MaterialDesignPaper}"
			IsMainMenu="True"
			Style="{StaticResource MaterialDesignMenu}">

			<!--  File 메뉴  -->
			<MenuItem Header="_File">
				<MenuItem
					Command="{Binding LoadMapImageCommand}"
					Header="맵 불러오기"
					Icon="{md:PackIcon Kind=Map}"
					InputGestureText="Ctrl+L">
					<MenuItem.InputBindings>
						<KeyBinding
							Key="L"
							Command="{Binding LoadMapImageCommand}"
							Modifiers="Ctrl" />
					</MenuItem.InputBindings>
				</MenuItem>

				<MenuItem
					Command="{Binding LoadImageOverlayCommand}"
					Header="이미지 불러오기"
					Icon="{md:PackIcon Kind=Image}"
					InputGestureText="Ctrl+I">
					<MenuItem.InputBindings>
						<KeyBinding
							Key="I"
							Command="{Binding LoadImageOverlayCommand}"
							Modifiers="Ctrl" />
					</MenuItem.InputBindings>
				</MenuItem>

				<MenuItem
					Command="{Binding CreateCustomMapCommand}"
					Header="새 커스텀 맵 생성"
					Icon="{md:PackIcon Kind=MapPlus}"
					InputGestureText="Ctrl+N">
					<MenuItem.InputBindings>
						<KeyBinding
							Key="N"
							Command="{Binding CreateCustomMapCommand}"
							Modifiers="Ctrl" />
					</MenuItem.InputBindings>
				</MenuItem>

				<MenuItem
					Command="{Binding SetMapTileFolderCommand}"
					Header="맵 타일 폴더 설정"
					Icon="{md:PackIcon Kind=Mapbox}"
					InputGestureText="Ctrl+D">
					<MenuItem.InputBindings>
						<KeyBinding
							Key="D"
							Command="{Binding SetMapTileFolderCommand}"
							Modifiers="Ctrl" />
					</MenuItem.InputBindings>
				</MenuItem>

				<Separator />

				<MenuItem
					Command="{Binding ExitApplicationCommand}"
					Header="Exit"
					Icon="{md:PackIcon Kind=ExitToApp}"
					InputGestureText="Ctrl+E">
					<MenuItem.InputBindings>
						<KeyBinding
							Key="E"
							Command="{Binding ExitApplicationCommand}"
							Modifiers="Ctrl" />
					</MenuItem.InputBindings>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="_Maps">
				<MenuItem
					Command="{Binding ToggleWGS84Command}"
					Header="WGS-84 좌표계"
					IsCheckable="True"
					IsChecked="{Binding IsShowWSG84, UpdateSourceTrigger=PropertyChanged}">
					<MenuItem.InputBindings>
						<KeyBinding Command="{Binding ToggleWGS84Command}" />
					</MenuItem.InputBindings>
				</MenuItem>
				<MenuItem
					Command="{Binding ToggleMGRSCommand}"
					Header="MGRS 좌표계"
					IsCheckable="True"
					IsChecked="{Binding IsShowMGRS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<MenuItem.InputBindings>
						<KeyBinding Command="{Binding ToggleMGRSCommand}" />
					</MenuItem.InputBindings>
				</MenuItem>
				<MenuItem
					Command="{Binding ToggleUTMCommand}"
					Header="UTM 좌표계"
					IsCheckable="True"
					IsChecked="{Binding IsShowUTM, UpdateSourceTrigger=PropertyChanged}">
					<MenuItem.InputBindings>
						<KeyBinding Command="{Binding ToggleUTMCommand}" />
					</MenuItem.InputBindings>
				</MenuItem>
			</MenuItem>
		</Menu>

		<ToolBarTray
			Grid.Row="1"
			Grid.Column="0"
			Grid.ColumnSpan="2"
			Margin="50,0,0,0"
			Panel.ZIndex="10"
			md:ThemeAssist.Theme="Inherit">
			<ToolBar ClipToBounds="True" Style="{StaticResource MaterialDesignToolBar}">

				<!--  ① 지도 선택 그룹  -->
				<ComboBox
					Width="150"
					Margin="5,0"
					ItemsSource="{Binding AvailableMaps}"
					SelectedItem="{Binding SelectedMapItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Style="{StaticResource CompactComboBox}"
					ToolTip="지도 선택">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon
									Width="14"
									Height="14"
									Margin="0,0,5,0"
									VerticalAlignment="Center"
									Kind="Map" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="{Binding Name}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ② 네비게이션 그룹  -->
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding MoveHomeLocationCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="홈 위치 이동">
							<md:PackIcon Kind="Home" />
						</Button>
						<Button Command="{Binding SetHomeLocationCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="홈 위치 설정">
							<md:PackIcon Kind="HomeEdit" />
						</Button>
						<Button Command="{Binding ShowMapRoiPanelCommand}" ToolTip="관심지역 관리">
							<Button.Style>
								<Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMapRoiPanelVisible}" Value="True">
											<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<md:PackIcon Kind="MapMarkerRadius" />
						</Button>
						<Button Command="{Binding ShowLayerPanelCommand}" ToolTip="레이어 관리">
							<Button.Style>
								<Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsLayerPanelVisible}" Value="True">
											<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<md:PackIcon Kind="Layers" />
						</Button>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ④ 편집 그룹  -->
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<ToggleButton
							x:Name="EditModeToggle"
							Command="{Binding ToggleEditModeCommand}"
							IsChecked="{Binding IsEditModeEnabled, Mode=OneWay}"
							Style="{StaticResource MaterialDesignSwitchToggleButton}"
							ToolTip="편집 모드 전환">
							<md:PackIcon Kind="Draw" />
						</ToggleButton>
						<Button
							Command="{Binding ClearSelectionCommand}"
							IsEnabled="{Binding HasSelectedItem}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="선택 해제">
							<md:PackIcon Kind="SelectionOff" />
						</Button>
						<Button
							Command="{Binding DeleteSelectedCommand}"
							IsEnabled="{Binding HasSelectedItem}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="선택 항목 삭제">
							<md:PackIcon Kind="Delete" />
						</Button>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ⑤ 심볼 추가 그룹  -->
				<ComboBox
					Width="120"
					ItemsSource="{Binding AvailableMarkerCategories}"
					SelectedItem="{Binding SelectedMarkerCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Style="{StaticResource CompactComboBox}"
					ToolTip="마커 카테고리 선택">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon
									Width="14"
									Height="14"
									Margin="0,0,5,0"
									Kind="{Binding Converter={StaticResource MarkerCategoryToIconConverter}}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="{Binding Converter={StaticResource MarkerCategoryToDisplayNameConverter}}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!--  심볼 타입 선택  -->
				<ComboBox
					Width="100"
					ItemsSource="{Binding AvailableSymbolTypes}"
					SelectedItem="{Binding SelectedSymbolType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Style="{StaticResource CompactComboBox}"
					ToolTip="심볼 타입 선택">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon
									Width="14"
									Height="14"
									Margin="0,0,5,0"
									Kind="{Binding Converter={StaticResource SymbolTypeToIconConverter}}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="{Binding Converter={StaticResource SymbolTypeToDisplayNameConverter}}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!--  심볼 추가 버튼  -->
				<Button
					Command="{Binding AddSelectedSymbolCommand}"
					IsEnabled="{Binding CanAddSymbol}"
					Style="{StaticResource MaterialDesignToolButton}"
					ToolTip="선택된 심볼 추가 (Ctrl+Shift+A)">
					<Button.InputBindings>
						<KeyBinding Key="A" Modifiers="Ctrl+Shift" />
					</Button.InputBindings>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							Kind="Plus" />
						<TextBlock
							Margin="3,0,0,0"
							VerticalAlignment="Center"
							FontSize="10"
							Text="추가" />
					</StackPanel>
				</Button>

				<!--  라인 드로잉 전용 버튼 추가 (AREA_BOUNDARY 카테고리일 때만 표시)  -->
				<!--<Button
					Command="{Binding StartLineDrawingCommand}"
					CommandParameter="boundary"
					IsEnabled="{Binding CanStartLineDrawing}"
					Style="{StaticResource MaterialDesignToolButton}"
					ToolTip="라인 그리기 시작 (Ctrl+L)"
					Visibility="{Binding SelectedMarkerCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AREA_BOUNDARY}">
					<Button.InputBindings>
						<KeyBinding Key="L" Modifiers="Ctrl" />
					</Button.InputBindings>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							Kind="VectorLine" />
						<TextBlock
							Margin="3,0,0,0"
							VerticalAlignment="Center"
							FontSize="10"
							Text="라인" />
					</StackPanel>
				</Button>-->


				<!--  마커 복제 버튼  -->
				<Button Command="{Binding DuplicateMarkerCommand}" ToolTip="선택된 마커 복제 (Ctrl+D)">
					<Button.InputBindings>
						<KeyBinding Key="D" Modifiers="Ctrl+Shift" />
					</Button.InputBindings>
					<md:PackIcon Kind="ContentDuplicate" />
				</Button>

				<!--  격자 스냅 토글  -->
				<Grid>
					<ToggleButton
						x:Name="SnapGridToggle"
						Command="{Binding ToggleSnapToGridCommand}"
						IsChecked="{Binding IsSnapToGridEnabled, Mode=OneWay}"
						IsEnabled="{Binding IsEditModeEnabled}"
						ToolTip="격자 스냅 ON/OFF (편집 모드 필요)">
						<ToggleButton.Style>
							<Style BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" TargetType="ToggleButton">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsSnapToGridEnabled}" Value="True">
										<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ToggleButton.Style>
						<md:PackIcon Kind="GridLarge" />
					</ToggleButton>
					<Popup
						AllowsTransparency="True"
						IsOpen="{Binding IsSnapToGridEnabled, Mode=OneWay}"
						Placement="Bottom"
						PlacementTarget="{x:Reference SnapGridToggle}"
						StaysOpen="True"
						VerticalOffset="4">
						<local:GridSnapSettingsControl />
					</Popup>
				</Grid>

				<!--<StackPanel Orientation="Horizontal" Visibility="{Binding CanEditMarker, Converter={StaticResource BooleanToVisibilityConverter}}">
					<md:PackIcon
						Width="16"
						Height="16"
						VerticalAlignment="Center"
