						Width="50"
						Margin="3,0"
						IsEnabled="{Binding HasSelectedItem}"
						ItemsSource="{Binding DeviceList}"
						SelectedItem="{Binding SelectedLinkDevice}"
						Style="{StaticResource CompactComboBox}"
						ToolTip="Stroke 색상">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock HorizontalAlignment="Center" Text="{Binding}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
					<Separator />
				</StackPanel>-->

				<!--  상태 표시  -->
				<!--<TextBlock Margin="10,0" VerticalAlignment="Center">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Text" Value="일반 모드" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsEditModeEnabled}" Value="True">
									<Setter Property="Text" Value="편집 모드" />
									<Setter Property="Foreground" Value="Orange" />
									<Setter Property="FontWeight" Value="Bold" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>-->

				<!--  선택된 마커 정보 표시  -->
				<!--<TextBlock
					Margin="10,0"
					VerticalAlignment="Center"
					FontSize="10">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Foreground" Value="DarkGreen" />
							<Setter Property="Text" Value="{Binding SelectedMarker.Title, StringFormat='선택: {0}'}" />
						</Style>
					</TextBlock.Style>
				</TextBlock>-->
			</ToolBar>
		</ToolBarTray>
		</DockPanel>

		<!--  편집 스트립 (FR-C2) — 편집 모드 동안만 확장(200ms 슬라이드), 주황 하단 테두리=수정 모드 상시 암시.
		      등록·심볼·선택·기준 4그룹(§3 매핑) — 운영 툴바·파일 메뉴에서 이관. CanMapEdit 없인 편집 모드 진입
		      자체가 불가하므로 스트립은 IsEditModeEnabled 단일 게이트.  -->
		<Border
			Grid.Row="1"
			Grid.ColumnSpan="2"
			Margin="50,0,0,0"
			Panel.ZIndex="9"
			AutomationProperties.AutomationId="GMaps.EditStrip.Panel"
			Background="{DynamicResource SurfaceBrush}"
			BorderBrush="{DynamicResource StatusWarningBrush}"
			BorderThickness="0,0,0,2"
			ClipToBounds="True">
			<Border.Style>
				<Style TargetType="Border">
					<Setter Property="MaxHeight" Value="0" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsEditModeEnabled}" Value="True">
							<DataTrigger.EnterActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="MaxHeight"
											To="64"
											Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.EnterActions>
							<DataTrigger.ExitActions>
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation
											Storyboard.TargetProperty="MaxHeight"
											To="0"
											Duration="0:0:0.2" />
									</Storyboard>
								</BeginStoryboard>
							</DataTrigger.ExitActions>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
			<StackPanel Margin="8,3" Orientation="Horizontal">

				<!--  등록 — 파일 메뉴에서 이관(FR-C3), 단축키 유지  -->
				<TextBlock Style="{StaticResource ToolbarGroupLabel}" Text="등록" />
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<Button
							AutomationProperties.AutomationId="GMaps.EditStrip.LoadMap"
							Command="{Binding LoadMapImageCommand}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="맵 불러오기 (Ctrl+L)">
							<md:PackIcon Kind="Map" />
						</Button>
						<Button
							AutomationProperties.AutomationId="GMaps.EditStrip.LoadImage"
							Command="{Binding LoadImageOverlayCommand}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="이미지 불러오기 (Ctrl+I)">
							<md:PackIcon Kind="Image" />
						</Button>
						<Button
							AutomationProperties.AutomationId="GMaps.EditStrip.CreateCustomMap"
							Command="{Binding CreateCustomMapCommand}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="새 커스텀 맵 생성 (Ctrl+N)">
							<md:PackIcon Kind="MapPlus" />
						</Button>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  심볼 — 툴바 ⑦에서 이관  -->
				<TextBlock Style="{StaticResource ToolbarGroupLabel}" Text="심볼" />
				<Button cal:Message.Attach="ToggleSymbolPalette" Style="{StaticResource ToolbarButtonStyle}" ToolTip="심볼 라이브러리 열기" AutomationProperties.AutomationId="GMaps.EditStrip.SymbolPalette">
					<StackPanel Orientation="Horizontal">
						<md:PackIcon Kind="ViewGridPlus"/>
						<TextBlock Text="아이콘 등록" Margin="6,0,0,0" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button
					AutomationProperties.AutomationId="GMaps.EditStrip.Duplicate"
					Command="{Binding DuplicateMarkerCommand}"
					Style="{StaticResource ToolbarButtonStyle}"
					ToolTip="선택된 마커 복제 (Ctrl+Shift+D)">
					<Button.InputBindings>
						<KeyBinding Key="D" Modifiers="Ctrl+Shift" />
					</Button.InputBindings>
					<md:PackIcon Kind="ContentDuplicate" />
				</Button>
				<Grid>
					<ToggleButton
						x:Name="SnapGridToggle"
						Command="{Binding ToggleSnapToGridCommand}"
						IsChecked="{Binding IsSnapToGridEnabled, Mode=OneWay}"
						IsEnabled="{Binding IsEditModeEnabled}"
						ToolTip="격자 스냅 ON/OFF (편집 모드 필요)">
						<ToggleButton.Style>
							<Style BasedOn="{StaticResource MaterialDesignSwitchToggleButton}" TargetType="ToggleButton">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsSnapToGridEnabled}" Value="True">
										<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ToggleButton.Style>
						<md:PackIcon Kind="GridLarge" />
					</ToggleButton>
					<Popup
						AllowsTransparency="True"
						IsOpen="{Binding IsSnapToGridEnabled, Mode=OneWay}"
						Placement="Bottom"
						PlacementTarget="{x:Reference SnapGridToggle}"
						StaysOpen="True"
						VerticalOffset="4">
						<local:GridSnapSettingsControl />
					</Popup>
				</Grid>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  선택 — 툴바 ④에서 이관  -->
				<TextBlock Style="{StaticResource ToolbarGroupLabel}" Text="선택" />
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<Button
							Command="{Binding ClearSelectionCommand}"
							IsEnabled="{Binding HasSelectedItem}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="선택 해제">
							<md:PackIcon Kind="SelectionOff" />
						</Button>
						<Button
							Command="{Binding DeleteSelectedCommand}"
							IsEnabled="{Binding HasSelectedItem}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="선택 항목 삭제">
							<md:PackIcon Kind="Delete" />
						</Button>
						<Button
							Command="{Binding UndoCommand}"
							IsEnabled="{Binding CanUndo}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTipService.ShowOnDisabled="True"
							ToolTip="{Binding NextUndoDescription, StringFormat='실행 취소 (Ctrl+Z): {0}', TargetNullValue='실행 취소 (Ctrl+Z)'}">
							<md:PackIcon Kind="Undo" />
						</Button>
						<Button
							Command="{Binding RedoCommand}"
							IsEnabled="{Binding CanRedo}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTipService.ShowOnDisabled="True"
							ToolTip="{Binding NextRedoDescription, StringFormat='다시 실행 (Ctrl+Y / Ctrl+Shift+Z): {0}', TargetNullValue='다시 실행 (Ctrl+Y / Ctrl+Shift+Z)'}">
							<md:PackIcon Kind="Redo" />
						</Button>
						<!--  선택 "?"(help-callout H-4) — 지도 위 선택 안내 띠에서 빠진 단축키(추가 · 해제 · 이동 · 삭제 · 복사)  -->
						<help:HelpTip
							Margin="4,0,2,0"
							HelpKey="Map.EditStrip.Selection"
							Scope="{Binding RelativeSource={RelativeSource AncestorType=Border}}" />
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  기준 — 툴바 ②에서 이관(홈 설정·사이트 고정 = 뷰 기준 '설정' 행위)  -->
				<TextBlock Style="{StaticResource ToolbarGroupLabel}" Text="기준" />
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<Button
							AutomationProperties.AutomationId="GMaps.EditStrip.SetHome"
							Command="{Binding SetHomeLocationCommand}"
							Style="{StaticResource ToolbarButtonStyle}"
							ToolTip="홈 위치 설정">
							<md:PackIcon Kind="HomeEdit" />
						</Button>
						<Button
							AutomationProperties.AutomationId="GMaps.EditStrip.Anchor"
							Command="{Binding ShowMapAnchorPanelCommand}"
							ToolTip="사이트 고정(맵 앵커)">
							<Button.Style>
								<Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMapAnchorPanelVisible}" Value="True">
											<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<md:PackIcon Kind="CropFree" />
						</Button>
					</StackPanel>
				</Border>
			</StackPanel>
		</Border>

		<!--<gmap:GMapCustomControl
			x:Name="MainMap"
			Grid.Row="2"
			Grid.ColumnSpan="2"
			IsEditMode="{Binding IsEditModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			MapRotation="{Binding MapRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			MaxZoom="19"
			MinZoom="2"
			RotationSnapAngle="{Binding RotationSnapAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			ShowMGRSGrid="{Binding IsShowMGRSGrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
			ShowRotationControl="{Binding ShowRotationControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->
		<Grid Grid.Row="2" Grid.ColumnSpan="2">



			<!--  ClipToBounds(C3): 디지털 줌 RenderTransform 확대분이 상단 윈도우 컨트롤바/툴바를 덮지 않도록 맵 경계에서 클립.
			      AdornerDecorator에만 적용(Grid 아님) — 형제 PropertyPanelCanvas(드래그 패널, 음수 Top 가능)는 클립 제외.  -->
			<AdornerDecorator Panel.ZIndex="0" ClipToBounds="True">
				<gmap:GMapCustomControl
					x:Name="MainMap"
					AllowDrop="True"
					GridSizePx="{Binding GridSizePx, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					IsEditMode="{Binding IsEditModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					IsSnapToGridEnabled="{Binding IsSnapToGridEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					MapRotation="{Binding MapRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					MaxZoom="19"
					MinZoom="2"
					RotationSnapAngle="{Binding RotationSnapAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					ShowMGRSGrid="{Binding IsShowMGRSGrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					ShowRotationControl="{Binding ShowRotationControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
					<!--  map-tilt-25d FR-04 레이아웃 오버스캔: Height = H_view/cosφ_layout, Margin = (0,−Δ,0,−Δ) 상하 대칭(컨트롤 중심 = 뷰포트 중심 불변식).
					      입력 = AdornerDecorator(뷰포트) ActualHeight + 컨트롤 자신의 TiltLayoutDeg(φ_layout — 게이트 전이 즉시, 각도 조작은 φmax 선확장 후 150 ms 정착, G8).
					      φ_layout=0 이면 컨버터가 Height=NaN(Auto)·Margin=0 을 돌려 오버스캔을 해제한다. F11/리사이즈는 ActualHeight 변경으로 자동 재계산.  -->
					<gmap:GMapCustomControl.Height>
						<MultiBinding Converter="{StaticResource TiltOverscanConverter}" ConverterParameter="Height">
							<Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=AdornerDecorator}" />
							<Binding Path="TiltLayoutDeg" RelativeSource="{RelativeSource Self}" />
						</MultiBinding>
					</gmap:GMapCustomControl.Height>
					<gmap:GMapCustomControl.Margin>
						<MultiBinding Converter="{StaticResource TiltOverscanConverter}" ConverterParameter="Margin">
							<Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=AdornerDecorator}" />
							<Binding Path="TiltLayoutDeg" RelativeSource="{RelativeSource Self}" />
						</MultiBinding>
					</gmap:GMapCustomControl.Margin>
				</gmap:GMapCustomControl>
			</AdornerDecorator>

			<!--  스케일바 + 기울임 배지(map-tilt-25d FR-09 · G6 세로 축척 이탈 표시: 수평 축척은 유지, 세로는 cosφ 배 — φ>0.1° 만 표시).
			      배지는 색이 아니라 형태(1px 스트로크 필 + 아이콘)로 구분, 토큰은 DynamicResource(라이트/다크 재해석).  -->
			<StackPanel
				Grid.Row="2"
				Margin="50,5,5,5"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Orientation="Horizontal">
				<ctrl:MapScaleBarControl
					VerticalAlignment="Bottom"
					Scale="{Binding Scale, FallbackValue=100m}"
					ScalePoints="{Binding ScalePoints}" />
				<Border
					Margin="8,0,0,2"
					Padding="6,1"
					VerticalAlignment="Bottom"
					Background="{DynamicResource SurfaceBrush}"
					BorderBrush="{DynamicResource PrimaryBrush}"
					BorderThickness="1"
					CornerRadius="9"
					IsHitTestVisible="False"
					Visibility="{Binding IsTiltBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="12"
							Height="12"
							Margin="0,0,3,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource PrimaryBrush}"
							Kind="PerspectiveMore" />
						<!--  AutomationId 는 peer 가 실재하는 TextBlock 에(Border 는 UIA 트리에 안 나온다 — ui-automation 규칙)  -->
						<TextBlock
							VerticalAlignment="Center"
							AutomationProperties.AutomationId="GMaps.Tilt.Badge"
							FontSize="11"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding TiltBadgeText}" />
					</StackPanel>
				</Border>
			</StackPanel>

			<!--  좌표 표시  -->
			<ctrl:MapCoordinateControl
				Grid.Row="2"
				Grid.ColumnSpan="2"
				Margin="50,5,5,5"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				IsShowMGRS="{Binding IsShowMGRS}"
				IsShowUTM="{Binding IsShowUTM}"
				IsShowWGS84="{Binding IsShowWSG84}"
				Latitude="{Binding CurrentCoordinatePosition.Latitude}"
				Longitude="{Binding CurrentCoordinatePosition.Longitude}"
				MGRS="{Binding CurrentMGRS}"
				UTM="{Binding CurrentUTM}" />

			<!--  화면 정중앙 십자가(비상호작용 시각 기준) — IsCenterCrosshairVisible 토글. AdornerDecorator 형제라 디지털줌 RenderTransform 영향 없이 항상 화면 중앙.
			      z-순서: 맵/심볼/오버레이이미지(GMapControl, ZIndex 0) 위 · OverlayWindow 패널(PropertyPanelCanvas, ZIndex 200) 아래 → ZIndex 150.  -->
			<Grid
				Grid.Row="2"
				Grid.ColumnSpan="2"
				Width="44"
				Height="44"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsHitTestVisible="False"
				Panel.ZIndex="150">
				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsCenterCrosshairVisible}" Value="True">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<Path
					Stroke="#FF2196F3"
					StrokeThickness="1.5"
					Data="M22,2 L22,16 M22,28 L22,42 M2,22 L16,22 M28,22 L42,22" />
				<Ellipse
					Width="8"
					Height="8"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Stroke="#FF2196F3"
					StrokeThickness="1.5" />
			</Grid>

			<!--  카메라 특정위치 확인(타겟 조준) 상태 배너 — IsAimStatusVisible 시 상단 중앙 표시  -->
			<Border
				Grid.Row="2"
				Grid.ColumnSpan="2"
				Margin="0,12,0,0"
				Padding="14,8"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				IsHitTestVisible="False"
				Panel.ZIndex="300"
				Background="#CC04161C"
				BorderBrush="#FF00C8FF"
				BorderThickness="1"
				CornerRadius="4">
				<Border.Style>
					<Style TargetType="Border">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsAimStatusVisible}" Value="True">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<TextBlock
					FontSize="13"
					FontWeight="SemiBold"
					Foreground="White"
					Text="{Binding AimStatusMessage}" />
			</Border>

			<!--  카메라 팝업 브로커 요청 결과 토스트(camera-popup-modes T-07 · FR-06) — 지도 하단 중앙 한 줄.
			      요청 · 띄움 · 거부 · 무응답만 알린다. 클릭을 막지 않는다(IsHitTestVisible=False). 토큰만(라이트/다크).  -->
			<Border
				Grid.Row="2"
				Grid.ColumnSpan="2"
				MaxWidth="720"
				Margin="0,0,0,28"
				HorizontalAlignment="Center"
				VerticalAlignment="Bottom"
				IsHitTestVisible="False"
				Panel.ZIndex="300"
				Style="{StaticResource MapFloatingPanelStyle}"
				Visibility="{Binding IsCameraPopupToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
				<StackPanel Orientation="Horizontal">
					<md:PackIcon
						Width="16"
						Height="16"
						VerticalAlignment="Center"
						Foreground="{DynamicResource PrimaryBrush}"
						Kind="Cctv" />
					<TextBlock
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Map.CameraPopup.Toast"
						FontSize="13"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding CameraPopupToastMessage}"
						TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<!--  팝업 호스트 안내(camera-popup-modes FR-25) — 호스트가 일시 중지인 동안 계속 떠 있다(오버레이가 없어도).
			      토스트 한 줄 위에 놓아 겹치지 않는다. [다시 시작]은 눌러야 하므로 히트 테스트를 막지 않는다. 토큰만(라이트/다크).  -->
			<Border
				Grid.Row="2"
				Grid.ColumnSpan="2"
				MaxWidth="720"
				Margin="0,0,0,72"
				HorizontalAlignment="Center"
				VerticalAlignment="Bottom"
				Panel.ZIndex="300"
				AutomationProperties.AutomationId="Map.CameraPopup.HostNotice.Panel"
				Style="{StaticResource MapFloatingPanelStyle}"
				Visibility="{Binding IsCameraPopupHostNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
				<StackPanel Orientation="Horizontal">
					<md:PackIcon
						Width="16"
						Height="16"
						VerticalAlignment="Center"
						Foreground="{DynamicResource StatusWarningBrush}"
						Kind="VideoOffOutline" />
					<TextBlock
						Margin="8,0,0,0"
						VerticalAlignment="Center"
						AutomationProperties.AutomationId="Map.CameraPopup.HostNotice"
						FontSize="13"
						FontWeight="SemiBold"
						Foreground="{DynamicResource TextPrimaryBrush}"
						Text="{Binding CameraPopupHostNoticeMessage}" />
					<Button
						Height="28"
						Margin="12,0,0,0"
						Padding="10,0"
						VerticalAlignment="Center"
						cal:Message.Attach="RestartCameraPopupHost"
						AutomationProperties.AutomationId="Map.CameraPopup.HostNotice.Restart"
						AutomationProperties.Name="다시 시작"
						Content="다시 시작"
						Style="{StaticResource MaterialDesignOutlinedButton}"
						ToolTip="영상 팝업 호스트를 다시 시작합니다" />
				</StackPanel>
			</Border>

			<!--  측정 리드아웃 HUD (MapFloatingPanelStyle + 토큰 — 라이트/다크 자동스왑)  -->
			<Border
				Grid.Row="2"
				Grid.ColumnSpan="2"
				MinWidth="160"
				Margin="0,12,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Panel.ZIndex="300"
				Style="{StaticResource MapFloatingPanelStyle}"
				Visibility="{Binding IsMeasureReadoutVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
				<StackPanel>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							VerticalAlignment="Center"
							Foreground="{DynamicResource PrimaryBrush}"
							Kind="Ruler" />
						<TextBlock
							Margin="6,0,0,0"
							VerticalAlignment="Center"
							FontSize="11"
							FontWeight="Bold"
							Foreground="{DynamicResource PrimaryBrush}"
							Text="{Binding MeasurePrimaryLabel}" />
						<TextBlock
							Margin="8,0,0,0"
							VerticalAlignment="Center"
							FontFamily="Consolas"
							FontSize="16"
							FontWeight="Bold"
							Foreground="{DynamicResource TextPrimaryBrush}"
							Text="{Binding MeasurePrimaryValue}" />
						<TextBlock
							Margin="3,0,0,0"
							VerticalAlignment="Bottom"
							FontFamily="Consolas"
							FontSize="11"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding MeasurePrimaryUnit}" />
						<!--  측정 "?"(help-callout H-4 · D-1) — 띠에는 지금 할 일 한 줄만, 끝내기 · 지우기 · 취소 단축키는 여기.
						      띠는 원래 히트 테스트를 받는 판이라(지도 클릭은 띠 밖에서만) "?" 가 지도 입력을 더 가리지 않는다.  -->
						<help:HelpTip
							Margin="10,0,0,0"
							HelpKey="Map.Measure.Tool"
							Scope="{Binding RelativeSource={RelativeSource AncestorType=Border}}" />
					</StackPanel>
					<StackPanel
						Margin="0,3,0,0"
						Orientation="Horizontal"
						Visibility="{Binding MeasureHasSecondary, Converter={StaticResource BooleanToVisibilityConverter}}">
						<TextBlock
							VerticalAlignment="Center"
							FontSize="10"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding MeasureSecondaryLabel}" />
						<TextBlock
							Margin="8,0,0,0"
							VerticalAlignment="Center"
							FontFamily="Consolas"
							FontSize="12"
							Foreground="{DynamicResource TextSecondaryBrush}"
							Text="{Binding MeasureSecondaryValue}" />
						<TextBlock
							Margin="3,0,0,0"
							VerticalAlignment="Bottom"
							FontFamily="Consolas"
							FontSize="9"
							Foreground="{DynamicResource TextMutedBrush}"
							Text="{Binding MeasureSecondaryUnit}" />
					</StackPanel>
					<TextBlock
						Margin="0,4,0,0"
						FontSize="9"
						Foreground="{DynamicResource TextMutedBrush}"
						Text="{Binding MeasureHint}" />
				</StackPanel>
			</Border>

			<!--  줌 컨트롤  -->
			<ctrl:MapZoomControl
				x:Name="MapZoomCtrl"
				Grid.Row="2"
				Grid.ColumnSpan="2"
				Margin="5,5,300,5"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				DigitalZoomLevel="{Binding MainMap.DigitalZoomLevel, Mode=TwoWay}"
				DigitalZoomSteps="3"
				MaxZoom="{Binding ZoomMax}"
				MinZoom="{Binding ZoomMin}"
				Zoom="{Binding MainMap.Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				ZoomInCommand="{Binding ZoomInCommand}"
				ZoomOutCommand="{Binding ZoomOutCommand}" />

			<!--  카메라 영상 팝업 제어 허브(CameraPopup_ControlHub) — 기존 카운터 위젯 교체.
			      드래그 이동 + 위치 기억 위해 PropertyPanelCanvas 안(Canvas.Left/Top)에 배치 → 아래 PropertyPanelCanvas 내부 참조.  -->

			<Canvas
				x:Name="PropertyPanelCanvas"
				Grid.Row="2"
				Grid.ColumnSpan="2"
				Panel.ZIndex="200">

				<!--  방위각 심볼(나침반) — GMap_Compass_Control PRD v1.0. 계기층 z6(D-03):
				      리더선(5) 위 · 카메라 팝업(10)/OverlayWindow 패널(20~120)/제어 허브(210) 아래.
				      RotationFeature OFF=Collapsed(컨트롤 자체 게이트) → 비회전 회귀 0(NFR-01).
				      위치/설정 영속=VM(MapCompassX/Y 등 TwoWay + SaveMapCompassCommand).  -->
				<!--  Canvas.Left/Top은 컨트롤이 직접 세팅(UpdateDisplayPosition) — 표시=클램프,
				      CompassX/Y=영속 원본(desired) 분리로 작은 창 부팅 시 저장 좌표 훼손 방지(리뷰 #4).  -->
				<ctrl:GMapCompassControl
					x:Name="MapCompass"
					Panel.ZIndex="6"
					CompassX="{Binding MapCompassX, Mode=TwoWay}"
					CompassY="{Binding MapCompassY, Mode=TwoWay}"
					DialSize="{Binding CompassDialSize, Mode=TwoWay}"
					DragCompletedCommand="{Binding SaveMapCompassCommand}"
					IsReadoutVisible="{Binding CompassShowReadout, Mode=TwoWay}"
					SettingsChangedCommand="{Binding SaveMapCompassCommand}"
					TargetMap="{Binding ElementName=MainMap}"
					Variant="{Binding CompassVariant, Mode=TwoWay}"
					Visibility="{Binding IsCompassVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  강풍모드(WINDY) 인디케이터 — 계기층 z6, 보기 메뉴 가시성(FR-17), 클릭→WINDY 패널(D-10).  -->
				<ctrl:GMapWindyIndicatorControl
					x:Name="MapWindyIndicator"
					Panel.ZIndex="6"
					ClickCommand="{Binding OpenWindyPanelCommand}"
					DisplayStyle="{Binding WindyDisplayStyle, Mode=TwoWay}"
					DragCompletedCommand="{Binding SaveMapWindyCommand}"
					HideOnNormal="{Binding WindyHideOnNormal, Mode=TwoWay}"
					IsInstrumentVisible="{Binding IsWindyIndicatorVisible}"
					Mode="{Binding WindyMode}"
					SettingsChangedCommand="{Binding SaveMapWindyCommand}"
					WindyX="{Binding WindyIndicatorX, Mode=TwoWay}"
					WindyY="{Binding WindyIndicatorY, Mode=TwoWay}" />

				<!--  탐지·장애 pill 계기는 map-topbar-trafficlight D2로 제거 —
				      이벤트 카드 리스트 헤더 신호등(Events.Ui)이 승계, 보기 토글은 EA 브리지(FR-A5).  -->

				<!--  심볼 속성 창  -->
				<ContentPresenter
					Canvas.Left="300"
					Canvas.Top="100"
					Panel.ZIndex="20"
					Content="{Binding PropertyPanel}"
					Visibility="{Binding IsPropertyPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  군사 심볼 등록창  -->
				<ContentPresenter
					x:Name="MilitarySymbolRegisterPresenter"
					Canvas.Left="400"
					Canvas.Top="50"
					Panel.ZIndex="30"
					Content="{Binding MilitarySymbolRegisterPanel}"
					Visibility="{Binding IsMilitarySymbolRegisterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  관심지역(ROI) 패널  -->
				<ContentPresenter
					x:Name="MapRoiPresenter"
					Panel.ZIndex="40"
					Content="{Binding MapRoiPanel}"
					Visibility="{Binding IsMapRoiPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  사이트 고정(맵 앵커) 설정 패널 (증분6, FR-B3) — OverlayWindow 패턴(Control+ControlTemplate, 헤더 드래그)  -->
				<ContentPresenter
					x:Name="MapAnchorPresenter"
					Canvas.Left="90"
					Canvas.Top="90"
					Panel.ZIndex="120"
					Content="{Binding MapAnchorPanel}"
					Visibility="{Binding IsMapAnchorPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  음원 실행 패널  -->
				<ContentPresenter
					x:Name="BroadcastPlayPresenter"
					Panel.ZIndex="50"
					Content="{Binding BroadcastPlayPanel}"
					Visibility="{Binding IsBroadcastPlayPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  TTS 실행 패널  -->
				<ContentPresenter
					x:Name="TtsBroadcastPresenter"
					Panel.ZIndex="60"
					Content="{Binding TtsBroadcastPanel}"
					Visibility="{Binding IsTtsBroadcastPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  오버레이 맵 등록 패널  -->
				<ContentPresenter
					x:Name="MapRegistrationPresenter"
					Canvas.Left="350"
					Canvas.Top="80"
					Panel.ZIndex="70"
					Content="{Binding MapRegistrationPanel}"
					Visibility="{Binding IsMapRegistrationPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  레이어 관리 패널  -->
				<ContentPresenter
					x:Name="LayerPanelPresenter"
					Panel.ZIndex="100"
					Content="{Binding LayerPanel}"
					Visibility="{Binding IsLayerPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  추적 재생(Playback) 콘솔 — 컨트롤만, 재생 마커는 MainMap에 직접  -->
				<ContentPresenter
					x:Name="PlaybackPanelPresenter"
					Canvas.Left="120"
					Canvas.Top="60"
					Panel.ZIndex="110"
					Content="{Binding PlaybackPanel}"
					Visibility="{Binding IsPlaybackPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  추적 설정 패널(P3-04) — 즉시적용 + 저장 영속  -->
				<ContentPresenter
					x:Name="TrackingSettingsPresenter"
					Canvas.Left="170"
					Canvas.Top="90"
					Panel.ZIndex="120"
					Content="{Binding TrackingSettingsPanel}"
					Visibility="{Binding IsTrackingSettingsPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ContentPresenter x:Name="SymbolPalettePresenter"
                    Canvas.Left="50" Canvas.Top="60" Panel.ZIndex="120"
                    Visibility="{Binding IsSymbolPaletteVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ContentPresenter.Content>
                        <local:SymbolPaletteView/>
                    </ContentPresenter.Content>
                </ContentPresenter>

				<!--  등록 센서 정보 오버레이(pidsgroup-rightclick FR-03) — 구역 우클릭 진입, 드래그 이동  -->
				<ContentPresenter
					x:Name="SensorInfoPresenter"
					Canvas.Left="210"
					Canvas.Top="110"
					Panel.ZIndex="120"
					Content="{Binding SensorInfoPanel}"
					Visibility="{Binding IsSensorInfoPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  PIDS 심볼 상세 보기 창(symbol-detail-and-door-control FR-15) — 편집 모드 아닐 때 우클릭 진입, 드래그 이동  -->
				<ContentPresenter
					x:Name="SymbolDetailPresenter"
					Canvas.Left="150"
					Canvas.Top="70"
					Panel.ZIndex="130"
					Content="{Binding SymbolDetailPanel}"
					Visibility="{Binding IsSymbolDetailPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

				<!--  카메라 팝업 연결선(Leader Line) — 카메라 심볼 중점 ↔ 팝업 경계, 팝업 아래 z레이어.
				      팝업과 동일하게 맵 영역으로 클립: 팝업이 맵 위로 스크롤되면 연결선도 맵 경계에서 잘려 상단 크롬을 덮지 않음.  -->
				<ItemsControl
					Canvas.Left="0"
					Canvas.Top="0"
					Width="{Binding ActualWidth, ElementName=PropertyPanelCanvas}"
					Height="{Binding ActualHeight, ElementName=PropertyPanelCanvas}"
					ClipToBounds="True"
					IsHitTestVisible="False"
					Panel.ZIndex="5"
					ItemsSource="{Binding CameraPopups}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<Canvas ClipToBounds="False" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Line
								IsHitTestVisible="False"
								Stroke="Red"
								StrokeDashArray="4 3"
								StrokeThickness="1.5"
								X1="{Binding LineX1}"
								X2="{Binding LineX2}"
								Y1="{Binding LineY1}"
								Y2="{Binding LineY2}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  카메라 RTSP 스트리밍 팝업(멀티) — Geo 앵커 추종, 드래그 이동.
				      ClipToBounds="True" + 캔버스 크기 고정: 팝업이 맵 영역(Grid.Row=2, PropertyPanelCanvas) 밖으로
				      넘쳐 상단 툴바/MahApps 윈도우 타이틀바·컨트롤바(최소/최대/닫기)를 덮는 것을 구조적으로 차단(2026-07-27 스크린샷).
				      PropertyPanelCanvas 자체는 다른 드래그 패널(음수 Top)을 위해 비클립 유지 — 이 레이어만 클립.  -->
				<ItemsControl
					Canvas.Left="0"
					Canvas.Top="0"
					Width="{Binding ActualWidth, ElementName=PropertyPanelCanvas}"
					Height="{Binding ActualHeight, ElementName=PropertyPanelCanvas}"
					ClipToBounds="True"
					Panel.ZIndex="10"
					ItemsSource="{Binding CameraPopups}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<Canvas ClipToBounds="False" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemContainerStyle>
						<Style TargetType="ContentPresenter">
							<Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
							<Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
								<Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
						</Style>
					</ItemsControl.ItemContainerStyle>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<ctrl:CameraStreamPopupControl
								Width="{Binding PopupWidth}"
								Height="{Binding ControlHeight}"
								PanelTitle="{Binding Title}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!--  카메라 RTSP 팝업 제어 허브 — 드래그 이동(Canvas.Left/Top↔HubX/Y) + 위치 기억(SaveHubPositionCommand).
				      0개면 컨트롤 자체가 Collapsed. ZIndex 210(팝업/패널 위). 플라이아웃은 컨트롤 내부 WPF Popup.  -->
				<ctrl:CameraPopupControlHub
					x:Name="CameraPopupHub"
					Canvas.Left="{Binding HubX, RelativeSource={RelativeSource Self}}"
					Canvas.Top="{Binding HubY, RelativeSource={RelativeSource Self}}"
					Panel.ZIndex="210"
					CloseAllCommand="{Binding CloseAllCameraPopupsCommand}"
					CloseCommand="{Binding CloseCameraPopupCommand}"
					DragCompletedCommand="{Binding SaveHubPositionCommand}"
					FocusCommand="{Binding FocusCameraPopupCommand}"
					HubX="{Binding HubPositionX, Mode=TwoWay}"
					HubY="{Binding HubPositionY, Mode=TwoWay}"
					OpenCount="{Binding CameraPopups.Count}"
					PopupsSource="{Binding CameraPopups}" />
			</Canvas>
		</Grid>
	</Grid>
</UserControl>
