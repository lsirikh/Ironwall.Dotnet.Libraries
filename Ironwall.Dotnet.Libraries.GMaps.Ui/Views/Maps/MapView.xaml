						HorizontalContentAlignment="Center"
						Kind="WindowClose" />

					<TextBox
						Width="50"
						Margin="3,0"
						VerticalAlignment="Center"
						HorizontalContentAlignment="Center"
						IsEnabled="{Binding HasSelectedItem}"
						Text="{Binding SelectedMarkerHeight}" />

					<md:PackIcon
						Width="16"
						Height="16"
						Margin="3,0"
						VerticalAlignment="Center"
						HorizontalContentAlignment="Center"
						Kind="AngleAcute" />


					<TextBox
						Width="50"
						Margin="3,0"
						VerticalAlignment="Center"
						HorizontalContentAlignment="Center"
						IsEnabled="{Binding HasSelectedItem}"
						Text="{Binding SelectedMarkerBearing}" />

					<md:PackIcon
						Width="16"
						Height="16"
						Margin="3,0"
