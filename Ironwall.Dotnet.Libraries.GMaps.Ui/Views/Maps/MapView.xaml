									Width="40"
									Height="12"
									Fill="{Binding Converter={StaticResource ColorTypeToBrushConverter}}"
									Stroke="Gray"
									StrokeThickness="0.5" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<ComboBox
						Width="50"
						Margin="3,0"
						IsEnabled="{Binding HasSelectedItem}"
						ItemsSource="{Binding AvailableSize}"
						SelectedItem="{Binding SelectedMarkerStrokeSize}"
