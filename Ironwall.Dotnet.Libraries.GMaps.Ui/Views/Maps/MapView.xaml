						Width="16"
						Height="16"
						Margin="3,0"
						VerticalAlignment="Center"
						Kind="Palette"
						ToolTip="색상 편집" />

					<ComboBox
						Width="70"
						Margin="3,0"
						IsEnabled="{Binding HasSelectedItem}"
						ItemsSource="{Binding AvailableColors}"
						SelectedItem="{Binding SelectedMarkerFillColor}"
