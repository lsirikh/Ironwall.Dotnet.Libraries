<UserControl
	x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps.MapView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:help="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:behavior="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Behaviors"
	xmlns:cal="http://caliburnmicro.com"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:ctrl="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls"
	xmlns:gmap="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapCustoms"
	xmlns:gproperty="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.GMapProperties"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:symbolUtils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils"
	xmlns:sysres="clr-namespace:Ironwall.Dotnet.Libraries.SystemResources.Models;assembly=Ironwall.Dotnet.Libraries.SystemResources"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.Utils;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:helpers="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Helpers"
	d:Background="WhiteSmoke"
	d:DesignHeight="450"
	d:DesignWidth="1200"
	FontFamily="{DynamicResource MaterialDesignFont}"
	mc:Ignorable="d"
	help:HelpTip.HandlesF1="True"
	AutomationProperties.AutomationId="GMaps.Map.Root">
	<!--  전역 단축키 — 상단 메뉴 명령을 맵 포커스 상태에서 동작(메뉴 스코프가 아닌 루트 스코프).
	      기존 코드 단축키(Ctrl+Shift+R 회전토글·Ctrl+R 회전리셋·Ctrl+←/→ 미세회전·Ctrl+A 전체선택)와 비충돌.  -->
	<UserControl.InputBindings>
		<!--  등록(편집 스트립) — 파일 메뉴 폐지(FR-C3) 후에도 단축키 유지. 타일폴더(Ctrl+D)는 기능 자체가
		      설정정보>지도설정 카드로 일원화되어 바인딩 제거(§3 매핑 '삭제(중복)').  -->
		<KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LoadMapImageCommand}" />
		<KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding LoadImageOverlayCommand}" />
		<KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding CreateCustomMapCommand}" />
		<KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExitApplicationCommand}" />
		<!--  지도(좌표계)  -->
		<KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ToggleWGS84Command}" />
		<KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ToggleMGRSCommand}" />
		<KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ToggleUTMCommand}" />
		<!--  보기(계기 토글) — Ctrl+Shift 조합, 회전토글 R과 비충돌  -->
		<KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding ToggleCompassVisibleCommand}" />
		<KeyBinding Key="W" Modifiers="Ctrl+Shift" Command="{Binding ToggleWindyIndicatorVisibleCommand}" />
		<KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{Binding ToggleDetFaultVisibleCommand}" />
		<KeyBinding Key="X" Modifiers="Ctrl+Shift" Command="{Binding ToggleCenterCrosshairCommand}" />
		<!--  지도 기울이기(map-tilt-25d FR-08 ②) — 툴바 토글·보기 메뉴와 동일 커맨드. 각도는 컨트롤 Ctrl(+Shift)+↑/↓  -->
		<KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ToggleTiltFeatureCommand}" />
	</UserControl.InputBindings>
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<symbolUtils:AreEqualMultiConverter x:Key="AreEqualMultiConverter" />
			<symbolUtils:ColorTypeToBrushConverter x:Key="ColorTypeToBrushConverter" />
		<symbolUtils:MarkerCategoryToDisplayNameConverter x:Key="MarkerCategoryToDisplayNameConverter" />
		<symbolUtils:MarkerCategoryToIconConverter x:Key="MarkerCategoryToIconConverter" />
		<symbolUtils:SymbolTypeToDisplayNameConverter x:Key="SymbolTypeToDisplayNameConverter" />
		<symbolUtils:SymbolTypeToIconConverter x:Key="SymbolTypeToIconConverter" />
		<utils:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
		<!--  map-tilt-25d FR-04: MainMap Height/Margin 오버스캔 MultiBinding(뷰포트 ActualHeight, φ_layout → Height | Margin)  -->
		<helpers:TiltOverscanConverter x:Key="TiltOverscanConverter" />
		<Style
			x:Name="CustomIconButton"
			BasedOn="{StaticResource MaterialDesignIconButton}"
			TargetType="Button">
			<Setter Property="Padding" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect
						BlurRadius="5"
						Direction="-90"
						RenderingBias="Quality"
						ShadowDepth="5"
						Color="Black" />
				</Setter.Value>
			</Setter>
		</Style>
		<Style
			x:Name="CustomSlider"
			BasedOn="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
			TargetType="Slider">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect
						BlurRadius="10"
						Direction="-90"
						RenderingBias="Quality"
						ShadowDepth="5"
						Color="Black" />
				</Setter.Value>
			</Setter>
		</Style>
		<Style
			x:Key="CompactComboBox"
			BasedOn="{StaticResource MaterialDesignComboBox}"
			TargetType="ComboBox">
			<Setter Property="Margin" Value="2" />
			<Setter Property="Padding" Value="4,2" />
			<Setter Property="FontSize" Value="10" />
			<Setter Property="MinHeight" Value="24" />
		</Style>

		<Style
			x:Key="CompactSlider"
			BasedOn="{StaticResource MaterialDesign3.MaterialDesignDiscreteSlider}"
			TargetType="Slider">
			<Setter Property="Margin" Value="2" />
			<Setter Property="Height" Value="20" />
		</Style>

		<!--  시스템 리소스 R1 도넛 게이지(FR-B1) — 링=사용률 호(MD 원형 determinate), 레벨색은 Tag(ResourceLevel) 트리거.
		      구 SysResChip(박스+아이콘)의 후신 — 토큰 스타일은 DesignTokens에 1릴리스 잔존.  -->
		<Style x:Key="SysResDonutHost" TargetType="StackPanel">
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="Margin" Value="10,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static sysres:ResourceLevel.Warning}">
					<Setter Property="TextElement.Foreground" Value="{DynamicResource StatusWarningBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static sysres:ResourceLevel.Critical}">
					<Setter Property="TextElement.Foreground" Value="{DynamicResource StatusCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!--  GPU: 카운터 부재 시 Hidden(공간 예약 — 리플로 방지, 기존 SysResChipGpu 동작 승계)  -->
		<Style
			x:Key="SysResDonutHostGpu"
			BasedOn="{StaticResource SysResDonutHost}"
			TargetType="StackPanel">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsGpuAvailable}" Value="False">
					<Setter Property="Visibility" Value="Hidden" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!--  링 드로잉 직접 소유(사용자 피드백 반영) — ① 회색 트랙 원이 항상 원형 실루엣을 유지하고
		      ② 호는 트랙과 정확히 동심·동두께(D=26,T=3, 12시 시작 시계방향). MD 원형 ProgressBar
		      템플릿 의존 제거(트랙과의 기하 일치를 보장할 수 없음).  -->
		<symbolUtils:PercentToDonutArcConverter
			x:Key="SysResDonutArcConverter"
			Diameter="26"
			Thickness="3" />
		<Style x:Key="SysResDonutTrack" TargetType="Ellipse">
			<Setter Property="Width" Value="26" />
			<Setter Property="Height" Value="26" />
			<Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
			<Setter Property="StrokeThickness" Value="3" />
		</Style>
		<Style x:Key="SysResDonutArc" TargetType="Path">
			<Setter Property="Width" Value="26" />
			<Setter Property="Height" Value="26" />
			<Setter Property="StrokeThickness" Value="3" />
			<Setter Property="StrokeStartLineCap" Value="Round" />
			<Setter Property="StrokeEndLineCap" Value="Round" />
			<Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static sysres:ResourceLevel.Warning}">
					<Setter Property="Stroke" Value="{DynamicResource StatusWarningBrush}" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static sysres:ResourceLevel.Critical}">
					<Setter Property="Stroke" Value="{DynamicResource StatusCriticalBrush}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<!--  링 중앙 약어(C/G/R) — 레벨색과 무관한 보조 텍스트  -->
		<Style x:Key="SysResDonutAbbr" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontSize" Value="8" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="IsHitTestVisible" Value="False" />
		</Style>
		<!--  % 병기(레벨색은 호스트 TextElement 상속) — Width=34 로 "100%"(4자) 폭을 선점(사용자 피드백):
		      자릿수가 5%↔55%↔100%로 바뀌어도 레이아웃이 좌우로 흔들리지 않는다. 우측 정렬=% 기호 고정.  -->
		<Style x:Key="SysResDonutText" TargetType="TextBlock">
			<Setter Property="Width" Value="34" />
			<Setter Property="TextAlignment" Value="Right" />
			<Setter Property="Margin" Value="5,0,0,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontFamily" Value="Consolas" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Medium" />
		</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid x:Name="MapView_OuterGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<!--<RowDefinition Height="50"/>-->
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  단일 커맨드 바 (Variant A): 메뉴(좌) + 툴바(채움)를 한 행에  -->
		<DockPanel
			Grid.Row="0"
			Grid.ColumnSpan="2"
			Margin="50,0,0,0"
			Panel.ZIndex="10"
			Background="{DynamicResource SurfaceBrush}">
			<Menu
				DockPanel.Dock="Left"
				VerticalAlignment="Center"
				Background="Transparent"
				IsMainMenu="True"
				Style="{StaticResource MaterialDesignMenu}">

			<!--  지도(M) 메뉴 (FR-C3) — 파일 메뉴 폐지: 등록 3종(맵/이미지/커스텀맵)→편집 스트립 '등록',
			      타일폴더 설정은 설정정보>지도설정 카드로 일원화(중복 삭제), 종료는 이 메뉴 최하단.
			      좌표계 토글: 마우스=IsChecked TwoWay 단일 토글, 키보드=루트 InputBindings(Ctrl+1/2/3).  -->
			<MenuItem Header="지도(_M)" AutomationProperties.AutomationId="GMaps.Map.MapMenu">
				<!--  지도 전환 라디오 — 콤보와 동일 기능의 키보드 접근 경로. 체크=현재 지도(참조 비교).  -->
				<MenuItem
					Header="지도 전환"
					Icon="{md:PackIcon Kind=SwapHorizontal}"
					ItemsSource="{Binding AvailableMaps}">
					<MenuItem.ItemContainerStyle>
						<Style BasedOn="{StaticResource MaterialDesignMenuItem}" TargetType="MenuItem">
							<Setter Property="Header" Value="{Binding Name}" />
							<Setter Property="Command" Value="{Binding DataContext.SelectMapCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
							<Setter Property="CommandParameter" Value="{Binding}" />
							<Setter Property="IsCheckable" Value="False" />
							<Setter Property="IsChecked">
								<Setter.Value>
									<MultiBinding Converter="{StaticResource AreEqualMultiConverter}" Mode="OneWay">
										<Binding />
										<Binding Path="DataContext.SelectedMapItem" RelativeSource="{RelativeSource AncestorType=Menu}" />
									</MultiBinding>
								</Setter.Value>
							</Setter>
						</Style>
					</MenuItem.ItemContainerStyle>
				</MenuItem>
				<MenuItem Header="좌표계" Icon="{md:PackIcon Kind=Earth}">
					<MenuItem
						Header="WGS-84 좌표계"
						InputGestureText="Ctrl+1"
						IsCheckable="True"
						IsChecked="{Binding IsShowWSG84, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<MenuItem
						Header="MGRS 좌표계"
						InputGestureText="Ctrl+2"
						IsCheckable="True"
						IsChecked="{Binding IsShowMGRS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<MenuItem
						Header="UTM 좌표계"
						InputGestureText="Ctrl+3"
						IsCheckable="True"
						IsChecked="{Binding IsShowUTM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				</MenuItem>
				<!--  설정정보>지도설정 바로가기 — 지도별 min/max 줌 편집 카드(zoom-float FR-20)  -->
				<MenuItem
					Command="{Binding OpenMapSetupCommand}"
					Header="지도 줌 범위 설정…"
					Icon="{md:PackIcon Kind=MagnifyPlusOutline}" />
				<Separator />
				<MenuItem
					Command="{Binding ExitApplicationCommand}"
					Header="종료"
					Icon="{md:PackIcon Kind=ExitToApp}"
					InputGestureText="Ctrl+E" />
			</MenuItem>

			<!--  보기(View) 메뉴 — 지도 계기 표시/숨김(GMap_Map_Instruments FR-14~16).
			      _Maps 좌표계 토글과 동일 IsCheckable+IsChecked TwoWay 패턴. 체크상태 영속(VM 세터→저장).  -->
			<MenuItem Header="보기(_V)">
				<MenuItem
					Header="방위각(나침반)"
					Icon="{md:PackIcon Kind=CompassOutline}"
					InputGestureText="Ctrl+Shift+C"
					IsCheckable="True"
					IsChecked="{Binding IsCompassVisible, Mode=TwoWay}" />
				<MenuItem
					Header="강풍모드 인디케이터"
					Icon="{md:PackIcon Kind=WeatherWindy}"
					InputGestureText="Ctrl+Shift+W"
					IsCheckable="True"
					IsChecked="{Binding IsWindyIndicatorVisible, Mode=TwoWay}" />
				<!--  대상: 이벤트 카드 리스트 헤더 신호등(FR-A5, pill 계기는 D2 제거)  -->
				<MenuItem
					Header="탐지·장애 신호등"
					Icon="{md:PackIcon Kind=TrafficLight}"
					InputGestureText="Ctrl+Shift+F"
					IsCheckable="True"
					IsChecked="{Binding IsDetFaultVisible, Mode=TwoWay}" />
				<Separator />
				<MenuItem
					Header="중앙 십자선"
					Icon="{md:PackIcon Kind=Crosshairs}"
					InputGestureText="Ctrl+Shift+X"
					IsCheckable="True"
					IsChecked="{Binding IsCenterCrosshairVisible, Mode=TwoWay}" />
				<Separator />
				<!--  지도 기울이기(map-tilt-25d FR-08 ②) — 툴바 토글과 같은 kill-switch(컨트롤 IsTiltFeatureEnabled SSOT).
				      앵커 A모드(정북 고정) 중엔 잠금(IsTiltToggleEnabled). 각도는 툴바 팝업 슬라이더 / Ctrl(+Shift)+↑/↓.  -->
				<MenuItem
					AutomationProperties.AutomationId="GMaps.Tilt.MenuToggle"
					Header="지도 기울이기"
					Icon="{md:PackIcon Kind=PerspectiveMore}"
					InputGestureText="Ctrl+Shift+T"
					IsCheckable="True"
					IsChecked="{Binding IsTiltFeatureEnabled, Mode=TwoWay}"
					IsEnabled="{Binding IsTiltToggleEnabled}"
					ToolTipService.ShowOnDisabled="True"
					ToolTip="{Binding TiltToggleToolTip}" />
			</MenuItem>
		</Menu>

			<!--  시스템 리소스 R1 도넛 게이지(우측 정렬) — 링=사용률 호, 중앙 약어, 레벨색(시안→노랑→빨강), % 병기 (FR-B1)
			      그룹 Border(사용자 피드백): 신호등 pill 과 동계열(SurfaceSunken+Border 토큰)로 도넛 3개를 하나의 캡슐로 묶는다.  -->
			<Border
				DockPanel.Dock="Right"
				Margin="0,0,10,0"
				Padding="0,2,10,2"
				VerticalAlignment="Center"
				AutomationProperties.AutomationId="GMaps.SysRes.Panel"
				Background="{DynamicResource SurfaceSunkenBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="16">
			<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
				<StackPanel
					AutomationProperties.AutomationId="GMaps.SysRes.Cpu"
					Style="{StaticResource SysResDonutHost}"
					Tag="{Binding CpuLevel}"
					ToolTip="{Binding CpuTooltip}">
					<Grid>
						<Ellipse Style="{StaticResource SysResDonutTrack}" />
						<Path
							Data="{Binding CpuPercent, Converter={StaticResource SysResDonutArcConverter}}"
							Style="{StaticResource SysResDonutArc}"
							Tag="{Binding CpuLevel}" />
						<TextBlock Style="{StaticResource SysResDonutAbbr}" Text="C" />
					</Grid>
					<TextBlock Style="{StaticResource SysResDonutText}" Text="{Binding CpuText}" />
				</StackPanel>
				<StackPanel
					AutomationProperties.AutomationId="GMaps.SysRes.Gpu"
					Style="{StaticResource SysResDonutHostGpu}"
					Tag="{Binding GpuLevel}"
					ToolTip="{Binding GpuTooltip}">
					<Grid>
						<Ellipse Style="{StaticResource SysResDonutTrack}" />
						<Path
							Data="{Binding GpuPercent, Converter={StaticResource SysResDonutArcConverter}}"
							Style="{StaticResource SysResDonutArc}"
							Tag="{Binding GpuLevel}" />
						<TextBlock Style="{StaticResource SysResDonutAbbr}" Text="G" />
					</Grid>
					<TextBlock Style="{StaticResource SysResDonutText}" Text="{Binding GpuText}" />
				</StackPanel>
				<StackPanel
					AutomationProperties.AutomationId="GMaps.SysRes.Ram"
					Style="{StaticResource SysResDonutHost}"
					Tag="{Binding RamLevel}"
					ToolTip="{Binding RamTooltip}">
					<Grid>
						<Ellipse Style="{StaticResource SysResDonutTrack}" />
						<Path
							Data="{Binding RamPercent, Converter={StaticResource SysResDonutArcConverter}}"
							Style="{StaticResource SysResDonutArc}"
							Tag="{Binding RamLevel}" />
						<TextBlock Style="{StaticResource SysResDonutAbbr}" Text="R" />
					</Grid>
					<TextBlock Style="{StaticResource SysResDonutText}" Text="{Binding RamText}" />
				</StackPanel>
			</StackPanel>
			</Border>

			<!--  탐지·장애 신호등(T1) — 시스템 도넛 캡슐 좌측·동일 높이 32(사용자 확정: 이벤트 헤더 배치 철회).
			      숫자 = EQM 활성(미조치) 건수, 점등 시에만 램프 옆 표시 · 미초기화 "—".
			      깜빡임 정책(사용자 확정): 탐지(노랑)=깜빡 · 장애(빨강)=상시 점등.
			      클릭 = 이벤트 패널 오픈(D-10 승계) · 보기>탐지·장애 신호등(Ctrl+Shift+F)이 가시성 직접 제어.  -->
			<Border
				DockPanel.Dock="Right"
				Height="32"
				Margin="0,0,8,0"
				Padding="10,0"
				VerticalAlignment="Center"
				AutomationProperties.AutomationId="GMaps.Status.TrafficLight"
				Background="{DynamicResource SurfaceSunkenBrush}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1"
				CornerRadius="16"
				Cursor="Hand"
				ToolTip="{Binding TrafficTooltip}"
				Visibility="{Binding IsDetFaultVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Border.InputBindings>
					<MouseBinding Command="{Binding OpenEventPanelCommand}" MouseAction="LeftClick" />
				</Border.InputBindings>
				<StackPanel VerticalAlignment="Center" Orientation="Horizontal">
					<StackPanel.Resources>
						<!--  램프 공통: 소등=테두리만, 점등=DataTrigger가 채움+글로 부여  -->
						<Style x:Key="LampBase" TargetType="Ellipse">
							<Setter Property="Width" Value="12" />
							<Setter Property="Height" Value="12" />
							<Setter Property="VerticalAlignment" Value="Center" />
							<Setter Property="Fill" Value="{DynamicResource SurfaceAltBrush}" />
							<Setter Property="Stroke" Value="{DynamicResource BorderBrush}" />
							<Setter Property="StrokeThickness" Value="1" />
						</Style>
						<Style x:Key="LampCount" TargetType="TextBlock">
							<Setter Property="Margin" Value="4,0,0,0" />
							<Setter Property="VerticalAlignment" Value="Center" />
							<Setter Property="FontFamily" Value="Consolas" />
							<Setter Property="FontSize" Value="12" />
							<Setter Property="FontWeight" Value="Bold" />
						</Style>
					</StackPanel.Resources>

					<!--  🔴 장애 — 상시 점등(깜빡임 없음, 사용자 확정)  -->
					<Ellipse AutomationProperties.AutomationId="GMaps.Status.TrafficLight.FaultLamp">
						<Ellipse.Style>
							<Style BasedOn="{StaticResource LampBase}" TargetType="Ellipse">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsTrafficFaultOn}" Value="True">
										<Setter Property="Fill" Value="{DynamicResource StatusCriticalBrush}" />
										<Setter Property="Stroke" Value="{DynamicResource StatusCriticalBrush}" />
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect
													BlurRadius="8"
													Opacity="0.9"
													ShadowDepth="0"
													Color="#FF5A52" />
											</Setter.Value>
										</Setter>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Ellipse.Style>
					</Ellipse>
					<TextBlock AutomationProperties.AutomationId="GMaps.Status.TrafficLight.FaultCount">
						<TextBlock.Style>
							<Style BasedOn="{StaticResource LampCount}" TargetType="TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource StatusCriticalBrush}" />
								<Setter Property="Text" Value="{Binding TrafficFaultCount}" />
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsTrafficFaultOn}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<!--  🟡 탐지 — 점등 시 깜빡임(사용자 확정)  -->
					<Ellipse Margin="7,0,0,0" AutomationProperties.AutomationId="GMaps.Status.TrafficLight.DetectionLamp">
						<Ellipse.Style>
							<Style BasedOn="{StaticResource LampBase}" TargetType="Ellipse">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsTrafficDetectionOn}" Value="True">
										<Setter Property="Fill" Value="{DynamicResource StatusWarningBrush}" />
										<Setter Property="Stroke" Value="{DynamicResource StatusWarningBrush}" />
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect
													BlurRadius="8"
													Opacity="0.85"
													ShadowDepth="0"
													Color="#FFB02E" />
											</Setter.Value>
										</Setter>
										<DataTrigger.EnterActions>
											<BeginStoryboard x:Name="TrafficDetectionBlink">
												<Storyboard AutoReverse="True" RepeatBehavior="Forever">
													<DoubleAnimation
														Storyboard.TargetProperty="Opacity"
														From="1.0"
														To="0.35"
														Duration="0:0:0.5" />
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
										<DataTrigger.ExitActions>
											<StopStoryboard BeginStoryboardName="TrafficDetectionBlink" />
										</DataTrigger.ExitActions>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Ellipse.Style>
					</Ellipse>
					<TextBlock AutomationProperties.AutomationId="GMaps.Status.TrafficLight.DetectionCount">
						<TextBlock.Style>
							<Style BasedOn="{StaticResource LampCount}" TargetType="TextBlock">
								<Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
								<Setter Property="Text" Value="{Binding TrafficDetectionCount}" />
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsTrafficDetectionOn}" Value="True">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<!--  🟢 정상 (green = ready && 둘 다 0 — TrafficLampLogic 불변식)  -->
					<Ellipse Margin="7,0,0,0" AutomationProperties.AutomationId="GMaps.Status.TrafficLight.NormalLamp">
						<Ellipse.Style>
							<Style BasedOn="{StaticResource LampBase}" TargetType="Ellipse">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsTrafficGreenOn}" Value="True">
										<Setter Property="Fill" Value="{DynamicResource StatusNormalBrush}" />
										<Setter Property="Stroke" Value="{DynamicResource StatusNormalBrush}" />
										<Setter Property="Effect">
											<Setter.Value>
												<DropShadowEffect
													BlurRadius="6"
													Opacity="0.8"
													ShadowDepth="0"
													Color="#46D17A" />
											</Setter.Value>
										</Setter>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Ellipse.Style>
					</Ellipse>

					<!--  미초기화 표기 "—" (데이터 없음 ≠ 정상)  -->
					<TextBlock
						Margin="6,0,0,0"
						VerticalAlignment="Center"
						FontFamily="Consolas"
						FontSize="12"
						Foreground="{DynamicResource TextSecondaryBrush}"
						Text="—">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsTrafficCountsReady}" Value="False">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</StackPanel>
			</Border>

			<ToolBarTray
				VerticalAlignment="Center"
				Background="{DynamicResource SurfaceBrush}"
				md:ThemeAssist.Theme="Inherit">
			<ToolBar ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" Style="{StaticResource MaterialDesignToolBar}">

				<!--  운영 모드 기본 노출(FR-C1) — 그룹 라벨 제거(툴팁이 이름 담당), 구분선만 유지.
				      수정 계열(등록·심볼·선택·기준)은 편집 스트립(Grid.Row=1, FR-C2)으로 이관.  -->

				<!--  ① 지도 선택  -->
				<ComboBox
					Width="150"
					Margin="5,0"
					ItemsSource="{Binding AvailableMaps}"
					SelectedItem="{Binding SelectedMapItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Style="{StaticResource CompactComboBox}"
					ToolTip="지도 선택">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<md:PackIcon
									Width="14"
									Height="14"
									Margin="0,0,5,0"
									VerticalAlignment="Center"
									Kind="Map" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="11"
									Text="{Binding Name}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ② 이동/조회 — 홈설정·앵커는 편집 스트립 '기준'으로, 십자는 보기 메뉴로 일원화(삭제),
				      추적 설정은 재생 패널 헤더로 이동(FR-C5)  -->
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding MoveHomeLocationCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="홈 위치 이동">
							<md:PackIcon Kind="Home" />
						</Button>
						<Button Command="{Binding ShowMapRoiPanelCommand}" ToolTip="관심지역 관리">
							<Button.Style>
								<Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsMapRoiPanelVisible}" Value="True">
											<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<md:PackIcon Kind="MapMarkerRadius" />
						</Button>
						<Button AutomationProperties.AutomationId="GMaps.Toolbar.LayerPanelButton" Command="{Binding ShowLayerPanelCommand}" ToolTip="레이어 관리">
							<Button.Style>
								<Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsLayerPanelVisible}" Value="True">
											<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<md:PackIcon Kind="Layers" />
						</Button>
						<Button Command="{Binding TogglePlaybackPanelCommand}" ToolTip="추적 재생(Playback)">
							<Button.Style>
								<Style BasedOn="{StaticResource ToolbarButtonStyle}" TargetType="Button">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsPlaybackPanelVisible}" Value="True">
											<Setter Property="Foreground" Value="{StaticResource PrimaryBlueBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<md:PackIcon Kind="PlayCircleOutline" />
						</Button>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ③ 측정 도구 (길이/넓이 — Measure_Tools, 운영 유지 Q3)  -->
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<ToggleButton
							Command="{Binding MeasureLengthCommand}"
							IsChecked="{Binding IsMeasureLengthActive, Mode=OneWay}"
							Style="{StaticResource ToolbarToggleButtonStyle}"
							ToolTip="길이 측정">
							<md:PackIcon Kind="Ruler" />
						</ToggleButton>
						<ToggleButton
							Command="{Binding MeasureAreaCommand}"
							IsChecked="{Binding IsMeasureAreaActive, Mode=OneWay}"
							Style="{StaticResource ToolbarToggleButtonStyle}"
							ToolTip="넓이 측정">
							<md:PackIcon Kind="VectorSquare" />
						</ToggleButton>
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ④ 회전 (GMap_Rotation_Full_Sync FR-18 — kill-switch 토글, Ctrl+Shift+R과 동일)
				      + 기울이기 (map-tilt-25d FR-08 ① — kill-switch 토글 Ctrl+Shift+T, 각도 팝업 슬라이더)  -->
				<Border Style="{StaticResource ToolbarGroupStyle}">
					<StackPanel Orientation="Horizontal">
						<!--  Q-7 정정: OFF 는 정북 복귀가 아니라 '회전 입력 차단 + 현재 각도 유지'(GMapCustomControl.ToggleRotationFeature 실동작).
						      정북 복귀는 나침반 N 클릭 / Ctrl+R(ResetRotation).  -->
						<ToggleButton
							Command="{Binding ToggleRotationFeatureCommand}"
							IsChecked="{Binding IsRotationFeatureEnabled, Mode=OneWay}"
							IsEnabled="{Binding IsRotationToggleEnabled}"
							ToolTipService.ShowOnDisabled="True">
							<!--  help-callout H-4 — 툴팁은 이름 + 단축키만. 조작법은 이 묶음의 "?"(Map.Toolbar.RotateTilt).
							      잠금 사유는 화면에 남는 글이라 꺼졌을 때만 바꿔 단다(로컬 ToolTip 은 트리거를 이기므로 스타일 안에서).  -->
							<ToggleButton.Style>
								<Style BasedOn="{StaticResource ToolbarToggleButtonStyle}" TargetType="ToggleButton">
									<Setter Property="ToolTip" Value="지도 회전 모드 (Ctrl+Shift+R)" />
									<Style.Triggers>
										<Trigger Property="IsEnabled" Value="False">
											<Setter Property="ToolTip" Value="지도 회전 모드 — 사이트 고정 중에는 바꿀 수 없습니다(고정을 먼저 해제하세요)" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</ToggleButton.Style>
							<md:PackIcon Kind="CompassOutline" />
						</ToggleButton>
						<!--  기울이기 토글 — IsChecked OneWay(컨트롤 SSOT) + Command. 앵커 A모드면 잠금(ShowOnDisabled 사유 툴팁).
						      Popup 은 PlacementTarget 미지정 → 논리 부모(Grid = 토글 영역) 기준 Bottom 배치(x:Name 추가 금지 규칙).  -->
						<Grid>
							<ToggleButton
								AutomationProperties.AutomationId="GMaps.Tilt.Toggle"
								Command="{Binding ToggleTiltFeatureCommand}"
								IsChecked="{Binding IsTiltFeatureEnabled, Mode=OneWay}"
								IsEnabled="{Binding IsTiltToggleEnabled}"
								Style="{StaticResource ToolbarToggleButtonStyle}"
								ToolTipService.ShowOnDisabled="True"
								ToolTip="{Binding TiltToggleToolTip}">
								<md:PackIcon Kind="PerspectiveMore" />
							</ToggleButton>
							<Popup
								AllowsTransparency="True"
								IsOpen="{Binding IsTiltAnglePopupOpen, Mode=TwoWay}"
								Placement="Bottom"
								StaysOpen="False"
								VerticalOffset="4">
								<Border
									MinWidth="300"
									Padding="12,8"
									Background="{DynamicResource SurfaceBrush}"
									BorderBrush="{DynamicResource PrimaryHueMidBrush}"
									BorderThickness="1.5"
									CornerRadius="6">
									<Border.Effect>
										<DropShadowEffect
											BlurRadius="8"
											Direction="-90"
											Opacity="0.18"
											RenderingBias="Performance"
											ShadowDepth="4" />
									</Border.Effect>
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<md:PackIcon
											Width="18"
											Height="18"
											Margin="0,0,8,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource TextSecondaryBrush}"
											Kind="AngleAcute" />
										<Button
											AutomationProperties.AutomationId="GMaps.Tilt.StepDown"
											Command="{Binding StepTiltAngleCommand}"
											CommandParameter="-5"
											Style="{StaticResource ToolbarButtonStyle}"
											ToolTip="−5° (Ctrl+↓ · 미세 Ctrl+Shift+↓ 1°)">
											<md:PackIcon Kind="Minus" />
										</Button>
										<!--  0~MaxAngleDeg(기본 35), 5° 틱 스냅. Value TwoWay → VM 세터 → 컨트롤 RequestedTiltDeg 즉시 반영(라이브 재대입은 컨트롤, G8 150 ms 정착).  -->
										<Slider
											Width="160"
											Margin="4,0"
											VerticalAlignment="Center"
											AutomationProperties.AutomationId="GMaps.Tilt.AngleSlider"
											IsSnapToTickEnabled="True"
											Maximum="{Binding TiltMaxAngleDeg, Mode=OneWay}"
											Minimum="0"
											TickFrequency="5"
											TickPlacement="BottomRight"
											Value="{Binding TiltAngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
										<Button
											AutomationProperties.AutomationId="GMaps.Tilt.StepUp"
											Command="{Binding StepTiltAngleCommand}"
											CommandParameter="5"
											Style="{StaticResource ToolbarButtonStyle}"
											ToolTip="+5° (Ctrl+↑ · 미세 Ctrl+Shift+↑ 1°)">
											<md:PackIcon Kind="Plus" />
										</Button>
										<TextBlock
											MinWidth="34"
											Margin="6,0,0,0"
											VerticalAlignment="Center"
											AutomationProperties.AutomationId="GMaps.Tilt.AngleText"
											Foreground="{DynamicResource TextPrimaryBrush}"
											Text="{Binding TiltAngleDeg, StringFormat={}{0:0}°}"
											TextAlignment="Right" />
										<Button
											Margin="6,0,0,0"
											Command="{Binding ToggleTiltAnglePopupCommand}"
											Style="{StaticResource ToolbarButtonStyle}"
											ToolTip="닫기">
											<md:PackIcon Kind="Close" />
										</Button>
									</StackPanel>
								</Border>
							</Popup>
						</Grid>
						<!--  각도 팝업 재열기(토글 OFF/ON 없이). 기울이기 OFF 면 비활성.  -->
						<ToggleButton
							Width="16"
							AutomationProperties.AutomationId="GMaps.Tilt.AngleButton"
							IsChecked="{Binding IsTiltAnglePopupOpen, Mode=TwoWay}"
							IsEnabled="{Binding IsTiltFeatureEnabled}"
							Style="{StaticResource ToolbarToggleButtonStyle}"
							ToolTip="기울임 각도 조절 (0~35°, 5° 단위)">
							<md:PackIcon
								Width="14"
								Height="14"
								Kind="ChevronDown" />
						</ToggleButton>
						<!--  회전 · 기울이기 "?"(help-callout H-4) — 단축키 · 동작 원리 · 기울임 배지 뜻  -->
						<help:HelpTip
							Margin="4,0,2,0"
							HelpKey="Map.Toolbar.RotateTilt"
							Scope="{Binding RelativeSource={RelativeSource AncestorType=Border}}" />
					</StackPanel>
				</Border>

				<Border Style="{StaticResource ToolbarSeparatorStyle}" />

				<!--  ⑤ 편집 스위치 (FR-C4) — CanMapEdit 권한자에게만 렌더(비노출, Q4). ON 시 편집 스트립 확장.  -->
				<StackPanel
					AutomationProperties.AutomationId="GMaps.EditSwitch.Host"
					Orientation="Horizontal"
					Visibility="{Binding CanMapEdit, Converter={StaticResource BooleanToVisibilityConverter}}">
					<ToggleButton
						x:Name="EditModeToggle"
						Command="{Binding ToggleEditModeCommand}"
						IsChecked="{Binding IsEditModeEnabled, Mode=OneWay}"
						IsEnabled="{Binding CanMapEdit}"
						Style="{StaticResource MaterialDesignSwitchToggleButton}"
						ToolTip="편집 모드">
						<md:PackIcon Kind="Draw" />
					</ToggleButton>
					<TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Text" Value="편집" />
								<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsEditModeEnabled}" Value="True">
										<Setter Property="Text" Value="편집 중" />
										<Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}" />
										<Setter Property="FontWeight" Value="Bold" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
					<!--  편집 모드 "?"(help-callout H-4) — 켜면 무엇이 열리는지  -->
					<help:HelpTip
						Margin="6,0,0,0"
						HelpKey="Map.Toolbar.EditMode"
						Scope="{Binding RelativeSource={RelativeSource AncestorType=StackPanel}}" />
				</StackPanel>

				<!--  라인 드로잉 전용 버튼 추가 (AREA_BOUNDARY 카테고리일 때만 표시)  -->
				<!--<Button
					Command="{Binding StartLineDrawingCommand}"
					CommandParameter="boundary"
					IsEnabled="{Binding CanStartLineDrawing}"
					Style="{StaticResource MaterialDesignToolButton}"
					ToolTip="라인 그리기 시작 (Ctrl+L)"
					Visibility="{Binding SelectedMarkerCategory, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AREA_BOUNDARY}">
					<Button.InputBindings>
						<KeyBinding Key="L" Modifiers="Ctrl" />
					</Button.InputBindings>
					<StackPanel Orientation="Horizontal">
						<md:PackIcon
							Width="16"
							Height="16"
							Kind="VectorLine" />
						<TextBlock
							Margin="3,0,0,0"
							VerticalAlignment="Center"
							FontSize="10"
							Text="라인" />
					</StackPanel>
				</Button>-->


