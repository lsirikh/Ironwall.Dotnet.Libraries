<UserControl
	x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.Views.Maps.Map3DNavControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:help="clr-namespace:Ironwall.Dotnet.Libraries.Utils.Consoles;assembly=Ironwall.Dotnet.Libraries.Utils"
	xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:utils="clr-namespace:Ironwall.Dotnet.Libraries.GMaps.Ui.Utils"
	PreviewKeyDown="OnPreviewKeyDown"
	PreviewKeyUp="OnPreviewKeyUp"
	IsKeyboardFocusWithinChanged="OnKeyboardFocusWithinChanged">
	<!--  3D 방향 링 · 이동 단추(2026-10-19, Fusion 360 뷰 큐브 · 궤도 링 참고) — DataContext = MapViewModel(MapViewModel.Map3DNav).
	      링: 빨간 N = 정북(누르면 정북), 판을 끌면 방위 회전(Thumb 캡처 · 데드존 8 DIU · 끝 = DragCompleted 하나), 가운데 지구본을 위아래로 끌면 기울기.
	      아래: 위에서 보기 · 비스듬히, 이동(앞 · 뒤 · 왼쪽 · 오른쪽 — 누르고 있으면 계속) · 확대 · 축소. 키보드 폴백은 code-behind.
	      디자인 = 지도 HUD 와 같은 MapFloatingPanelStyle · PanelSecondaryButtonStyle, 색은 토큰만(DynamicResource — 라이트/다크), 나침반과 같은 N(StatusCriticalBrush).  -->
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Ironwall.Dotnet.Libraries.GMaps.Ui;component/Themes/DesignTokens.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<!--  이동 · 보기 단추 — 패널 보조 단추 모양 그대로, 크기만 작게  -->
			<Style x:Key="Map3DNavButtonStyle" BasedOn="{StaticResource PanelSecondaryButtonStyle}" TargetType="Button">
				<Setter Property="Width" Value="30" />
				<Setter Property="Height" Value="30" />
				<Setter Property="Margin" Value="1" />
				<Setter Property="Padding" Value="0" />
			</Style>
			<Style x:Key="Map3DNavTickStyle" TargetType="Rectangle">
				<Setter Property="Width" Value="2" />
				<Setter Property="Height" Value="7" />
				<Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
				<Setter Property="RenderTransformOrigin" Value="0.5,7.57" />
			</Style>
			<Style x:Key="Map3DNavLetterStyle" TargetType="TextBlock">
				<Setter Property="Width" Value="16" />
				<Setter Property="FontSize" Value="10" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="TextAlignment" Value="Center" />
				<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<Border
		Padding="6"
		AutomationProperties.AutomationId="GMaps.Map3D.Nav"
		Style="{StaticResource MapFloatingPanelStyle}">
		<StackPanel>
			<DockPanel Margin="2,0,0,4">
				<help:HelpTip
					VerticalAlignment="Center"
					DockPanel.Dock="Right"
					HelpKey="Map.Map3D.Nav"
					Scope="{Binding RelativeSource={RelativeSource AncestorType=Border}}" />
				<TextBlock
					VerticalAlignment="Center"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Bearing"
					FontSize="11"
					Foreground="{DynamicResource TextSecondaryBrush}"
					Text="{Binding Map3DNavBearingText}" />
			</DockPanel>

			<!--  방향 링 — 112 × 112. 회전하는 층(눈금 · 글자 · N 단추)은 3D 방위를 따라 돈다(Map3DNavRingAngle).  -->
			<Grid Width="112" Height="112">
				<Thumb
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Ring"
					AutomationProperties.Name="방향 링"
					Cursor="Hand"
					DragCompleted="OnRingDragCompleted"
					DragDelta="OnRingDragDelta"
					DragStarted="OnRingDragStarted"
					Focusable="True"
					IsTabStop="True"
					ToolTip="끌어서 방향 돌리기">
					<Thumb.Template>
						<ControlTemplate TargetType="Thumb">
							<Grid Background="Transparent">
								<Ellipse
									x:Name="Rim"
									Fill="{DynamicResource SurfaceAltBrush}"
									Stroke="{DynamicResource BorderBrush}"
									StrokeThickness="1" />
								<Ellipse
									Margin="20"
									Fill="{DynamicResource SurfaceBrush}"
									Stroke="{DynamicResource DividerBrush}"
									StrokeThickness="1" />
								<Canvas
									Width="112"
									Height="112"
									IsHitTestVisible="False"
									RenderTransformOrigin="0.5,0.5">
									<Canvas.RenderTransform>
										<RotateTransform Angle="{Binding Map3DNavRingAngle}" />
									</Canvas.RenderTransform>
									<!--  30° 눈금(기수 방위는 글자) — 중심(56,56)에서 반지름 49~56  -->
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="30" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="60" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="120" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="150" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="210" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="240" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="300" /></Rectangle.RenderTransform></Rectangle>
									<Rectangle Canvas.Left="55" Canvas.Top="3" Style="{StaticResource Map3DNavTickStyle}"><Rectangle.RenderTransform><RotateTransform Angle="330" /></Rectangle.RenderTransform></Rectangle>
									<TextBlock Canvas.Left="96" Canvas.Top="49" Style="{StaticResource Map3DNavLetterStyle}" Text="E" />
									<TextBlock Canvas.Left="48" Canvas.Top="96" Style="{StaticResource Map3DNavLetterStyle}" Text="S" />
									<TextBlock Canvas.Left="0" Canvas.Top="49" Style="{StaticResource Map3DNavLetterStyle}" Text="W" />
								</Canvas>
							</Grid>
							<ControlTemplate.Triggers>
								<!--  초점 · 끄는 중 = 테두리 두께(색이 아니라 형태)  -->
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Rim" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
									<Setter TargetName="Rim" Property="StrokeThickness" Value="2" />
								</Trigger>
								<Trigger Property="IsDragging" Value="True">
									<Setter TargetName="Rim" Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
									<Setter TargetName="Rim" Property="StrokeThickness" Value="2" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Thumb.Template>
				</Thumb>

				<!--  N(정북) 단추 — 링과 함께 돈다. 누르면 정북  -->
				<Canvas
					Width="112"
					Height="112"
					RenderTransformOrigin="0.5,0.5">
					<Canvas.RenderTransform>
						<RotateTransform Angle="{Binding Map3DNavRingAngle}" />
					</Canvas.RenderTransform>
					<Button
						Canvas.Left="45"
						Canvas.Top="0"
						Width="22"
						Height="20"
						AutomationProperties.AutomationId="GMaps.Map3D.Nav.North"
						AutomationProperties.Name="정북"
						Command="{Binding Map3DNorthCommand}"
						Cursor="Hand"
						Focusable="False"
						ToolTip="정북으로">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="Transparent">
									<TextBlock
										x:Name="Letter"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										FontWeight="Bold"
										Foreground="{DynamicResource StatusCriticalBrush}"
										Text="N" />
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Letter" Property="FontSize" Value="15" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</Canvas>

				<!--  가운데 지구본 — 위로 끌면 눕히기(멀리 보기), 아래로 끌면 위에서 보기 쪽  -->
				<Thumb
					Width="40"
					Height="40"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Tilt"
					AutomationProperties.Name="기울기"
					Cursor="SizeNS"
					DragCompleted="OnTiltDragCompleted"
					DragDelta="OnTiltDragDelta"
					DragStarted="OnTiltDragStarted"
					Focusable="False"
					ToolTip="위아래로 끌어 기울이기">
					<Thumb.Template>
						<ControlTemplate TargetType="Thumb">
							<Grid Background="Transparent">
								<Ellipse
									x:Name="Globe"
									Fill="{DynamicResource SurfaceBrush}"
									Stroke="{DynamicResource PrimaryBrush}"
									StrokeThickness="1.5" />
								<!--  경선 · 위선(지구본 모양)  -->
								<Ellipse
									Width="16"
									Stroke="{DynamicResource PrimaryBrush}"
									StrokeThickness="1" />
								<Line
									VerticalAlignment="Center"
									Stroke="{DynamicResource PrimaryBrush}"
									StrokeThickness="1"
									X1="2"
									X2="38" />
								<Path
									Data="M 6,12 Q 20,17 34,12 M 6,28 Q 20,23 34,28"
									Stroke="{DynamicResource PrimaryBrush}"
									StrokeThickness="1" />
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsDragging" Value="True">
									<Setter TargetName="Globe" Property="StrokeThickness" Value="2.5" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Thumb.Template>
				</Thumb>
			</Grid>

			<!--  위에서 보기 · 비스듬히  -->
			<StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
				<Button
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.TopView"
					AutomationProperties.Name="위에서 보기"
					Command="{Binding Map3DTopViewCommand}"
					Focusable="False"
					Style="{StaticResource Map3DNavButtonStyle}"
					ToolTip="위에서 보기">
					<md:PackIcon Width="18" Height="18" Kind="ArrowCollapseDown" />
				</Button>
				<Button
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.DefaultView"
					AutomationProperties.Name="비스듬히"
					Command="{Binding Map3DDefaultViewCommand}"
					Focusable="False"
					Style="{StaticResource Map3DNavButtonStyle}"
					ToolTip="비스듬히(처음 기울기)">
					<md:PackIcon Width="18" Height="18" Kind="AngleAcute" />
				</Button>
			</StackPanel>

			<!--  이동 — 바라보는 방향 기준. 누르고 있으면 계속(Tag = 방향)  -->
			<Grid Margin="0,4,0,0" HorizontalAlignment="Center">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button
					Grid.Row="0"
					Grid.Column="0"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.ZoomIn"
					AutomationProperties.Name="확대"
					Click="OnMoveClick"
					Focusable="False"
					LostMouseCapture="OnMoveLostCapture"
					PreviewMouseLeftButtonDown="OnMoveDown"
					PreviewMouseLeftButtonUp="OnMoveUp"
					Style="{StaticResource Map3DNavButtonStyle}"
					Tag="{x:Static utils:Map3DNavMove.ZoomIn}"
					ToolTip="확대">
					<md:PackIcon Width="18" Height="18" Kind="MagnifyPlusOutline" />
				</Button>
				<Button
					Grid.Row="0"
					Grid.Column="1"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Forward"
					AutomationProperties.Name="앞으로"
					Click="OnMoveClick"
					Focusable="False"
					LostMouseCapture="OnMoveLostCapture"
					PreviewMouseLeftButtonDown="OnMoveDown"
					PreviewMouseLeftButtonUp="OnMoveUp"
					Style="{StaticResource Map3DNavButtonStyle}"
					Tag="{x:Static utils:Map3DNavMove.Forward}"
					ToolTip="앞으로">
					<md:PackIcon Width="18" Height="18" Kind="ChevronUp" />
				</Button>
				<Button
					Grid.Row="0"
					Grid.Column="2"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.ZoomOut"
					AutomationProperties.Name="축소"
					Click="OnMoveClick"
					Focusable="False"
					LostMouseCapture="OnMoveLostCapture"
					PreviewMouseLeftButtonDown="OnMoveDown"
					PreviewMouseLeftButtonUp="OnMoveUp"
					Style="{StaticResource Map3DNavButtonStyle}"
					Tag="{x:Static utils:Map3DNavMove.ZoomOut}"
					ToolTip="축소">
					<md:PackIcon Width="18" Height="18" Kind="MagnifyMinusOutline" />
				</Button>
				<Button
					Grid.Row="1"
					Grid.Column="0"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Left"
					AutomationProperties.Name="왼쪽으로"
					Click="OnMoveClick"
					Focusable="False"
					LostMouseCapture="OnMoveLostCapture"
					PreviewMouseLeftButtonDown="OnMoveDown"
					PreviewMouseLeftButtonUp="OnMoveUp"
					Style="{StaticResource Map3DNavButtonStyle}"
					Tag="{x:Static utils:Map3DNavMove.Left}"
					ToolTip="왼쪽으로">
					<md:PackIcon Width="18" Height="18" Kind="ChevronLeft" />
				</Button>
				<Button
					Grid.Row="1"
					Grid.Column="2"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Right"
					AutomationProperties.Name="오른쪽으로"
					Click="OnMoveClick"
					Focusable="False"
					LostMouseCapture="OnMoveLostCapture"
					PreviewMouseLeftButtonDown="OnMoveDown"
					PreviewMouseLeftButtonUp="OnMoveUp"
					Style="{StaticResource Map3DNavButtonStyle}"
					Tag="{x:Static utils:Map3DNavMove.Right}"
					ToolTip="오른쪽으로">
					<md:PackIcon Width="18" Height="18" Kind="ChevronRight" />
				</Button>
				<Button
					Grid.Row="2"
					Grid.Column="1"
					AutomationProperties.AutomationId="GMaps.Map3D.Nav.Back"
					AutomationProperties.Name="뒤로"
					Click="OnMoveClick"
					Focusable="False"
					LostMouseCapture="OnMoveLostCapture"
					PreviewMouseLeftButtonDown="OnMoveDown"
					PreviewMouseLeftButtonUp="OnMoveUp"
					Style="{StaticResource Map3DNavButtonStyle}"
					Tag="{x:Static utils:Map3DNavMove.Back}"
					ToolTip="뒤로">
					<md:PackIcon Width="18" Height="18" Kind="ChevronDown" />
				</Button>
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
