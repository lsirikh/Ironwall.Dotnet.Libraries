<UserControl x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls.TrackingSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="360" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="Foreground" Value="#C9D6E2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#6E7D8C"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Num">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Background" Value="#0D131A"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#3D4756"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="GH">
            <Setter Property="Foreground" Value="#6E7D8C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Val">
            <Setter Property="Foreground" Value="#40C4FF"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#F2121821" BorderBrush="#3D4756" BorderThickness="1" CornerRadius="10">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <StackPanel>
            <!-- header -->
            <Grid Background="#1B2430">
                <TextBlock Text="⚙ 추적 설정" Foreground="#E6EDF3" FontWeight="Bold" Margin="12,8" VerticalAlignment="Center"/>
                <Button Content="✕" Command="{Binding CloseCommand}" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#9AA7B4" BorderThickness="0" Width="34" Height="32" Cursor="Hand"/>
            </Grid>

            <!-- 표시 -->
            <StackPanel Margin="12,10,12,8">
                <TextBlock Text="표시" Style="{StaticResource GH}"/>
                <Grid Margin="0,3">
                    <TextBlock Text="추적 표시" Style="{StaticResource Lbl}"/>
                    <CheckBox IsChecked="{Binding IsTrackingEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="최소 줌" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="이하 숨김 (0=항상)" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding MinVisibleZoom, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding MinVisibleZoom, StringFormat={}{0:0}}" Style="{StaticResource Val}"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="#30363D"/>

            <!-- 트레일 -->
            <StackPanel Margin="12,8">
                <TextBlock Text="트레일" Style="{StaticResource GH}"/>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="최대 점수" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="10~100" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding TrailMaxPoints, Mode=TwoWay}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TrailMaxPoints, StringFormat={}{0} pt}" Style="{StaticResource Val}"/>
                </Grid>
                <Grid Margin="0,3">
                    <StackPanel>
                        <TextBlock Text="끊김 분절" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="gap 초 초과 시 트레일 분리" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TextBox Text="{Binding GapThresholdSec, Mode=TwoWay}" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="#30363D"/>

            <!-- 수명 -->
            <StackPanel Margin="12,8">
                <TextBlock Text="수명 (TTL)" Style="{StaticResource GH}"/>
                <Grid Margin="0,3">
                    <StackPanel>
                        <TextBlock Text="기본 TTL" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="ttl_sec 없을 때 폴백(초)" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TextBox Text="{Binding DefaultTtlSec, Mode=TwoWay}" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,3">
                    <StackPanel>
                        <TextBlock Text="Lost 유예" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="lost 후 제거 유예(초)" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TextBox Text="{Binding LostTtlSec, Mode=TwoWay}" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="#30363D"/>

            <!-- 속도·재생 -->
            <StackPanel Margin="12,8">
                <TextBlock Text="속도 · 재생" Style="{StaticResource GH}"/>
                <Grid Margin="0,3">
                    <StackPanel>
                        <TextBlock Text="최대 속도" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="m/s 이상치 방어" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TextBox Text="{Binding MaxSpeedMs, Mode=TwoWay}" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,3">
                    <StackPanel>
                        <TextBlock Text="최대 재생시간" Style="{StaticResource Lbl}"/>
                        <TextBlock Text="Playback 1회 조회 상한(시간)" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TextBox Text="{Binding MaxPlaybackHours, Mode=TwoWay}" Style="{StaticResource Num}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- footer -->
            <Grid Background="#161D27" Margin="0,4,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="12,0" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
                    <Button Content="기본값" Command="{Binding ResetCommand}" Background="Transparent" Foreground="#9AA7B4"
                            BorderBrush="#3D4756" BorderThickness="1" Padding="10,4" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="저장" Command="{Binding SaveCommand}" Background="#40C4FF" Foreground="#04121B"
                            FontWeight="Bold" BorderThickness="0" Padding="14,4" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
