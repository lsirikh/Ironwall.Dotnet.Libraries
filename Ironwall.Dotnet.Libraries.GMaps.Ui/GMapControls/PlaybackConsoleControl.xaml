<UserControl x:Class="Ironwall.Dotnet.Libraries.GMaps.Ui.GMapControls.PlaybackConsoleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style TargetType="Button" x:Key="Chip">
            <Setter Property="Background" Value="#22303C"/>
            <Setter Property="Foreground" Value="#C9D6E2"/>
            <Setter Property="BorderBrush" Value="#3D4756"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#40C4FF"/>
            <Setter Property="Foreground" Value="#04121B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#40C4FF"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#F2121821" BorderBrush="#3D4756" BorderThickness="1" CornerRadius="10">
        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.5"/></Border.Effect>
        <StackPanel>
            <!-- header -->
            <Grid Background="#1B2430">
                <TextBlock Text="⏱ 추적 재생 (Playback)" Foreground="#E6EDF3" FontWeight="Bold"
                           Margin="12,8" VerticalAlignment="Center"/>
                <Button Content="✕" Command="{Binding CloseCommand}" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#9AA7B4" BorderThickness="0"
                        Width="34" Height="32" Cursor="Hand"/>
            </Grid>

            <!-- ① 기간 -->
            <StackPanel Margin="12,10,12,8">
                <TextBlock Text="① 기간" Foreground="#6E7D8C" FontSize="11" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="최근 5분"  Style="{StaticResource Chip}" Command="{Binding PresetCommand}" CommandParameter="5"/>
                    <Button Content="30분"     Style="{StaticResource Chip}" Command="{Binding PresetCommand}" CommandParameter="30"/>
                    <Button Content="1시간"    Style="{StaticResource Chip}" Command="{Binding PresetCommand}" CommandParameter="60"/>
                    <Button Content="오늘"     Style="{StaticResource Chip}" Command="{Binding PresetCommand}" CommandParameter="today"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding FromTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"
                             Background="#0D131A" Foreground="#E6EDF3" BorderBrush="#3D4756" Padding="4,3"/>
                    <TextBlock Text="~" Foreground="#6E7D8C" Margin="6,4"/>
                    <TextBox Text="{Binding ToTime, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"
                             Background="#0D131A" Foreground="#E6EDF3" BorderBrush="#3D4756" Padding="4,3"/>
                    <Button Content="불러오기" Style="{StaticResource Primary}" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- ② 이벤트 리스트 -->
            <StackPanel Margin="12,0,12,8">
                <TextBlock Text="② 추적 이벤트 — ☑ 표시/숨김 · ⌖ 따라보기" Foreground="#6E7D8C" FontSize="11" Margin="0,0,0,6"/>
                <Border BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" MaxHeight="170">
                    <ListBox ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TypeGlyph}" FontSize="14" Margin="4,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Foreground="#E6EDF3" FontSize="12">
                                            <Run Text="cam"/><Run Text="{Binding CameraId}"/><Run Text=" · "/><Run Text="{Binding Label}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Span}" Foreground="#6E7D8C" FontSize="10"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Background="{Binding ThreatBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding ThreatLevel}" Foreground="White" FontSize="9"/>
                                    </Border>
                                    <Button Grid.Column="4" Content="⌖" Width="24" Height="22" Cursor="Hand"
                                            Background="Transparent" Foreground="#9AA7B4" BorderThickness="0"
                                            Command="{Binding DataContext.FocusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- ③ 컨트롤바 -->
            <StackPanel Margin="12,0,12,12">
                <TextBlock Text="③ 재생" Foreground="#6E7D8C" FontSize="11" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding PlayPauseGlyph}" Command="{Binding PlayPauseCommand}"
                            Width="36" Height="36" FontSize="15" FontWeight="Bold"
                            Background="#40C4FF" Foreground="#04121B" BorderThickness="0" Cursor="Hand"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=TwoWay}"
                            VerticalAlignment="Center" Margin="9,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Foreground="#9AA7B4" FontFamily="Consolas"
                               FontSize="11" VerticalAlignment="Center" MinWidth="118" TextAlignment="Right"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="배속" Foreground="#6E7D8C" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="0.5×" Style="{StaticResource Chip}" Command="{Binding SpeedCommand}" CommandParameter="0.5"/>
                    <Button Content="1×"   Style="{StaticResource Chip}" Command="{Binding SpeedCommand}" CommandParameter="1"/>
                    <Button Content="2×"   Style="{StaticResource Chip}" Command="{Binding SpeedCommand}" CommandParameter="2"/>
                    <Button Content="4×"   Style="{StaticResource Chip}" Command="{Binding SpeedCommand}" CommandParameter="4"/>
                    <TextBlock Text="{Binding Status}" Foreground="#6E7D8C" FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
