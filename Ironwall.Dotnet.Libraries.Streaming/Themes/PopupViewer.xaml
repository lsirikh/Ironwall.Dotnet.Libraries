<!--  Themes/PopupViewer.xaml  -->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Converters"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Controls">

	<!--  Converters  -->
	<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

	<!--  Value Converters for Empty State  -->
	<converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />

	<!--  Close Button Style  -->
	<Style x:Key="PopupCloseButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						x:Name="border"
						Background="{TemplateBinding Background}"
						CornerRadius="4">
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							FontFamily="Segoe MDL2 Assets"
							FontSize="14"
							Foreground="{TemplateBinding Foreground}"
							Text="&#xE711;" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="border" Property="Background" Value="#55FFFFFF" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  PopupViewer Style  -->
	<Style TargetType="{x:Type local:PopupViewer}">
		<Setter Property="Background" Value="#FF2D2D30" />
		<Setter Property="BorderBrush" Value="#FF007ACC" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="MinWidth" Value="800" />
		<Setter Property="MinHeight" Value="600" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:PopupViewer}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="8">
						<Border.Effect>
							<DropShadowEffect
								BlurRadius="10"
								Direction="270"
								Opacity="0.5"
								ShadowDepth="3" />
						</Border.Effect>

						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!--  Header  -->
							<Border
								x:Name="PART_HeaderBorder"
								Grid.Row="0"
								Height="48"
								Background="#FF1E1E1E"
								CornerRadius="7,7,0,0">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Visibility" Value="Visible" />
										<!--  드래그 가능한 커서 표시  -->
										<Setter Property="Cursor" Value="SizeAll" />
									</Style>
								</Border.Style>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<Rectangle
										Grid.ColumnSpan="3"
										Fill="Transparent"
										IsHitTestVisible="True" />

									<!--  Icon  -->
									<Border
										Grid.Column="0"
										Width="32"
										Height="32"
										Margin="12,0,8,0"
										Background="#FF007ACC"
										CornerRadius="4"
										IsHitTestVisible="False">
										<TextBlock
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											FontFamily="Segoe MDL2 Assets"
											FontSize="18"
											Foreground="White"
											Text="&#xE7EE;" />
									</Border>

									<!--  Title  -->
									<TextBlock
										Grid.Column="1"
										VerticalAlignment="Center"
										FontSize="16"
										FontWeight="Medium"
										Foreground="White"
										IsHitTestVisible="False"
										Text="{TemplateBinding Title}" />

									<!--  Close Button  -->
									<Button
										x:Name="PART_CloseButton"
										Grid.Column="2"
										Margin="0,0,12,0"
										VerticalAlignment="Center"
										Style="{StaticResource PopupCloseButtonStyle}"
										ToolTip="닫기"
										Visibility="{TemplateBinding ShowCloseButton,
										                             Converter={StaticResource BoolToVisibility}}" />
								</Grid>
							</Border>

							<!--  Camera Container  -->
							<Border
								Grid.Row="1"
								Padding="4"
								Background="Black">
								<Grid>
									<!--  Empty State  -->
									<Border x:Name="EmptyState">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding CurrentCount, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>

										<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
											<TextBlock
												HorizontalAlignment="Center"
												FontFamily="Segoe MDL2 Assets"
												FontSize="64"
												Foreground="#FF404040"
												Text="&#xE7EE;" />
											<TextBlock
												Margin="0,16,0,0"
												HorizontalAlignment="Center"
												FontSize="18"
												Foreground="#FF606060"
												Text="이벤트 카메라 없음" />
											<TextBlock
												Margin="0,8,0,0"
												HorizontalAlignment="Center"
												FontSize="14"
												Foreground="#FF505050"
												Text="{TemplateBinding EmptyMessage}" />
										</StackPanel>
									</Border>

									<!--  Camera Rows Container  -->
									<ScrollViewer
										x:Name="CameraScrollViewer"
										HorizontalScrollBarVisibility="Disabled"
										VerticalScrollBarVisibility="Auto">

										<!--  CameraSource를 Row 컬렉션으로 바인딩  -->
										<ItemsControl x:Name="PART_CameraContainer" ItemsSource="{TemplateBinding CameraSource}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel Orientation="Vertical" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>

											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<!--  각 Row  -->
													<Border
														Height="Auto"
														BorderBrush="#FF3F3F46"
														BorderThickness="0,0,0,1">
														<!--  Row 내 카메라들  -->
														<ItemsControl ItemsSource="{Binding Cameras}">
															<ItemsControl.ItemsPanel>
																<ItemsPanelTemplate>
																	<UniformGrid Rows="1" />
																</ItemsPanelTemplate>
															</ItemsControl.ItemsPanel>

															<ItemsControl.ItemTemplate>
																<DataTemplate>
																	<Border Margin="2">
																		<local:ImprovedRtspPlayer
																			AutoPlay="{Binding AutoPlay}"
																			ConnectionInfo="{Binding ConnectionInfo}"
																			ContextId="{Binding Guid}"
																			ShowControls="{Binding ShowControls}"
																			StreamingOptions="{Binding StreamingOptions}" />
																	</Border>
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</ScrollViewer>
								</Grid>
							</Border>

							<!--  Status Bar  -->
							<Border
								Grid.Row="2"
								Height="32"
								Background="#FF1E1E1E"
								CornerRadius="0,0,7,7"
								Visibility="{TemplateBinding ShowStatusBar,
								                             Converter={StaticResource BoolToVisibility}}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<!--  Camera Count  -->
									<StackPanel
										Grid.Column="0"
										Margin="12,0,0,0"
										VerticalAlignment="Center"
										Orientation="Horizontal">
										<TextBlock
											FontSize="12"
											Foreground="#FFA0A0A0"
											Text="활성 카메라: " />
										<TextBlock
											x:Name="PART_StatusText"
											FontSize="12"
											FontWeight="Bold"
											Foreground="#FFFFC107">
											<TextBlock.Text>
												<MultiBinding StringFormat="{}{0} / {1}">
													<Binding Path="CurrentCount" RelativeSource="{RelativeSource TemplatedParent}" />
													<Binding Path="MaxItems" RelativeSource="{RelativeSource TemplatedParent}" />
												</MultiBinding>
											</TextBlock.Text>
										</TextBlock>
									</StackPanel>

									<!--  Status Indicator  -->
									<StackPanel
										Grid.Column="2"
										Margin="0,0,12,0"
										VerticalAlignment="Center"
										Orientation="Horizontal">
										<Ellipse
											Width="8"
											Height="8"
											Margin="0,0,6,0">
											<Ellipse.Style>
												<Style TargetType="Ellipse">
													<Setter Property="Fill" Value="#FF808080" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding CurrentCount, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static converters:ComparisonConverter.GreaterThan}, ConverterParameter=0}" Value="True">
															<Setter Property="Fill" Value="#FF4CAF50" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Ellipse.Style>
										</Ellipse>
										<TextBlock
											FontSize="11"
											Foreground="#FF808080"
											Text="실시간 모니터링" />
									</StackPanel>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  Visual States  -->
		<Style.Triggers>
			<!--  Empty State Trigger  -->
			<Trigger Property="CurrentCount" Value="0">
				<Setter Property="BorderBrush" Value="#FF606060" />
			</Trigger>

			<!--  Full State Trigger  -->
			<DataTrigger Binding="{Binding CurrentCount, RelativeSource={RelativeSource Self}, Converter={x:Static converters:ComparisonConverter.Equal}, ConverterParameter=6}" Value="True">
				<Setter Property="BorderBrush" Value="#FFFFC107" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>