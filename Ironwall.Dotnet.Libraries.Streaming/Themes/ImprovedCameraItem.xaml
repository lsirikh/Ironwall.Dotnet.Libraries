<!--  Themes/ImprovedCameraItem.xaml  -->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Converters"
	xmlns:local="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Controls"
	xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">

	<!--  공통 리소스 (기존과 동일)  -->
	<converters:PlaybackStateToColorConverter x:Key="StateToColorConverter" />
	<converters:PlaybackStateToVisibilityConverter x:Key="StateToVisibilityConverter" />


	<BooleanToVisibilityConverter x:Key="BoolToVisibility" />

	<!--  Button Style (기존과 동일)  -->
	<Style x:Key="ImprovedStreamingButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="2">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="Transparent" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter Property="Background" Value="Transparent" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Opacity" Value="0.5" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ToggleButton Style (기존과 동일)  -->
	<Style x:Key="ImprovedStreamingToggleButtonStyle" TargetType="ToggleButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="White" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ToggleButton">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="2">
						<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter Property="Background" Value="#33FFFFFF" />
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter Property="Background" Value="#55FFFFFF" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Slider Style (기존과 동일)  -->
	<Style x:Key="ImprovedStreamingSliderStyle" TargetType="Slider">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Slider">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Track x:Name="PART_Track" Grid.Row="1">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="Slider.DecreaseLarge" Style="{x:Null}">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border
												Height="4"
												Background="#FF4CAF50"
												CornerRadius="2" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.DecreaseRepeatButton>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="Slider.IncreaseLarge" Style="{x:Null}">
									<RepeatButton.Template>
										<ControlTemplate TargetType="RepeatButton">
											<Border
												Height="4"
												Background="#33FFFFFF"
												CornerRadius="2" />
										</ControlTemplate>
									</RepeatButton.Template>
								</RepeatButton>
							</Track.IncreaseRepeatButton>
							<Track.Thumb>
								<Thumb>
									<Thumb.Template>
										<ControlTemplate TargetType="Thumb">
											<Ellipse
												Width="12"
												Height="12"
												Fill="White" />
										</ControlTemplate>
									</Thumb.Template>
								</Thumb>
							</Track.Thumb>
						</Track>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ProgressBar Style (기존과 동일)  -->
	<Style x:Key="ImprovedStreamingProgressBarStyle" TargetType="ProgressBar">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ProgressBar">
					<Grid>
						<Border Background="#22FFFFFF" CornerRadius="25" />
						<Border
							x:Name="PART_Indicator"
							HorizontalAlignment="Left"
							Background="#FF4CAF50"
							CornerRadius="25">
							<Border.RenderTransform>
								<RotateTransform x:Name="Rotation" CenterX="25" CenterY="25" />
							</Border.RenderTransform>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsIndeterminate" Value="True">
							<Trigger.EnterActions>
								<BeginStoryboard>
									<Storyboard RepeatBehavior="Forever">
										<DoubleAnimation
											Storyboard.TargetName="Rotation"
											Storyboard.TargetProperty="Angle"
											From="0"
											To="360"
											Duration="0:0:1" />
									</Storyboard>
								</BeginStoryboard>
							</Trigger.EnterActions>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ImprovedRtspPlayer Style (주요 변경점: TargetType)  -->
	<Style TargetType="{x:Type local:ImprovedRtspPlayer}">
		<Setter Property="Background" Value="#FF1E1E1E" />
		<Setter Property="BorderBrush" Value="#FF3A3A3A" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Focusable" Value="True" />
		<Setter Property="StatusMessage" Value="Ready" />
		<!--  기본 메시지 개선  -->
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:ImprovedRtspPlayer}">
					<Border
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="4">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<!--  Camera Header  -->
							<Border
								Grid.Row="0"
								Padding="8,4"
								Background="#FF3F3F46">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<!--  Camera Name  -->
									<!--<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontWeight="Medium"
										Foreground="White"
										Text="{Binding ContextId, RelativeSource={RelativeSource TemplatedParent}}" />-->
									<TextBlock
										Grid.Column="0"
										VerticalAlignment="Center"
										FontWeight="Medium"
										Foreground="White"
										Text="{Binding TimeoutDisplay, RelativeSource={RelativeSource TemplatedParent}}" />

									<!--  Status Text  -->
									<TextBlock
										Grid.Column="1"
										Margin="0,0,10,0"
										VerticalAlignment="Center"
										FontSize="10"
										Foreground="#FFB0B0B0"
										Text="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}}" />

									<!--  Status Indicator  -->
									<Ellipse
										Grid.Column="2"
										Width="8"
										Height="8"
										Margin="0,0,6,0"
										Fill="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToColorConverter}}" />
								</Grid>
							</Border>

							<!--  Video Display Area  -->
							<Grid Grid.Row="1" MinHeight="200">
								<!--  Layer 1: Background  -->
								<Rectangle Fill="Black" />

								<!--  Layer 2: Video Container (PART_VideoView는 필수)  -->
								<Grid x:Name="VideoContainer" Grid.RowSpan="2">
									<Rectangle Fill="Black" />
									<vlc:VideoView x:Name="PART_VideoView" />
								</Grid>

								<!--  Layer 3: Overlay Panel  -->
								<Grid x:Name="OverlayPanel">
									<Grid.Style>
										<Style TargetType="Grid">
											<Setter Property="IsHitTestVisible" Value="True" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}}" Value="Playing">
													<Setter Property="IsHitTestVisible" Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Grid.Style>

									<!--  Status Badge (우상단)  -->
									<Border
										Margin="10"
										Padding="8,4"
										HorizontalAlignment="Right"
										VerticalAlignment="Top"
										Background="#CC000000"
										CornerRadius="4"
										IsHitTestVisible="False"
										Visibility="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=playing}">
										<StackPanel Orientation="Horizontal">
											<Ellipse
												Width="8"
												Height="8"
												Margin="0,0,6,0"
												Fill="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToColorConverter}}" />
											<TextBlock
												x:Name="PART_StatusText"
												FontSize="11"
												Foreground="White"
												Text="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}}" />
										</StackPanel>
									</Border>

									<!--  Loading Indicator (중앙)  -->
									<Grid x:Name="LoadingPanel" Visibility="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=loading}">
										<Rectangle Fill="Black" Opacity="0.7" />
										<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
											<ProgressBar
												x:Name="PART_LoadingIndicator"
												Width="50"
												Height="50"
												IsIndeterminate="True"
												Style="{StaticResource ImprovedStreamingProgressBarStyle}" />
											<TextBlock
												Margin="0,10,0,0"
												HorizontalAlignment="Center"
												FontSize="12"
												Foreground="White"
												Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}" />
										</StackPanel>
									</Grid>

									<!--  Restricted 상태 표시  -->
									<Grid Visibility="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=restricted}">
										<Rectangle Fill="#FF2D2D30" />
										<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
											<!--  금지 아이콘  -->
											<TextBlock
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontSize="60"
												Text="🚫" />

											<!--  메시지  -->
											<TextBlock
												Margin="0,15,0,0"
												HorizontalAlignment="Center"
												FontSize="16"
												FontWeight="Medium"
												Foreground="#FFFF5252"
												Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='Surveillance Not Allowed'}" />

											<TextBlock
												Margin="0,5,0,0"
												HorizontalAlignment="Center"
												FontSize="12"
												Foreground="#FFA0A0A0"
												Text="This camera is restricted" />
										</StackPanel>
									</Grid>


									<!--  Error Panel (중앙)  -->
									<Grid x:Name="ErrorPanel" Visibility="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=error}">
										<Rectangle Fill="Black" Opacity="0.8" />
										<StackPanel
											x:Name="PART_ErrorPanel"
											HorizontalAlignment="Center"
											VerticalAlignment="Center">
											<TextBlock
												HorizontalAlignment="Center"
												FontFamily="Segoe MDL2 Assets"
												FontSize="48"
												Foreground="#FFFF5252"
												Text="&#xE7BA;" />
											<TextBlock
												MaxWidth="300"
												Margin="0,10,0,5"
												HorizontalAlignment="Center"
												FontSize="14"
												Foreground="White"
												Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}"
												TextWrapping="Wrap" />
											<Button
												Margin="0,5,0,0"
												Padding="12,6"
												HorizontalAlignment="Center"
												Background="#FF4CAF50"
												BorderThickness="0"
												Command="{Binding PlayCommand, RelativeSource={RelativeSource TemplatedParent}}"
												Content="Retry"
												Foreground="White"
												Style="{StaticResource ImprovedStreamingButtonStyle}" />
										</StackPanel>
									</Grid>




									<!--  No Stream Message (초기 상태)  -->
									<Grid x:Name="DisconnectedPanel" Visibility="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=none}">
										<Rectangle Fill="Black" />
										<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
											<TextBlock
												HorizontalAlignment="Center"
												FontFamily="Segoe MDL2 Assets"
												FontSize="32"
												Foreground="#FF606060"
												Text="&#xE714;" />
											<TextBlock
												Margin="0,10,0,0"
												HorizontalAlignment="Center"
												FontSize="14"
												Foreground="#FF808080">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Text" Value="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}" Value="">
																<Setter Property="Text" Value="No Stream Connected" />
															</DataTrigger>
															<DataTrigger Binding="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
																<Setter Property="Text" Value="No Stream Connected" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
											<!--  연결 버튼 (옵션)  -->
											<Button
												Margin="0,15,0,0"
												Padding="15,8"
												HorizontalAlignment="Center"
												Background="#FF007ACC"
												BorderThickness="0"
												Command="{Binding PlayCommand, RelativeSource={RelativeSource TemplatedParent}}"
												Style="{StaticResource ImprovedStreamingButtonStyle}"
												Visibility="{Binding ConnectionInfo, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
												<StackPanel Orientation="Horizontal">
													<TextBlock
														Margin="0,0,8,0"
														FontFamily="Segoe MDL2 Assets"
														FontSize="14"
														Text="&#xE768;" />
													<TextBlock Text="Connect" />
												</StackPanel>
											</Button>
										</StackPanel>
									</Grid>
								</Grid>
							</Grid>

							<!--  Control Bar  -->
							<Border
								Grid.Row="2"
								Height="48"
								Background="#FF424242"
								Visibility="{Binding ShowControls, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<!--  Play Controls  -->
									<StackPanel
										Grid.Column="0"
										Margin="8,0"
										Orientation="Horizontal">

										<!--  Play/Pause 통합 버튼  -->
										<Button
											x:Name="PlayPauseButton"
											Width="32"
											Height="32"
											Command="{Binding PlayCommand, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource ImprovedStreamingButtonStyle}">
											<Button.ToolTip>
												<ToolTip>
													<TextBlock>
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Text" Value="Play" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding PlaybackState, RelativeSource={RelativeSource AncestorType=local:ImprovedRtspPlayer}}" Value="Playing">
																		<Setter Property="Text" Value="Pause" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</ToolTip>
											</Button.ToolTip>
											<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Text" Value="&#xE768;" />
														<!--  Play Icon  -->
														<Style.Triggers>
															<DataTrigger Binding="{Binding PlaybackState, RelativeSource={RelativeSource AncestorType=local:ImprovedRtspPlayer}}" Value="Playing">
																<Setter Property="Text" Value="&#xE769;" />
																<!--  Pause Icon  -->
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</Button>

										<!--  Stop Button  -->
										<Button
											Width="32"
											Height="32"
											Command="{Binding StopCommand, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource ImprovedStreamingButtonStyle}"
											ToolTip="Stop">
											<TextBlock
												FontFamily="Segoe MDL2 Assets"
												FontSize="18"
												Text="&#xE71A;" />
										</Button>

										<!--  Snapshot Button  -->
										<Button
											Width="32"
											Height="32"
											Command="{Binding SnapshotCommand, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource ImprovedStreamingButtonStyle}"
											ToolTip="Take Snapshot"
											Visibility="{Binding PlaybackState, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateToVisibilityConverter}, ConverterParameter=playing}">
											<TextBlock
												FontFamily="Segoe MDL2 Assets"
												FontSize="18"
												Text="&#xE722;" />
										</Button>
									</StackPanel>

									<!--  Stream Info  -->
									<Grid Grid.Column="1" Margin="8,0">
										<Grid.RowDefinitions>
											<RowDefinition Height="*" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>

										<TextBlock
											Grid.Row="0"
											VerticalAlignment="Bottom"
											FontSize="12"
											FontWeight="Medium"
											Foreground="White"
											Text="{Binding ConnectionInfo.Description, RelativeSource={RelativeSource TemplatedParent}, FallbackValue='RTSP Stream'}" />

										<StackPanel
											Grid.Row="1"
											VerticalAlignment="Top"
											Orientation="Horizontal">
											<TextBlock
												FontSize="10"
												Foreground="#FFAAAAAA"
												Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}"
												TextTrimming="CharacterEllipsis" />
											<!--  Context ID 표시 (디버깅용, 옵션)  -->
											<TextBlock
												Margin="10,0,0,0"
												FontSize="10"
												Foreground="#FF606060"
												Text="{Binding ContextId, RelativeSource={RelativeSource TemplatedParent}, StringFormat='[{0}]'}"
												Visibility="Collapsed" />
											<!--  필요시 Visible로 변경  -->
										</StackPanel>
									</Grid>

									<!--  Volume Control  -->
									<StackPanel
										Grid.Column="2"
										Margin="8,0"
										Orientation="Horizontal">
										<!--  Mute Button  -->
										<ToggleButton
											Width="32"
											Height="32"
											IsChecked="{Binding IsMuted, RelativeSource={RelativeSource TemplatedParent}}"
											Style="{StaticResource ImprovedStreamingToggleButtonStyle}"
											ToolTip="Mute">
											<TextBlock
												FontFamily="Segoe MDL2 Assets"
												FontSize="18"
												Foreground="White">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Text" Value="&#xE767;" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
																<Setter Property="Text" Value="&#xE74F;" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</ToggleButton>

										<!--  Volume Slider  -->
										<Slider
											Width="100"
											VerticalAlignment="Center"
											Maximum="100"
											Minimum="0"
											Style="{StaticResource ImprovedStreamingSliderStyle}"
											ToolTip="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Volume: {0}%'}"
											Value="{Binding Volume, RelativeSource={RelativeSource TemplatedParent}}" />
									</StackPanel>
								</Grid>
							</Border>
						</Grid>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>

		<!--  State-based Border Color  -->
		<Style.Triggers>
			<Trigger Property="PlaybackState" Value="Playing">
				<Setter Property="BorderBrush" Value="#FF4CAF50" />
			</Trigger>
			<Trigger Property="PlaybackState" Value="Error">
				<Setter Property="BorderBrush" Value="#FFFF5252" />
			</Trigger>
			<Trigger Property="PlaybackState" Value="Connecting">
				<Setter Property="BorderBrush" Value="#FFFFC107" />
			</Trigger>
			<Trigger Property="PlaybackState" Value="Buffering">
				<Setter Property="BorderBrush" Value="#FFFFEB3B" />
			</Trigger>
			<Trigger Property="PlaybackState" Value="Reconnecting">
				<Setter Property="BorderBrush" Value="#FFFF9800" />
			</Trigger>
			<Trigger Property="PlaybackState" Value="Paused">
				<Setter Property="BorderBrush" Value="#FF9E9E9E" />
			</Trigger>
		</Style.Triggers>
	</Style>

</ResourceDictionary>