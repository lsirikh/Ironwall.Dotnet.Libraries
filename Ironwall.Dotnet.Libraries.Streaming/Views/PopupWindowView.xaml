<Window
	x:Class="Ironwall.Dotnet.Libraries.Streaming.Views.PopupWindowView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:cal="http://www.caliburnproject.org"
	xmlns:controls="clr-namespace:Ironwall.Dotnet.Libraries.Streaming.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="{Binding Title}"
	Width="900"
	Height="800"
	AllowsTransparency="True"
	Background="Transparent"
	WindowStyle="None"
	mc:Ignorable="d">
	<Border
		Background="#EE2D2D30"
		BorderBrush="#FF007ACC"
		BorderThickness="2"
		CornerRadius="8">

		<controls:PopupViewer
			Title="{Binding Title}"
			CameraSource="{Binding Cameras}"
			CloseCommand="{Binding CloseCommand}"
			EmptyMessage="이벤트 대기 중..."
			MaxItems="{Binding MaxCameras}"
			ShowPlayerControls="False"
			ShowStatusBar="True" />

	</Border>
</Window>
