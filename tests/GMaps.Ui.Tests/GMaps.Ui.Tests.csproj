  <ItemGroup>
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Services\Tracking\TrackingMath.cs" />
    <!-- Press-Hold(CameraPopup_PressHold_PtzZoomFocus) 순수 헬퍼 -->
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Helpers\Ptz\PtzGestureTag.cs" />
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Helpers\Ptz\PtzFocusMath.cs" />
    <!-- PTZ 속도 스케일(CameraPopup_PTZ_Responsiveness_Speed FR-PTR-02) -->
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Helpers\Ptz\PtzVelocityMath.cs" />
    <!-- Tracking 달력/세션 분할 -->
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Services\Tracking\DateRangeCalendar.cs" />
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Services\Tracking\TrackSessionSplitter.cs" />
    <!-- 카메라 특정위치 확인 순수 로직(Camera_PTZ_AimLocation) — 실코드 링크 -->
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Services\Tracking\CameraAimMath.cs" />
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.GMaps.Ui\Services\Tracking\CameraAimRequestBuilder.cs" />
    <Compile Include="..\..\Ironwall.Dotnet.Libraries.Messages\Dto\Brokers\CameraAimLocationBodyDto.cs" />
